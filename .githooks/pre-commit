#!/usr/bin/env bash
# Mentl pre-commit — the FAIL-CLOSED thesis gate at commit time.
#
# Claude Code's PostToolUse runs drift-audit during editing, but THIS hook
# survives any editor, any model, any future tooling change: it REFUSES the
# commit when the Mentl thesis is violated, instead of merely surfacing it.
# It is the strongest pre-L1 shadow of the kernel's own verifier (the kernel
# internalizes this enforcement BY CONSTRUCTION once first-light closes).
#
# Two gates fire:
#
#   1. tools/drift-audit.sh on staged .mn — every drift mode is a syntactic
#      tell of the Carried-Truth Law violated.
#
#   2. tools/verify.sh when any compiler source is staged (src/*.mn,
#      lib/**/*.mn) — the micro battery compiles-and-runs green + the
#      census (informational). Stamped: an unchanged tree answers from
#      verify's green stamp instantly. This makes it impossible to COMMIT
#      a state that breaks the medium.
#
# The fixpoint itself (m2 == m3) is the march's gate (tools/march.sh /
# `mentl march`), run per landing — not per-commit (a full double-compile
# per commit is wasteful; the pin ritual owns it).
#
# Enable: bash tools/setup-git-hooks.sh   (git config core.hooksPath .githooks)
# Bypass: --no-verify is for non-source emergency fixes ONLY. Never bypass for
# .mn sources — these gates ARE the discipline CLAUDE.md establishes.
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
AUDIT="$REPO_ROOT/tools/drift-audit.sh"
VERIFY="$REPO_ROOT/tools/verify.sh"

# Staged source: .mn anywhere.
mapfile -t staged_src < <(
    git diff --cached --name-only --diff-filter=ACMR \
      | grep -E '\.mn$' || true
)

# (The former Gate 0 — `mentl fmt` over staged files, re-staged — is GONE,
# 2026-09-24. It formatted AFTER the march had pinned a boot from the
# unformatted text, so the commit and the pin were two sources, and one
# landing paid four marches to reconcile them. Source is canonical as it is
# WRITTEN now — tools/audit-on-edit.sh runs `mentl fmt` on every edit — and
# `mentl verify` refuses any module off its canonical render, at the repin
# and again inside Gate 3 below, so a commit-time rewrite could only ever
# reintroduce the split it existed to prevent.)

# ─── Gate 1: drift-audit ─────────────────────────────────────────────
if [[ -x "$AUDIT" && ${#staged_src[@]} -gt 0 ]]; then
    abspaths=()
    for f in "${staged_src[@]}"; do [[ -f "$REPO_ROOT/$f" ]] && abspaths+=("$REPO_ROOT/$f"); done
    if [[ ${#abspaths[@]} -gt 0 ]]; then
        echo "pre-commit: drift-audit on ${#abspaths[@]} staged source file(s)..."
        if ! bash "$AUDIT" "${abspaths[@]}"; then
            echo ""
            echo "pre-commit: DRIFT detected — the commit is BLOCKED."
            echo "Every drift mode is the Carried-Truth Law violated (re-derive / discard /"
            echo "fabricate / cache what the graph proved). Rewrite in residue form. A true"
            echo "false-positive may be suppressed with a trailing '# drift-audit: ignore'"
            echo "(only after verifying it is NOT one of the nine drift modes in disguise)."
            exit 1
        fi
    fi
fi

# (The former Gate 2 — the comment-truth ratchet — ABSORBED 2026-07-22:
# the medium's own W_CommentRefUnresolved pass runs in every compile, and
# `mentl verify` bounds its tally at 0 (src/board.mn). Its script was deleted
# then; the dead -x check here silently no-opped for a week — the exact
# gate-that-cannot-fail vacuity, caught by the practice scout 2026-07-30.
# The board in Gate 3 below IS the comment-truth gate now.)

# ─── Gate 3: the thesis gate (compiler source staged) ────────────────
has_compiler_change=false
for f in "${staged_src[@]}"; do
    if [[ "$f" == src/*.mn || "$f" == lib/*.mn || "$f" == lib/*/*.mn ]]; then
        has_compiler_change=true; break
    fi
done

if [[ "$has_compiler_change" == "true" && -x "$VERIFY" ]]; then
    echo "pre-commit: thesis gate (tools/verify.sh — micros + the census ratchet)..."
    if ! bash "$VERIFY"; then
        echo ""
        echo "pre-commit: THE MENTL-THESIS GATE FAILED — the commit is BLOCKED."
        echo "The medium broke or the first-light ratchet regressed. Fix it; do not bypass."
        exit 1
    fi
fi

# ─── Gate 4: the FULL-GREEN perimeter (frontier stamped at this boot) ─
# Paid for at d51661f1 (2026-08-09): the general-severance commit landed
# with frontier 358/1 RED because this hook ran verify only — the board
# stamped `frontier: NOT RUN`, a visible blank that refuses nothing. The
# full-green law says a wheel commit lands only when the frontier ran,
# green, against the exact boot being committed. Mechanically: the gate
# writes .build/frontier-stamp (the boot sha256) on a 0-red run and clears
# it otherwise; this gate demands the stamp match the staged boot.
# Boot↔source coherence stays the march's contract (m2 == m3).
# "Green" is literal ZERO again, and the history is worth keeping because
# the word moved twice in one day. It hard-coded 0 while march.sh read a
# `frontier_red_max` COUNT, so the march blessed pins this refused to
# commit — fixed that morning by reading the same count here, which then
# propagated the count's real defect into the commit gate: a count cannot
# say WHICH leg is red, so a fixed standing red plus a broken crown leg
# passed identically. Standing failures are DECLARED BY NAME now
# (frontier_expected_red, judged in both directions) and land in the
# summary's expected-red field, so zero is the strong form rather than the
# unreachable one.
staged_boot=$(git diff --cached --name-only --diff-filter=ACMR | grep -cx 'boot/mentl.wasm' || true)
if [[ "$has_compiler_change" == "true" || "$staged_boot" -gt 0 ]]; then
    STAMP="$REPO_ROOT/.build/frontier-stamp"
    boot_sha=$(sha256sum "$REPO_ROOT/boot/mentl.wasm" | cut -d' ' -f1)
    # The stamp lists every wheel a green run tested (tools/frontier-gate.sh),
    # so a green run against a march candidate stands for the boot it becomes.
    if [[ ! -f "$STAMP" ]] || ! grep -qx "$boot_sha" "$STAMP"; then
        echo ""
        echo "pre-commit: THE FULL-GREEN PERIMETER REFUSES — the frontier has not"
        echo "run green against this boot ($(echo "$boot_sha" | cut -c1-12)…). Run:"
        echo "    bash tools/frontier-gate.sh"
        echo "and commit only on 0 red. A standing failure is DECLARED BY NAME"
        echo "(frontier_expected_red in tools/verify-baseline.txt) and reports as"
        echo "expected-red, not red — so zero here is the strong form, and a leg"
        echo "no entry declares clears the stamp."
        exit 1
    fi
    echo "pre-commit: full-green perimeter — frontier stamped green at this boot."
fi

exit 0
