// clock.mn — time as four peer effects (spec 11)
//
// Four, not one. Different domains need different notions of time;
// collapsing them into one erases the distinctions the refinement
// algebra needs to prove.
//
//   Clock    — wall time (now, sleep, deadline_remaining)
//   Tick     — logical time (monotonic counter, no wall relation)
//   Sample   — DSP time (integer counter at known rate)
//   Deadline — budget (completion guarantee, independent of wall read)
//
// Each is negated independently (`!Clock`, `!Tick`, `!Sample`,
// `!Deadline`) through spec 01's Boolean algebra. `<~` feedback infers
// its clock from its own site (SYNTAX §«<~»: a per-site line whose
// previous iteration is the enclosing function's next call) and requires
// none of these; they are the rates a program declares it runs at. The
// IterContext marker below is the vocabulary an inferred clock calculus
// will read (`Hβ.dataflow.clock-calculus-sample-rate`); nothing reads it
// at a `<~` site today.
//
// Three handler tiers per effect: real (delegates to host) · test
// (deterministic) · record (tees to trace); the tick's replay reads a trace.
// Time vocabulary — Instant and Duration are nanosecond-scale wrappers.
//
// nanoseconds since epoch
type Instant = Instant(Int)

// nanoseconds
type Duration = Duration(Int)

// The four peer effects — Clock, Tick, Sample, Deadline.
effect Clock {
  clock_now() -> Instant
  clock_sleep(Duration)
}

effect Tick {
  tick()
  current_tick() -> Int
}

// A sample rate: some number of frames each second, never none, so a frame
// count divided by it is a whole division.
type Rate = Int where 0 < self

// Sample is INSTANCE-PARAMETERIZED (SYNTAX §«Parameterized effect»): the
// rate rides the effect, so `Sample(44100)` and `Sample(48000)` are distinct
// row members, and a path that declares `!Sample(44100)` refuses a stage
// written for the other rate — the canonical audio bug, refused per
// instance. A program declares the rate it runs at (`with Sample(48_000)`)
// and reads it back through `sample_rate()`; the number is authored ONCE,
// and the install that answers it is the one serving that instance.
effect Sample(rate: Int) {
  sample_rate() -> Rate
  advance_sample()
  current_sample() -> Int
}

effect Deadline {
  deadline() -> Instant
  remaining() -> Duration
}

// Tier 1: real — delegates to host via HostClock. In WASM builds, host_*
// effects are mapped at emit time to WASI imports; pure composition here.
effect HostClock {
  host_clock_ns() -> Int
}

handler clock_real {
  clock_now() => resume(Instant(host_clock_ns())),
  clock_sleep(_d) => // no-op in batch compilation
  resume(),
}

handler tick_real with counter = 0 {
  tick() => resume() with counter = counter + 1,
  current_tick() => resume(counter),
}

// sample_at(rate) — the one Sample handler: the rate is its config, the
// sample count its state. Its config shares its name with Sample's
// parameter, so `~> sample_at(48_000)` serves `Sample(48_000)` alone: a
// stage declared `with Sample(44_100)` passes it to the install serving its
// own rate, and with none the root refuses, proposing that install. Nested
// installs at two rates are two clocks, each answering its own stages. The
// rate is a `Rate`, claimed where the install is written, so the rate every
// stage reads back is one it may divide by.
handler sample_at(rate: Rate) with count = 0 {
  sample_rate() => resume(rate),
  advance_sample() => resume() with count = count + 1,
  current_sample() => resume(count),
}

handler deadline_real with deadline_ns = 0 {
  deadline() => resume(Instant(deadline_ns)),
  remaining() => resume(Duration(deadline_ns)),
}

// Tier 2: test — deterministic, seeded.
handler clock_test with clock_state = 1000 {
  clock_now() => resume(Instant(clock_state)) with clock_state = clock_state + 1,
  clock_sleep(d) => match d {
    Duration(ns) => resume() with clock_state = clock_state + ns,
  },
}

handler tick_test with counter = 0 {
  tick() => resume() with counter = counter + 1,
  current_tick() => resume(counter),
}

handler deadline_test {
  deadline() => resume(Instant(5000)),
  remaining() => // 5ms test budget
  resume(Duration(5000)),
}

// Tier 3: record — tees values to a trace. Wraps the real handler;
// captures every value; produces a trace usable by the replay handler.
//
// Record handlers append to flat trace buffers via list_extend_to —
// O(1) amortized per tick. The trace_len counter is the logical
// length; entries above it are stale (matching the trail substrate
// in graph.mn). Replay handlers consume by advancing read_idx into
// the trace, never popping — the trace itself is immutable through
// the replay so callers can re-replay or inspect post hoc.
handler clock_record with trace = [], trace_len = 0 {
  clock_now() => {
    let now = host_clock_ns()
    let new_trace = list_set(list_extend_to(trace, trace_len + 1), trace_len, now)
    resume(Instant(now)) with trace = new_trace, trace_len = trace_len + 1
  },
  clock_sleep(_d) => resume(),
}

handler tick_record with counter = 0, trace = [], trace_len = 0 {
  tick() => {
    let new_trace = list_set(list_extend_to(trace, trace_len + 1), trace_len, counter)
    resume() with counter = counter + 1, trace = new_trace, trace_len = trace_len + 1
  },
  current_tick() => resume(counter),
}

handler tick_replay with trace = [], read_idx = 0 {
  tick() => if read_idx >= len(trace) { resume() } else { resume() with read_idx = read_idx + 1 },
  current_tick() => if read_idx >= len(trace) { resume(0) } else { resume(list_index(trace, read_idx)) },
}

// Deadline budgeting — tight real-time loops. `with_deadline(budget_ns,
// computation)` installs deadline_budget around computation.
handler deadline_budget with budget_remaining = 0 {
  deadline() => resume(Instant(budget_remaining)),
  remaining() => resume(Duration(budget_remaining)),
}

fn with_deadline(budget_ns, computation) = computation() ~> deadline_budget
