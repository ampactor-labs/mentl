// cfc.mn — cross-frequency coupling on CPU (the comodulogram)
//
// Phase-amplitude coupling (PAC): does the PHASE of a slow rhythm govern
// the AMPLITUDE of a fast one? The comodulogram answers it for a grid of
// (low, high) frequency pairs — one mean-vector-length per cell, the
// argmax naming the coupled pair. This is PLAN §11 col 4's research half
// (slime-mould / bat / electric-fish / plant recordings), run end to end
// through the Mentl wheel.
//
// ── Representation (the substrate seam, named not hidden) ──
// The signal, the phase/amplitude columns, and the comodulogram matrix are
// native `[Float]` — §5.U's wide-element cash-out: a `[Float]` list round-trips
// end to end (a literal is born stride-8, `list_set`/`list_index` carry the
// element stride, and arithmetic / comparison / show deref the element at its
// native f64 width). Live per-frequency values (re, im) ride a float TUPLE,
// which the record path stores exactly. The earlier scaled-Int Q-format carrier
// — a workaround for a `[Float]` that did not round-trip — is gone.
//
// Every float accumulator threaded across a tail-recursive loop (dft's re/im,
// mvl's sc/ss, argmax's best) is annotated `: Float`. The pin is load-bearing,
// not cosmetic: an UNANNOTATED float accumulator leaves its type a variable
// when the body is checked, so the fn compiles ONCE at the i32 floor and reads
// f64 arguments as words — silent-wrong. That is the generic-over-wide keystone
// Hβ.value.seq-element-stride-carrier (the ultimate is monomorphization or a
// runtime stride carrier); the annotation monomorphizes the body to f64.
import math

import io

// Positive — a strictly positive count: a hop in samples, a grid width.
// The refinement PROVES the divisions below total (`k / num_high` and
// `(len(xs) - win) / hop` exclude 0 and -1), so no site here performs
// `Trap`; a caller pays the claim once, at the argument, where a literal
// folds and a computed value is honest debt.
type Positive = Int where 0 < self

// ─── Hann window — the taper that tames spectral leakage ────────────
//
// 0.5·(1 − cos(2πi/(n−1))): zero at the ends, unity at the centre, so a
// windowed bin reads one frequency without the boxcar's side-lobes
// smearing its neighbours in.
fn hann(i: Int, n: Int) -> Float with Pure =
  0.5 - 0.5 * cos(two_pi() * float_of_int(i) / float_of_int(n - 1))

// ─── One complex bin, read two ways ─────────────────────────────────
//
// A DFT bin is a complex number (re, im); its ANGLE is the component's
// phase, its LENGTH the component's amplitude. bin_phase / bin_mag are
// the same atan2 / hypot the analytic signal uses — one (re, im), two
// projections.
fn bin_phase(re: Float, im: Float) -> Float with Pure = atan2(im, re)

fn bin_mag(re: Float, im: Float) -> Float with Pure = sqrt(re * re + im * im)

// ─── Single-bin windowed DFT over xs[start .. start+n) ──────────────
//
// re = (1/n)·Σ x·hann·cos(2πf i/sr), im = −(1/n)·Σ x·hann·sin(…). One
// frequency, evaluated directly (not an FFT grid), so any Hz is reachable.
// The accumulator threads (re, im) as float scalars and returns the pair
// as a tuple — the record path stores its f64 fields exactly. `freq` is
// integer Hz (the grid axes are integer frequencies).
//
// The loop is the tail-recursive accumulator the whole file uses; no
// list grows inside it (the samples are read, never appended).
fn dft_bin_loop(xs, start: Int, n: Int, freq: Int, sr: Int, j: Int, re: Float, im: Float) = if j >= n {
  (re / float_of_int(n), 0.0 - im / float_of_int(n))
} else {
  let sample = list_index(xs, start + j)
  let w = hann(j, n)
  let angle = two_pi() * float_of_int(freq) * float_of_int(j) / float_of_int(sr)
  let wx = sample * w
  dft_bin_loop(xs, start, n, freq, sr, j + 1, re + wx * cos(angle), im + wx * sin(angle))
}

fn dft_bin(xs, start: Int, n: Int, freq: Int, sr: Int) =
  dft_bin_loop(xs, start, n, freq, sr, 0, 0.0, 0.0)

// ─── Mean vector length — the coupling measure ──────────────────────
//
// MVL = |mean over frames of A·e^{iφ}| = √((Σ A·cosφ)² + (Σ A·sinφ)²) / N.
// When A (the high-frequency amplitude) rises at a consistent low-
// frequency phase φ, the vectors A·e^{iφ} point one way and the resultant
// is large; when A is phase-blind they cancel. `phases` and `amps` are
// native [Float] columns, co-indexed by frame.
//
// This is the RAW Canolty (2006) MVL — the mean of the complex vectors,
// weighting each by its amplitude. It is NOT the Σamp-normalized variant
// (|Σ A·e^{iφ}| / Σ A): normalizing by Σamp rewards a low-amplitude band
// whose few samples happen to align, so on this data it argmaxes a bin
// with no carrier (measured: the /Σamp form peaks at high=60 Hz, a band
// the signal never fills, while the raw form peaks at the true 40 Hz).
// The amplitude weight IS the discriminator; do not divide it out.
fn mvl_loop(phases, amps, i: Int, n: Int, sc: Float, ss: Float) -> Float = if i >= n {
  sqrt(sc * sc + ss * ss) / float_of_int(n)
} else {
  let p = list_index(phases, i)
  let a = list_index(amps, i)
  mvl_loop(phases, amps, i + 1, n, sc + a * cos(p), ss + a * sin(p))
}

fn mvl(phases, amps) -> Float = mvl_loop(phases, amps, 0, len(phases), 0.0, 0.0)

// ─── Per-frequency time series — the O(frames × win × bins) tables ──
//
// For one frequency, walk the frames (hop-spaced windows) and record the
// bin's phase (or amplitude) at each — a scaled-Int column of length
// num_frames. Building the phase column for every low bin and the
// amplitude column for every high bin visits each (frame, bin) once:
// O(num_frames × win × (num_low + num_high)). The comodulogram then reads
// columns, never recomputing a DFT per (low, high) pair.
fn fill_phase_column(xs, sr: Int, freq: Int, win: Int, hop: Int, num_frames: Int, out, f: Int) = if f >= num_frames {
  out
} else {
  match dft_bin(xs, f * hop, win, freq, sr) {
    (re, im) => {
      let out2 = list_set(out, f, bin_phase(re, im))
      fill_phase_column(xs, sr, freq, win, hop, num_frames, out2, f + 1)
    },
  }
}

fn phase_column(xs, sr: Int, freq: Int, win: Int, hop: Int, num_frames: Int) =
  fill_phase_column(xs, sr, freq, win, hop, num_frames, make_list(num_frames), 0)

fn fill_amp_column(xs, sr: Int, freq: Int, win: Int, hop: Int, num_frames: Int, out, f: Int) = if f >= num_frames {
  out
} else {
  match dft_bin(xs, f * hop, win, freq, sr) {
    (re, im) => {
      let out2 = list_set(out, f, bin_mag(re, im))
      fill_amp_column(xs, sr, freq, win, hop, num_frames, out2, f + 1)
    },
  }
}

fn amp_column(xs, sr: Int, freq: Int, win: Int, hop: Int, num_frames: Int) =
  fill_amp_column(xs, sr, freq, win, hop, num_frames, make_list(num_frames), 0)

// One column per frequency, collected into a list-of-columns (the list
// holds column handles — an ordinary Int-slot list). `is_phase` picks the
// projection so the two builds share one walk.
fn fill_columns(xs, sr: Int, freqs, win: Int, hop: Int, num_frames: Int, num_freqs: Int, is_phase, out, fi: Int) = if fi >= num_freqs {
  out
} else {
  let freq = list_index(freqs, fi)
  let col = if is_phase {
    phase_column(xs, sr, freq, win, hop, num_frames)
  } else {
    amp_column(xs, sr, freq, win, hop, num_frames)
  }
  let out2 = list_set(out, fi, col)
  fill_columns(xs, sr, freqs, win, hop, num_frames, num_freqs, is_phase, out2, fi + 1)
}

fn columns(xs, sr: Int, freqs, win: Int, hop: Int, num_frames: Int, is_phase) =
  fill_columns(xs, sr, freqs, win, hop, num_frames, len(freqs), is_phase, make_list(len(freqs)), 0)

// ─── The comodulogram — one MVL per (low, high) cell ────────────────
//
// Phase columns for the low grid, amplitude columns for the high grid,
// then cell (li, hi) = MVL(low_phase[li], high_amp[hi]). Returns [[Float]]
// (rows = low frequencies, cols = high). num_frames is
// (len(xs) − win)/hop + 1.
fn fill_row(low_cols, high_cols, li: Int, num_high: Int, out, hi: Int) = if hi >= num_high {
  out
} else {
  let phases = list_index(low_cols, li)
  let amps = list_index(high_cols, hi)
  let out2 = list_set(out, hi, mvl(phases, amps))
  fill_row(low_cols, high_cols, li, num_high, out2, hi + 1)
}

fn fill_matrix(low_cols, high_cols, num_low: Int, num_high: Int, out, li: Int) = if li >= num_low {
  out
} else {
  let row = fill_row(low_cols, high_cols, li, num_high, make_list(num_high), 0)
  let out2 = list_set(out, li, row)
  fill_matrix(low_cols, high_cols, num_low, num_high, out2, li + 1)
}

fn comodulogram(xs, sr: Int, low_freqs, high_freqs, win: Int, hop: Positive) = {
  let num_frames = (len(xs) - win) / hop + 1
  let low_cols = columns(xs, sr, low_freqs, win, hop, num_frames, true)
  let high_cols = columns(xs, sr, high_freqs, win, hop, num_frames, false)
  fill_matrix(low_cols, high_cols, len(low_freqs), len(high_freqs), make_list(len(low_freqs)), 0)
}

// ─── Reading the matrix — accessor, argmax, and stats ───────────────
fn matrix_get(matrix, li: Int, hi: Int) = list_index(list_index(matrix, li), hi)

// The argmax cell as a FLAT index (li·num_high + hi). The demo maps it
// back to a (low, high) pair. Track the running best cell and its value;
// a flat scan over num_low × num_high, no allocation.
fn argmax_scan(matrix, num_low: Int, num_high: Positive, k: Int, total: Int, best_k: Int, best_v: Float) = if k >= total {
  best_k
} else {
  let li = k / num_high
  let hi = k - li * num_high
  let v = matrix_get(matrix, li, hi)
  if v > best_v {
    argmax_scan(matrix, num_low, num_high, k + 1, total, k, v)
  } else {
    argmax_scan(matrix, num_low, num_high, k + 1, total, best_k, best_v)
  }
}

fn comodulogram_argmax(matrix, num_low: Int, num_high: Positive) =
  argmax_scan(matrix, num_low, num_high, 0, num_low * num_high, 0, 0.0 - 1.0)

// Sum of all cells (scaled Int) — for the mean, a peak/mean separation
// witness the demo reports.
fn matrix_sum(matrix, num_low: Int, num_high: Positive, k: Int, total: Int, acc: Float) = if k >= total {
  acc
} else {
  let li = k / num_high
  let hi = k - li * num_high
  matrix_sum(matrix, num_low, num_high, k + 1, total, acc + matrix_get(matrix, li, hi))
}

fn matrix_max(matrix, num_low: Int, num_high: Positive) = {
  let flat = comodulogram_argmax(matrix, num_low, num_high)
  let li = flat / num_high
  let hi = flat - li * num_high
  matrix_get(matrix, li, hi)
}

// ─── Debug projection — eprint the matrix (scaled Ints) ─────────────
//
// One row per low frequency, cells scaled by 1e6. Diagnostics-tier: the
// gated demo never calls it, but a debug main does, so the (low, high)
// peak is eyeball-checkable and the peak/mean ratio recordable.
fn eprint_row(matrix, li: Int, num_high: Int, hi: Int) = if hi >= num_high {
  eprint_string("\n")
} else {
  eprint_string(float_to_str(matrix_get(matrix, li, hi)))
  eprint_string(" ")
  eprint_row(matrix, li, num_high, hi + 1)
}

fn eprint_matrix(matrix, num_low: Int, num_high: Int, li: Int) = if li >= num_low {
  0
} else {
  eprint_row(matrix, li, num_high, 0)
  eprint_matrix(matrix, num_low, num_high, li + 1)
}

// ─── Real-recording transport — newline-separated floats → signal ───
//
// The research face: a recording on disk is one float per line. Read the
// file, split on newlines, parse each into the native [Float] signal the
// comodulogram consumes. `fs_read_file_impl` crosses the WASI boundary
// (the host IS an effect); the parse is pure. Gated end to end by
// tests/frontier/cfc-rec (Mentl's argmax cross-validated against a numpy
// oracle over the same on-disk bytes) — the representation-stress the
// m3==m4 fixpoint is blind to.
//
// `split` yields VIEW strings ([-1][buf][start][len], PLAN §6): the first
// word is the −1 discriminant, not a length, so a bare `len`/`parse_float`
// (which read that first word) mis-read every line. `str_concat("", line)`
// materializes the view into a flat [len][bytes] parse_float can read, and
// `byte_len` reads a view's real length. A trailing newline leaves one
// empty final view (byte_len 0), skipped. The buffer is preallocated to
// the line count and sliced to the parsed length — no grow-and-copy.
fn fill_recording(strs, num: Int, out, i: Int, w: Int) = if i >= num {
  slice(out, 0, w)
} else {
  let line = str_concat("", list_index(strs, i))
  if byte_len(line) == 0 {
    fill_recording(strs, num, out, i + 1, w)
  } else {
    let written = list_set(out, w, parse_float(line))
    fill_recording(strs, num, written, i + 1, w + 1)
  }
}

fn read_recording(path) = {
  let strs = lines(fs_read_file_impl(path))
  fill_recording(strs, len(strs), make_list(len(strs)), 0, 0)
}
