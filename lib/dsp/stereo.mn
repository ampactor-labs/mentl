// stereo.mn — the field a voice stands in: placement, the echo, the room,
// the limiter
//
// Everything here with memory is a MAKER, as every filter in
// lib/dsp/feedback.mn is: the stage it returns owns its lines, so two echoes
// are two rooms and a stereo pair is two calls. Every stage is `!Alloc`, and
// the medium proves it — the rings were allocated when the closure was.
import math

import dsp/feedback

import dsp/signal

// A feedback gain under unity — a line fed back through it dies away. At 1.0
// an echo would ring forever; above it, grow without bound.
type Decay = Float where 0.0 <= self && self < 1.0

// Equal-power panning: a position p in [-1, 1] sweeps a quarter circle, so
// the two gains' squares always sum to one and a voice keeps its loudness as
// it moves.
fn pan_left(p: Float) -> Float with Pure = cos((p + 1.0) * two_pi() * 0.125)

fn pan_right(p: Float) -> Float with Pure = sin((p + 1.0) * two_pi() * 0.125)

// An echo is now plus a little of before, and there is no echo without a
// before: `delay(12000)` is 12,000 samples of memory — a quarter second at
// 48 kHz — and `prev` is what came out of this echo a quarter second ago,
// fed back at `fb`. A line's depth is a literal, so the echo's length is the
// maker's, not the rate's. The signal is any Float: the stage accepts any
// signal, and saying so keeps the gain's `Decay` bound from spreading,
// through the sum, onto the input.
fn echo(fb: Decay) = {
  fn stage(x: Float) with !Alloc = { prev => x + fb * prev } <~ delay(12000)
  stage
}

// A Schroeder reverberator per channel: four comb filters in parallel, then
// two allpasses in series. A comb is y[n] = x[n] + g·y[n−D]: a line D
// samples deep fed back at gain g, a train of fading reflections every D
// samples. Four combs with mutually prime lengths (29.7 to 43.7 ms at 48 kHz)
// blur into a dense tail; each gain is set so the tail falls 60 dB in about
// a second and a half.
//
// An allpass passes every frequency at unit gain and smears its phase — the
// diffusion that turns reflections into a room. Its textbook form reads the
// input D samples ago, and a `<~` site hands its body only its OWN prior, so
// the allpass is written through the comb it contains: with w[n] = x[n] +
// g·w[n−D], the allpass output is y[n] = ((1 − g²)·w[n] − x[n]) / g — the
// same transfer function, (z^−D − g) / (1 − g·z^−D), one line deep.
//
// The right room's lines are 23 samples longer than the left's, so the two
// tails never line up — the width a listener hears as space.
fn comb_sum(c1: Float, c2: Float, c3: Float, c4: Float) -> Float with Pure =
  (c1 + c2 + c3 + c4) * 0.25

fn allpass_out(w: Float, x: Float) -> Float with Pure = (0.51 * w - x) / 0.7

// The room is drawn in the verbs: the input fans to four combs (`<|`, each
// branch a cycle of its own whose line belongs to this stage's record), the
// four merge into `comb_sum`, and each allpass is the comb and the signal it
// combs, side by side, merged into `allpass_out`. No tuple is built — a
// fanout taken apart where it stands costs what its lets would — so the room
// keeps its `!Alloc`.
fn room_left() = {
  fn stage(x: Float) with !Alloc = {
    let combs = (x <| (
      { v => { prev => v + 0.872 * prev } <~ delay(1426) },
      { v => { prev => v + 0.843 * prev } <~ delay(1781) },
      { v => { prev => v + 0.828 * prev } <~ delay(1973) },
      { v => { prev => v + 0.818 * prev } <~ delay(2098) }
    )) |> comb_sum
    let d1 = (combs <| ({ v => { prev => v + 0.7 * prev } <~ delay(240) }, { v => v })) |> allpass_out
    (d1 <| ({ v => { prev => v + 0.7 * prev } <~ delay(82) }, { v => v })) |> allpass_out
  }
  stage
}

fn room_right() = {
  fn stage(x: Float) with !Alloc = {
    let combs = (x <| (
      { v => { prev => v + 0.871 * prev } <~ delay(1449) },
      { v => { prev => v + 0.842 * prev } <~ delay(1804) },
      { v => { prev => v + 0.827 * prev } <~ delay(1996) },
      { v => { prev => v + 0.817 * prev } <~ delay(2121) }
    )) |> comb_sum
    let d1 = (combs <| ({ v => { prev => v + 0.7 * prev } <~ delay(263) }, { v => v })) |> allpass_out
    (d1 <| ({ v => { prev => v + 0.7 * prev } <~ delay(105) }, { v => v })) |> allpass_out
  }
  stage
}

// The larger magnitude of two channels.
fn louder(l: Float, r: Float) -> Float with Pure = if abs(l) > abs(r) { abs(l) } else { abs(r) }

// A peak limiter over the pair: the louder channel's envelope, rising in
// about a millisecond and falling over a few hundred, and the gain that
// holds that envelope at `ceiling`. One follower for both channels, so the
// stereo image does not lean when one side peaks.
fn limiter(ceiling: Float, sr: Int) = {
  let follow = envelope_follower(800.0, 3.0, sr)
  fn stage(l: Float, r: Float) with !Alloc = {
    let env = follow(louder(l, r))
    if env > ceiling { ceiling / env } else { 1.0 }
  }
  stage
}
