// processors.mn — handler-based DSP processors
//
// Stateful DSP processors over the DSP effect the import below names.
// Named handlers enable composition: warm_filter |> peak_tracker.
// Handler-local state tracks filter memory, envelopes, peak levels.
import dsp/signal

// ── Identity processor ──────────────────────────────────────
handler passthrough {
  process(x) => resume(x),
}

// ── Peak tracker ────────────────────────────────────────────
handler peak_tracker with state = 0.0 {
  process(x) => {
    let ax = abs(x)
    let peak = if ax > state { ax } else { state }
    resume(x) with state = peak
  },
}

// ── Lowpass filter ──────────────────────────────────────────
// The inline `handle {} with` spelling is format-lifted to a named handler
// decl + `~>` install (SYNTAX.md §"Installing a handler in code": `~>` is the
// ONE install verb; handler state + arms live at the DECLARATION). `alpha` is
// a config param captured at install; `state` is the filter memory.
handler lowpass(alpha) with state = 0.0 {
  process(x) => {
    let y = state + alpha * (x - state)
    resume(y) with state = y
  },
}

// A bare op IS the function value — `process` is declared by lowpass,
// biquad AND envelope, and that ambiguity used to be fatal here because the
// reified body resolved its record by HANDLER name, which three declarers
// have no single answer to. The walk keys on the OP now, so the reified
// value means what it always meant: whichever install answers `process`
// where the closure is actually called.
fn process_lowpass(alpha, buffer) = map(process, buffer) ~> lowpass(alpha)

// ── Biquad filter ───────────────────────────────────────────
// Five config coefficients captured at install; four state cells (the two
// prior inputs + two prior outputs) are the biquad's memory.
handler biquad(b0, b1, b2, a1, a2) with y1 = 0.0, y2 = 0.0, x1 = 0.0, x2 = 0.0 {
  process(x) => {
    let y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2
    resume(y) with y1 = y, y2 = y1, x1 = x, x2 = x1
  },
}

fn process_biquad(b0, b1, b2, a1, a2, buffer) = map(process, buffer) ~> biquad(b0, b1, b2, a1, a2)

// ── Envelope follower ───────────────────────────────────────
// Asymmetric attack/release captured at install; `state` is the running
// envelope. coeff selects attack on a rising edge, release on a falling one.
handler envelope(attack, release) with state = 0.0 {
  process(x) => {
    let abs_x = abs(x)
    let coeff = if abs_x > state { attack } else { release }
    let env = state + coeff * (abs_x - state)
    resume(env) with state = env
  },
}

fn process_envelope(attack, release, buffer) = map(process, buffer) ~> envelope(attack, release)

// ── Preset handlers ─────────────────────────────────────────
handler warm_filter with state = 0.0 {
  process(x) => {
    let y = state + 0.2 * (x - state)
    resume(y) with state = y
  },
}

handler bright_filter with state = 0.0 {
  process(x) => {
    let y = state + 0.8 * (x - state)
    resume(y) with state = y
  },
}
