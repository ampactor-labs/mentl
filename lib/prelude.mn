// prelude.mn — the vocabulary
//
// The prelude is the connected set of types, effects, and operations
// every Mentl program speaks.  Option, Bool, Result, Fail — the
// algebraic vocabulary.  The Iterate effect and its handlers — every
// collection operation as a single yield/resume pattern.  Composition,
// string operations, sort, feedback specs.
//
// The imports ARE the manifest (there is no config file, ever): a user
// program's one `import prelude` pulls the whole vocabulary through the
// driver's dep walk — memory (the substrate ops), strings, lists,
// threading.
import memory

import lists

import strings

import threading

// The algebraic bedrock every program speaks.
//
// Nullary-sentinel ADT.  False=tag 0, True=tag 1 — matches WAT's
// i32 truthiness convention so `(if cond ...)` works directly.
// Both compile to (i32.const N); zero allocation.  The substrate
// has ONE story for tagged values; Bool is its canonical instance.
type Bool = False | True

// The vocabulary's own carrier type — ONE home (the wheel's types.mn
// points here; a rung linking the prelude gets the constructors the
// stage fns speak in).
type Option = None | Some(a)

type Result = Ok(a) | Err(e)

// A Float whose truncation toward zero is an Int: finite, and inside the
// range an Int holds. It is what `float_to_int` demands of its argument, the
// one conversion the machine refuses to complete, so every value handed to it
// carries the claim and a value nothing bounds pays the trap.
type Truncatable = Float where -2147483649.0 < self && self < 2147483648.0

// Failure IS an effect — the kernel's answer to bottom.  `fail` never
// resumes: its result is the never type, quantified per perform, so each
// consumer meets a variable of its own and the effect carries no
// parameter; the installed handler decides the policy (io.mn fail_exit
// prints + exits; a test handler collects instead).  Fail is distinct from
// the control-cut Abort effect: their declarations must never share
// identity.
effect Fail {
  fail(String) -> !
}

fn unwrap(opt) = match opt {
  Some(v) => v,
  None => fail("unwrap on None"),
}

fn unwrap_or(opt, default) = match opt {
  Some(v) => v,
  None => default,
}

fn is_some(opt) = match opt {
  Some(_) => true,
  None => false,
}

fn is_none(opt) = match opt {
  Some(_) => false,
  None => true,
}

fn map_option(f, opt) = match opt {
  Some(v) => Some(f(v)),
  None => None,
}

fn and_then(f, opt) = match opt {
  Some(v) => f(v),
  None => None,
}

fn ok(res) = match res {
  Ok(v) => Some(v),
  Err(_) => None,
}

fn err_val(res) = match res {
  Ok(_) => None,
  Err(e) => Some(e),
}

fn is_ok(res) = match res {
  Ok(_) => true,
  Err(_) => false,
}

fn map_result(f, res) = match res {
  Ok(v) => Ok(f(v)),
  Err(e) => Err(e),
}

// One effect.  Every collection operation is a handler on it.
effect Iterate {
  yield(element)
  // result() delivers the handler's collected value — the accumulator for
  // fold, the mapped list for map, the count for count — so its return type
  // is a type parameter, and each collection op derives its own type from
  // what its handler resumes with.
  result() -> r
}

// Flattened once, so each `xs[i]` is O(1): a list built by push or `++` is a
// snoc or concat tree, where an index read is O(i), and `list_to_flat` leaves
// a flat list as it is. The walk is a tail call, so the stack stays bounded
// at any length.
fn iterate_from(xs, i, n) = if i < n {
  yield(xs[i])
  iterate_from(xs, i + 1, n)
} else {
  ()
}

fn iterate(xs) = iterate_from(list_to_flat(xs), 0, len(xs))

// One handler per `~>` install: the transform and the collection fused into
// one state record, its buffer grown in place and sliced at `result`, so a
// collection costs O(N) in all.
handler map_collector(f) with buf = make_list(16), count = 0 {
  yield(elem) => {
    let v = f(elem)
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, v)
    resume() with buf = written, count = count + 1
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

handler filter_collector(pred) with buf = make_list(16), count = 0 {
  yield(elem) => if pred(elem) {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1
  } else {
    resume()
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

handler take_collector(n) with buf = make_list(16), count = 0, remaining = n {
  yield(elem) => if remaining > 0 {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1, remaining = remaining - 1
  } else {
    resume()
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

handler drop_collector(n) with buf = make_list(16), count = 0, skipped = 0 {
  yield(elem) => if skipped < n {
    resume() with skipped = skipped + 1
  } else {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

// General collector — for direct user use when materializing arbitrary
// yields without transform.  `{ source_emitting_yields() } ~> collector`.
handler collector with buf = make_list(16), count = 0 {
  yield(elem) => {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

// List-producing operations — single fused handler per op.
fn map(f, xs) = {
  iterate(xs)
  result()
} ~> map_collector(f)

fn filter(p, xs) = {
  iterate(xs)
  result()
} ~> filter_collector(p)

fn take(n, xs) = {
  iterate(xs)
  result()
} ~> take_collector(n)

fn drop(n, xs) = {
  iterate(xs)
  result()
} ~> drop_collector(n)

handler fold_handler(f, init) with acc = init {
  yield(elem) => resume() with acc = f(acc, elem),
  result() => resume(acc),
}

// Exhaustive over `Iterate` like its siblings: `each` collects nothing, so
// its `result` is unit (a half-handler answering `yield` alone is refused,
// E_HandlerInexhaustive — an install subtracts the WHOLE effect from the
// row). The arm resumes with the stage's answer, which `yield`'s declared
// result makes unit: the constraint `each` promises, read off the op.
handler each_handler(f) {
  yield(elem) => resume(f(elem)),
  result() => resume(),
}

handler any_handler(pred) with found = false {
  yield(elem) => if pred(elem) { resume() with found = true } else { resume() },
  result() => resume(found),
}

handler all_handler(pred) with ok = true {
  yield(elem) => if pred(elem) { resume() } else { resume() with ok = false },
  result() => resume(ok),
}

handler find_handler(pred) with found = None {
  yield(elem) => match found {
    Some(_) => resume(),
    None => if pred(elem) { resume() with found = Some(elem) } else { resume() },
  },
  result() => resume(found),
}

handler find_map_handler(f) with found = None {
  yield(elem) => match found {
    Some(_) => resume(),
    None => resume() with found = f(elem),
  },
  result() => resume(found),
}

handler count_handler(pred) with n = 0 {
  yield(elem) => if pred(elem) { resume() with n = n + 1 } else { resume() },
  result() => resume(n),
}

fn fold(init, f, xs) = {
  iterate(xs)
  result()
} ~> fold_handler(f, init)

// The stage of an iteration for effect answers `()`: the arm resumes with the
// stage's answer and `yield` answers unit, so a stage answering anything else
// is refused — a value the program would silently lose (SYNTAX, the Stage
// Law).
fn each(f, xs) = iterate(xs) ~> each_handler(f)

fn any(pred, xs) = {
  iterate(xs)
  result()
} ~> any_handler(pred)

fn all(pred, xs) = {
  iterate(xs)
  result()
} ~> all_handler(pred)

fn find(pred, xs) = {
  iterate(xs)
  result()
} ~> find_handler(pred)

// The first answer `f` gives: `f` of the first element it maps to `Some`.
fn find_map(f, xs) = {
  iterate(xs)
  result()
} ~> find_map_handler(f)

fn count(pred, xs) = {
  iterate(xs)
  result()
} ~> count_handler(pred)

fn head(xs) = xs[0]

fn rest(xs) = slice(xs, 1, len(xs))

fn reverse(xs) = fold([], (acc, x) => [x] ++ acc, xs)

fn flatten(xss) = fold([], (acc, xs) => acc ++ xs, xss)

fn flat_map(f, xs) = flatten(map(f, xs))

fn sum(xs) = fold(0, (acc, x) => acc + x, xs)

fn product(xs) = fold(1, (acc, x) => acc * x, xs)

fn concat(xss) = flatten(xss)

fn reduce(xs, f) = fold(head(xs), f, rest(xs))

// One exact-size flat buffer and one tail-recursive fill: O(min(n)) work and
// O(1) stack at any length.
fn zip_with_fill(f, xs, ys, buf, i, n) =
  if i < n { zip_with_fill(f, xs, ys, list_set(buf, i, f(xs[i], ys[i])), i + 1, n) } else { buf }

fn zip_with(f, xs, ys) = {
  let nx = len(xs)
  let ny = len(ys)
  let n = if nx < ny { nx } else { ny }
  zip_with_fill(f, list_to_flat(xs), list_to_flat(ys), make_list(n), 0, n)
}

fn zip(xs, ys) = zip_with((a, b) => (a, b), xs, ys)

fn enumerate(xs) = zip(range(0, len(xs)), xs)

fn unique(xs) = fold([], (acc, x) => if any((a) => a == x, acc) { acc } else { push(acc, x) }, xs)

fn partition(pred, xs) = (filter(pred, xs), filter((x) => !pred(x), xs))

fn range_inclusive(start, end) = range(start, end + 1)

fn intersperse(sep, xs) = if len(xs) <= 1 { xs } else { [xs[0], sep] ++ intersperse(sep, rest(xs)) }

fn scanl(xs, init, f) = if len(xs) == 0 {
  [init]
} else {
  let next = f(init, xs[0])
  [init] ++ scanl(rest(xs), next, f)
}

fn repeat(n, x) = if n <= 0 { [] } else { [x] ++ repeat(n - 1, x) }

fn chunk(n, xs) = if len(xs) == 0 { [] } else { [take(n, xs)] ++ chunk(n, drop(n, xs)) }

fn sum_by(f, xs) = fold(0, (acc, x) => acc + f(x), xs)

fn max_by(f, xs) = reduce(xs, (a, b) => if f(a) >= f(b) { a } else { b })

fn min_by(f, xs) = reduce(xs, (a, b) => if f(a) <= f(b) { a } else { b })

// compose is the pipe as a value: f first, then g, so
// `x |> compose(f, g)` is `x |> f |> g`. id is its identity element:
// compose(f, id) and compose(id, f) both behave as f.
fn compose(f, g) = (x) => g(f(x))

fn id(x) with Pure = x

fn not(x) with Pure = if x { false } else { true }

// A pipeline from a list of functions, composed left to right:
// `x |> build_pipeline([f, g, h])` is `x |> f |> g |> h`.
fn build_pipeline(steps) = fold(id, compose, steps)

fn nth(xs, n, default) = if n >= 0 && n < len(xs) { xs[n] } else { default }

fn min(a, b) with Pure = if a <= b { a } else { b }

fn max(a, b) with Pure = if a <= b { b } else { a }

fn clamp(x, lo, hi) with Pure = min(max(x, lo), hi)

// Float-typed by its own literals; an integer magnitude reads
// `if n < 0 { 0 - n } else { n }` at its own width.
fn abs(x) with Pure = if x < 0.0 { 0.0 - x } else { x }

// Two sorted lists as one, stably: a loop over a read position in each that
// writes the lesser head into one flat buffer, the left on a tie.
fn merge(xs, ys) = merge_into(make_list(len(xs) + len(ys)), xs, 0, ys, 0, 0)

fn merge_into(out, xs, i, ys, j, k) = if 0 <= i && i < len(xs) && (j < 0 || j >= len(ys) || !(ys[j] < xs[i])) {
  merge_into(list_set(out, k, xs[i]), xs, i + 1, ys, j, k + 1)
} else if 0 <= j && j < len(ys) {
  merge_into(list_set(out, k, ys[j]), xs, i, ys, j + 1, k + 1)
} else {
  out
}

// A merge sort over one flat list: each half is a slice of it read in
// constant time, and each merge writes a flat buffer the next level reads
// the same way, so the sort costs n log n and recurses only log n deep.
fn sort(xs) = sort_flat(list_to_flat(xs))

fn sort_flat(xs) = if len(xs) <= 1 {
  xs
} else {
  let mid = len(xs) / 2
  merge(sort_flat(slice(xs, 0, mid)), sort_flat(slice(xs, mid, len(xs))))
}

// The pins are the representation: with the element type free, `acc ++ sep
// ++ xs[i]` has no sequence to concatenate. The order is the Stage Law's —
// the separator first, the flowing datum last — so `names |> join(", ")`
// fills `xs`.
fn join_loop(ref xs: [String], sep: String, i, acc: String) =
  if i >= len(xs) { acc } else { join_loop(xs, sep, i + 1, acc ++ sep ++ xs[i]) }

fn join(sep: String, ref xs: [String]) =
  if len(xs) == 0 { "" } else { join_loop(xs, sep, 1, xs[0]) }

fn words(s) = split(" ", s)

fn unwords(ws) = join(" ", ws)

fn lines(s) = split("\n", s)

fn unlines(ls) = join("\n", ls)

// A string is read here through its byte-level view, `str_slice`, and
// compared byte by byte, `str_eq`.
fn starts_with(s: String, prefix: String) =
  byte_len(s) >= byte_len(prefix) && str_eq(str_slice(s, 0, byte_len(prefix)), prefix)

fn ends_with(s: String, suffix: String) =
  byte_len(s) >= byte_len(suffix) && str_eq(str_slice(s, byte_len(s) - byte_len(suffix), byte_len(s)), suffix)

fn contains(s: String, sub: String) = index_of(s, sub) >= 0

fn index_of(s: String, sub: String) = {
  let slen = byte_len(s)
  let sublen = byte_len(sub)
  fn search(i) = if i + sublen > slen {
    -1
  } else {
    if str_eq(str_slice(s, i, i + sublen), sub) { i } else { search(i + 1) }
  }
  search(0)
}

fn replace(s, old, new) = {
  let idx = index_of(s, old)
  if idx < 0 {
    s
  } else {
    str_slice(s, 0, idx) ++ new ++ replace(str_slice(s, idx + byte_len(old), byte_len(s)), old, new)
  }
}

fn trim(s) = {
  let n = byte_len(s)
  fn is_ws(b) = b == 32 || b == 9 || b == 10 || b == 13
  fn trim_left(i) = if i >= n { i } else { if is_ws(byte_at(s, i)) { trim_left(i + 1) } else { i } }
  fn trim_right(i) =
    if i <= 0 { 0 } else { if is_ws(byte_at(s, i - 1)) { trim_right(i - 1) } else { i } }
  let start = trim_left(0)
  let end = trim_right(n)
  if start >= end { "" } else { str_slice(s, start, end) }
}

fn parse_int(s) = {
  let n = byte_len(s)
  fn digit(b) = b - 48
  fn go(i, acc) = if i >= n { acc } else { go(i + 1, acc * 10 + digit(byte_at(s, i))) }
  if n > 0 && byte_at(s, 0) == 45 { 0 - go(1, 0) } else { go(0, 0) }
}

// Per SYNTAX.md §`<~`: the feedback verb's RHS is a FeedbackSpec value.
// `signal <~ delay(3)` closes a 3-sample cycle; `state <~ accumulate(s0)`
// threads a running value; `filter <~ filter_spec(n, coeffs)` feeds N
// prior outputs through coefficient taps.  The spec names WHAT flows
// back; the installed iterative handler (Sample/Tick/Clock) decides
// WHEN the cycle advances.
type FeedbackSpec = Delay(Int) | Accumulate(a) | FilterSpec(Int, [Float])

fn delay(n) = Delay(n)

fn accumulate(init) = Accumulate(init)

fn filter_spec(n, coeffs) = FilterSpec(n, coeffs)
