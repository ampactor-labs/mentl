// prelude.mn — the vocabulary
//
// The prelude is the connected set of types, effects, and operations
// every Mentl program speaks.  Option, Bool, Result, Fail — the
// algebraic vocabulary.  The Iterate effect and its handlers — every
// collection operation as a single yield/resume pattern.  Composition,
// string operations, sort, feedback specs.
//
// The imports ARE the manifest (there is no config file, ever): a user
// program's one `import prelude` pulls the whole vocabulary through the
// driver's dep walk — memory (the substrate ops), strings, lists,
// threading.  The wheel's own one-namespace concatenation reads these as
// inert statements; the driver reads them as the dep DAG.
import memory

import strings

import lists

import threading

// ─── Vocabulary Types ───────────────────────────────────────
// The algebraic bedrock every program speaks.
//
// Nullary-sentinel ADT.  False=tag 0, True=tag 1 — matches WAT's
// i32 truthiness convention so `(if cond ...)` works directly.
// Both compile to (i32.const N); zero allocation.  The substrate
// has ONE story for tagged values; Bool is its canonical instance.
type Bool = False | True

// The vocabulary's own carrier type — ONE home (the wheel's types.mn
// points here; a rung linking the prelude gets the constructors the
// stage fns speak in).
type Option = None | Some(a)

type Result = Ok(a) | Err(e)

// Failure IS an effect — the kernel's answer to bottom.  `fail` never
// resumes, so its polymorphic return unifies with any consumer; the
// installed handler decides the policy (io.mn fail_exit prints +
// exits; a test handler collects instead).  Fail is distinct from the
// control-cut Abort effect: their declarations must never share identity.
effect Fail {
  fail(String) -> a
}

fn unwrap(opt) = match opt {
  Some(v) => v,
  None => fail("unwrap on None"),
}

fn unwrap_or(opt, default) = match opt {
  Some(v) => v,
  None => default,
}

fn is_some(opt) = match opt {
  Some(_) => true,
  None => false,
}

fn is_none(opt) = match opt {
  Some(_) => false,
  None => true,
}

fn map_option(f, opt) = match opt {
  Some(v) => Some(f(v)),
  None => None,
}

fn and_then(f, opt) = match opt {
  Some(v) => f(v),
  None => None,
}

fn ok(res) = match res {
  Ok(v) => Some(v),
  Err(_) => None,
}

fn err_val(res) = match res {
  Ok(_) => None,
  Err(e) => Some(e),
}

fn is_ok(res) = match res {
  Ok(_) => true,
  Err(_) => false,
}

fn map_result(f, res) = match res {
  Ok(v) => Ok(f(v)),
  Err(e) => Err(e),
}

// ─── The Iterate Effect ─────────────────────────────────────
// One effect.  Every collection operation is a handler on it.
effect Iterate {
  yield(element)
  // result() DELIVERS the handler's collected value — the accumulator for
  // fold, [b] for map, the count for count — so its return type IS the
  // handler's result, polymorphic in `r` (the case rule; `r` = a type param).
  // Declared `-> ()` it forced every `resume(<value>)` arm to Unit, collapsing
  // fold's accumulator to () — the bug infer_seq_op existed to override.  With
  // `-> r` each collection op DERIVES its own type from its handler's resume.
  result() -> r
}

// Flatten ONCE so iterate_from's xs[i] is O(1).  map/fold/filter build their
// inputs via push/++ (snoc/concat, tags 1/3), where list_index(xs, i) is O(i)
// -> the whole iteration O(N²); it was 48.85% of the self-compile (perf,
// 2026-07-14).  list_to_flat no-ops on an already-flat list (tag 0), so flat
// inputs pay nothing; the flat copy preserves order, so every yield is
// byte-identical.
// Top-level tail-recursive iteration — no nested closure.  Lower's
// tail-call-mark-pass recognizes `iterate_from(xs, i+1, n)` as the
// tail call of the then-branch; emit produces a return_call, the
// frame doesn't accumulate.  For wheel-class lists (hundreds of
// elements), this keeps the wasm stack bounded — without this form,
// mentl2's self-compile trapped via the map handler's per-element yield recursion (one
// frame per element × handler-stack-depth).
// Declared BEFORE its caller (callee-first): a caller judged against the
// PRE-scheme reads the authored bare row (mk_ef_open of declared names),
// and that bare accumulation bakes into the caller's own published row —
// the Iterate instance args died exactly there, orphaning every
// fold-family element.  Source order kills this instance; the class
// (order-independent verdicts) is the named peer in PLAN.
fn iterate_from(xs, i, n) with Memory + Iterate = if i < n {
  yield(xs[i])
  iterate_from(xs, i + 1, n)
} else {
  ()
}

fn iterate(xs) with Iterate + Alloc + Memory = iterate_from(list_to_flat(xs), 0, len(xs))

// The range producer — every handle-walk's source. Yields lo, lo + 1, …,
// hi - 1 without materializing a list (`range_inclusive` builds one), so a
// walk over the graph's quarter-million handles allocates nothing per
// element and every collector above it — `filter_collector`, `fold_handler`,
// `each_handler` — serves unchanged. The self-call threading `lo + 1` is the
// substrate's one index loop, exactly as `iterate_from` is for lists: the
// loop lives here once, and a walk written as `{ iterate_range(0, n) …
// result() } ~> collector` is a fold, not an index-threaded self-call of
// its own (the shape `mentl audit` convicts across the wheel).
fn iterate_range(lo, hi) with Iterate = if lo < hi {
  yield(lo)
  iterate_range(lo + 1, hi)
} else {
  ()
}

// ─── Collection Operations (single fused handlers on Iterate) ────────
// One handler per `~>` install: transform + materialize fused into
// ONE state record.  The substrate-honest form per the eight interrogations:
//   Graph: one handler IS one graph node at the `~>` site.
//   Handler: single arm performs the work; no chain dispatch.
//   Verb: one `~>` install, not a chain of two.
//   Row: Iterate handled here, ownership of buf threads through state.
//   Ownership: buf owned across yields; consumed at result via slice.
//   Refinement: slice(buf, 0, count) IS the refined output.
//   Gradient: single-fused-handler form is the locked gradient state.
//   Reason: "<op>_collector for <op>" — one Reason chain per result.
//
// Chained transform→materialize handlers (Haskell-pipeline fluency)
// require evidence-passing for arm-internal performs to reach outer
// handlers — not yet substrate.  Fused single-handler form sidesteps
// that gap and IS the Mentl-canonical shape.  Buffer-counter (Ω.3)
// substrate via list_extend_to + list_set + slice keeps O(N) total
// vs the O(N²) concat-plus-element pattern (drift mode 11).
//
// Scalar-producing operations (fold, any, all, find, count, each)
// use named handlers + ~> pipe — uniform with map/filter/take/drop.
// Per Hβ.prelude-ultimate-form (2026-05-14): all iteration operations
// use the canonical ~> pipe verb form per SYNTAX.md §1466-1468.
handler map_collector(f) with buf = make_list(16), count = 0 {
  yield(elem) => {
    let v = f(elem)
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, v)
    resume() with buf = written, count = count + 1
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

handler filter_collector(pred) with buf = make_list(16), count = 0 {
  yield(elem) => if pred(elem) {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1
  } else {
    resume()
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

handler take_collector(n) with buf = make_list(16), count = 0, remaining = n {
  yield(elem) => if remaining > 0 {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1, remaining = remaining - 1
  } else {
    resume()
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

handler drop_collector(n) with buf = make_list(16), count = 0, skipped = 0 {
  yield(elem) => if skipped < n {
    resume() with skipped = skipped + 1
  } else {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

// General collector — for direct user use when materializing arbitrary
// yields without transform.  `{ source_emitting_yields() } ~> collector`.
handler collector with buf = make_list(16), count = 0 {
  yield(elem) => {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, elem)
    resume() with buf = written, count = count + 1
  },
  result() => resume(list_to_flat(slice(buf, 0, count))),
}

// List-producing operations — single fused handler per op.
fn map(f, xs) = {
  iterate(xs)
  result()
} ~> map_collector(f)

fn filter(p, xs) = {
  iterate(xs)
  result()
} ~> filter_collector(p)

fn take(n, xs) = {
  iterate(xs)
  result()
} ~> take_collector(n)

fn drop(n, xs) = {
  iterate(xs)
  result()
} ~> drop_collector(n)

// Scalar-producing operations — named handler + ~> pipe form.
// Per Hβ.prelude-ultimate-form (2026-05-14): the inline handle-block
// escape hatch is dissolved into `~>`, the one install verb (SYNTAX.md
// §«Installation»).  Named handlers + `~>` make these uniform with
// map/filter/take/drop above, and the PTee path pushes the handler
// stack and carries the row algebra `(body − E) ⊕ R` live.  Zero
// call-site changes — function signatures unchanged.
handler fold_handler(f, init) with acc = init {
  yield(elem) => resume() with acc = f(acc, elem),
  result() => resume(acc),
}

handler each_handler(f) {
  yield(elem) => {
    f(elem)
    resume()
  },
}

handler any_handler(pred) with found = false {
  yield(elem) => if pred(elem) { resume() with found = true } else { resume() },
  result() => resume(found),
}

handler all_handler(pred) with ok = true {
  yield(elem) => if pred(elem) { resume() } else { resume() with ok = false },
  result() => resume(ok),
}

handler find_handler(pred) with found = None {
  yield(elem) => match found {
    Some(_) => resume(),
    None => if pred(elem) { resume() with found = Some(elem) } else { resume() },
  },
  result() => resume(found),
}

handler count_handler(pred) with n = 0 {
  yield(elem) => if pred(elem) { resume() with n = n + 1 } else { resume() },
  result() => resume(n),
}

// Scalar-producing operations — ~> pipe with named handlers.
fn fold(init, f, xs) = {
  iterate(xs)
  result()
} ~> fold_handler(f, init)

fn each(f, xs) = iterate(xs) ~> each_handler(f)

fn any(pred, xs) = {
  iterate(xs)
  result()
} ~> any_handler(pred)

fn all(pred, xs) = {
  iterate(xs)
  result()
} ~> all_handler(pred)

fn find(pred, xs) = {
  iterate(xs)
  result()
} ~> find_handler(pred)

fn count(pred, xs) = {
  iterate(xs)
  result()
} ~> count_handler(pred)

// ─── Derived (built on the handlers above) ──────────────────
fn head(xs) = xs[0]

fn rest(xs) = slice(xs, 1, len(xs))

fn reverse(xs) = fold([], (acc, x) => [x] ++ acc, xs)

fn flatten(xss) = fold([], (acc, xs) => acc ++ xs, xss)

fn flat_map(f, xs) = flatten(map(f, xs))

fn sum(xs) = fold(0, (acc, x) => acc + x, xs)

fn product(xs) = fold(1, (acc, x) => acc * x, xs)

fn concat(xss) = flatten(xss)

fn reduce(xs, f) = fold(head(xs), f, rest(xs))

// The buffer-counter tail form (range_fill's own shape): one exact-size
// flat buffer, one tail-recursive fill — O(min(n)) work, O(1) stack.  The
// old cons-recursive form spent a non-tail frame per element and died at
// the ambient stack cliff: the wheel's own emit enumerates its fn table
// under thousands of compile frames and sat ~1,000 fns from that death
// (found 2026-08-07 by the total-twinning forensics; mn-zip-deep pins
// 200,000 on a fresh stack).  Declared callee-first (iterate_from's law).
fn zip_with_fill(f, xs, ys, buf, i, n) with Memory =
  if i < n { zip_with_fill(f, xs, ys, list_set(buf, i, f(xs[i], ys[i])), i + 1, n) } else { buf }

fn zip_with(f, xs, ys) = {
  let nx = len(xs)
  let ny = len(ys)
  let n = if nx < ny { nx } else { ny }
  zip_with_fill(f, list_to_flat(xs), list_to_flat(ys), make_list(n), 0, n)
}

fn zip(xs, ys) = zip_with((a, b) => (a, b), xs, ys)

fn enumerate(xs) = zip(range(0, len(xs)), xs)

fn unique(xs) = fold([], (acc, x) => if any((a) => a == x, acc) { acc } else { push(acc, x) }, xs)

fn partition(pred, xs) = (filter(pred, xs), filter((x) => !pred(x), xs))

fn range_inclusive(start, end) = range(start, end + 1)

fn intersperse(sep, xs) = if len(xs) <= 1 { xs } else { [xs[0], sep] ++ intersperse(sep, rest(xs)) }

fn scanl(xs, init, f) = if len(xs) == 0 {
  [init]
} else {
  let next = f(init, xs[0])
  [init] ++ scanl(rest(xs), next, f)
}

fn repeat(n, x) = if n <= 0 { [] } else { [x] ++ repeat(n - 1, x) }

fn chunk(n, xs) = if len(xs) == 0 { [] } else { [take(n, xs)] ++ chunk(n, drop(n, xs)) }

// ─── Aggregation with projection ────────────────────────────
fn sum_by(f, xs) = fold(0, (acc, x) => acc + f(x), xs)

fn max_by(f, xs) = reduce(xs, (a, b) => if f(a) >= f(b) { a } else { b })

fn min_by(f, xs) = reduce(xs, (a, b) => if f(a) <= f(b) { a } else { b })

// ─── Composition ────────────────────────────────────────────
// compose IS <> for when you need a function instead of syntax.
// id is the identity element: f <> id = f, id <> f = f.
// build_pipeline folds a list of functions into one composed pipeline.
//
// compose matches <> — f first, then g.  Left to right.
// x |> (f <> g) = x |> f |> g
fn compose(f, g) = (x) => g(f(x))

fn id(x) with Pure = x

fn not(x) with Pure = if x { false } else { true }

// Build a pipeline from a list of functions.  Fold with compose.
// build_pipeline([f, g, h]) = f <> g <> h
fn build_pipeline(steps) = fold(id, (acc, step) => (x) => step(acc(x)), steps)

// ─── Safe access ────────────────────────────────────────────
fn nth(xs, n, default) = if n >= 0 && n < len(xs) { xs[n] } else { default }

// ─── Math ───────────────────────────────────────────────────
fn min(a, b) with Pure = if a <= b { a } else { b }

fn max(a, b) with Pure = if a <= b { b } else { a }

fn clamp(x, lo, hi) with Pure = min(max(x, lo), hi)

// Float-typed by its own literals: every caller in the corpus is a dsp
// Float site, and the old `0` pins made abs Int -> Int — each forward
// call site unified Float against the LOOSE pre-scheme while the compiled
// body word-floored, so abs was an identity on negative floats (caught by
// the order-independent judge, 2026-07-25).  An integer magnitude reads
// `if n < 0 { 0 - n } else { n }` at its own width.
fn abs(x) with Pure = if x < 0.0 { 0.0 - x } else { x }

// ─── Sort (merge sort — pure, not an Iterate handler) ───────
fn merge(xs, ys) = if len(xs) == 0 {
  ys
} else {
  if len(ys) == 0 {
    xs
  } else {
    if xs[0] <= ys[0] { [xs[0]] ++ merge(rest(xs), ys) } else { [ys[0]] ++ merge(xs, rest(ys)) }
  }
}

fn sort(xs) = if len(xs) <= 1 {
  xs
} else {
  let mid = len(xs) / 2
  merge(sort(slice(xs, 0, mid)), sort(slice(xs, mid, len(xs))))
}

// ─── String operations (pure Mentl) ───────────────────────────
//
// THE PINS ARE LOAD-BEARING, and their absence shipped a RUNTIME TRAP on
// the plainest line a beginner writes: unannotated params leave the
// element type free, so `acc ++ sep ++ xs[i]` reaches `++`'s no-guess
// floor — the refusal is RIGHT (a representation cannot be guessed) and
// its FORM was an `unreachable` in shipped library code.  `join(["ab",
// "cd"], "-")` exited 134 with zero diagnostics until 2026-07-31.  The
// comment that stood here claimed "explicit str_concat threads the String
// type directly through the loop" — a repair that was never in the body;
// the Intent Boundaries below are that repair, made real.
//
// The order is the STAGE LAW's (SYNTAX §"The Stage Law"): configuration
// first, the flowing datum LAST, so `names |> join(", ")` fills `xs` and
// reads as the graph.  Datum-first, the pipe filled `sep` with the datum
// and joined the SEPARATOR by the list — silently, at exit 0.
fn join_loop(ref xs: [String], sep: String, i, acc: String) =
  if i >= len(xs) { acc } else { join_loop(xs, sep, i + 1, acc ++ sep ++ xs[i]) }

fn join(sep: String, ref xs: [String]) =
  if len(xs) == 0 { "" } else { join_loop(xs, sep, 1, xs[0]) }

fn words(s) = split(" ", s)

fn unwords(ws) = join(" ", ws)

fn lines(s) = split("\n", s)

fn unlines(ls) = join("\n", ls)

// String functions use str_slice (byte-level) not slice (list-level).
// This separation is load-bearing for WASM: the HM checker doesn't
// instantiate user-defined generic functions, so all call sites of
// `slice` share the same type variable.  If both string and list call
// sites use `slice`, the type variable unifies with the String alias, and the
// WASM lowerer dispatches list-slicing to str_slice — corrupting
// pointers.  Using str_slice here keeps `slice` list-only.
// str_eq BY NAME (the render-family precedent — the author states the
// representation): str_slice builds its view by address arithmetic, so the
// slice's word proof wins the == dispatch and the compare goes pointer-eq —
// ends_with was false for every (view, literal) pair, discovered when the
// mentl server routed every "/dir/" request to a 404 (2026-07-10).  The
// param pins alone were refuted at the artifact; §4① String=[Byte]
// dissolves the residue.
fn starts_with(s: String, prefix: String) =
  byte_len(s) >= byte_len(prefix) && str_eq(str_slice(s, 0, byte_len(prefix)), prefix)

fn ends_with(s: String, suffix: String) =
  byte_len(s) >= byte_len(suffix) && str_eq(str_slice(s, byte_len(s) - byte_len(suffix), byte_len(s)), suffix)

fn contains(s: String, sub: String) = index_of(s, sub) >= 0

fn index_of(s: String, sub: String) = {
  let slen = byte_len(s)
  let sublen = byte_len(sub)
  fn search(i) = if i + sublen > slen {
    0 - 1
  } else {
    if str_eq(str_slice(s, i, i + sublen), sub) { i } else { search(i + 1) }
  }
  search(0)
}

fn replace(s, old, new) = {
  let idx = index_of(s, old)
  if idx < 0 {
    s
  } else {
    str_slice(s, 0, idx) ++ new ++ replace(str_slice(s, idx + byte_len(old), byte_len(s)), old, new)
  }
}

fn trim(s) = {
  let n = byte_len(s)
  fn is_ws(b) = b == 32 || b == 9 || b == 10 || b == 13
  fn trim_left(i) = if i >= n { i } else { if is_ws(byte_at(s, i)) { trim_left(i + 1) } else { i } }
  fn trim_right(i) =
    if i <= 0 { 0 } else { if is_ws(byte_at(s, i - 1)) { trim_right(i - 1) } else { i } }
  let start = trim_left(0)
  let end = trim_right(n)
  if start >= end { "" } else { str_slice(s, start, end) }
}

// ─── Parsing (pure Mentl) ─────────────────────────────────────
fn parse_int(s) = {
  let n = byte_len(s)
  fn digit(b) = b - 48
  fn go(i, acc) = if i >= n { acc } else { go(i + 1, acc * 10 + digit(byte_at(s, i))) }
  if n > 0 && byte_at(s, 0) == 45 { 0 - go(1, 0) } else { go(0, 0) }
}

// ─── Feedback specs — the `<~` verb's RHS contract ──────────────────
//
// Per SYNTAX.md §`<~`: the feedback verb's RHS is a FeedbackSpec value.
// `signal <~ delay(3)` closes a 3-sample cycle; `state <~ accumulate(s0)`
// threads a running value; `filter <~ filter_spec(n, coeffs)` feeds N
// prior outputs through coefficient taps.  The spec names WHAT flows
// back; the installed iterative handler (Sample/Tick/Clock) decides
// WHEN the cycle advances.
type FeedbackSpec = Delay(Int) | Accumulate(a) | FilterSpec(Int, [Float])

fn delay(n) = Delay(n)

fn accumulate(init) = Accumulate(init)

fn filter_spec(n, coeffs) = FilterSpec(n, coeffs)
