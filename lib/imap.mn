// imap — the indexed maps (Hβ.runtime.indexed-map-primitive, §5.O).
//
// THE KEY IS A WORD. Two shapes live here and nowhere else. The wmap family
// is a bucketed map: a bucket array, a push, a scan down the bucket, keyed by
// a word that a hash of the key makes. The pt family is a COLUMN: a cell per
// handle, reached by the handle's own digits in four loads, versioned so the
// graph can be taken as a value in O(1). Everything else is a projection of
// one of the two through a key→word function. That is not a refactor of
// taste: a map keyed by anything else re-derives a word at every read, which is
// §5.O's own law ("a name is a HANDLE ... every table handle-keyed, never a
// name scan") read at the container.
//
// What varies between uses of a bucketed map is only how a key becomes a
// bucket word and how two keys compare, and both of those are projections
// rather than primitives. A second copy of either shape elsewhere in the tree
// is this law violated, however it is spelled.
//
// The smap family is the String projection: str_hash makes the bucket word, and
// the bucket keeps the name because two names can share a hash. It is NOT a
// second primitive, it is the residue of names not being handles yet — when
// they intern, the projection is the identity one and this family dissolves.
// Miss → None, distinguishing "absent" from a present empty value (Some []).
//
// Byte-identical to the linear scans it replaces: build reverse-inserts and
// prepends, so the smallest original index sits at the bucket front and
// smap_get returns the SAME first-match the O(n) scan did. The `name: String`
// pins carry the content-equality (str_eq inside the small bucket) — a bare
// `==` on the list-erased word would floor to pointer-eq, the very bug the
// crown gate shed.
//
// ─── wmap: the primitive ─────────────────────────────────────────────────
// `n` is the bucket count and MUST be a power of two — the bucket index is a
// mask, not a modulo, so a non-power-of-two silently loses the high keys.
//
// A bucket is a SNOC STACK: add pushes at the END, the reads walk down from
// the end (newest first), and wmap_pop drops the newest entry by reading the
// snoc's parent — the same push-at-END / drop_last discipline every Mentl
// stack keeps (graph_handler's checkpoint_stack). That discipline is what
// lets a trail-backed map be undone inside a speculation for nothing: the
// pop allocates nothing and the surviving bucket is the pre-add object, so
// once the rollback has run the speculation's arena finds no bucket of its
// own to move (a rebuilt bucket would be minted inside and copied out at
// the exit).
fn wmap_new(n) = list_filled(n, [])

// The key is pinned Int at every entry: the primitive's own law is that
// the key IS a word, and the pin is what makes the bucket's key compare a
// proven word compare rather than an address compare over the erased
// tuple (the unprovable-comparison class, refused now as E_ShapeUnprovable
// — the collect walk entered the wheel's count the day it gained a caller).
fn wmap_bucket(ref idx, k: Int) = i32_and(k, len(idx) - 1)

fn wmap_add(idx, k: Int, val) = {
  let b = wmap_bucket(idx, k)
  list_set(idx, b, push(list_index(idx, b), (k, val)))
}

fn wmap_get(ref idx, k: Int) = wmap_bucket_scan(list_index(idx, wmap_bucket(idx, k)), k)

// A bucket is read down its own spine, newest first: `last` and `drop_last`
// are a snoc stack's O(1) reads, so a scan costs the entries it passes.
// Indexing the bucket from its end descended the spine once per entry, and
// at the in-edges of a declaration thousands of references reach that was
// 61% of a resident session's edit (measured 2026-10-16).
fn wmap_bucket_scan(ref bucket, k: Int) = if len(bucket) == 0 {
  None
} else {
  match last(bucket) {
    (bk, val) => if bk == k { Some(val) } else { wmap_bucket_scan(drop_last(bucket), k) },
  }
}

// ONE empty result for every miss: the multi-map read runs at the graph's
// hottest writers (every row bind asks a cell for its gates and its
// notes), and a fresh `[]` per miss was an allocation that said nothing —
// the same law as effects.mn's shared empty mask. A hit pushes onto it,
// which allocates the snoc and never touches the shared list.
let wmap_none = []

// The MULTI-map read — every value entered under K, newest first,
// collected in one bucket scan: O(bucket), never O(map).
fn wmap_get_all(ref idx, k: Int) =
  wmap_bucket_collect(list_index(idx, wmap_bucket(idx, k)), k, wmap_none)

fn wmap_bucket_collect(ref bucket, k: Int, acc) = if len(bucket) == 0 {
  acc
} else {
  match last(bucket) {
    (bk, val) => wmap_bucket_collect(drop_last(bucket), k, if bk == k { push(acc, val) } else { acc }),
  }
}

// The LIFO undo: drop the newest entry, which the caller asserts was
// entered under K. Only a trail walked BACKWARD calls this, so every add
// that landed in the bucket after K's was undone first and the bucket's
// last entry is K's — a different key here is a trail out of order, and
// it traps rather than silently dropping someone else's entry.
fn wmap_pop(idx, k: Int) = {
  let b = wmap_bucket(idx, k)
  let bucket = list_index(idx, b)
  match last(bucket) {
    (bk, _) => if bk == k { 0 } else { out_of_range() },
  }
  list_set(idx, b, drop_last(bucket))
}

// ─── smap: the String projection ─────────────────────────────────────────
fn smap_new() = list_filled(4096, [])

fn smap_build(pairs) = smap_build_from(pairs, len(pairs) - 1, smap_new())

fn smap_build_from(pairs, i, idx) = if i < 0 {
  idx
} else {
  match list_index(pairs, i) {
    (name, val) => smap_build_from(pairs, i - 1, smap_add(idx, name, val)),
  }
}

fn smap_add(idx, name: String, val) = {
  let b = i32_and(str_hash(name), 4095)
  list_set(idx, b, [(name, val)] ++ list_index(idx, b))
}

fn smap_get(ref idx, name: String) = {
  let b = i32_and(str_hash(name), 4095)
  smap_bucket_scan(list_index(idx, b), name, 0)
}

fn smap_bucket_scan(ref bucket, name: String, i) = if i >= len(bucket) {
  None
} else {
  match list_index(bucket, i) {
    (bn, val) => if bn == name { Some(val) } else { smap_bucket_scan(bucket, name, i + 1) },
  }
}

// Membership alone — the read a set wants, answered without building the
// Option `smap_get` hands back, so a hot membership test allocates nothing.
fn smap_has(ref idx, name: String) = {
  let b = i32_and(str_hash(name), 4095)
  smap_bucket_has(list_index(idx, b), name, 0)
}

fn smap_bucket_has(ref bucket, name: String, i) =
  i < len(bucket) && (smap_pair_named(list_index(bucket, i), name) || smap_bucket_has(bucket, name, i + 1))

fn smap_pair_named(pair, name: String) = match pair {
  (bn, _) => bn == name,
}

// Keep the entries whose VALUE `keep` holds. A bucket with nothing to drop
// stays the object it was, so a purge allocates only where it removes —
// what lets a column drop one module's entries at the moment that module is
// superseded rather than filtering itself at every read.
fn smap_retain(idx, keep) = fold(idx, smap_bucket_retain(keep, ??, ??), range(0, len(idx)))

fn smap_bucket_retain(keep, idx, b) = {
  let bucket = list_index(idx, b)
  if all(smap_value_kept(keep, ??), bucket) {
    idx
  } else {
    list_set(idx, b, filter(smap_value_kept(keep, ??), bucket))
  }
}

fn smap_value_kept(keep, pair) = match pair {
  (_, val) => keep(val),
}

// The MULTI-map read — every value entered under NAME, newest first
// (add prepends). The reverse-edge column's read face: N smap_add calls
// per name are N bucket entries, and this collects them all in one
// bucket scan — O(bucket), never O(map).
fn smap_get_all(ref idx, name: String) = {
  let b = i32_and(str_hash(name), 4095)
  smap_bucket_collect(list_index(idx, b), name, 0, [])
}

fn smap_bucket_collect(ref bucket, name: String, i, acc) = if i >= len(bucket) {
  acc
} else {
  match list_index(bucket, i) {
    (bn, val) => smap_bucket_collect(bucket, name, i + 1, if bn == name { push(acc, val) } else { acc }),
  }
}

// ─── pt: the persistent column — one cell per handle, versioned ──────────
// A 64-way trie four levels deep: the root is a flat table that grows with
// the mint (a root slot spans 64³ handles), the three levels under it are
// pages of 64, and a leaf's slots are the cells. A read is four loads along
// the key's digits. A write lands in place when the node it reaches was
// allocated after the version's MARK and copies the node's one page into its
// parent's slot otherwise, so a version is taken by remembering the roots
// and the heap line — O(1) — a write after it costs the path it touches, and
// the version reads as it was for as long as anything holds its roots.
//
// The ownership question is asked of memory, never of a tag: a node at or
// past the mark was allocated since the version was taken, and nothing older
// can reach it, so it is the current version's own; a node below the mark
// may be shared with the version and is copied before it is written. The
// marks stack with the versions, so a version kept or dropped hands its mark
// back and the nodes made under it are written in place again.
//
// A node is a list of nodes and a leaf a list of cells, never a raw block,
// because an arena's exit moves a published root through its type and
// follows only what the type names (lib/arena.mn). A virgin child or cell is
// the zero word, the allocator's contract: a read past one answers the zero
// word of the column's own type, which `slot_present` tells from a value, and
// so does a key beyond the root.
let pt_absent_cell = make_list(1)

fn pt_absent() = list_index(pt_absent_cell, 0)

// A slot word's presence — the Option-of-handle niche read at the repr
// altitude (0 = absent, a value's word = present; a handle IS a word). The
// judgment types it `a -> Bool` (its face in the substrate table), so the
// test never pins the slot's element type onto Int; the body compares the
// word.
fn slot_present(w) with Pure = w != 0

fn pt_empty() = []

// A key's root slot, then its three digits under it.
fn pt_root_slot(k: Int) = i32_shr_u(k, 18)

fn pt_digit2(k: Int) = i32_and(i32_shr_u(k, 12), 63)

fn pt_digit1(k: Int) = i32_and(i32_shr_u(k, 6), 63)

fn pt_digit0(k: Int) = i32_and(k, 63)

// The cell at a key: four loads, each testing the node it reached.
fn pt_get(ref root, k: Int) = {
  let i3 = pt_root_slot(k)
  if i3 >= len(root) {
    pt_absent()
  } else {
    let n3 = list_index(root, i3)
    if slot_present(n3) {
      let n2 = list_index(n3, pt_digit2(k))
      if slot_present(n2) {
        let n1 = list_index(n2, pt_digit1(k))
        if slot_present(n1) { list_index(n1, pt_digit0(k)) } else { pt_absent() }
      } else {
        pt_absent()
      }
    } else {
      pt_absent()
    }
  }
}

// The column with the cell at a key written: the root as it stands when it
// and the path were the version's own, else the copied root.
fn pt_set(root, mark, k: Int, v) = {
  let i3 = pt_root_slot(k)
  let r = pt_root_owned(root, mark, i3)
  let n1 =
    pt_child_owned(pt_child_owned(pt_child_owned(r, mark, i3), mark, pt_digit2(k)), mark, pt_digit1(k))
  list_set(n1, pt_digit0(k), v)
  r
}

// At or past the mark: allocated since the version was taken, so the current
// version's own. The mark travels as the line's number — an address held in
// a version or a handler's state would be a value no arena's exit can read,
// and the exit would keep its region whole for it — and is read back as the
// address it names where the two are compared, by magnitude.
fn pt_owned(node, mark) = pt_at_or_past(addr(node), word_addr(mark))

fn pt_at_or_past(a: Addr, mark: Addr) = a >= mark

// The root, writable: grown to hold the slot (a grown table is fresh), kept
// when it is the version's own, copied otherwise.
fn pt_root_owned(root, mark, i3) = if i3 >= len(root) {
  list_extend_to(root, i3 + 1)
} else if pt_owned(root, mark) {
  root
} else {
  pt_dup(root)
}

// A child, writable: minted where none was, kept when it is the version's
// own, copied into the parent's slot otherwise. The parent is writable
// already, since every write descends from pt_root_owned.
fn pt_child_owned(parent, mark, i) = {
  let c = list_index(parent, i)
  if !slot_present(c) {
    let fresh = make_list(64)
    list_set(parent, i, fresh)
    fresh
  } else if pt_owned(c, mark) {
    c
  } else {
    let copy = pt_dup(c)
    list_set(parent, i, copy)
    copy
  }
}

// A flat copy: the same elements in a fresh list, so a store into either
// leaves the other as it was.
fn pt_dup(xs) = list_copy_into(xs, make_list(len(xs)), 0, len(xs))

// The multi-map face: a cell holds every value entered under its key, in
// the order entered, the newest last; a key nothing entered answers the one
// shared empty list, so a miss allocates nothing.
fn pt_all(ref root, k: Int) = {
  let c = pt_get(root, k)
  if slot_present(c) { c } else { wmap_none }
}

fn pt_push(root, mark, k: Int, v) = pt_set(root, mark, k, push(pt_all(root, k), v))

fn pt_newest(ref root, k: Int) = {
  let c = pt_all(root, k)
  if len(c) == 0 { None } else { Some(last(c)) }
}

// The keys below `below` whose cells differ between two versions of one
// column, ascending. A node the two versions share is skipped whole, so the
// walk costs the paths that moved; two cells differ when they are not the
// same object.
fn pt_changed(ref a, ref b, below) = fold(
  [],
  pt_changed_root(a, b, below, ??, ??),
  range(0, if len(a) > len(b) { len(a) } else { len(b) })
)

fn pt_changed_root(ref a, ref b, below, acc, i) = if i32_shl(i, 18) >= below {
  acc
} else {
  pt_changed3(pt_slot(a, i), pt_slot(b, i), below, i32_shl(i, 18), acc)
}

// The slot at i, absent past the table's end.
fn pt_slot(ref t, i) = if i < len(t) { list_index(t, i) } else { pt_absent() }

// The digits of one level, walked where two nodes differ.
let pt_digits = range(0, 64)

fn pt_changed3(na, nb, below, base, acc) = if pt_same(na, nb) {
  acc
} else {
  fold(acc, pt_changed3_at(na, nb, below, base, ??, ??), pt_digits)
}

fn pt_changed3_at(na, nb, below, base, acc, i) = if base + i32_shl(i, 12) >= below {
  acc
} else {
  pt_changed2(pt_child(na, i), pt_child(nb, i), below, base + i32_shl(i, 12), acc)
}

fn pt_changed2(na, nb, below, base, acc) = if pt_same(na, nb) {
  acc
} else {
  fold(acc, pt_changed2_at(na, nb, below, base, ??, ??), pt_digits)
}

fn pt_changed2_at(na, nb, below, base, acc, i) = if base + i32_shl(i, 6) >= below {
  acc
} else {
  pt_changed_leaf(pt_child(na, i), pt_child(nb, i), below, base + i32_shl(i, 6), acc)
}

fn pt_changed_leaf(la, lb, below, base, acc) = if pt_same(la, lb) {
  acc
} else {
  fold(acc, pt_changed_cell(la, lb, below, base, ??, ??), pt_digits)
}

fn pt_changed_cell(la, lb, below, base, acc, i) = if base + i >= below || pt_same(pt_child(la, i), pt_child(lb, i)) {
  acc
} else {
  push(acc, base + i)
}

// A child of a node, the zero word where the node is absent.
fn pt_child(n, i) = if slot_present(n) { list_index(n, i) } else { pt_absent() }

// Whether two values are one object: identity by address, compared as the
// addresses they are.
fn pt_same(x, y) = pt_same_addr(addr(x), addr(y))

fn pt_same_addr(a: Addr, b: Addr) = a == b

// Keep, in every cell, the values `keep` holds — in place: the purge runs at
// the outermost boundary, where every node is the version's own, and a cell
// with nothing to drop stays the object it was.
//
// THE STORES STAND IN THE FUNCTION THAT OWNS THE TYPE. A store into memory
// older than an open arena is journaled with the type the store knows, and
// the exit moves the value through that type (lib/arena.mn); a generic
// function's twin knows its variable's type only where the move of that
// variable reaches it — a direct call carries it, a partial application
// handed to `each` and a function handed as a parameter do not, and a
// store made through either is emitted where the type is unknown, so the
// exit keeps the region whole for it (measured 2026-10-20: 4,711 of the
// self-compile's 33,943 exits kept, 728 MB of line). So each walk below
// makes its stores in its own lambdas and reaches the level under it by a
// direct call, never by a partial or a parameter.
fn pt_retain(root, keep) = {
  root |> each({
    n3 => if slot_present(n3) {
      n3 |> each({
        n2 => if slot_present(n2) {
          n2 |> each({
            n1 => if slot_present(n1) {
              pt_digits |> each({
                i => {
                  let c = list_index(n1, i)
                  if slot_present(c) && !all(keep, c) {
                    list_set(n1, i, filter(keep, c))
                    ()
                  } else {
                    ()
                  }
                },
              })
            } else {
              ()
            },
          })
        } else {
          ()
        },
      })
    } else {
      ()
    },
  })
  root
}

// A kept version ADOPTED back into the pages it replaced. A write under a
// version copies the page it touches, and the copy is what the version's
// successor reads; dropping the version would leave the page it replaced
// where it lies, in memory older than any extent that could reclaim it, one
// orphan per page per kept round. So the keep walks the two columns where
// they differ: a replaced page at or past the enclosing version's mark is
// that version's own, and it takes the kept words in place, so the copy
// dies with the extent that made it; a replaced page below the mark is
// shared with an enclosing version and the copy stands, its children
// adopted in turn, for that version's keep to settle. A slot is written
// only where the adopted child is not the one it holds, so a shared page
// costs no journal entry. O(what the kept version wrote).
fn pt_adopt(cur, old, mark) = if pt_same(cur, old) {
  cur
} else {
  let into = if len(cur) == len(old) && pt_owned(old, mark) { old } else { cur }
  range(0, len(old)) |> each({
    i => {
      let a = pt_adopt3(list_index(cur, i), list_index(old, i), mark)
      if pt_same(a, list_index(into, i)) {
        ()
      } else {
        list_set(into, i, a)
        ()
      }
    },
  })
  into
}

fn pt_adopt3(c, o, mark) = if pt_same(c, o) || !slot_present(o) || !slot_present(c) {
  c
} else {
  let into = if pt_owned(o, mark) { o } else { c }
  pt_digits |> each({
    i => {
      let a = pt_adopt2(list_index(c, i), list_index(o, i), mark)
      if pt_same(a, list_index(into, i)) {
        ()
      } else {
        list_set(into, i, a)
        ()
      }
    },
  })
  into
}

fn pt_adopt2(c, o, mark) = if pt_same(c, o) || !slot_present(o) || !slot_present(c) {
  c
} else {
  let into = if pt_owned(o, mark) { o } else { c }
  pt_digits |> each({
    i => {
      let a = pt_adopt_leaf(list_index(c, i), list_index(o, i), mark)
      if pt_same(a, list_index(into, i)) {
        ()
      } else {
        list_set(into, i, a)
        ()
      }
    },
  })
  into
}

fn pt_adopt_leaf(c, o, mark) = if pt_same(c, o) || !slot_present(o) || !slot_present(c) {
  c
} else if pt_owned(o, mark) {
  pt_digits |> each({
    i => {
      let v = list_index(c, i)
      if pt_same(v, list_index(o, i)) {
        ()
      } else {
        list_set(o, i, v)
        ()
      }
    },
  })
  o
} else {
  c
}
