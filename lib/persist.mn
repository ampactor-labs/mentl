// persist.mn — the rooted-image persist (§4④: persist = memcpy).
//
// The image [0, heap-line) plus the mutable-global record IS the whole
// program state: wasm call frames live engine-side, outside linear memory,
// so one contiguous copy re-enters the exact address space with every
// interior pointer valid — no serializer, no relocation, no reachability
// walk. The emitter generates the module's own save/restore pair and build
// key beside $alloc (emit_image_substrate); this file owns the wire and
// its gate.
//
// ONE GATE — the build key, a refusal through Fail (the runtime policy
// decides; fail_exit prints + exits, a test handler collects): the
// image's baked words (fn table indices, interned data offsets, static
// closure addresses, the globals record layout) resolve only in the
// build that wrote them; $build_key hashes exactly those sources, so
// equal keys admit. THE FINGERPRINT CONTRACT DISSOLVED (2026-07-25,
// the resume-verb interrogation): its whole purpose was keeping the
// post-swap UNWIND valid — every dispatch bracket writes back a world
// saved before the swap — but image_resume calls the restore as a
// DIRECT SUBSTRATE OP (no effect arm, no dispatch bracket), so the one
// mid-trust-path stale write is gone; every remaining pre-swap-saved
// write fires in the benign tail (extent-ends after the last perform),
// and every post-swap dispatch walks the RESTORED $world_g — the world
// is image-resident end to end. A gate that guards nothing is deleted,
// not carried.
//
// Honest limits, named: host resources (open fds, the stdin position, live
// sockets) are not in the image and do not restore — the shim re-derives
// preopens per process; a spawning (shared-memory) module's heap line lives
// in the image at cell 64 and restores consistently, but persisting one
// mid-spawn is Phase C's fusion work, not claimed here.
import memory

import strings

import io

// A durable-branch ticket is opaque to its consumer. The handler owns the
// current in-image index representation; the effect surface preserves only the
// identity connecting `persist_branch : (() -> a) -> PersistHandle` to
// `join_persist : PersistHandle -> a`.
type PersistHandle = PersistHandle(Int)

// persist names a continuation-shaped record (closure = continuation = one
// record class) and writes the whole rooted image. The restore side is NOT
// an effect: image_resume below calls the substrate directly — an arm-form
// restore would put a dispatch bracket's pre-swap world write on the trust
// path (the dissolved fingerprint contract's whole reason to exist). The
// typed re-entry channel is any root the globals record restores (a
// top-level let the persisting process stored into); the returned address
// is the word-face belt beside it.
effect Persist {
  // THE WIRE, ALREADY PACKED, and the path to put it at. The op does not
  // take a ROOT and pack it, because packing is not policy: `persist =
  // memcpy` is the substrate operation and is identical for every handler
  // that could answer this — disk, network, a test sink. What a handler
  // chooses is WHERE the bytes go, which is what "this handler IS the disk
  // policy" already says one screen down.
  //
  // It also has to be this way, measured. image_header snapshots the globals,
  // and $world_g is one of them. Packed from inside an arm, the world it
  // captures is the arm's — which by the deep-handler law EXCLUDES the very
  // handler doing the packing. A warm run then restored a chain that could
  // not answer `persist`, and trapped at exactly that dispatch
  // (ev_declaring_node, i32.const 100764 = Persist, slot 0, pinned at
  // 0x4a589 in driver_warm_persist). Building the header at the PERFORM site captures
  // the caller's world, which still has the handler in it, so the restored
  // image can answer the op that wrote it.
  persist(String, String)
  // Fanout storage. persist_branch checkpoints the whole image before
  // invoking the branch; results join from live handler state. THE
  // RESUME BARRIER lives in the param's row: a crashed branch re-enters
  // from its wire and RE-RUNS the thunk (the SPACE=TIME fork, §4④), so
  // an external effect in the branch would fire AGAIN on replay — the
  // row severs image-external effects (WASI/Filesystem/Network; the
  // image restore rolls back Alloc/Memory but cannot un-send a packet),
  // and ordinary row checking at the argument edge is the whole gate:
  // absorb the effect before the boundary or own the replay in a
  // handler. The durable-execution field enforces exactly this
  // invariant at runtime by journal-diffing; the row proves it before
  // the first run. persist(root, path) stays word-rooted — a DATA root
  // (the warm compile's asts) replays nothing, so it carries no gate;
  // a thunk root's re-entry call is gated at its own call site.
  persist_branch(() -> a with !WASI + !Filesystem + !Network) -> PersistHandle
  join_persist(PersistHandle) -> a
}

// The restore, whole: read the wire, gate on the build key, swap the image
// in. Every wire read lands in a local before the swap; after image_restore
// returns, this process's pre-swap heap values are dead — the caller reads
// its typed roots (the restored top-level lets), never its own old heap.
fn image_resume(path) with Memory + Alloc + WASI + Fail = {
  let wire = fs_read_file_impl(path)
  let p = str_payload(wire)
  if load_i32(p) != image_key() {
    fail("persist: image key {int_to_str(load_i32(p))} is not this build ({int_to_str(image_key())})")
  } else {
    image_restore(p)
  }
}

// The wire's layout, written STREAMING — the file is the only place it is
// ever whole:
//   +0   build key      (the same-build gate)
//   +4   k              (the named record's address in the image)
//   +8   image size     (the heap line at the persist moment)
//   +12  globals count  ($image_restore's layout belt)
//   +16  globals record (8 bytes per slot; slot 0 = the heap line,
//                        patched below to the image extent so restore
//                        rewinds allocation to the persisted moment)
//   +16+8G  image bytes [0, size)
//
// THE IMAGE IS THE WIRE — nothing materializes it. A wire built by copying
// [0, size) into a fresh buffer would double the footprint to produce bytes
// that are already contiguous, which is the Carried-Truth Law at the
// persistence boundary; and the doubling is not a memory nicety, it is the
// difference between a medium that can resume its own work and one that
// cannot. Twice an image crosses the allocator's signed-2GB bound at half the
// judgment, so the largest programs — the wheel among them — fall out of the
// warm path entirely and re-derive from cold on every run. A single copy here
// costs the incremental compiler.
//
// The header stays a buffer because it is BOUNDED (16 bytes plus the globals
// record) — the same cost on a 4KB image as on a 2GB one. The image extent is
// written from address 0 through the fd that fs_create_impl exists to give
// ("for writers that emit through the fd across a long extent instead of
// banking one buffer" — its own words, written before this had a caller).
//
// The size reads FIRST: everything the persisting program built lies below it,
// and the header allocates above, so the header stays out of the extent it
// describes.
// The HEADER, built at the perform site — which is not a style choice but the
// world law above: globals_save captures $world_g, and inside an arm that
// world excludes the arm's own handler, so a restored image could not answer
// the op that wrote it. The header is what carries the globals, so the header
// is what must be built out here. The EXTENT carries no world at all — it is
// just the bytes at [0, size) — so the arm writes it, and nothing has to be
// copied to get it there.
fn image_header(k) with Memory + Alloc = {
  let size = heap_mark()
  let gsz = globals_area()
  let hdr = bytes_buf(16 + gsz)
  let p = hdr + 8
  store_i32(p, image_key())
  store_i32(p + 4, k)
  store_i32(p + 8, size)
  store_i32(p + 12, gsz / 8)
  // globals_save runs AFTER the header allocation, so slot 0 holds the bumped
  // line; the patch puts back the extent this wire actually carries, which is
  // what restore must rewind to. The old pack had the same two lines for the
  // same reason — the bump it was correcting was just image-sized.
  globals_save(p + 16)
  store_i32(p + 16, size)
  str_of_buf(hdr)
}

// The write, streaming: the header the perform site built, then the image
// extent straight from address 0. The size is READ BACK from the header at +8
// rather than re-read from heap_mark — by the time a handler runs, the line
// has moved, and the extent this wire describes is the one its own header
// states (Carried-Truth: the fact is in hand, do not re-derive it).
// A SHORT WRITE LEAVES NO IMAGE. driver_warm_ready admits a wire on two
// facts — at least 16 bytes, and a matching build key — and both of those
// live in the HEADER, so a header-only file is indistinguishable from a
// whole one to every reader. It would restore a declared extent that was
// never written: not a failed warm start, a silently wrong program.
//
// This is not hypothetical and it is not the old path's problem inherited.
// It is what this file does TODAY on the wheel, measured: the wheel's own
// judgment line is 2,268,065,808 bytes, which as a signed word is
// -2,026,901,488, so the extent write is handed a negative length, writes
// nothing, and leaves exactly that 184-byte header. The capacity gate this
// change deleted used to hide it by refusing to write at all.
//
// So the write states its own outcome and the file only survives if the
// extent it declares is the extent that landed.
fn image_write_wire(ref hdr, ref path) with Memory + Alloc + WASI = {
  let p = str_payload(hdr)
  let size = load_i32(p + 8)
  if fs_write_image_impl(path, p, byte_len(hdr), 0, size) {
    ()
  } else {
    eprint_string("warm: image not persisted — the judgment line is {int_to_str(size)} byte(s), past what one extent can carry; the next run derives cold\n")
  }
}

// The disk policy's one home — both arms write the wire through it. An
// arm's performs resolve OUTER of its own install (the world law), so an
// arm re-performing `persist` as an OP would put Persist in this
// handler's RESIDUAL — every install then honestly carried Persist to
// the root and the row gate refused programs whose only Persist handler
// was this very install. The policy is a direct write, never a re-entry.
// The write is the IMPL, not the op, and that is forced rather than lazy:
// the Filesystem effect is declared in src/types.mn, so a lib/ module
// cannot perform it and still compile standalone. The frontier's persist
// shadow leg proved it — `fs_write_file` answered E_MissingVariable at
// 3405 in the subset link the moment the op was substituted here. The
// declared `Filesystem` row above stays honest about what a caller must
// grant; the effect's own home is what keeps the op out of reach.
// Hβ.io.filesystem-impl-bypasses-the-effect carries the boundary.
// The BRANCH wire's writer, and the one place a pack still runs inside an
// arm. persist_branch checkpoints BEFORE invoking the branch, at a path
// derived from the handler's own state, so neither half can move to the
// perform site the way `persist`'s did. It therefore still records the arm's
// world — without persist_to_disk — and a branch re-entered from its wire
// inherits a chain that cannot answer the op that wrote it. That is
// `Hβ.persist.branch-world-tag` exactly, now with the measurement the peer
// never had: the same shape on the `persist` arm trapped warm-inc at
// ev_declaring_node, Persist slot 0.
fn persist_write(k, ref path) with Memory + Alloc + WASI = image_write_wire(image_header(k), path)

// persist_to_disk — the default disk policy for the rooted-image wire.
handler persist_to_disk with branch_results = [] {
  persist(wire, path) => {
    // This handler IS the disk policy — it writes through the WASI substrate
    // layer directly (the swappable point is the Persist effect itself; a
    // bare fs_write_file resolves only inside the wheel's own compile).
    // It writes the wire it was HANDED: the HEADER, built at the perform site
    // where the world still contains this handler (see the op's decl). The
    // image extent needs no world and no copy — it is already contiguous at
    // [0, size), and this streams it straight out behind the header.
    image_write_wire(wire, path)
    resume()
  },
  persist_branch(thunk) => // Checkpoint the whole image before running the branch, then retain the
  // result in this live handler activation; a crashed branch re-enters from
  // its wire (the SPACE=TIME fork, §4④).
  {
    persist_write(addr(thunk), "/tmp/mn-persist-branch-{int_to_str(len(branch_results))}.k")
    // drift-audit: ignore — thunk() is the effectful branch body; result feeds the with-clause accumulator, not chain position
    let result = thunk()
    resume(PersistHandle(len(branch_results))) with branch_results = push(branch_results, result)
  },
  join_persist(branch) => match branch {
    PersistHandle(idx) => resume(list_index(branch_results, idx)),
  },
}
