// math.mn — the transcendental functions over Float
//
// WebAssembly's f64 instructions stop at sqrt, abs, ceil, floor, trunc,
// nearest, min, max and copysign, and WASI has no math calls, so exp, log,
// sin and atan are series in Mentl, each range-reduced so a fixed count of
// terms reaches f64 precision on the reduced range, and each series is a
// fixed sequence of stages, so nothing here recurses. The instructions they
// stand on are primitives (`floor`, `sqrt`) and none of them traps, so every
// function here answers what IEEE answers at the edges and is `Pure`, which is
// what lets a real-time stage call `exp` under `!Alloc` and `!Trap`. `turn_of`,
// `sin` and `cos` take an angle below 2^53 in magnitude (`ReducibleAngle`).
//
// Float parameters are annotated `: Float` throughout. This is a
// representation PIN, not inference laziness: today the emit reads an
// UNANNOTATED float parameter at the i32 floor (§5.U's repr gradient
// reaches literals and float-forcing bodies, but not a bare `x + y`
// param), so the callee is compiled with i32 params while the caller
// pushes f64 and dispatches through a call_indirect — an "indirect call
// type mismatch" trap the moment a float fn calls another float fn.
// Annotating the parameter emits the f64 slot the gradient will one day
// infer. Named peer Hβ.emit.float-evidence-ft (PLAN §7): the gradient
// propagating a param's repr from its use makes every `: Float` here
// redundant and the annotations dissolve.
fn ln2() with Pure = 0.6931471805599453

fn pi() with Pure = 3.141592653589793

fn two_pi() -> Float with Pure = 6.283185307179586

// The positive infinity: one over zero, which a Float division answers.
fn infinity() -> Float with Pure = 1.0 / 0.0

// 2^k for an integral k, read off k's bits from the most significant: each
// stage squares the power so far and doubles or halves it where its bit is
// set. Every intermediate is a power of two no further from 1.0 than the
// answer, so each product is exact. From 1024 up the power is past the Float
// range and the answer is infinity; below -1074 it is zero; a NaN answers NaN.
fn pow2(k: Float) -> Float with Pure = if k >= 1024.0 {
  infinity()
} else if k < -1074.0 {
  0.0
} else if k >= 0.0 {
  pow2_up(k)
} else if k < 0.0 {
  pow2_down(0.0 - k)
} else {
  k
}

// 2^n for an integral n in [0, 1023]: its ten bits, from 512 down.
fn pow2_up(n: Float) -> Float with Pure =
  1.0 |> pow2_up_stage(n, 512.0, ??) |> pow2_up_stage(n, 256.0, ??) |> pow2_up_stage(n, 128.0, ??) |> pow2_up_stage(n, 64.0, ??) |> pow2_up_stage(n, 32.0, ??) |> pow2_up_stage(n, 16.0, ??) |> pow2_up_stage(n, 8.0, ??) |> pow2_up_stage(n, 4.0, ??) |> pow2_up_stage(n, 2.0, ??) |> pow2_up_stage(n, 1.0, ??)

// 2^-n for an integral n in [1, 1074]: its eleven bits, from 1024 down.
fn pow2_down(n: Float) -> Float with Pure =
  1.0 |> pow2_down_stage(n, 1024.0, ??) |> pow2_down_stage(n, 512.0, ??) |> pow2_down_stage(n, 256.0, ??) |> pow2_down_stage(n, 128.0, ??) |> pow2_down_stage(n, 64.0, ??) |> pow2_down_stage(n, 32.0, ??) |> pow2_down_stage(n, 16.0, ??) |> pow2_down_stage(n, 8.0, ??) |> pow2_down_stage(n, 4.0, ??) |> pow2_down_stage(n, 2.0, ??) |> pow2_down_stage(n, 1.0, ??)

// One stage of pow2_up: the power so far squared, then doubled where n has
// the bit of this weight.
fn pow2_up_stage(n: Float, weight: Float, power: Float) -> Float with Pure =
  if has_bit(n, weight) { power * power * 2.0 } else { power * power }

// One stage of pow2_down: the power so far squared, then halved where n has
// the bit of this weight.
fn pow2_down_stage(n: Float, weight: Float, power: Float) -> Float with Pure =
  if has_bit(n, weight) { power * power * 0.5 } else { power * power }

// Whether the integral n has the bit of this weight, a power of two.
fn has_bit(n: Float, weight: Float) -> Bool with Pure =
  floor(n / weight) - 2.0 * floor(n / (2.0 * weight)) > 0.5

// x = k·ln2 + r with k integral and r ∈ [0, ln2); exp(x) = 2^k · Σ rⁿ/n!.
// 13 terms bound the series error below f64 epsilon on [0, ln2). Above
// 709.8 the answer overflows and below −745.2 it underflows, so those ends
// answer infinity and zero; a NaN answers itself.
fn exp(x: Float) -> Float with Pure = if x < 709.8 {
  if x > -745.2 {
    let k = floor(x / ln2())
    pow2(k) * exp_series(x - k * ln2())
  } else {
    0.0
  }
} else if x >= 709.8 {
  infinity()
} else {
  x
}

// e^r for r in [0, ln2): the Taylor series to its r^13 term in Horner's
// form, 1 + r(1 + r/2(1 + … (1 + r/13))), one stage per term, the innermost
// first.
fn exp_series(r: Float) -> Float with Pure =
  1.0 |> exp_stage(r, 13.0, ??) |> exp_stage(r, 12.0, ??) |> exp_stage(r, 11.0, ??) |> exp_stage(r, 10.0, ??) |> exp_stage(r, 9.0, ??) |> exp_stage(r, 8.0, ??) |> exp_stage(r, 7.0, ??) |> exp_stage(r, 6.0, ??) |> exp_stage(r, 5.0, ??) |> exp_stage(r, 4.0, ??) |> exp_stage(r, 3.0, ??) |> exp_stage(r, 2.0, ??) |> exp_stage(r, 1.0, ??)

// One stage of exp_series: 1 + r/divisor times what the stages inside it built.
fn exp_stage(r: Float, divisor: Float, inner: Float) -> Float with Pure = 1.0 + r / divisor * inner

// ln(x). At the edges it answers what IEEE does: −∞ at zero, NaN below zero
// and for a NaN, ∞ at ∞.
fn log(x: Float) -> Float with Pure = if x > 0.0 {
  if x < infinity() { log_finite(x) } else { x }
} else if x == 0.0 {
  0.0 - infinity()
} else {
  0.0 / 0.0
}

// ln(x) for a finite positive x = m·2^k with m in [1, 2):
// k·ln2 + 2·atanh((m-1)/(m+1)). 2^-k is applied in two halves, so neither
// factor leaves the Float range.
fn log_finite(x: Float) -> Float with Pure = {
  let k = binary_exponent(x)
  let half = floor((0.0 - k) / 2.0)
  let m = x * pow2(half) * pow2(0.0 - k - half)
  k * ln2() + 2.0 * atanh_series((m - 1.0) / (m + 1.0))
}

// The largest integral k with 2^k ≤ x, for a finite positive x: twelve
// stages from weight 2048 down, starting at the smallest power, 2^-1074.
fn binary_exponent(x: Float) -> Float with Pure =
  -1074.0 |> binary_exponent_stage(x, 2048.0, ??) |> binary_exponent_stage(x, 1024.0, ??) |> binary_exponent_stage(x, 512.0, ??) |> binary_exponent_stage(x, 256.0, ??) |> binary_exponent_stage(x, 128.0, ??) |> binary_exponent_stage(x, 64.0, ??) |> binary_exponent_stage(x, 32.0, ??) |> binary_exponent_stage(x, 16.0, ??) |> binary_exponent_stage(x, 8.0, ??) |> binary_exponent_stage(x, 4.0, ??) |> binary_exponent_stage(x, 2.0, ??) |> binary_exponent_stage(x, 1.0, ??)

// One stage of binary_exponent: the weight is added where 2^(k + weight)
// still fits under x.
fn binary_exponent_stage(x: Float, weight: Float, k: Float) -> Float with Pure =
  if pow2(k + weight) <= x { k + weight } else { k }

// atanh(t) for t in [0, 1/3]: t(1 + t²/3 + t⁴/5 + … + t¹⁸/19) in Horner's
// form, ten odd terms, which reach f64 epsilon on that range.
fn atanh_series(t: Float) -> Float with Pure = {
  let t2 = t * t
  t * (1.0 / 19.0 |> atanh_stage(t2, 17.0, ??) |> atanh_stage(t2, 15.0, ??) |> atanh_stage(t2, 13.0, ??) |> atanh_stage(t2, 11.0, ??) |> atanh_stage(t2, 9.0, ??) |> atanh_stage(t2, 7.0, ??) |> atanh_stage(t2, 5.0, ??) |> atanh_stage(t2, 3.0, ??) |> atanh_stage(t2, 1.0, ??))
}

// One stage of atanh_series: 1/divisor plus t² times what the stages inside it built.
fn atanh_stage(t2: Float, divisor: Float, inner: Float) -> Float with Pure =
  1.0 / divisor + t2 * inner

// An angle one reduction step can bring into [0, 2π): below 2^53 in
// magnitude the Float grid is finer than a turn. turn_of, sin and cos take
// one, and the judgment checks it at every call.
type ReducibleAngle = Float where -9007199254740992.0 < self && self < 9007199254740992.0

// The angle reduced into [0, 2π): one step, then the corrections a rounded
// product can need.
fn turn_of(x: ReducibleAngle) -> Float with Pure =
  x - two_pi() * floor(x / two_pi()) |> at_least_zero |> below_full_turn

// A remainder just below zero, with a turn added.
fn at_least_zero(angle: Float) -> Float with Pure =
  if angle < 0.0 { angle + two_pi() } else { angle }

// An angle at or past a full turn, with a turn taken off.
fn below_full_turn(angle: Float) -> Float with Pure =
  if angle >= two_pi() { angle - two_pi() } else { angle }

// An angle in [0, 2π), moved into [-π, π).
fn within_half_turn(angle: Float) -> Float with Pure =
  if angle >= pi() { angle - two_pi() } else { angle }

fn sin(x: ReducibleAngle) -> Float with Pure = turn_of(x) |> within_half_turn |> sin_series

// sin(r) for r in [-π, π): r - r³/3! + r⁵/5! - … to the r¹⁷ term in Horner's
// form, eight alternating terms, which bound the error below f64 epsilon on
// that range.
fn sin_series(r: Float) -> Float with Pure = {
  let r2 = r * r
  r * (1.0 |> sin_stage(r2, 272.0, ??) |> sin_stage(r2, 210.0, ??) |> sin_stage(r2, 156.0, ??) |> sin_stage(r2, 110.0, ??) |> sin_stage(r2, 72.0, ??) |> sin_stage(r2, 42.0, ??) |> sin_stage(r2, 20.0, ??) |> sin_stage(r2, 6.0, ??))
}

// One stage of sin_series: 1 - r²/divisor times what the stages inside it built.
fn sin_stage(r2: Float, divisor: Float, inner: Float) -> Float with Pure =
  1.0 - r2 / divisor * inner

// (e^{2x} - 1)/(e^{2x} + 1); magnitude past 20 saturates to ±1 (e^{40}
// overflows the series' useful range while tanh is already 1.0
// to f64 precision).
fn tanh(x: Float) -> Float with Pure = if x >= 20.0 {
  1.0
} else if x < -20.0 {
  -1.0
} else {
  let e2 = exp(2.0 * x)
  (e2 - 1.0) / (e2 + 1.0)
}

// cos(x) = sin(x + π/2), with the quarter turn added after the reduction, so
// the angle the sine series reads stays in [-π, π).
fn cos(x: ReducibleAngle) -> Float with Pure =
  turn_of(x) + pi() / 2.0 |> below_full_turn |> within_half_turn |> sin_series

// ─── atan / atan2 — half-angle-reduced arctangent ───────────────────
//
// atan(x) reduces to [0, 1] by odd symmetry and the reciprocal identity
// atan(x) = π/2 − atan(1/x) for x > 1, then ONE half-angle step
// atan(x) = 2·atan(x / (1 + √(1+x²))) shrinks the argument below 0.42 —
// the plain series crawls near x = 1 (π/4 needs thousands of terms), so
// the reduction is what makes twelve odd terms reach f64 epsilon.
fn atan(x: Float) -> Float with Pure =
  if x < 0.0 { 0.0 - atan_positive(0.0 - x) } else { atan_positive(x) }

fn atan_positive(x: Float) -> Float with Pure =
  if x > 1.0 { pi() / 2.0 - atan_unit(1.0 / x) } else { atan_unit(x) }

fn atan_unit(x: Float) -> Float with Pure = 2.0 * atan_series(x / (1.0 + sqrt(1.0 + x * x)))

// atan(r) for r below 0.42: r - r³/3 + r⁵/5 - … to the r²⁵ term in Horner's
// form, twelve alternating terms.
fn atan_series(r: Float) -> Float with Pure = {
  let r2 = r * r
  r * (1.0 / 25.0 |> atan_stage(r2, 23.0, ??) |> atan_stage(r2, 21.0, ??) |> atan_stage(r2, 19.0, ??) |> atan_stage(r2, 17.0, ??) |> atan_stage(r2, 15.0, ??) |> atan_stage(r2, 13.0, ??) |> atan_stage(r2, 11.0, ??) |> atan_stage(r2, 9.0, ??) |> atan_stage(r2, 7.0, ??) |> atan_stage(r2, 5.0, ??) |> atan_stage(r2, 3.0, ??) |> atan_stage(r2, 1.0, ??))
}

// One stage of atan_series: 1/divisor minus r² times what the stages inside it built.
fn atan_stage(r2: Float, divisor: Float, inner: Float) -> Float with Pure =
  1.0 / divisor - r2 * inner

// atan2 — full-quadrant angle of (x, y). The sign of x picks the branch;
// the y sign resolves the ±π ambiguity on the negative-x half-plane and
// the ±π/2 poles where x is zero. The (0, 0) degenerate returns 0.0.
fn atan2(y: Float, x: Float) -> Float with Pure = if x > 0.0 {
  atan(y / x)
} else if x < 0.0 {
  if y >= 0.0 { atan(y / x) + pi() } else { atan(y / x) - pi() }
} else {
  if y > 0.0 { pi() / 2.0 } else if y < 0.0 { 0.0 - pi() / 2.0 } else { 0.0 }
}
