// math.mn — the transcendental functions over Float
//
// WebAssembly's f64 instructions stop at sqrt, abs, ceil, floor, trunc,
// nearest, min, max and copysign, and WASI has no math calls, so exp, log,
// sin and atan are series in Mentl, each range-reduced so a fixed count of
// terms reaches f64 precision on the reduced range. The instructions they
// stand on are primitives (`floor`, `sqrt`), and none of them reaches the one
// conversion that can trap, so every function here answers for every Float —
// at the edges what IEEE answers: a NaN gives NaN, an overflow infinity — and
// is `Pure`, which is what lets a real-time stage call `exp` under `!Alloc`
// and `!Trap`.
//
// Float parameters are annotated `: Float` throughout. This is a
// representation PIN, not inference laziness: today the emit reads an
// UNANNOTATED float parameter at the i32 floor (§5.U's repr gradient
// reaches literals and float-forcing bodies, but not a bare `x + y`
// param), so the callee is compiled with i32 params while the caller
// pushes f64 and dispatches through a call_indirect — an "indirect call
// type mismatch" trap the moment a float fn calls another float fn.
// Annotating the parameter emits the f64 slot the gradient will one day
// infer. Named peer Hβ.emit.float-evidence-ft (PLAN §7): the gradient
// propagating a param's repr from its use makes every `: Float` here
// redundant and the annotations dissolve.
fn ln2() with Pure = 0.6931471805599453

fn pi() with Pure = 3.141592653589793

fn two_pi() -> Float with Pure = 6.283185307179586

// The positive infinity: one over zero, which a Float division answers.
fn infinity() -> Float with Pure = 1.0 / 0.0

// 2^k for an integral k. Past ±1100 every power is beyond the Float range, so
// the exponent stops there and the answer is what IEEE gives, infinity or
// zero; a NaN exponent answers NaN.
fn pow2(k: Float) -> Float with Pure = if k > 1100.0 {
  power_by_squaring(2.0, 1100.0, 12)
} else if k < -1100.0 {
  power_by_squaring(0.5, 1100.0, 12)
} else if k < 0.0 {
  power_by_squaring(0.5, 0.0 - k, 12)
} else if k >= 0.0 {
  power_by_squaring(2.0, k, 12)
} else {
  k
}

// b^n for an integral n in [0, 1100] by squaring, b^n = (b^⌊n/2⌋)² · b^(n mod 2),
// so the depth is n's bit count, at most 11. `depth` counts the halvings
// left, and the 12 pow2 hands in covers every n it passes.
fn power_by_squaring(b: Float, n: Float, depth) -> Float with Pure = if n < 1.0 || depth <= 0 {
  1.0
} else {
  let half = floor(n / 2.0)
  let h = power_by_squaring(b, half, depth - 1)
  if n - 2.0 * half < 0.5 { h * h } else { b * h * h }
}

// x = k·ln2 + r with k integral and r ∈ [0, ln2); exp(x) = 2^k · Σ rⁿ/n!.
// 13 terms bound the series error below f64 epsilon on [0, ln2). Above
// 709.8 the answer overflows and below −745.2 it underflows, so those ends
// answer infinity and zero; a NaN answers itself.
fn exp(x: Float) -> Float with Pure = if x < 709.8 {
  if x > -745.2 {
    let k = floor(x / ln2())
    pow2(k) * exp_series(x - k * ln2(), 1, 1.0, 1.0)
  } else {
    0.0
  }
} else if x >= 709.8 {
  infinity()
} else {
  x
}

fn exp_series(r: Float, n: Int, term: Float, acc: Float) -> Float with Pure = if n > 13 {
  acc
} else {
  let t = term * r / float_of_int(n)
  exp_series(r, n + 1, t, acc + t)
}

// x = m·2^k with m ∈ [1, 2); ln(x) = k·ln2 + 2·atanh((m-1)/(m+1)).
// t = (m-1)/(m+1) ∈ [0, 1/3] so nine odd terms reach f64 epsilon. At the
// edges it answers what IEEE does: −∞ at zero, NaN below zero and for a
// NaN, ∞ at ∞.
fn log(x: Float) -> Float with Pure = if x > 0.0 {
  if x < infinity() { log_normalized(x, 0, 1100) } else { x }
} else if x == 0.0 {
  0.0 - infinity()
} else {
  0.0 / 0.0
}

// m brought into [1, 2) one halving or doubling at a time, k counting them.
// A finite positive m is at most 1075 doublings or 1024 halvings away, so
// the budget of 1100 steps log hands in is never spent.
fn log_normalized(m: Float, k: Int, steps) -> Float with Pure = if steps > 0 && m >= 2.0 {
  log_normalized(m / 2.0, k + 1, steps - 1)
} else if steps > 0 && m < 1.0 {
  log_normalized(m * 2.0, k - 1, steps - 1)
} else {
  let t = (m - 1.0) / (m + 1.0)
  float_of_int(k) * ln2() + 2.0 * atanh_series(t * t, 1, t, t)
}

// atanh(t) = t + t³/3 + t⁵/5 + … ; term advances by t².
fn atanh_series(t2: Float, n: Int, term: Float, acc: Float) -> Float with Pure = if n > 9 {
  acc
} else {
  let next_term = term * t2
  let odd = float_of_int(2 * n + 1)
  atanh_series(t2, n + 1, next_term, acc + next_term / odd)
}

// The angle reduced into [0, 2π). One step lands there for every |x| below
// 2^53·2π, where the Float grid is finer than a turn; past it the product
// 2π·⌊x/2π⌋ rounds whole turns away, so the step repeats, each shrinking the
// remainder by the grid's own factor. An infinity or a NaN has no angle and
// answers NaN.
fn turn_of(x: Float) -> Float with Pure = turn_within(x, 64)

// `steps` counts the reductions left: a finite x reaches [0, 2π) within a
// few dozen, so the 64 turn_of hands in is never spent.
fn turn_within(x: Float, steps) -> Float with Pure = if x >= 0.0 && x < two_pi() {
  x
} else if x - x == 0.0 && steps > 0 {
  turn_within(x - two_pi() * floor(x / two_pi()), steps - 1)
} else {
  x - x
}

// Reduce to [-π, π), then x - x³/3! + x⁵/5! - …; eight alternating terms
// bound the error below f64 epsilon on the reduced range.
fn sin(x: Float) -> Float with Pure = {
  let r0 = turn_of(x)
  let r = if r0 >= pi() { r0 - two_pi() } else { r0 }
  sin_series(r * r, 1, r, r)
}

// term advances by -r² / ((2n)(2n+1)).
fn sin_series(r2: Float, n: Int, term: Float, acc: Float) -> Float with Pure = if n > 8 {
  acc
} else {
  let d = float_of_int(2 * n * (2 * n + 1))
  let next_term = 0.0 - term * r2 / d
  sin_series(r2, n + 1, next_term, acc + next_term)
}

// (e^{2x} - 1)/(e^{2x} + 1); magnitude past 20 saturates to ±1 (e^{40}
// overflows the series' useful range while tanh is already 1.0
// to f64 precision).
fn tanh(x: Float) -> Float with Pure = if x >= 20.0 {
  1.0
} else if x < -20.0 {
  -1.0
} else {
  let e2 = exp(2.0 * x)
  (e2 - 1.0) / (e2 + 1.0)
}

// cos(x) = sin(x + π/2). The range reduction and eight-term alternating
// series live in sin; cos reads the same wheel a quarter turn along, so
// there is one trig series in the file, not two.
fn cos(x: Float) -> Float with Pure = sin(x + pi() / 2.0)

// ─── atan / atan2 — half-angle-reduced arctangent ───────────────────
//
// atan(x) reduces to [0, 1] by odd symmetry and the reciprocal identity
// atan(x) = π/2 − atan(1/x) for x > 1, then ONE half-angle step
// atan(x) = 2·atan(x / (1 + √(1+x²))) shrinks the argument below 0.42 —
// the plain series crawls near x = 1 (π/4 needs thousands of terms), so
// the reduction is what makes twelve odd terms reach f64 epsilon.
fn atan(x: Float) -> Float with Pure =
  if x < 0.0 { 0.0 - atan_positive(0.0 - x) } else { atan_positive(x) }

fn atan_positive(x: Float) -> Float with Pure =
  if x > 1.0 { pi() / 2.0 - atan_unit(1.0 / x) } else { atan_unit(x) }

fn atan_unit(x: Float) -> Float with Pure = {
  let r = x / (1.0 + sqrt(1.0 + x * x))
  2.0 * atan_series(r * r, 1, r, r)
}

// atan(r) = r − r³/3 + r⁵/5 − … ; term advances by −r².
fn atan_series(r2: Float, n: Int, term: Float, acc: Float) -> Float with Pure = if n > 12 {
  acc
} else {
  let next_term = 0.0 - term * r2
  let odd = float_of_int(2 * n + 1)
  atan_series(r2, n + 1, next_term, acc + next_term / odd)
}

// atan2 — full-quadrant angle of (x, y). The sign of x picks the branch;
// the y sign resolves the ±π ambiguity on the negative-x half-plane and
// the ±π/2 poles where x is zero. The (0, 0) degenerate returns 0.0.
fn atan2(y: Float, x: Float) -> Float with Pure = if x > 0.0 {
  atan(y / x)
} else if x < 0.0 {
  if y >= 0.0 { atan(y / x) + pi() } else { atan(y / x) - pi() }
} else {
  if y > 0.0 { pi() / 2.0 } else if y < 0.0 { 0.0 - pi() / 2.0 } else { 0.0 }
}
