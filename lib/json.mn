// json.mn — JSON parse + serialize substrate
//
// Per MV-LSP-adapter walkthrough §1 (commit 4d0fce1): JSON is the
// wire format LSP uses; this substrate is the bridge between raw
// bytes and Mentl-native ADTs. Reusable beyond LSP — web playground,
// MCP, debug adapter all compose on the same substrate.
//
// Per drift mode 8 mitigation: JSON IS string-keyed by spec; the
// JsonValue ADT immediately structures it. Downstream code matches
// on JsonValue variants, never on raw JSON text.
//
// Per kernel-closure discipline (insight #13): pure substrate;
// composition on Memory + Alloc; no new effects.
//
// A number is the Int an integer token spells (JInt), or the Float the
// medium's own reader makes of any other number (JNum), so an integer field
// (a line, a column, an id) is read as the Int it was written as. A
// `\uXXXX` escape in a string is read as the UTF-8 bytes of the character
// it names (`unicode_escape`).
import strings

// JsonValue — the canonical typed JSON representation. Six variants
// matching the JSON spec; H6 exhaustive at every match site. JObj's
// fields are List<(String, JsonValue)> tuples per Insight #9 (records-
// as-handler-state-shape) — order-preserving, lookup via linear scan
// (LSP messages are small; O(N) lookup is honest scope).
type JsonValue
  = JNull
  | JBool(Bool)
  | JInt(Int)
  | JNum(Float)
  | JStr(String)
  | JArr([JsonValue])
  | JObj([(String, JsonValue)])

// JsonResult — parser return shape. Per drift mode 9 prevention: no
// silent absorption of parse errors. Caller pattern-matches; LSP
// session loop reports JErr to the protocol; library callers handle
// recovery as they choose.
type JsonResult
  // value + new position
  = JOk(JsonValue, Int)
  // error message + position where error occurred
  | JErr(String, Int)

// ─── Byte-level predicates ────────────────────────────────────────────
//
// is_ws — JSON whitespace per spec: space (0x20), tab (0x09), newline
// (0x0A), carriage return (0x0D). H6-style explicit enumeration; no
// range arithmetic that could mask other bytes.
fn is_ws(b) with Pure = b == 32 || b == 9 || b == 10 || b == 13

// json_is_digit — ASCII '0'..'9' (0x30..0x39).
fn json_is_digit(b) with Pure = b >= 48 && b <= 57

// ─── Whitespace skip ──────────────────────────────────────────────────
//
// json_skip_ws — advance position past JSON whitespace. Tail-recursive;
// returns the position of the first non-whitespace byte (or end of
// string).
fn json_skip_ws(src, pos) = if pos >= byte_len(src) {
  pos
} else {
  let b = byte_at(src, pos)
  if is_ws(b) { json_skip_ws(src, pos + 1) } else { pos }
}

// ─── Top-level parse entry ────────────────────────────────────────────
//
// json_parse — entry point. Skip leading whitespace, dispatch to
// parse_value, return JsonResult. Trailing whitespace is permissive
// (LSP messages may have trailing whitespace within Content-Length).
fn json_parse(src) = {
  let p0 = json_skip_ws(src, 0)
  parse_value(src, p0)
}

// ─── parse_value — dispatch on first byte ─────────────────────────────
//
// parse_value — peek at the first non-whitespace byte; dispatch to
// parse_string / parse_number / parse_object / parse_array /
// parse_keyword. Per drift mode 6: explicit byte-class enumeration;
// no Bool-cased dispatch.
fn parse_value(src, pos) = if pos >= byte_len(src) {
  JErr("unexpected end of input", pos)
} else {
  let b = byte_at(src, pos)
  // "
  if b == 34 {
    parse_string(src, pos)
  }
  // {
  else if b == 123 {
    parse_object(src, pos)
  }
  // [
  else if b == 91 {
    parse_array(src, pos)
  } else if b == 116 {
    parse_keyword(src, pos, "true", JBool(true))
  } else if b == 102 {
    parse_keyword(src, pos, "false", JBool(false))
  } else if b == 110 {
    parse_keyword(src, pos, "null", JNull)
  }
  // -  or  0..9
  else if b == 45 || json_is_digit(b) {
    parse_number(src, pos)
  } else {
    JErr("unexpected byte at value position", pos)
  }
}

// ─── parse_keyword — match literal "true" / "false" / "null" ──────────
//
// parse_keyword — match the literal `kw` string at position; on
// match, return `value` and advance past the keyword. On mismatch,
// JErr. H6-via-string-comparison via byte-by-byte loop.
fn parse_keyword(src, pos, kw, value) = {
  let kw_len = byte_len(kw)
  if pos + kw_len > byte_len(src) {
    JErr("unexpected end matching keyword", pos)
  } else if keyword_matches(src, pos, kw, 0, kw_len) {
    JOk(value, pos + kw_len)
  } else {
    JErr("keyword mismatch", pos)
  }
}

fn keyword_matches(src, pos, kw, i, n) = if i >= n {
  true
} else if byte_at(src, pos + i) == byte_at(kw, i) {
  keyword_matches(src, pos, kw, i + 1, n)
} else {
  false
}

// A JSON number (-? digits (. digits)? ((e|E) (+|-)? digits)?). An integer
// token whose value an Int holds is that Int; any other number — a
// fraction, an exponent, an integer past the Int range — is the Float the
// medium's own correctly rounded reader makes of its text (`parse_float`).
fn parse_number(src, pos) = match json_scan_number(src, pos, pos, false) {
  (end, is_float) => if end == pos || end == pos + 1 && byte_at(src, pos) == 45 {
    JErr("expected number", pos)
  } else {
    JOk(json_number(str_slice(src, pos, end), is_float), end)
  },
}

fn json_number(text, is_float) = if is_float {
  JNum(parse_float(text))
} else {
  match json_int_token(text) {
    Some(n) => JInt(n),
    None => JNum(parse_float(text)),
  }
}

// The Int an integer token spells, or None past the range an Int holds. The
// magnitude accumulates below zero, where the range reaches one further, so
// the least Int reads as itself.
fn json_int_token(text) = match if byte_at(text, 0) == 45 { (true, str_slice(text, 1, byte_len(text))) } else { (false, text) } {
  (negative, digits) => match fold(Some(0), digit_below, digits) {
    Some(m) => if negative { Some(m) } else if m < -2147483647 { None } else { Some(0 - m) },
    None => None,
  },
}

// One more digit onto a magnitude held below zero, or None once it would pass
// the least Int.
fn digit_below(acc, b) = match acc {
  Some(m) => if m < -214748364 || m == -214748364 && b > 56 { None } else { Some(m * 10 - (b - 48)) },
  None => None,
}

// json_scan_number — advance past digits, optional decimal point, optional
// exponent. Returns (end_pos, is_float). Tail-recursive.
fn json_scan_number(src, start, pos, is_float) = if pos >= byte_len(src) {
  (pos, is_float)
} else {
  let b = byte_at(src, pos)
  if json_is_digit(b) {
    json_scan_number(src, start, pos + 1, is_float)
  }
  // .
  else if b == 46 {
    json_scan_number(src, start, pos + 1, true)
  }
  // leading -
  else if b == 45 && pos == start {
    json_scan_number(src, start, pos + 1, is_float)
  }
  // e or E
  else if b == 101 || b == 69 {
    json_scan_number(src, start, pos + 1, true)
  }
  // the exponent's sign, right after its marker
  else if (b == 43 || b == 45) && pos > start && (byte_at(src, pos - 1) == 101 || byte_at(src, pos - 1) == 69) {
    json_scan_number(src, start, pos + 1, is_float)
  } else {
    (pos, is_float)
  }
}

// ─── parse_string — JSON string with escape handling ──────────────────
//
// parse_string — opening `"`, then bytes until closing `"`, with
// escape sequences (\", \\, \n, \r, \t, \/, \b, \f) recognized. Per
// drift mode 9: \uXXXX Unicode escapes deferred to JSON.unicode
// peer sub-handle (rare in LSP traffic). Honest scope.
//
// Returns the unescaped String content (without quotes) on success.
fn parse_string(src, pos) = if byte_at(src, pos) != 34 {
  JErr("expected string opening quote", pos)
} else {
  scan_string_body(src, pos + 1)
}

fn scan_string_body(src, pos) = {
  let buf = bytes_buf(256)
  store_i32(buf, 0)
  let result = scan_string_loop(src, pos, buf, 0, 256)
  result
}

fn scan_string_loop(src, pos, buf, written, cap) = if pos >= byte_len(src) {
  JErr("unexpected end of string literal", pos)
} else {
  let b = byte_at(src, pos)
  if b == 34 {
    store_i32(buf, written)
    JOk(JStr(str_of_buf(buf)), pos + 1)
  } else if b == 92 {
    handle_escape(src, pos + 1, buf, written, cap)
  } else {
    match grow_buf_if_needed(buf, written, cap) {
      (buf2, cap2) => {
        store_i8(addr_at(buf2, 8 + written), b)
        scan_string_loop(src, pos + 1, buf2, written + 1, cap2)
      },
    }
  }
}

fn grow_buf_if_needed(buf, written, cap) = if written < cap {
  (buf, cap)
} else {
  let new_cap = cap * 2
  let new_buf = bytes_buf(new_cap)
  mem_copy(addr_at(new_buf, 8), addr_at(buf, 8), written)
  (new_buf, new_cap)
}

fn handle_escape(src, pos, buf, written, cap) = if pos >= byte_len(src) {
  JErr("escape sequence cut off", pos)
} else {
  let e = byte_at(src, pos)
  if e == 117 {
    unicode_escape(src, pos + 1, buf, written, cap)
  } else {
    match decode_escape(e) {
      (b_out, ok) => if ok {
        match grow_buf_if_needed(buf, written, cap) {
          (buf2, cap2) => {
            store_i8(addr_at(buf2, 8 + written), b_out)
            scan_string_loop(src, pos + 1, buf2, written + 1, cap2)
          },
        }
      } else {
        JErr("unrecognized escape sequence", pos)
      },
    }
  }
}

// `\uXXXX` — one UTF-16 code unit in four hex digits, written into the
// string as the UTF-8 bytes of the character it names. A high surrogate is
// read with the low one that must follow it (`😀` is one
// character); either half alone names no character and is refused.
fn unicode_escape(src, pos, buf, written, cap) = match hex4_at(src, pos) {
  None => JErr("a \\u escape needs four hex digits", pos),
  Some(unit) => if unit >= 55296 && unit <= 56319 {
    match low_surrogate_at(src, pos + 4) {
      Some(low) => write_code_point(src, pos + 10, 65536 + (unit - 55296) * 1024 + (low - 56320), buf, written, cap),
      None => JErr("a high surrogate escape is not followed by its low half", pos),
    }
  } else if unit >= 56320 && unit <= 57343 {
    JErr("a low surrogate escape has no high half before it", pos)
  } else {
    write_code_point(src, pos + 4, unit, buf, written, cap)
  },
}

// The value of the four hex digits at `pos`, or None where one is missing.
fn hex4_at(src, pos) = if pos + 4 > byte_len(src) {
  None
} else {
  let a = byte_at(src, pos)
  let b = byte_at(src, pos + 1)
  let c = byte_at(src, pos + 2)
  let d = byte_at(src, pos + 3)
  if is_hex_byte(a) && is_hex_byte(b) && is_hex_byte(c) && is_hex_byte(d) {
    Some(((hex_val(a) * 16 + hex_val(b)) * 16 + hex_val(c)) * 16 + hex_val(d))
  } else {
    None
  }
}

// The low half of a surrogate pair, written as the `\uXXXX` at `pos`.
fn low_surrogate_at(src, pos) = if pos + 6 <= byte_len(src) && byte_at(src, pos) == 92 && byte_at(src, pos + 1) == 117 {
  match hex4_at(src, pos + 2) {
    Some(low) => if low >= 56320 && low <= 57343 { Some(low) } else { None },
    None => None,
  }
} else {
  None
}

// A character's UTF-8 bytes appended to the string being read; the scan
// resumes after the escape.
fn write_code_point(src, next, cp, buf, written, cap) = match utf8_bytes(cp) |> fold((buf, written, cap), append_byte) {
  (buf2, written2, cap2) => scan_string_loop(src, next, buf2, written2, cap2),
}

fn append_byte(acc, b) = match acc {
  (buf, written, cap) => match grow_buf_if_needed(buf, written, cap) {
    (buf2, cap2) => {
      store_i8(addr_at(buf2, 8 + written), b)
      (buf2, written + 1, cap2)
    },
  },
}

// The UTF-8 bytes of a code point: one byte below 128, then two, three or
// four, each byte after the first carrying six of its bits.
fn utf8_bytes(cp) = if cp < 128 {
  [cp]
} else if cp < 2048 {
  [192 + cp / 64, 128 + cp % 64]
} else if cp < 65536 {
  [224 + cp / 4096, 128 + cp / 64 % 64, 128 + cp % 64]
} else {
  [240 + cp / 262144, 128 + cp / 4096 % 64, 128 + cp / 64 % 64, 128 + cp % 64]
}

// decode_escape — map escape character to its byte. Returns
// (byte, ok), over the eight one-byte escape codes; `\u` names a
// character and is read before this (`unicode_escape`).
//
// \"
fn decode_escape(e) = if e == 34 {
  (34, true)
}
// \\
else if e == 92 {
  (92, true)
}
// \/
else if e == 47 {
  (47, true)
}
// \n
else if e == 110 {
  (10, true)
}
// \r
else if e == 114 {
  (13, true)
}
// \t
else if e == 116 {
  (9, true)
}
// \b
else if e == 98 {
  (8, true)
}
// \f
else if e == 102 {
  (12, true)
} else {
  (0, false)
}

// ─── parse_array — JSON array → JArr([JsonValue]) ─────────────────
//
// parse_array — opening `[`, comma-separated values, closing `]`.
// Empty array `[]` returns JArr([]). Per drift mode 11: cons-prepend
// during parse, reverse before return (avoids O(N²) loop append).
fn parse_array(src, pos) = if byte_at(src, pos) != 91 {
  JErr("expected array opening bracket", pos)
} else {
  let p0 = json_skip_ws(src, pos + 1)
  if p0 < byte_len(src) && byte_at(src, p0) == 93 {
    JOk(JArr([]), p0 + 1)
  } else {
    parse_array_elements(src, p0, [])
  }
}

fn parse_array_elements(src, pos, acc_rev) = match parse_value(src, pos) {
  JErr(m, p) => JErr(m, p),
  JOk(v, p1) => {
    let p2 = json_skip_ws(src, p1)
    if p2 >= byte_len(src) {
      JErr("unexpected end in array", p2)
    } else {
      let next_acc = [v] ++ acc_rev
      let b = byte_at(src, p2)
      if b == 93 {
        JOk(JArr(reverse(next_acc)), p2 + 1)
      } else if b == 44 {
        let p3 = json_skip_ws(src, p2 + 1)
        parse_array_elements(src, p3, next_acc)
      } else {
        JErr("expected ',' or ']' in array", p2)
      }
    }
  },
}

// ─── parse_object — JSON object → JObj(List<(String, JsonValue)>) ─────
//
// parse_object — opening `{`, comma-separated `"key": value` pairs,
// closing `}`. Empty object `{}` returns JObj([]). Same cons-then-
// reverse pattern as arrays.
fn parse_object(src, pos) = if byte_at(src, pos) != 123 {
  JErr("expected object opening brace", pos)
} else {
  let p0 = json_skip_ws(src, pos + 1)
  if p0 < byte_len(src) && byte_at(src, p0) == 125 {
    JOk(JObj([]), p0 + 1)
  } else {
    parse_object_pairs(src, p0, [])
  }
}

fn parse_object_pairs(src, pos, acc_rev) = match parse_string(src, pos) {
  JErr(m, p) => JErr(m, p),
  JOk(key_val, p1) => {
    let key = match key_val {
      JStr(s) => s,
      JNull => "",
      JBool(_) => "",
      JInt(_) => "",
      JNum(_) => "",
      JArr(_) => "",
      JObj(_) => "",
    }
    let p2 = json_skip_ws(src, p1)
    if p2 >= byte_len(src) || byte_at(src, p2) != 58 {
      JErr("expected ':' after object key", p2)
    } else {
      let p3 = json_skip_ws(src, p2 + 1)
      match parse_value(src, p3) {
        JErr(m, p) => JErr(m, p),
        JOk(v, p4) => {
          let p5 = json_skip_ws(src, p4)
          if p5 >= byte_len(src) {
            JErr("unexpected end in object", p5)
          } else {
            let next_acc = [(key, v)] ++ acc_rev
            let b = byte_at(src, p5)
            if b == 125 {
              JOk(JObj(reverse(next_acc)), p5 + 1)
            } else if b == 44 {
              let p6 = json_skip_ws(src, p5 + 1)
              parse_object_pairs(src, p6, next_acc)
            } else {
              JErr("expected ',' or '\}' in object", p5)
            }
          }
        },
      }
    }
  },
}

// ─── reverse_list — utility for cons-then-reverse pattern ─────────────
// ─── json_serialize — JsonValue → canonical JSON String ───────────────
//
// json_serialize — entry point. Canonical formatting: no extra
// whitespace, no trailing newlines. Object keys appear in their
// JObj list order (per Insight #9 record-shape: order is data, not
// formatting choice). Reusable for any consumer wanting JSON output.
fn json_serialize(v) = match v {
  JNull => "null",
  JBool(true) => "true",
  JBool(false) => "false",
  JInt(n) => int_to_str(n),
  JNum(n) => float_to_str(n),
  JStr(s) => serialize_string(s),
  JArr(items) => serialize_array(items),
  JObj(fields) => serialize_object(fields),
}

fn serialize_string(s) = "\"{escape_string(s)}\""

// escape_string — the JSON spelling of a byte string: the bytes RFC 8259
// requires escaped (quote, reverse solidus, every control byte) take their
// escape, and the rest stand as themselves. Two passes as topology, the
// str_escape form: a fold counts the escaped length for the one
// allocation, then `each` streams every byte's spelling into the ByteSink
// whose cursor is the handler's state. The buffer is the length it needs,
// so no pass grows it.
fn escape_string(s) = {
  let ptr = s |> fold(0, json_escape_len_acc) |> bytes_buf
  s |> each(json_escape_emit) ~> byte_sink(ptr)
  str_of_buf(ptr)
}

fn json_escape_len_acc(acc, b) with Pure = acc + json_escape_len(b)

// The short escapes are two bytes; any other control byte is the six-byte
// `\u00XX`; everything else is itself.
fn json_escape_len(b) with Pure =
  if b == 34 || b == 92 || b == 10 || b == 13 || b == 9 { 2 } else if b < 32 { 6 } else { 1 }

fn json_escape_emit(b) = {
  let k = json_escape_len(b)
  if k == 1 {
    emit_byte(b)
  } else if k == 2 {
    emit_byte(92)
    emit_byte(json_escape_tail(b))
  } else {
    emit_byte(92)
    emit_byte(117)
    emit_byte(48)
    emit_byte(48)
    emit_byte(hex_nibble(i32_and(b / 16, 15)))
    emit_byte(hex_nibble(i32_and(b, 15)))
  }
}

// The letter after the backslash of a two-byte escape.
fn json_escape_tail(b) with Pure =
  if b == 10 { 110 } else if b == 13 { 114 } else if b == 9 { 116 } else { b }

fn serialize_array(items) = "[{serialize_array_inner(items, 0, len(items), "")}]"

fn serialize_array_inner(items, i, n, acc) = if i >= n {
  acc
} else {
  let item = list_index(items, i)
  let item_str = json_serialize(item)
  let sep = if i == 0 { "" } else { "," }
  let next_acc = acc ++ sep ++ item_str
  serialize_array_inner(items, i + 1, n, next_acc)
}

fn serialize_object(fields) = "\{{serialize_object_inner(fields, 0, len(fields), "")}\}"

fn serialize_object_inner(fields, i, n, acc) = if i >= n {
  acc
} else {
  let pair = list_index(fields, i)
  match pair {
    (key, value) => {
      let pair_str = "{serialize_string(key)}:{json_serialize(value)}"
      let sep = if i == 0 { "" } else { "," }
      let next_acc = acc ++ sep ++ pair_str
      serialize_object_inner(fields, i + 1, n, next_acc)
    },
  }
}

// ─── Lookup helpers (consumed by lsp_adapter and other JSON consumers) ─
//
// json_obj_get — find a field by key in a JObj. Returns Option(JsonValue).
// Linear scan; LSP messages are small. H6 over JsonValue (JObj only;
// other variants return None as type-safety).
fn json_obj_get(v, key) = match v {
  JObj(fields) => json_obj_get_loop(fields, key, 0, len(fields)),
  JNull => None,
  JBool(_) => None,
  JInt(_) => None,
  JNum(_) => None,
  JStr(_) => None,
  JArr(_) => None,
}

fn json_obj_get_loop(fields, key, i, n) = if i >= n {
  None
} else {
  let pair = list_index(fields, i)
  match pair {
    (k, v) => if k == key { Some(v) } else { json_obj_get_loop(fields, key, i + 1, n) },
  }
}

// json_str_or_default — extract String from JStr; default for other variants.
// Convenience for LSP param extraction.
fn json_str_or_default(v, default) with Pure = match v {
  JStr(s) => s,
  JNull => default,
  JBool(_) => default,
  JInt(_) => default,
  JNum(_) => default,
  JArr(_) => default,
  JObj(_) => default,
}

// json_int_or_default — the Int an integer token spelled; default for every
// other value, a number written with a fraction or an exponent among them.
// LSP integer fields (line/character/version/id) route through the helper.
fn json_int_or_default(v, default) with Pure = match v {
  JInt(n) => n,
  JNum(_) => default,
  JNull => default,
  JBool(_) => default,
  JStr(_) => default,
  JArr(_) => default,
  JObj(_) => default,
}
