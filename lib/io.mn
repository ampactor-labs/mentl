// io.mn — I/O primitives for the Mentl runtime
//
// All I/O routes through the WASI effect (declared below — the host
// boundary IS an effect; the host runtime IS its handler).
// No print-via-syscall magic. No fd_write call sites scattered
// across the compiler. All of it lives here, behind named functions.
//
// EVERY syscall's argument record — iov, nwritten/nread cell, filestat,
// prestat, fd-out cell — allocs per use from the one bump image. The
// record's lifetime IS the call, and the never-freeing image absorbs
// the droplets (net.mn's precedent). There is NO static scratch: the
// old page-0 map (iov 0x50, print 0x60, fs path 0x100, filestat 0x200,
// fd 0x240) was an unaccounted allocation evading the Alloc row, and
// its baked addresses clobbered a real record the day the layout
// shifted (the ev_scan fn_ptr smash, 2026-07-10). Page 0 belongs to
// the substrate (the sentinel space + the thread-record region); the
// runtime owns no address it did not alloc.
//
// Paths cross the boundary as (ptr, len) views straight into the
// string's payload bytes (fs_path_view) — WASI preview1 paths are
// explicit-length, never NUL-terminated, so copying them anywhere
// first would re-derive bytes the image already holds contiguously.
//
// Effects declared in std/compiler/types.mn — not re-declared here.
//
// FS constants (WASI preview1 flags). Mirrored literally from the
// WASI spec; documented here to avoid magic numbers at call sites.
//   dir preopen fd        — read LIVE from the preopen table (fs_dir_fd;
//                           a tcplisten socket may occupy fd 3 first)
//   FS_RIGHTS_READ        = 0x2 — fd_read right
//   FS_RIGHTS_WRITE       = 0x40 — fd_write right
//   FS_OFLAGS_CREAT       = 0x1 — create if not exists
//   FS_OFLAGS_TRUNC       = 0x8 — truncate to zero on open
import types

import strings

// ─── The WASI effect — the host boundary IS an effect ─────────
//
// Every op mirrors a WASI preview1 import 1:1; the host runtime IS
// the handler (lower maps each op to its `wasi_snapshot_preview1`
// import — the import IS the handler install). Errno returns are
// Int per the WASI ABI; refinement of errno spaces is Verify's
// post-L2 work.
effect WASI {
  fd_write(Int, Int, Int, Int) -> Int
  fd_read(Int, Int, Int, Int) -> Int
  fd_close(Int) -> Int
  fd_prestat_get(Int, Int) -> Int
  fd_prestat_dir_name(Int, Int, Int) -> Int
  fd_fdstat_get(Int, Int) -> Int
  fd_readdir(Int, Int, Int, Int, Int) -> Int
  path_open(Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Int
  path_create_directory(Int, Int, Int) -> Int
  path_filestat_get(Int, Int, Int, Int, Int) -> Int
  path_unlink_file(Int, Int, Int) -> Int
  path_rename(Int, Int, Int, Int, Int, Int) -> Int
  // The socket pair (2026-07-10, mentl serves natively): the host preopens
  // the LISTENER (wasmtime -S tcplisten); sock_accept yields a connection fd
  // the fd_* ops above already speak; poll_oneoff is the honest blocking
  // wait both nonblocking ends demand (lib/net.mn wraps them).
  sock_accept(Int, Int, Int) -> Int
  poll_oneoff(Int, Int, Int, Int) -> Int
  args_sizes_get(Int, Int) -> Int
  args_get(Int, Int) -> Int
  proc_exit(Int)
}

// wasi_args — the process argv as a [String], read live from the host at
// _start. This is what makes the CLI real: without it _start handed main a
// len-0 list and every `mentl <verb>` fell through to compile-stdin
// (Hβ.emit.wasi-argv-in-start). args_sizes_get writes (argc, total-byte-size);
// args_get writes the argv pointer array + the null-terminated string buffer;
// each argv[i] is a C-string materialized into a flat [len][bytes] Mentl string
// (the read_stdin buffer→string layout). argv[0] is the program name, so the
// self-compile (`m2 < wheel`, argc=1) still parses to VCompileStdin (len < 2).
fn cstr_len(cstr, i) with Memory = if load_i8(cstr + i) == 0 { i } else { cstr_len(cstr, i + 1) }

fn cstr_to_string(cstr) with Memory + Alloc = {
  let n = cstr_len(cstr, 0)
  let s = bytes_buf(n)
  mem_copy(s + 8, cstr, n)
  str_of_buf(s)
}

fn wasi_args_build(argv_ptr, argc, i, acc) with Memory + Alloc = if i >= argc {
  acc
} else {
  let cstr = load_i32(argv_ptr + i * 4)
  wasi_args_build(argv_ptr, argc, i + 1, push(acc, cstr_to_string(cstr)))
}

fn wasi_args() with Memory + Alloc + WASI = {
  let argc_ptr = alloc(4)
  let bufsz_ptr = alloc(4)
  args_sizes_get(argc_ptr, bufsz_ptr)
  let argc = load_i32(argc_ptr)
  let argv_ptr = alloc(argc * 4)
  let buf = alloc(load_i32(bufsz_ptr))
  args_get(argv_ptr, buf)
  wasi_args_build(argv_ptr, argc, 0, make_list(0))
}

// ─── The Console effect — narration's output boundary ─────────
//
// The medium's voice performs `print`; WHERE it lands is the
// installed handler's decision. stdout_console routes to fd 1;
// sibling handlers (buffer_console for tests, lsp_console for the
// LSP transport) swap without touching the narrating code.
effect Console {
  print(String)
}

handler stdout_console {
  print(msg) => {
    print_string(msg)
    resume()
  },
}

// ─── fail_exit — the host-boundary failure policy ──────────────
//
// Fail.fail never resumes; this handler prints the message and
// exits through the WASI host. A test handler can swap in to
// collect failures instead — the policy is the install, not the
// call site.
handler fail_exit {
  fail(msg) => {
    print_string(msg)
    print_newline()
    proc_exit(1)
  },
}

// ─── The one syscall-marshal pair ──────────────────────────────
//
// fd_write_bytes — ONE fd_write over the contiguous span [ptr, ptr+len).
// The iov + nwritten record is the syscall's argument marshaling,
// alloc'd per call: [ptr@0][len@4][nwritten@8]. Returns the host's
// bytes-written count; the print family discards it (a stdout short-
// write has no recovery worth a loop at this altitude), stream writers
// that must drain loop on it (net.mn's sock_write_all owns the socket
// contract — partial writes + EAGAIN — so it marshals its own).
fn fd_write_bytes(fd, ptr, len) with Memory + Alloc + WASI = {
  let iov = alloc(12)
  store_i32(iov, ptr)
  store_i32(iov + 4, len)
  fd_write(fd, iov, 1, iov + 8)
  load_i32(iov + 8)
}

// read_chunk — ONE fd_read of up to `size` bytes into buf. The twin
// marshal record: [ptr@0][len@4][nread@8]. Returns bytes actually
// read (0 = EOF).
fn read_chunk(fd, buf, size) with Memory + Alloc + WASI = {
  let iov = alloc(12)
  store_i32(iov, buf)
  store_i32(iov + 4, size)
  fd_read(fd, iov, 1, iov + 8)
  load_i32(iov + 8)
}

// Stdout
//
// print_string — write a Mentl string to stdout (fd=1). Io IS the
// materialization boundary in the gradient: str_payload flattens a
// rope/slice (and repacks a wider-stride byte record) to the contiguous
// stride-1 span the syscall wants; a flat string passes through untouched.
fn print_string(s) with Memory + Alloc + WASI = {
  fd_write_bytes(1, str_payload(s), byte_len(s))
  ()
}

// print_int — convert n to a decimal string and write to stdout.
fn print_int(n) with Memory + Alloc + WASI = {
  let s = int_to_str(n)
  print_string(s)
}

// print_newline — write a single newline character (0x0A) to stdout.
fn print_newline() with Memory + Alloc + WASI = {
  let cell = alloc(1)
  store_i8(cell, 10)
  fd_write_bytes(1, cell, 1)
  ()
}

// println — write a string + newline to stdout.
fn println(s) with Memory + Alloc + WASI = {
  print_string(s)
  print_newline()
}

// Stderr
//
// eprint_string — write a Mentl string to stderr (fd=2). The same
// str_payload materialization boundary print_string reads.
fn eprint_string(s) with Memory + Alloc + WASI = {
  fd_write_bytes(2, str_payload(s), byte_len(s))
  ()
}

// Stdin
//
// fd_read_all — slurp an fd to EOF into a heap-allocated flat string.
// Reads into a raw doubling byte buffer, then materializes one flat
// [count][tag][bytes] byte record (bytes_buf). ONE loop serves stdin
// (read_stdin) and opened files (fs_read_file_impl) — the stream does
// not care where the fd came from.
fn fd_read_all(fd) with Memory + Alloc + WASI = {
  let initial_cap = 65536
  let buf = alloc(initial_cap)
  match fd_read_loop(fd, buf, 0, initial_cap) {
    (final_buf, total) => {
      let str = bytes_buf(total)
      mem_copy(str + 8, final_buf, total)
      str_of_buf(str)
    },
  }
}

fn fd_read_loop(fd, buf, offset, capacity) with Memory + Alloc + WASI = {
  let chunk_size = 65536
  match if offset + chunk_size > capacity {
    let new_cap = capacity * 2
    let new_buf = alloc(new_cap)
    mem_copy(new_buf, buf, offset)
    (new_buf, new_cap)
  } else {
    (buf, capacity)
  } {
    (cur_buf, cur_cap) => {
      let nread = read_chunk(fd, cur_buf + offset, chunk_size)
      if nread == 0 { (cur_buf, offset) } else { fd_read_loop(fd, cur_buf, offset + nread, cur_cap) }
    },
  }
}

// read_stdin — slurp all of stdin (fd 0). The compiler's input path.
fn read_stdin() with Memory + Alloc + WASI = fd_read_all(0)

// read_one_byte — read exactly 1 byte from stdin. Returns the byte
// value (0..255) or -1 on EOF. Substrate primitive for boundary-
// scanning reads (line endings, LSP \r\n headers) where the consumer
// can't know the boundary until it sees the byte. Honest: per-byte
// syscalls are slow for bulk data but correct for interactive prompts
// and ~50-byte header sections; bulk paths use read_chunk directly.
fn read_one_byte() with Memory + Alloc + WASI = {
  let cell = alloc(1)
  let nread = read_chunk(0, cell, 1)
  if nread == 0 { 0 - 1 } else { load_i8(cell) }
}

// read_stdin_line — read one line from stdin (interactive-prompt
// discipline: one human action per line). Accumulates bytes until
// 0x0A or EOF; the newline is consumed, not returned. Returns a flat
// [count][tag][bytes] Mentl string.
fn read_stdin_line() with Memory + Alloc + WASI = {
  let initial_cap = 256
  let buf = alloc(initial_cap)
  match read_line_loop(buf, 0, initial_cap) {
    (final_buf, total) => {
      let str = bytes_buf(total)
      mem_copy(str + 8, final_buf, total)
      str_of_buf(str)
    },
  }
}

fn read_line_loop(buf, offset, capacity) with Memory + Alloc + WASI = match if offset + 1 > capacity {
  let new_cap = capacity * 2
  let new_buf = alloc(new_cap)
  mem_copy(new_buf, buf, offset)
  (new_buf, new_cap)
} else {
  (buf, capacity)
} {
  (cur_buf, cur_cap) => {
    let b = read_one_byte()
    if b < 0 {
      (cur_buf, offset)
    } else {
      if b == 10 {
        (cur_buf, offset)
      } else {
        store_i8(cur_buf + offset, b)
        read_line_loop(cur_buf, offset + 1, cur_cap)
      }
    }
  },
}

// Filesystem (FS) — impl functions bridging the Filesystem effect
// ops to WASI path_* syscalls. Each takes a String path and hands the
// syscall a (ptr, len) view straight into the string's payload.
//
// fs_path_view — the (ptr, len) span a path_* syscall reads, pointing
// STRAIGHT at the string's payload bytes in the image. WASI preview1
// paths carry explicit lengths; str_payload materializes a rope/slice
// exactly here, and a flat path is zero-copy — the bytes already sit
// where the syscall wants them.
fn fs_path_view(s) with Memory + Alloc = (str_payload(s), byte_len(s))

// fs_dir_fd — the preopened DIRECTORY's fd, read live from the preopen
// table: fd_prestat_get answers 0 with tag 0 (dir) for a dir preopen; a
// tcplisten socket occupying a slot refuses. The table's ORDER is the
// host invocation's business, never a baked constant — the listener
// stole fd 3 the first time mentl served with both preopens (2026-07-10)
// and every path syscall hit the socket. Scan exhausted = no dir
// preopened: return the first slot so the syscall itself errors loudly.
fn fs_dir_fd() with Memory + Alloc + WASI = fs_dir_fd_from(3)

fn fs_dir_fd_from(fd) with Memory + Alloc + WASI = if fd >= 16 {
  3
} else {
  let prestat = alloc(8)
  if fd_prestat_get(fd, prestat) == 0 && load_i8(prestat) == 0 { fd } else { fs_dir_fd_from(fd + 1) }
}

// fs_at — the ONE path resolution every fs syscall reads: (dir_fd,
// path_ptr, path_len). The preopen table IS the mount table (Carried-Truth
// at the WASI layer): an ABSOLUTE path resolves to the preopen whose guest
// name is its LONGEST prefix (the wasi-libc rule), opened relative with the
// prefix stripped — what makes the install shim's `--dir lib::/mentl-lib`
// mapping reachable, so a user project's vocabulary imports resolve from any
// directory. A relative path opens against the FIRST dir preopen (the shim
// preopens the caller's cwd first); no prefix match falls to the first dir
// so the syscall itself errors loudly, exactly as fs_dir_fd always did.
fn fs_at(path_str) with Memory + Alloc + WASI = match fs_path_view(path_str) {
  (pp, plen) => if plen == 0 || load_i8(pp) != 47 {
    (fs_dir_fd(), pp, plen)
  } else {
    match fs_best_preopen(pp, plen, 3, 0, 0) {
      (best_fd, best_len) => if best_fd == 0 {
        (fs_dir_fd(), pp, plen)
      } else {
        let skip = if best_len < plen && load_i8(pp + best_len) == 47 { best_len + 1 } else { best_len }
        (best_fd, pp + skip, plen - skip)
      },
    }
  },
}

// The longest-prefix scan over the preopen table (dir fds live in 3..16;
// fd 0 is the no-match sentinel — a real dir preopen is never below 3).
fn fs_best_preopen(pp, plen, fd, best_fd, best_len) with Memory + Alloc + WASI = if fd >= 16 {
  (best_fd, best_len)
} else {
  let prestat = alloc(8)
  if fd_prestat_get(fd, prestat) == 0 && load_i8(prestat) == 0 {
    let nlen = load_i32(prestat + 4)
    let nbuf = alloc(nlen)
    if fd_prestat_dir_name(fd, nbuf, nlen) == 0 && fs_preopen_prefix(nbuf, nlen, pp, plen) && nlen > best_len {
      fs_best_preopen(pp, plen, fd + 1, fd, nlen)
    } else {
      fs_best_preopen(pp, plen, fd + 1, best_fd, best_len)
    }
  } else {
    fs_best_preopen(pp, plen, fd + 1, best_fd, best_len)
  }
}

// The guest name is a prefix of the path AND the boundary is exact (the
// path ends there or continues with '/'); the root name "/" matches every
// absolute path.
fn fs_preopen_prefix(nbuf, nlen, pp, plen) with Memory = if nlen == 1 && load_i8(nbuf) == 47 {
  true
} else if nlen > plen {
  false
} else if !fs_bytes_eq(nbuf, pp, nlen, 0) {
  false
} else {
  nlen == plen || load_i8(pp + nlen) == 47
}

fn fs_bytes_eq(a, b, n, i) with Memory = if i >= n {
  true
} else if load_i8(a + i) != load_i8(b + i) {
  false
} else {
  fs_bytes_eq(a, b, n, i + 1)
}

// stdin_is_tty — the fdstat filetype of fd 0 (character_device = 2). The
// one read that lets a bare `mentl` fork honestly: a terminal invocation
// projects the welcome; a pipe or file IS the compile-stdin contract
// (`mentl < wheel.mn` — the fixpoint path, byte-identical). The fdstat
// record is 24 bytes; filetype is the u8 at offset 0.
fn stdin_is_tty() with Memory + Alloc + WASI = {
  let stat = alloc(24)
  fd_fdstat_get(0, stat) == 0 && load_i8(stat) == 2
}

// fs_list_dir_names — the names in the FIRST dir preopen (the caller's
// cwd under the install shim), read via fd_readdir on the preopen fd
// itself. The dirent wire format (WASI preview1): d_next u64@0,
// d_ino u64@8, d_namlen u32@16, d_type u8@20, name@24. The cookie rides
// the low word (the fd_readdir import's RI64 slot zero-extends it — the
// wait_i32 precedent); a buffer-boundary-truncated entry resumes the
// loop from the last whole entry's d_next.
fn fs_list_dir_names() with Memory + Alloc + WASI = fs_dir_fd() |> fs_readdir_loop(??, 0, [])

fn fs_readdir_loop(fd, cookie, acc) with Memory + Alloc + WASI = {
  let bufsz = 8192
  let buf = alloc(bufsz)
  let nread_cell = alloc(4)
  let errno = fd_readdir(fd, buf, bufsz, cookie, nread_cell)
  if errno != 0 {
    acc
  } else {
    let nread = load_i32(nread_cell)
    match fs_parse_dirents(buf, nread, 0, acc, cookie, false) {
      (acc2, last_cookie, saw_whole) => // nread < bufsz ⇒ the host wrote the whole remainder — done. A full
      // buffer means more entries exist; continue from the last WHOLE
      // entry's d_next (no whole entry in a full buffer = a name larger
      // than the buffer — stop rather than loop forever).
      if nread < bufsz || !saw_whole { acc2 } else { fs_readdir_loop(fd, last_cookie, acc2) },
    }
  }
}

fn fs_parse_dirents(buf, end, off, acc, last_cookie, saw_whole) with Memory + Alloc = if off + 24 > end {
  (acc, last_cookie, saw_whole)
} else {
  let d_next = load_i32(buf + off)
  let namlen = load_i32(buf + off + 16)
  if off + 24 + namlen > end {
    (acc, last_cookie, saw_whole)
  } else {
    let name = bytes_buf(namlen)
    mem_copy(name + 8, buf + off + 24, namlen)
    fs_parse_dirents(buf, end, off + 24 + namlen, push(acc, str_of_buf(name)), d_next, true)
  }
}

// fs_list_dir_impl — list a SUBDIRECTORY's entry names: path_open the dir
// (oflags DIRECTORY = 0x2; rights = fd_readdir, bit 14) against its preopen,
// then the same fd_readdir loop the cwd projection drives, then close. None
// = the path is not an openable directory — the discriminator `mentl test`
// uses to fork battery-mode (a directory) from the check chain (a module).
fn fs_list_dir_impl(path_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    let fd_cell = alloc(4)
    let open_errno = path_open(dfd, 0, pp, plen, 2, 16384, 0, 0, fd_cell)
    if open_errno != 0 {
      None
    } else {
      let fd = load_i32(fd_cell)
      let names = fs_readdir_loop(fd, 0, [])
      fd_close(fd)
      Some(names)
    }
  },
}

// fs_exists — path_filestat_get returns 0 on success, errno otherwise.
// The 64-byte filestat_t record is alloc'd and discarded; existence is
// the boolean.
fn fs_exists_impl(path_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    let stat = alloc(64)
    let errno = path_filestat_get(dfd, 0, pp, plen, stat)
    errno == 0
  },
}

// fs_mkdir — path_create_directory relative to the dir preopen.
// Idempotent at the handler level (errno-17 EEXIST ignored).
fn fs_mkdir_impl(path_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    path_create_directory(dfd, pp, plen)
    ()
  },
}

// fs_read_file — path_open (read flag) + fd_read_all + fd_close.
// Returns the file bytes as a flat Mentl String. On open failure
// returns an empty string; caller should distinguish via fs_exists.
fn fs_read_file_impl(path_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    let fd_cell = alloc(4)
    // path_open(base_fd, dirflags=0, path_ptr, path_len, oflags=0,
    //   rights_base=FS_RIGHTS_READ, rights_inheriting=FS_RIGHTS_READ,
    //   fdflags=0, fd_out_ptr)
    let open_errno = path_open(dfd, 0, pp, plen, 0, 2, 2, 0, fd_cell)
    if open_errno != 0 {
      str_of_buf(bytes_buf(0))
    } else {
      let fd = load_i32(fd_cell)
      let bytes = fd_read_all(fd)
      fd_close(fd)
      bytes
    }
  },
}

// fs_write_file — path_open (write+create+trunc) + fd_write + fd_close.
// Overwrites any existing file at path.
fn fs_write_file_impl(path_str, bytes_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    let fd_cell = alloc(4)
    // path_open with FS_OFLAGS_CREAT|FS_OFLAGS_TRUNC = 0x9, FS_RIGHTS_WRITE = 0x40
    let open_errno = path_open(dfd, 0, pp, plen, 9, 64, 64, 0, fd_cell)
    if open_errno != 0 {
      ()
    } else {
      let fd = load_i32(fd_cell)
      fd_write_bytes(fd, str_payload(bytes_str), byte_len(bytes_str))
      fd_close(fd)
      ()
    }
  },
}

// fs_write_image_impl — a header buffer followed by a raw memory extent,
// streamed to path, ALL OR NOTHING. Returns whether the whole extent landed.
//
// This is the streaming sibling of fs_write_file_impl, and it exists so that
// writing a large image is ONE filesystem operation with one home. A caller
// that opened the fd, wrote twice, closed and unlinked for itself would be
// reaching past this seam five times for what is a single question — does this
// path now hold exactly these bytes — and each of those reaches is an
// operation the Filesystem handler can no longer see.
//
// ALL OR NOTHING is the contract, not a convenience. A reader that admits a
// wire on its header alone cannot tell a truncated file from a whole one, so a
// short write must leave NO file rather than a plausible one: the failure has
// to be absence, which every reader already handles, instead of a declared
// extent that was never written.
//
// A length that does not fit a signed word is refused here rather than handed
// to the syscall as a negative — the honest bound of the word this interface
// is built from, named where it bites.
fn fs_write_image_impl(path_str, hdr_ptr, hdr_len, base, len) with Memory + Alloc + WASI = {
  let fd = fs_create_impl(path_str)
  if fd == 0 {
    false
  } else {
    let nh = fd_write_bytes(fd, hdr_ptr, hdr_len)
    let nb = if len < 0 { 0 - 1 } else { fd_write_bytes(fd, base, len) }
    fd_close(fd)
    if nh == hdr_len && nb == len {
      true
    } else {
      fs_unlink_impl(path_str)
      false
    }
  }
}

// FX.A.basics primitives — per FX walkthrough §2.1 (commit 61b2b60).
// Each lifts one Filesystem op to a WASI syscall over a path view.
// Returns are domain-free (Int fd / Bool errno); ADT projection
// lifted to mentl_voice_filesystem.
//
// fs_open_impl — path_open for read+write+create. Returns WASI fd
// integer or 0 on failure (caller checks via fs_exists for distinction).
// FS_OFLAGS_CREAT = 0x1; FS_RIGHTS_READ|WRITE = 0x42.
fn fs_open_impl(path_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    let fd_cell = alloc(4)
    let open_errno = path_open(dfd, 0, pp, plen, 1, 66, 66, 0, fd_cell)
    if open_errno != 0 { 0 } else { load_i32(fd_cell) }
  },
}

// fs_create_impl — path_open write+create+trunc RETURNING the fd: the
// streaming half of fs_write_file (same flags), for writers that emit
// through the fd across a long extent instead of banking one buffer.
// 0 on failure (the fs_open_impl convention).
fn fs_create_impl(path_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    let fd_cell = alloc(4)
    let open_errno = path_open(dfd, 0, pp, plen, 9, 64, 64, 0, fd_cell)
    if open_errno != 0 { 0 } else { load_i32(fd_cell) }
  },
}

// fs_close_impl — fd_close; errno absorbed (idempotent at runtime
// per WASI errno-9 EBADF semantics).
fn fs_close_impl(fd) with WASI = {
  fd_close(fd)
  ()
}

// fs_unlink_impl — path_unlink_file relative to the dir preopen.
// Errno surfaced as Bool (true on success). H6 binary outcome.
fn fs_unlink_impl(path_str) with Memory + Alloc + WASI = match fs_at(path_str) {
  (dfd, pp, plen) => {
    let errno = path_unlink_file(dfd, pp, plen)
    errno == 0
  },
}

// fs_rename_impl — path_rename within the dir preopen to itself. Each
// path crosses as its own payload view; the old adjacent-scratch
// packing (new at 256 + old_len + 1) died with the scratch. Errno
// surfaced as Bool.
fn fs_rename_impl(old_str, new_str) with Memory + Alloc + WASI = match fs_at(old_str) {
  (ofd, op, olen) => match fs_at(new_str) {
    (nfd, np, nlen) => {
      let errno = path_rename(ofd, op, olen, nfd, np, nlen)
      errno == 0
    },
  },
}
