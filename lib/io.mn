// io.mn — I/O primitives for the Mentl runtime
//
// All I/O routes through the WASI effect (declared below — the host
// boundary IS an effect; the host runtime IS its handler).
// No print-via-syscall magic. No fd_write call sites scattered
// across the compiler. All of it lives here, behind named functions.
//
// EVERY syscall's argument record — iov, nwritten/nread cell, filestat,
// prestat, fd-out cell — allocs per use from the one bump image. The
// record's lifetime IS the call, and the extent's arena reclaims the
// droplets at its exit. There is NO static scratch: the
// old page-0 map (iov 0x50, print 0x60, fs path 0x100, filestat 0x200,
// fd 0x240) was an unaccounted allocation evading the Alloc row, and
// its baked addresses clobbered a real record the day the layout
// shifted (the ev_scan fn_ptr smash, 2026-07-10). Page 0 belongs to
// the substrate (the sentinel space + the thread-record region); the
// runtime owns no address it did not alloc.
//
// Paths cross the boundary as (ptr, len) views straight into the
// string's payload bytes (fs_path_view) — WASI preview1 paths are
// explicit-length, never NUL-terminated, so copying them anywhere
// first would re-derive bytes the image already holds contiguously.
//
// The Filesystem capability — its effect, its handler and the path syscalls
// each arm hands its request to — is lib/fs.mn's, whole; this module is the
// WASI boundary and the stream reads and writes over it.
//
// FS constants (WASI preview1 flags). Mirrored literally from the
// WASI spec; documented here to avoid magic numbers at call sites.
//   dir preopen fd        — read LIVE from the preopen table (fs_dir_fd;
//                           a tcplisten socket may occupy fd 3 first)
//   FS_RIGHTS_READ        = 0x2 — fd_read right
//   FS_RIGHTS_WRITE       = 0x40 — fd_write right
//   FS_OFLAGS_CREAT       = 0x1 — create if not exists
//   FS_OFLAGS_TRUNC       = 0x8 — truncate to zero on open
import strings

// ─── The WASI effect — the host boundary IS an effect ─────────
//
// Every op mirrors a WASI preview1 import 1:1; the host runtime IS
// the handler (lower maps each op to its wasi_snapshot_preview1
// import — the import IS the handler install). A parameter the host
// reads or writes memory through is an Addr; errno returns are Int per
// the WASI ABI, and refinement of errno spaces is Verify's post-L2 work.
effect WASI {
  // (fd, iovs, iovs_len, nwritten)
  fd_write(Int, Addr, Int, Addr) -> Int
  // (fd, iovs, iovs_len, nread)
  fd_read(Int, Addr, Int, Addr) -> Int
  fd_close(Int) -> Int
  // (fd, prestat)
  fd_prestat_get(Int, Addr) -> Int
  // (fd, path, path_len)
  fd_prestat_dir_name(Int, Addr, Int) -> Int
  // (fd, fdstat)
  fd_fdstat_get(Int, Addr) -> Int
  // (fd, buf, buf_len, cookie, bufused)
  fd_readdir(Int, Addr, Int, Int, Addr) -> Int
  // (dirfd, dirflags, path, path_len, oflags, rights_base, rights_inheriting,
  // fdflags, opened_fd)
  path_open(Int, Int, Addr, Int, Int, Int, Int, Int, Addr) -> Int
  // (dirfd, path, path_len)
  path_create_directory(Int, Addr, Int) -> Int
  // (dirfd, flags, path, path_len, filestat)
  path_filestat_get(Int, Int, Addr, Int, Addr) -> Int
  // (dirfd, path, path_len)
  path_unlink_file(Int, Addr, Int) -> Int
  // (old_dirfd, old_path, old_len, new_dirfd, new_path, new_len)
  path_rename(Int, Addr, Int, Int, Addr, Int) -> Int
  // (argc, argv_buf_size)
  args_sizes_get(Addr, Addr) -> Int
  // (argv, argv_buf)
  args_get(Addr, Addr) -> Int
  // (environc, environ_buf_size)
  environ_sizes_get(Addr, Addr) -> Int
  // (environ, environ_buf) — each entry a `NAME=VALUE` C-string
  environ_get(Addr, Addr) -> Int
  // Never returns: the host ends the process, so the op answers a bare
  // variable — any install an arm ending in it answers (SYNTAX
  // §«Unit return omission»). Its emit is `(call $proc_exit)(unreachable)`.
  proc_exit(Int) -> !
}

// wasi_args — the process argv as a [String], read live from the host at
// _start. This is what makes the CLI real: without it _start handed main a
// len-0 list and every `mentl <verb>` fell through to compile-stdin
// (Hβ.emit.wasi-argv-in-start). args_sizes_get writes (argc, total-byte-size);
// args_get writes the argv pointer array + the null-terminated string buffer;
// each argv[i] is a C-string materialized into a flat [len][bytes] Mentl string
// (the read_stdin buffer→string layout). argv[0] is the program name, so the
// self-compile (`m2 < wheel`, argc=1) still parses to VCompileStdin (len < 2).
fn cstr_len(cstr, i) = if load_i8(addr_at(cstr, i)) == 0 { i } else { cstr_len(cstr, i + 1) }

fn cstr_to_string(cstr) = {
  let n = cstr_len(cstr, 0)
  let s = bytes_buf(n)
  mem_copy(addr_at(s, 8), cstr, n)
  str_of_buf(s)
}

fn wasi_args_build(argv_ptr, argc, i, acc) = if i >= argc {
  acc
} else {
  let cstr = load_addr(addr_at(argv_ptr, i * 4))
  wasi_args_build(argv_ptr, argc, i + 1, push(acc, cstr_to_string(cstr)))
}

fn wasi_args() = {
  let argc_ptr = alloc(4)
  let bufsz_ptr = alloc(4)
  args_sizes_get(argc_ptr, bufsz_ptr)
  let argc = load_i32(argc_ptr)
  let argv_ptr = alloc(argc * 4)
  let buf = alloc(load_i32(bufsz_ptr))
  args_get(argv_ptr, buf)
  wasi_args_build(argv_ptr, argc, 0, make_list(0))
}

// wasi_environ — the variables the host passed, as (NAME, VALUE) pairs, read
// live in args' shape: environ_sizes_get writes (count, total-byte-size),
// environ_get the pointer array and the buffer of `NAME=VALUE` C-strings,
// split at the first `=`. The host decides what is here — `mentl run` passes
// exactly the names the program's roster states (lib/environ.mn).
fn wasi_environ() = {
  let count_ptr = alloc(4)
  let bufsz_ptr = alloc(4)
  environ_sizes_get(count_ptr, bufsz_ptr)
  let n = load_i32(count_ptr)
  let ptrs = alloc(4 * n)
  let buf = alloc(load_i32(bufsz_ptr))
  environ_get(ptrs, buf)
  range(0, n) |> map({ i => load_addr(addr_at(ptrs, 4 * i)) |> cstr_to_string |> environ_pair })
}

// One `NAME=VALUE` entry, split at its first `=`; an entry with none is a
// name holding the empty value.
fn environ_pair(kv: String) = {
  let n = byte_len(kv)
  let eq = find_char(kv, n, 0, 61)
  if eq < 0 { (kv, "") } else { (str_slice(kv, 0, eq), str_slice(kv, eq + 1, n)) }
}

// ─── The Console effect — narration's output boundary ─────────
//
// The medium's voice performs `print`; WHERE it lands is the
// installed handler's decision. stdout_console routes to fd 1;
// sibling handlers (buffer_console for tests, lsp_console for the
// LSP transport) swap without touching the narrating code.
effect Console {
  print(String)
}

handler stdout_console {
  print(msg) => {
    print_string(msg)
    resume()
  },
}

// ─── fail_exit — the host-boundary failure policy ──────────────
//
// Fail.fail never resumes; this handler writes the message to stderr and
// exits 1 through the WASI host. Stdout is the program's product — a
// compile's WAT among them — so a failure never lands inside it. A test
// handler can swap in to collect failures instead — the policy is the
// install, not the call site.
handler fail_exit {
  fail(msg) => {
    eprint_string("{msg}\n")
    proc_exit(1)
  },
}

// ─── The one syscall-marshal pair ──────────────────────────────
//
// fd_write_bytes — ONE fd_write over the contiguous span of len bytes from
// ptr. The iov + nwritten record is the syscall's argument marshaling,
// alloc'd per call: [ptr@0][len@4][nwritten@8]. Returns the host's
// bytes-written count; the print family discards it (a stdout short-
// write has no recovery worth a loop at this altitude), and a stream
// writer that must drain loops on it.
fn fd_write_bytes(fd, ptr, len) = {
  let iov = alloc(12)
  store_addr(iov, ptr)
  store_i32(addr_at(iov, 4), len)
  fd_write(fd, iov, 1, addr_at(iov, 8))
  load_i32(addr_at(iov, 8))
}

// read_chunk — ONE fd_read of up to `size` bytes into buf. The twin
// marshal record: [ptr@0][len@4][nread@8]. Returns bytes actually
// read (0 = EOF).
fn read_chunk(fd, buf, size) = {
  let iov = alloc(12)
  store_addr(iov, buf)
  store_i32(addr_at(iov, 4), size)
  fd_read(fd, iov, 1, addr_at(iov, 8))
  load_i32(addr_at(iov, 8))
}

// Stdout
//
// print_string — write a Mentl string to stdout (fd=1). Io IS the
// materialization boundary in the gradient: str_payload flattens a
// rope/slice (and repacks a wider-stride byte record) to the contiguous
// stride-1 span the syscall wants; a flat string passes through untouched.
fn print_string(s) = {
  fd_write_bytes(1, str_payload(s), byte_len(s))
  ()
}

// print_int — convert n to a decimal string and write to stdout.
fn print_int(n) = {
  let s = int_to_str(n)
  print_string(s)
}

// print_newline — write a single newline character (0x0A) to stdout.
fn print_newline() = {
  let cell = alloc(1)
  store_i8(cell, 10)
  fd_write_bytes(1, cell, 1)
  ()
}

// println — write a string + newline to stdout.
fn println(s) = {
  print_string(s)
  print_newline()
}

// Stderr
//
// eprint_string — write a Mentl string to stderr (fd=2). The same
// str_payload materialization boundary print_string reads.
fn eprint_string(s) = {
  fd_write_bytes(2, str_payload(s), byte_len(s))
  ()
}

// Stdin
//
// fd_read_all — slurp an fd to EOF into a heap-allocated flat string.
// Reads into a raw doubling byte buffer, then materializes one flat
// [count][tag][bytes] byte record (bytes_buf). It serves stdin
// (read_stdin), whose size nothing states — the stream does not care where
// the fd came from.
fn fd_read_all(fd) = {
  let initial_cap = 65536
  let buf = alloc(initial_cap)
  match fd_read_loop(fd, buf, 0, initial_cap) {
    (final_buf, total) => {
      let str = bytes_buf(total)
      mem_copy(addr_at(str, 8), final_buf, total)
      str_of_buf(str)
    },
  }
}

fn fd_read_loop(fd, buf, offset, capacity) = {
  let chunk_size = 65536
  match if offset + chunk_size > capacity {
    let new_cap = capacity * 2
    let new_buf = alloc(new_cap)
    mem_copy(new_buf, buf, offset)
    (new_buf, new_cap)
  } else {
    (buf, capacity)
  } {
    (cur_buf, cur_cap) => {
      let nread = read_chunk(fd, addr_at(cur_buf, offset), chunk_size)
      if nread == 0 { (cur_buf, offset) } else { fd_read_loop(fd, cur_buf, offset + nread, cur_cap) }
    },
  }
}

// read_stdin — slurp all of stdin (fd 0). The compiler's input path.
fn read_stdin() = fd_read_all(0)

// read_one_byte — read exactly 1 byte from stdin. Returns the byte
// value (0..255) or -1 on EOF. Substrate primitive for boundary-
// scanning reads (line endings, LSP \r\n headers) where the consumer
// can't know the boundary until it sees the byte. Honest: per-byte
// syscalls are slow for bulk data but correct for interactive prompts
// and ~50-byte header sections; bulk paths use read_chunk directly.
fn read_one_byte() = {
  let cell = alloc(1)
  let nread = read_chunk(0, cell, 1)
  if nread == 0 { -1 } else { load_i8(cell) }
}

// read_stdin_line — read one line from stdin (interactive-prompt
// discipline: one human action per line). Accumulates bytes until
// 0x0A or EOF; the newline is consumed, not returned. Returns a flat
// [count][tag][bytes] Mentl string.
fn read_stdin_line() = {
  let initial_cap = 256
  let buf = alloc(initial_cap)
  match read_line_loop(buf, 0, initial_cap) {
    (final_buf, total) => {
      let str = bytes_buf(total)
      mem_copy(addr_at(str, 8), final_buf, total)
      str_of_buf(str)
    },
  }
}

fn read_line_loop(buf, offset, capacity) = match if offset + 1 > capacity {
  let new_cap = capacity * 2
  let new_buf = alloc(new_cap)
  mem_copy(new_buf, buf, offset)
  (new_buf, new_cap)
} else {
  (buf, capacity)
} {
  (cur_buf, cur_cap) => {
    let b = read_one_byte()
    if b < 0 {
      (cur_buf, offset)
    } else {
      if b == 10 {
        (cur_buf, offset)
      } else {
        store_i8(addr_at(cur_buf, offset), b)
        read_line_loop(cur_buf, offset + 1, cur_cap)
      }
    }
  },
}

// Whether a descriptor is a terminal: its fdstat filetype is character_device
// (2). A bare mentl command forks on fd 0's — a terminal invocation projects
// the welcome, a pipe or file IS the compile-stdin contract — and the
// compile's live line on fd 2's. The fdstat record is 24 bytes; filetype is
// the u8 at offset 0.
fn fd_is_tty(fd) = {
  let stat = alloc(24)
  fd_fdstat_get(fd, stat) == 0 && load_i8(stat) == 2
}
