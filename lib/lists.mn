// lists.mn — List primitives for the Mentl runtime
//
// Lists have four structural tags; every function here dispatches
// on them exhaustively. No silent defaults. No O(N²) flat-index loops.
//
// Tag layout:
//   tag 0 (flat):   [count:i32][tag:i32][elem0:i32][elem1:i32]...
//                   length = count, O(1) indexed at offset 8+i*4
//   tag 1 (snoc):   [count:i32][tag:i32][left:ptr][last:i32]
//                   push appends via snoc; last reads last in O(1)
//   tag 3 (concat): [count:i32][tag:i32][left:ptr][right:ptr]
//                   list_concat returns this node without copying
//   tag 4 (slice):  [count:i32][tag:i32][base:ptr][start:i32]
//                   view into base[start..start+count)
//
// A node is an address, and so is each of its links (left, right, base):
// they are read by load_addr and written by store_addr. An element is a
// word — the runtime's word protocol — and a wide element crosses it as its
// address punned to a word (addr_word in, word_addr out).
//
// Ownership rule: functions receiving an `own List` MAY mutate in-place
// when the list is tag=0 and the ref-count proves uniqueness. Functions
// receiving a borrowed List always allocate a new node.
//
// Effects declared in std/compiler/types.mn — not re-declared here, and not
// IMPORTED either: this module references no name from types, so the import
// was pure link mass. It put the compiler's whole effect vocabulary — Abort,
// FreshHandle, Consume, GraphRead/Write, Diagnostic, EnvRead/Write, Verify,
// 100-odd ops — into the namespace of every program that touches a list.
//
// The stride carrier. A sequence's element byte-stride rides the HIGH bits of
// its tag word (which holds sc*16 + tag): the structural tag is that word masked
// to its low 4 bits, the stride-code sc is that word / 16 (exact, since the tag
// is < 16, so no shift op is needed). Zero-biased
// (decode_stride/stride_class, types.mn): a stride-4 word list writes sc 0, so
// pack_tag(0, 0) == 0 and every existing list is byte-identical; only a byte or
// packed-float sequence writes a nonzero code. This is what lets a GENERIC body
// (iterate_from's xs[i], its element a TVar) read a packed [byte] correctly — it
// reads the stride LIVE from the node, never assuming 4 (the corruption the
// naive String=[byte] merge caused, fixed at the substrate).
// decode_stride — the RUNTIME half of the zero-biased carrier codec (sc =>
// element byte stride), the inverse of types.mn's stride_class (the EMIT half).
// It lives HERE, not in the compiler's type layer, because the RTLIBS blob
// (memory + strings + lists + prelude, how the micros compile) has no src/ — a
// runtime reader must resolve to a runtime definition.
fn decode_stride(sc) with Pure = match sc {
  0 => 4,
  1 => 1,
  2 => 8,
  3 => 16,
  4 => 2,
  _ => 4,
}

fn pack_tag(tag, sc) with Pure = sc * 16 + tag

fn seq_stride(ref list) = decode_stride(load_i32(addr_at(list, 4)) / 16)

// The node's shape, off its tag word (0 flat, 1 snoc, 3 concat, 4 slice):
// the builders here write the only tags, and the word is trusted as a walk's
// every load is, so a walk dispatches on the shape whole.
type SeqShape = SeqFlat | SeqSnoc | SeqConcat | SeqSlice

fn seq_shape(tw) = match i32_and(tw, 15) {
  0 => SeqFlat,
  1 => SeqSnoc,
  3 => SeqConcat,
  _ => SeqSlice,
}

fn seq_sc(ref list) = load_i32(addr_at(list, 4)) / 16

// Element access at a runtime-carried stride — the WORD PROTOCOL, total and
// repr-erased. A sub-word byte loads as a word by value; a word loads as
// itself; a WIDE element (stride 8/16 — f64 today, i64/v128 by the same law)
// answers its address as a word (addr_word) — the reference IS the element's
// word face ("a handle IS a word", §5.U). The generic layer never touches a
// wide value; a typed site cashes the width through load_f64/store_f64 at the
// boundary. Stride 2 (the reserved u16 code) has no producer; it rides the
// wide arm's address/copy protocol until a by-value arm earns a producer.
fn load_strided(base, i, stride) = if stride == 1 {
  load_i8(addr_at(base, i * stride))
} else if stride == 4 {
  load_i32(addr_at(base, i * stride))
} else {
  addr_word(addr_at(base, i * stride))
}

// The stride-1 store carries the byte RANGE trap (out_of_range, the list_index
// bounds-trap precedent): a word outside 0..255 entering a byte slot would
// otherwise wrap silently (i32.store8 masks to the low byte) — the narrowing
// corruption class §4① band D names. Runtime-total; the compile-time ground
// discharge on top is the named refinement tier
// (Hβ.infer.byte-narrowing-ground-discharge).
fn store_strided(base, i, stride, val) = if stride == 1 {
  store_i8(addr_at(base, i * stride), if val < 0 || val > 255 { out_of_range() } else { val })
} else if stride == 4 {
  store_i32(addr_at(base, i * stride), val)
} else // Wide slot: val is the reference punned to a word (the word face of a
// wide value), and the slot takes the scalar the address names.
{
  scalar_copy(addr_at(base, i * stride), word_addr(val), stride)
}

// A wide slot's scalar, copied as the number it is — a wide representation
// is a number, never an address — so an arena whose older list the slot lies
// in reads nothing into it and reclaims past it, where a raw `mem_copy`
// would keep the region. Eight bytes cross as one Float (`store_f64` writes
// the bits `load_f64` read, whatever they encode); a 16-byte lane is two of
// them, a 2-byte slot two bytes.
fn scalar_copy(dst, src, stride) = if stride == 2 {
  store_i8(dst, load_i8(src))
  store_i8(addr_at(dst, 1), load_i8(addr_at(src, 1)))
} else {
  store_f64(dst, load_f64(src))
  if stride == 16 { store_f64(addr_at(dst, 8), load_f64(addr_at(src, 8))) } else { () }
}

// Construction
//
// make_list — allocate a flat tag=0 list of `count` slots (uninitialized).
// Callers must fill slots with list_set before the list escapes.
// The representation layer speaks TWO altitudes, and the names carry the
// boundary: `alloc_list_sc` is the RAW constructor (a count and a stride class
// in, an address out — the [len][tag][slots] record laid out by addr_at), used
// INSIDE this file's raw walks; `make_list` is the TYPED name the substrate
// table projects as `Int -> [a]` for every consumer above the boundary. One
// body, two names — a raw body that CALLS a table-typed name would force the
// typed view onto its own word-level locals (the List-vs-Int census class this
// split felled).
fn alloc_list_sc(count, sc) = {
  let t = alloc(8 + count * decode_stride(sc))
  store_i32(t, count)
  store_i32(addr_at(t, 4), pack_tag(0, sc))
  t
}

// A negative count is no length: it traps here, at the list's own
// precondition, before the allocator could read it as exhausted memory. The
// answer is the allocation alone, so the list is memory its caller built.
fn make_list(count) = {
  if count < 0 { out_of_range() }
  alloc_list_sc(count, 0)
}

// The constructor a packed list literal calls at its stride class.
fn make_list_sc(count, sc) = alloc_list_sc(count, sc)

// list_filled — a flat list with every slot holding v. The bucket-index
// mints read this: a hash index's slot IS a list that starts empty (one
// shared [] across the slots — buckets are only ever REPLACED, never
// mutated, so the sharing is sound), which keeps the element type honest
// end to end where a zero-filled buffer forced every reader through an
// `if x == 0` word test that no type admits.
fn list_filled(n, v) = list_filled_from(make_list(n), v, 0, n)

fn list_filled_from(xs, v, i, n) =
  if i >= n { xs } else { list_filled_from(list_set(xs, i, v), v, i + 1, n) }

// len — element count of any list. Every node shape carries its
// count at offset 0 (flat, snoc, concat, slice alike) — one load;
// the representation already proves it. No tag dispatch.
fn len(ref xs) = load_i32(xs)

// Mutation and access (tag-dispatched)
//
// list_set — write val into slot idx of a flat tag=0 list. Returns the
// list pointer so callers can chain: make_list(3) |> list_set(0, a) ...
// Caller asserts tag=0 — calling list_set on a snoc/concat/slice is
// a structural contract violation (the list should be list_to_flat'd first).
fn list_set(l, idx, val) = {
  // One tag-word read; 0 == pack_tag(0, 0), the flat word list — a direct
  // store. Byte lists route through store_strided so the 0..255 range trap
  // holds; wide slots keep the copy-from-reference protocol. The base
  // refuses a structured tag LOUDLY, and the list an index outside it: a
  // snoc/concat/slice node has headers where flat elements would sit, and a
  // slot past the end is the next allocation's — a store through either is
  // corruption, never a wrong element.
  if idx < 0 || load_i32(l) <= idx { out_of_range() }
  let tw = load_i32(addr_at(l, 4))
  let base = addr_at(l, if tw % 16 == 0 { 8 } else { out_of_range() })
  if tw == 0 {
    store_i32(addr_at(base, idx * 4), val)
  } else {
    store_strided(base, idx, decode_stride(tw / 16), val)
  }
  l
}

// list_extend_to — ensure `list` has capacity ≥ min_size. If already
// large enough, returns `list` unchanged. Otherwise allocates a new
// flat tag=0 list of size max(min_size, 2 * len(list)), copies
// existing elements, and returns the new pointer. Amortized O(1)
// per append when callers maintain a separate logical-length
// counter.
//
// Substrate primitive for every flat-buffer-plus-counter state in the
// compiler — the env's entries, infer.mn's evidence vectors, query.mn's
// capability sets. Every flat-substrate grow in the compiler routes
// through here.
//
// CONTRACT: slots in [len(list), new_cap) are zero-initialized by
// the allocator but carry no semantic meaning. Callers must track
// logical length separately and never read uninitialized slots.
fn list_extend_to(list, min_size) = {
  let cur_len = len(list)
  if cur_len >= min_size {
    list
  } else {
    let new_cap = if min_size > cur_len * 2 { min_size } else { cur_len * 2 }
    let fresh = make_list(new_cap)
    list_copy_into(list, fresh, 0, cur_len)
  }
}

// list_copy_into — copy src[0..count) into dst[0..count). Dispatches
// through list_index so src may be any tag; dst must be tag=0.
// Callers should keep src tag=0 for O(count) cost; non-flat sources
// pay list_index dispatch per element.
fn list_copy_into(src, dst, i, count) = if i >= count {
  dst
} else {
  list_copy_into(src, list_set(dst, i, list_index(src, i)), i + 1, count)
}

// O(1) for a flat list, O(log N) for a snoc chain, O(depth) for a concat or
// a slice. An index out of range traps at this one boundary check, and the
// traversal below it runs unchecked.
fn list_index(ref list, i) =
  if i < 0 || load_i32(list) <= i { out_of_range() } else { list_index_unchecked(list, i) }

// The raw traversal — every entry already carries a discharged bounds
// obligation: list_index's boundary check, or the judgment's proof of a
// sequence read's bounds claim, where `xs[i]` lowers here directly (TRAP).
// It dispatches on the node's shape, so a read the judgment proved in bounds
// is total.
//
// In the flat arm the tag word is sc*16, so 0 is the word floor and 16 the
// byte code; in the snoc arm it is sc*16 + 1. A concat or slice derives no
// stride: each child carries its own word.
fn list_index_unchecked(ref list, i) = {
  let tw = addr_at(list, 4) |> load_i32
  match tw |> seq_shape {
    SeqFlat => if tw == 0 {
      load_i32(addr_at(list, 8 + i * 4))
    } else if tw == 16 {
      load_i8(addr_at(list, 8 + i))
    } else {
      load_strided(addr_at(list, 8), i, decode_stride(tw / 16))
    },
    SeqSnoc => {
      let left = load_addr(addr_at(list, 8))
      let left_len = load_i32(left)
      if i < left_len {
        list_index_unchecked(left, i)
      } else if tw == 1 {
        load_i32(addr_at(list, 12))
      } else {
        load_strided(addr_at(list, 12), 0, decode_stride(tw / 16))
      }
    },
    SeqConcat => {
      let left = load_addr(addr_at(list, 8))
      let left_len = load_i32(left)
      if i < left_len {
        list_index_unchecked(left, i)
      } else {
        list_index_unchecked(load_addr(addr_at(list, 12)), i - left_len)
      }
    },
    SeqSlice => {
      let base = load_addr(addr_at(list, 8))
      let start = load_i32(addr_at(list, 12))
      list_index_unchecked(base, start + i)
    },
  }
}

// Structural equality — the sequence case of the one == derivation.
//
// list_eq — length-then-element structural equality over the sequence
// node-kind (SYNTAX.md §Equality: "sequence ([a], incl. String = [Byte])
// -> length-then-element recursion"). This is the [a] instance of the
// single structural-eq derivation; the String case is str_eq (the [Byte]
// instance), and both are the ONE sequence projection — not two operators.
// Elements compare via i32.eq (the scalar/pointer word); deep element
// recursion for nested sequences rides the element-typed emit dispatch.
//
// Identity is the first structural fact: the same node is equal to
// itself — sayable HERE because this raw body reads its operands as
// addresses, which compare by identity. (str_eq's typed body cannot say
// it; its identity path is the named emit-wrapper strike.)
fn list_eq(a, b) -> Bool = if a == b {
  true
} else {
  let la = load_i32(a)
  let lb = load_i32(b)
  if la != lb { false } else { list_eq_loop(a, b, la, 0) }
}

fn list_eq_loop(a, b, n, i) -> Bool = if i >= n {
  true
} else {
  // The raw altitude end to end: list_index (a typed face) would pin the
  // loop's operands [t] while list_eq's own body reads them as addresses —
  // the unchecked read is the f64 siblings' exact form, bounds discharged
  // by the loop guard over the header length.
  if list_index_unchecked(a, i) != list_index_unchecked(b, i) {
    false
  } else {
    list_eq_loop(a, b, n, i + 1)
  }
}

// list_compare — the 3-way lexicographic ordering: the [a] instance of the ONE
// compare leaf (sibling of str_compare's [Byte] instance). Returns -1 / 0 / 1.
// The first differing element decides; on a common prefix the shorter list is
// less. Elements compare as words here (the i32 instance the eq loop also uses);
// the generated $compare_<sig> fold descends element-typed aggregates at the
// emit layer, the same place the eq leaf does. The SAME lexicographic walk
// str_compare's [byte] instance makes, so a byte sequence orders identically
// through either route.
fn list_compare_loop(a, b, la, lb, i) -> Int = if i >= la && i >= lb {
  0
} else if i >= la {
  -1
} else if i >= lb {
  1
} else {
  let ea = list_index_unchecked(a, i)
  let eb = list_index_unchecked(b, i)
  if ea < eb { -1 } else if ea > eb { 1 } else { list_compare_loop(a, b, la, lb, i + 1) }
}

// The raw altitude end to end, as `list_eq` reads it: the emit calls this
// for WORD lists only, so the lengths are header words and each element the
// word the unchecked read yields, bounded by the loop's own guards.
fn list_compare(a, b) -> Int = {
  let la = load_i32(a)
  let lb = load_i32(b)
  list_compare_loop(a, b, la, lb, 0)
}

// list_hash — FNV-1a over the elements: the [a] instance of the ONE hash leaf.
// Structural-equal lists (element-equal, equal length) hash equal (list_eq ⇒
// list_hash equal — the eq/hash agreement). The length seeds the mix so [1] and
// [1,1] differ; the same FNV constants str_hash / hash_source share.
fn list_hash_loop(xs, i, n, h) -> Int =
  if i >= n { h } else { list_hash_loop(xs, i + 1, n, i32_xor(h, list_index(xs, i)) * 16777619) }

fn list_hash(xs) -> Int = {
  let n = len(xs)
  list_hash_loop(xs, 0, n, i32_xor(-2128831035, n) * 16777619)
}

// Push — O(1) snoc
//
// push — append val to list, returning a new snoc node (tag=1).
// Ownership-aware path: if the list is tag=0 AND owned AND has capacity,
// list_set is preferred by the caller (no node allocation). Otherwise
// push allocates a 16-byte snoc node.
fn push(list, val) = {
  let old_len = load_i32(list)
  let sc = load_i32(addr_at(list, 4)) / 16
  let st = decode_stride(sc)
  // The value slot at +12 is stride-sized: 12+4=16 for a word list
  // (byte-identical floor), 12+8 for a packed f64, 12+1 for a byte.
  let snoc = alloc(12 + st)
  store_i32(snoc, old_len + 1)
  store_i32(addr_at(snoc, 4), pack_tag(1, sc))
  store_addr(addr_at(snoc, 8), list)
  store_strided(addr_at(snoc, 12), 0, st, val)
  snoc
}

// Concatenation — O(1) concat node
//
// list_concat — join two lists. Returns either input directly if the other
// list_pop — remove the last element of `list`, returning (rest, last).
// Allocates a fresh tag=0 list of capacity n-1 and copies the prefix
// via list_copy_into. For an empty list, returns (empty, 0) — caller
// must check len before depending on the popped value.
fn list_pop(list) = {
  let n = len(list)
  if n == 0 {
    (make_list(0), 0)
  } else {
    let end_val = list_index(list, n - 1)
    let rest = if n == 1 {
      make_list(0)
    } else {
      let buf = make_list(n - 1)
      list_copy_into(list, buf, 0, n - 1)
    }
    (rest, end_val)
  }
}

// range — produce a flat tag=0 list `[start, start+1, ..., end-1]`.
// Returns make_list(0) for empty ranges (start >= end).
fn range(start, end) = {
  let n = if end > start { end - start } else { 0 }
  let buf = make_list(n)
  range_fill(buf, start, end, 0)
}

fn range_fill(buf, cur, end, idx) =
  if cur >= end { buf } else { range_fill(list_set(buf, idx, cur), cur + 1, end, idx + 1) }

// is empty (no allocation), otherwise allocates a 16-byte concat node (tag=3).
fn list_concat(a, b) = {
  let len_a = load_i32(a)
  let len_b = load_i32(b)
  if len_a == 0 {
    b
  } else if len_b == 0 {
    a
  } else {
    let total = len_a + len_b
    let node = alloc(16)
    store_i32(node, total)
    store_i32(addr_at(node, 4), pack_tag(3, seq_sc(a)))
    store_addr(addr_at(node, 8), a)
    store_addr(addr_at(node, 12), b)
    node
  }
}

// Slice — O(1) view
//
// slice — a view into list[start..end) (exclusive end), a 16-byte slice node
// (tag=4), no copying. Its precondition is `0 <= start <= end <= len(list)`:
// a bound outside the list traps, as an index out of range does, and is
// never clamped to a view the caller did not ask for.
// `slice` is the typed table name; `slice_raw` is the cut at the raw
// altitude, callable from this file's word-level walks.
fn slice(list, start, end) = {
  if start < 0 || end < start || load_i32(list) < end { out_of_range() }
  slice_raw(list, start, end)
}

// The cut, its bounds already in range: an empty range is the empty list, and
// a slice of a slice views the same base at the composed offset, so a list
// cut again and again stays one hop from its elements.
fn slice_raw(list, start, end) = if end - start <= 0 {
  alloc_list_sc(0, seq_sc(list))
} else {
  match addr_at(list, 4) |> load_i32 |> seq_shape {
    SeqSlice => slice_node(
      load_addr(addr_at(list, 8)),
      load_i32(addr_at(list, 12)) + start,
      end - start,
      seq_sc(list)
    ),
    SeqFlat | SeqSnoc | SeqConcat => slice_node(list, start, end - start, seq_sc(list)),
  }
}

fn slice_node(base, start, n, sc) = {
  let node = alloc(16)
  store_i32(node, n)
  store_i32(addr_at(node, 4), pack_tag(4, sc))
  store_addr(addr_at(node, 8), base)
  store_i32(addr_at(node, 12), start)
  node
}

// last — the element most recently pushed: a snoc list's end, and so the
// innermost binding of a scope kept as a stack. It is read through the
// sequence index, which carries the element's type from the list's own and
// lowers to `list_index`, so one read covers every representation. An empty
// list has no last element: the index is out of range, and `list_index`
// traps there.
fn last(xs) = xs[len(xs) - 1]

// drop_last — the list without its last element: a snoc's left link, else
// an O(1) slice by reference.
fn drop_last(list) = match addr_at(list, 4) |> load_i32 |> seq_shape {
  SeqSnoc => load_addr(addr_at(list, 8)),
  SeqFlat | SeqConcat | SeqSlice => slice_raw(list, 0, load_i32(list) - 1),
}

// Materialization
//
// list_to_flat — convert any list tree to a contiguous tag=0 array.
// O(N) time, O(N) space. Returns the input unchanged if already flat.
// Call this at hot-path entrances when O(1) random access is required.
// Two altitudes, two names (the make_list/alloc_list precedent): flat_raw is
// the RAW body (an address in, an address out — the flatten laid out by
// addr_at), used by this file's walks and str_payload's raw body;
// list_to_flat is the TYPED name the substrate table projects as [a] -> [a]
// for every consumer above the boundary; a typed caller reaching the raw
// name would read its element as a word.
fn list_to_flat(list) = flat_raw(list)

fn flat_raw(list) = match addr_at(list, 4) |> load_i32 |> seq_shape {
  SeqFlat => list,
  SeqSnoc | SeqConcat | SeqSlice => {
    let flat = alloc_list_sc(load_i32(list), seq_sc(list))
    fill_range(flat, list, 0, 0, load_i32(list), seq_stride(flat))
    flat
  },
}

// fill_range — node[src .. src + n) into flat[dest ..], each element read
// once off the node's own structure. The stride is uniform through a fill:
// flat_raw allocates the destination with the tree's own sc, and every
// sub-node carries its parent's, so a flat node is one mem_copy for word,
// byte and wide elements alike, and a slice composes its offset.
fn fill_range(flat, node, dest, src, n, st) = if n == 0 {
  ()
} else {
  match addr_at(node, 4) |> load_i32 |> seq_shape {
    SeqFlat => mem_copy(addr_at(flat, 8 + dest * st), addr_at(node, 8 + src * st), n * st),
    SeqSnoc => fill_snoc(flat, node, dest, src, n, st),
    SeqConcat => if n == load_i32(node) {
      ff_concat_drain(flat, ff_push(ff_push(make_list(16), 0, null_addr(), 0), 1, node, dest), 2, st)
    } else {
      fill_concat_part(flat, node, dest, src, n, st)
    },
    SeqSlice => fill_range(flat, load_addr(addr_at(node, 8)), dest, load_i32(addr_at(node, 12)) + src, n, st),
  }
}

// A snoc node is [count][tag=1][left][last]: the last element sits at the
// count less one, so past the range it is skipped, inside it it is the
// range's last, and the left link holds the rest. A suffix of a chain costs
// its own length; indexing each element instead descended the chain from its
// end once per element, and a module's span-index suffix cost the whole
// graph per node.
fn fill_snoc(flat, node, dest, src, n, st) = {
  let left = load_addr(addr_at(node, 8))
  if load_i32(node) - 1 >= src + n {
    fill_range(flat, left, dest, src, n, st)
  } else {
    if st == 4 {
      store_i32(addr_at(flat, 8 + (dest + n - 1) * 4), load_i32(addr_at(node, 12)))
    } else {
      store_strided(addr_at(flat, 8), dest + n - 1, st, load_strided(addr_at(node, 12), 0, st))
    }
    fill_range(flat, left, dest, src, n - 1, st)
  }
}

// A range covering part of a concat: the part in its right half first, then
// the part in its left half as the tail call, so a ++-folded rope, which
// leans left, is walked down its spine without the call stack growing.
fn fill_concat_part(flat, node, dest, src, n, st) = {
  let left = load_addr(addr_at(node, 8))
  let left_len = load_i32(left)
  let in_left = if src >= left_len { 0 } else if src + n <= left_len { n } else { left_len - src }
  let right_src = if src >= left_len { src - left_len } else { 0 }
  fill_range(flat, load_addr(addr_at(node, 12)), dest + in_left, right_src, n - in_left, st)
  fill_range(flat, left, dest, src, in_left, st)
}

// A whole concat drains an EXPLICIT heap stack of (node, offset) pairs:
// destinations are absolute, so sibling order is irrelevant and the walk
// needs no call stack. Native recursion died at rope depth — a ++-folded
// chain leans left one node per append, thousands deep. A concat reached
// through a snoc or a slice re-enters as a fresh drain, so call depth is the
// representation's alternation depth, never the concat depth. Two words an
// entry, [2k] the node as its address punned (addr_word in, word_addr out,
// the runtime's word protocol) and [2k+1] its offset, since the stack of the
// emitted module's rope holds a pair for every node of its spine; entry 0 is
// a permanent floor, so sp == 1 means empty.
fn ff_push(stack, k, node, off) = {
  let grown = list_extend_to(stack, k * 2 + 2)
  list_set(list_set(grown, k * 2, addr_word(node)), k * 2 + 1, off)
}

fn ff_concat_drain(flat, stack, sp, st) = if sp <= 1 {
  ()
} else {
  let node = word_addr(stack[(sp - 1) * 2])
  let off = stack[(sp - 1) * 2 + 1]
  match addr_at(node, 4) |> load_i32 |> seq_shape {
    SeqConcat => {
      let left = load_addr(addr_at(node, 8))
      let right_entry = ff_push(stack, sp - 1, load_addr(addr_at(node, 12)), off + load_i32(left))
      ff_concat_drain(flat, ff_push(right_entry, sp, left, off), sp + 1, st)
    },
    SeqFlat | SeqSnoc | SeqSlice => {
      fill_range(flat, node, off, 0, load_i32(node), st)
      ff_concat_drain(flat, stack, sp - 1, st)
    },
  }
}
