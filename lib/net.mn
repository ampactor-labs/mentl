import io

// net.mn — the socket substrate (WASI preview1, proven by the sockprobe
// contract 2026-07-10). The host preopens a LISTENING TCP socket
// (wasmtime -S tcplisten=ADDR); sock_accept yields a connection fd that
// fd_read / fd_write / fd_close already speak. Both the listener and its
// connections are NONBLOCKING, so every wait is an honest poll_oneoff —
// never a spin on EAGAIN (errno 6).
//
// poll_fd — block until fd is ready. tag 1 = readable, 2 = writable
// (the preview1 subscription tags). One 48-byte subscription + one
// 32-byte event, allocated per wait (the bump image never frees; a
// serve loop's waits are droplets beside the compile's lake).
fn poll_fd(fd, tag) = {
  let sub = alloc(48)
  // userdata lo (an arbitrary marker)
  store_i32(sub, 7)
  // userdata hi
  store_i32(sub + 4, 0)
  store_i8(sub + 8, tag)
  store_i32(sub + 16, fd)
  let ev = alloc(32)
  let nev = alloc(4)
  poll_oneoff(sub, ev, 1, nev)
  ()
}

// sock_accept_blocking — poll the listener readable, then accept; EAGAIN
// (a raced-away connection) polls again. Returns the connection fd.
fn sock_accept_blocking(listen_fd) = {
  poll_fd(listen_fd, 1)
  let ro = alloc(4)
  let errno = sock_accept(listen_fd, 0, ro)
  if errno == 0 { load_i32(ro) } else { sock_accept_blocking(listen_fd) }
}

// find_listener — the preopen table is positional (dirs first, then
// tcplisten), so the listener's fd depends on the invocation. Read the
// truth from the table itself: the first fd in [3, 8) that ANSWERS like a
// listener (accept says ok=0 or EAGAIN=6; a dir preopen says ENOTSOCK).
// -1 = no listener preopened (the caller reports and exits).
fn find_listener() = find_listener_from(3)

fn find_listener_from(fd) = if fd >= 8 {
  0 - 1
} else {
  let ro = alloc(4)
  let errno = sock_accept(fd, 0, ro)
  // a real early connection: serve it next accept
  if errno == 0 {
    fd_close(load_i32(ro))
    fd
  } else if errno == 6 {
    fd
  } else {
    find_listener_from(fd + 1)
  }
}

// sock_read — poll readable, then one fd_read into buf (up to cap bytes).
// Returns nread (0 = peer closed). EAGAIN polls again.
fn sock_read(fd, buf, cap) = {
  poll_fd(fd, 1)
  let iov = alloc(8)
  let nread_ptr = alloc(4)
  store_i32(iov, buf)
  store_i32(iov + 4, cap)
  let errno = fd_read(fd, iov, 1, nread_ptr)
  if errno == 0 { load_i32(nread_ptr) } else if errno == 6 { sock_read(fd, buf, cap) } else { 0 }
}

// sock_write_all — write the whole [ptr, ptr+len) region, looping on
// partial writes (a socket buffer fills mid-stream on anything big) and
// polling writable on EAGAIN. The write loop IS the contract; a single
// fd_write on a 1.9MB wasm body silently truncates.
fn sock_write_all(fd, ptr, len) = if len <= 0 {
  ()
} else {
  let iov = alloc(8)
  let nw_ptr = alloc(4)
  store_i32(iov, ptr)
  store_i32(iov + 4, len)
  let errno = fd_write(fd, iov, 1, nw_ptr)
  if errno == 0 {
    let nw = load_i32(nw_ptr)
    if nw <= 0 { () } else { sock_write_all(fd, ptr + nw, len - nw) }
  } else if errno == 6 {
    poll_fd(fd, 2)
    sock_write_all(fd, ptr, len)
  } else {
    ()
  }
}

// sock_write_str — a Mentl string (any shape) onto the socket, whole.
// str_payload is the materialization boundary: rope/slice flattens here.
fn sock_write_str(fd, s) = sock_write_all(fd, str_payload(s), byte_len(s))
