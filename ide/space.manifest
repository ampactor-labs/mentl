# ide/space.manifest — what Mentl Space is: the one home the page, the
# staging script (tools/space-stage.sh), the deploy and the IDE gate read.
# `root` is where the page finds these paths: `..` in the repo (the page
# lives in ide/), `.` once staged beside the page. A `program` is a
# one-file project; a `project` is a folder of modules, which staging expands
# into `member` lines (a static host lists no folder): Pulse's renderer, the
# course's ten lessons with the module they share, and Wasatch's score.
root ..
wasm boot/mentl.wasm
wheel src/main.mn
lib lib/memory.mn
lib lib/strings.mn
lib lib/lists.mn
lib lib/threading.mn
lib lib/io.mn
lib lib/fs.mn
lib lib/prelude.mn
lib lib/math.mn
lib lib/dsp/clock.mn
lib lib/dsp/feedback.mn
lib lib/dsp/signal.mn
lib lib/dsp/spectral.mn
lib lib/dsp/cfc.mn
lib lib/dsp/processors.mn
lib lib/dsp/osc.mn
lib lib/dsp/envelope.mn
lib lib/dsp/stereo.mn
lib lib/audio/wav.mn
lib lib/ml/grad.mn
project examples/pulse/render
project examples/pulse/course
project examples/wasatch
