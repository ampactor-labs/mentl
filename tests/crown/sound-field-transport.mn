// check: accepted
// CROWN — the sound dual: a record CARRYING an effectful closure
// transports under `with !E` — latency is not performance; only the
// call performs. Must accept.
effect E { op() -> Int }
fn make() = ({run: () => op()})
fn good() with !E = {
  let r = make()
  1
}
fn main() = good()
