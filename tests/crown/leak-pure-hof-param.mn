// CROWN — `with Pure` on a HOF is absolute (SYNTAX): a parameter it calls
// may perform nothing, so a caller handing it a performing closure is
// refused. Expect E_EffectMismatch.
//
// Checked clean and ran through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
fn run(f) with Pure = f()
fn bad() = run(() => op())
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
