// CROWN — a !E function's let-bound lambda calls the function's parameter; a
// caller hands it a performing closure. Expect E_EffectMismatch.
//
// Checked clean through the pinned boot, narrating that the body uses
// Pure, and ran at 8 (measured 2026-09-23).
effect E { op() -> Int }
fn g(f) with !E = {
  let k = { x => f() + x }
  k(1)
}
fn bad() = g(() => op())
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
