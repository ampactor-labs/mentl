// CROWN — a closure-carrying instance in a callee's content, installed under two
// handlers by two callers, one of which also sets a performing closure.
// Must accept.
//
// Accepted through the pinned boot (measured 2026-09-23). The row cell
// inside the content is the callee's, renamed per use.
effect E { op() -> Int }
effect Feed { set(k: () -> Int), fire() -> Int }
handler holder with s = () => 0 {
  set(k) => resume() with s = k,
  fire() => resume(s()),
}
fn body4() = set(() => 1)
fn good() with !E = {
  body4()
  fire()
} ~> holder
fn other() = {
  body4()
  set(() => op())
  fire()
} ~> holder
handler eh { op() => resume(7) }
fn main() = (good() + other()) ~> eh
