// CROWN refinement (S5, 2026-10-02): a state no arm writes holds its init
// at every read, so `100 / d` over `with d = 5` is total and `!Trap` holds —
// the control beside `leak-state-write`, which only the write separates.
effect Ask {
  ask() -> Int
}

handler h with d = 5 {
  ask() => resume(100 / d),
}

fn main() with !Trap = ask() ~> h
