// CROWN — a HOF sealed `!E` never calls its parameter; it FORWARDS it to
// another generalized HOF that does. A caller hands it a performing fn.
// Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured
// 2026-09-23). The bound the declaration puts on its own frame must reach
// its own parameter through the forwarding callee's instance, and must
// never land on that callee's generalized declaration.
effect E { op() -> Int }
fn loop_apply(f, n) = if n <= 0 { f() } else { loop_apply(f, n - 1) }
fn g2(f) with !E = loop_apply(f, 3)
fn loud() = op()
handler h { op() => resume(7) }
fn main() = g2(loud) ~> h
