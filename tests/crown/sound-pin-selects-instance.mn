// CROWN — two declarations pin one unpinned callee to two instances, and a
// negation forbids only the other one. Must accept.
//
// Accepted through the pinned boot (measured 2026-09-23).
effect Sample(rate: Int) { tick() -> Int }
fn raw() = tick()
fn i44() with Sample(44100) = raw()
fn i48() with Sample(48000) = raw()
fn fine() with !Sample(44100) = i48()
handler h { tick() => resume(1) }
fn main() = (fine() + i44()) ~> h
