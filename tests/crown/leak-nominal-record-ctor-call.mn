// CROWN — latency rides a NOMINAL record's declared fn field, constructed by
// the call form `Job({run: loud})`, the field read and called under
// `with !E`. Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured 2026-09-23):
// the constructor's arrow view instantiates the declared field row, while
// the field access reads the nominal's fields raw — two copies of one
// identity cell, and nothing connects them.
effect E { op() -> Int }
type Job = {run: () -> Int}
fn loud() = op()
fn make() = Job({run: loud})
fn bad() with !E = {
  let j = make()
  let f = j.run
  f()
}
handler h { op() => resume(7) }
fn main() = bad() ~> h
