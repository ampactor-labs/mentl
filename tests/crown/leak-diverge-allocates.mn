// CROWN — a `<|` fanout builds its result tuple. Expect E_EffectMismatch under the
// declared !Alloc.
//
// Checked clean through the pinned boot, and the heap mark moved 56 bytes
// (measured 2026-09-23).
fn inc(x) = x + 1
fn dbl(x) = x * 2
fn f(x) with !Alloc = match x <| (inc, dbl) {
  (a, b) => a + b,
}
fn main() = {
  let m0 = heap_mark()
  let r = f(1)
  heap_mark() - m0
}
