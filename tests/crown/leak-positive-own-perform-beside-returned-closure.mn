// CROWN — a declared positive row over a body that performs E itself and also
// returns a closure performing E. Expect E_EffectMismatch.
//
// Refused through the pinned boot (measured 2026-09-23). A guard: the
// return type's row is the function's own output, never an exemption.
effect E { op() -> Int }
fn f() with Memory + Alloc = {
  let x = op()
  () => x + op()
}
handler eh { op() => resume(7) }
fn main() = (f()()) ~> eh
