// CROWN — the pre-gate copy: a fully signature'd fn instantiates its own
// pre-registered scheme at the recursive call, BEFORE its exit gates f's
// cell, so the copy bound to `() => op()` was never checked (exit 7 on
// boot 2974547b — adv-sigd-self-rec). The copy is noted under its root at
// the mint; the exit install walks the notes and judges the copy's
// binding. Expect E_EffectMismatch.
effect E { op() -> Int }
handler h { op() => resume(7) }
fn run(f: () -> Int, n: Int) -> Int with !E = if n > 0 { run(() => op(), n - 1) } else { f() }
fn main() = (run(() => 1, 1)) ~> h
