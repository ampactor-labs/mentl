// check: refuse E_EffectMismatch
// CROWN instance (§11 6.2) — the CONSERVATIVE arm: a non-literal
// instance argument (EANode — `Sample(rate)`) is not provably distinct
// from the forbidden 44100, so the gate refuses rather than assumes.
// Expect E_EffectMismatch.
effect Sample(rate: Int) { tick() -> Int }
let rate = 44100
fn inner() with Sample(rate) = tick()
fn bad() with !Sample(44100) = inner()
fn main() = bad()
