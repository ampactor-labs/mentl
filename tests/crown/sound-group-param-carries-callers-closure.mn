// CROWN — a group member's positive row bounds its OWN effects; the closure its
// co-member hands it performs, and that is the co-member's. Must accept.
//
// Accepted through the pinned boot, ran at 8 (measured 2026-09-23).
effect E { op() -> Int }
fn b(f, n) with Memory + Alloc = {
  let unused = a
  f(n) + len([n])
}
fn a(n) = b({ x => op() }, n)
handler eh { op() => resume(7) }
fn main() = (a(1)) ~> eh
