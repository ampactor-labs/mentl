// CROWN — a fn payload one level down a RECURSIVE type, called under
// `with !E`. Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured
// 2026-09-23). A recursive occurrence of `Chain` inside its own
// declaration must carry the same row parameters as the outer one.
effect E { op() -> Int }
type Chain = Link(() -> Int, Chain) | End
fn loud() = op()
fn quiet() = 1
fn second(c) with !E = match c {
  Link(_, rest) => match rest {
    Link(g, _) => g(),
    End => 0,
  },
  End => 0,
}
handler eh { op() => resume(7) }
fn main() = (second(Link(quiet, Link(loud, End)))) ~> eh
