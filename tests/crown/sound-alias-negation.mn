// CROWN — the sound dual: `!Both` forbids its members and NOTHING more.
// A body performing C, which the alias does not name, must be accepted
// under `with !Both` — a negation that over-refused would make named
// rows unusable, which is the opposite failure from the leak case.
effect A { opa() -> Int }

effect B { opb() -> Int }

effect C { opc() -> Int }

type Both = A + B

fn good() with !Both + C = opc()

// The handler at main makes the program EXECUTABLE: the root gate reads
// the row alone (2026-09-27), and a C performed with no install anywhere
// refuses at the root — it did on every boot before, hidden by a crown
// judge that counted one class.
handler hc { opc() => resume(1) }

fn main() = (good()) ~> hc
