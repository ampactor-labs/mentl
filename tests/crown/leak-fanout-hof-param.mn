// CROWN — a `><` branch calls a HOF parameter, the caller handing a
// performing closure under `with !E`. Expect E_EffectMismatch.
//
// Checked clean and ran at 8 through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
fn par(f) = {
  let (a, b) = (f()) >< (1)
  a + b
}
fn bad() with !E = par(() => op())
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
