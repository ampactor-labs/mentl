// check: accepted
// CROWN — the sound dual: a handler whose config default performs NOTHING
// installs freely under `with !E`. The default still fires and still binds
// `k`; charging what an install evaluates must not charge what it does not.
effect E { op() -> Int }
effect F { g() -> Int }
handler hf(k: Int = 5) with s = 1 {
  g() => resume(s + k),
}
fn good() with !E = (g()) ~> hf
fn main() = good()
