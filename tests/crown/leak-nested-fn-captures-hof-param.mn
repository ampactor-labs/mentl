// CROWN — the nested-fn face of leak-lambda-captures-hof-param: `inner`
// calls the enclosing HOF's parameter. Expect E_EffectMismatch.
//
// Checked clean through the pinned boot (measured 2026-09-23): a nested fn
// is a lambda bound by name, and its exit settles the enclosing
// parameter's call cell the same way.
effect E { op() -> Int }
fn outer(h) = {
  fn inner(k) = h(k)
  inner(1)
}
fn clean() with !E = outer({ x => op() })
fn main() = 0
