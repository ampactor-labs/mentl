// CROWN — a `><` fanout builds its branch thunks and its result tuple. Expect
// E_EffectMismatch under the declared !Alloc.
//
// Checked clean through the pinned boot, and the heap mark moved 40 bytes
// (measured 2026-09-23).
fn f() with !Alloc = match (1 + 1) >< (2 + 2) {
  (a, b) => a + b,
}
fn main() = {
  let m0 = heap_mark()
  let r = f()
  heap_mark() - m0
}
