// check: accepted
// CROWN — the sound dual at the SUM carrier: a variant CARRYING an
// effectful closure transports under `with !E`, and matching it out
// without calling performs nothing. Must accept.
effect E { op() -> Int }

type Box = Empty | Holds(a)

fn make() = Holds(() => op())

fn good() with !E = match make() {
  Holds(_f) => 1,
  Empty => 0,
}

fn main() = good()
