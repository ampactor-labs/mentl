// CROWN — the declaring member forwards its parameter to the co-member that
// calls it. Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
fn a(g, n) with !E = if n > 5 { 0 } else { b(g, n + 1) }
fn b(f, n) = if n > 5 { f(n) } else { a(f, n + 1) }
fn z() = b({ x => op() }, 0)
handler eh { op() => resume(7) }
fn main() = (z()) ~> eh
