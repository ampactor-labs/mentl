// CROWN — a let-bound lambda forwards its parameter to a !E callee, and the body
// calls it with a performing closure. Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
fn strict(g) with !E = g()
fn bad() = {
  let k = { h => strict(h) }
  k(() => op())
}
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
