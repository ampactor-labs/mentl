// CROWN partiality (TRAP, 2026-10-06): a read whose index and length the
// text fixes is proven in range — a constant index into a list literal,
// into a let bound to one, through every tail of a join, and a byte read of
// a string literal — so it reads the unchecked traversal and performs no
// Trap. Must raise nothing.
fn pick(c) with !Trap = {
  let xs = [10, 20, 30]
  let ys = if c { [1, 2] } else { [3, 4, 5] }
  [7, 8, 9][2] + xs[1] + ys[1] + "abc"[2]
}

fn main() = pick(true)
