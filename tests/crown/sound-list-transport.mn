// check: accepted
// CROWN — the sound dual at the sequence kind: a list CARRYING
// effectful closures transports under `with !E` — latency is not
// performance; only the call performs. Must accept.
effect E { op() -> Int }
fn make() = [() => op()]
fn good() with !E = {
  let fs = make()
  len(fs)
}
fn main() = good()
