// check: refuse E_EffectMismatch
// CROWN instance — the effect-name arm's guard: the SAME effect at the
// same argument position is the SAME instance. !Flow(1, Store) refuses
// the body's Flow(1, Store). Expect E_EffectMismatch.
effect Store { put(x: Int) -> Int }
effect Flow(src: Int, sink: Int) { move(x: Int) -> Int }
fn inner() with Flow(1, Store) = move(1)
fn bad() with !Flow(1, Store) = inner()
fn main() = bad()
