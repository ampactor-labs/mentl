// CROWN — the sound twin of leak-fn-type-alias-negation-through-alias: a
// callback performing an effect outside the named row is admitted through
// the alias, so the alias's row forbids Both's members and nothing else.
effect A {
  opa() -> Int
}

effect B {
  opb() -> Int
}

effect C {
  opc() -> Int
}

fn run(f: Thunk) = f()

handler hc {
  opc() => resume(7),
}

fn main() = run(() => opc()) ~> hc

type Thunk = () -> Int with !Both

type Both = A + B
