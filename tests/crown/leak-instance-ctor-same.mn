// check: refuse E_EffectMismatch
// CROWN instance — the ctor fold's guard: folding a nullary ctor to its
// value-distinct form must never admit the SAME instance. !Flow(1, Store)
// refuses the body's Flow(1, Store). Expect E_EffectMismatch.
type Sink = Wasi | Store
effect Flow(src: Int, sink: Sink) { move(x: Int) -> Int }
fn inner() with Flow(1, Store) = move(1)
fn bad() with !Flow(1, Store) = inner()
fn main() = bad()
