// CROWN — the control for leak-mask-sibling: the E-performing callback
// is the one the tee encloses, so h absorbs it and the declared !E holds.
// Expect NO E_EffectMismatch.
effect E { op() -> Int }
handler h { op() => resume(7) }
fn run(f, g) = f() + ((g()) ~> h)
fn good() with !E = run(() => 1, () => op())
fn main() = good()
