// CROWN — the recursion-cycle face of leak-absorbing-hof-mask-scope: the
// install covers a co-member's call and `k` is called outside it.
// Expect E_EffectMismatch.
//
// Refuses through the pinned boot; the in-flight rows landing accepted it
// (measured 2026-09-23), because its mask covered every source of the
// frame cell. Each install is its own cell.
effect E { op() -> Int }
handler absorb { op() => resume(5) }
fn g5(n, k) = if n > 3 { k(n) } else { (h5(n) ~> absorb) + k(1) }
fn h5(n) = g5(n + 1, { z => z })
fn clean() with !E = g5(0, { y => op() + y })
fn main() = 0
