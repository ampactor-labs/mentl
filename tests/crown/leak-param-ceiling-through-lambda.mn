// CROWN — the direct control of leak-param-ceiling-through-generic: the
// lambda calls `h` itself. Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
fn strict(g: () -> Int with !E) with !E = g()
fn mid(h) = strict(() => h())
handler eh { op() => resume(7) }
fn main() = (mid(() => op())) ~> eh
