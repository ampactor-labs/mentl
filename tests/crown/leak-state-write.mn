// CROWN refinement (S5, 2026-10-02): a handler's state is every value
// written into it. `d` starts at 5 and `shrink` writes `d - 5`, so the
// division `ask` makes owes `d != 0` of a write nothing bounds, and the open
// claim's `Trap` reaches `!Trap`. The proof read the init alone, so this
// checked clean and divided by zero on pin 53f7404b and boot 1a68ecc0.
// Expect E_EffectMismatch.
effect Ask {
  ask() -> Int
  shrink() -> Int
}

handler h with d = 5 {
  ask() => resume(100 / d),
  shrink() => resume(0) with d = d - 5,
}

fn main() with !Trap = shrink() + ask() ~> h
