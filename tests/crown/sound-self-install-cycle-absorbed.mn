// CROWN — the control of leak-self-install-cycle: the caller installs the
// absorber too. Must accept.
//
// Accepted through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
handler absorb { op() => resume(5) }
fn walk(f, n) = if n == 0 { f() } else { (walk(f, n - 1)) ~> absorb }
fn good() with !E = (walk(() => op(), 0)) ~> absorb
handler eh { op() => resume(7) }
fn main() = (good()) ~> eh
