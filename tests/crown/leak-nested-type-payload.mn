// CROWN — a fn payload inside a nominal that is itself the payload of
// another nominal, called under `with !E`. Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured
// 2026-09-23). A type that mentions a row-parameterized type inherits its
// parameters.
effect E { op() -> Int }
type Job = Job(() -> Int)
type Outer = Outer(Job)
fn loud() = op()
fn run_outer(o) with !E = match o {
  Outer(j) => match j {
    Job(f) => f(),
  },
}
handler eh { op() => resume(7) }
fn main() = (run_outer(Outer(Job(loud)))) ~> eh
