// CROWN — a partial application builds a closure record. Expect E_EffectMismatch
// under the declared !Alloc.
//
// Checked clean through the pinned boot, and the run's heap mark moved 16
// bytes (measured 2026-09-23).
fn add(a, b) = a + b
fn f() with !Alloc = {
  let p = add(1)
  p(2)
}
fn main() = {
  let m0 = heap_mark()
  let r = f()
  heap_mark() - m0
}
