// CROWN — the join partner is a let-bound lambda, whose reference is its own
// instantiated copy. Expect E_EffectMismatch.
//
// A guard, refused through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
fn g(c, f) with !E = {
  let dflt = () => 3
  let k = if c { f } else { dflt }
  k()
}
fn bad() = g(true, () => op())
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
