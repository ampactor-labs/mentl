// CROWN — a parameter sealed !E joined with a performing function, the join
// called, nothing declared on the joining function. Must accept.
//
// Falsely refused through the pinned boot (measured 2026-09-23). A join
// is a fresh cell every branch flows into; it never unions a branch's
// content into another branch's sealed cell.
effect E { op() -> Int }
fn loud() = op()
fn quiet() = 3
fn g(h: () -> Int with !E, c) = {
  let k = if c { h } else { loud }
  k()
}
handler eh { op() => resume(7) }
fn main() = (g(quiet, false)) ~> eh
