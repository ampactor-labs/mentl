// CROWN — the path order swapped, so no single-instance choice can hold both.
// Expect E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
effect Run { run(f: () -> Int) -> Int }
handler skip { run(f) => resume(0) }
handler call { run(f) => resume(f()) }
fn g(b) = ((b()) ~> call) + ((b()) ~> skip)
fn bad() with !E = g(() => run(() => op()))
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
