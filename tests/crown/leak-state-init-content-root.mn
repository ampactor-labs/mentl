// CROWN — a handler state initialized with a closure that already carries
// content, then replaced by a performing closure the arm calls. Expect
// E_EffectMismatch.
//
// Checked clean and ran at 7 through the pinned boot (measured
// 2026-09-23). A root that holds content when it is first reached is
// still a root: the state cell is renamed per install, and its content is
// not what makes it one.
effect E { op() -> Int }
effect Feed { set(k: () -> Int), fire() -> Int }
fn quiet() = 3
handler holder with s = () => quiet() {
  set(k) => resume() with s = k,
  fire() => resume(s()),
}
fn bad() with !E = {
  set(() => op())
  fire()
} ~> holder
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
