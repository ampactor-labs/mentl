// CROWN — a recursion cycle passes a PURE lambda to its co-member `b`, and
// an unrelated caller with NO declared row hands `b` a performing one.
// Nothing claims `!E`. Must accept.
//
// Falsely refused through the pinned boot (measured 2026-09-23, "E vs
// Pure" at the second call): the co-member's pure lambda is published as
// `b`'s parameter row, so a demand became a ceiling.
effect E { op() -> Int }
fn a(n) = if n > 5 { 0 } else { b({ x => x + 1 }, n + 1) }
fn b(f, n) = if n > 5 { f(n) } else { a(n + 1) }
fn z2() = b({ x => op() }, 0)
fn main() = 0
