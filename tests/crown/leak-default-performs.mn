// CROWN — a parameter default performs, and a default is a callee-scoped fill, so
// the callee is charged. Expect E_EffectMismatch.
//
// A guard, refused through the pinned boot (measured 2026-09-23).
effect E { op() -> Int }
fn takes(a, b = op()) = a + b
fn bad() with !E = takes(1)
handler eh { op() => resume(7) }
fn main() = (bad()) ~> eh
