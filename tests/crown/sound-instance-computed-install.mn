// The computed face of sound-instance-own-install: `run` installs the clock
// at a rate its caller hands, and a stage that names no rate runs at the
// rate of the clock around it — the install binds its instance to the
// operand that computes the config, so the install absorbs it and `run`
// performs nothing at 44.1 kHz. Expect NO E_EffectMismatch.
effect Sample(rate: Int) {
  tick() -> Int
}

handler clock_at(rate) {
  tick() => resume(rate),
}

fn any_rate() = tick()

fn run(r) with !Sample(44100) = any_rate() ~> clock_at(r)

fn main() = run(44100) - 44090
