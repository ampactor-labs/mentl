// CROWN — the controller shape: a higher-order function with a written row
// variable, so its row is exactly its callback's. The decision passes it a
// callback that reads the network, and the variable is filled in with Net.
// Expect E_EffectMismatch.
effect Net {
  fetch(url: String) -> Int
}

handler offline {
  fetch(url) => resume(50000),
}

fn twice(f: (Int) -> Int with e, x: Int) -> Int with e = f(f(x))

fn decide(hz: Int) -> Int with !Net = twice((v) => v + fetch("https://api.eia.gov/"), hz)

fn main() = decide(60000) ~> offline
