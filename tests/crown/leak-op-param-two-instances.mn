// CROWN — two performs of an op with a fn-typed parameter in one frame,
// `run(quiet) + run(loud)`, installed under `with !E`.
// Expect E_EffectMismatch.
//
// Checked clean and ran at 10 through the pinned boot (measured
// 2026-09-23): the row keeps one `Run` entry by NAME, so loud's instance
// is dropped before the install sees it. Instances of one effect coexist
// by identity until an install reconciles them.
effect E { op() -> Int }
effect Run { run(f: () -> Int) -> Int }
fn loud() = op()
fn quiet() = 3
handler runner { run(f) => resume(f()) }
fn body() = run(quiet) + run(loud)
fn bad() with !E = body() ~> runner
handler h { op() => resume(7) }
fn main() = bad() ~> h
