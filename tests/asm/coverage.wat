;; select, and every section and name subsection. coverage.wasm is the module
;; WABT 1.0.39 wrote from this text (wat2wasm --no-check --debug-names
;; --enable-threads --enable-tail-call); tools/asm-gate.sh holds `mentl asm`
;; to it byte for byte. Operands are omitted, so the module does not
;; validate: it measures the projection, never a program.
