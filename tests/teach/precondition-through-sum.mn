// teach 14: add m: Count
// The open claim is that m + 1 is Positive, read through the sum's two
// ends. A precondition that bounds m on both sides makes it hold, since
// the sum then stays inside the word: from 0 to 1000 does, and so does
// from 1 to 1000, but the call with 0 proves only the first.
type Positive = Int where 0 < self

type Count = Int where 0 <= self && self <= 1000

type Step = Int where 0 < self && self <= 1000

fn inv(n: Positive) = 100 / n

fn f(m) = inv(m + 1)

fn main() = f(4) + f(0)
