// teach 10: none
// The body proves the contract through the sum's lower bound, and the call is
// what the body computes there: `inc(p)` is at least 2, so the caller's claim
// owes nothing and no stated return is needed. On the boot before the call
// reading it proposed `-> Positive`.
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn inc(x: Positive) = x + 1

fn h(p: Positive) = inv(inc(p))

fn main() = h(3)
