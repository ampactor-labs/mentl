// The replay VALUE barrier (the row half's sibling, one landing later):
// a frame-declared authored `own` FREE in a persist_branch thunk crosses
// the wire as bytes while the duty to finish it stays behind — each
// resumed run re-consumes it, BParallel's collision law read on the TIME
// axis. T_OwnAcrossReplay names `buf` at risky's call edge; safe's
// self-contained thunk stays silent. Narration tier (the census arming
// law), so the whole checkpoint+run+join loop still runs.
// Expected exit: 42.

fn risky(own buf) = {
  let h = persist_branch(() => len(buf))
  join_persist(h)
}

fn safe() = {
  let h = persist_branch(() => 21 + 18)
  join_persist(h)
}

fn main() = {
  risky([1, 2, 3]) + safe()
} ~> persist_to_disk ~> wasi_filesystem ~> fail_exit
