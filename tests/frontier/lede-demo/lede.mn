// The outer prose — a decl comment renders as the address's lede line.
fn compute(x) = {
  // The interior step — attaches to the statement that follows.
  let doubled = x * 2
  doubled + 1   // the trailing beat — attaches backward to its own line
}

fn main() = compute(20)

fn scaled(v) = apply(
  // the anonymous step — a lambda is a node like any other, and its line is its own
  (x) => x * 3,
  v)

fn apply(f, v) = f(v)
