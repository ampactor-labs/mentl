// expect: 90
// Product control: branch results remain exact when the scheduled value is a
// tuple containing both an Int and a Float.

fn bundle(x) = (x * 10, float_of_int(x) + 0.5)

fn main() = {
  let (left, right) = (2 <| (bundle, bundle)) ~> sequential_compose
  let (li, lf) = left
  let (ri, rf) = right
  li + ri + float_to_int(lf * 10.0 + rf * 10.0)
}
