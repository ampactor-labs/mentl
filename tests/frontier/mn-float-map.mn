// expect: 42
// The generic combinators over [Float]: the lambda's f64 face reaches the
// table through its word wrapper, elements cross the polymorphic boundary
// by reference, and the concrete sites cash the width back. map doubles,
// fold sums, filter counts, any finds.
fn main() = {
  let xs = [1.5, 2.5, 3.0]
  let ys = map((x) => x * 2.0, xs)
  let total = fold(0.0, (acc, x) => acc + x, xs)
  let big = filter((x) => x > 2.0, xs)
  if ys[0] == 3.0 && ys[2] == 6.0 && total == 7.0
     && len(big) == 2 && any((x) => x == 2.5, xs) { 42 } else { 1 }
}
