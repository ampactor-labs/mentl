// The catch-all fixture: a `_` or a bare binder over a SUM is the roster the
// author declined to write (Morgan, 2026-10-13). The judgment refuses each
// such match, naming the roster; `mentl tighten` writes the roster in the
// arm's place — under the binder when the arm bound one, the comment the arm
// carries kept above it — and a second run finds nothing. The arm over a
// word stays: `_` there is the honest complement.
type Shape = Dot | Line(Int) | Box(Int, Int) | Blob

fn sides(s) = match s {
  Dot => 0,
  Line(_) => 1,
  // a box and a blob have four sides each
  _ => 4,
}

fn named(s) = match s {
  Dot => "dot",
  other => "many",
}

fn sign(n) = match n {
  0 => 0,
  _ => 1,
}

fn main() = sides(Box(2, 3)) + sign(len(named(Blob)))
