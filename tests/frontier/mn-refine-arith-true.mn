// expect: 42
// R3 · the decidable arithmetic Verify fragment (true case).
// `self + 1 <= 10` with self = 5 decides TRUE (6 <= 10) at compile time — the
// construction is discharged, NO proof debt. Pre-R3 the NESTED `self` inside
// `self + 1` never substituted and the arithmetic never folded, so the
// obligation accrued as V_Pending instead. Runs to exit 42.
type Small = Int where self + 1 <= 10

fn main() = {
  let x: Small = 5
  x + 37
}
