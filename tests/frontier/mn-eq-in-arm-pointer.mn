// `==` is one structural-equality derivation, total over the five node-kinds
// (SYNTAX §Equality): two byte-equal Strings are equal wherever they are
// compared. Here the compare sits in a handler ARM over the op's quantified
// parameters. The install's handler expression is typed at the instance its
// performs prove — Strings — so the arm is twinned there and the compare reads
// String: exit 0. From 2026-09-18 until
// R0c no twin reached an arm through its effect's instance, the operand was
// still a variable at emit, and the compare ran on the two Strings' ADDRESSES
// — exit 1, no diagnostic, declared RED on the frontier.
effect Cmp {
  same(a, b) -> Bool
}

handler by_eq {
  same(a, b) => resume(a == b),
}

fn main() = if same("ab", str_concat("a", "b")) { 0 } else { 1 } ~> by_eq
