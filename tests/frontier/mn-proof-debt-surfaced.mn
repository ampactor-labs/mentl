// expect: 1
// `unchecked` claims its argument is Positive, and main hands it one minus
// the number of arguments the host passes, which no reading of the program
// can know: with no argument the claim holds, with any it fails. So the
// claim is pending, the normal state of a claim the verifier cannot decide:
// the compile prints it as V_Pending, exits 0 and emits the module, neither
// assuming the claim true nor refusing the program. The battery passes no
// argument, so the claim holds and the run answers 1; refusing the program
// would refuse one that runs correctly.
type Positive = Int where 0 < self

fn unchecked(x) -> Positive = {
  let claimed: Positive = x
  claimed
}

fn given(args) = match args {
  [] => 0,
  [_, ...rest] => 1 + given(rest),
}

fn main(argv) = unchecked(1 - given(argv))
