// expect: 42
// §5.U wide-element cash-out — [Float] as a first-class sequence: the literal
// is born packed (stride-8, sc 2), a concrete read derefs the element's
// reference, structural == compares VALUES through list_eq_f64 (never the
// references), and push/concat/slice ride the same carrier every list does.
// Before the word-protocol boundary landed, this file did not even ASSEMBLE
// (f64.const into list_set's i32 param — the measured baseline).
fn main() = {
  let xs = [1.5, 2.5, 3.0]
  if xs[1] == 2.5 && len(xs) == 3
     && xs == [1.5, 2.5, 3.0]
     && xs != [1.5, 2.5, 3.5]
     && push(xs, 4.5) == [1.5, 2.5, 3.0, 4.5]
     && ([1.5] ++ [2.5]) == [1.5, 2.5]   // drift-audit: ignore (one-shot concat test, not a loop accumulator)
     && slice(xs, 1, 3) == [2.5, 3.0] { 42 } else { 1 }
}
