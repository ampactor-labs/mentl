// The rooted-image persist — one build, two processes (§4④: persist = memcpy).
//
// Leg A (no argv): build heap state, park the continuation-shaped thunk in
// the typed root, persist the WHOLE image, exit 40. Leg B ("resume", a fresh
// process of the same wasm): rehydrate swaps A's image in — the typed root
// (a top-level let the globals record restores) hands back A's thunk fully
// typed, no cast; calling it chases A's heap pointees (the capture, the
// squares list) through the restored image. addr ties rehydrate's returned
// word to the typed channel — the two channels name one record.
// Expected exits: leg A 40, leg B 42.

fn freeze_zero() = 0

let root = [freeze_zero]

fn build(n) = if n == 0 { [] } else { push(build(n - 1), n * n) }

fn main(argv) = {
  if len(argv) > 1 {
    let k = image_resume("/tmp/mn-persist-image.img")
    let thunk = list_index(root, 0)
    if addr(thunk) == k { thunk() } else { 1 }
  } else {
    let xs = build(6)
    let a = list_index(xs, 2)
    let b = list_index(xs, 5)
    let thunk = () => a + b - 3
    list_set(root, 0, thunk)
    persist(image_pack(addr(thunk)), "/tmp/mn-persist-image.img")
    40
  }
} ~> persist_to_disk ~> fail_exit
