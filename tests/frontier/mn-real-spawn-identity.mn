// expect: 60
// Per-instance identity under real spawn: thread_id reads the identity
// the thread entry stamped into the spawned instance ($tid_g — a
// per-instance global IS instance-local storage). Every spawned task
// answers a positive host thread id; the root answers 0. The two
// branches run on distinct instances, so both reads are positive.
// Expected exit: 60.

fn main() = {
  let (a, b) = (0 <| ((_) => thread_id(), (_) => thread_id())) ~> parallel_compose
  if a > 0 && b > 0 { 60 } else { 1 }
}
