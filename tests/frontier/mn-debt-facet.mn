// expect: 1
// The debt facet's gate (the verification query renders WHAT is owed): a
// claim on a value no constant decides is honest debt at the call edge, and
// the query lists it LOCATED with its predicate — a count alone is not an
// instrument.
type Bounded = Float where -1.0 <= self && self <= 1.0
fn accept(s: Bounded) = 1
fn main(argv) = accept(float_of_int(len(argv)))
