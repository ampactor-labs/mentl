// expect: 11
// The arm-wide-op-arg gate (Hβ.emit.arm-wide-arg-face, closed): a handler
// arm may READ a wide op argument. A perform speaks its site's face, and
// the arm twinned at the install's instance is that face by construction,
// so an arm that uses a Float argument and an arm that ignores one both
// meet the value at its own width. The class hid behind the unused case
// once — an arm that ignored the argument floored to a word and matched by
// accident — which is why the pair stands together.
//
// The pair: `gain_read` reads its wide arg, `gain_ignored` ignores one.
// The frontier runs it to 11 (10 + 1).
type Gain = Float where 0.0 <= self

effect Mix {
  gain_read(g: Gain) -> Int
  gain_ignored(t: Gain) -> Int
}

handler mixer {
  gain_read(g) => if g <= 1.0 { resume(10) } else { resume(0) },
  gain_ignored(t) => resume(1),
}

fn run() = {
  let a = gain_read(0.5)
  let b = gain_ignored(0.25)
  a + b
}

fn main() = run() ~> mixer
