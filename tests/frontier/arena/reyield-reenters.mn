// The resumed rest performs the op again inside the re-entered arena, so
// the re-entry suspends in its turn and wraps the fresh continuation. The
// answer is the deep-handler value of the same body with no arena:
// pick() + pick() * 10 under `both` = (0 + 10) + (1 + 11) = 22.
effect Pick {
  pick() -> Int
}

handler both {
  pick() => {
    let a = resume(0)
    let b = resume(1)
    a + b
  },
}

fn build(n) = if n == 0 { [] } else { build(n - 1) ++ [n] }

fn body() = pick() + pick() * 10 + len(build(30)) - 30 ~> arena

fn plain() = pick() + pick() * 10 + len(build(30)) - 30

fn main() = {
  let r = body() ~> both
  let c = plain() ~> both
  if r == 22 && c == 22 && arena_stat(ArKept) == 0 { 42 } else { 1 }
}
