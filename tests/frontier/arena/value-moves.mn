// An arena's value moves out; what the body allocated and dropped is reclaimed.
fn build(n) = if n == 0 { [] } else { build(n - 1) ++ [n] }

fn add_int(a, b) = a + b

fn main() = {
  let before = heap_mark()
  let xs = build(200) ~> arena
  let after = heap_mark()
  let grew = addr_diff(after, before)
  if fold(0, add_int, xs) == 20100 && len(xs) == 200 && grew < 40000 && arena_stat(ArExits) == 1 {
    42
  } else {
    1
  }
}
