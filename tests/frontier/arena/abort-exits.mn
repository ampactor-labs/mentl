// An op performed inside an arena and answered by an arm that never
// resumes: the perform's argument, a list the arena allocated, is a
// PUBLICATION of the extent — it crosses to the arm — and the arena EXITS as
// any extent does when its body is done, a dead continuation holding nothing
// else of the region: the argument moves out through its leaf (its slot in
// the argument area was journaled where the perform stored it), the region
// is reclaimed, and the arm reads the list intact. A second arena opened
// afterwards exits as any arena does. Expected len(xs) = 10, no suspension,
// two exits, nothing kept.
//
// Until AN-2 the abandon was a yield and the arena SUSPENDED for it, keeping
// the region whole for a continuation nothing would ever resume; the first
// form of the exit reclaimed the region with the argument's slot unjournaled,
// and the arm read a reclaimed list (len 0 for 10, the frontier's red that
// named the journal entry).
effect Bail {
  bail(xs: [Int]) -> Int
}

handler catch_it {
  bail(xs) => len(xs),
}

fn build(n) = if n == 0 { [] } else { build(n - 1) ++ [n] }

fn body() = bail(build(10)) + len(build(300)) ~> arena

fn main() = {
  let r = body() ~> catch_it
  let ys = build(50) ~> arena
  if r == 10 && len(ys) == 50 && arena_stat(ArSuspended) == 0 && arena_stat(ArExits) == 2 && arena_stat(ArKept) == 0 {
    42
  } else {
    1
  }
}
