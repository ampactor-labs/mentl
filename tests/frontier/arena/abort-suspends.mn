// An op performed inside an arena and answered by an arm that never
// resumes: the arm reads the perform's argument, which the arena allocated,
// and the rest of the arena's body never runs. The unwind suspends the arena,
// so the argument survives and the arena is closed — a second arena opened
// afterwards is the only one open and reclaims as any arena does.
// Expected len(xs) = 10, one suspension, one exit (the second arena's).
effect Fail {
  fail(xs: [Int]) -> Int
}

handler catch_it {
  fail(xs) => len(xs),
}

fn build(n) = if n == 0 { [] } else { build(n - 1) ++ [n] }

fn body() = fail(build(10)) + len(build(300)) ~> arena

fn main() = {
  let r = body() ~> catch_it
  let ys = build(50) ~> arena
  if r == 10 && len(ys) == 50 && arena_stat(ArSuspended) == 1 && arena_stat(ArExits) == 1 {
    42
  } else {
    1
  }
}
