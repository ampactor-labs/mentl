// A module that spawns gives each instance its own run of the line (one
// atomic add per chunk, a private bump inside), so an arena's region is a
// span of its instance's run and its exit reclaims as it does
// single-threaded: in the root after the join, and inside each spawned
// branch, which opens arenas of its own. Until 2026-10-06 a spawn anywhere
// turned every arena in the module off — the body ran and no exit was
// counted (`Hβ.arena.per-instance-regions`). Expected exit: 42.
fn build(n) = if n == 0 { [] } else { build(n - 1) ++ [n] }

fn add_int(a, b) = a + b

// A branch's own arena: its exits count in its instance's census.
fn branch(_) = {
  let s = fold(0, add_int, build(60)) ~> arena
  if s == 1830 && arena_stat(ArExits) > 0 && arena_stat(ArKept) == 0 && arena_stat(ArFreed) > 0 {
    15
  } else {
    0
  }
}

fn main() = match 2 <| (branch, branch) ~> parallel_compose {
  (a, b) => {
    let s = fold(0, add_int, build(60)) ~> arena
    if a + b == 30 && s == 1830 && arena_stat(ArExits) > 0 && arena_stat(ArKept) == 0 && arena_stat(ArFreed) > 0 {
      42
    } else {
      1
    }
  },
}
