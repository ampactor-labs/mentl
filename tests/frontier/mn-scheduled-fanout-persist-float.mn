// Persist scheduler representation contract. The branch payload is Float, but
// the scheduler transports only the exact one-field carrier authored by
// inference. `persist_branch` returns an opaque PersistHandle and
// `join_persist` recovers the same generic carrier before field 0 is projected.
// Expected exit: 60.

fn widen(x) = float_of_int(x) * 15.0

fn main() = {
  let (a, b) = (2 <| (widen, widen)) ~> persist_to_disk ~> wasi_filesystem ~> fail_exit
  float_to_int(a + b)
}
