// expect: 10
// A module let's init runs once, in the root, before main: a spawned
// instance takes the root's module values and never re-runs an init. The
// init here prints, so a re-run is visible on stdout as a second line.
// A re-run would print "init" twice.
import io

let seed = {
  println("init")
  5
}

fn widen(x) = x + seed

fn main() = match 0 <| (widen, widen) ~> parallel_compose {
  (a, b) => a + b,
}
