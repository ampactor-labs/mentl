// The fmt fixture: one of every structural form the totality landing
// added — block, lambda, match, records, interpolation, patterns.
type Shade = Dark | Bright(Int)

fn pick(s) = match s {
  // the zero arm teaches the dark default
  Dark      => 0,
  Bright(n) => n
}

fn describe(x, tag) = "{tag}: {x}"

// The closed annotation is the concrete receiver the open-record field
// class needs (the lambda-param field read is that class's repro shape).
fn level_plus(a, b: {kind: String, level: Int}) = a + b.level

// The destructure-param lambda: the render must re-sugar the desugared
// machine form back to the authored pattern (a canonical page never
// bakes minted names), and the prose-carrying tuple below must hold the
// vertical layout so each label stays glued to its own element.
fn spread(f, pair) = f(pair)

fn keep(r) = r

// The heads of postfix forms — a field read's receiver, a call's callee, an
// index's receiver — each an operator expression: postfix binds tighter than
// every operator, so the render must keep their parens or the re-parse takes
// the postfix onto the head's last operand (the boot of 2026-09-28 rendered
// `(r |> keep).level` as `r |> keep.level`).
fn heads(r) = ((r |> keep).level - 5) + (((a, b) => a * b)(2, 3) - 6) + (([1, 2] ++ [3, 4])[2] - 3)

// A module-scope `let` bound to a function literal IS the declaration: the
// binder form renders as `fn`, and the arm-list form keeps its literal, whose
// one parameter is minted and never reaches the page.
let twice_of = (x) => x * 2

let or_zero = { Some(v) => v, None => 0 }

fn main() = {
  let base = {kind: "b", level: 2}
  let lifted = {...base, level: 3}
  let g = (n) => n + 1
  let (lo, hi) = (1, pick(Bright(40)))
  let both = spread(((a, b)) => a + b, (lo, hi))
  let labeled = (
    // the low end
    lo,
    // the high end
    hi
  )
  let (l2, _) = labeled
  let sharp = g((lo + hi) * 2) - (hi - lo) - 1
  describe(level_plus(lo, lifted) + hi, "sum")
  sharp + level_plus(lo, lifted) - 5 + both - hi - l2 + heads({kind: "c", level: 5}) + (twice_of(3) - 6) + (or_zero(Some(7)) - 7)
}
