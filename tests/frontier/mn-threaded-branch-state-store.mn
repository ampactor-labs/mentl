// The race rule reads EVERY write an arm makes into its handler's state,
// not only `resume … with`: `bump` stores into the state buffer in place
// (`list_set`), so two spawned branches bumping one `tally` install race
// on one cell from two instances. Refused at lowering, naming the store.
// The read-only control (mn-threaded-branch-state-read) differs by the
// store alone and runs. Expected: REFUSE E_ThreadedBranchEffect.
effect Tally {
  bump() -> Int
}

handler tally with buf = make_list(1) {
  bump() => {
    list_set(buf, 0, list_index(buf, 0) + 1)
    resume(list_index(buf, 0))
  },
}

fn main() = match 0 <| ({ _ => bump() }, { _ => bump() }) ~> parallel_compose ~> tally {
  (a, b) => a + b,
}
