// expect: 5
// A WRITTEN FIELD REPLACES THE BASE'S, WHATEVER ITS TYPE. The result is the
// text field b in front of a copy of the base past b, and the copy is the
// base's row without the name, so the base's Int field b stays the base's:
// s.b is the text and the record holds one b.
fn relabel(r) = {...r, b: "four"}

fn main() = {
  let s = relabel({a: 1, b: 2})
  s.a + len(s.b)
}
