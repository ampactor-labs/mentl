// expect: refuse E_RefinementRejected
// A function inside the record a call returns is every function the
// declaration can put there: `pick` publishes the meet of `succ` and `inv` at
// `f`, which demands `Positive`, so `.f(0)` is refuted. The published return
// kept the first branch's contract, so this checked clean and divided by
// zero on boots 1a68ecc0, 53f7404b and 85218488 (exit 134).
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn succ(n) = n + 1

fn pick(c) = if c { {f: succ} } else { {f: inv} }

fn main() with !Trap = pick(false).f(0)
