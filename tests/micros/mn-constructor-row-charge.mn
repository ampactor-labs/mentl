// expect: refuse E_PurityViolated
//
// Every form that builds a value allocates its record, so a tuple, list or
// record literal charges `Alloc` where it is built. A `with Pure` declared
// over one is refused, here at all three declarations, and `!Alloc`
// refuses every literal. A nullary constructor and a constant tuple's read
// allocate nothing and charge nothing.

fn pure_tuple(a, b) with Pure = (a, b)

fn pure_list() with Pure = [1, 2]

fn pure_record(x) with Pure = ({alpha: x, beta: 2})

fn main() = match pure_tuple(1, 2) {
  (p, q) => p + q + len(pure_list()) + pure_record(3).alpha,
}
