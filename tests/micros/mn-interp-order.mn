// expect: 10
// Interpolation assembles in SOURCE ORDER: "x{a}y{b}z" is exactly
// [120,66,121,68,122]. The wheel's lower_string_interpolation baked the
// FINAL fragment first (head = last) — every interpolated string m2
// lowered into m3 came out rotated ("$ft_{codes}_{rc}" → d$ft_iiiid_,
// m4.wat's first assembly failure once m4 existed at all, 2026-07-10).
// The seed's own make-string lowering is source-ordered, so m2's strings
// were fine and the wheel's copy was never order-gated until this micro.
fn main() = {
  let a = "B"
  let b = "D"
  let s = "x{a}y{b}z"
  if byte_len(s) == 5 && byte_at(s, 0) == 120 && byte_at(s, 1) == 66
     && byte_at(s, 2) == 121 && byte_at(s, 3) == 68 && byte_at(s, 4) == 122 { 10 }
  else { byte_len(s) }
}
