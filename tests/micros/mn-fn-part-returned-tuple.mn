// expect: refuse E_RefinementRejected
// A tuple's position publishes the meet of every function it can hold: the
// `g` a `let` takes out of `pick(false)` demands `Positive`, so `g(0)` is
// refuted. On pin 85218488 the position kept `succ`'s contract and this
// divided by zero (exit 134).
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn succ(n) = n + 1

fn pick(c) = if c { (succ, 1) } else { (inv, 2) }

fn main() with !Trap = match pick(false) {
  (g, _) => g(0),
}
