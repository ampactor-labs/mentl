// expect: refuse E_RefinementRejected
// A function written into state is one of the functions the state can be:
// `f` is `succ` at the install and `inv` after `arm_it`, so applying it at 0
// owes `inv`'s `Positive` of 0, refuted. The proof read the init's `succ`
// alone, so this checked clean and divided by zero on pin 53f7404b and
// boot 1a68ecc0 (exit 134).
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn succ(n) = n + 1

effect Pick {
  arm_it() -> Int
  call_it() -> Int
}

handler h with f = succ {
  arm_it() => resume(0) with f = inv,
  call_it() => resume(f(0)),
}

fn main() with !Trap = arm_it() + call_it() ~> h
