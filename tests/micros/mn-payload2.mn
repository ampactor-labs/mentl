effect Probe {
  emit(x) -> Int
}

handler collect {
  emit(v) => resume(v.beta),
}

fn helper() with Probe + Memory + Alloc = emit({alpha: 1, beta: 2, gamma: 3})

fn run() with Probe + Memory + Alloc = helper()

fn main(q) = run() ~> collect
