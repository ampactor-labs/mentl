// expect: 7
// A list built in an arena and stored into the field read off a call's fresh record, which holds an older list, must survive the arena's exit.
import arena

fn mk(x) = {f: x}

fn getf(r) = r.f

fn main() = {
  let older = make_list(1)
  list_set(older, 0, [0])
  {
    list_set(getf(mk(older)), 0, [7, 8, 9])
    0
  } ~> arena
  let junk = list_filled(16, 99)
  list_index(list_index(older, 0), 0) + len(junk) - 16
}
