// expect: refuse E_EffectMismatch
// HUM's controller shape (examples/grid/station.mn) with its positive row
// written as a cap. A negation alone says what the body never performs
// itself, so a new effect performed inside the decision and answered
// outside it, by a handler that reads the network, passes `!Net`
// (mn-grid-cap-exact-accepts shows the capped body accepted). The positive
// row `Mutate` is the row the body proves, and as a cap it refuses the
// perform of Price.
effect Net {
  fetch(url: String) -> Int
}

effect Price {
  price() -> Int
}

handler online {
  price() => resume(fetch("https://api.eia.gov/")),
}

handler offline {
  fetch(url) => resume(50000),
}

fn decide(hz: Int) -> Int with Mutate + !Net = {
  let n = { k => k + 1 } <~ delay(1)
  hz + n + price()
}

fn main() = decide(60000) ~> online ~> offline
