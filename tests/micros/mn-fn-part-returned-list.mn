// expect: refuse E_RefinementRejected
// A list's element position publishes the meet of every function the list
// can hold: `pick(false)[0]` is `succ` or `inv` to the caller, so `(0)` is
// refuted. On pin 85218488 the element kept `succ`'s contract and this
// divided by zero (exit 134).
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn succ(n) = n + 1

fn pick(c) = if c { [succ] } else { [inv] }

fn main() with !Trap = pick(false)[0](0)
