// expect: refuse E_RefinementRejected
// A declaration relaying another's result publishes what that result
// states: `outer` returns `pick(c)`, whose `f` is the meet `pick` published,
// so `outer(false).f(0)` is refuted. On pin 85218488 the relay carried the
// first branch's contract and this divided by zero (exit 134).
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn succ(n) = n + 1

fn pick(c) = if c { {f: succ} } else { {f: inv} }

fn outer(c) = pick(c)

fn main() with !Trap = outer(false).f(0)
