// expect: refuse E_EffectMismatch
// HUM's controller shape (examples/grid/station.mn): creating a closure that
// captures a value inside a function declared `!Alloc` mints its record,
// which allocates.
fn decide(hz: Int) -> Int with !Alloc = {
  let f = (x) => x + hz
  f(1)
}

fn main() = decide(60000)
