// expect: 40
// A VERB NEVER COSTS MORE THAN ITS DESUGARING. Under the sequential schedule a
// fanout's branches are evaluated in the frame the fanout stands in, and a
// tuple a pattern takes apart where it is made never becomes a record, so
// `match (x + 1) >< (x + 2) { (a, b) => a * b }` costs what
// `let a = x + 1; let b = x + 2; a * b` costs: nothing. A thousand calls,
// zero growth, under the same `!Alloc` the let-spelling carries.
fn f(x) with !Alloc = match (x + 1) >< (x + 2) {
  (a, b) => a * b,
}

fn run(n, acc) = if n == 0 { acc } else { run(n - 1, f(acc) % 1000) }

fn main() -> Int = {
  let before = heap_mark()
  let r = run(1000, 3)
  let grown = addr_diff(heap_mark(), before)
  if grown == 0 && r >= 0 { 40 } else { 41 }
}
