// expect: 40
// A handler installed outside the reading. State that lives past the extent
// enters it held fixed — its lane is stale where the reading opens and reads
// as zero — and is differentiated from the first write inside: s = w before
// the reading, then s += w² under it, so d(total()) is 2w = 4 at w = 2. A
// reading that credited the earlier write would answer 5.
//
// The declarations are lib/ml/grad.mn's, repeated because a micro links only
// the runtime floor.
effect Derivative {
  d(v: Float) -> t
}

handler grad(w) {
  d(v) => resume(tangent_of(v, w)),
}

effect Acc {
  put(v: Float)
  total() -> Float
}

handler acc with s = 0.0 {
  put(v) => resume() with s = s + v,
  total() => resume(s),
}

fn main() -> Int = {
  let w = 2.0
  let slope = {
    put(w)
    {
      put(w * w)
      d(total())
    } ~> grad(w)
  } ~> acc
  float_to_int(slope * 10.0)
}
