// check: refuse E_EffectMismatch
// Each call resets one counter while it climbs the other, and neither is a
// part of a value either parameter matched, so tangle is refused.
fn tangle(x, y) with !Diverge =
  if x < 3 { tangle(x + 1, 0) } else if y < 3 { tangle(0, y + 1) } else { 0 }

fn main() = 0
