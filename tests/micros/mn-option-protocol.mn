// expect: 42
// band B M2 RATCHET — the author-encoded Option protocol under TODAY's
// UZero convention (the bank's Option-protocol finding, pinned so M4's
// abandon cut is a MEASURED flip, never an accident). abort()'s arm value
// (None) returns TO THE PERFORM SITE — the abort does NOT unwind:
// `abort(); 0` discards the None and risky completes with 0, so the
// Some-wrap carries 0 and the catch never runs.
//   TODAY: exit 0 (diags 0).
//   M4 (uzero-abandon — an arm that never resumes delivers its value as
//   the INSTALL's, abandoning the continuation): this program flips to 42
//   (the catch branch). The flip is this ratchet's expected break — M4's
//   commit re-pins it with the measurement in hand.
effect Abort {
  abort() -> Option
}

handler my_catch {
  abort() => None
}

// A positive row on a HOF is a CAP on its callbacks (A3-pos, 2026-09-27):
// `with Abort` here refused the thunks' Memory + Alloc, so the row is
// inferred — the cap was never a decision.
fn try_with(try_fn, catch_fn) = {
  let attempted = (try_fn()) ~> my_catch
  match attempted {
    Some(value) => value,
    None        => catch_fn()
  }
}

fn risky(n) with Abort = if n > 3 { abort(); 0 } else { n * 7 }

fn main() = try_with(() => Some(risky(9)), () => 42)
