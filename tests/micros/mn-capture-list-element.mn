// expect: 30
// A perform as a list element between two others: each resumption builds its
// own list, the first element read from before the suspension and the last
// computed after it, (7 + 0 + 3) + (7 + 10 + 3).
effect Pick {
  pick() -> Int
}

handler both {
  pick() => {
    let a = resume(0)
    let b = resume(1)
    a + b
  },
}

effect Tally {
  bump()
  total() -> Int
}

handler tally with n = 0 {
  bump() => resume() with n = n + 1,
  total() => resume(n),
}

fn seven() = {
  bump()
  7
}

fn body() = {
  let xs = [seven(), pick(), 3]
  xs[0] + xs[1] * 10 + xs[2]
}

fn main() = body() ~> both ~> tally
