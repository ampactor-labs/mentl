// expect: 6
// mn-autodiff — the derivative reading, the smallest witness.
//
// d(x·x)/dx at x = 3 is 2·x = 6. The body evaluates `x * x` once; `d` asks
// how it changes with the seed, and the medium answers from the derivative
// program it derived from this chain — there is no tape and no hand-written
// backward pass. The declarations are lib/ml/grad.mn's, repeated here
// because a micro links nothing: the reading is recognized by the effect it
// answers (`Derivative`), the way a schedule is recognized by `Thread`.
//
// RED on the prior boot: the primitive the arm names did not exist and the
// install lowered as an ordinary handler.
effect Derivative {
  d(v: Float) -> t
}

handler grad(w) {
  d(v) => resume(tangent_of(v, w)),
}

fn main() -> Int = {
  let x = 3.0
  float_to_int(d(x * x) ~> grad(x))
}
