// expect: refuse E_EffectMismatch
// A state handed to a refined parameter owes the refinement of every value
// it can hold — the init's 5 and the write `d - 5` alike. The write's claim
// is open, so the guard `inv`'s division charged is paid here and `!Trap`
// refuses. Checked clean and divided by zero on pin 53f7404b and boot
// 1a68ecc0 (exit 134).
type Positive = Int where 0 < self

effect Ask {
  ask() -> Int
  shrink() -> Int
}

fn inv(n: Positive) = 100 / n

handler h with d = 5 {
  ask() => resume(inv(d)),
  shrink() => resume(0) with d = d - 5,
}

fn main() with !Trap = shrink() + ask() ~> h
