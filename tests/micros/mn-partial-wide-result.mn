// expect: 42
// A PARTIAL'S OPEN SLOT READS AT ITS OWN WIDTH, AND ITS BODY'S CALL AT THE
// CALLEE'S RESULT. `fadd(1.5)` leaves the Float slot b open; the synthesized
// body calls `fadd` with the supplied a and the open b, and answers a Float.
// On boot 523f1732 the open slot was typed by the partial node — the
// product's own arrow, a word — so the parameter was declared f64 and read
// as a word, and the module did not assemble (an undefined local). Each open
// slot is typed by its own cell now, written by the judgment beside the
// product, and a closure call's result face is the callee's return.
fn fadd(a: Float, b: Float) -> Float = a + b

fn main() -> Int = {
  let p = fadd(1.5)
  if p(2.0) == 3.5 { 42 } else { 0 }
}
