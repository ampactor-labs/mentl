// expect: refuse E_RefinementRejected
// The same through a tuple's position, taken apart by a pattern: the second
// element is owed `Positive` where the tuple is built. Checked clean under
// `!Trap` and divided by zero on boots e23392f6 and 1a68ecc0 (exit 134).
type Positive = Int where 0 < self

fn second_inv(p: (Int, Positive)) = match p {
  (_, d) => 100 / d,
}

fn main() with !Trap = second_inv((1, 0))
