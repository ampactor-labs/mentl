// expect: 20
// The same result applied at 5 proves both preconditions, so `!Trap` holds.
// Boot e23392f6 refused it (E_EffectMismatch), reading the call's class.
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn inv2(n: Int) = n + 1

fn pick_or(o, d) = match o {
  Some(v) => v,
  None => d,
}

fn main() with !Trap = pick_or(Some(inv), inv2)(5)
