// expect: refuse E_RefinementRejected
// A record a `let` built is claimed at the construction the let holds.
// Checked clean under `!Trap` and divided by zero on boots e23392f6 and
// 1a68ecc0 (exit 134).
type Positive = Int where 0 < self

fn den_inv(r: {den: Positive}) = 100 / r.den

fn main() with !Trap = {
  let q = {den: 0}
  den_inv(q)
}
