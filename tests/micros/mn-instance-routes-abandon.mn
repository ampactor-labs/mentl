// expect: 2
// An op that never resumes routes by its instance as a resumed one does: the
// stop `leave` raises is Stop(2), so it passes the install serving Stop(1)
// and lands at the one serving Stop(2), whose arm answers 2. On boot
// 342695ce the innermost install caught every instance by the op's name and
// answered 1.
effect Stop(code: Int) {
  halt() -> !
}

handler stop_at(code) {
  halt() => code,
}

fn leave() with Stop(2) = halt()

fn main() = leave() ~> stop_at(1) ~> stop_at(2)
