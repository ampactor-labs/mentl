// expect: 30
// The `<~` prior binding: the literal's parameter names the prior iteration's
// output, so the recurrence y[n] = x[n] + y[n-1] is expressed. With x = 10
// the three calls answer 10, 20 and 30, the prior carried across calls by
// the line the record of `accum` owns, with no context installed around it;
// were the prior unbound, every call would answer 10.
fn accum(input) = ((prev) => input + prev) <~ delay(1)

fn run() = {
  let _ = accum(10)
  let _ = accum(10)
  accum(10)
}

fn main() = run()
