// expect: refuse E_RefinementRejected
// A lambda publishes its return as a declaration does: `mk` returns `succ`
// or `inv` at `f`, so `mk(false).f(0)` is refuted. The lambda's return was
// its body's class, the first branch's contract, so this divided by zero on
// pin 85218488 (exit 134).
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn succ(n) = n + 1

fn main() with !Trap = {
  let mk = (c) => if c { {f: succ} } else { {f: inv} }
  mk(false).f(0)
}
