// expect: 38
// A parameter that shares an op's name is the parameter: the lowering reads a
// call's op off the edge its callee drew, so `twice`'s calls of its `pick`
// call the function it is handed, where reading the spelling took them for
// the multi-shot op and the program answered 30.
effect Pick {
  pick() -> Int
}

handler both {
  pick() => resume(1) + resume(2),
}

fn twice(pick) = pick() + pick()

fn chosen() = pick() * 10

fn main() = twice(() => 4) + (chosen() ~> both)
