> // An effect renames at its declaration, and the row that negates it follows
> // its edge.
> effect Tally {
>   bump() -> Int
> }
>
> handler counter {
>   bump() => resume(1),
> }
>
> fn quiet() with !Tally = 1
>
> fn main() = (bump() ~> counter) + quiet() - 2
