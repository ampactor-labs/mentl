// refs of Ping: 3 row
// A name an author writes in a row is a reference: the judgment links each
// effect a declaration's row names to the effect it denotes, so `refs of
// Ping` answers the clause that negates it, the named row that holds it and
// the handler whose row forbids it.
effect Ping {
  ping() -> Int
}

effect Pong {
  pong() -> Int
}

type Quiet = !Ping

fn calm(x) with !Ping = x + 1

handler answer with !Ping {
  pong() => resume(7),
}

fn main() = calm(pong()) ~> answer
