// expect: 12
// A RUN MINTED UNDER A DERIVATIVE READING: `sq` and `cube_tail` capture the
// seed and each other, so each record carries its captures' tangent lanes
// and holds a sibling minted after it. The emit allocates and binds both
// records before it fills either, lanes included; sq(1) = 3·w², so the slope
// at w = 2 is 12. Measured 2026-10-03 on boot 91257716: refused
// (E_MissingVariable: cube_tail).
//
// The declarations are lib/ml/grad.mn's, repeated because a micro links only
// the runtime floor.
effect Derivative {
  d(v: Float) -> t
}

handler grad(w) {
  d(v) => resume(tangent_of(v, w)),
}

fn main() -> Int = {
  let w = 2.0
  let g = {
    fn sq(n) = if n == 0 { 1.0 } else { w * cube_tail(n - 1) }
    fn cube_tail(n) = if n == 0 { w * 3.0 } else { sq(n - 1) }
    d(sq(1))
  } ~> grad(w)
  float_to_int(g)
}
