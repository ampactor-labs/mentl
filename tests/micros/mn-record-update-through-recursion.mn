// expect: 19
// A function threading a record through its own recursion updates the record
// its recursive call returns, so the update's base is the function's own
// result. The copy past the written field is the base's row without it, and
// the base turns out to hold that field, so the result and the base are one
// record: `walk` keeps `x` and sets `fb`, `step` keeps `caps` and `x` and adds
// to `fb` at every level. On boot db6881c7 both refused, `{fb: Int} vs {}`.
fn walk(sc, n) = if n == 0 {
  sc
} else {
  let sc2 = walk(sc, n - 1)
  {...sc2, fb: sc.fb + 1}
}

fn step(sc, n) = match n {
  0 => sc,
  1 => {...sc, caps: sc.caps + 1},
  _ => match step(sc, n - 1) {
    s2 => {...s2, fb: s2.fb + n},
  },
}

fn main() = {
  let a = walk({fb: 0, x: 3}, 4)
  let b = step({caps: 0, fb: 0, x: 1}, 3)
  a.fb * 10 + a.x + b.fb + b.x
}
