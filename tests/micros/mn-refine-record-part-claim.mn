// expect: refuse E_RefinementRejected
// A structure is claimed part by part. `den_inv` assumes `r.den` is
// `Positive` under `r: {den: Positive}`, so a caller owes it of the field it
// builds, and `0` refutes it. The claim answered held without claiming the
// field, so this checked clean under `!Trap` and divided by zero on boots
// e23392f6 and 1a68ecc0 (exit 134).
type Positive = Int where 0 < self

fn den_inv(r: {den: Positive}) = 100 / r.den

fn main() with !Trap = den_inv({den: 0})
