// expect: 30
// THE CUT's load-bearing acid (bank M3): the COMPLETE backtrack shape —
// resume in a lambda passed as a config-fn arg, an arm-internal `~>`
// install, recursion through a nested fn, an args-bearing MultiShot op,
// and the abort protocol. backtrack is DEAD CODE in the wheel, so no wheel
// gate can see it post-cut — THIS crucible is the proof ("flipped but
// unproven is the drift").
//   The classifier: g(try_each) saturates UMany at round 2 (its self-call
//   through the catch lambda); choose flips MultiShot. The resume's k
//   resolves through the CAPTURE chain (arm → try_each → lambda, all
//   lexical — no evidence threading needed for nested fns). attempt's
//   abort resolves DYNAMICALLY through the my_catch singleton global set
//   by twac's bracket at the resume site (A2's arbitration, realized by
//   shipped machinery). Per the refuter's authoring constraints: my_catch
//   is the ONE abort-armed handler in the link set (the unambiguous op
//   edge) and every abort sits in tail position (the Option protocol).
//   Trace: choose([10,20,30]): k = [?? |> attempt].
//     try_each(0): twac(() => resume(10), retry): attempt(10) → abort →
//       None (via twac's live bracket) → resume = None → attempted = None
//       → retry → try_each(1): attempt(20) → None → try_each(2):
//       attempt(30) → Some(30) → attempted = Some(30) → Some(30).
//   Arm returns Some(30); main unwraps it → exit 30.
//   AN ARM'S VALUE IS THE INSTALL'S VALUE (2026-10-03): until then twac
//   answered `value` — an Int wearing an Option's type — and the root
//   `~> my_catch` answered `None` over an Int body; the judgment refuses
//   both now (`Int vs Option(t)` at the install), so every install here
//   answers the Option its arms do, and main unwraps once at the root.
effect Choice {
  choose(options) -> Int
}

effect Abort {
  abort() -> Option(a)
}

handler my_catch {
  abort() => None
}

// A positive row on a HOF is a CAP on its callbacks (A3-pos, 2026-09-27):
// `with Abort` here refused the thunks' Memory + Alloc + Choice, so the row
// is inferred — the cap was never a decision.
fn twac(try_fn, catch_fn) = {
  let attempted = (try_fn()) ~> my_catch
  match attempted {
    None  => catch_fn(),
    found => found,
  }
}

handler bt {
  choose(options) => {
    fn try_each(i) =
      if i >= len(options) { None }
      else {
        twac(() => resume(list_index(options, i)),
             () => try_each(i + 1))
      }
    try_each(0)
  }
}

fn pick_one() with Choice + Memory + Alloc = choose([10, 20, 30])

fn attempt(v) with Abort + Memory + Alloc = if v > 25 { Some(v) } else { abort() }

fn body() with Choice + Abort + Memory + Alloc = pick_one() |> attempt

// THE ROOT INSTALL OF my_catch (2026-09-27): the executable root gate reads
// the row alone now, and the row charges the remainder's `abort()` at its
// PERFORM site (attempt, inside body) as well as at the resume site where
// twac's bracket absorbs it — so Abort reaches the root in the row although
// every execution of attempt runs inside a resumption under my_catch. The
// root install is the honest form of that gap: the program declares who
// serves an Abort that escapes, and the innermost live my_catch (twac's,
// at every actual abort) still serves at runtime — exit 30 unchanged. The
// precise verdict — a multi-shot remainder's effects charged in the world
// its resumption runs in — is band B's TCont world at the resume site
// (Hβ.continuations.remainder-row-charged-at-perform-site).
fn main() = {
  let r = body() ~> bt ~> my_catch
  match r {
    Some(v) => v,
    None => 0,
  }
}
