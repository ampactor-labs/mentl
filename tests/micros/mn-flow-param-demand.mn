// expect: refuse E_RefinementRejected
// flow: refused at 20
// A demand travels to the caller through computation: `run` builds the sink's
// argument from its parameter, so what every call hands the parameter reaches
// the sink, and the untrusted value `main` hands it refuses the sink's claim,
// naming the argument where the label enters. On boot cb12aeea the sink's
// claim was pending debt and nothing reached `main`.
effect Trust {
  untrusted(v: String) -> Bool
}

type Untrusted = String where untrusted(self)

type Trusted = String where !untrusted(self)

fn read_cmd() -> Untrusted = "rm -rf /"

fn exec(cmd: Trusted) = len(cmd)

fn run(cmd) = exec("sh -c " ++ cmd)

fn main() = run(read_cmd())
