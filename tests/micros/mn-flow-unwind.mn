// expect: refuse E_RefinementRejected
// flow: refused at 29
// An implicit flow through an abandon: `halt` never resumes `stop`, so the
// install's body stops at the perform, and whether the sink after it runs is
// decided by the untrusted value the perform is reached under. On boot
// cb12aeea the claim was pending debt.
effect Trust {
  untrusted(v: String) -> Bool
}

type Untrusted = String where untrusted(self)

type Trusted = String where !untrusted(self)

fn read_cmd() -> Untrusted = "x"

fn exec(cmd: Trusted) = len(cmd)

effect Stop {
  stop() -> Int
}

handler halt {
  stop() => 0,
}

fn main() = {
  if read_cmd() == "x" { stop() } else { 0 }
  exec("ls")
} ~> halt
