// expect: 9
// A match arm's list pattern binds and compares at the element's width: `x`
// and `y` are floats, and the literal arm reads its element as a float to
// compare it. Measured on boots 0bc8383e and 2d784560: did not assemble (`$y.f64`
// undefined).
fn sum2(xs) = match xs {
  [0.5, y] => y,
  [x, y] => x + y,
  _ => 0.0,
}

fn main() = {
  let a = sum2([1.5, 3.0])
  let b = sum2([0.5, 2.0])
  if a > 4.0 && b > 1.5 && b < 2.5 { 9 } else { 1 }
}
