// expect: refuse E_EffectMismatch
// THE AGENTIC SHAPE (OWASP agentic: insecure tool execution / tool
// chaining): a plan runner declares it cannot Exec — the cage — but a
// step reached through the tool loop performs the privileged op. The
// refusal fires at COMPILE TIME, before anything executes; runtime
// fences see this only after the call is attempted.
effect Exec { run_tool(cmd: Int) -> Int }
fn step_a() = 1
fn step_b() = run_tool(7)
fn plan(choice) = if choice > 0 { step_b() } else { step_a() }
fn caged_runner(choice) with !Exec = plan(choice)
fn main() = caged_runner(1)
