// expect: 7
// A closure made before the arena writes into a list it captured. A share
// inside the arena hands it its input as one of two branches, and its write
// must root the arena.
import arena

fn build(n) = if n == 0 { [] } else { build(n - 1) ++ [n] }

fn add_int(a, b) = a + b

fn chk(xs) = if fold(0, add_int, xs) == 55 { 7 } else { 1 }

fn main() = {
  let old = make_list(4)
  let w = { v => list_set(old, 0, build(v)) }
  let k = {
    let (a, b) = 10 <| (w, { n => n * 30 })
    b
  } ~> arena
  let junk = build(400)
  if k == 300 && len(junk) == 400 { chk(old[0]) } else { 2 }
}
