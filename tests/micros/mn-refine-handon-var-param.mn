// expect: refuse E_EffectMismatch
// A position whose contract is a type variable states no use of what it is
// handed: `keep_list` takes any value and returns it, so the caller's
// function inside the list comes back and is applied at 0. A learning
// function placed at a variable position is handed on, its structures'
// parts included. The H4 tree before that rule ran this to a trap (exit
// 134).
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn keep_list(xs) = xs

fn run(h) = {
  let _ = h(5)
  keep_list([h])[0](0)
}

fn main() with !Trap = run(inv)
