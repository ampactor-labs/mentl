// expect: 7
// A list built in an arena and stored into an older list read off the answer of map must survive the arena's exit.
import arena

fn id_fn(x) = x

fn main() = {
  let older = make_list(1)
  list_set(older, 0, [0])
  {
    let ys = map(id_fn, [older])
    list_set(list_index(ys, 0), 0, [7, 8, 9])
    0
  } ~> arena
  let junk = list_filled(16, 99)
  list_index(list_index(older, 0), 0) + len(junk) - 16
}
