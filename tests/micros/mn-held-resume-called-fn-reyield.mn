// expect: 50
// A held resume in a fn the arm declares and calls, whose remainder performs
// again. `drive` resumes and computes after it; the second `pick` yields
// inside the first resume and re-drives the handler from inside `drive`.
// Deep semantics: the second arm's resume answers 1 + 1 = 2 and its drive
// 10, so the first resume answers 10 and the first drive 50. (It answered
// 200 until 2026-10-05: a program's exit is what the WASI host reports, and
// the stock engine reports only [0..126) — 200 was unobservable, FAIL(run)
// at exit 1.)
effect Choice {
  pick() -> Int
}

handler once {
  pick() => {
    fn drive() = {
      let a = resume(1)
      a * 5
    }
    drive()
  },
}

fn body() = pick() + pick()

fn main() = body() ~> once
