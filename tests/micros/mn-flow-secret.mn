// The confidential face of one law: a secret is a label like any other and a
// public sink demands its absence. `digest` declassifies by its declared
// return, so the first line is proven; the second hands the password itself
// to the log and refuses. On boot cb12aeea every claim was pending debt.
effect Secrecy {
  secret(v: String) -> Bool
}

type Secret = String where secret(self)

type Public = String where !secret(self)

fn password() -> Secret = "hunter2"

fn log_line(msg: Public) = len(msg)

fn digest(pw) -> Public = "#{len(pw)}"

fn main() = {
  let ok = log_line("login " ++ digest(password()))
  ok + log_line("pw " ++ password())
}
