// expect: 9
// A resume in a fn the arm declares and calls: `drive` is minted inside the
// arm, so its record captures the arm's continuation, and the classifier's
// call-substitution grades the arm through drive's summary (pick flips
// MultiShot). k = ?? + 3: a = resume(1) → 4; b = resume(2) → 5; the arm
// answers drive() = 9. The same resumes in a top-level fn have no
// continuation to read and refuse (mn-resume-outside-arm-refuses.mn).
effect Choice {
  pick() -> Int
}

handler twice {
  pick() => {
    fn drive() = {
      let a = resume(1)
      let b = resume(2)
      a + b
    }
    drive()
  },
}

fn body() = pick() + 3

fn main() = body() ~> twice
