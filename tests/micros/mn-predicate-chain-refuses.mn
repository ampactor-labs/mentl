// expect: refuse E_TypeMismatch
// A refinement's predicate is an expression over the value it refines, judged
// where the type is declared. A chained bound reads as `(-1.0 <= self) <=
// 1.0`, a Bool compared with a Float, so the declaration refuses; until the
// predicate was judged it degraded to debt at every value claiming the type,
// and `let s: Sample = 1.5` compiled.
type Sample = Float where -1.0 <= self <= 1.0

fn main() = {
  let s: Sample = 1.5
  if s > 0.0 { 1 } else { 0 }
}
