// expect: 42
// The forward-referenced face of the effect-polymorphic absorption: the
// caller precedes the bracket in source, and the judgment is callee-first,
// so the caller reads bracket's masked row and its `!Ping` proof lands.
// EXPECTATION TRUED (2026-09-24): this declared `with Pure`; building the
// thunk is a construction (`Memory + Alloc`), so `!Ping` is the claim the
// fixture measures — see mn-absorb-poly.
effect Ping { ping() -> Int }

handler pong {
  ping() => resume(7)
}

fn caller() -> Int with !Ping = bracket(() => ping())

fn bracket(body) = body() ~> pong

fn main() = caller() * 6
