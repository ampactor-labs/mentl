// expect: 42
// The forward-referenced face of the effect-polymorphic absorption: the
// caller precedes the bracket in source, and the one judgment's
// callee-first order judges bracket first, so the caller reads bracket's
// published subtraction and its `!Ping` proof lands. The claim is `!Ping`
// and never `Pure`: minting the thunk and installing `pong` each allocate,
// and the row charges both (Hβ.effects.install-allocates-unrowed), so the
// absorption is what this fixture proves.
effect Ping { ping() -> Int }

handler pong {
  ping() => resume(7)
}

fn caller() -> Int with !Ping = bracket(() => ping())

fn bracket(body) = body() ~> pong

fn main() = caller() * 6
