// expect: 42
// The same merge with a list that holds no demanding function: the
// callback applies `inv2`, and the merge's other element is never applied.
// The pin refused this (the merge's class carried `inv`'s contract into the
// parameter); the channel reads what the list hands in.
type Positive = Int where 0 < self

fn inv(n: Positive) = 100 / n

fn inv2(n) = n + 42

fn main() = fold(0, (acc, f) => { let g = [f, inv]; acc + f(0) }, [inv2])
