// expect: refuse E_RefinementRejected
// flow: refused at 18 18
// An implicit flow: both commands are constants, but which one runs is
// decided by an untrusted value, so each call is reached under it and each
// refuses. On boot cb12aeea both claims were pending debt.
effect Trust {
  untrusted(v: String) -> Bool
}

type Untrusted = String where untrusted(self)

type Trusted = String where !untrusted(self)

fn read_cmd() -> Untrusted = "yes"

fn exec(cmd: Trusted) = len(cmd)

fn main() = if read_cmd() == "yes" { exec("rm") } else { exec("ls") }
