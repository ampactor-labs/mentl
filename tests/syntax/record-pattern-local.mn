// expect: 9
// SYNTAX §«Pattern syntax for records» — `let {zeta} = r` binds by the
// field's NAME, never its slot: "Identity, not position — the field's
// NAME is the key; the order is a projection." Source order is
// irrelevant (fields sort alphabetically at parse), so a pattern naming
// the alphabetically-later field must still read that field's value.
//
// The receiver here is a LOCAL binding. The same pattern over a
// FUNCTION-PARAMETER receiver is record-pattern-param, and its rest is
// record-pattern-param-rest (`Hβ.lower.record-pattern-param-receiver`).
fn main() = {
  let r = {alpha: 7, zeta: 9}
  let {zeta} = r
  zeta
}
