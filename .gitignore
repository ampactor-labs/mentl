/target
# Session-local state stays out; the hook configuration is versioned — it is
# the mechanism (mentl-first, audit-on-edit) that every session must carry,
# and an ignored `.claude/` was why CLAUDE.md's "runs as a hook" claim held
# nowhere (measured 2026-09-21: the session's hooks were `{}`).
.claude/*
!.claude/settings.json
.agents/
CLAUDE.md
.env
.env.*
!.env.example
art/

# Bootstrap build artifacts — generated by bootstrap/Makefile
/bootstrap/build/

# state.sh / run-micro.sh intermediates — luks-backed (off the tmpfs quota)
/.build/
**/.build/

# Trace-harness build artifacts — generated by bootstrap/test.sh
/bootstrap/test/.assembled/

# Stray WASM/WAT at root (should never happen — they belong under bootstrap/build/)
/*.wasm
/*.wat

# One-off probe outputs
/probe-*.txt

# Throwaway substrate-debug artifacts (build logs, .err/.wat reproductions)
/.tmp/
# Root-level probe/build stderr dumps + WABT error captures — regenerated by
# every probe.sh/march-gate/wat2wasm run; belong in the scratchpad, never tracked.
/*.err
/*.log
/*.w2e
# One-off scratch reproductions dropped at root during a dig (a graph dump, a
# sed patch) — session debris, cleared by hand when a dig closes.
/dump_*.mn
/patch_*.sh

# Inka cache directory
.inka/

# Local Codex artifact
.codex
__pycache__/
.heavy-lock
