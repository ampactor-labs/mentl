// lexer.mn — typed Token stream with full spans (SYNTAX §Token enumeration)
//
// The tokenizer. Emits `[Token]` where `Token = Tok(TokenKind, Span)`.
// Mirrors the AST Node wrapper pattern: structured value + positional
// metadata. Per SYNTAX, the parser dispatches via exhaustive
// `match Tok(kind, _) { … }` over every TokenKind variant — H6's
// substrate-discipline applied at the lexical layer. The variant COUNT
// lives in SYNTAX's checksum alone, which doc-truth now asserts against
// the graph's own roster; this header carried a second copy of it and
// the copy had drifted by one, which is the whole argument against it.
//
// LAYOUT IS NEVER READ HERE. This header claimed "layout-sensitive `~>`
// disambiguation reads start columns" until 2026-08-16, and the artifact
// refutes it: `~>` is two bytes (126, 62) in the same two-character
// operator ladder as every other verb, and `~>` has ONE precedence, the
// loosest (SYNTAX §tee). TNewline is a token because it SEPARATES
// STATEMENTS, and it is transparent around binops — whitespace is never
// semantically load-bearing in Mentl (SYNTAX §Governing principles 1).
//
// Pure transformation over strings. Errors are structural (unknown
// chars are skipped — parser routes diagnostics via the position
// where parse fails, not at lex time).
import types

import strings

// Character classification
//
// Byte-code classification. Lexer operates on raw bytes from the
// source string via `byte_at(source, pos)`. No 1-char-string
// allocation per byte; no char-code indirection; no bare-== on
// runtime strings (drift mode 12 cure).
fn is_digit(b) with Pure = b >= 48 && b <= 57

fn is_alpha(b) with Pure = b >= 65 && b <= 90 || b >= 97 && b <= 122 || b == 95

fn is_alnum(b) with Pure = is_alpha(b) || is_digit(b)

fn is_whitespace(b) with Pure = b == 32 || b == 9 || b == 13

//
// Keyword classification — returns `Some(TokenKind)` if `word` is a
// reserved keyword; `None` otherwise (caller emits `TIdent(word)`).
fn keyword_kind(ref word) = if word == "fn" {
  Some(TFn)
} else if word == "let" {
  Some(TLet)
} else if word == "if" {
  Some(TIf)
} else if word == "else" {
  Some(TElse)
} else if word == "match" {
  Some(TMatch)
} else if word == "type" {
  Some(TType)
} else if word == "effect" {
  Some(TEffect)
} else if word == "handler" {
  Some(THandler)
} else if word == "with" {
  Some(TWith)
} else if word == "resume" {
  Some(TResume)
} else if word == "import" {
  Some(TImport)
} else if word == "where" {
  Some(TWhere)
} else if word == "own" {
  Some(TOwn)
} else if word == "ref" {
  Some(TRef)
}
// drift-audit: ignore — legitimate keyword str_eq at word granularity, NOT effect-name match; "Pure" is a reserved word (TPure is its TokenKind).
else if word == "Pure" {
  Some(TPure)
} else if word == "true" {
  Some(TTrue)
} else if word == "false" {
  Some(TFalse)
} else {
  None
}

// Returns `Some(TokenKind)` if `(a, b)` form a recognized two-char operator,
// `None` otherwise (caller falls through to single-char). Byte-code dispatch;
// no string comparison.
//
// ==
fn two_char_kind(a, b) = if a == 61 && b == 61 {
  Some(TEqEq)
}
// !=
else if a == 33 && b == 61 {
  Some(TBangEq)
}
// <=
else if a == 60 && b == 61 {
  Some(TLtEq)
}
// >=
else if a == 62 && b == 61 {
  Some(TGtEq)
}
// ->
else if a == 45 && b == 62 {
  Some(TArrow)
}
// =>
else if a == 61 && b == 62 {
  Some(TFatArrow)
}
// ++
else if a == 43 && b == 43 {
  Some(TPlusPlus)
}
// |>
else if a == 124 && b == 62 {
  Some(TPipeGt)
}
// <|
else if a == 60 && b == 124 {
  Some(TLtPipe)
}
// ><
else if a == 62 && b == 60 {
  Some(TGtLt)
}
// ~>
else if a == 126 && b == 62 {
  Some(TTildeGt)
}
// <~
else if a == 60 && b == 126 {
  Some(TLtTilde)
}
// &&
else if a == 38 && b == 38 {
  Some(TAndAnd)
}
// ||
else if a == 124 && b == 124 {
  Some(TOrOr)
}
// ?? — the gradient's absence marker
else if a == 63 && b == 63 {
  Some(THole)
} else {
  None
}

// Returns `Some(TokenKind)` if `b` is a recognized punctuation byte,
// `None` otherwise (caller skips the character).
fn single_char_kind(b) = if b == 40 {
  Some(TLParen)
} else if b == 41 {
  Some(TRParen)
} else if b == 123 {
  Some(TLBrace)
} else if b == 125 {
  Some(TRBrace)
} else if b == 91 {
  Some(TLBracket)
} else if b == 93 {
  Some(TRBracket)
} else if b == 44 {
  Some(TComma)
} else if b == 46 {
  Some(TDot)
} else if b == 58 {
  Some(TColon)
} else if b == 59 {
  Some(TSemicolon)
} else if b == 43 {
  Some(TPlus)
} else if b == 45 {
  Some(TMinus)
} else if b == 42 {
  Some(TStar)
} else if b == 47 {
  Some(TSlash)
} else if b == 37 {
  Some(TPercent)
} else if b == 61 {
  Some(TEq)
} else if b == 60 {
  Some(TLt)
} else if b == 62 {
  Some(TGt)
} else if b == 33 {
  Some(TBang)
}
// byte 38 `&` single — effect-row intersection (inter_row). `&&` is
// TAndAnd (logical and), lexed by maximal munch before this point;
// a bare `&` reaching here is the row connective.
else if b == 38 {
  Some(TAmp)
} else if b == 124 {
  Some(TPipe)
}
// byte 126 `~` is NOT a single-char token: it is valid only as `~>`
// (handler-attach) / `<~` (feedback), lexed by maximal munch before
// here. A standalone `~` falls through to None → unexpected-char,
// exactly as a standalone `?` does (`??` is the only `?` form).
else if b == 64 {
  Some(TAt)
} else {
  None
}

// Entry point — tokenize `source` into a `[Token]`.
// Tokens accumulate into a flat buffer threaded through tail-recursion
// as `(buf, count)`. `push_tok` extends the buffer if needed and writes
// at the counter — O(1) amortized per emit; flat-buffer-plus-counter
// avoids the O(N²) concat-append pattern. Final `slice` call produces
// a tag=4 view with logical length = count.
//
// `source` is a flat byte-string. `byte_at(source, pos)` returns the
// `Int` byte code at a position. No intermediate `[String]` of
// 1-char strings is allocated; all per-byte dispatch is `Int`-eq, not
// string-eq (drift mode 12 cure).
fn lex(ref source) = {
  // ValidOffset by the len leg: byte_len is >= 0 by the sequence
  // representation, so the annotation's own obligation discharges at
  // this construction and the lex_from arg edge reads the proof.
  let n: ValidOffset = byte_len(source)
  let initial_capacity = if n < 16 { 16 } else { n }
  let buf = make_list(initial_capacity)
  match lex_from(source, n, 0, 1, 1, buf, 0, 0, 0) {
    (_final_pos, _final_line, _final_col, final_buf, final_count) => slice(final_buf, 0, final_count),
  }
}

// Append one token to the buffer. Returns `(buf, count + 1)`. The buffer
// is not `own` here: list_extend_to BORROWS it and the (possibly fresh)
// owner comes back through the return — ownership passes through the
// chain, this fn finishes nothing (the relevant tier's first sweep; an
// own that is only handed forward is the caller's to finish).
fn push_tok(buf, count, own t) = {
  let extended = list_extend_to(buf, count + 1)
  let written = list_set(extended, count, t)
  (written, count + 1)
}

// mk_tok() — see src/types.mn (canonical Token constructor; Tok ADT
// is declared there).
//
// Core lexer loop. `term_byte = 0` (no terminator) or `125`
// (terminate on first `TRBrace` at depth 0 — used by splice scanning).
// `depth` tracks open brace nesting for splice termination.
// The ONE string surface (SYNTAX.md Strings): `"..."` and the
// multi-line `"""..."""`, both with always-live `{expr}` interpolation —
// `scan_string` emits `TStringPart`/`TStringSplice` directly, threading
// `buf`/`count`. There is no single-quote form (dissolved: a splice-free
// `"abc"` and `'abc'` produced an identical byte-sequence graph).
fn lex_from(ref source, n: ValidOffset, pos: ValidOffset, line, col, own buf, count, term_byte, depth) = if pos >= n {
  match push_tok(buf, count, mk_tok(TEof, line, col, line, col)) {
    (b1, c1) => (pos, line, col, b1, c1),
  }
} else {
  let b = byte_at(source, pos)
  if is_whitespace(b) {
    lex_from(source, n, pos + 1, line, col + 1, buf, count, term_byte, depth)
  } else if b == 10 {
    // newline (\n)
    match push_tok(buf, count, mk_tok(TNewline, line, col, line + 1, 1)) {
      (b1, c1) => lex_from(source, n, pos + 1, line + 1, 1, b1, c1, term_byte, depth),
    }
  } else if b == 47 && pos + 1 < n && byte_at(source, pos + 1) == 47 {
    // One comment form // — graph content, never dropped (SYNTAX.md Comments).
    // Capture the rest of the line as TComment payload (leading // stripped); a
    // third slash is just prose. The parser attaches it to the node it precedes
    // via graph_attach_comment; the Why engine / formatter / cursor project it.
    let after = scan_to_eol(source, n, pos + 2)
    let comment_text = str_slice(source, pos + 2, after)
    let end_col = col + (after - pos)
    match push_tok(buf, count, mk_tok(TComment(comment_text), line, col, line, end_col)) {
      (b1, c1) => lex_from(source, n, after, line, end_col, b1, c1, term_byte, depth),
    }
  } else if b == 34 && pos + 2 < n && byte_at(source, pos + 1) == 34 && byte_at(source, pos + 2) == 34 {
    // triple-quoted multi-line string `"""..."""` — the multi-line
    // variant of the ONE string form (SYNTAX.md Strings). Interpolation
    // is still live (TStringPart/TStringSplice); leading whitespace
    // common to all lines is stripped (indentation-aware). The closing
    // `"""` terminates. scan_triple_string materializes the de-indented
    // body once, then scans it through the same splice machinery.
    match scan_triple_string(source, n, pos + 3, line, col + 3, line, col, buf, count) {
      (new_pos, new_line, new_col, b1, c1) => lex_from(source, n, new_pos, new_line, new_col, b1, c1, term_byte, depth),
    }
  } else if b == 34 {
    // double-quoted string — the ONE string form with always-live
    // `{expr}` interpolation. scan_string emits TStringPart/TStringSplice
    // tokens directly into buf and returns (new_pos, new_line, new_col,
    // buf, count) — the line rides every scan return so a splice or body
    // spanning newlines resumes the loop at the TRUE line.
    // Per Hβ.lex.scan-string-on-to-on-restructure: scan-to-break +
    // single str_slice per chunk, replacing per-byte acc-concat.
    match scan_string(source, n, pos + 1, line, col + 1, line, col, buf, count) {
      (new_pos, new_line, new_col, b1, c1) => lex_from(source, n, new_pos, new_line, new_col, b1, c1, term_byte, depth),
    }
  } else if is_digit(b) {
    // The scanner returns its verdict; this site reads it and reports.
    // The abutting-alnum test lives HERE, once, because it is the same
    // rule for all four bases: a literal that ends against a letter or
    // digit was never one literal. Before it, 0b1012 scanned as 0b101
    // and left 2 to lex as a second literal, 0o9 scanned as 0o and left
    // 9, and 123abc left a bare identifier to be reported as a missing
    // variable — the medium naming the wrong thing.
    match scan_number(source, n, pos, col) {
      NumInt(new_pos, new_col, value) => {
        if new_pos < n && is_alnum(byte_at(source, new_pos)) {
          report(EMalformedNumericLiteral(
            str_slice(source, pos, num_lit_end(source, n, new_pos)),
            "a letter or digit runs on from the end of it",
            Span(line, col, line, new_col)
          ))
        }
        // Productive under error: the literal terminates here either
        // way and the rest of the file lexes true (scan_string's own
        // precedent). The refusal is what stops the executable.
        match push_tok(buf, count, mk_tok(TIntLit(value), line, col, line, new_col)) {
          (b1, c1) => lex_from(source, n, new_pos, line, new_col, b1, c1, term_byte, depth),
        }
      },
      NumFloat(new_pos, new_col) => {
        let kind = TFloatLit(parse_float(strip_underscores(str_slice(source, pos, new_pos))))
        match push_tok(buf, count, mk_tok(kind, line, col, line, new_col)) {
          (b1, c1) => lex_from(source, n, new_pos, line, new_col, b1, c1, term_byte, depth),
        }
      },
      NumNoDigits(new_pos, new_col, base) => {
        report(EMalformedNumericLiteral(
          str_slice(source, pos, num_lit_end(source, n, new_pos)),
          "the prefix promises {base_name(base)} digits and none follow",
          Span(line, col, line, new_col)
        ))
        match push_tok(buf, count, mk_tok(TIntLit(0), line, col, line, new_col)) {
          (b1, c1) => lex_from(source, n, new_pos, line, new_col, b1, c1, term_byte, depth),
        }
      },
    }
  } else if is_alpha(b) {
    match scan_ident(source, n, pos, col) {
      (new_pos, new_col) => // The intern resolves the identifier ONCE per unique spelling: a
      // repeat occurrence returns the canonical String and its banked
      // keyword classification through a hash probe — no slice minted,
      // no keyword chain walked (the per-occurrence forms this replaces
      // paid both at every identifier).
      match intern_span(source, pos, new_pos) {
        (word, _handle, kw) => {
          let kind = match kw {
            Some(k) => k,
            None => TIdent(word),
          }
          match push_tok(buf, count, mk_tok(kind, line, col, line, new_col)) {
            (b1, c1) => lex_from(source, n, new_pos, line, new_col, b1, c1, term_byte, depth),
          }
        },
      },
    }
  } else {
    let b2 = if pos + 1 < n { byte_at(source, pos + 1) } else { 0 }
    match two_char_kind(b, b2) {
      Some(kind) => match push_tok(buf, count, mk_tok(kind, line, col, line, col + 2)) {
        (b1, c1) => lex_from(source, n, pos + 2, line, col + 2, b1, c1, term_byte, depth),
      },
      None => match single_char_kind(b) {
        Some(kind) => {
          // TLBrace increments depth; TRBrace may terminate splice.
          let new_depth = if b == 123 { depth + 1 } else { depth }
          if b == 125 && term_byte == 125 && depth == 0 {
            // Splice termination — emit TRBrace and return to
            // scan_string_after_splice with position info so the
            // outer scan_string can resume past the splice. The LIVE
            // line rides the return: a splice spanning newlines used to
            // hand the resumption its pre-splice line, and every token
            // after the string carried spans stale by the splice's
            // height — the whole-weave address collapse (nodes lying
            // about their lines resolve to nothing but the module's own
            // span-fallback node) and the span-keyed cone
            // misattribution both rooted here.
            match push_tok(buf, count, mk_tok(TRBrace, line, col, line, col + 1)) {
              (b1, c1) => (pos + 1, line, col + 1, b1, c1),
            }
          } else {
            let new_d = if b == 125 && depth > 0 { depth - 1 } else { new_depth }
            match push_tok(buf, count, mk_tok(kind, line, col, line, col + 1)) {
              (b1, c1) => lex_from(source, n, pos + 1, line, col + 1, b1, c1, term_byte, new_d),
            }
          }
        },
        None => lex_from(source, n, pos + 1, line, col + 1, buf, count, term_byte, depth),
      },
    }
  }
}

// Lexer helpers
//
// Advance `pos` until end-of-line (byte 10) or end-of-input.
// Returns the position AT the newline (not past it). Used by
// both doc-comment payload slicing and line-comment skipping.
fn scan_to_eol(ref source, n: ValidOffset, pos: ValidOffset) = if pos >= n {
  pos
} else if byte_at(source, pos) == 10 {
  pos
} else {
  scan_to_eol(source, n, pos + 1)
}

// The `"..."` / `"""..."""` string scanner. Emits
// `TStringPart(the literal chunk)` for contiguous literal content. On `{`
// followed by an expression-start byte, emits `TStringPart(acc)` +
// `TStringSplice` then delegates to `scan_string_after_splice`, which
// calls `lex_from` with `term_byte=125` to tokenize the expression until
// the matching `}`. Literal braces are `\{`/`\}` (a backslash escape, NOT
// a chunk break) — there is no brace-doubling. Closing `"` terminates.
// Returns `(new_pos, new_line, new_col, buf, count)` — buffer threaded
// directly, the live line riding every return.
//
// is_splice_start_byte — true for bytes that can begin an expression
// inside a string splice: identifiers (a-z, A-Z, _), digits (0-9),
// parens, brackets. False for `"` (which would close the string),
// `}` (empty splice), whitespace, and EOF. This makes a bare `{` not
// followed by an expression-start a literal brace, distinct from `\{`.
//
// a-z
fn is_splice_start_byte(b) with Pure = if b >= 97 && b <= 122 {
  true
}
// A-Z
else if b >= 65 && b <= 90 {
  true
}
// _ (underscore — ident start)
else if b == 95 {
  true
}
// 0-9 (digit — numeric expression)
else if b >= 48 && b <= 57 {
  true
}
// ( — parenthesized expression
else if b == 40 {
  true
}
// [ — list literal
else if b == 91 {
  true
}
// ! — negation
else if b == 33 {
  true
} else {
  false
}

// `sline`/`scol` is where the chunk's TOKEN begins — the opening quote for
// the first chunk, the byte after a splice's `}` for each later one — so a
// part's span is its extent in the source, start through end. It used to be
// the END alone (the closing quote, or a zero-width point at a `{`), and a
// string literal's node covered one column: a caret anywhere inside
// `"hello world"` reached the declaration around it (measured on boot
// 8b071ba3).
fn scan_string(ref source, n: ValidOffset, pos: ValidOffset, line, col, sline, scol, own buf, count) =
  scan_string_chunk(source, n, pos, pos, line, col, sline, scol, buf, count)

// chunk_start carries the start-byte of the current literal chunk;
// pos advances byte-by-byte without allocation until a break-byte
// halts the scan (close-quote, splice-open `{expr`, EOF). A backslash
// escape (`\X`, including `\{`/`\}` for literal braces and `\xHH` for a
// hex byte) is NOT a break — it stays in the chunk and is resolved once
// by str_unescape at the flush. On halt, one str_slice(source, chunk_start, pos)
// materializes the TStringPart payload — O(N) total scan + O(N) total
// bytes copied across all chunks. The prior per-byte `acc |> str_concat`
// form was O(N²) on the heap (CLAUDE.md "++ in a loop is a memory
// bomb"); for the wheel's ~13KB of string content that was hundreds
// of millions of bytes through the bump allocator, exhausting heap
// before completion. Future peer: Hβ.runtime.zero-copy-string-view
// represents TStringPart payload as (offset, length) into source,
// eliminating the slice-alloc entirely — O(1) per chunk.
fn scan_string_chunk(ref source, n: ValidOffset, chunk_start: ValidOffset, pos: ValidOffset, line, col, sline, scol, own buf, count) = if pos >= n {
  let part = str_unescape(str_slice(source, chunk_start, pos))
  match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line, col)) {
    (b1, c1) => (pos, line, col, b1, c1),
  }
} else {
  let b = byte_at(source, pos)
  if b == 34 {
    // closing "
    let part = str_unescape(str_slice(source, chunk_start, pos))
    match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line, col + 1)) {
      (b1, c1) => (pos + 1, line, col + 1, b1, c1),
    }
  } else if b == 10 {
    // A raw newline in the SINGLE-line form is the unterminated-quote
    // author error (the swallow ran to the next quote or EOF and the
    // diagnostic surfaced as a brace complaint lines away — measured);
    // the multi-line form is `"""` (scan_triple_string). Report at the
    // string's own line, TERMINATE the literal here, and leave the
    // newline unconsumed so the rest of the file lexes true —
    // productive-under-error at the lexical layer.
    report(PUnclosedConstruct(
      "string literal spans a raw newline — close the quote on its line, or use the multi-line \"\"\" form",
      Span(sline, scol, line, col)
    ))
    let part = str_unescape(str_slice(source, chunk_start, pos))
    match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line, col)) {
      (b1, c1) => (pos, line, col, b1, c1),
    }
  } else if b == 123 && pos + 1 < n && is_splice_start_byte(byte_at(source, pos + 1)) {
    // { — start of interpolation splice (amendment C). Only when the
    // next byte is an expression-start (ident, digit, paren, etc.);
    // `"{"` and `"{}"` are literal strings, not splices. Matches the
    // seed's scan_string behavior exactly.
    let part = str_unescape(str_slice(source, chunk_start, pos))
    match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line, col)) {
      (b1, c1) => match push_tok(b1, c1, mk_tok(TStringSplice, line, col, line, col + 1)) {
        (b2, c2) => scan_string_after_splice(source, n, pos + 1, line, col + 1, b2, c2),
      },
    }
  } else if b == 92 && pos + 1 < n {
    // Escape: NOT a chunk break — `\X` is two source bytes resolved
    // once by str_unescape at the chunk-flush sites (matches the
    // one unescape arbiter, $str_unescape). chunk_start
    // unchanged so `\"` does not falsely close the string. The
    // prior per-escape TStringPart flush was the design flaw the
    // parser then had to un-coalesce — deleted, not decorated.
    scan_string_chunk(source, n, chunk_start, pos + 2, line, col + 2, sline, scol, buf, count)
  } else {
    // non-break byte — advance pos; chunk_start unchanged.
    scan_string_chunk(source, n, chunk_start, pos + 1, line, col + 1, sline, scol, buf, count)
  }
}

// After emitting `TStringPart` + `TStringSplice`, lex the expression
// inside the splice using `lex_from` with `term_byte=125` (terminates
// on first `TRBrace` at depth 0). Then resume `scan_string` with empty acc.
// Nested splices (depth > 0) handled by `lex_from`'s depth tracking;
// peer sub-handle B.12.5.2 extends this to multiple nesting levels.
fn scan_string_after_splice(ref source, n: ValidOffset, pos: ValidOffset, line, col, own buf, count) = match lex_from(source, n, pos, line, col, buf, count, 125, 0) {
  (new_pos, new_line, new_col, b1, c1) => scan_string(source, n, new_pos, new_line, new_col, new_line, new_col, b1, c1),
}

// scan_triple_string — the multi-line `"""..."""` variant of the one
// string form. `pos` points just past the opening `"""`. Interpolation is
// live (same TStringPart/TStringSplice machinery), and leading whitespace
// common to all content lines is stripped (indentation-aware): the common
// indent `ci` is computed once over the whole body, then each line's first
// `ci` whitespace bytes are skipped as a position gap — no buffer rewrite,
// so splice expressions still slice the real source. A leading newline
// directly after the opening `"""` is dropped (content starts next line).
// `sline`/`scol` is the opening `"""`, where the first part's token begins.
// A stripped indent is a position GAP, not a column reset: the scan's column
// is where the byte it stands on sits in the source, so a splice on a
// de-indented line lexes at its true column (it used to restart at 1 after
// every stripped indent).
fn scan_triple_string(ref source, n: ValidOffset, pos: ValidOffset, line, col, sline, scol, own buf, count) = {
  let body_start = if pos < n && byte_at(source, pos) == 10 { pos + 1 } else { pos }
  let body_line = if pos < n && byte_at(source, pos) == 10 { line + 1 } else { line }
  let body_col = if pos < n && byte_at(source, pos) == 10 { 1 } else { col }
  let end = scan_triple_end(source, n, body_start)
  let ci = triple_common_indent(source, n, body_start, end, 2147483647)
  // ci stays at the sentinel only when the body is empty/all-blank — then
  // there is nothing to strip, so a zero common-indent is the honest read.
  let strip = if ci == 2147483647 { 0 } else { ci }
  let after_first = triple_skip_indent(source, n, body_start, strip, 0)
  scan_triple_chunk(
    source,
    n,
    after_first,
    after_first,
    body_line,
    body_col + (after_first - body_start),
    sline,
    scol,
    strip,
    buf,
    count
  )
}

// scan_triple_end — position of the opening byte of the closing `"""`
// (three consecutive byte-34). Returns n (EOF) if unterminated.
fn scan_triple_end(ref source, n: ValidOffset, pos: ValidOffset) = if pos + 2 >= n {
  n
} else if byte_at(source, pos) == 34 && byte_at(source, pos + 1) == 34 && byte_at(source, pos + 2) == 34 {
  pos
} else {
  scan_triple_end(source, n, pos + 1)
}

// triple_common_indent — the minimum leading-whitespace byte count over
// all non-blank lines of the body `[pos, end)`. Threads the running
// minimum `acc`; a blank line (immediate newline) contributes no constraint.
fn triple_common_indent(ref source, n: ValidOffset, pos: ValidOffset, end, acc) = if pos >= end {
  acc
} else {
  let ws = triple_line_indent(source, end, pos, 0)
  let line_end = scan_to_eol(source, end, pos)
  let is_blank = pos + ws >= line_end
  let new_acc = if is_blank { acc } else if ws < acc { ws } else { acc }
  // advance past the newline to the next line's start
  let next = if line_end < end { line_end + 1 } else { end }
  triple_common_indent(source, n, next, end, new_acc)
}

// triple_line_indent — count of leading space (32) / tab (9) bytes from
// `pos` up to `limit`.
fn triple_line_indent(ref source, limit: ValidOffset, pos: ValidOffset, acc) = if pos >= limit {
  acc
} else {
  let b = byte_at(source, pos)
  if b == 32 || b == 9 { triple_line_indent(source, limit, pos + 1, acc + 1) } else { acc }
}

// triple_skip_indent — advance `count` whitespace bytes (up to `strip`),
// returning the position after the skipped indent. Used at each line start.
fn triple_skip_indent(ref source, n: ValidOffset, pos: ValidOffset, strip, count) = if count >= strip {
  pos
} else if pos >= n {
  pos
} else {
  let b = byte_at(source, pos)
  if b == 32 || b == 9 { triple_skip_indent(source, n, pos + 1, strip, count + 1) } else { pos }
}

// scan_triple_chunk — mirror of scan_string_chunk for the triple-quoted
// body. Breaks on the closing `"""`, on a splice `{expr`, and at each
// newline (to skip the next line's common indent as a position gap). The
// backslash escape (`\X`, `\{`/`\}`, `\xHH`) is resolved by str_unescape
// at flush, exactly as in the single-line form.
fn scan_triple_chunk(ref source, n: ValidOffset, chunk_start: ValidOffset, pos: ValidOffset, line, col, sline, scol, strip, own buf, count) = if pos + 2 < n && byte_at(source, pos) == 34 && byte_at(source, pos + 1) == 34 && byte_at(source, pos + 2) == 34 {
  // closing """
  let part = str_unescape(str_slice(source, chunk_start, pos))
  match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line, col + 3)) {
    (b1, c1) => (pos + 3, line, col + 3, b1, c1),
  }
} else if pos >= n {
  // unterminated — flush what we have; parser surfaces P_UnclosedConstruct.
  let part = str_unescape(str_slice(source, chunk_start, pos))
  match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line, col)) {
    (b1, c1) => (pos, line, col, b1, c1),
  }
} else {
  let b = byte_at(source, pos)
  if b == 10 {
    // newline — flush the chunk through the newline, then skip the next
    // line's common indent as a position gap (the indentation strip).
    let part = str_unescape(str_slice(source, chunk_start, pos + 1))
    match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line + 1, 1)) {
      (b1, c1) => {
        let after = triple_skip_indent(source, n, pos + 1, strip, 0)
        let at_col = 1 + (after - pos - 1)
        scan_triple_chunk(source, n, after, after, line + 1, at_col, line + 1, at_col, strip, b1, c1)
      },
    }
  } else if b == 123 && pos + 1 < n && is_splice_start_byte(byte_at(source, pos + 1)) {
    // { — interpolation splice (live in triple-quoted strings too).
    let part = str_unescape(str_slice(source, chunk_start, pos))
    match push_tok(buf, count, mk_tok(TStringPart(part), sline, scol, line, col)) {
      (b1, c1) => match push_tok(b1, c1, mk_tok(TStringSplice, line, col, line, col + 1)) {
        (b2, c2) => scan_triple_after_splice(source, n, pos + 1, line, col + 1, strip, b2, c2),
      },
    }
  } else if b == 92 && pos + 1 < n {
    // backslash escape — not a chunk break; resolved by str_unescape.
    scan_triple_chunk(source, n, chunk_start, pos + 2, line, col + 2, sline, scol, strip, buf, count)
  } else {
    scan_triple_chunk(source, n, chunk_start, pos + 1, line, col + 1, sline, scol, strip, buf, count)
  }
}

// scan_triple_after_splice — lex the splice expression (term_byte=125),
// then resume the triple-quoted chunk scan past the closing `}`.
fn scan_triple_after_splice(ref source, n: ValidOffset, pos: ValidOffset, line, col, strip, own buf, count) = match lex_from(source, n, pos, line, col, buf, count, 125, 0) {
  (new_pos, new_line, new_col, b1, c1) => scan_triple_chunk(source, n, new_pos, new_pos, new_line, new_col, new_line, new_col, strip, b1, c1),
}

// ── The numeric literal's own vocabulary ────────────────────────────────
// These live HERE, not in types.mn, and the reason is measured rather than
// stylistic: the frontier's prelude floor counts the source a program that
// asks for nothing must still process, and types.mn is 3672 of its 6359
// lines because every module pulls it. Putting lexical ADTs there made a
// bare `fn main() = 7` pay for the scanner — the leg went RED at 6413 the
// moment they landed there, which is the ratchet doing exactly its job
// (`Hβ.driver.link-is-reachability` is what finally lowers that floor).
// One home per truth means the home where the readers are, and every
// reader of these is in this file.
//
// The base of a numeric literal. It was an Int in {2, 8, 10, 16} threaded
// from the scanner to a second walk that re-derived, from three
// hand-written byte ranges, what counts as a digit — and the two
// classifiers disagreed. The scanner stopped at the first byte outside the
// base while the accumulator accepted any hex digit and answered 0 for
// everything else, so 0b1012 read 5 and the trailing 2 became a separate
// token nobody complained about, 0o1238 read 83, and a bare 0x read 0.
// The ADT makes the disagreement unconstructible: the radix and the digit
// set are arms of one value.
type NumBase = BBin | BOct | BDec | BHex

// What the scanner PROVED, not a position for the caller to re-read.
// NumInt carries the accumulated value; NumFloat carries only the extent,
// because a float's mantissa/exponent walk is a different algorithm and
// parse_float still owns it. NumNoDigits is the prefix that promised
// digits and met none.
type NumScan = NumInt(Int, Int, Int) | NumFloat(Int, Int) | NumNoDigits(Int, Int, NumBase)

fn base_radix(b) with Pure = match b {
  BBin => 2,
  BOct => 8,
  BDec => 10,
  BHex => 16,
}

fn base_name(b) with Pure = match b {
  BBin => "binary",
  BOct => "octal",
  BDec => "decimal",
  BHex => "hexadecimal",
}

// IS this byte a digit of this base, and WHICH digit — one answer, so the
// two cannot disagree. Every predicate-plus-value pair the old form kept
// apart was a place they could drift.
//
// The row is Memory + Alloc, not Pure, because the answer is constructed:
// the constructor charge bills Some(d), once per scanned digit byte. That
// is the honest row for the shape, and the shape is right — a predicate
// beside a value is exactly the split this deletes. What should cost
// nothing is the Option itself, which a niche-encoded word would carry in
// a register (Hβ.repr.option-of-word-niche); until the gradient cashes
// that out, the charge is real and named rather than declared away.
fn base_digit(b, byte) = match b {
  BBin => if byte >= 48 && byte <= 49 { Some(byte - 48) } else { None },
  BOct => if byte >= 48 && byte <= 55 { Some(byte - 48) } else { None },
  BDec => if byte >= 48 && byte <= 57 { Some(byte - 48) } else { None },
  BHex => if byte >= 48 && byte <= 57 {
    Some(byte - 48)
  } else if byte >= 65 && byte <= 70 {
    Some(byte - 55)
  } else if byte >= 97 && byte <= 102 {
    Some(byte - 87)
  } else {
    None
  },
}

// Scan one numeric literal and return WHAT IT IS, never a position for
// the caller to re-read. The old form returned (pos, col, base, is_float)
// and the caller re-sliced the source and walked it a second time with a
// different digit classifier; where the two disagreed, the second one
// answered 0. The value is accumulated here, in the walk that already
// proved every byte, so there is one walk and one classifier and nothing
// left to disagree about.
//
// Underscore is a visual separator — skipped during accumulation, never a
// digit, never the byte a literal may end on.
fn scan_number(ref source, n: ValidOffset, pos: ValidOffset, col) = if pos + 1 < n && byte_at(source, pos) == 48 {
  let prefix = byte_at(source, pos + 1)
  if prefix == 120 {
    scan_prefixed(source, n, pos + 2, col + 2, BHex)
  } else if prefix == 98 {
    scan_prefixed(source, n, pos + 2, col + 2, BBin)
  } else if prefix == 111 {
    scan_prefixed(source, n, pos + 2, col + 2, BOct)
  } else {
    scan_decimal(source, n, pos, col, 0, false)
  }
} else {
  scan_decimal(source, n, pos, col, 0, false)
}

// How far the author's literal actually runs, so the diagnostic can quote
// what was written rather than the prefix the scanner could read. `0b1012`
// names itself, not `0b101`.
fn num_lit_end(source, n: ValidOffset, pos: ValidOffset) =
  if pos < n && is_alnum(byte_at(source, pos)) { num_lit_end(source, n, pos + 1) } else { pos }

// A base prefix promises at least one digit. Zero digits is NumNoDigits —
// the case that used to read as the value 0, silently, for `0x` and `0b`
// alike.
fn scan_prefixed(source, n: ValidOffset, pos: ValidOffset, col, base) = match scan_base_digits(source, n, pos, col, base, 0, 0) {
  (p2, c2, value, digits) => if digits == 0 { NumNoDigits(p2, c2, base) } else { NumInt(p2, c2, value) },
}

// The one accumulator: base_digit answers IS-a-digit and WHICH-digit
// together, so the extent and the value come from the same read.
fn scan_base_digits(source, n: ValidOffset, pos: ValidOffset, col, base, acc, digits) = if pos >= n {
  (pos, col, acc, digits)
} else {
  let b = byte_at(source, pos)
  if b == 95 {
    scan_base_digits(source, n, pos + 1, col + 1, base, acc, digits)
  } else {
    match base_digit(base, b) {
      Some(d) => scan_base_digits(source, n, pos + 1, col + 1, base, acc * base_radix(base) + d, digits + 1),
      None => (pos, col, acc, digits),
    }
  }
}

// Decimal path — the same accumulation, plus the one `.` that makes a
// float. A float's value is not accumulated here: parse_float owns the
// mantissa/exponent walk and this scanner returns only its extent.
fn scan_decimal(ref source, n: ValidOffset, pos: ValidOffset, col, acc, is_float) = if pos >= n {
  if is_float { NumFloat(pos, col) } else { NumInt(pos, col, acc) }
} else {
  let b = byte_at(source, pos)
  if b == 95 {
    scan_decimal(source, n, pos + 1, col + 1, acc, is_float)
  } else if is_digit(b) {
    scan_decimal(source, n, pos + 1, col + 1, acc * 10 + (b - 48), is_float)
  } else if b == 46 && !is_float && pos + 1 < n && is_digit(byte_at(source, pos + 1)) {
    scan_decimal(source, n, pos + 1, col + 1, acc, true)
  } else if is_float {
    NumFloat(pos, col)
  } else {
    NumInt(pos, col, acc)
  }
}

// Advance position over identifier characters. Returns `(pos, col)`.
// The caller slices `source` to obtain the identifier text.
fn scan_ident(ref source, n: ValidOffset, pos: ValidOffset, col) = if pos >= n {
  (pos, col)
} else if is_alnum(byte_at(source, pos)) {
  scan_ident(source, n, pos + 1, col + 1)
} else {
  (pos, col)
}

// ── The lex-name intern — intern_table (§5.O layer 1) ───────────────────────
// One row per unique name: (canonical String, handle, keyword kind). The
// canonical instance is materialized FLAT once at first sight and every
// repeat occurrence returns the SAME pointer through a hash probe — zero
// allocation, zero keyword compares (the row carries the classification the
// old per-occurrence keyword chain re-derived ~1e5 times). str_hash_loop over
// the source range IS the hash (no slice minted to hash); str_eq_at is the
// range compare. Handle 0 reserved = absent; count starts at 1. TWO entry
// paths, one table: intern_span (lex — a source range) and intern_str (a
// whole String — the EffName mints and any name born outside a token).
// Both classify through keyword_kind at insert, so a name first seen via
// intern_str still lexes correctly as a keyword on a later intern_span hit.
// entries is the reverse read (handle → canonical) intern_name_of serves —
// the render/emit projection; comparisons never read it.

