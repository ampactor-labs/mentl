// verify.mn — the refinement obligations: each claim decided where the
// fragment can decide it, and the rest kept as honest debt.
//
// `verify_ledger` is the Verify handler. A claim the fragment decides is
// proven (no debt) or refused at its site (`E_RefinementRejected`); a claim
// it cannot decide accrues as pending debt — the program compiles and the
// debt is visible, countable and queryable (`mentl query <entry>
// verification`). Deciding more is Verify's own solver growing its fragment
// (PLAN §11, Verify's own solver); an external solver plugs in only as a
// proposer whose certificate the kernel checks.
import types

import canon

import effects

import graph

import io

// Each claim decided by `predicate_decide` where it can be, the verdict
// recorded; an undecided claim kept as debt. A claim naming a label is the
// settle's (`flow_settle`): kept among the flows the judgment raised, and
// owed or decided as the latest settle left it.
// A claim whose reading met code the judgment had not reached is kept
// among the unsettled as well, the only debt the settle asks again.
handler verify_ledger with debt = [], decided = [], flows = [], settled = [], unsettled = [] {
  verify(modh, span, predicate, reason) => match decide_noting(predicate) {
    (Some(true), _) => resume(Some(true)) with decided = [(modh, span, predicate, true)] ++ decided,
    (Some(false), _) => resume(Some(false)) with decided = [(modh, span, predicate, false)] ++ decided,
    (None, met) => if pred_names_label(predicate) {
      resume(None) with flows = [(modh, span, predicate, reason)] ++ flows
    } else if met {
      resume(None) with debt = [(modh, span, predicate, reason)] ++ debt, unsettled = [(modh, span, predicate, reason)] ++ unsettled
    } else {
      resume(None) with debt = [(modh, span, predicate, reason)] ++ debt
    },
  },
  verify_debt() => resume(debt ++ flat_map(settled_owed, settled)),
  verify_decided() => resume(decided ++ flat_map(settled_verdict, settled)),
  verify_flows() => resume(flows),
  verify_adopt(entries) => resume() with decided = entries ++ decided,
  verify_reask() => {
    let asked = unsettled |> map(reasked)
    let verdicts = flat_map(reask_verdict, asked)
    if len(verdicts) == 0 {
      resume([])
    } else {
      resume(flat_map(reask_refuted, asked)) with debt = filter(still_owed(verdicts, ??), debt), unsettled = flat_map(reask_owed, asked), decided = verdicts ++ decided
    }
  },
  verify_settle(entries) => resume() with settled = entries,
  verify_forget(gone) => resume() with debt = filter(debt_outside(gone, ??), debt), decided = filter(debt_outside(gone, ??), decided), flows = filter(debt_outside(gone, ??), flows), settled = filter(settled_outside(gone, ??), settled), unsettled = filter(debt_outside(gone, ??), unsettled),
}

// A claim decided, and whether its reading met code the judgment had not
// reached, which the settle may read differently once it has.
fn decide_noting(predicate) = {
  let verdict = predicate_decide(predicate)
  (verdict, unsettled_met())
} ~> noting_unsettled

fn still_owed(verdicts, entry) = match entry {
  (modh, span, _, _) => !any({ (m, s, _, _) => m == modh && s == span }, verdicts),
}

fn reasked(entry) = match entry {
  (_, _, pred, _) => (entry, predicate_decide(pred)),
}

fn reask_owed(asked) = match asked {
  (entry, None) => [entry],
  (_, Some(_)) => [],
}

fn reask_verdict(asked) = match asked {
  ((modh, span, pred, _), Some(held)) => [(modh, span, pred, held)],
  (_, None) => [],
}

fn reask_refuted(asked) = match asked {
  (entry, Some(false)) => [entry],
  (_, Some(true)) | (_, None) => [],
}

// The settle's re-ask: a claim refuted now is reported where it was raised.
fn reask_settle() =
  verify_reask() |> each({ (modh, span, pred, reason) => report_at(modh, ERefinementRejected(pred, span, reason)) })

fn settled_owed(entry) = match entry {
  (modh, span, pred, reason, None) => [(modh, span, pred, reason)],
  _ => [],
}

fn settled_verdict(entry) = match entry {
  (modh, span, pred, _, Some(held)) => [(modh, span, pred, held)],
  _ => [],
}

fn settled_outside(gone, entry) = match entry {
  (modh, span, _, _, _) => !any(obligation_replaced(modh, span, ??), gone),
}

// An obligation survives a forget unless an edit replaced what raised it:
// its module whole, or the statement whose extent holds it. A decided claim
// is the same four-place fact with its verdict where the debt carries its
// Why, so one test serves both.
fn debt_outside(gone, entry) = match entry {
  (modh, span, _, _) => !any(obligation_replaced(modh, span, ??), gone),
}

// Compile-time decidable discharge. Returns Some(true) when the predicate
// proves true on its GROUND operands alone; Some(false) when it proves false;
// None at the undecidable boundary (a free variable with no `self` binding, a
// call, a non-constant expression) — defers to the ledger or the SMT tier.
//
// A PCompare decides iff BOTH operands reduce to ground constants under the
// current `self` binding — the decidable ARITHMETIC FRAGMENT: literals, `self`
// resolved to its value node, and +,-,*,/,% over same-kind Int/Float operands
// (node_const_at). litval_compare folds the comparison; cross-kind equality is
// Some(false), cross-kind ordering is None. PAnd/POr/PNot recurse with
// three-valued short-circuit; PWithSelf rebinds `self` over its inner predicate.
fn predicate_decide(ref pred) = predicate_decide_at(pred, NoSelf)

// What `self` resolves to while a predicate is decided: nothing (a bare
// claim — `self` is undecidable), the VALUE NODE a claim was raised over
// (PWithSelf's binder, read live through its joins), or a GROUND CONSTANT
// — the implication read, which asks a refinement whether it admits one
// point (`contract_excludes`). It was a handle with 0 for "none", the
// flag-as-int the drift catalog names; the three readings are three
// constructors now.
type SelfBind = NoSelf | SelfNode(Int) | SelfVal(LitValue)

fn predicate_decide_at(ref pred, bind) = match pred {
  PTrue => Some(true),
  PCompare(op, l, r) => compare_decide_at(op, l, r, bind),
  PAnd(a, b) => and_decide(predicate_decide_at(a, bind), predicate_decide_at(b, bind)),
  POr(a, b) => or_decide(predicate_decide_at(a, bind), predicate_decide_at(b, bind)),
  PNot(inner) => not_decide(predicate_decide_at(inner, bind)),
  // a truth value the predicate computes — a call it makes among them — read
  // off what the walk says it can be, `self` handed on to every call; a
  // label is the influence walk's to decide (`flow_settle`)
  PBoolNode(n) => if label_of(n) == None {
    leaves_decide_bool(value_leaves(n, bind) ~> walking_self_as(bind))
  } else {
    None
  },
  // a destructuring pattern's shape, read off the value's edges
  PPatternMatch(pat, n) => shape_decide(pat, n),
  // bind `self` = sh over inner, through its tails when sh is a join
  PWithSelf(sh, inner) => decide_with_self(inner, SelfNode(sh)),
  PTotalDiv(op, a, b) => total_div_decide(op, a, b, bind),
  PInBounds(recv, idx) => in_bounds_decide(recv, idx, bind),
  // a provision states what arrives at a position, never a demand on it
  PProvides(_) => Some(true),
}

// Integer `/` and `%` trap on a zero divisor, and `/` on INT_MIN / -1 (the
// one quotient a signed word cannot hold). The claim decides from what the
// graph holds about the two operands: a constant decides a face outright,
// and a face a constant refutes REFUSES (`1 / 0` is never the program's
// meaning); a non-constant operand asks its refined type whether it EXCLUDES
// the fatal point — a Positive refinement excludes 0 and -1, a NonZero refinement
// excludes 0 alone, a NonNegative one on the dividend excludes INT_MIN —
// and an operand nothing bounds leaves the face open, which is the row
// fact `Trap` at the site. The answer is a ROW fact, so it stands only on
// what is proven or assumed under contract (`leaves_exclude`), never on a
// postcondition still owed or on the overflow-blind Add fold.
// Two ground operands decide at their points through the one home the
// integer folder asks (types.mn `int_op_defined`), so the claim and the fold
// cannot disagree about which constants trap.
fn total_div_decide(op, a, b, bind) = match node_const_at(a, bind) {
  Some(LVInt(na)) => match node_const_at(b, bind) {
    Some(LVInt(nb)) => Some(int_op_defined(op, na, nb)),
    None | Some(_) => total_div_faces(op, a, b, bind),
  },
  None | Some(_) => total_div_faces(op, a, b, bind),
}

fn total_div_faces(op, a, b, bind) = match op {
  BMod => node_excludes(b, 0, bind),
  BDiv => and_decide(
    node_excludes(b, 0, bind),
    or_decide(node_excludes(b, -1, bind), node_excludes(a, i32_min(), bind))
  ),
  BAdd | BSub | BMul | BEq | BNe | BLt | BGt | BLe | BGe | BAnd | BOr | BConcat => Some(true),
}

// A sequence read's precondition (TRAP): `0 <= i` and `i < len(xs)`, each
// decided as the division's faces are — a ROW fact, so it stands on
// constants, lengths and preconditions alone. The index's lower face reads
// its leaves' lower bounds; the upper face pairs every constant the index can
// be with every length the receiver can have, read along the receiver's
// edges (`seq_lengths`). A pair the text fixes out of range refutes — a
// join's tail that reads past its own literal is the trap written down. A
// face the values leave open is proven where the read's path implies it
// (`if i >= 0 && i < len(xs) { xs[i] }`), and otherwise stays open, which is
// the row fact `Trap` at the site.
fn in_bounds_decide(recv, idx, bind) = {
  let ileaves = value_leaves(idx, bind)
  let at = term_of(idx, bind)
  and_decide(
    or_path(leaves_nonneg(ileaves), idx, BLe, Some(TermAt(MZero, 0)), at),
    or_path(below_lengths(ileaves, seq_lengths(recv)), idx, BLt, at, length_of(recv, bind))
  )
}

// A sequence's length as a term: the constant the text fixes where every
// value it can be has one, else the length of the term it is.
fn length_of(recv, bind) = match seq_lengths(recv) {
  [Some(n), ...rest] => if all(same_length(n, ??), rest) { point_term(n) } else { length_term(term_of(recv, bind)) },
  _ => length_term(term_of(recv, bind)),
}

fn same_length(n, length) = length == Some(n)

fn leaves_nonneg(leaves) =
  if len(leaves) == 0 { None } else { fold(Some(true), nonneg_step, leaves) }

fn nonneg_step(acc, leaf) = and_decide(acc, leaf_nonneg(leaf))

fn leaf_nonneg(leaf) = match leaf {
  LPoint(v) => match v {
    LVInt(n) => Some(n >= 0),
    LVFloat(_) | LVString(_) | LVBool(_) => None,
  },
  LLength => Some(true),
  LParam(_, c) => match domain_lo(ty_domain(c)) {
    Some(lo) => if lo >= 0 { Some(true) } else { None },
    None => None,
  },
  LClaimed(_, beneath) => leaf_nonneg(beneath),
  LMay(beneath) => proves_only(leaf_nonneg(beneath)),
  LPost(_) => None,
  LSum(_) => None,
  LRet(_) => None,
  LBuilt(_) => None,
  LUnknown => None,
}

// `i < len(xs)` over every constant the index can be and every length the
// receiver can have: proven when each pair is in range, refuted the moment
// one is not, open where either side has a value nothing here fixes.
fn below_lengths(ileaves, lengths) = if len(ileaves) == 0 || len(lengths) == 0 {
  None
} else {
  fold(Some(true), below_step(lengths, ??, ??), ileaves)
}

fn below_step(lengths, acc, leaf) = and_decide(acc, leaf_below(leaf, lengths))

fn leaf_below(leaf, lengths) = match leaf {
  LPoint(v) => match v {
    LVInt(k) => fold(Some(true), point_step(k, ??, ??), lengths),
    LVFloat(_) | LVString(_) | LVBool(_) => None,
  },
  LClaimed(_, beneath) => leaf_below(beneath, lengths),
  LMay(beneath) => proves_only(leaf_below(beneath, lengths)),
  LParam(_, _) | LPost(_) | LSum(_) | LLength | LRet(_) | LBuilt(_) | LUnknown => None,
}

fn point_step(k, acc, n) = and_decide(acc, point_below(k, n))

fn point_below(k, n) = match n {
  Some(m) => Some(k < m),
  None => None,
}

// A claim stands where control reached it, and control reached it through
// every condition above it on the parent edge: an `if`'s branch holds its
// test one way, the right operand of `&&` or `||` holds the left one, and a
// `match` arm holds its own literal pattern and every earlier literal arm
// failing. Those conditions are the claim's hypotheses, read up the edge
// from the claim's own node.
//
// They speak of TERMS: a constant, a binder read along its edge, the length
// the vocabulary names, each plus a constant. A binder is one value wherever
// it is read, so two reads of it are one term; a handler's state is rebound
// by every resume and stands for nothing here. A hypothesis is a fact about
// machine words, so a term with an offset is admitted only where the facts
// already admitted keep it inside the word: `i + 1 <= len(xs)` says nothing
// of `i < len(xs)` where `i + 1` can wrap. The facts are difference bounds; a
// claim is proven when they imply it, and a path whose facts contradict each
// other is never taken, so every claim on it holds.
type Measure = MZero | MBinder(Int) | MLength(Measure)

type Term = TermAt(Measure, Int)

type Hyp = Holds(BinOp, Term, Term)

// `a - b <= w`, and `a - b != w`.
type Gap = AtMost(Measure, Measure, Int) | Apart(Measure, Measure, Int)

// A verdict the values left open, proven where the site's path implies the
// claim; one they decided stands.
fn or_path(verdict, site, op, lt, rt) = match verdict {
  None => if path_holds(site, op, lt, rt) { Some(true) } else { None },
  Some(v) => Some(v),
}

fn path_holds(site, op, lt, rt) = match lt {
  Some(l) => match rt {
    Some(r) => hyps_prove(path_hyps(site), Holds(op, l, r)),
    None => false,
  },
  None => false,
}

fn path_hyps(h) = match graph_parent_of(h) {
  Some(p) => step_hyps(h, p) ++ path_hyps(p),
  None => [],
}

fn step_hyps(child, p) = match graph_node_body(p) {
  NExpr(IfExpr(c, t, e)) => if child == t { cond_hyps(c, true) } else if child == e { cond_hyps(c, false) } else { [] },
  NExpr(BinOpExpr(op, a, b)) => if child == b { operand_hyps(op, a) } else { [] },
  NExpr(MatchExpr(s, arms)) => arm_hyps(child, s, arms),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// The right operand of `&&` runs where the left held, of `||` where it failed.
fn operand_hyps(op, a) = match op {
  BAnd => cond_hyps(a, true),
  BOr => cond_hyps(a, false),
  BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BLt | BGt | BLe | BGe | BConcat => [],
}

fn arm_hyps(child, s, arms) = match find(arm_body_is(child, ??), enumerate(arms)) {
  Some((k, (pat, _))) => (take(k, arms) |> flat_map(arm_failed(s, ??))) ++ pat_hyps(s, pat, true),
  None => [],
}

fn arm_body_is(child, indexed) = match indexed {
  (_, (_, body)) => body == child,
}

fn arm_failed(s, arm) = match arm {
  (pat, _) => pat_hyps(s, pat, false),
}

// What a literal arm says of its scrutinee: that it is the literal where the
// arm runs, and that it is not where a later arm runs. Any other pattern
// says nothing a term can hold.
fn pat_hyps(s, pat, holds) = match pat_of(pat) {
  PLit(lv) => match lv {
    LVInt(v) => compare_hyps(if holds { BEq } else { BNe }, term_of(s, NoSelf), point_term(v)),
    LVBool(b) => cond_hyps(s, b == holds),
    LVFloat(_) | LVString(_) => [],
  },
  PVar(_) | PWild | PAs(_, _) | PAlt(_) | PCon(_, _) | PTuple(_) | PRecord(_, _) | PList(_, _) => [],
}

// What a condition says where it held (or failed): a comparison its two
// terms, a conjunction both sides where it held, a disjunction both
// negations where it failed, a negation the other way, a let's test its
// value.
fn cond_hyps(c, holds) = match graph_node_body(c) {
  NExpr(BinOpExpr(op, l, r)) => match op {
    BAnd => if holds { cond_hyps(l, true) ++ cond_hyps(r, true) } else { [] },
    BOr => if holds { [] } else { cond_hyps(l, false) ++ cond_hyps(r, false) },
    BEq | BNe | BLt | BGt | BLe | BGe => compare_hyps(if holds { op } else { cmp_negated(op) }, term_of(l, NoSelf), term_of(r, NoSelf)),
    BAdd | BSub | BMul | BDiv | BMod | BConcat => [],
  },
  NExpr(UnaryOpExpr(op, x)) => match op {
    UNot => cond_hyps(x, !holds),
    UNeg => [],
  },
  NExpr(VarRef(_)) => match binder_read_by(c) {
    Some(b) => match graph_binder_of(b) {
      None => cond_hyps(b, holds),
      Some(_) => [],
    },
    None => [],
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

fn cmp_negated(op) = match op {
  BEq => BNe,
  BNe => BEq,
  BLt => BGe,
  BGe => BLt,
  BGt => BLe,
  BLe => BGt,
  BAdd | BSub | BMul | BDiv | BMod | BAnd | BOr | BConcat => op,
}

fn compare_hyps(op, lt, rt) = match lt {
  Some(l) => match rt {
    Some(r) => [Holds(op, l, r)],
    None => [],
  },
  None => [],
}

// The term a node is: a constant, a binder followed along its reference, the
// length of a term, or a term plus a constant. A constant past the bound the
// difference arithmetic keeps exact is no term.
fn term_of(h, bind) = match node_const_at(h, bind) {
  Some(v) => match v {
    LVInt(k) => point_term(k),
    LVFloat(_) | LVString(_) | LVBool(_) => None,
  },
  None => match graph_node_body(h) {
    NExpr(VarRef(name)) => if name == "self" {
      self_term(bind)
    } else {
      match binder_read_by(h) {
        Some(b) => binder_term(b),
        None => None,
      }
    },
    NExpr(CallExpr(f, args)) => match args {
      [x] => if is_length_callee(f) { length_term(term_of(x, bind)) } else { None },
      _ => None,
    },
    NExpr(PipeExpr(PForward, x, stage)) => if is_length_callee(stage) { length_term(term_of(x, bind)) } else { None },
    NExpr(BinOpExpr(op, l, r)) => match op {
      BAdd => term_sum(term_of(l, bind), term_of(r, bind)),
      BSub => term_less(term_of(l, bind), term_of(r, bind)),
      BMul | BDiv | BMod | BEq | BNe | BLt | BGt | BLe | BGe | BAnd | BOr | BConcat => None,
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => None,
  },
}

fn self_term(bind) = match bind {
  SelfNode(sh) => term_of(sh, NoSelf),
  SelfVal(v) => match v {
    LVInt(k) => point_term(k),
    LVFloat(_) | LVString(_) | LVBool(_) => None,
  },
  NoSelf => None,
}

// A parameter and a destructured part are their binder; a let is its value's
// term, or its binder where the value is no term; a handler's state is no
// term, since a resume rebinds it.
fn binder_term(b) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(_) => Some(TermAt(MBinder(b), 0)),
    PartFact(_) => Some(TermAt(MBinder(b), 0)),
    StateFact(_) => None,
  },
  None => match graph_node_body(b) {
    NExpr(_) => match term_of(b, NoSelf) {
      Some(t) => Some(t),
      None => Some(TermAt(MBinder(b), 0)),
    },
    NParam(_) => Some(TermAt(MBinder(b), 0)),
    NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) => None,
  },
}

fn is_length_callee(callee) = match graph_ref_decl(callee) {
  Some(d) => any(names_decl(d, ??), length_callees()),
  None => false,
}

fn names_decl(d, name: String) = env_resolve_linked(name) == Some(d)

fn length_term(t) = match t {
  Some(TermAt(m, k)) => if k == 0 { Some(TermAt(MLength(m), 0)) } else { None },
  None => None,
}

fn point_term(k) = if exact_offset(k) { Some(TermAt(MZero, k)) } else { None }

// The constants the bounds carry stay small, so no sum of them along a path
// leaves the word the arithmetic here is done in.
fn exact_offset(k) with Pure = k <= 1048576 && k >= -1048576

fn term_sum(a, b) = match a {
  Some(TermAt(m, k)) => match b {
    Some(TermAt(n, j)) => if n == MZero { offset_term(m, k + j) } else if m == MZero { offset_term(n, k + j) } else { None },
    None => None,
  },
  None => None,
}

fn term_less(a, b) = match a {
  Some(TermAt(m, k)) => match b {
    Some(TermAt(n, j)) => if n == MZero { offset_term(m, k - j) } else { None },
    None => None,
  },
  None => None,
}

fn offset_term(m, k) = if exact_offset(k) { Some(TermAt(m, k)) } else { None }

// The hypotheses the path states, admitted round by round as the facts
// already admitted keep their terms inside the word, beside what every term
// is by itself — a length is at least zero, a parameter what its
// precondition bounds; a disequation tightens a bound it sits at the edge of.
fn hyps_prove(hyps, goal) = {
  let base = flat_map(hyp_measures, [goal] ++ hyps) |> unique |> flat_map(measure_gaps)
  let gaps = tightened(admitted(hyps, base))
  !consistent(gaps) || hyp_in_word(gaps, goal) && follows(gaps, goal)
}

fn hyp_measures(hyp) = match hyp {
  Holds(_, TermAt(a, _), TermAt(b, _)) => [a, b],
}

fn measure_gaps(m) = match m {
  MZero => [],
  MLength(_) => [AtMost(MZero, m, 0)],
  MBinder(b) => binder_gaps(b, m),
}

fn binder_gaps(b, m) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => match pre_contract(f.pre) {
      Some(c) => domain_gaps(ty_domain(c), m),
      None => [],
    },
    PartFact(_) => [],
    StateFact(_) => [],
  },
  None => [],
}

fn domain_gaps(d, m) = match d {
  DRange(lo, hi) => lo_gaps(lo, m) ++ hi_gaps(hi, m),
  DFinite(_) | DUndecided => [],
}

fn lo_gaps(lo, m) = match lo {
  Some(l) => if exact_offset(l) { [AtMost(MZero, m, 0 - l)] } else { [] },
  None => [],
}

fn hi_gaps(hi, m) = match hi {
  Some(h) => if exact_offset(h) { [AtMost(m, MZero, h)] } else { [] },
  None => [],
}

fn admitted(pending, gaps) = match filter(hyp_in_word(gaps, ??), pending) {
  [] => gaps,
  ready => admitted(filter(hyp_outside(gaps, ??), pending), gaps ++ flat_map(hyp_gaps, ready)),
}

fn hyp_outside(gaps, hyp) = !hyp_in_word(gaps, hyp)

fn hyp_in_word(gaps, hyp) = match hyp {
  Holds(_, l, r) => term_in_word(gaps, l) && term_in_word(gaps, r),
}

// `m + k` is the word it denotes when m is bounded on the side k moves it
// toward: against zero by any bound, against another measure — itself a word
// — by at least k.
fn term_in_word(gaps, t) = match t {
  TermAt(m, k) => if k == 0 || m == MZero {
    true
  } else {
    let ms = gap_measures(gaps)
    if k > 0 {
      dist(gaps, ms, MZero, m) != None || any(bounds_above(gaps, ms, m, k, ??), ms)
    } else {
      dist(gaps, ms, m, MZero) != None || any(bounds_below(gaps, ms, m, k, ??), ms)
    }
  },
}

fn bounds_above(gaps, ms, m, k, l) = l != MZero && at_most(dist(gaps, ms, l, m), 0 - k)

fn bounds_below(gaps, ms, m, k, l) = l != MZero && at_most(dist(gaps, ms, m, l), k)

fn at_most(d, c) = match d {
  Some(v) => v <= c,
  None => false,
}

fn hyp_gaps(hyp) = match hyp {
  Holds(op, TermAt(a, ka), TermAt(b, kb)) => match op {
    BLe => [AtMost(a, b, kb - ka)],
    BLt => [AtMost(a, b, kb - ka - 1)],
    BGe => [AtMost(b, a, ka - kb)],
    BGt => [AtMost(b, a, ka - kb - 1)],
    BEq => [AtMost(a, b, kb - ka), AtMost(b, a, ka - kb)],
    BNe => [Apart(a, b, kb - ka)],
    BAdd | BSub | BMul | BDiv | BMod | BAnd | BOr | BConcat => [],
  },
}

fn follows(gaps, goal) = match goal {
  Holds(op, TermAt(a, ka), TermAt(b, kb)) => match op {
    BLe => implied(gaps, a, b, kb - ka),
    BLt => implied(gaps, a, b, kb - ka - 1),
    BGe => implied(gaps, b, a, ka - kb),
    BGt => implied(gaps, b, a, ka - kb - 1),
    BEq => implied(gaps, a, b, kb - ka) && implied(gaps, b, a, ka - kb),
    BNe => implied(gaps, a, b, kb - ka - 1) || implied(gaps, b, a, ka - kb - 1) || any(stated_apart(a, b, kb - ka, ??), gaps),
    BAdd | BSub | BMul | BDiv | BMod | BAnd | BOr | BConcat => false,
  },
}

fn stated_apart(a, b, c, gap) = match gap {
  Apart(x, y, d) => x == a && y == b && d == c || x == b && y == a && d == 0 - c,
  AtMost(_, _, _) => false,
}

// A disequation at the edge of a bound moves the bound past it: `n != 0`
// beside `n >= 0` is `n >= 1`.
fn tightened(gaps) = gaps ++ flat_map(apart_tightens(gaps, ??), gaps)

fn apart_tightens(gaps, gap) = match gap {
  Apart(a, b, c) => if implied(gaps, a, b, c) { [AtMost(a, b, c - 1)] } else { [] } ++ if implied(gaps, b, a, 0 - c) { [AtMost(b, a, 0 - c - 1)] } else { [] },
  AtMost(_, _, _) => [],
}

// `a - b <= c` follows when the shortest path from b to a weighs at most c.
fn implied(gaps, a, b, c) = at_most(dist(gaps, gap_measures(gaps), b, a), c)

fn gap_measures(gaps) = gaps |> flat_map(gap_ends) |> unique

fn gap_ends(gap) = match gap {
  AtMost(a, b, _) => [a, b],
  Apart(a, b, _) => [a, b],
}

// The shortest path from `src` to `dst`, every bound `x - y <= w` an edge
// from y to x weighing w, relaxed once per measure.
fn dist(gaps, ms, src, dst) = ms |> map(start_dist(src, ??)) |> relaxed(gaps, ms) |> dist_at(dst)

fn start_dist(src, m) = (m, if m == src { Some(0) } else { None })

fn relaxed(gaps, ms, ds) = fold(ds, relax_round(gaps, ??, ??), ms)

fn relax_round(gaps, ds, _) = fold(ds, relax, gaps)

fn relax(ds, gap) = match gap {
  AtMost(x, y, w) => match dist_at(y, ds) {
    Some(dy) => if shorter(dist_at(x, ds), dy + w) { set_dist(ds, x, dy + w) } else { ds },
    None => ds,
  },
  Apart(_, _, _) => ds,
}

fn shorter(cur, d) = match cur {
  Some(c) => d < c,
  None => true,
}

fn dist_at(m, ds) = match find(dist_of(m, ??), ds) {
  Some((_, d)) => d,
  None => None,
}

fn dist_of(m, entry) = match entry {
  (n, _) => n == m,
}

fn set_dist(ds, m, d) = ds |> map(set_entry(m, d, ??))

fn set_entry(m, d, entry) = match entry {
  (n, e) => if n == m { (n, Some(d)) } else { (n, e) },
}

// Bounds that close a cycle of negative weight cannot all hold: every
// measure starts at zero, and a round past one per measure still shortens a
// path only around such a cycle.
fn consistent(gaps) = {
  let ms = gap_measures(gaps)
  let settled = ms |> map(at_zero) |> relaxed(gaps, ms)
  fold(settled, relax, gaps) == settled
}

fn at_zero(m) = (m, Some(0))

// The lengths a sequence can have, read along its edges: a list literal's
// own count, a string literal's bytes, a let's value through the reference's
// link, every tail of a join; None for a length nothing here fixes (a
// parameter, a call, a built value). One entry per value the receiver can
// be, so a join answers each of its tails.
fn seq_lengths(h) = match node_const_at(h, NoSelf) {
  Some(LVString(s)) => [Some(len(s))],
  None | Some(_) => match value_tails(h) {
    Some(tails) => tails |> flat_map(seq_lengths),
    None => match graph_node_body(h) {
      NExpr(MakeListExpr(elems)) => [Some(len(elems))],
      NExpr(VarRef(_)) => match binder_read_by(h) {
        Some(b) => binder_lengths(b),
        None => [None],
      },
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => [None],
    },
  },
}

// A let's binder is its value node; a parameter, a part or a handler state
// fixes no length here.
fn binder_lengths(b) = match graph_binder_of(b) {
  Some(_) => [None],
  None => match graph_node_body(b) {
    NExpr(_) => seq_lengths(b),
    NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => [None],
  },
}

// `let [a, b] = xs`, `let Some(v) = o` and a parameter written as a pattern
// ASSERT the shape of a value where a `match` would dispatch on it, so the
// assertion is a partial read's claim, decided as the index's is: along the
// value's edges, every value it can be. Refuted the moment one has a
// constructor, a length or a constant the pattern excludes; proven when each
// has the pattern's shape; open where the walk reads nothing. The reads are
// the walk's own — the leaves (a constant, the constructor that built a
// value), `seq_lengths`, and `part_read` for a part of a whole built in
// sight. Two of them prove and never refute: an alternation, whose branches
// may each answer a different value, and a list's elements, which the part
// read answers together rather than at their positions.
fn shape_decide(pat, n) = match pat_of(pat) {
  PVar(_) => Some(true),
  PWild => Some(true),
  PAs(_, inner) => shape_decide(inner, n),
  PAlt(branches) => proves_only(fold(Some(false), alt_step(n, ??, ??), branches)),
  PLit(lv) => leaves_decide(value_leaves(n, NoSelf), leaf_is_point(lv, ??)),
  PCon(cname, ps) => and_decide(ctor_decide(cname, n), parts_decide(n, map(ctor_part(cname, ??), enumerate(ps)))),
  PTuple(ps) => parts_decide(n, map(tuple_part, enumerate(ps))),
  PRecord(fields, _) => parts_decide(n, map(record_part, fields)),
  PList(prefix, rest) => and_decide(
    seq_lengths(n) |> map(length_admits(len(prefix), rest, ??)) |> fold(Some(true), and_decide),
    elements_decide(n, prefix)
  ),
}

fn alt_step(n, acc, branch) = or_decide(acc, shape_decide(branch, n))

fn proves_only(v) = match v {
  Some(true) => Some(true),
  Some(false) => None,
  None => None,
}

fn leaves_decide(leaves, test) =
  if len(leaves) == 0 { None } else { leaves |> map(test) |> fold(Some(true), and_decide) }

fn leaf_is_point(lv, leaf) = match leaf {
  LPoint(v) => litval_eq(v, lv),
  LClaimed(_, beneath) => leaf_is_point(lv, beneath),
  LMay(beneath) => proves_only(leaf_is_point(lv, beneath)),
  LBuilt(_) | LParam(_, _) | LPost(_) | LSum(_) | LLength | LRet(_) | LUnknown => None,
}

// A constructor pattern: every value built by it proves, one built by
// another refutes, one not built in sight leaves it open. A type with one
// constructor has nothing to exclude.
fn ctor_decide(cname: String, n) = if len(ctor_roster(cname)) == 1 {
  Some(true)
} else {
  leaves_decide(value_leaves(n, NoSelf), leaf_is_built_by(cname, ??))
}

fn leaf_is_built_by(cname: String, leaf) = match leaf {
  LBuilt(made) => Some(made == cname),
  LClaimed(_, beneath) => leaf_is_built_by(cname, beneath),
  LMay(beneath) => proves_only(leaf_is_built_by(cname, beneath)),
  LPoint(_) | LParam(_, _) | LPost(_) | LSum(_) | LLength | LRet(_) | LUnknown => None,
}

fn ctor_part(cname: String, indexed) = match indexed {
  (i, p) => (PartCtor(cname, i), p),
}

fn tuple_part(indexed) = match indexed {
  (i, p) => (PartIndex(i), p),
}

fn record_part(field) = match field {
  (name, p) => (PartField(name), p),
}

fn parts_decide(n, parts) = parts |> map(part_decide(n, ??)) |> fold(Some(true), and_decide)

// A part that binds or ignores what it holds asserts nothing; any other is
// read off the whole where the whole was built in sight, each node the part
// can be deciding its own pattern, and is open where it was not.
fn part_decide(n, part) = match part {
  (step, p) => if asserts_nothing(p) {
    Some(true)
  } else {
    match part_read(n, step, shape_read(p, ??)) {
      Some(verdicts) => verdicts |> fold(Some(true), and_decide),
      None => None,
    }
  },
}

fn shape_read(p, node) = Some([shape_decide(p, node)])

// A list's elements are read together — `PartElem` answers every element of
// a list built in sight, not the one at a position — so each asserting
// element pattern is asked of every element: that proves the claim, and a
// failure says nothing of the element at the pattern's own position.
fn elements_decide(n, prefix) = match filter(asserts, prefix) {
  [] => Some(true),
  asserting => match part_read(n, PartElem, node_read) {
    Some(elems) => proves_only(elems |> flat_map(element_verdicts(asserting, ??)) |> fold(Some(true), and_decide)),
    None => None,
  },
}

fn asserts(p) = !asserts_nothing(p)

fn node_read(node) = Some([node])

fn element_verdicts(asserting, elem) = asserting |> map(shape_decide(??, elem))

fn length_admits(k, rest, length) = match length {
  Some(m) => match rest {
    Some(_) => Some(m >= k),
    None => Some(m == k),
  },
  None => None,
}

// A pattern no value of its type can fail: a binder, `_`, and a tuple, a
// record or a sole constructor whose parts are such patterns.
fn asserts_nothing(p) = match pat_of(p) {
  PVar(_) => true,
  PWild => true,
  PAs(_, inner) => asserts_nothing(inner),
  PTuple(ps) => all(asserts_nothing, ps),
  PRecord(fields, _) => all(field_asserts_nothing, fields),
  PCon(cname, ps) => len(ctor_roster(cname)) == 1 && all(asserts_nothing, ps),
  PLit(_) => false,
  PList(_, _) => false,
  PAlt(_) => false,
}

fn field_asserts_nothing(field) = match field {
  (_, p) => asserts_nothing(p),
}

// Is the value at `h` provably not `k`? A constant answers outright (equal
// is Some(false) — the refutation); otherwise the leaves decide as a claim
// over a join does: every leaf excluding the point proves it, a leaf that IS
// the point refutes it (a join's tail, an arm's answer at an install — the
// text writes the trap), anything else leaves it open. Until 2026-10-03 a
// leaf at the point answered open, so `100 / ((…) ~> zero)` was debt under
// `!Trap` where the arm's `0` refutes it.
fn node_excludes(h, k, bind) = match node_const_at(h, bind) {
  Some(v) => not_decide(litval_eq(v, LVInt(k))),
  None => or_path(leaves_exclude(value_leaves(h, bind), k), h, BNe, term_of(h, bind), point_term(k)),
}

// THE IMPLICATION READ: a contract excludes a point exactly when one of its
// predicates decides FALSE with `self` bound to that point — `0 < self` at 0
// is false, so a Positive refinement excludes 0; `self % 2 == 0` at 0 is true, so an
// Even refinement admits it. Every predicate down the alias chain is asked,
// since a refinement of a refinement holds both. No implication engine: the
// fragment that decides claims decides this one, over the ground constant
// the SelfVal binding carries.
fn contract_excludes(c, k) = match c {
  TAlias(_, inner) => contract_excludes(inner, k),
  TRefined(base, pred) => pred_excludes(pred, k) || contract_excludes(base, k),
  TReprPin(_, base) => contract_excludes(base, k),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
  | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => false,
}

fn pred_excludes(pred, k) = match predicate_decide_at(pred, SelfVal(LVInt(k))) {
  Some(false) => true,
  None | Some(_) => false,
}

// A claim about a JOIN's value is a claim about every value the join can
// take, and an `if`, a `match` or a block takes exactly its tails' values —
// so a claim over one decides as the AND of the claim over each tail
// (`and_decide`: true when every tail proves it, false the moment one
// refutes it, open otherwise). It reads STRUCTURE only, as the value walk
// below does; a join's leaves (`value_leaves`) are the same AND one altitude
// over, at the constant fragment.
// A tail the text writes is judged even where no execution reaches it: the
// signature claims every tail. Until 2026-09-27 a claim over a join was
// never decided, so `fn note_hz(k) -> Hz = match k { 0 => 220.0, … }` left a
// pending obligation behind every literal-armed match.
fn decide_with_self(inner, bind) = match bind {
  SelfNode(sh) => match value_tails(sh) {
    Some(tails) => fold(Some(true), decide_tail(inner, ??, ??), tails),
    None => predicate_decide_at(inner, bind),
  },
  NoSelf | SelfVal(_) => predicate_decide_at(inner, bind),
}

fn decide_tail(inner, acc, tail) = and_decide(acc, decide_with_self(inner, SelfNode(tail)))

// A JOIN's tails: the nodes whose values the join takes — an `if`'s two
// branches, every `match` arm's body, a block's final expression; None for
// a node that is not a join. One home for the structure that the claim
// decided over a join, the value walk and the claim noted over a join each
// fold.
fn join_tails(h) = match graph_node_body(h) {
  NExpr(IfExpr(_, t, e)) => Some([t, e]),
  NExpr(MatchExpr(_, arms)) => Some(arms |> map(tail_of_arm)),
  NExpr(BlockExpr(_, final_expr)) => Some([final_expr]),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

fn tail_of_arm(arm) = match arm {
  (_, body) => body,
}

// A VALUE's tails: a join's, or a tee's — the body it governs and every arm
// of the handler it installs (`install_arm_tails`). The one home the claim
// decider, the leaves, the path read, the flow label and the function-value
// walk read a value's structure through. A claim NOTED over a value stays
// with the join's own tails (infer.mn's note_claim): a handler's arms are shared by
// every install, and a note there would claim for all of them.
fn value_tails(h) = match join_tails(h) {
  Some(tails) => Some(tails),
  None => match graph_node_body(h) {
    NExpr(PipeExpr(PTee, left, right)) => match install_arm_tails(right) {
      Some(tails) => Some([left] ++ tails),
      None => None,
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => None,
  },
}

// A TEE's value is every value its install can answer: the body's tails —
// the body completing, or a resuming arm's remainder answering, which is
// the body's own value — and each arm's tails of its own. An arm whose tail
// is the `resume` hands the remainder's answer through and adds no value;
// any other tail is a value of the install's. A handler's arms met again
// while they are being read add nothing: an arm installing its own handler
// makes the tails a fixed point whose least solution is the body's, so the
// re-entry is exact, never a floor. The walk's dynamic scope (`StateWalk`)
// knows the handler by its residual row cell — minted once at
// pre-registration, the one cell every reference to the handler reads it
// through, so the declaration's identity is on the env entry and no name
// is scanned for it. None when the install's handler is not a declaration
// the graph noted, so each walk keeps its own floor. Until 2026-10-03
// every walk read a tee as nothing it could read, so `100 / ((…) ~> h)`
// was debt whatever `h` answered.
fn install_arm_tails(right) = match tee_handler_decl(right) {
  Some(d) => match graph_published(d) {
    Some((_, _, kind)) => match kind {
      HandlerKind(r_handle, _, _, _, arms) => if walking_state(r_handle) {
        Some([])
      } else {
        Some(arms |> flat_map({ arm => arm_tails(arm.body) }) ~> walking_state_of(r_handle))
      },
      FnScheme | ConstructorScheme(_, _) | EffectOpScheme(_, _, _) | RecordSchemeKind(_)
      | EffectDeclKind(_, _) | ParamScheme(_) | RowAliasKind(_) | TypeVariants(_) | HandlerChainKind(_)
      | ValueScheme | PrimitiveKind(_) => None,
    },
    None => None,
  },
  None => None,
}

// The reference a tee's right side installs through — the handler bare, or
// applied to its config — or the side itself when it is no reference.
fn tee_ref(r) = match graph_node_body(r) {
  NExpr(CallExpr(f, _)) => tee_ref(f),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => r,
}

// The declaration a tee installs: its reference followed along its edge.
// None when that side is no reference — no declaration answers it, which is
// the frame fence.
fn tee_handler_decl(r) = graph_ref_decl(tee_ref(r))

// What a handler declaration was published as: the residual row cell its
// arms were judged under, its config, its state and its arms. None for a
// declaration that is no handler — a parameter or a local holding one.
fn handler_shape_at(d) = match graph_published(d) {
  Some((_, _, kind)) => match kind {
    HandlerKind(r, _, config, state, arms) => Some((r, config, state, arms)),
    FnScheme | ValueScheme | ParamScheme(_) | ConstructorScheme(_, _) | EffectOpScheme(_, _, _)
    | RecordSchemeKind(_) | EffectDeclKind(_, _) | HandlerChainKind(_) | RowAliasKind(_)
    | TypeVariants(_) | PrimitiveKind(_) => None,
  },
  None => None,
}

fn handler_arms_at(d) = match handler_shape_at(d) {
  Some((_, _, _, arms)) => Some(arms),
  None => None,
}

// The arms of the handler a tee installs, read along its edge.
fn tee_arms(r) = match tee_handler_decl(r) {
  Some(d) => handler_arms_at(d),
  None => None,
}

// The handler a tee installs, by the name its right side carries — a bare
// reference, or a configured handler applied to its arguments — read off the
// node, since the install column is the lowering's, written after every
// claim is decided. A tee whose handler expression is not a named reference
// has no name to classify: "" is the frame-fence sentinel
// schedule_installed itself reads (lower.mn: a "" stack entry is the
// fence), not a fabrication — no declaration answers it, so its class is a
// dispatch and the schedule read walks past it. One home for the judgment,
// the query and the caret.
fn tee_handler_name(r) = match graph_node_body(r) {
  NExpr(VarRef(n)) => n,
  NExpr(CallExpr(callee, _)) => match graph_node_body(callee) {
    NExpr(VarRef(n)) => n,
    // drift-audit: ignore — the frame-fence sentinel, documented above
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => "",
  },
  // drift-audit: ignore — the frame-fence sentinel, documented above
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => "",
}

fn arm_tails(h) = match value_tails(h) {
  Some(tails) => tails |> flat_map(arm_tails),
  None => match graph_node_body(h) {
    NExpr(ResumeExpr(_, _)) => [],
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [h],
  },
}

// A comparison decides iff BOTH operands reduce to ground constants under the
// current `self` binding — or, with a ground LEFT and a structural right, the
// interval fragment proves `n <= X` from X's lower bound; a claim over a value
// it leaves open is proven where the value's path implies it.
fn compare_decide_at(op, lh, rh, bind) = match node_const_at(lh, bind) {
  Some(lv) => match node_const_at(rh, bind) {
    Some(rv) => litval_compare(op, lv, rv),
    None => claim_on_path(interval_ge_decide(op, lv, rh, bind), op, lh, rh, bind),
  },
  None => claim_on_path(None, op, lh, rh, bind),
}

// The path a comparison stands on is the claimed value's: a predicate's own
// nodes sit in its type's declaration, where no condition holds.
fn claim_on_path(verdict, op, lh, rh, bind) = match bind {
  SelfNode(sh) => or_path(verdict, sh, op, term_of(lh, bind), term_of(rh, bind)),
  NoSelf | SelfVal(_) => verdict,
}

// `n <= X` / `n < X` with ground left: proves when X's structural LOWER BOUND
// reaches n. PROVES only, never refutes — a bound that fails to reach n says
// nothing about X's values (None keeps the obligation live and honest).
fn interval_ge_decide(ref op, ref lv, rh, bind) = match lv {
  LVInt(n) => match leaves_lo(value_leaves(rh, bind)) {
    Some(lo) => match op {
      BLe => if n <= lo { Some(true) } else { None },
      BLt => if n < lo { Some(true) } else { None },
      BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BGt | BGe | BAnd | BOr | BConcat => None,
    },
    None => None,
  },
  LVFloat(_) | LVString(_) | LVBool(_) => None,
}

// Resolve an operand HANDLE to a ground constant, reading the Expr LIVE from the
// graph — the decidable arithmetic fragment. A literal folds to itself; `self`
// resolves to the value node the enclosing PWithSelf bound; a BinOpExpr folds
// its two ground operands via litval_arith (+,-,*,/,% same-kind); a UnaryOpExpr
// negates its ground operand. NO node is minted — every leaf is read live and
// folded in place (the e-graph const-fold mints nodes and runs AFTER Verify;
// this is a pure read-and-fold at the proof gate). Carry the handle, read live.
fn node_const(handle) = node_const_at(handle, NoSelf)

fn node_const_at(handle, bind) = match graph_node_body(handle) {
  NExpr(LitInt(n)) => Some(LVInt(n)),
  NExpr(LitFloat(f)) => Some(LVFloat(f)),
  NExpr(LitString(s)) => Some(LVString(s)),
  NExpr(LitBool(b)) => Some(LVBool(b)),
  NExpr(VarRef(name)) => resolve_self_operand(handle, name, bind),
  NExpr(BinOpExpr(op, l, r)) => litval_arith_opt(op, node_const_at(l, bind), node_const_at(r, bind)),
  NExpr(UnaryOpExpr(op, x)) => litval_unary_opt(op, node_const_at(x, bind)),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// `self` resolves through its binding — the value node, read as a ground
// constant, or the constant itself; a bare claim has no `self`. Any OTHER
// name is a constant exactly when it is a MODULE VALUE bound to one
// (`module_let_const`): `let lanes = 4` is a fact the graph holds at the
// let's own node, and a division by it is total for that reason.
fn resolve_self_operand(r, name: String, bind) = if name == "self" {
  match bind {
    NoSelf => None,
    SelfNode(h) => node_const_at(h, NoSelf),
    SelfVal(v) => Some(v),
  }
} else {
  module_let_const(r)
}

// A module-level `let` bound to a constant: the reference's edge reaches the
// value the let binds (a `let`'s binder IS its value's cell), and that value
// is the let's own at module level. A local let — or a local of the same
// name, which the edge reaches instead — is path-sensitive and stays honest
// debt.
fn module_let_const(r) = match binder_read_by(r) {
  Some(v) => match graph_parent_of(v) {
    Some(s) => match graph_node_body(s) {
      NStmt(LetStmt(pat, value, _)) => match pat_of(pat) {
        PVar(_) => if value == v && at_module_level(s) { node_const_at(v, NoSelf) } else { None },
        PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) | PAs(_, _) => None,
      },
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => None,
    },
    None => None,
  },
  None => None,
}

// A refinement is a fact about a VALUE, and the edges the value flowed
// through say what it is. Its unification class says nothing: a cell holds
// a shape (types.mn `shape_of`), because union-find merges every value a
// join can take and every operand an operator meets — the class model
// typed `x - 1` over `x: Positive` as Positive and `if c { n } else { 0 }`
// as Positive (P0, 2026-10-01). The walk reads a value as its LEAVES, each
// a graph READ minting nothing:
//   · a constant is its point (node_const_at folds literals, module
//     constants and the arithmetic over them at the word's own wrap)
//   · a reference reads its binder through its own link — a declared
//     parameter's precondition, a let's value, the claim's `self`
//   · an if / match / block is every tail's leaves — a join is all of them
//   · len / byte_len are lengths, by the sequence representation itself
//   · a call — and a pipe stage, the same application — is its callee's
//     declared return, or a function-typed parameter's contract on its
//     result
//   · Add folds its operands' lower bounds
// and each reader asks its own question of the leaves: a ROW fact
// (partiality, a guard) stands on constants, lengths and preconditions
// alone; a CLAIM's bound and echo may stand on a postcondition, which its
// callee owes at its declaration, and on the Add fold, which models Int as
// unbounded where the i32 floor wraps
// (Hβ.verify.interval-fragment-assumes-unbounded-int). It replaced the
// class reads and three compensations for them: a two-face "contamination
// law" that read types only where a class boundary was crossed, a licence
// refusing the echo to computation nodes, and a rebind exposing a let
// annotation on its value's class.
type Leaf
  // a constant — exact, at the word's own wrap
  = LPoint(LitValue)
  // a declared parameter's precondition: assumed here, owed by every
  // caller, and the parameter whose guard a row fact standing on it grows
  | LParam(Int, Ty)
  // a callee's declared return: the callee owes it at its own declaration,
  // and it is debt there until proven
  | LPost(Ty)
  // the Add fold's lower bound for a sum — overflow-blind
  | LSum(Option(Int))
  // len / byte_len: a length, never below zero
  | LLength
  // a callee's return still a free cell — nothing to any reader but the
  // summary of the declaration whose return it is, where a self-call is
  // the claim being proven (`proven_return`)
  | LRet(Int)
  // a value under a contract claimed of it where it was made — a `let`'s
  // annotation, a constructor field's declared refinement — owed there: a
  // claim may stand on the contract, a row fact only on the leaf beneath
  | LClaimed(Ty, Leaf)
  // a value built by this constructor, named bare or applied — the fact
  // `construction_part` compares, read by a destructuring pattern's claim
  // (`shape_decide`); no number, bound or label stands on it
  | LBuilt(String)
  // a value the read MAY take: what a writer stored into the memory, which
  // another write may have replaced since, or what one of an op's providers
  // resumes with, where which install answers is not in sight — what holds
  // of every such value holds of the read, and no one of them alone refutes
  // a claim
  | LMay(Leaf)
  // nothing this walk can read
  | LUnknown

// The leaves of a value the walk cannot read, the answer at every place it
// stops: one value, made once.
let leaves_unknown = [LUnknown]

// A value walk's dynamic scope: the state binders whose writers it is
// reading, the handler declarations whose arms it is reading, and the calls
// and performs it has entered, each with what its parameters take there. A
// write may read the state it writes (`with d = d + 1`, or through a let), so
// a walk that meets a state it is already inside reads it as unknown rather
// than looping; an arm may install its own handler, and the arms met again
// add no tail (the least fixed point, exact); a declaration met again inside
// its own body answers what it publishes. The chain of handlers installed
// around the walks IS the stack of states, declarations and calls entered
// (walking_state_of, walking_args).
effect StateWalk {
  walking_state(b: Int) -> Bool
  walked_arg(b: Int, path: [PartStep]) -> Option([Leaf])
  // what `self` is while a predicate is decided: a call the predicate makes
  // hands it on as an argument, and the callee's reads reach it here
  walked_self() -> SelfBind
  // whether the reading has entered the declaration's body already: None
  // where no call is entered yet, Some(true) where it has, Some(false) where
  // this is the first time, now marked
  walk_enter(d: Int) -> Option(Bool)
  // the reading met code the judgment has not reached yet — a handler whose
  // arms are not all judged, a declaration not yet published
  walk_unsettled()
}

// Whether the reading of one claim met code the judgment had not reached.
effect Unsettled {
  unsettled_met() -> Bool
}

handler noting_unsettled with met = false {
  walking_state(x) => resume(walking_state(x)),
  walked_arg(x, path) => resume(walked_arg(x, path)),
  walked_self() => resume(walked_self()),
  walk_enter(d) => resume(walk_enter(d)),
  walk_unsettled() => resume() with met = true,
  unsettled_met() => resume(met),
}

// What a parameter takes at the call or the perform the walk entered: the
// argument's node; the value the perform's instance holds, for a handler's
// config that pins one of its effect's dimensions; or, for any other config,
// only the precondition its install owes.
type WalkedArg = ArgNode(Int) | ArgPoint(LitValue) | ArgOpaque

fn value_leaves(h, bind) = match node_const_at(h, bind) {
  Some(v) => [LPoint(v)],
  None => match value_tails(h) {
    Some(tails) => tails |> flat_map(value_leaves(??, bind)),
    None => match graph_node_body(h) {
      NExpr(VarRef(name)) => if name == "self" {
        self_leaves(bind)
      } else if ref_is_constructor(h) {
        [LBuilt(name)]
      } else {
        binder_leaves(h)
      },
      NExpr(BinOpExpr(op, l, r)) => match op {
        BAdd | BSub | BMul | BDiv | BMod => arith_leaves(op, operand_leaves(l, bind), operand_leaves(r, bind)),
        BEq | BNe | BLt | BGt | BLe | BGe => compare_leaves(op, operand_leaves(l, bind), operand_leaves(r, bind)),
        BAnd => operand_leaves(l, bind) |> flat_map(and_leaf(??, r, bind)),
        BOr => operand_leaves(l, bind) |> flat_map(or_leaf(??, r, bind)),
        BConcat => leaves_unknown,
      },
      NExpr(UnaryOpExpr(UNot, x)) => operand_leaves(x, bind) |> map(not_leaf),
      NExpr(CallExpr(callee, _)) => call_leaves(h, callee),
      NExpr(PipeExpr(PForward, _, stage)) => call_leaves(h, stage),
      NExpr(FieldExpr(recv, fname)) => part_leaves(recv, PartField(fname)),
      NExpr(IndexExpr(recv, idx)) => part_leaves(recv, index_step(recv, idx)),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => leaves_unknown,
    },
  },
}

// An operand computed over. A value with no leaves is a state read inside
// its own writer, which adds no part where a write hands it on unchanged;
// computed over, it is a part the other writes never held, out of sight.
fn operand_leaves(h, bind) = match value_leaves(h, bind) {
  [] => leaves_unknown,
  leaves => leaves,
}

fn self_leaves(bind) = match bind {
  SelfNode(sh) => value_leaves(sh, NoSelf),
  SelfVal(v) => [LPoint(v)],
  NoSelf => match walked_self() {
    SelfNode(sh) => value_leaves(sh, NoSelf),
    SelfVal(v) => [LPoint(v)],
    NoSelf => leaves_unknown,
  },
}

// Arithmetic is what its operands can be, pair by pair, where every value
// either can be is a point: two points fold where the folder defines the
// result, and a division the folder will not fold is out of sight. A sum of
// anything else keeps the lower bound its operands' bounds reach.
fn arith_leaves(op, las, lbs) = if all(has_point, las) && all(has_point, lbs) {
  las |> flat_map({ a => lbs |> map(arith_pair(op, a, ??)) })
} else {
  match op {
    BAdd => [LSum(lo_add(leaves_lo(las), leaves_lo(lbs)))],
    BSub | BMul | BDiv | BMod | BEq | BNe | BLt | BGt | BLe | BGe | BAnd | BOr | BConcat => leaves_unknown,
  }
}

fn arith_pair(op, a, b) = match may_point(a) {
  Some((va, ma)) => match may_point(b) {
    Some((vb, mb)) => match litval_arith(op, va, vb) {
      Some(v) => may_if(ma || mb, LPoint(v)),
      None => LUnknown,
    },
    None => LUnknown,
  },
  None => LUnknown,
}

fn has_point(leaf) = may_point(leaf) != None

// The point a leaf is and whether the value only MAY be it.
fn may_point(leaf) = match leaf {
  LMay(beneath) => match may_point(beneath) {
    Some((v, _)) => Some((v, true)),
    None => None,
  },
  LPoint(v) => Some((v, false)),
  LClaimed(_, beneath) => may_point(beneath),
  LParam(_, _) | LPost(_) | LSum(_) | LLength | LRet(_) | LBuilt(_) | LUnknown => None,
}

// A comparison is what its operands can be, pair by pair: two points fold;
// a constant against an operand's lower bound proves where the bound reaches
// it and says nothing where it does not; any other pair is out of sight. A
// pair an operand MAY take is a verdict the comparison MAY take.
fn compare_leaves(op, las, lbs) = las |> flat_map({ a => lbs |> map(compare_pair(op, a, ??)) })

fn compare_pair(op, a, b) = match compare_verdict(op, a, b) {
  Some(held) => may_if(leaf_may(a) || leaf_may(b), LPoint(LVBool(held))),
  None => LUnknown,
}

fn compare_verdict(op, a, b) = match may_point(a) {
  Some((va, _)) => match may_point(b) {
    Some((vb, _)) => litval_compare(op, va, vb),
    None => bound_reaches(flip_cmp(op), b, va),
  },
  None => match may_point(b) {
    Some((vb, _)) => bound_reaches(op, a, vb),
    None => None,
  },
}

fn leaf_may(leaf) = match leaf {
  LMay(_) => true,
  LClaimed(_, beneath) => leaf_may(beneath),
  LPoint(_) | LParam(_, _) | LPost(_) | LSum(_) | LLength | LRet(_) | LBuilt(_) | LUnknown => false,
}

// `x >= n` and `x > n` hold where x's lower bound reaches n; a bound that
// falls short says nothing of x.
fn bound_reaches(op, x, v) = match v {
  LVInt(n) => match leaf_lo(x) {
    Some(lo) => match op {
      BGe => if lo >= n { Some(true) } else { None },
      BGt => if lo > n { Some(true) } else { None },
      BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BLt | BLe | BAnd | BOr | BConcat => None,
    },
    None => None,
  },
  LVFloat(_) | LVString(_) | LVBool(_) => None,
}

fn as_may(leaf) = match leaf {
  LPoint(_) => LMay(leaf),
  LMay(_) | LParam(_, _) | LPost(_) | LClaimed(_, _) | LSum(_) | LLength | LRet(_) | LBuilt(_)
  | LUnknown => leaf,
}

// `&&` and `||` short-circuit over what their left operand can be: a left
// that decides the result is the result, a left that defers is the right's
// value, MAY where the left only may defer.
fn and_leaf(a, r, bind) = match leaf_bool(a) {
  Some((false, _)) => [a],
  Some((true, may)) => value_leaves(r, bind) |> map(may_if(may, ??)),
  None => leaves_unknown,
}

fn or_leaf(a, r, bind) = match leaf_bool(a) {
  Some((true, _)) => [a],
  Some((false, may)) => value_leaves(r, bind) |> map(may_if(may, ??)),
  None => leaves_unknown,
}

fn may_if(may, leaf) = if may { as_may(leaf) } else { leaf }

fn not_leaf(leaf) = match leaf_bool(leaf) {
  Some((held, may)) => may_if(may, LPoint(LVBool(!held))),
  None => LUnknown,
}

// A leaf's truth value and whether the value only MAY be it.
fn leaf_bool(leaf) = match leaf {
  LMay(beneath) => match leaf_bool(beneath) {
    Some((held, _)) => Some((held, true)),
    None => None,
  },
  LPoint(LVBool(held)) => Some((held, false)),
  LClaimed(_, beneath) => leaf_bool(beneath),
  LPoint(_) | LParam(_, _) | LPost(_) | LSum(_) | LLength | LRet(_) | LBuilt(_) | LUnknown => None,
}

// A truth value read off its leaves: every value it can be holds, so it
// holds; one value it must be fails, so it fails; else it is out of sight.
fn leaves_decide_bool(leaves) = if len(leaves) > 0 && all({ l => leaf_bool(l) == Some((true, false)) || leaf_bool(l) == Some((true, true)) }, leaves) {
  Some(true)
} else if any({ l => leaf_bool(l) == Some((false, false)) }, leaves) {
  Some(false)
} else {
  None
}

// A reference's binder, along the reference's own edge (`binder_read_by`),
// never its class.
fn binder_leaves(use_h) = match binder_read_by(use_h) {
  Some(b) => leaves_at_binder(b),
  None => leaves_unknown,
}

// What a binder answers: a parameter of a call or a perform the walk
// entered — a function's, a lambda's, an arm's — what it takes there; any
// other declared parameter its precondition; a destructured part what its
// whole was built from at that position (a field's declared contract, owed
// where the value was built, over it); a let its value under every contract
// the let claimed of it. Any other binder answers nothing.
fn leaves_at_binder(b) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => entered_or(
      b,
      match pre_contract(f.pre) {
        Some(c) => [LParam(b, c)],
        None => leaves_unknown,
      }
    ),
    PartFact(f) => match f.declared {
      Some(c) => claimed_under(part_leaves(f.whole, f.step), c),
      None => part_leaves(f.whole, f.step),
    },
    StateFact(f) => state_leaves(b, f.writes),
  },
  None => match graph_node_body(b) {
    NExpr(_) => graph_claims_of(b) |> fold(value_leaves(b, NoSelf), claimed_under),
    NParam(_) => entered_or(b, leaves_unknown),
    NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) => leaves_unknown,
  },
}

fn entered_or(b, otherwise) = match walked_arg(b, []) {
  Some(leaves) => leaves,
  None => otherwise,
}

// A handler's state is every value written into it, each writer read as the
// expression it is — the init's node is the state's binder, so reading it as
// one would enter the state again. Inside its own writers the state is
// unknown: sound, and short of the inductive reading, which would assume
// there what every write must preserve.
fn state_leaves(b, writes) = if walking_state(b) {
  leaves_unknown
} else {
  writes |> flat_map(value_leaves(??, NoSelf)) ~> walking_state_of(b)
}

// No state entered: the root every value walk runs under, installed where
// the graph is.
handler no_state_walked {
  walking_state(_) => resume(false),
  walked_arg(_, _) => resume(None),
  walked_self() => resume(NoSelf),
  walk_enter(_) => resume(None),
  walk_unsettled() => resume(),
}

// Inside state `b`'s writers: `b` answers yes, and any other state is asked
// of the handler around this one — an arm's own perform resolves outward.
handler walking_state_of(b) {
  walking_state(x) => resume(x == b || walking_state(x)),
  walked_arg(x, path) => resume(walked_arg(x, path)),
  walked_self() => resume(walked_self()),
  walk_enter(d) => resume(walk_enter(d)),
  walk_unsettled() => resume(walk_unsettled()),
}

// Inside a predicate decided over a value: `self` is that value wherever the
// predicate's calls hand it.
handler walking_self_as(bind) {
  walking_state(x) => resume(walking_state(x)),
  walked_arg(x, path) => resume(walked_arg(x, path)),
  walked_self() => resume(bind),
  walk_enter(d) => resume(walk_enter(d)),
  walk_unsettled() => resume(walk_unsettled()),
}

// The declarations one reading has entered, installed by its first entry: a
// body is read once per reading, and met again — down another branch, through
// another call — answers what it publishes, so a reading costs the
// declarations it reaches, never the paths between them.
handler walk_entries with seen = [] {
  walking_state(x) => resume(walking_state(x)),
  walked_arg(x, path) => resume(walked_arg(x, path)),
  walked_self() => resume(walked_self()),
  walk_enter(d) => if any({ s => s == d }, seen) {
    resume(Some(true))
  } else {
    resume(Some(false)) with seen = [d] ++ seen
  },
  walk_unsettled() => resume(walk_unsettled()),
}

// Inside a call or a perform the walk entered: each parameter it binds takes
// what the call hands it, and any other is asked of the walk around this
// one. The argument is read in the arm, so its own reads resolve around
// this install, where the call stands — a recursive call hands a parameter
// back to itself, and the argument names the caller's binder, never the
// callee's.
handler walking_args(binds) {
  walking_state(x) => resume(walking_state(x)),
  walked_arg(x, path) => resume(match find({ (p, _) => p == x }, binds) {
    Some((_, w)) => Some(walked_leaves(x, w, path)),
    None => walked_arg(x, path),
  }),
  walked_self() => resume(walked_self()),
  walk_enter(d) => resume(walk_enter(d)),
  walk_unsettled() => resume(walk_unsettled()),
}

// What a parameter takes, at a path into it, as leaves: the argument's part
// read where the call stands, the value the instance holds, or — for a
// config its install owes the precondition of — the contract a claim may
// stand on, beneath which a row fact finds nothing in sight.
fn walked_leaves(b, w, path) = match w {
  ArgNode(n) => path_leaves(n, path),
  ArgPoint(v) => match path {
    [] => [LPoint(v)],
    [_, ..._] => leaves_unknown,
  },
  ArgOpaque => match graph_binder_of(b) {
    Some(ParamFact(f)) => match pre_contract(f.pre) {
      Some(c) => path |> fold([LClaimed(c, LUnknown)], project_leaves),
      None => leaves_unknown,
    },
    Some(PartFact(_)) | Some(StateFact(_)) | None => leaves_unknown,
  },
}

fn claimed_under(leaves, contract) = leaves |> map(LClaimed(contract, ??))

// A claim pending over an authored hole is the hole's DEMAND, not a proof
// of its own: the fill discharges it, and the hole's position carries it.
fn claim_is_a_holes_demand(pred) = match pred {
  PWithSelf(h, _) => match graph_node_body(h) {
    NHole(_) => true,
    NExpr(_) | NStmt(_) | NPat(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => false,
  },
  PTrue | PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
  | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _) => false,
}

// The leaves of whatever stands at a handle: a binder's (a destructured
// part's, a parameter's) or an expression's.
fn node_leaves(h) = match graph_binder_of(h) {
  Some(_) => leaves_at_binder(h),
  None => value_leaves(h, NoSelf),
}

// A pattern's binder for a part of the value it matched carries the edge to
// that value (PartFact), and a field read names its receiver. The part's
// value is read off the whole: where the whole was BUILT in sight — a tuple,
// a constructor call, a record, a list literal, through a let's value and
// every tail of a join — the part IS the argument at that position; where it
// was not, the whole's own contracts are projected to the position (a
// parameter's `(Int, Positive)` precondition answers Positive at its
// second element).
fn part_leaves(whole, step) = match part_read(whole, step, node_leaves_read) {
  Some(leaves) => leaves,
  None => match step {
    PartRest => leaves_unknown,
    PartIndex(_) | PartCtor(_, _) | PartField(_) | PartElem | PartTypeArg(_) => path_leaves(whole, [step]),
  },
}

fn node_leaves_read(n) = Some(node_leaves(n))

// The nodes a part can BE, read off its whole's construction, each read by
// `read` where the walk stands; None when the whole was not built where the
// walk sees. A constructor call of another constructor holds no such part —
// the arm cannot match it — and answers no nodes at all. The reader runs
// INSIDE every state the walk entered on the way, so a reader that meets one
// of them again is cut there: a state's writer can read the state it writes
// (`with acc = {count: acc.count + 1}`), and a walk that handed its nodes
// back to be read after it returned recursed until the stack ran out.
fn part_read(whole, step, read) = path_read(whole, [step], read)

// The value at a path inside a whole. A destructured part's binder extends
// the path into its own whole, so the reader is only ever forwarded and
// applied where the path ends.
fn path_read(whole, path, read) = match path {
  [] => read(whole),
  [step, ...rest] => match graph_binder_of(whole) {
    Some(fact) => match fact {
      PartFact(f) => path_read(f.whole, [f.step] ++ path, read),
      ParamFact(_) => None,
      StateFact(f) => state_path_read(whole, f.writes, path, read),
    },
    None => expr_path_read(whole, step, rest, read),
  },
}

// The path into an expression: through each tail, or its construction.
fn expr_path_read(whole, step, rest, read) = match value_tails(whole) {
  Some(tails) => read_all(tails, path_read(??, [step] ++ rest, read)),
  None => built_path_read(whole, step, rest, read),
}

// A state's path is each writer's, read off the writer as an expression,
// while nothing stores into the state's memory there; inside its own
// writers the state is out of sight.
fn state_path_read(b, writes, path, read) = if walking_state(b) {
  None
} else {
  match read_all(writes, writer_path_read(path, read, ??)) ~> walking_state_of(b) {
    Some(found) => match path {
      [step, ..._] => if nothing_written(memory_writes(b, step)) { Some(found) } else { None },
      [] => Some(found),
    },
    None => None,
  }
}

fn writer_path_read(path, read, w) = match path {
  [step, ...rest] => expr_path_read(w, step, rest, read),
  [] => read(w),
}

// A reference's path is its binder's; a constructor named bare is a
// construction with no fields; any other construction continues at the node
// in the step's position.
fn built_path_read(whole, step, rest, read) = match graph_node_body(whole) {
  NExpr(VarRef(_)) => if ref_is_constructor(whole) {
    nodes_path_read(bare_construction_part(step), rest, read)
  } else {
    match binder_read_by(whole) {
      Some(b) => path_read(b, [step] ++ rest, read),
      None => None,
    }
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => match built_part(whole, step) {
    Some(placed) => if nothing_written(memory_writes(whole, step)) {
      nodes_path_read(Some(placed), rest, read)
    } else {
      None
    },
    None => None,
  },
}

// A node read answers what the part IS; a value a writer stored there is one
// the part MAY hold, which only the leaves can say (`LMay`), so a written
// memory is out of a node reader's sight.
fn nothing_written(w) = match w {
  WrittenBy(written) => len(written) == 0,
  WrittenUnseen => false,
}

fn nodes_path_read(found, rest, read) = match found {
  Some(nodes) => read_all(nodes, path_read(??, rest, read)),
  None => None,
}

fn read_all(hs, read) = hs |> fold(Some([]), gather_read(read, ??, ??))

fn gather_read(read, acc, h) = match acc {
  Some(found) => match read(h) {
    Some(more) => Some(found ++ more),
    None => None,
  },
  None => None,
}

fn built_part(whole, step) = match graph_node_body(whole) {
  NExpr(MakeTupleExpr(elems)) => match step {
    PartIndex(i) => nth_handle(elems, i),
    PartCtor(_, _) | PartField(_) | PartElem | PartRest | PartTypeArg(_) => None,
  },
  NExpr(CallExpr(callee, args)) => match graph_node_body(callee) {
    NExpr(VarRef(made)) => if ref_is_constructor(callee) { construction_part(made, args, step) } else { None },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => None,
  },
  NExpr(MakeRecordExpr(fields)) => field_part(fields, step),
  NExpr(NamedRecordExpr(_, fields)) => field_part(fields, step),
  NExpr(MakeListExpr(elems)) => match step {
    PartElem => Some(elems),
    PartIndex(_) | PartCtor(_, _) | PartField(_) | PartRest | PartTypeArg(_) => None,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// A construction's part: the argument at its constructor's field, and none at
// another constructor's — a pattern naming that one cannot match this value,
// so it holds no such part, never one read off the whole. A type argument's
// values are among the fields: every field, since which field a type
// argument types is the constructor's declaration, out of this walk's reach
// (Hβ.verify.type-arg-part-reads-every-field).
fn construction_part(made: String, args, step) = match step {
  PartCtor(cname, i) => if made == cname { nth_handle(args, i) } else { Some([]) },
  PartTypeArg(_) => Some(args),
  PartIndex(_) | PartField(_) | PartElem | PartRest => None,
}

// A constructor named bare is a construction with no fields.
fn bare_construction_part(step) = match step {
  PartCtor(_, _) => Some([]),
  PartTypeArg(_) => Some([]),
  PartIndex(_) | PartField(_) | PartElem | PartRest => None,
}

fn nth_handle(nodes, i) = if i < len(nodes) { Some([list_index(nodes, i)]) } else { None }

fn field_part(fields, step) = match step {
  PartField(name) => match find({ (n, _) => n == name }, fields) {
    Some((_, v)) => Some([v]),
    None => None,
  },
  PartIndex(_) | PartCtor(_, _) | PartElem | PartRest | PartTypeArg(_) => None,
}

// A whole's leaf read at a position: a contract projects to the position's
// contract — assumed if the whole's was, owed if the whole's was — and a
// position that carries no refinement answers nothing.
fn project_leaf(leaf, step) = match leaf {
  LParam(b, c) => match refined_part(c, step) {
    Some(pc) => LParam(b, pc),
    None => LUnknown,
  },
  LPost(c) => match refined_part(c, step) {
    Some(pc) => LPost(pc),
    None => LUnknown,
  },
  LClaimed(c, beneath) => match refined_part(c, step) {
    Some(pc) => LClaimed(pc, project_leaf(beneath, step)),
    None => project_leaf(beneath, step),
  },
  LMay(beneath) => LMay(project_leaf(beneath, step)),
  // a constant, a sum, a length or a free return has no parts
  LPoint(_) => LUnknown,
  LSum(_) => LUnknown,
  LLength => LUnknown,
  LRet(_) => LUnknown,
  // a construction's parts are read where it was built (`part_read`)
  LBuilt(_) => LUnknown,
  LUnknown => LUnknown,
}

fn refined_part(c, step) = match contract_part(c, step) {
  Some(pc) => if ty_states_refinement(pc) { Some(pc) } else { None },
  None => None,
}

fn contract_part(c, step) = match c {
  TAlias(_, inner) => contract_part(inner, step),
  TReprPin(_, base) => contract_part(base, step),
  TTuple(es) => match step {
    PartIndex(i) => if i < len(es) { Some(list_index(es, i)) } else { None },
    PartCtor(_, _) | PartField(_) | PartElem | PartRest | PartTypeArg(_) => None,
  },
  TRecord(fs) => field_contract(fs, step),
  TRecordOpen(fs, _) => field_contract(fs, step),
  TList(e) => match step {
    PartElem => Some(e),
    PartIndex(_) | PartCtor(_, _) | PartField(_) | PartRest | PartTypeArg(_) => None,
  },
  TName(tname, args) => match step {
    PartTypeArg(k) => if k < len(args) { Some(list_index(args, k)) } else { None },
    PartCtor(cname, i) => ctor_field_contract(c, cname, i),
    PartField(name) => named_field_contract(tname, args, name),
    PartIndex(_) | PartElem | PartRest => None,
  },
  TRefined(base, _) => contract_part(base, step),
  TInt | TFloat | TUnit | TByte | TAddr | TFun(_, _, _) | TVar(_) | TCont(_, _, _, _) | TValue(_) => None,
}

// A nominal contract at a constructor's field: the field's declared type with
// the type's parameters read at the contract's arguments — `Option(Positive)`
// at `Some`'s field is the Positive refinement (types.mn `variant_named_specs_at`). A
// value built with `Some` owes it where it is claimed, and a pattern over a
// value under the contract may assume it.
fn ctor_field_contract(c, cname: String, i) = match find(spec_named(cname), variant_named_specs_at(c)) {
  Some(spec) => match spec {
    (_, _, tys) => if i < len(tys) { Some(list_index(tys, i)) } else { None },
  },
  None => None,
}

// A nominal record's contract at a field: the field's declared type, read
// along the record's name to its declaration with the type's parameters
// grounded at the contract's arguments, as a constructor's field is. So a
// parameter declared `v: Version` assumes at `v.spans` what the declaration
// states there, where a structural record with that field always did; a
// name that declares no record states nothing.
fn named_field_contract(tname: String, args, name) = match published_at(env_resolve_type(tname)) {
  Some((binding, _, kind)) => match kind {
    RecordSchemeKind(fields) => match field_contract(fields, PartField(name)) {
      Some(t) => Some(if len(args) == 0 { t } else { ground_ty(type_params_of(binding), args, t) }),
      None => None,
    },
    FnScheme | ConstructorScheme(_, _) | EffectOpScheme(_, _, _) | TypeVariants(_)
    | EffectDeclKind(_, _) | HandlerKind(_, _, _, _, _) | ParamScheme(_) | RowAliasKind(_)
    | HandlerChainKind(_) | ValueScheme | PrimitiveKind(_) => None,
  },
  None => None,
}

fn field_contract(fs, step) = match step {
  PartField(name) => match find({ (n, _) => n == name }, fs) {
    Some((_, t)) => Some(t),
    None => None,
  },
  PartIndex(_) | PartCtor(_, _) | PartElem | PartRest | PartTypeArg(_) => None,
}

// A call is a length when the callee is len / byte_len, and a construction
// when the callee is a constructor (a pipe into one is the same
// application); a call of a declaration in sight is what that declaration
// computes (`declared_call_leaves`); any other call is its callee's return —
// declared, or proven at the callee's exit — when that return states a
// refinement.
fn call_leaves(h, ref callee) = match graph_node_body(callee) {
  NExpr(VarRef(cname)) => if is_length_callee(callee) {
    [LLength]
  } else if ref_is_constructor(callee) {
    [LBuilt(cname)]
  } else {
    match graph_ref_decl(callee) {
      Some(d) => declared_call_leaves(h, callee, d),
      None => applied_leaves(callee),
    }
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => applied_leaves(callee),
}

// A value flows from a parameter when it is the parameter, a part of it — an
// element of a list parameter, a field of a record one, a position of a
// tuple one, read by an index, a field access or a pattern that
// destructured it — or a let of one of those. The path names the part, so a
// parameter can learn what its body does with the function at `fs[0]` as
// it learns what it does with the parameter itself. A join or a computation is not
// the parameter's value, and a variant's field or a list's rest carries no
// position a contract states.
fn flow_param_path(h) = match graph_node_body(h) {
  NExpr(VarRef(name)) => if name == "self" {
    None
  } else {
    match binder_read_by(h) {
      Some(b) => binder_path(b),
      None => None,
    }
  },
  NExpr(IndexExpr(recv, idx)) => path_step(flow_param_path(recv), index_step(recv, idx)),
  NExpr(FieldExpr(recv, fname)) => path_step(flow_param_path(recv), PartField(fname)),
  NExpr(BlockExpr(_, f)) => flow_param_path(f),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// What an index reads: a list's element, or — a literal index over a
// tuple — that position (SYNTAX §«Indexing»).
fn index_step(recv_h, idx) = match graph_node_body(idx) {
  NExpr(LitInt(k)) => match graph_chase(recv_h) {
    GNode(NBound(TTuple(_)), _) => PartIndex(k),
    GNode(_, _) => PartElem,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => PartElem,
}

fn binder_path(b) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(_) => Some((b, [])),
    PartFact(f) => path_step(whole_path(f.whole), f.step),
    StateFact(_) => None,
  },
  None => match graph_node_body(b) {
    NExpr(_) => flow_param_path(b),
    NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => None,
  },
}

// A destructured part's whole: an enclosing part's binder, or the node the
// pattern matched.
fn whole_path(w) = match graph_binder_of(w) {
  Some(_) => binder_path(w),
  None => flow_param_path(w),
}

fn path_step(at, step) = match at {
  Some(found) => match found {
    (b, path) => match step {
      PartIndex(_) => Some((b, path ++ [step])),
      PartField(_) => Some((b, path ++ [step])),
      PartElem => Some((b, path ++ [step])),
      PartTypeArg(_) => Some((b, path ++ [step])),
      PartCtor(_, _) => None,
      PartRest => None,
    },
  },
  None => None,
}

// The contract a structure states at a path.
fn contract_at(c, path) = match path {
  [] => Some(c),
  [step, ...rest] => match contract_part(c, step) {
    Some(part) => contract_at(part, rest),
    None => None,
  },
}

// A function-typed parameter applied — the parameter itself or a function at
// a part of it: its result under the return contract the parameter carries
// there, stated or learned from the demand its result meets, assumed here as
// a precondition is and owed where a caller hands the function in, so a row
// fact standing on it grows the parameter's guard. Any other callee: its
// return.
fn applied_leaves(ch) = match param_result(ch) {
  Some(leaf) => [leaf],
  None => post_leaves(ch),
}

fn param_result(ch) = match flow_param_path(ch) {
  Some(at) => match at {
    (b, path) => match graph_binder_of(b) {
      Some(fact) => match fact {
        ParamFact(f) => match pre_contract(f.pre) {
          Some(c) => match contract_at(c, path) {
            Some(t) => match t {
              TFun(_, ret, _) => if ty_carries_refinement(ret) { Some(LParam(b, ret)) } else { None },
              TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
              | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => None,
            },
            None => None,
          },
          None => None,
        },
        PartFact(_) => None,
        StateFact(_) => None,
      },
      None => None,
    },
  },
  None => None,
}

fn post_leaves(ch) = match graph_chase(ch) {
  GNode(NBound(TFun(_, ret, _)), _) => if ty_carries_refinement(ret) {
    [LPost(ret)]
  } else {
    match ret {
      TVar(r) => [LRet(r)],
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
      | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
      | TAlias(_, _) | TValue(_) => leaves_unknown,
    }
  },
  GNode(_, _) => leaves_unknown,
}

// A call of a declaration in sight is what that declaration computes there:
// its body read at the call's arguments, or — where the callee writes memory
// in place, so what it stored is part of what it hands back and its tails
// cannot show it — what its signature says the arguments handed in; a
// perform what the op's providers resume with at its instance. A
// postcondition the callee states rides over what it computes, so a claim
// may stand on the promise and a row fact on the computation beneath it. A
// declaration the walk is already inside answers what it publishes.
fn declared_call_leaves(h, callee, d) = if walking_state(d) {
  applied_leaves(callee)
} else {
  match graph_published(d) {
    Some((_, _, EffectOpScheme(en, providers, _))) => perform_leaves(h, callee, d, en, providers) |> under_post(callee, ??),
    Some((_, _, FnScheme)) => match answer_by_signature(h, callee, d, []) {
      Some(leaves) => leaves |> under_post(callee, ??),
      None => match graph_node_body(d) {
        NStmt(FnStmt(_, params, _, _, body)) => entered_leaves(h, callee, d, params, body),
        NStmt(_) | NExpr(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
        | NRow(_) | NParam(_) => applied_leaves(callee),
      },
    },
    Some(_) => applied_leaves(callee),
    None => {
      walk_unsettled()
      applied_leaves(callee)
    },
  }
}

// The callee's body at the call: each parameter takes the argument in its
// slot (the product the judgment wrote at the call, defaults filled), read
// where the call stands. The body's tails are every value it can answer, the
// branches its own conditions rule out at these arguments among them, so
// each is a value the call MAY take: together they prove, and one of them
// failing refutes nothing. A body the reading entered already answers what
// the declaration publishes (`walk_entries`).
fn entered_leaves(h, callee, d, params, body) = match graph_product_at(h) {
  ProductOf(slots, _, CallApplied) => if len(slots) == len(params) {
    match walk_enter(d) {
      Some(true) => applied_leaves(callee),
      Some(false) => body_at_call(callee, d, params, slots, body),
      None => body_at_call(callee, d, params, slots, body) ~> walk_entries,
    }
  } else {
    applied_leaves(callee)
  },
  ProductOf(_, _, CallSuspended) | NoProduct => applied_leaves(callee),
}

fn body_at_call(callee, d, params, slots, body) =
  (value_leaves(body, NoSelf) ~> walking_args(zip_with(arg_of_param, params, slots)) ~> walking_state_of(d)) |> map(may_refute) |> under_post(callee, ??)

// A tail of a body read at a call is one the call MAY take: only a point or
// a construction can refute a claim, so only those need saying so.
fn may_refute(leaf) = match leaf {
  LPoint(_) | LBuilt(_) => LMay(leaf),
  LParam(_, _) | LPost(_) | LSum(_) | LLength | LRet(_) | LClaimed(_, _) | LMay(_) | LUnknown => leaf,
}

// A parameter takes its argument at its own node, the binder a reference to
// it reaches.
fn arg_of_param(p, a) = (p, ArgNode(a))

fn under_post(callee, leaves) = match graph_chase(callee) {
  GNode(NBound(TFun(_, ret, _)), _) => if ty_carries_refinement(ret) { claimed_under(leaves, ret) } else { leaves },
  GNode(_, _) => leaves,
}

// A perform is what the op's providers resume with: every handler with an arm
// for it, the arm's arguments the perform's own. Which install answers is not
// in sight, so each value is one the perform MAY take (`LMay`); a provider
// whose arms the walk is already inside is unknown.
fn perform_leaves(h, callee, op, en: String, providers) = {
  let args = match graph_product_at(h) {
    ProductOf(slots, _, CallApplied) => slots,
    ProductOf(_, _, CallSuspended) | NoProduct => [],
  }
  let dims = op_dims(op)
  let inst = perform_instance(h, en, dims)
  match providers |> flat_map(provider_leaves(op, args, dims, inst, ??)) {
    [] => applied_leaves(callee),
    found => found |> map(LMay),
  }
}

// A handler that pins the op's effect answers a perform only from an install
// serving the perform's own instance, so its config there holds the value the
// instance holds at each dimension (effects.mn's `route_distinct`, the law
// the install's absorption and the run's dispatch read); a handler that pins
// nothing answers from any install, its config whatever that install handed.
fn provider_leaves(op, args, dims, inst, hd) = if walking_state(hd) {
  leaves_unknown
} else {
  match graph_node_body(hd) {
    NStmt(HandlerDeclStmt(_, _, config, _, arms, _)) => {
      let pinned = if pins_its_effect(hd, dims) { inst } else { [] }
      arms |> filter(arm_for_op(op, ??)) |> flat_map(arm_resumed(config, args, pinned, ??)) ~> walking_state_of(hd)
    },
    NStmt(_) | NExpr(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => leaves_unknown,
  }
}

fn pins_its_effect(hd, dims) = match graph_published(hd) {
  Some((_, _, HandlerKind(_, _, config, _, _))) => config_pins_dims(config, dims),
  Some(_) | None => false,
}

fn arm_for_op(op, arm) = graph_ref_decl(arm.op) == Some(op)

// What one arm resumes with, its arguments the perform's and its config read
// at the instance the install serves.
fn arm_resumed(config, args, pinned, arm) = {
  let arg_binds = if len(arm.args) == len(args) { zip_with(arg_of_param, arm.args, args) } else { [] }
  resumed_values(arm.body) |> flat_map(value_leaves(??, NoSelf)) ~> walking_args(arg_binds ++ map(config_bind(pinned, ??), config))
}

// A config that is a pinned dimension takes the value the instance holds
// there; any other is a precondition its install owes.
fn config_bind(pinned, p) = match find(dim_of_name(param_binder(p), ??), pinned) {
  Some((_, v)) => (p, ArgPoint(v)),
  None => (p, ArgOpaque),
}

fn dim_of_name(name: String, dv) = match dv {
  (dim, _) => dim == name,
}

// The dimensions of an op's effect, read off the declaration that holds it.
fn op_dims(op) = match graph_parent_of(op) {
  Some(ed) => match graph_published(ed) {
    Some((_, _, EffectDeclKind(_, dims))) => dims,
    Some(_) | None => [],
  },
  None => [],
}

// The perform's instance: each dimension of its effect paired with the value
// the row at the perform holds there, where that value is a constant.
fn perform_instance(h, en: String, dims) = match find(entry_named(en, ??), flat_map(row_present, graph_rows_at(h))) {
  Some(e) => instance_points(dims, entry_args_of(e)),
  None => [],
}

fn row_present(r) = match r {
  EfRow(p, _, _) => p,
}

fn entry_named(en: String, e) = eff_name_str(e) == en

fn entry_args_of(e) = match e {
  EParameterized(_, args) => args,
  ENamed(_) | EPure => [],
}

fn instance_points(dims, args) = zip(dims, args) |> flat_map(instance_point)

fn instance_point(da) = match da {
  (dim, a) => match arg_point(a) {
    Some(v) => [(dim, v)],
    None => [],
  },
}

// An instance argument as the constant it is, an instance variable read
// through its cell.
fn arg_point(a) = match a {
  EAInt(n) => Some(LVInt(n)),
  EAFloat(f) => Some(LVFloat(f)),
  EAString(s) => Some(LVString(s)),
  EAVar(f) => match graph_chase(f) {
    GNode(NBound(TValue(x)), _) => arg_point(x),
    GNode(_, _) => None,
  },
  EAType(_) | EANode(_) | EAEffect(_) | EACon(_) => None,
}

// The return a declaration PROVES when it authored none: the contract every
// return tail's leaves carry, a self-call read co-inductively — the walk
// stands inside the declaration, so the self-call answers the return being
// proven: it returns what the other tails return, or it never returns. None
// when a tail carries nothing, or every tail is the self-call. Published as
// the callee's return, it is a postcondition to its callers: a claim may
// stand on it, a row fact never (the arguments that made it true are owed by
// those same callers).
fn proven_return(decl, body_h, ret_h) = {
  let root = graph_chase_handle(ret_h)
  (value_leaves(body_h, NoSelf) ~> walking_state_of(decl) ~> reading_published) |> filter({ l => !leaf_is_ret(root, l) }) |> leaves_contract
}

handler reading_published {
  walking_state(x) => resume(walking_state(x)),
  walked_arg(x, path) => resume(walked_arg(x, path)),
  walked_self() => resume(walked_self()),
  walk_enter(_) => resume(Some(true)),
  walk_unsettled() => resume(walk_unsettled()),
}

// The contract every leaf carries, named by one alias — the first leaf's,
// when every leaf names it. None when a leaf carries none. What a return
// proves of every tail and what an application provides at a position are
// this one read.
fn leaves_contract(leaves) = match leaves {
  [] => None,
  [first, ..._] => match leaf_contract(first) {
    Some(c) => match contract_alias(c) {
      Some(a) => if all(leaf_carries(a, ??), leaves) { Some(c) } else { None },
      None => None,
    },
    None => None,
  },
}

fn leaf_is_ret(root, leaf) = match leaf {
  LRet(r) => graph_chase_handle(r) == root,
  LMay(beneath) => leaf_is_ret(root, beneath),
  LPoint(_) | LParam(_, _) | LPost(_) | LSum(_) | LLength | LClaimed(_, _) | LBuilt(_) | LUnknown => false,
}

fn leaf_contract(leaf) = match leaf {
  LParam(_, c) => Some(c),
  LPost(c) => Some(c),
  LClaimed(c, _) => Some(c),
  LMay(beneath) => leaf_contract(beneath),
  LPoint(_) | LSum(_) | LLength | LRet(_) | LBuilt(_) | LUnknown => None,
}

// The alias a contract is named by, through refinements and width pins.
fn contract_alias(c) = match c {
  TAlias(n, _) => Some(n),
  TRefined(base, _) => contract_alias(base),
  TReprPin(_, base) => contract_alias(base),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
  | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => None,
}

// A ROW fact, three-valued over the leaves (`and_decide`): proven when every
// leaf excludes the point, on what is proven (a constant, a length) or
// assumed under contract (a parameter's precondition) — never on a
// postcondition still owed or on the Add fold; REFUTED when a leaf is the
// point itself; open otherwise, and open over no leaves at all.
fn leaves_exclude(leaves, k) =
  if len(leaves) == 0 { None } else { fold(Some(true), leaf_exclude_step(k, ??, ??), leaves) }

fn leaf_exclude_step(k, acc, leaf) = and_decide(acc, leaf_excludes(k, leaf))

fn leaf_excludes(k, leaf) = match leaf {
  LPoint(v) => not_decide(litval_eq(v, LVInt(k))),
  LParam(_, c) => if contract_excludes(c, k) { Some(true) } else { None },
  LLength => if k < 0 { Some(true) } else { None },
  LClaimed(_, beneath) => leaf_excludes(k, beneath),
  LMay(beneath) => proves_only(leaf_excludes(k, beneath)),
  LPost(_) => None,
  LSum(_) => None,
  LRet(_) => None,
  LBuilt(_) => None,
  LUnknown => None,
}

// A CLAIM's lower bound: the least of every leaf's, each answering — a
// postcondition and the Add fold included, since a claim's own debt is the
// ledger's to carry.
fn leaves_lo(leaves) =
  if len(leaves) == 0 { None } else { leaves |> fold(Some(int_max_word()), leaf_lo_meet) }

fn leaf_lo_meet(acc, leaf) = match acc {
  Some(a) => match leaf_lo(leaf) {
    Some(b) => Some(int_min(a, b)),
    None => None,
  },
  None => None,
}

fn leaf_lo(leaf) = match leaf {
  LPoint(v) => match v {
    LVInt(n) => Some(n),
    LVFloat(_) | LVString(_) | LVBool(_) => None,
  },
  LParam(_, c) => domain_lo(ty_domain(c)),
  LPost(c) => domain_lo(ty_domain(c)),
  // both hold of the one value, so the bounds MEET
  LClaimed(c, beneath) => bound_meet(int_max, domain_lo(ty_domain(c)), leaf_lo(beneath)),
  LMay(beneath) => leaf_lo(beneath),
  LSum(lo) => lo,
  LLength => Some(0),
  LRet(_) => None,
  LBuilt(_) => None,
  LUnknown => None,
}

// The largest signed word — the identity of the lower bound's meet.
fn int_max_word() with Pure = 2147483647

// The sum of two operand bounds — both must answer.
fn lo_add(ea, eb) = match ea {
  Some(a) => match eb {
    Some(b) => Some(a + b),
    None => None,
  },
  None => None,
}

// A CLAIM's echo: every leaf names the refinement — a parameter's
// precondition or a callee's postcondition carrying the alias — so the
// value is already a member, and its obligation was owed where the leaf
// was made.
fn value_carries_alias(h, aname: String) = leaves_carry_alias(value_leaves(h, NoSelf), aname)

fn leaves_carry_alias(leaves, aname: String) =
  len(leaves) > 0 && all(leaf_carries(aname, ??), leaves)

// A value's leaves read at a path into it, along the edges the part was
// carried on: each tail of a join, the node a construction in sight placed
// there, a state's writers, the argument a parameter the walk entered was
// handed, and the values a generic call's signature says an argument handed
// in. Where no edge carries the part, each leaf of the whole is projected one
// step at a time, as a destructured part reads its whole (`project_leaf`).
// Beside them stands what every writer of its memory stored there; where a
// writer stored, what the part held may have been replaced, so each value
// is one it MAY hold.
fn path_leaves(h, path) = match path {
  [] => node_leaves(h),
  [step, ...rest] => match memory_writes(h, step) {
    WrittenUnseen => leaves_unknown,
    WrittenBy(written) => written_may(written, carried_or_projected(h, path) ++ (written |> flat_map(path_leaves(??, rest)))),
  },
}

fn carried_or_projected(h, path) = match carried_leaves(h, path) {
  Some(leaves) => leaves,
  None => path |> fold(node_leaves(h), project_leaves),
}

// A part's leaves where a writer stored: every one a value it MAY hold.
fn written_may(written, leaves) = if len(written) == 0 { leaves } else { leaves |> map(LMay) }

fn project_leaves(leaves, step) = leaves |> map(project_leaf(??, step))

fn carried_leaves(h, path) = match graph_binder_of(h) {
  Some(fact) => match fact {
    StateFact(f) => state_part_leaves(h, f.writes, path),
    ParamFact(_) => walked_arg(h, path),
    PartFact(_) => None,
  },
  None => match value_tails(h) {
    Some(tails) => Some(tails |> flat_map(path_leaves(??, path))),
    None => match graph_node_body(h) {
      NExpr(VarRef(name)) => if name == "self" {
        match walked_self() {
          SelfNode(sh) => Some(path_leaves(sh, path)),
          SelfVal(_) | NoSelf => None,
        }
      } else {
        match binder_read_by(h) {
          Some(b) => carried_leaves(b, path),
          None => None,
        }
      },
      NExpr(CallExpr(callee, _)) => if ref_is_constructor(callee) {
        built_leaves(h, path)
      } else {
        call_part_by_signature(h, callee, path)
      },
      NExpr(PipeExpr(PForward, _, stage)) => call_part_by_signature(h, stage, path),
      NExpr(MakeTupleExpr(_)) | NExpr(MakeRecordExpr(_)) | NExpr(NamedRecordExpr(_, _))
      | NExpr(MakeListExpr(_)) => built_leaves(h, path),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => None,
    },
  },
}

fn built_leaves(h, path) = match path {
  [step, ...rest] => match built_part(h, step) {
    Some(nodes) => Some(nodes |> flat_map(path_leaves(??, rest))),
    None => None,
  },
  [] => None,
}

// A state's part is what its writers put there — «a state is every value
// written into it», read at its parts. A writer's own read of the state adds
// no part the other writes do not (the least fixed point; induction over the
// order of the writes), so inside its writers it reads none, where the whole
// value read there stays out of sight. The parts close only where every
// store the handler's arms make into the state's memory stands inside one of
// its writes, read there by its callee's signature.
fn state_part_leaves(b, writes, path) = if walking_state(b) {
  Some([])
} else if stores_within_writes(b, writes) {
  Some(writes |> flat_map(path_leaves(??, path)) ~> walking_state_of(b))
} else {
  None
}

fn stores_within_writes(b, writes) = match owning_handler(b) {
  Some(hd) => match graph_node_body(hd) {
    NStmt(HandlerDeclStmt(_, _, _, _, arms, _)) => arm_stores(hd, arms) |> filter({ s => store_may_reach(s.roots, b) }) |> all({ s => within_writes(writes, s.call) }),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => false,
  },
  None => false,
}

fn store_may_reach(roots, b) = match roots {
  RootsAny => true,
  RootsAt(xs) => any({ x => x == b }, xs),
}

fn within_writes(writes, h) = any({ w => w == h }, writes) || match graph_parent_of(h) {
  Some(p) => within_writes(writes, p),
  None => false,
}

// The handler declaration a node stands in, read up the parent edges.
fn owning_handler(h) = match graph_parent_of(h) {
  Some(p) => match graph_node_body(p) {
    NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => Some(p),
    NModule(_) => None,
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => owning_handler(p),
  },
  None => None,
}

// A call whose callee writes memory in place answers what it stored there as
// much as what its tails compute, and the tails cannot show the stores, so
// it is read by its signature — beside the zero word: a slot nothing wrote
// holds it (`make_list`'s, which such a callee may place in what it hands
// back), and it is the one value of a type the callee was never told that
// the substrate can make. A callee that writes nothing in place is read
// through its body (`entered_leaves`).
fn answer_by_signature(h, callee, d, path) = if writes_in_place(d) {
  match signature_leaves(h, callee, path) {
    Some(leaves) => Some(leaves ++ [LMay(LPoint(LVInt(0)))]),
    None => None,
  }
} else {
  None
}

fn call_part_by_signature(h, callee, path) = match graph_ref_decl(callee) {
  Some(d) => answer_by_signature(h, callee, d, path),
  None => None,
}

// Whether a declaration writes memory older than its frame, as its store
// claim says: a parameter's, a capture's, or memory it cannot name.
fn writes_in_place(d) = match graph_store_claim_of(d) {
  Some(StoreClaim(s)) => len(s.mutated) > 0 || len(s.captures) > 0 || s.beyond || s.opaque,
  None => false,
}

// A generic call's part is one of the values its signature says an argument
// handed in at the variable the part stands at — parametricity: the callee
// cannot make a value of a type it was never told but the zero word. Which
// value is not in sight, so each is one the call MAY answer. A callee whose
// row carries a value type — an effect's payload — could take one from a
// perform, and answers nothing here.
fn signature_leaves(h, callee, path) = match generic_signature(callee) {
  Some(sig) => match sig {
    (qs, dps, dret) => match var_along(qs, dret, path) {
      Some(at) => match at {
        (q, rest) => match graph_product_at(h) {
          ProductOf(slots, _, CallApplied) => Some(scheme_occurrences(qs, dps) |> filter(occ_source_of(q, ??)) |> flat_map(occurrence_leaves(slots, rest, ??)) |> map(LMay)),
          ProductOf(_, _, CallSuspended) | NoProduct => None,
        },
      },
      None => None,
    },
  },
  None => None,
}

fn generic_signature(callee) = match graph_ref_decl(callee) {
  Some(d) => match graph_published(d) {
    Some((Frozen(qs, TFun(dps, dret, drow)), _, FnScheme)) => if len(qs) > 0 && !row_carries_payload(drow) { Some((qs, dps, dret)) } else { None },
    Some(_) | None => None,
  },
  None => None,
}

fn row_carries_payload(row) = match row {
  EfRow(present, _, _) => any(name_carries_type, present),
}

fn name_carries_type(n) = match n {
  EParameterized(_, args) => any(arg_is_type, args),
  ENamed(_) | EPure => false,
}

fn arg_is_type(a) = match a {
  EAType(_) => true,
  EAInt(_) | EAFloat(_) | EAString(_) | EAEffect(_) | EACon(_) | EANode(_) | EAVar(_) => false,
}

// The quantified variable a path into a type reaches, with the rest of the
// path past it.
fn var_along(qs, t, path) = match bare_var(qs, t) {
  Some(q) => Some((q, path)),
  None => match path {
    [step, ...rest] => match contract_part(t, step) {
      Some(pt) => var_along(qs, pt, rest),
      None => None,
    },
    [] => None,
  },
}

// The values one source occurrence hands in, at the rest of the path: an
// argument's part, or what a function argument answers, read off the
// contract its type states at that path of its result.
fn occurrence_leaves(slots, rest, occ) = match occ {
  Occ(_, i, opath, end, sub) => match nth_handle(slots, i) {
    Some([a]) => match end {
      AtValue => path_leaves(a, opath ++ rest),
      AtResult => result_contract_leaves(a, opath, sub ++ rest),
      AtParam(_) => [],
    },
    None | Some(_) => leaves_unknown,
  },
}

fn result_contract_leaves(a, fpath, sub) = match graph_chase(a) {
  GNode(NBound(t), _) => match contract_at(t, fpath) {
    Some(ft) => match ft {
      TFun(_, ret, _) => match contract_at(ret, sub) {
        Some(c) => if ty_states_refinement(c) { [LPost(c)] } else { leaves_unknown },
        None => leaves_unknown,
      },
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
      | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => leaves_unknown,
    },
    None => leaves_unknown,
  },
  GNode(_, _) => leaves_unknown,
}

// Where a quantified variable stands in a declared signature: in an
// argument's value at a path, or at a function argument's position or
// result — that function found at a path in the argument — at a path
// inside that end.
type FnEnd = AtValue | AtParam(Int) | AtResult

type Occurrence = Occ(Int, Int, [PartStep], FnEnd, [PartStep])

fn scheme_occurrences(qs, dps) =
  dps |> enumerate |> flat_map({ (i, dp) => value_occurrences(qs, i, param_ty(dp), []) })

fn value_occurrences(qs, i, t, path) = match t {
  TVar(v) => if any({ q => q == v }, qs) { [Occ(v, i, path, AtValue, [])] } else { [] },
  TList(e) => value_occurrences(qs, i, e, path ++ [PartElem]),
  TTuple(es) => es |> enumerate |> flat_map({ (k, e) => value_occurrences(qs, i, e, path ++ [PartIndex(k)]) }),
  TRecord(fs) => fs |> flat_map({ (n, ft) => value_occurrences(qs, i, ft, path ++ [PartField(n)]) }),
  TRecordOpen(fs, _) => fs |> flat_map({ (n, ft) => value_occurrences(qs, i, ft, path ++ [PartField(n)]) }),
  TFun(ps, r, _) => {
    let at_params =
      ps |> enumerate |> flat_map({ (j, p) => end_occurrences(qs, i, path, AtParam(j), param_ty(p), []) })
    at_params ++ end_occurrences(qs, i, path, AtResult, r, [])
  },
  TName(_, args) => args |> enumerate |> flat_map(type_arg_values(qs, i, path, ??)),
  TAlias(_, inner) => value_occurrences(qs, i, inner, path),
  TRefined(base, _) => value_occurrences(qs, i, base, path),
  TReprPin(_, base) => value_occurrences(qs, i, base, path),
  TInt | TFloat | TUnit | TByte | TAddr | TCont(_, _, _, _) | TValue(_) => [],
}

// A nominal type is read as a container of its type arguments' values: the
// variable standing at argument `k` is reached at `PartTypeArg(k)`, whose
// parts are the fields of a construction in sight (`built_part`).
// `Option(a)` went unread until H4, so the function `Some(inv)` carries
// reached no callback, and `opt_apply({ g => g(0) }, Some(inv))` over a
// generic `opt_apply(f, o)` checked clean under `!Trap` and trapped.
fn type_arg_values(qs, i, path, slot) = match slot {
  (k, a) => value_occurrences(qs, i, a, path ++ [PartTypeArg(k)]),
}

// One end of a function argument: a function nested inside it is not read
// (Hβ.verify.channel-depth-one).
fn end_occurrences(qs, i, path, end, t, sub) = match t {
  TVar(v) => if any({ q => q == v }, qs) { [Occ(v, i, path, end, sub)] } else { [] },
  TList(e) => end_occurrences(qs, i, path, end, e, sub ++ [PartElem]),
  TTuple(es) => es |> enumerate |> flat_map({ (k, e) => end_occurrences(qs, i, path, end, e, sub ++ [PartIndex(k)]) }),
  TRecord(fs) => fs |> flat_map({ (n, ft) => end_occurrences(qs, i, path, end, ft, sub ++ [PartField(n)]) }),
  TRecordOpen(fs, _) => fs |> flat_map({ (n, ft) => end_occurrences(qs, i, path, end, ft, sub ++ [PartField(n)]) }),
  TName(_, args) => args |> enumerate |> flat_map(type_arg_ends(qs, i, path, end, sub, ??)),
  TAlias(_, inner) => end_occurrences(qs, i, path, end, inner, sub),
  TRefined(base, _) => end_occurrences(qs, i, path, end, base, sub),
  TReprPin(_, base) => end_occurrences(qs, i, path, end, base, sub),
  TInt | TFloat | TUnit | TByte | TAddr | TFun(_, _, _) | TCont(_, _, _, _) | TValue(_) => [],
}

fn type_arg_ends(qs, i, path, end, sub, slot) = match slot {
  (k, a) => end_occurrences(qs, i, path, end, a, sub ++ [PartTypeArg(k)]),
}

fn occ_source_of(q, occ) = match occ {
  Occ(v, _, _, end, _) => if v == q { is_source_end(end) } else { false },
}

fn is_source_end(end) = match end {
  AtValue => true,
  AtResult => true,
  AtParam(_) => false,
}

fn bare_var(qs, t) = match t {
  TVar(v) => if any({ q => q == v }, qs) { Some(v) } else { None },
  TAlias(_, inner) => bare_var(qs, inner),
  TRefined(base, _) => bare_var(qs, base),
  TReprPin(_, base) => bare_var(qs, base),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => None,
}

fn leaf_carries(aname: String, leaf) = match leaf {
  LParam(_, c) => ty_names_alias(c, aname),
  LPost(c) => ty_names_alias(c, aname),
  LClaimed(c, beneath) => ty_names_alias(c, aname) || leaf_carries(aname, beneath),
  LMay(beneath) => leaf_carries(aname, beneath),
  LPoint(_) | LSum(_) | LLength | LRet(_) | LBuilt(_) | LUnknown => false,
}

fn ty_names_alias(ty, aname: String) = match ty {
  TAlias(n, inner) => n == aname || ty_names_alias(inner, aname),
  TRefined(base, _) => ty_names_alias(base, aname),
  TReprPin(_, base) => ty_names_alias(base, aname),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
  | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => false,
}

// What a held claim STANDS ON, for the row it guards: the parameters whose
// preconditions it leaned on (the guard travels to them), and whether it
// leaned on anything that is not a row fact — a postcondition still owed,
// or the Add fold — in which case the guard is paid where the claim stands.
fn leaves_params(leaves) = leaves |> flat_map(leaf_param)

fn leaf_param(leaf) = match leaf {
  LParam(b, _) => [b],
  LClaimed(_, beneath) => leaf_param(beneath),
  LMay(beneath) => leaf_param(beneath),
  LPoint(_) | LPost(_) | LSum(_) | LLength | LRet(_) | LBuilt(_) | LUnknown => [],
}

fn leaves_unproven(leaves) = leaves |> any(leaf_unproven)

// A let's claim is owed where the let stands, and nothing says the claim
// decided here did not stand on it.
fn leaf_unproven(leaf) = match leaf {
  LPost(_) => true,
  LSum(_) => true,
  LClaimed(_, _) => true,
  LMay(beneath) => leaf_unproven(beneath),
  LPoint(_) | LParam(_, _) | LLength | LRet(_) | LBuilt(_) | LUnknown => false,
}

// A LABEL is an op named in a refinement over `self`: under `effect Trust {
// untrusted(v: String) -> Bool }`, `type Trusted = String where
// !untrusted(self)` demands of a value that nothing untrusted reaches it. An
// op has no body to read, so the medium gives the label its meaning: it holds
// of every value a SOURCE stating it can influence — through what the value
// is built from, the branches it is computed under, the calls it is made
// under, the statements before it that can unwind past it and the memory it
// is read out of. A source is a contract that states the label: a declared
// return, a parameter's annotation, a field's, an op's declared return. A
// declared return's label is the declaration's own statement, never a claim
// of its body (`ty_without_labels`), so a function whose return states the
// label's negation ENDORSES what it answers.
//
// What can reach a value is a fact of the whole program, so a claim naming a
// label is decided once the program is judged (`flow_settle`): the judgment
// hands each one to the ledger's flows, and every judgment of the program
// decides them all again. A claim stands on what the claim's own function is
// handed and on whether that function runs; both are DEMANDS, owed at every
// call of it, the function's own calls among them.
//
// The op a predicate's atom names over `self` — `untrusted(self)` — read
// along the callee's edge to its declaration; None for any other atom.
fn label_of(h) = match graph_node_body(h) {
  NExpr(CallExpr(callee, args)) => match args {
    [arg] => if is_self_node(arg) { op_declared_at(callee) } else { None },
    _ => None,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

fn op_declared_at(callee) = match graph_ref_decl(callee) {
  Some(d) => match graph_published(d) {
    Some((_, _, EffectOpScheme(_, _, _))) => Some(d),
    None | Some(_) => None,
  },
  None => None,
}

fn pred_names_label(pred) = match pred {
  PBoolNode(h) => label_of(h) != None,
  PNot(inner) => pred_names_label(inner),
  PAnd(a, b) => pred_names_label(a) || pred_names_label(b),
  POr(a, b) => pred_names_label(a) || pred_names_label(b),
  PWithSelf(_, inner) => pred_names_label(inner),
  PTrue | PCompare(_, _, _) | PPatternMatch(_, _) | PTotalDiv(_, _, _) | PProvides(_)
  | PInBounds(_, _) => false,
}

// What a contract states of a label at the value it types: Some(true) that
// the label holds, Some(false) that it does not, None neither. A conjunction
// states what either side states; a disjunction states the label where either
// side might hold it, and its absence only where both sides state that.
fn ty_states(t, label) = match t {
  TAlias(_, inner) => ty_states(inner, label),
  TRefined(base, pred) => match pred_states(pred, label) {
    Some(s) => Some(s),
    None => ty_states(base, label),
  },
  TReprPin(_, base) => ty_states(base, label),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
  | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => None,
}

fn pred_states(pred, label) = match pred {
  PBoolNode(h) => if label_of(h) == Some(label) { Some(true) } else { None },
  PNot(PBoolNode(h)) => if label_of(h) == Some(label) { Some(false) } else { None },
  PAnd(a, b) => match pred_states(a, label) {
    Some(s) => Some(s),
    None => pred_states(b, label),
  },
  POr(a, b) => either_states(pred_states(a, label), pred_states(b, label)),
  PWithSelf(_, inner) => pred_states(inner, label),
  PTrue | PCompare(_, _, _) | PNot(_) | PPatternMatch(_, _) | PTotalDiv(_, _, _) | PProvides(_)
  | PInBounds(_, _) => None,
}

fn either_states(a, b) = match a {
  Some(true) => Some(true),
  Some(false) => match b {
    Some(true) => Some(true),
    Some(false) => Some(false),
    None => None,
  },
  None => match b {
    Some(true) => Some(true),
    None | Some(_) => None,
  },
}

// Whether a contract states the label of the value or of any part of it: a
// list of untrusted strings holds untrusted values.
fn ty_carries_label(t, label) = match ty_states(t, label) {
  Some(s) => s,
  None => match t {
    TAlias(_, inner) => ty_carries_label(inner, label),
    TRefined(base, _) => ty_carries_label(base, label),
    TReprPin(_, base) => ty_carries_label(base, label),
    TList(e) => ty_carries_label(e, label),
    TTuple(es) => any(ty_carries_label(??, label), es),
    TRecord(fs) => any({ (_, ft) => ty_carries_label(ft, label) }, fs),
    TRecordOpen(fs, _) => any({ (_, ft) => ty_carries_label(ft, label) }, fs),
    TName(_, args) => any(ty_carries_label(??, label), args),
    TInt | TFloat | TUnit | TByte | TAddr | TFun(_, _, _) | TVar(_) | TCont(_, _, _, _) | TValue(_) => false,
  },
}

// A contract with its labels taken out: what a declaration's body owes of
// its declared return, and an arm of what its op declares it answers. The
// labels are the declaration's statement — a source where they hold, an
// endorsement where they are negated — and never a claim of the body.
fn ty_without_labels(t) = match t {
  TAlias(n, inner) => TAlias(n, ty_without_labels(inner)),
  TRefined(base, pred) => TRefined(ty_without_labels(base), pred_without_labels(pred)),
  TReprPin(w, base) => TReprPin(w, ty_without_labels(base)),
  TList(e) => TList(ty_without_labels(e)),
  TTuple(es) => TTuple(map(ty_without_labels, es)),
  TRecord(fs) => TRecord(map({ (n, ft) => (n, ty_without_labels(ft)) }, fs)),
  TRecordOpen(fs, r) => TRecordOpen(map({ (n, ft) => (n, ty_without_labels(ft)) }, fs), r),
  TName(n, args) => TName(n, map(ty_without_labels, args)),
  TInt | TFloat | TUnit | TByte | TAddr | TFun(_, _, _) | TVar(_) | TCont(_, _, _, _) | TValue(_) => t,
}

fn pred_without_labels(pred) = if pred_names_label(pred) {
  match pred {
    PAnd(a, b) => PAnd(pred_without_labels(a), pred_without_labels(b)),
    PWithSelf(s, inner) => PWithSelf(s, pred_without_labels(inner)),
    PTrue | PCompare(_, _, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
    | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _) => PTrue,
  }
} else {
  pred
}

// The conjuncts of a predicate that name a label.
fn pred_only_labels(pred) = if pred_names_label(pred) {
  match pred {
    PAnd(a, b) => PAnd(pred_only_labels(a), pred_only_labels(b)),
    PWithSelf(s, inner) => PWithSelf(s, pred_only_labels(inner)),
    PTrue | PCompare(_, _, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
    | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _) => pred,
  }
} else {
  PTrue
}

fn ty_names_a_label(t) = match t {
  TAlias(_, inner) => ty_names_a_label(inner),
  TRefined(base, pred) => pred_names_label(pred) || ty_names_a_label(base),
  TReprPin(_, base) => ty_names_a_label(base),
  TList(e) => ty_names_a_label(e),
  TTuple(es) => any(ty_names_a_label, es),
  TRecord(fs) => any({ (_, ft) => ty_names_a_label(ft) }, fs),
  TRecordOpen(fs, _) => any({ (_, ft) => ty_names_a_label(ft) }, fs),
  TName(_, args) => any(ty_names_a_label, args),
  TInt | TFloat | TUnit | TByte | TAddr | TFun(_, _, _) | TVar(_) | TCont(_, _, _, _) | TValue(_) => false,
}

// What brings a label to a value: a source stating it, carried as the chain
// from where the walk met it; what the call being read hands a parameter of
// the function whose summary is being read, which each call of it supplies;
// a declared function's parameter whose contract says nothing of it, which
// every call of the function hands it; the reach of a declared function,
// which the calls of it decide; or a node the walk cannot read.
type FlowAtom = FaSource(Reason) | FaArg(Int) | FaParam(Int) | FaReach(Int) | FaOpen(Int)

// The memory a value may be: the binders and the literals it was built as,
// or any memory at all.
type Roots = RootsAt([Int]) | RootsAny

// The nodes a walk has met, each once: a value, a reach, a declaration
// whose code it asked whether a statement unwinds. A walk carries, beside
// them, a context: the label and the name its author wrote it by, the
// declaration whose summary it reads (its parameters are what each call
// hands them), and every store the program makes into memory.
effect FlowWalked {
  value_met(node: Int) -> Bool
  reach_met(node: Int) -> Bool
  decl_met(decl: Int) -> Bool
}

handler flow_walk with values = [], reaches = [], decls = [] {
  value_met(h) => if any({ v => v == h }, values) {
    resume(true)
  } else {
    resume(false) with values = push(values, h)
  },
  reach_met(h) => if any({ v => v == h }, reaches) {
    resume(true)
  } else {
    resume(false) with reaches = push(reaches, h)
  },
  decl_met(d) => if any({ v => v == d }, decls) { resume(true) } else { resume(false) with decls = push(decls, d) },
}

fn flow_source(ctx, site, what: String) = FaSource(LabelEnters(ctx.name, site, Inferred(what)))

// What a declared function does with the label, each read once per settle and
// stated over its own parameters: what it answers, what it hands the function
// it is given at a slot at each position, what decides whether it applies
// that function, and what it stores into the memory it is handed at a slot.
// A call reads a summary with its own arguments standing for the parameters.
type FlowFact
  = FfAnswer
  | FfHand(Int, Int)
  | FfApply(Int)
  | FfWrite(Int)
  | FfHanded(Int)
  | FfReach
  // a handler's reading at one install of it: what it hands the function
  // in its configuration at a slot at a position, and whether it applies it
  | FfHandAt(Int, Int, Int)
  | FfApplyAt(Int, Int)
  // what a function's performs of an op hand at a position, and what
  // decides whether it performs it
  | FfPerform(Int, Int)
  | FfPerformReach(Int)

// The summaries read so far, each with the round it was read in; the ones
// being read now; the round; whether this round grew any; and every store the
// program makes into memory, gathered once for the settle.
effect FlowSummaries {
  facts_stores() -> [{by: StoreBy, call: Int, local: Bool, owner: Int, roots: Roots}]
  fact_known(decl: Int, label: Int, fact: FlowFact) -> Option(([FlowAtom], Int))
  fact_keep(decl: Int, label: Int, fact: FlowFact, atoms: [FlowAtom])
  fact_reading(decl: Int, label: Int, fact: FlowFact) -> Bool
  fact_enter(decl: Int, label: Int, fact: FlowFact)
  fact_leave()
  facts_round() -> Int
  facts_grew() -> Bool
}

handler flow_summaries(stores) with memo = wmap_new(256), reading = [], round = 0, grew = false {
  facts_stores() => resume(stores),
  fact_known(d, label, fact) => resume(fact_found(wmap_get_all(memo, d), label, fact)),
  fact_keep(d, label, fact, atoms) => resume() with memo = wmap_add(memo, d, (label, fact, atoms, round)), grew = grew || len(atoms) > len(known_atoms(fact_found(wmap_get_all(memo, d), label, fact))),
  fact_reading(d, label, fact) => resume(any({ r => r == (d, label, fact) }, reading)),
  fact_enter(d, label, fact) => resume() with reading = push(reading, (d, label, fact)),
  fact_leave() => resume() with reading = drop_last(reading),
  facts_round() => resume(round),
  facts_grew() => resume(grew) with grew = false, round = round + 1,
}

fn fact_found(entries, label, fact) = match find({ (l, f, _, _) => l == label && f == fact }, entries) {
  Some((_, _, atoms, r)) => Some((atoms, r)),
  None => None,
}

fn known_atoms(known) = match known {
  Some((atoms, _)) => atoms,
  None => [],
}

// A summary, read at most once a round. A recursion through one being read
// reads what the round before left, and the rounds repeat until none grows —
// the least fixed point.
fn flow_fact(ctx, d, fact) = {
  let known = fact_known(d, ctx.label, fact)
  let prior = known_atoms(known)
  if read_this_round(known, facts_round()) || fact_reading(d, ctx.label, fact) {
    prior
  } else {
    fact_enter(d, ctx.label, fact)
    let atoms = atoms_union(prior, read_fact(ctx, d, fact))
    fact_leave()
    fact_keep(d, ctx.label, fact, atoms)
    atoms
  }
}

fn read_this_round(known, round) = match known {
  Some((_, r)) => r == round,
  None => false,
}

// A reading over summaries, repeated until no summary grows.
fn until_settled(read, x) = {
  let v = read(x)
  if facts_grew() { until_settled(read, x) } else { v }
}

fn read_fact(ctx, d, fact) = {
  let inside = ctx_at(ctx, 0, d)
  let outside = ctx_at(ctx, 0, 0)
  match fact {
    FfAnswer => answers_of(inside, d),
    FfHand(k, i) => at_param_uses(d, k, hand_use(inside, i, ??)),
    FfApply(k) => at_param_uses(d, k, apply_use(inside, ??)),
    FfWrite(k) => writes_of(inside, d, k),
    FfHanded(k) => handed_of(outside, d, k),
    FfReach => reached_of(outside, d),
    FfHandAt(t, k, i) => at_param_uses(d, k, hand_use(ctx_at(ctx, t, owning_fn(t)), i, ??)),
    FfApplyAt(t, k) => at_param_uses(d, k, apply_use(ctx_at(ctx, t, owning_fn(t)), ??)),
    FfPerform(op, i) => answers_body(d) |> flat_map(performs_in(inside, ??, op, i)),
    FfPerformReach(op) => answers_body(d) |> flat_map(perform_reach_in(inside, ??, op)),
  } ~> flow_walk
}

// The walk's context at an install of a handler and in the summary of a
// declaration.
fn ctx_at(ctx, install, self) = {install, label: ctx.label, name: ctx.name, self}

fn atoms_union(prior, more) = more |> fold(prior, atom_add)

fn atom_add(acc, a) = if any(atom_same(a, ??), acc) { acc } else { push(acc, a) }

fn atom_same(a, b) = match a {
  FaSource(ca) => match b {
    FaSource(cb) => source_site(ca) == source_site(cb),
    FaArg(_) | FaParam(_) | FaReach(_) | FaOpen(_) => false,
  },
  FaArg(x) => match b {
    FaArg(y) => x == y,
    FaSource(_) | FaParam(_) | FaReach(_) | FaOpen(_) => false,
  },
  FaParam(x) => match b {
    FaParam(y) => x == y,
    FaSource(_) | FaArg(_) | FaReach(_) | FaOpen(_) => false,
  },
  FaReach(x) => match b {
    FaReach(y) => x == y,
    FaSource(_) | FaArg(_) | FaParam(_) | FaOpen(_) => false,
  },
  FaOpen(x) => match b {
    FaOpen(y) => x == y,
    FaSource(_) | FaArg(_) | FaParam(_) | FaReach(_) => false,
  },
}

fn source_site(chain) = match chain {
  LabelEnters(_, site, _) => site,
  Declared(_) | Inferred(_) | Fresh(_) | OpConstraint(_, _, _) | VarLookup(_, _) | FnReturn(_, _)
  | FnParam(_, _, _) | MatchBranch(_, _) | ListElement(_) | IfBranch(_) | LetBinding(_, _)
  | Unified(_, _) | Instantiation(_, _) | Placeholder(_) | MissingVar(_) | Refinement(_, _)
  | Located(_, _) | InferredCallReturn(_, _) | InferredPipeResult(_, _) | DefaultReason(_, _)
  | Accepted(_, _, _) | EffectEnters(_, _, _) | ChainInstall(_, _) | StateBinding(_, _) => 0,
}

// What a declared function answers: its body's value.
fn answers_of(ctx, d) = answers_body(d) |> flat_map(value_flow(ctx, ??))

fn answers_body(d) = match graph_node_body(d) {
  NStmt(FnStmt(_, _, _, _, body)) => [body],
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// What the performs of an op in code hand at a position: each perform's
// argument, what a declared function the code calls performs, and — where it
// calls a function value, whose code is out of sight — that call. A nested
// install that answers the op absorbs the performs inside it, and a nested
// declaration performs where it is called.
fn performs_in(ctx, h, op, i) = match graph_node_body(h) {
  NExpr(CallExpr(callee, _)) => call_performs(ctx, h, callee, op, i) ++ flat_map(performs_in(ctx, ??, op, i), body_child_handles(graph_node_body(h))),
  NExpr(PipeExpr(PTee, body, right)) => if install_serves(right, op) { [] } else { performs_in(ctx, body, op, i) } ++ performs_in(ctx, right, op, i),
  NExpr(PipeExpr(PForward, left, stage)) => stage_performs(ctx, h, stage, op, i) ++ performs_in(ctx, left, op, i) ++ performs_in(ctx, stage, op, i),
  NStmt(FnStmt(_, _, _, _, _)) => [],
  body @ (
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_)
  ) => flat_map(performs_in(ctx, ??, op, i), body_child_handles(body)),
}

fn call_performs(ctx, call, callee, op, i) = match graph_node_body(callee) {
  NExpr(VarRef(_)) => if ref_is_constructor(callee) {
    []
  } else {
    match graph_ref_decl(callee) {
      Some(d) => if d == op {
        applied_arg_flow(ctx, i, call)
      } else {
        match graph_node_body(d) {
          NStmt(FnStmt(_, _, _, _, _)) => subst_at(ctx, call, d, flow_fact(ctx, d, FfPerform(op, i))),
          NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
          | NRow(_) | NParam(_) => if binder_read_by(callee) == None { [] } else { [FaOpen(call)] },
        }
      },
      None => [FaOpen(call)],
    }
  },
  NExpr(LambdaExpr(_, _)) => [],
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [FaOpen(call)],
}

fn stage_performs(ctx, pipe, stage, op, i) = match stage_application(stage, []) {
  Some((callee, _)) => call_performs(ctx, pipe, callee, op, i),
  None => [],
}

// What decides whether code performs an op: whatever decides whether each
// perform, and each call that performs it, runs.
fn perform_reach_in(ctx, h, op) = match graph_node_body(h) {
  NExpr(CallExpr(callee, _)) => call_perform_reach(ctx, h, callee, op) ++ flat_map(perform_reach_in(ctx, ??, op), body_child_handles(graph_node_body(h))),
  NExpr(PipeExpr(PTee, body, right)) => if install_serves(right, op) { [] } else { perform_reach_in(ctx, body, op) } ++ perform_reach_in(ctx, right, op),
  NExpr(PipeExpr(PForward, left, stage)) => match stage_application(stage, []) {
    Some((callee, _)) => call_perform_reach(ctx, h, callee, op),
    None => [],
  } ++ perform_reach_in(ctx, left, op) ++ perform_reach_in(ctx, stage, op),
  NStmt(FnStmt(_, _, _, _, _)) => [],
  body @ (
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_)
  ) => flat_map(perform_reach_in(ctx, ??, op), body_child_handles(body)),
}

fn call_perform_reach(ctx, call, callee, op) = match graph_node_body(callee) {
  NExpr(VarRef(_)) => match graph_ref_decl(callee) {
    Some(d) => if d == op {
      reach_flow(ctx, call)
    } else {
      match graph_node_body(d) {
        NStmt(FnStmt(_, _, _, _, _)) => reach_flow(ctx, call) ++ subst_at(ctx, call, d, flow_fact(ctx, d, FfPerformReach(op))),
        NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
        | NRow(_) | NParam(_) => if binder_read_by(callee) == None { [] } else { reach_flow(ctx, call) ++ [FaOpen(call)] },
      }
    },
    None => [FaOpen(call)],
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// Whether an install's handler answers an op.
fn install_serves(right, op) = match tee_arms(right) {
  Some(arms) => any({ arm => graph_ref_decl(arm.op) == Some(op) }, arms),
  None => false,
}

// The install a handler applied to its configuration stands in, and whether
// the walk reads a handler at one.
fn install_of(call) = match graph_parent_of(call) {
  Some(t) => match graph_node_body(t) {
    NExpr(PipeExpr(PTee, _, right)) => if right == call { Some(t) } else { None },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => None,
  },
  None => None,
}

fn installed_here(ctx, hd) = ctx.install != 0 && match graph_node_body(ctx.install) {
  NExpr(PipeExpr(PTee, _, right)) => tee_handler_decl(right) == Some(hd),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => false,
}

fn install_body(t) = match graph_node_body(t) {
  NExpr(PipeExpr(PTee, body, _)) => [body],
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// What a declared function does with its parameter at a slot, read at each
// use of the name it binds; a parameter it takes apart holds the function it
// is handed among parts the walk does not follow, so what it does there is
// out of sight.
fn at_param_uses(d, k, read) = {
  let params = decl_params(d)
  if k < len(params) {
    let p = list_index(params, k)
    match graph_node_body(p) {
      NParam(fields) => match graph_node_body(fields.pat) {
        NPat(PVar(_)) => graph_refs_of(fields.pat) |> flat_map(read),
        NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
        | NRow(_) | NParam(_) => [FaOpen(p)],
      },
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) => [FaOpen(p)],
    }
  } else {
    []
  }
}

// A declaration's parameters: a function's, or a handler's configuration,
// which its install hands it.
fn decl_params(d) = match graph_node_body(d) {
  NStmt(FnStmt(_, params, _, _, _)) => params,
  NStmt(HandlerDeclStmt(_, _, config, _, _, _)) => config,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// The declaration a call applies whose summaries the walk reads: a declared
// function, or a handler applied to its configuration.
fn applied_summarized(call) = match applied_decl(call) {
  Some(d) => Some(d),
  None => match graph_node_body(call) {
    NExpr(CallExpr(callee, _)) => match graph_ref_decl(callee) {
      Some(d) => match graph_node_body(d) {
        NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => Some(d),
        NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
        | NRow(_) | NParam(_) => None,
      },
      None => None,
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => None,
  },
}

// What a function parameter is handed at one of its uses: the argument at the
// position where the use is the callee, what the function it is passed to
// hands it there, the piped value where it is a stage; anywhere else what it
// is handed is out of sight.
fn hand_use(ctx, i, r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(callee, _)) => if callee == r { applied_arg_flow(ctx, i, q) } else { passed_on(ctx, q, r, FfHand(0, i)) },
    NExpr(PipeExpr(PForward, left, stage)) => if stage == r { if i == 0 { value_flow(ctx, left) } else { [] } } else { [FaOpen(r)] },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(r)],
  },
  None => [FaOpen(r)],
}

// What decides whether a function parameter is applied at one of its uses.
fn apply_use(ctx, r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(callee, _)) => if callee == r {
      reach_flow(ctx, q)
    } else {
      reach_flow(ctx, q) ++ passed_on(ctx, q, r, FfApply(0))
    },
    NExpr(PipeExpr(PForward, _, stage)) => if stage == r { reach_flow(ctx, q) } else { [FaOpen(r)] },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(r)],
  },
  None => [FaOpen(r)],
}

// A function parameter handed on to a declared function: that function's
// summary at the slot it is handed in, read at the call. The fact names the
// slot it is read at; its own slot is the call's. A handler applied to its
// configuration where it is installed is read at that install, its arms
// served by the performs of the body it governs.
fn passed_on(ctx, call, r, fact) = match applied_summarized(call) {
  Some(e) => match find_slot(r, applied_args(call)) {
    Some(m) => match install_of(call) {
      Some(t) => from_install(ctx, t, flow_fact(ctx, e, at_install(fact, t, m))),
      None => subst_at(ctx, call, e, flow_fact(ctx, e, at_slot(fact, m))),
    },
    None => [FaOpen(r)],
  },
  None => [FaOpen(r)],
}

fn at_slot(fact, m) = match fact {
  FfHand(_, i) => FfHand(m, i),
  FfApply(_) => FfApply(m),
  FfWrite(_) => FfWrite(m),
  FfHanded(_) => FfHanded(m),
  FfHandAt(t, _, i) => FfHandAt(t, m, i),
  FfApplyAt(t, _) => FfApplyAt(t, m),
  FfAnswer | FfReach | FfPerform(_, _) | FfPerformReach(_) => fact,
}

fn at_install(fact, t, m) = match fact {
  FfHand(_, i) => FfHandAt(t, m, i),
  FfApply(_) => FfApplyAt(t, m),
  FfWrite(_) | FfHanded(_) | FfHandAt(_, _, _) | FfApplyAt(_, _) | FfAnswer | FfReach
  | FfPerform(_, _) | FfPerformReach(_) => at_slot(fact, m),
}

// A reading at an install is stated over the parameters of the function the
// install stands in: its own where that is the function being read, and what
// every call of that function hands them anywhere else.
fn from_install(ctx, t, atoms) =
  if ctx.self == owning_fn(t) { atoms } else { map(as_demand, atoms) }

fn find_slot(h, nodes) = match find({ (_, n) => n == h }, enumerate(nodes)) {
  Some((i, _)) => Some(i),
  None => None,
}

// What a declared function stores into the memory it is handed at a slot:
// every store its own code makes into that memory.
fn writes_of(ctx, d, k) = match graph_node_body(d) {
  NStmt(FnStmt(_, params, _, _, body)) => if k < len(params) && writes_param(d, k) {
    let p = list_index(params, k)
    stores_in(d, body) |> filter({ s => roots_hold(s.roots, p) }) |> flat_map(write_atoms(ctx, ??))
  } else {
    []
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

fn roots_hold(roots, p) = match roots {
  RootsAt(xs) => any({ x => x == p }, xs),
  RootsAny => false,
}

// A summary read at a call: what the summary says each call hands a
// parameter is what this call hands it.
fn subst_at(ctx, call, d, atoms) = flat_map(subst_atom(ctx, call, d, ??), atoms)

fn subst_atom(ctx, call, d, a) = match a {
  FaArg(b) => if graph_parent_of(b) == Some(d) {
    match nth_handle(applied_args(call), param_slot(d, b)) {
      Some(found) => flat_map(value_flow(ctx, ??), found),
      None => [FaOpen(call)],
    }
  } else {
    [FaParam(b)]
  },
  FaSource(_) | FaParam(_) | FaReach(_) | FaOpen(_) => [a],
}

fn param_slot(d, b) = match graph_node_body(d) {
  NStmt(FnStmt(_, params, _, _, _)) => node_index(b, params),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => 0,
}

// What every call of a function hands its parameters, where a summary's
// arguments are read beyond the call that hands them.
fn as_demand(a) = match a {
  FaArg(b) => FaParam(b),
  FaSource(_) | FaParam(_) | FaReach(_) | FaOpen(_) => a,
}

// Everything that can bring the label to the value at `h`: what it is built
// from, read along its edges, and what decides which value it is.
fn value_flow(ctx, h) = if value_met(h) { [] } else { value_flow_at(ctx, h) }

fn value_flow_at(ctx, h) = match node_const_at(h, NoSelf) {
  Some(_) => [],
  None => match graph_node_body(h) {
    NExpr(e) => expr_flow(ctx, h, e),
    NStmt(LetStmt(_, value, _)) => value_flow(ctx, value),
    NStmt(ExprStmt(x)) => value_flow(ctx, x),
    NHole(_) => [FaOpen(h)],
    NStmt(_) | NPat(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => [],
  },
}

fn expr_flow(ctx, h, e) = match e {
  VarRef(_) => ref_flow(ctx, h),
  CallExpr(callee, args) => call_flow(ctx, h, callee, args),
  LabeledArg(_, v) => value_flow(ctx, v),
  PipeExpr(kind, left, right) => pipe_flow(ctx, h, kind, left, right),
  FanoutExpr(branches) => flat_map(value_flow(ctx, ??), branches),
  IfExpr(c, t, f) => value_flow(ctx, c) ++ value_flow(ctx, t) ++ value_flow(ctx, f),
  MatchExpr(scrut, arms) => dispatch_flow(ctx, scrut, arms) ++ flat_map(arm_body_flow(ctx, ??), arms),
  BlockExpr(stmts, final) => value_flow(ctx, final) ++ flat_map(unwind_flow(ctx, ??), stmts),
  BinOpExpr(_, l, r) => value_flow(ctx, l) ++ value_flow(ctx, r),
  UnaryOpExpr(_, x) => value_flow(ctx, x),
  MakeStringExpr(frags) => flat_map(value_flow(ctx, ??), frags),
  ShowExpr(x) => value_flow(ctx, x),
  MakeListExpr(xs) => flat_map(value_flow(ctx, ??), xs) ++ stores_flow(ctx, h, RootsAt([h])),
  MakeTupleExpr(xs) => flat_map(value_flow(ctx, ??), xs),
  MakeRecordExpr(fields) => flat_map(field_flow(ctx, ??), fields),
  NamedRecordExpr(head, fields) => flat_map(named_field_flow(ctx, head, ??), fields),
  RecordUpdateExpr(base, fields) => value_flow(ctx, base) ++ flat_map(field_flow(ctx, ??), fields),
  FieldExpr(recv, fname) => part_flow(ctx, recv, PartField(fname)),
  IndexExpr(recv, idx) => part_flow(ctx, recv, index_step(recv, idx)) ++ value_flow(ctx, idx),
  LambdaExpr(_, body) => value_flow(ctx, body),
  ResumeExpr(_, _) => [FaOpen(h)],
  RestExpr(_) => [FaOpen(h)],
  ExprPlaceholder => [FaOpen(h)],
  LitInt(_) | LitFloat(_) | LitString(_) | LitBool(_) | LitUnit => [],
}

fn field_flow(ctx, field) = match field {
  (_, v) => value_flow(ctx, v),
}

// A field whose declared type states the label is a source whatever is
// placed in it, as a declared return is whatever its body computes; any
// other field is what was placed there.
fn named_field_flow(ctx, head, field) = match field {
  (name, v) => if declared_field_carries(ctx, head, name) {
    [flow_source(ctx, v, "the field's declared contract")]
  } else {
    value_flow(ctx, v)
  },
}

// Whether a nominal record's declaration states the label at a field, read
// along the record's name to its declaration.
fn declared_field_carries(ctx, head, name: String) = match graph_ref_decl(head) {
  Some(v) => match graph_published(v) {
    Some((_, _, RecordSchemeKind(fields))) => match find({ (n, _) => n == name }, fields) {
      Some((_, t)) => ty_carries_label(t, ctx.label),
      None => false,
    },
    None | Some(_) => false,
  },
  None => false,
}

fn arm_body_flow(ctx, arm) = match arm {
  (_, body) => value_flow(ctx, body),
}

// A match of two or more arms dispatches on its scrutinee, so which arm
// answers is the scrutinee's to decide; a match of one arm asserts its shape
// and decides nothing.
fn dispatch_flow(ctx, scrut, arms) = if len(arms) >= 2 { value_flow(ctx, scrut) } else { [] }

// A statement that can unwind past its block, or run what follows it more
// than once, decides whether and how often everything after it runs, so
// everything it reads reaches what follows.
fn unwind_flow(ctx, s) = if stmt_alters(s) { subtree_flow(ctx, s) } else { [] }

fn subtree_flow(ctx, h) =
  value_flow(ctx, h) ++ flat_map(subtree_flow(ctx, ??), body_child_handles(graph_node_body(h)))

// A reference reads its binder, along the reference's own edge.
fn ref_flow(ctx, r) = if is_self_node(r) {
  [FaOpen(r)]
} else if ref_is_constructor(r) {
  []
} else {
  match binder_read_by(r) {
    Some(b) => binder_flow(ctx, b),
    None => match graph_ref_decl(r) {
      Some(d) => fn_value_flow(ctx, r, d),
      None => [FaOpen(r)],
    },
  }
}

// A declaration named as a value is what calling it can answer — whoever
// calls it hands it its arguments, and those are theirs to walk: a function's
// declared return or what its summary answers beyond its arguments, an op's
// declared return or every value an arm resumes it with. A handler, a type or
// a constructor named as a value answers no value of its own.
fn fn_value_flow(ctx, r, d) = match graph_published(d) {
  Some((_, _, EffectOpScheme(_, _, _))) => match ret_states(d, ctx.label) {
    Some(true) => [flow_source(ctx, r, "what the op is declared to answer")],
    Some(false) => [],
    None => flat_map(arm_resume_flow(ctx, ??), serving_arms(d)),
  },
  None | Some(_) => match graph_node_body(d) {
    NStmt(FnStmt(_, _, _, _, _)) => match ret_states(d, ctx.label) {
      Some(true) => [flow_source(ctx, r, "what `{decl_name(d)}` is declared to answer")],
      Some(false) => [],
      None => flow_fact(ctx, d, FfAnswer) |> filter({ a => !is_arg(a) }),
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [],
  },
}

fn is_arg(a) = match a {
  FaArg(_) => true,
  FaSource(_) | FaParam(_) | FaReach(_) | FaOpen(_) => false,
}

fn binder_flow(ctx, b) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => param_flow(ctx, b, f.pre),
    PartFact(f) => if value_met(b) { [] } else { declared_flow(ctx, f.declared, b, part_flow(ctx, f.whole, f.step)) },
    StateFact(f) => if value_met(b) {
      []
    } else {
      flat_map(value_flow(ctx, ??), f.writes) ++ stores_flow(ctx, b, RootsAt([b]))
    },
  },
  None => match graph_node_body(b) {
    NExpr(_) => let_flow(ctx, b),
    NParam(_) => param_flow(ctx, b, Unstated),
    NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) => [FaOpen(b)],
  },
}

// A contract a part was declared with states the label, or its absence, of
// whatever the part holds; otherwise the part is what was placed there.
fn declared_flow(ctx, declared, at, beneath) = match declared {
  Some(c) => match ty_states(c, ctx.label) {
    Some(true) => [flow_source(ctx, at, "the field's declared contract")],
    Some(false) => [],
    None => beneath,
  },
  None => beneath,
}

// A let is its value, under every contract the let claimed of it: a claim of
// the label's absence is owed where the let stands and a reader may stand on
// it, and a claim of the label is a source.
fn let_flow(ctx, b) = match claims_state(ctx, b) {
  Some(false) => [],
  Some(true) => [flow_source(ctx, b, "the let's annotation")],
  None => value_flow(ctx, b) ++ stores_flow(ctx, b, value_roots(b)),
}

fn claims_state(ctx, b) =
  graph_claims_of(b) |> map(ty_states(??, ctx.label)) |> fold(None, either_states)

// A parameter is what its function is handed: a declared function's
// parameter is what every call of it hands, owed there; an arm's is what
// every perform of its op hands; a handler's configuration what every install
// of it hands; a function literal's what it is applied to where it is
// applied.
fn param_flow(ctx, b, pre) = if value_met(b) {
  []
} else {
  match graph_parent_of(b) {
    Some(p) => match graph_node_body(p) {
      NStmt(FnStmt(_, _, _, _, _)) => fn_param_flow(ctx, p, b, pre),
      NStmt(HandlerDeclStmt(_, _, config, _, arms, _)) => handler_param_flow(ctx, p, b, config, arms),
      NExpr(LambdaExpr(params, body)) => lambda_param_flow(ctx, p, b, params, body),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => [FaOpen(b)],
    },
    None => [FaOpen(b)],
  }
}

// A declared function's parameter, beside what it is handed, holds what the
// function itself stores into the memory it is handed.
fn fn_param_flow(ctx, d, b, pre) = {
  let stated = match pre_contract(pre) {
    Some(c) => if ty_carries_label(c, ctx.label) { Some(true) } else { ty_states(c, ctx.label) },
    None => None,
  }
  let handed = match stated {
    Some(true) => [flow_source(ctx, b, "the parameter's annotation")],
    Some(false) => [],
    None => if ctx.self == d { [FaArg(b)] } else { [FaParam(b)] },
  }
  let k = param_slot(d, b)
  let written = if writes_param(d, k) { flow_fact(ctx, d, FfWrite(k)) } else { [] }
  handed ++ stores_flow(ctx, b, RootsAt([b])) ++ if ctx.self == d { written } else { map(as_demand, written) }
}

// An arm's argument is what its op is declared to be handed where the
// declaration states the label — a source where it holds, owed by every
// perform where it is absent — and otherwise every value a perform hands:
// at the install being read, each perform of the body it governs; anywhere
// else, every perform of the op. A configuration parameter is what the
// install hands it, or what every install does.
fn handler_param_flow(ctx, hd, b, config, arms) = match find({ arm => any({ a => a == b }, arm.args) }, arms) {
  Some(arm) => match graph_ref_decl(arm.op) {
    Some(op) => {
      let i = node_index(b, arm.args)
      match op_param_states(op, i, ctx.label) {
        Some(true) => [flow_source(ctx, b, "what the op is declared to be handed")],
        Some(false) => [],
        None => if installed_here(ctx, hd) {
          install_body(ctx.install) |> flat_map(performs_in(ctx_at(ctx, 0, ctx.self), ??, op, i))
        } else {
          flat_map(applied_arg_flow(ctx, i, ??), graph_applies_of(op))
        },
      }
    },
    None => [FaOpen(b)],
  },
  None => if any({ c => c == b }, config) {
    if installed_here(ctx, hd) {
      install_config_at(ctx_at(ctx, 0, ctx.self), ctx.install, node_index(b, config))
    } else {
      config_flow(ctx, hd, node_index(b, config))
    }
  } else {
    [FaOpen(b)]
  },
}

fn install_config_at(ctx, t, i) = match graph_node_body(t) {
  NExpr(PipeExpr(PTee, _, right)) => match graph_node_body(right) {
    NExpr(CallExpr(_, args)) => match nth_handle(args, i) {
      Some(found) => flat_map(value_flow(ctx, ??), found),
      None => [FaOpen(right)],
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(right)],
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [FaOpen(t)],
}

fn node_index(h, nodes) = match find({ (_, n) => n == h }, enumerate(nodes)) {
  Some((i, _)) => i,
  None => len(nodes),
}

// What an application hands at a position.
fn applied_arg_flow(ctx, i, app) = match nth_handle(applied_args(app), i) {
  Some(found) => flat_map(value_flow(ctx, ??), found),
  None => [FaOpen(app)],
}

// A handler's configuration is what each install of it hands: the handler
// applied to its arguments.
fn config_flow(ctx, hd, i) = graph_refs_of(hd) |> flat_map(install_config_flow(ctx, i, ??))

fn install_config_flow(ctx, i, r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(callee, args)) => if callee == r {
      match nth_handle(args, i) {
        Some(found) => flat_map(value_flow(ctx, ??), found),
        None => [FaOpen(q)],
      }
    } else {
      [FaOpen(r)]
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [],
  },
  None => [FaOpen(r)],
}

// A function literal's parameter: the piped value where the literal is a
// stage, the recurrence's own output where it is a `<~` body, the argument
// where it is applied in place, what the callee hands it where it is handed
// to a declared function, and what every call of it hands where a let binds
// it.
fn lambda_param_flow(ctx, lam, b, params, body) = match graph_parent_of(lam) {
  Some(q) => match graph_node_body(q) {
    NExpr(PipeExpr(PForward, left, stage)) => if stage == lam { value_flow(ctx, left) } else { [FaOpen(b)] },
    NExpr(PipeExpr(PFeedback, lhs, _)) => if lhs == lam { value_flow(ctx, body) } else { [FaOpen(b)] },
    NExpr(CallExpr(callee, args)) => if callee == lam {
      applied_arg_flow(ctx, node_index(b, params), q)
    } else if any({ a => a == lam }, args) {
      passed_on(ctx, q, lam, FfHand(0, node_index(b, params)))
    } else {
      [FaOpen(b)]
    },
    NStmt(LetStmt(pat, value, _)) => if value == lam {
      graph_refs_of(pat) |> flat_map(called_arg_flow(ctx, node_index(b, params), ??))
    } else {
      [FaOpen(b)]
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(b)],
  },
  None => [FaOpen(b)],
}

fn called_arg_flow(ctx, i, r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(callee, _)) => if callee == r { applied_arg_flow(ctx, i, q) } else { [FaOpen(r)] },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(r)],
  },
  None => [FaOpen(r)],
}

// The declared function a call applies, read along its callee's edge.
fn applied_decl(call) = match graph_node_body(call) {
  NExpr(CallExpr(callee, _)) => match graph_ref_decl(callee) {
    Some(d) => match graph_node_body(d) {
      NStmt(FnStmt(_, _, _, _, _)) => Some(d),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => None,
    },
    None => None,
  },
  NExpr(PipeExpr(PForward, _, stage)) => applied_decl(stage),
  NExpr(VarRef(_)) => match graph_ref_decl(call) {
    Some(d) => match graph_node_body(d) {
      NStmt(FnStmt(_, _, _, _, _)) => Some(d),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => None,
    },
    None => None,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// What an application hands its callee, slot by slot: the judgment's
// product at a call — every argument, default and hole in declaration order
// — or a stage's slots with the piped value in the open one.
fn applied_args(app) = match graph_node_body(app) {
  NExpr(PipeExpr(PForward, left, stage)) => match stage_application(stage, [left]) {
    Some((_, args)) => args,
    None => [left],
  },
  NExpr(CallExpr(_, args)) => match graph_parent_of(app) {
    Some(q) => match graph_node_body(q) {
      NExpr(PipeExpr(PForward, _, stage)) => if stage == app { applied_args(q) } else { call_slots(app, args) },
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => call_slots(app, args),
    },
    None => call_slots(app, args),
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

fn call_slots(call, args) = match graph_product_at(call) {
  ProductOf(nodes, _, _) => nodes,
  NoProduct => args,
}

// A call: a constructor builds its parts, a literal applied in place is its
// body, an op is every value its arms resume it with, a declared function is
// its return as its declaration states it or as its body computes it from
// what it was handed, and a function value is what it computes from what it
// was handed.
fn call_flow(ctx, h, callee, args) = if ref_is_constructor(callee) {
  flat_map(value_flow(ctx, ??), args)
} else {
  match graph_node_body(callee) {
    NExpr(LambdaExpr(_, body)) => value_flow(ctx, body),
    NExpr(VarRef(_)) => match graph_ref_decl(callee) {
      Some(d) => match graph_published(d) {
        Some((_, _, EffectOpScheme(_, _, _))) => perform_flow(ctx, h, d, args),
        None | Some(_) => match graph_node_body(d) {
          NStmt(FnStmt(_, _, _, _, _)) => declared_call_flow(ctx, h, d),
          NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
          | NRow(_) | NParam(_) => match binder_read_by(callee) {
            Some(b) => binder_flow(ctx, b) ++ flat_map(value_flow(ctx, ??), args),
            None => flat_map(value_flow(ctx, ??), args),
          },
        },
      },
      None => [FaOpen(h)],
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => value_flow(ctx, callee) ++ flat_map(value_flow(ctx, ??), args),
  }
}

// A call of a declared function: what its declaration states, else what its
// summary answers, read with this call's arguments.
fn declared_call_flow(ctx, h, d) = match ret_states(d, ctx.label) {
  Some(true) => [flow_source(ctx, h, "what `{decl_name(d)}` is declared to answer")],
  Some(false) => [],
  None => subst_at(ctx, h, d, flow_fact(ctx, d, FfAnswer)),
}

fn decl_name(d) = match graph_node_body(d) {
  NStmt(FnStmt(name, _, _, _, _)) => name,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => "the declaration",
}

// What a declaration's published return states of the label.
fn ret_states(d, label) = match published_fn_ty(d) {
  Some(TFun(_, ret, _)) => {
    let r = bound_ty(ret)
    if ty_carries_label(r, label) { Some(true) } else { ty_states(r, label) }
  },
  None | Some(_) => None,
}

// What an op's declaration states of the label at one of its parameters.
fn op_param_states(op, i, label) = match published_fn_ty(op) {
  Some(TFun(params, _, _)) => if i < len(params) {
    match some_param_ty(list_index(params, i)) {
      Some(t) => if ty_carries_label(t, label) { Some(true) } else { ty_states(t, label) },
      None => None,
    }
  } else {
    None
  },
  None | Some(_) => None,
}

fn published_fn_ty(d) = match graph_published(d) {
  Some((binding, _, _)) => match binding {
    Frozen(_, ty) => Some(bound_ty(ty)),
    Live(h) => Some(bound_ty(TVar(h))),
  },
  None => None,
}

fn bound_ty(t) = match t {
  TVar(h) => match graph_chase(h) {
    GNode(NBound(inner), _) => if inner == t { t } else { bound_ty(inner) },
    GNode(_, _) => t,
  },
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) | TValue(_) => t,
}

// A perform: what its op declares it answers — a source where the label
// holds, nothing where it is absent, since every arm owes that at each
// resume — else every value an arm serving the op resumes it with, and what
// it was handed.
fn perform_flow(ctx, h, op, args) = match ret_states(op, ctx.label) {
  Some(true) => [flow_source(ctx, h, "what the op is declared to answer")],
  Some(false) => [],
  None => flat_map(value_flow(ctx, ??), args) ++ flat_map(arm_resume_flow(ctx, ??), serving_arms(op)),
}

// Every arm serving an op, read off the op's references: an arm names the op
// it serves.
fn serving_arms(op) = graph_refs_of(op) |> flat_map(arm_named_by)

fn arm_named_by(r) = match graph_parent_of(r) {
  Some(p) => match graph_node_body(p) {
    NStmt(HandlerDeclStmt(_, _, _, _, arms, _)) => filter({ arm => arm.op == r }, arms),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [],
  },
  None => [],
}

fn arm_resume_flow(ctx, arm) = flat_map(value_flow(ctx, ??), resumed_values(arm.body))

// The values a body resumes with, wherever its resumes stand.
fn resumed_values(h) = match graph_node_body(h) {
  NExpr(ResumeExpr(v, _)) => [v] ++ resumed_values(v),
  body @ (
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_)
  ) => flat_map(resumed_values, body_child_handles(body)),
}

// A pipe: a stage is applied where the pipe stands; a tee is its body or any
// arm's answer, and where an arm answers in place of the body, everything
// that decides whether the body reached that perform; a feedback is its
// body; a fanout is its branches.
fn pipe_flow(ctx, h, kind, left, right) = match kind {
  PForward => match graph_node_body(right) {
    NExpr(LambdaExpr(_, body)) => value_flow(ctx, body),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => match stage_application(right, [left]) {
      Some((callee, _)) => stage_call_flow(ctx, h, callee),
      None => value_flow(ctx, right) ++ value_flow(ctx, left),
    },
  },
  PTee => value_flow(ctx, left) ++ tee_answer_flow(ctx, left, right),
  PFeedback => value_flow(ctx, left),
  PFanout(_) => value_flow(ctx, left) ++ value_flow(ctx, right),
}

fn stage_call_flow(ctx, pipe, callee) = match graph_ref_decl(callee) {
  Some(d) => match graph_published(d) {
    Some((_, _, EffectOpScheme(_, _, _))) => perform_flow(ctx, pipe, d, applied_args(pipe)),
    None | Some(_) => match graph_node_body(d) {
      NStmt(FnStmt(_, _, _, _, _)) => declared_call_flow(ctx, pipe, d),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => value_flow(ctx, callee) ++ flat_map(value_flow(ctx, ??), applied_args(pipe)),
    },
  },
  None => value_flow(ctx, callee) ++ flat_map(value_flow(ctx, ??), applied_args(pipe)),
}

fn tee_answer_flow(ctx, body, right) = match tee_arms(right) {
  Some(arms) => {
    let answers = flat_map({ arm => arm_tails(arm.body) }, arms)
    if len(answers) == 0 {
      []
    } else {
      flat_map(value_flow(ctx, ??), answers) ++ subtree_flow(ctx, body)
    }
  },
  None => [FaOpen(right)],
}

// A part read off its whole: the node it is where the whole was built in
// sight, through every branch the whole was chosen by, and what the whole's
// own contract states there where it was not.
fn part_flow(ctx, whole, step) =
  part_flow_at(ctx, whole, step) ++ stores_flow(ctx, whole, value_roots(whole))

fn part_flow_at(ctx, whole, step) = match graph_node_body(whole) {
  NExpr(VarRef(_)) => match binder_read_by(whole) {
    Some(b) => binder_part_flow(ctx, b, step),
    None => value_flow(ctx, whole),
  },
  NExpr(IfExpr(c, t, f)) => value_flow(ctx, c) ++ part_flow(ctx, t, step) ++ part_flow(ctx, f, step),
  NExpr(MatchExpr(scrut, arms)) => dispatch_flow(ctx, scrut, arms) ++ flat_map({ (_, body) => part_flow(ctx, body, step) }, arms),
  NExpr(BlockExpr(stmts, final)) => part_flow(ctx, final, step) ++ flat_map(unwind_flow(ctx, ??), stmts),
  NExpr(NamedRecordExpr(head, _)) => match step {
    PartField(name) => if declared_field_carries(ctx, head, name) {
      [flow_source(ctx, whole, "the field's declared contract")]
    } else {
      built_flow(ctx, whole, step)
    },
    PartIndex(_) | PartCtor(_, _) | PartElem | PartRest | PartTypeArg(_) => built_flow(ctx, whole, step),
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => built_flow(ctx, whole, step),
}

fn built_flow(ctx, whole, step) = match built_part(whole, step) {
  Some(nodes) => flat_map(value_flow(ctx, ??), nodes),
  None => value_flow(ctx, whole),
}

fn binder_part_flow(ctx, b, step) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => match pre_contract(f.pre) {
      Some(c) => match contract_part(c, step) {
        Some(pc) => match ty_states(pc, ctx.label) {
          Some(true) => [flow_source(ctx, b, "the parameter's annotation at the part")],
          Some(false) => [],
          None => param_flow(ctx, b, f.pre),
        },
        None => param_flow(ctx, b, f.pre),
      },
      None => param_flow(ctx, b, f.pre),
    },
    PartFact(_) => binder_flow(ctx, b),
    StateFact(_) => binder_flow(ctx, b),
  },
  None => match graph_node_body(b) {
    NExpr(_) => match claims_state(ctx, b) {
      Some(false) => [],
      Some(true) => [flow_source(ctx, b, "the let's annotation")],
      None => part_flow(ctx, b, step),
    },
    NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => binder_flow(ctx, b),
  },
}

// A callee leaf applied to arguments: a reference applied to them, or a
// partial application completed by them — the authored `??` slots first,
// then the slots past its arguments.
fn stage_application(sh, applied) = match graph_node_body(sh) {
  NExpr(VarRef(_)) => Some((sh, applied)),
  NExpr(CallExpr(callee, _)) => match graph_product_at(sh) {
    ProductOf(nodes, _, CallSuspended) => Some((callee, completed_args(nodes, applied))),
    ProductOf(_, _, CallApplied) => None,
    NoProduct => None,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// Each authored hole takes the next applied value, in order, and the applied
// values no hole took follow the slots.
fn completed_args(nodes, applied) = match fold(([], applied), fill_slot, nodes) {
  (filled, left) => filled ++ left,
}

fn fill_slot(acc, n) = match acc {
  (filled, left) => if is_authored_hole(n) {
    match left {
      [v, ...more] => (push(filled, v), more),
      [] => (push(filled, n), []),
    }
  } else {
    (push(filled, n), left)
  },
}

fn is_authored_hole(n) = match graph_node_body(n) {
  NHole(id) => id != 0,
  NExpr(_) | NStmt(_) | NPat(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => false,
}

// The Memory ops that write (lib/memory.mn): each the address it writes, or
// the whole image.
type RawStore = RsNone | RsAt(Int) | RsAll

fn raw_store_target(cname: String) = match cname {
  "store_i32" => RsAt(0),
  "store_i8" => RsAt(0),
  "store_addr" => RsAt(0),
  "store_f64" => RsAt(0),
  "mem_copy" => RsAt(0),
  "globals_save" => RsAt(0),
  "image_restore" => RsAll,
  _ => RsNone,
}

// The memory a value may be: a binder it names and what that binder was
// bound to, a literal it was built as, a fresh allocation, the argument a
// callee answers back, through every branch it was chosen by — or any
// memory, where it is a part of another value or comes from where the walk
// cannot see.
fn value_roots(t) = match graph_node_body(t) {
  NExpr(VarRef(_)) => match binder_read_by(t) {
    Some(b) => match graph_binder_of(b) {
      Some(PartFact(_)) => RootsAny,
      Some(_) => RootsAt([b]),
      None => if b == t { RootsAt([b]) } else { roots_join(RootsAt([b]), value_roots(b)) },
    },
    None => RootsAny,
  },
  NExpr(CallExpr(callee, args)) => call_roots(t, callee, args),
  NExpr(MakeListExpr(_)) | NExpr(MakeTupleExpr(_)) | NExpr(MakeRecordExpr(_))
  | NExpr(NamedRecordExpr(_, _)) | NExpr(MakeStringExpr(_)) => RootsAt([t]),
  NParam(_) => RootsAt([t]),
  NExpr(LitString(_)) => RootsAt([t]),
  NExpr(IfExpr(_, a, b)) => roots_join(value_roots(a), value_roots(b)),
  NExpr(MatchExpr(_, arms)) => arms |> map(arm_roots) |> fold(RootsAt([]), roots_join),
  NExpr(BlockExpr(_, final)) => value_roots(final),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) => RootsAny,
}

fn arm_roots(arm) = match arm {
  (_, body) => value_roots(body),
}

fn roots_join(a, b) = match a {
  RootsAny => RootsAny,
  RootsAt(xs) => match b {
    RootsAny => RootsAny,
    RootsAt(ys) => RootsAt(xs ++ ys),
  },
}

// A call's result: a constructor's is fresh, an address `addr_at` moves stays
// in the allocation its base names, `alloc`'s is fresh, and a declared
// function's is what its store claim says of the arguments it answers back.
fn call_roots(call, callee, args) = if ref_is_constructor(callee) {
  RootsAt([call])
} else {
  match graph_node_body(callee) {
    NExpr(VarRef(cname)) => if cname == "alloc" {
      RootsAt([call])
    } else if cname == "addr_at" || cname == "addr" {
      match args {
        [base, ..._] => value_roots(base),
        [] => RootsAny,
      }
    } else {
      match graph_ref_decl(callee) {
        Some(d) => match graph_store_claim_of(d) {
          Some(StoreClaim(s)) => match s.returns {
            Some(idxs) => idxs |> map(slot_roots(args, ??)) |> fold(RootsAt([call]), roots_join),
            None => RootsAny,
          },
          None => RootsAny,
        },
        None => RootsAny,
      }
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => RootsAny,
  }
}

fn slot_roots(args, i) = match nth_handle(args, i) {
  Some([a]) => value_roots(a),
  None | Some(_) => RootsAny,
}

fn roots_meet(store, read) = match store {
  RootsAny => true,
  RootsAt(xs) => match read {
    RootsAny => true,
    RootsAt(ys) => any({ x => any({ y => y == x }, ys) }, xs),
  },
}

// What the stores into a value's memory wrote there. A value whose memory is
// out of sight is never a function's own allocation, which is read where it
// was made, so a store into such memory meets only a value whose memory names
// it. A value whose type is a word holds no memory.
fn stores_flow(ctx, h, roots) = if holds_memory(h) {
  facts_stores() |> filter(store_meets(roots, ??)) |> flat_map(store_atoms(ctx, ??))
} else {
  []
}

fn store_meets(read, s) = match read {
  RootsAny => !s.local,
  RootsAt(ys) => match s.roots {
    RootsAt(_) => roots_meet(s.roots, read),
    RootsAny => !s.local || any({ y => owning_fn(y) == s.owner }, ys),
  },
}

// The declared function a node stands in, read up the parent edges; 0 at
// module level.
fn owning_fn(h) = match graph_parent_of(h) {
  None => 0,
  Some(p) => match graph_node_body(p) {
    NStmt(FnStmt(_, _, _, _, _)) => p,
    NModule(_) => 0,
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => owning_fn(p),
  },
}

// What a store writes — read in the activation that makes it where the memory
// is its function's own, and as any activation's otherwise: a raw store
// writes what it is handed, a call into a function that writes its parameter
// writes what that function's summary stores there.
fn store_atoms(ctx, s) = write_atoms(if s.local { ctx } else { ctx_at(ctx, 0, 0) }, s)

fn write_atoms(at, s) = match s.by {
  ByRaw => match graph_node_body(s.call) {
    NExpr(CallExpr(_, args)) => flat_map(value_flow(at, ??), args),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(s.call)],
  },
  BySlot(k) => match applied_decl(s.call) {
    Some(d) => subst_at(at, s.call, d, flow_fact(at, d, FfWrite(k))),
    None => [FaOpen(s.call)],
  },
  ByInstall(hd, k) => config_writes(at, hd, k),
}

// What a handler's arms store into the memory its install hands it as
// configuration: a handler's configuration is its install's parameters.
fn config_writes(ctx, hd, k) = match graph_node_body(hd) {
  NStmt(HandlerDeclStmt(_, _, config, _, arms, _)) => if k < len(config) {
    let c = list_index(config, k)
    arm_stores(hd, arms) |> filter({ s => roots_hold(s.roots, c) }) |> flat_map(store_atoms(ctx, ??))
  } else {
    []
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

fn arm_stores(hd, arms) = arms |> flat_map({ arm => stores_in(hd, arm.body) })

fn holds_memory(h) = match graph_chase(h) {
  GNode(NBound(ty), _) => match ty {
    TInt | TFloat | TUnit | TByte | TAddr | TValue(_) => false,
    TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_) | TName(_, _) | TRecord(_) | TRecordOpen(_, _)
    | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) => true,
  },
  GNode(_, _) => true,
}

// A memory's parts are what its writers put there. A part read off how a
// value was built is the construction's only while nothing else writes that
// memory: each write the walk can place in it adds what it stored there, and
// a memory whose writers cannot all be seen is out of sight at every part.
// The language writes a list in place — `list_set`, and through it any
// function that writes what it is handed — and never a record, a tuple or a
// constructor's payload, so a list's elements are what has writers.
type Written = WrittenBy([Int]) | WrittenUnseen

// No writer at all, the answer nearly every part read gets: one value, made
// once.
let written_none = WrittenBy([])

fn memory_writes(n, step) = if step_into_list(step) && holds_memory(n) {
  frame_writes(frame_of(n), memory_roots(n), step)
} else {
  written_none
}

// The memory a node names: a parameter's or a state's binder is that memory
// itself, a part of another value is out of the roots' reach, and any other
// node is the memory its value may be.
fn memory_roots(n) = match graph_binder_of(n) {
  Some(fact) => match fact {
    StateFact(_) => RootsAt([n]),
    ParamFact(_) => RootsAt([n]),
    PartFact(_) => RootsAny,
  },
  None => value_roots(n),
}

fn step_into_list(step) = match step {
  PartElem | PartRest => true,
  PartIndex(_) | PartCtor(_, _) | PartField(_) | PartTypeArg(_) => false,
}

fn written_join(a, b) = match a {
  WrittenUnseen => WrittenUnseen,
  WrittenBy(xs) => match b {
    WrittenUnseen => WrittenUnseen,
    WrittenBy(ys) => WrittenBy(xs ++ ys),
  },
}

// The code that runs between a memory's making and a read of it: the
// declaration or the handler it stands in, with every nested function and
// literal inside it, since each runs while the frame does. A module value
// stands in the whole program, which every declaration can write.
type MemoryFrame = FrameOf(Int, Int) | FrameProgram

fn frame_of(n) = match graph_parent_of(n) {
  Some(p) => match graph_node_body(p) {
    NStmt(FnStmt(_, _, _, _, body)) => FrameOf(p, body),
    NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => FrameOf(p, p),
    NModule(_) => FrameProgram,
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => frame_of(p),
  },
  None => FrameProgram,
}

// What the frame's code can have written into memory the roots name, where
// a part of it is read. A write the walk cannot place — into a part of a
// value, through a name it cannot follow — may be any memory. A memory
// handed to code that keeps it or writes it out of sight is out of sight,
// and so is a memory older than the frame — a parameter's, a state's, a
// capture's — or one a value holds elsewhere, where the frame calls code
// that writes memory older than its own. A handler's arms run in any order,
// so its memory is read once every arm is judged; a declaration's code runs
// in its order, so what the judgment has not reached is written after.
fn frame_writes(frame, roots, step) = match frame {
  FrameProgram => WrittenUnseen,
  FrameOf(owner, body) => if frame_unjudged(owner, body) {
    walk_unsettled()
    WrittenUnseen
  } else {
    match roots {
      RootsAny => scan_verdict(true, frame_scan([], step, scan_start, body)),
      RootsAt(rs) => scan_verdict(any(root_shared(owner, ??), rs), frame_scan(rs, step, scan_start, body)),
    }
  },
}

// One walk over the frame asks each judged node every question at once: a
// write it cannot place ends the walk, and otherwise it gathers whether the
// frame writes memory older than itself, whether it hands the memory away,
// and what it stores there.
type FrameScan = ScanUnplaced | Scanned(Bool, Bool, [Int])

let scan_start = Scanned(false, false, [])

fn frame_scan(rs, step, acc, h) = match acc {
  ScanUnplaced => ScanUnplaced,
  Scanned(_, _, _) => {
    let here = if node_judged(h) { scan_node(rs, step, acc, h) } else { acc }
    graph_node_body(h) |> body_child_handles |> fold(here, frame_scan(rs, step, ??, ??))
  },
}

fn scan_node(rs, step, acc, h) = match acc {
  ScanUnplaced => ScanUnplaced,
  Scanned(older, handed, written) => if writes_unplaced(h) {
    ScanUnplaced
  } else {
    match node_writes(rs, step, h) {
      WrittenUnseen => ScanUnplaced,
      WrittenBy(more) => {
        let older_now = older || writes_older(h)
        let handed_now = handed || hands_away(rs, h)
        if older_now == older && handed_now == handed && len(more) == 0 {
          acc
        } else {
          Scanned(older_now, handed_now, written ++ more)
        }
      },
    }
  },
}

fn scan_verdict(shared, scan) = match scan {
  ScanUnplaced => WrittenUnseen,
  Scanned(older, handed, written) => if handed || shared && older {
    WrittenUnseen
  } else if len(written) == 0 {
    written_none
  } else {
    WrittenBy(written)
  },
}

fn node_judged(n) = match graph_chase(n) {
  GNode(NBound(_), _) => true,
  GNode(_, _) => false,
}

fn frame_unjudged(owner, body) = match graph_node_body(owner) {
  NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => expr_unjudged(body),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => false,
}

fn expr_unjudged(h) = match graph_node_body(h) {
  NExpr(_) => !node_judged(h),
  NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => false,
} || (graph_node_body(h) |> body_child_handles |> any(expr_unjudged))

fn meets(rs, x) = match value_roots(x) {
  RootsAt(xs) => any({ x => any({ r => r == x }, rs) }, xs),
  RootsAny => false,
}

// A root the frame did not make: a parameter, a state, a part of another
// value, or a binder or construction standing outside the frame.
fn root_shared(owner, r) = match graph_binder_of(r) {
  Some(_) => true,
  None => match graph_node_body(r) {
    NParam(_) => true,
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) => !within(r, owner),
  },
}

fn within(n, owner) = n == owner || match graph_parent_of(n) {
  Some(p) => within(p, owner),
  None => false,
}

// What an application is to the memory it is handed: a construction, a raw
// store of the substrate, a substrate primitive read by its face, a declared
// function read by its claim, a perform, an install's configuration, a word
// primitive — an instruction over words, keeping and writing nothing — or a
// function value the walk cannot name.
type AppKind
  = AkBuild
  | AkRaw(RawStore)
  | AkFace(Int)
  | AkDecl(Int)
  | AkPerform([Int])
  | AkInstall
  | AkWord
  | AkValue

fn app_kind(c) = if ref_is_constructor(c) {
  AkBuild
} else if reaches_substrate(c) {
  match graph_ref_decl(c) {
    Some(d) => AkFace(d),
    None => AkValue,
  }
} else {
  match graph_node_body(c) {
    NExpr(VarRef(cname)) => match raw_store_target(cname) {
      RsNone => named_app_kind(c),
      found @ (RsAt(_) | RsAll) => AkRaw(found),
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => AkValue,
  }
}

fn named_app_kind(c) = match graph_ref_decl(c) {
  Some(d) => match graph_published(d) {
    Some((_, _, kind)) => match kind {
      FnScheme => match graph_node_body(d) {
        NStmt(FnStmt(_, _, _, _, _)) => AkDecl(d),
        NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
        | NRow(_) | NParam(_) => AkValue,
      },
      ConstructorScheme(_, _) => AkBuild,
      EffectOpScheme(_, providers, _) => AkPerform(providers),
      HandlerKind(_, _, _, _, _) | HandlerChainKind(_) => AkInstall,
      PrimitiveKind(_) => AkWord,
      RecordSchemeKind(_) | EffectDeclKind(_, _) | ParamScheme(_) | RowAliasKind(_) | TypeVariants(_)
      | ValueScheme => AkValue,
    },
    None => AkValue,
  },
  None => AkValue,
}

// An application and what it is handed: a call; a pipe into a stage that is
// not itself a call, whose piped value is the stage's argument; a fanout,
// whose input its branches are handed; a feedback line, which keeps what it
// is fed.
fn app_of(n) = match graph_node_body(n) {
  NExpr(CallExpr(callee, _)) => Some((app_kind(callee), applied_args(n))),
  NExpr(PipeExpr(kind, left, stage)) => match kind {
    PForward => match graph_node_body(stage) {
      NExpr(CallExpr(_, _)) => None,
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => Some((app_kind(stage), [left])),
    },
    PFanout(_) | PFeedback => Some((AkValue, [left])),
    PTee => None,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// A node that puts the memory where its later writes cannot be seen: into
// another value — a construction's field, a fanout's branch, the value a
// writer stores, a resume, a state's update — or into code that keeps it or
// writes it out of sight.
fn hands_away(rs, n) = match graph_node_body(n) {
  NExpr(MakeListExpr(elems)) => any(meets(rs, ??), elems),
  NExpr(MakeTupleExpr(elems)) => any(meets(rs, ??), elems),
  NExpr(FanoutExpr(elems)) => any(meets(rs, ??), elems),
  NExpr(MakeRecordExpr(fields)) => any({ (_, v) => meets(rs, v) }, fields),
  NExpr(NamedRecordExpr(_, fields)) => any({ (_, v) => meets(rs, v) }, fields),
  NExpr(RecordUpdateExpr(_, fields)) => any({ (_, v) => meets(rs, v) }, fields),
  NExpr(ResumeExpr(v, updates)) => meets(rs, v) || any({ u => meets(rs, u.init) }, updates),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => match app_of(n) {
    Some((kind, args)) => app_hands_away(rs, kind, args),
    None => false,
  },
}

fn app_hands_away(rs, kind, args) = match kind {
  AkBuild => any(meets(rs, ??), args),
  AkWord => false,
  AkRaw(target) => args |> enumerate |> any({ (i, a) => !raw_targets(target, i) && meets(rs, a) }),
  AkFace(d) => face_stored_slots(d) |> any({ i => slot_meets(rs, args, i) }),
  AkDecl(d) => match graph_store_claim_of(d) {
    Some(StoreClaim(s)) => (s.beyond || s.opaque) && any(meets(rs, ??), args) || applies_write_handed(rs, s, args),
    None => any(meets(rs, ??), args),
  },
  AkPerform(_) | AkInstall | AkValue => any(meets(rs, ??), args),
}

fn raw_targets(target, i) = match target {
  RsAt(t) => t == i,
  RsAll | RsNone => false,
}

fn slot_meets(rs, args, i) = match nth_handle(args, i) {
  Some([a]) => meets(rs, a),
  None | Some(_) => false,
}

fn slot_nodes(args, i) = match nth_handle(args, i) {
  Some(nodes) => nodes,
  None => [],
}

// A function a callee applies writes what the callee hands it: the memory a
// slot hands the callee is written where it is handed to such a function.
fn applies_write_handed(rs, s, args) =
  s.applies |> any({ (k, handed) => applied_writes(args, k) && any(handed_meets(rs, args, ??), handed) })

fn handed_meets(rs, args, handed) = match handed {
  HandedParam(j) => slot_meets(rs, args, j),
  HandedLoop(j, _) => slot_meets(rs, args, j),
  HandedNone => any(meets(rs, ??), args),
}

// Whether the function at a slot writes memory — any it is handed, a
// capture, its own record, or memory older than its frame: a literal or a
// declaration read by its claim, anything else by nothing it can show.
fn applied_writes(args, k) = match nth_handle(args, k) {
  Some([f]) => match fn_claim(f) {
    Some(StoreClaim(s)) => len(s.mutated) > 0 || len(s.captures) > 0 || s.record || s.beyond || s.opaque,
    None => true,
  },
  None | Some(_) => true,
}

fn fn_claim(f) = match graph_node_body(f) {
  NExpr(LambdaExpr(_, _)) => graph_store_claim_of(f),
  NExpr(VarRef(_)) => match graph_ref_decl(f) {
    Some(d) => graph_store_claim_of(d),
    None => None,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// A write into memory the walk cannot place: a raw store, a substrate writer
// or a function writing what it is handed, each into a part of a value or
// through a name the walk cannot follow, and the image restored whole.
fn writes_unplaced(n) = match app_of(n) {
  Some((kind, args)) => match kind {
    AkRaw(target) => match target {
      RsAt(i) => slot_unplaced(args, i),
      RsAll => true,
      RsNone => false,
    },
    AkFace(d) => claim_mutated(d) |> any(slot_unplaced(args, ??)),
    AkDecl(d) => claim_mutated(d) |> any(slot_unplaced(args, ??)),
    AkBuild | AkPerform(_) | AkInstall | AkWord | AkValue => false,
  },
  None => false,
}

fn slot_unplaced(args, i) = match nth_handle(args, i) {
  Some([a]) => value_roots(a) == RootsAny,
  None | Some(_) => true,
}

fn claim_mutated(d) = match graph_store_claim_of(d) {
  Some(StoreClaim(s)) => s.mutated,
  None => [],
}

// A write into memory older than the frame, by code the frame calls: a
// callee whose claim says it writes beyond what it is handed, or applies a
// function that writes; a perform whose handlers' arms write their
// configuration or older memory; a function value whose row can carry
// `Mutate`, since a store into any memory older than the function's own run
// is that effect in its row.
fn writes_older(n) = match app_of(n) {
  Some((kind, args)) => match kind {
    AkDecl(d) => match graph_store_claim_of(d) {
      Some(StoreClaim(s)) => s.beyond || s.opaque || (s.applies |> any({ (k, _) => applied_writes(args, k) })),
      None => true,
    },
    AkPerform(providers) => any(arms_write, providers),
    AkValue => value_call_writes(n),
    AkBuild | AkRaw(_) | AkFace(_) | AkInstall | AkWord => false,
  },
  None => false,
}

fn value_call_writes(n) = match graph_node_body(n) {
  NExpr(CallExpr(callee, _)) => match graph_chase(callee) {
    GNode(NBound(TFun(_, _, row)), _) => row_may_carry_mutate(row),
    GNode(_, _) => true,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => true,
}

// Whether a callee's row can carry Mutate into this frame: it names it, or
// its tail is still open to a row this frame's callers fill. A row that can
// carry none makes the callee's claim moot, whatever it says of itself: the
// scope keeps every unaccounted write where the row could hold one, and
// nowhere else, so an opaque callee whose row is closed and clean costs its
// callers nothing. The tail is read through its cells: an edge whose mask
// names Mutate carries none, an edge bound to a row carries what that row
// can, and a free edge can carry anything. Read off the edges alone, every
// call of a stage whose callback was already judged clean was masked into a
// row of its own — the self-compile's line peak, 2026-10-21.
fn row_may_carry_mutate(row) = match row {
  EfRow(present, absent, tail) => any(names_mutate, present) || match tail {
    EtClosed => false,
    EtAll => !any(names_mutate, absent),
    EtOpen(edges) => any(edge_may_carry_mutate, edges),
  },
}

fn edge_may_carry_mutate(e) = if any(names_mutate, edge_mask(e)) {
  false
} else {
  match graph_chase(edge_cell(e)) {
    GNode(kind, _) => match edge_row_of(kind) {
      Some(inner) => row_may_carry_mutate(inner),
      None => true,
    },
  }
}

fn arms_write(hd) = match graph_store_claim_of(hd) {
  Some(StoreClaim(s)) => s.beyond || s.opaque || len(s.mutated) > 0,
  None => true,
}

// What one node writes into memory the roots name: a raw store's word, at a
// place no part names; a substrate writer the values its face stores; a
// declared function what its own code stores into the parameter it is
// handed the memory at.
fn node_writes(rs, step, n) = match app_of(n) {
  Some((kind, args)) => match kind {
    AkRaw(target) => match target {
      RsAt(i) => if slot_meets(rs, args, i) { WrittenUnseen } else { written_none },
      RsAll => WrittenUnseen,
      RsNone => written_none,
    },
    AkFace(d) => if claim_mutated(d) |> any(slot_meets(rs, args, ??)) {
      WrittenBy(face_stored_slots(d) |> flat_map(slot_nodes(args, ??)))
    } else {
      written_none
    },
    AkDecl(d) => claim_mutated(d) |> filter(slot_meets(rs, args, ??)) |> map(param_writes(d, ??, step)) |> fold(written_none, written_join),
    AkBuild | AkPerform(_) | AkInstall | AkWord | AkValue => written_none,
  },
  None => written_none,
}

// What a declared function stores into the memory its parameter is handed:
// the same law read in its own frame. A function the walk is already inside
// writes what the walk cannot yet say.
fn param_writes(d, k, step) = if walking_state(d) {
  WrittenUnseen
} else {
  match graph_node_body(d) {
    NStmt(FnStmt(_, params, _, _, body)) => match nth_handle(params, k) {
      Some([p]) => frame_writes(FrameOf(d, body), RootsAt([p]), step) ~> walking_state_of(d),
      None | Some(_) => WrittenUnseen,
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => WrittenUnseen,
  }
}

// The slots whose values a substrate writer stores into the list it writes:
// those its face types by the element alone.
fn face_stored_slots(d) = match graph_node_body(d) {
  NStmt(FnStmt(name, _, _, _, _)) => match seq_face(name, face_element()) {
    Some((ptys, _)) => ptys |> enumerate |> flat_map({ (i, t) => if is_face_element(t) { [i] } else { [] } }),
    None => [],
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// The element a face is read over: a variable no judgment mints.
fn face_element() = TVar(-1)

fn is_face_element(t) = match t {
  TVar(v) => v == -1,
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) | TValue(_) => false,
}

// How a store writes: a raw Memory store writes what it is handed into the
// address it is handed; a call into a function that writes one of its
// parameters (its store claim names which) writes there what that function
// stores into the memory the call hands it.
type StoreBy = ByRaw | BySlot(Int) | ByInstall(Int, Int)

// Every store the program makes, read off its declarations once per settle:
// the call that makes it, how it writes, the memory it writes, and whether
// that memory is its function's own — a parameter of it or a value it built.
// A function's stores into the memory it is handed alone are its write
// summary, and reach the program through its calls.
fn flow_stores() = link_program() |> flat_map(decl_stores)

fn decl_stores(d) = match graph_node_body(d) {
  NStmt(FnStmt(_, params, _, _, body)) => scope_stores(d, params, body),
  NStmt(HandlerDeclStmt(_, _, config, _, _, _)) => scope_stores(d, config, d),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => scope_stores(0, [], d),
}

fn scope_stores(owner, params, h) = match graph_node_body(h) {
  NStmt(FnStmt(_, inner, _, _, body)) => scope_stores(h, inner, body),
  body @ (
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_)
  ) => filter({ s => !roots_within(s.roots, params) }, node_stores(owner, h)) ++ flat_map(scope_stores(owner, params, ??), body_child_handles(body)),
}

fn roots_within(roots, params) = match roots {
  RootsAny => false,
  RootsAt(xs) => len(xs) > 0 && all({ x => any({ p => p == x }, params) }, xs),
}

// The stores a function's own code makes, a nested function's aside.
fn stores_in(d, h) = match graph_node_body(h) {
  NStmt(FnStmt(_, _, _, _, _)) => [],
  body @ (
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_)
  ) => node_stores(d, h) ++ flat_map(stores_in(d, ??), body_child_handles(body)),
}

fn node_stores(owner, h) = match graph_node_body(h) {
  NExpr(CallExpr(callee, args)) => callee_stores(owner, h, callee, args),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

fn callee_stores(owner, call, callee, args) = match graph_node_body(callee) {
  NExpr(VarRef(cname)) => match raw_store_target(cname) {
    RsAt(i) => [store_at(owner, call, ByRaw, slot_roots(args, i))],
    RsAll => [store_at(owner, call, ByRaw, RootsAny)],
    RsNone => match graph_ref_decl(callee) {
      Some(d) => match graph_store_claim_of(d) {
        Some(StoreClaim(s)) => map({ i => store_at(owner, call, writes_by(d, i), slot_roots(applied_args(call), i)) }, s.mutated),
        None => [],
      },
      None => [],
    },
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// A function writes the memory a slot hands it through its summary; a
// handler applied to its configuration writes it through its arms.
fn writes_by(d, i) = match graph_node_body(d) {
  NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => ByInstall(d, i),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => BySlot(i),
}

// A store the judgment saw write memory older than its frame charged Mutate
// where it stands; any other wrote memory its own activation built.
fn store_at(owner, call, by, roots) =
  {by, call, local: !any(row_names_mutate, graph_rows_at(call)), owner, roots}

// Whether a declared function writes the memory it is handed at a slot, as
// its store claim says.
fn writes_param(d, k) = match graph_store_claim_of(d) {
  Some(StoreClaim(s)) => any({ i => i == k }, s.mutated),
  None => false,
}

// A statement unwinds past its block, or runs what follows it more than once,
// where it performs — outside every install inside it that answers — an op
// some arm serving it does not resume on every path or resumes more than
// once, calls a function that does, or calls a function value, whose code
// the statement cannot see.
fn stmt_alters(s) = alters_within(s, []) ~> flow_walk

fn alters_within(h, absorbed) = match graph_node_body(h) {
  NExpr(CallExpr(callee, args)) => callee_alters(callee, absorbed) || any(alters_within(??, absorbed), args),
  NExpr(PipeExpr(PTee, body, right)) => alters_within(body, absorbed ++ served_ops(right)) || arms_alter(right, absorbed),
  NExpr(PipeExpr(PForward, left, stage)) => alters_within(left, absorbed) || stage_alters(stage, absorbed),
  body @ (
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_)
  ) => any(alters_within(??, absorbed), body_child_handles(body)),
}

fn stage_alters(stage, absorbed) = match graph_node_body(stage) {
  NExpr(VarRef(_)) => callee_alters(stage, absorbed),
  NExpr(CallExpr(callee, args)) => callee_alters(callee, absorbed) || any(alters_within(??, absorbed), args),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => alters_within(stage, absorbed),
}

fn callee_alters(callee, absorbed) = match graph_node_body(callee) {
  NExpr(VarRef(_)) => if ref_is_constructor(callee) {
    false
  } else {
    match graph_ref_decl(callee) {
      Some(d) => match graph_published(d) {
        Some((_, _, EffectOpScheme(_, _, disc))) => !any({ a => a == d }, absorbed) && op_alters(d, disc),
        None | Some(_) => match graph_node_body(d) {
          NStmt(FnStmt(_, _, _, _, body)) => if decl_met(d) { false } else { alters_within(body, absorbed) },
          NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
          | NRow(_) | NParam(_) => binder_read_by(callee) != None,
        },
      },
      None => true,
    }
  },
  NExpr(LambdaExpr(_, _)) => false,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => true,
}

fn op_alters(op, disc) =
  disc == MultiShot || any({ arm => len(arm_tails(arm.body)) > 0 }, serving_arms(op))

// The ops a tee's handler answers, read off its arms' edges.
fn served_ops(right) = match tee_arms(right) {
  Some(arms) => flat_map({ arm => arm_op_decls(arm) }, arms),
  None => [],
}

fn arm_op_decls(arm) = match graph_ref_decl(arm.op) {
  Some(op) => [op],
  None => [],
}

fn arms_alter(right, absorbed) = match tee_arms(right) {
  Some(arms) => any({ arm => alters_within(arm.body, absorbed) }, arms),
  None => true,
}

// Everything that decides whether the code at `h` runs: the conditions of the
// branches it stands in, the statements before it that can unwind past it,
// the context of the function literal it stands in, every perform of the op
// whose arm it stands in, and — at a declared function's edge — whether the
// function runs, which every call of it owes.
fn reach_flow(ctx, h) = match graph_parent_of(h) {
  None => [],
  Some(p) => reach_step(ctx, h, p),
}

fn reach_step(ctx, h, p) = match graph_node_body(p) {
  NExpr(IfExpr(c, _, _)) => if c == h { [] } else { value_flow(ctx, c) } ++ reach_flow(ctx, p),
  NExpr(MatchExpr(scrut, arms)) => if scrut == h { [] } else { dispatch_flow(ctx, scrut, arms) } ++ reach_flow(ctx, p),
  NExpr(BinOpExpr(op, l, r)) => if r == h && short_circuits(op) { value_flow(ctx, l) } else { [] } ++ reach_flow(ctx, p),
  NExpr(BlockExpr(stmts, _)) => flat_map(unwind_flow(ctx, ??), stmts_before(stmts, h)) ++ reach_flow(ctx, p),
  NExpr(LambdaExpr(_, _)) => lambda_reach(ctx, p),
  NStmt(FnStmt(_, _, _, _, _)) => if ctx.self == p { [] } else { [FaReach(p)] },
  NStmt(HandlerDeclStmt(_, _, _, _, arms, _)) => arm_reach(ctx, p, h, arms),
  NModule(_) => [],
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => reach_flow(ctx, p),
}

fn short_circuits(op) = match op {
  BAnd => true,
  BOr => true,
  BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BLt | BGt | BLe | BGe | BConcat => false,
}

fn stmts_before(stmts, h) = match find({ (_, s) => s == h }, enumerate(stmts)) {
  Some((i, _)) => take(i, stmts),
  None => stmts,
}

fn lambda_reach(ctx, lam) = if reach_met(lam) {
  []
} else {
  match graph_parent_of(lam) {
    Some(q) => match graph_node_body(q) {
      NExpr(PipeExpr(PForward, _, stage)) => if stage == lam { reach_flow(ctx, q) } else { [FaOpen(lam)] },
      NExpr(PipeExpr(PFeedback, lhs, _)) => if lhs == lam { reach_flow(ctx, q) } else { [FaOpen(lam)] },
      NExpr(CallExpr(callee, args)) => if callee == lam {
        reach_flow(ctx, q)
      } else if any({ a => a == lam }, args) {
        reach_flow(ctx, q) ++ passed_on(ctx, q, lam, FfApply(0))
      } else {
        [FaOpen(lam)]
      },
      NStmt(LetStmt(pat, value, _)) => if value == lam { graph_refs_of(pat) |> flat_map(call_reach(ctx, ??)) } else { [FaOpen(lam)] },
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => [FaOpen(lam)],
    },
    None => [FaOpen(lam)],
  }
}

fn call_reach(ctx, r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(callee, _)) => if callee == r { reach_flow(ctx, q) } else { [FaOpen(r)] },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(r)],
  },
  None => [FaOpen(r)],
}

// An arm runs where its op is performed: inside the body the install being
// read governs, or wherever the op is performed.
fn arm_reach(ctx, hd, h, arms) = match find({ arm => arm.body == h || any({ a => a == h }, arm.args) }, arms) {
  Some(arm) => if reach_met(arm.body) {
    []
  } else {
    match graph_ref_decl(arm.op) {
      Some(op) => if installed_here(ctx, hd) {
        install_body(ctx.install) |> flat_map(perform_reach_in(ctx_at(ctx, 0, ctx.self), ??, op))
      } else {
        graph_applies_of(op) |> flat_map(reach_flow(ctx, ??))
      },
      None => [FaOpen(h)],
    }
  },
  None => [FaOpen(h)],
}

// What a declaration states and owes of every label the program declares:
// what a function's return answers or endorses and what each parameter
// demands, and, for a value, the source that can reach it. One line each;
// none where the declaration has nothing to say of any label.
fn flow_facts(d) = program_labels() |> flat_map(label_facts(d, ??))

// Every label a type declaration of the program names: each the op and the
// name its author wrote it by, once.
fn program_labels() = link_program() |> flat_map(decl_labels) |> fold([], label_add)

fn label_add(acc, l) = if any({ k => fst_of(k) == fst_of(l) }, acc) { acc } else { push(acc, l) }

fn fst_of(pair) = match pair {
  (a, _) => a,
}

fn decl_labels(d) = match graph_node_body(d) {
  NStmt(RefineStmt(_, _, pred)) => pred_labels(node_to_predicate(pred)),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

fn pred_labels(pred) = match pred {
  PBoolNode(h) => match label_of(h) {
    Some(op) => [(op, label_name(h))],
    None => [],
  },
  PNot(inner) => pred_labels(inner),
  PAnd(a, b) => pred_labels(a) ++ pred_labels(b),
  POr(a, b) => pred_labels(a) ++ pred_labels(b),
  PWithSelf(_, inner) => pred_labels(inner),
  PTrue | PCompare(_, _, _) | PPatternMatch(_, _) | PTotalDiv(_, _, _) | PProvides(_)
  | PInBounds(_, _) => [],
}

fn label_facts(d, label) = match label {
  (op, name) => match graph_node_body(d) {
    NStmt(FnStmt(fname, _, _, _, _)) => fn_label_facts(d, fname, op, name) ++ decl_claim_facts(d, op),
    NStmt(LetStmt(_, value, _)) => value_label_facts(value, op, name) ++ decl_claim_facts(d, op),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [],
  },
}

// Every claim naming the label inside a declaration, with what the settle
// decided of it: proven, refused, or owed.
fn decl_claim_facts(d, op) =
  (verify_decided() |> flat_map(decided_claim_fact(d, op, ??))) ++ (verify_debt() |> flat_map(owed_claim_fact(d, op, ??)))

fn decided_claim_fact(d, op, entry) = match entry {
  (modh, span, pred, held) => if claim_within(d, op, modh, span, pred) {
    [if held { "proven" } else { "refused" } ++ ": {show_predicate(pred)} at {show_span(span)}"]
  } else {
    []
  },
}

fn owed_claim_fact(d, op, entry) = match entry {
  (modh, span, pred, why) => if claim_within(d, op, modh, span, pred) {
    ["owed: {show_predicate(pred)} at {show_span(span)} — {show_reason(why)}"]
  } else {
    []
  },
}

fn claim_within(d, op, modh, span, pred) =
  modh == graph_module_of(d) && span_contains(graph_span_of(d), span) && any({ l => fst_of(l) == op }, pred_labels(pred))

fn fn_label_facts(d, fname: String, op, name: String) = match published_fn_ty(d) {
  Some(TFun(params, ret, _)) => {
    let answers = match ret_states(d, op) {
      Some(true) => ["`{fname}` answers {name}"],
      Some(false) => ["`{fname}` endorses: what it answers carries no {name}"],
      None => answer_label_facts(d, fname, op, name),
    }
    answers ++ flat_map(param_label_fact(fname, op, name, ??), params)
  },
  None | Some(_) => [],
}

// What brings the label into what a function answers, from beyond what it
// is handed: the first source its return tails reach, as the walk met it.
fn answer_label_facts(d, fname: String, op, name: String) = {
  let ctx = {install: 0, label: op, name, self: 0}
  let atoms = until_settled(flow_fact(ctx, d, ??), FfAnswer) ~> flow_summaries(flow_stores())
  match find_map(atom_source, atoms) {
    Some(chain) => ["what `{fname}` answers carries {name}: {show_reason(chain)}"],
    None => atoms |> flat_map(open_fact(fname, ??)),
  }
}

fn open_fact(fname: String, a) = match a {
  FaOpen(h) => ["what `{fname}` answers is out of sight at {site_address(h)}"],
  FaSource(_) | FaArg(_) | FaParam(_) | FaReach(_) => [],
}

fn param_label_fact(fname: String, op, name: String, p) = match ty_states(bound_ty(param_ty(p)), op) {
  Some(true) => ["`{fname}` demands of `{param_name(p)}`: {name}"],
  Some(false) => ["`{fname}` demands of `{param_name(p)}`: no {name}"],
  None => [],
}

fn walked_flow(ctx, h) = value_flow(ctx, h) ~> flow_walk

fn value_label_facts(value, op, name: String) = {
  let ctx = {install: 0, label: op, name, self: 0}
  let atoms = until_settled(walked_flow(ctx, ??), value) ~> flow_summaries(flow_stores())
  match find_map(atom_source, atoms) {
    Some(chain) => [show_reason(chain)],
    None => [],
  }
}

// A label literal in a predicate: the atom's node, the op, and whether it
// states the label or its absence.
fn label_literal(pred) = match pred {
  PBoolNode(h) => match label_of(h) {
    Some(op) => Some((h, op, true)),
    None => None,
  },
  PNot(PBoolNode(h)) => match label_of(h) {
    Some(op) => Some((h, op, false)),
    None => None,
  },
  PTrue | PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PPatternMatch(_, _)
  | PWithSelf(_, _) | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _) => None,
}

fn conjuncts(pred) = match pred {
  PAnd(a, b) => conjuncts(a) ++ conjuncts(b),
  PTrue | PCompare(_, _, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
  | PWithSelf(_, _) | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _) => [pred],
}

fn label_name(lit) = match graph_node_body(lit) {
  NExpr(CallExpr(callee, _)) => show_callee_name(callee),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => "the label",
}

// What a claim's decision leaves: its verdict, and the chain from a source
// where one reaches it.
fn flow_verdict(v) = {chain: None, verdict: v}

// One literal read at a subject: whether a source can reach its value. What
// every call hands a parameter and whether a function runs are summaries of
// their own, read through until only sources and what the walk cannot read
// remain.
fn literal_verdict(subject, lit, op, holds) = {
  let ctx = {install: 0, label: op, name: label_name(lit), self: 0}
  let atoms = expand(ctx, value_flow(ctx, subject) ++ reach_flow(ctx, subject) ~> flow_walk)
  match find_map(atom_source, atoms) {
    Some(chain) => {chain: Some(chain), verdict: Some(holds)},
    None => match find(atom_open, atoms) {
      Some(FaOpen(h)) => {chain: Some(Inferred("what can reach it is out of sight at {site_address(h)}")), verdict: None},
      None | Some(_) => flow_verdict(Some(!holds)),
    },
  }
}

// A demand read through: what every call of a function hands its parameter,
// and whether the function runs.
fn expand(ctx, atoms) = expand_from(ctx, atoms, [], [])

fn expand_from(ctx, todo, seen, out) = match todo {
  [] => out,
  [a, ...rest] => if any(atom_same(a, ??), seen) {
    expand_from(ctx, rest, seen, out)
  } else {
    match a {
      FaArg(b) => expand_from(ctx, rest ++ handed(ctx, b), push(seen, a), out),
      FaParam(b) => expand_from(ctx, rest ++ handed(ctx, b), push(seen, a), out),
      FaReach(fd) => expand_from(ctx, rest ++ flow_fact(ctx, fd, FfReach), push(seen, a), out),
      FaSource(_) | FaOpen(_) => expand_from(ctx, rest, push(seen, a), push(out, a)),
    }
  },
}

fn handed(ctx, b) = match graph_parent_of(b) {
  Some(fd) => flow_fact(ctx, fd, FfHanded(param_slot(fd, b))),
  None => [FaOpen(b)],
}

// What every call of a declared function hands its parameter at a slot: the
// argument at each call, and what decides whether the call runs; where the
// function is handed on as a value, what the function it is handed to hands
// it there, and anywhere else values out of sight.
fn handed_of(ctx, d, k) =
  (graph_applies_of(d) |> flat_map({ app => slot_flow(ctx, app, k) ++ reach_flow(ctx, app) })) ++ (graph_refs_of(d) |> filter(escapes) |> flat_map(escape_hand(ctx, k, ??)))

fn slot_flow(ctx, app, k) = match nth_handle(applied_args(app), k) {
  Some(found) => flat_map(value_flow(ctx, ??), found),
  None => [FaOpen(app)],
}

fn escape_hand(ctx, k, r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(_, _)) => reach_flow(ctx, q) ++ passed_on(ctx, q, r, FfHand(0, k)),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(r)],
  },
  None => [FaOpen(r)],
}

// Whether a declared function runs: what decides whether each call of it
// runs, and whether the function it is handed to as a value applies it.
fn reached_of(ctx, d) =
  (graph_applies_of(d) |> flat_map(reach_flow(ctx, ??))) ++ (graph_refs_of(d) |> filter(escapes) |> flat_map(escape_apply(ctx, ??)))

fn escape_apply(ctx, r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(_, _)) => reach_flow(ctx, q) ++ passed_on(ctx, q, r, FfApply(0)),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => [FaOpen(r)],
  },
  None => [FaOpen(r)],
}

fn atom_source(a) = match a {
  FaSource(chain) => Some(chain),
  FaArg(_) | FaParam(_) | FaReach(_) | FaOpen(_) => None,
}

fn atom_open(a) = match a {
  FaOpen(_) => true,
  FaSource(_) | FaArg(_) | FaParam(_) | FaReach(_) => false,
}

// A claim decided: each conjunct of its predicate a label read by the walk or
// a value read by the fragment, joined as the conjunction joins them; a label
// under a disjunction or a further negation stays open.
fn claim_verdict(subject, pred) =
  fold(flow_verdict(Some(true)), verdict_and, map(conjunct_verdict(subject, ??), conjuncts(pred)))

fn conjunct_verdict(subject, c) = match label_literal(c) {
  Some((lit, op, holds)) => literal_verdict(subject, lit, op, holds),
  None => if pred_names_label(c) {
    flow_verdict(None)
  } else {
    flow_verdict(predicate_decide(PWithSelf(subject, c)))
  },
}

fn verdict_and(a, b) = {
  chain: match a.chain {
    Some(c) => Some(c),
    None => b.chain,
  },
  verdict: and_decide(a.verdict, b.verdict),
}

// The settle: every claim naming a label decided over the judged program, and
// the ledger handed what was decided. A refuted claim is reported where it was
// raised, with the chain from the source that reaches it.
fn flow_settle() = match verify_flows() {
  [] => verify_settle([]),
  claims => {
    let done = until_settled(map(settle_claim, ??), claims) ~> flow_summaries(flow_stores())
    done |> each(report_refuted)
    verify_settle(map({ t => t.entry }, done))
  },
}

fn report_refuted(t) = match t.entry {
  (modh, span, pred, _, Some(false)) => report_at(modh, ERefinementRejected(pred, span, t.why)),
  _ => (),
}

// One claim decided. A claim with no value to read — a contract claimed of a
// part of a value built out of sight — stays owed where it was raised.
fn settle_claim(claim) = match claim {
  (modh, span, pred, reason) => {
    let out = match pred {
      PWithSelf(subject, inner) => claim_verdict(subject, inner),
      PTrue | PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
      | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _) => flow_verdict(None),
    }
    let why = match out.chain {
      Some(c) => c,
      None => reason,
    }
    {entry: (modh, span, pred, why, out.verdict), why}
  },
}

fn escapes(r) = match graph_parent_of(r) {
  Some(q) => match graph_node_body(q) {
    NExpr(CallExpr(callee, _)) => callee != r,
    NExpr(PipeExpr(PForward, _, stage)) => stage != r,
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => true,
  },
  None => true,
}

// The domain a CONTRACT states about its inhabitants. An alias is
// transparent, a refinement meets its base with its predicate's reading, a
// width pin narrows representation and never values; a variable is a cell,
// and a cell holds a shape, so it states nothing.
fn ty_domain(ty) = match ty {
  TAlias(_, inner) => ty_domain(inner),
  TRefined(base, pred) => domain_meet(ty_domain(base), pred_domain(pred)),
  TReprPin(_, base) => ty_domain(base),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
  | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => dom_top(),
}

// The whole fact, in one walk: both ends of what a refinement admits, read
// together. A walk that answers one end alone forces any consumer wanting the
// other to grow a mirror family beside it — two walks over one fact, the
// parallel-arrays drift at the function layer. A leaf's lower bound
// (`leaf_lo`) is this read projected through `domain_lo`, and the bound-meet
// is `domain_meet` at the domain altitude.
//
// It is an OVER-approximation by contract (Domain, types.mn): the reader may
// decide what to construct from it, never what to admit.
fn pred_domain(pred) = match pred {
  PTrue => dom_top(),
  PCompare(op, lh, rh) => compare_domain(op, lh, rh),
  PAnd(a, b) => domain_meet(pred_domain(a), pred_domain(b)),
  POr(a, b) => domain_join(pred_domain(a), pred_domain(b)),
  // The complement of a range is two rays, which DRange cannot hold; the
  // top is the honest superset rather than a bound that would cut inhabitants.
  PNot(_) => dom_top(),
  PBoolNode(_) => DUndecided,
  PPatternMatch(_, _) => DUndecided,
  PWithSelf(_, inner) => pred_domain(inner),
  // a precondition on two operands states nothing about `self`
  PTotalDiv(_, _, _) => dom_top(),
  PInBounds(_, _) => dom_top(),
  PProvides(_) => dom_top(),
}

fn dom_top() = DRange(None, None)

fn is_self_node(handle) = match graph_node_body(handle) {
  NExpr(VarRef(name)) => name == "self",
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => false,
}

// One comparison, read from whichever side `self` stands on: the other side
// must fold to a ground constant, or the fragment stops (DUndecided) rather
// than guessing.
fn compare_domain(op, lh, rh) = if is_self_node(lh) {
  match node_const(rh) {
    Some(v) => self_op_const(op, v),
    None => DUndecided,
  }
} else if is_self_node(rh) {
  match node_const(lh) {
    Some(v) => self_op_const(flip_cmp(op), v),
    None => DUndecided,
  }
} else {
  DUndecided
}

// `n < self` read from self's side is `self > n`. Identity on anything that is
// not a comparison is correct because the one reader answers DUndecided there.
fn flip_cmp(op) with Pure = match op {
  BLt => BGt,
  BGt => BLt,
  BLe => BGe,
  BGe => BLe,
  BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BAnd | BOr | BConcat => op,
}

// `self OP v`. The strict bounds step by one, which is why DRange is integral;
// a non-Int operand answers DUndecided for the ordering ops and still answers
// exactly for equality, where no predecessor is needed.
fn self_op_const(op, v) = match op {
  BEq => DFinite([v]),
  // The complement of one point is not a range; top is the honest superset.
  BNe => dom_top(),
  BLt => match v {
    LVInt(n) => DRange(None, Some(n - 1)),
    LVFloat(_) | LVString(_) | LVBool(_) => DUndecided,
  },
  BLe => match v {
    LVInt(n) => DRange(None, Some(n)),
    LVFloat(_) | LVString(_) | LVBool(_) => DUndecided,
  },
  BGt => match v {
    LVInt(n) => DRange(Some(n + 1), None),
    LVFloat(_) | LVString(_) | LVBool(_) => DUndecided,
  },
  BGe => match v {
    LVInt(n) => DRange(Some(n), None),
    LVFloat(_) | LVString(_) | LVBool(_) => DUndecided,
  },
  // An arithmetic operator in a comparison slot states nothing this
  // fragment can read.
  BAdd | BSub | BMul | BDiv | BMod | BAnd | BOr | BConcat => DUndecided,
}

// MEET — both predicates hold, so the truth is the intersection. An unreadable
// side yields to the readable one: the intersection is a SUBSET of either side,
// so keeping the decided side stays the over-approximation the contract
// requires, and nothing real is cut.
fn domain_meet(a, b) = match a {
  DUndecided => b,
  DFinite(vs) => match b {
    DUndecided => a,
    DFinite(ws) => DFinite(vs |> filter(lit_in(??, ws))),
    DRange(lo, hi) => DFinite(vs |> filter(lit_in_range(??, lo, hi))),
  },
  DRange(la, ha) => match b {
    DUndecided => a,
    DFinite(ws) => DFinite(ws |> filter(lit_in_range(??, la, ha))),
    DRange(lb, hb) => DRange(bound_meet(int_max, la, lb), bound_meet(int_min, ha, hb)),
  },
}

// JOIN — either predicate may hold, so the truth is the union and the reading
// must COVER it. Two ranges give their hull; two finite sets give their
// concatenation, which is exact; anything mixed or unreadable widens to the
// top, because a bound that cannot cover the union would cut inhabitants.
fn domain_join(a, b) = match a {
  DUndecided => dom_top(),
  DFinite(vs) => match b {
    DFinite(ws) => DFinite(vs ++ ws),
    DRange(_, _) => dom_top(),
    DUndecided => dom_top(),
  },
  DRange(la, ha) => match b {
    DRange(lb, hb) => DRange(bound_join(int_min, la, lb), bound_join(int_max, ha, hb)),
    DFinite(_) => dom_top(),
    DUndecided => dom_top(),
  },
}

fn lit_same(a, b) = match litval_eq(a, b) {
  Some(x) => x,
  None => false,
}

fn lit_in(v, ws) = ws |> any(lit_same(v, ??))

// A value outside the range is cut; a value the integral range cannot speak
// about is KEPT, because the meet may only over-approximate.
fn lit_in_range(v, lo, hi) = match v {
  LVInt(n) => bound_admits_lo(lo, n) && bound_admits_hi(hi, n),
  LVFloat(_) | LVString(_) | LVBool(_) => true,
}

fn bound_admits_lo(lo, n) with Pure = match lo {
  Some(l) => n >= l,
  None => true,
}

fn bound_admits_hi(hi, n) with Pure = match hi {
  Some(h) => n <= h,
  None => true,
}

// Two ways to combine a pair of bounds, and only two: under a MEET an open
// side yields to the closed one, because a constraint that says nothing cannot
// loosen a constraint that says something; under a JOIN an open side absorbs,
// because a union with an unbounded set is unbounded. Which END is being
// combined is the comparator, not a flag — the four near-identical combiners
// this replaces differed by one glyph each and were a family where a pair of
// higher-order reads belongs.
fn bound_meet(pick, ea, eb) = match ea {
  Some(a) => match eb {
    Some(b) => Some(pick(a, b)),
    None => ea,
  },
  None => eb,
}

fn bound_join(pick, ea, eb) = match ea {
  Some(a) => match eb {
    Some(b) => Some(pick(a, b)),
    None => None,
  },
  None => None,
}

fn int_max(a, b) with Pure = if a > b { a } else { b }

fn int_min(a, b) with Pure = if a < b { a } else { b }

// The low bound a domain states. A finite set bounds itself; a member the
// integral bound cannot speak about leaves the end open rather than inventing
// one.
fn domain_lo(d) = match d {
  DRange(lo, _) => lo,
  DFinite(vs) => if vs |> all(is_lv_int) { vs |> fold(None, min_of_lit) } else { None },
  DUndecided => None,
}

fn is_lv_int(v) with Pure = match v {
  LVInt(_) => true,
  LVFloat(_) | LVString(_) | LVBool(_) => false,
}

// The guard above admits only integral members, so the other arm carries the
// accumulator untouched rather than inventing a bound for a value it cannot
// read.
fn min_of_lit(acc, v) = match v {
  LVInt(n) => match acc {
    Some(a) => if n < a { Some(n) } else { Some(a) },
    None => Some(n),
  },
  LVFloat(_) | LVString(_) | LVBool(_) => acc,
}

// Bind the refinement's `self` to the value node being refined. A predicate's
// operands are node HANDLES (types.mn Predicate) and `self` may sit NESTED inside
// an arithmetic operand (`self + 1`, `self % 2`), so a physical operand swap
// could not reach it without minting a rewritten node. Carry the binding as data
// instead — PWithSelf(value_handle, pred) — and predicate_decide_at threads it
// into every node_const_at. One binder resolves every `self`, top-level and
// nested, the same way; carry the handle, read live, mint nothing.
fn subst_self(pred, value_handle) = PWithSelf(value_handle, pred)

// The candidate gate's refinement half: a candidate SURFACES only when the
// target's refinement DECIDES true on it (PLAN §5 sample-then-filter — the
// proven survivors, which may be none). An undecided predicate is not a
// proof, and assume-true is the Dafny {:axiom} cautionary the ledger
// exists to refuse. Transparent aliases recurse; an unrefined target
// admits by type alone.
fn refinement_admits(ty, value_handle) = match ty {
  // A candidate whose every leaf already NAMES the refinement — a
  // parameter's precondition, a callee's declared return — is admitted
  // by that identity, which proves the declaration, never its discharge.
  // The layering is deliberate, each proof question at its one home: a
  // callee's return obligation lives in the ledger AT ITS decl
  // (discharged, pending, or refuted THERE); a refuted callee already
  // fails the program's own check leg (E_RefinementRejected at the decl),
  // so admitting its call here changes nothing observable; and executable
  // refusal on remaining debt is R5's gate at the emit boundary. The synth
  // gate answers only "does this filling fit the target type" — it never
  // re-decides a proof another site owns.
  TAlias(aname, inner) => value_carries_alias(value_handle, aname) || refinement_admits(inner, value_handle),
  TRefined(base, pred) => refinement_admits(base, value_handle) && match predicate_decide(subst_self(pred, value_handle)) {
    Some(decided) => decided,
    None => false,
  },
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
  | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TValue(_) => true,
}

// Fold a comparison over two constant operand values.
// Total over the comparison operators: the three the grammar spells the
// other way round are the same three questions with the operands swapped
// or the answer negated, and `self != 0` is what a NonZero refinement says.
fn litval_compare(ref op, ref a, ref b) = match op {
  BEq => litval_eq(a, b),
  BNe => not_decide(litval_eq(a, b)),
  BLt => litval_lt(a, b),
  BLe => litval_le(a, b),
  BGt => litval_lt(b, a),
  BGe => litval_le(b, a),
  BAdd | BSub | BMul | BDiv | BMod | BAnd | BOr | BConcat => None,
}

// Equality over constants. Same-kind compares; cross-kind is Some(false)
// (different-kind constants are unequal — a stronger refusal than None).
fn litval_eq(ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => Some(na == nb),
    LVFloat(_) => Some(false),
    LVString(_) => Some(false),
    LVBool(_) => Some(false),
  },
  LVFloat(fa) => match b {
    LVInt(_) => Some(false),
    LVFloat(fb) => Some(fa == fb),
    LVString(_) => Some(false),
    LVBool(_) => Some(false),
  },
  LVString(sa) => match b {
    LVInt(_) => Some(false),
    LVFloat(_) => Some(false),
    LVString(sb) => Some(sa == sb),
    LVBool(_) => Some(false),
  },
  LVBool(ba) => match b {
    LVInt(_) => Some(false),
    LVFloat(_) => Some(false),
    LVString(_) => Some(false),
    LVBool(bb) => Some(ba == bb),
  },
}

// Strict order over numeric constants; strings/bools carry no order
// here (None — defer); cross-kind numeric is None.
fn litval_lt(ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => Some(na < nb),
    LVFloat(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVFloat(fa) => match b {
    LVInt(_) => None,
    LVFloat(fb) => Some(fa < fb),
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVString(_) => None,
  LVBool(_) => None,
}

fn litval_le(ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => Some(na <= nb),
    LVFloat(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVFloat(fa) => match b {
    LVInt(_) => None,
    LVFloat(fb) => Some(fa <= fb),
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVString(_) => None,
  LVBool(_) => None,
}

// Fold an arithmetic BinOp over two OPTIONAL ground operands (the decidable
// fragment); either None makes the fold None.
fn litval_arith_opt(op, ref ea, ref eb) = match ea {
  Some(a) => match eb {
    Some(b) => litval_arith(op, a, b),
    None => None,
  },
  None => None,
}

// Fold +,-,*,/,% over two ground operands. SAME-KIND only: Int op Int -> Int,
// Float op Float -> Float; cross-kind -> None (a genuine type mismatch the
// comparison above already refuses). Strings/bools carry no arithmetic. The
// operands are bound through the LVInt/LVFloat PATTERN — exactly like
// litval_lt/litval_le — so na/nb are Int and fa/fb are Float; a bare helper
// param defaults to the i32 floor and stores an int where an f64 belongs.
// Int folds through the one integer folder (types.mn `int_fold`), which folds
// a division only where its claim holds at the two points — folding one that
// traps would LIE, and folding it with the host's own division trapped the
// compiler. Float folds use the
// compiler's own f64 ops (identical wasm IEEE-754 semantics; f64 `/ 0.0` is
// inf/nan, not a trap). No float modulo; a comparison/logical op defers to None.
fn litval_arith(ref op, ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => match int_fold(op, na, nb) {
      Some(v) => Some(LVInt(v)),
      None => None,
    },
    LVFloat(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVFloat(fa) => match b {
    LVFloat(fb) => match op {
      BAdd => Some(LVFloat(fa + fb)),
      BSub => Some(LVFloat(fa - fb)),
      BMul => Some(LVFloat(fa * fb)),
      BDiv => Some(LVFloat(fa / fb)),
      BMod | BEq | BNe | BLt | BGt | BLe | BGe | BAnd | BOr | BConcat => None,
    },
    LVInt(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVString(_) => None,
  LVBool(_) => None,
}

// Fold a unary op over an OPTIONAL ground operand. UNeg negates a numeric
// constant (the source of `-1.0` / `-3`); UNot is boolean, outside the
// arithmetic fragment (defer to None).
fn litval_unary_opt(op, ref e) = match e {
  Some(v) => litval_unary(op, v),
  None => None,
}

fn litval_unary(ref op, ref v) = match op {
  UNeg => match v {
    LVInt(n) => Some(LVInt(0 - n)),
    LVFloat(f) => Some(LVFloat(0.0 - f)),
    LVString(_) => None,
    LVBool(_) => None,
  },
  UNot => None,
}

// Conjunction with three-valued short-circuit. Some(false) on either
// branch decides the conjunction false regardless; Some(true) on both
// decides true; mixed Some(true) + None defers to None (the unknown
// branch is still load-bearing); Some(true) + Some(true) is the only
// fully-decidable true.
fn and_decide(ref ea, ref eb) = match ea {
  Some(false) => Some(false),
  Some(true) => match eb {
    Some(false) => Some(false),
    Some(true) => Some(true),
    None => None,
  },
  None => match eb {
    Some(false) => Some(false),
    Some(true) => None,
    None => None,
  },
}

fn or_decide(ref ea, ref eb) = match ea {
  Some(true) => Some(true),
  Some(false) => match eb {
    Some(true) => Some(true),
    Some(false) => Some(false),
    None => None,
  },
  None => match eb {
    Some(true) => Some(true),
    Some(false) => None,
    None => None,
  },
}

fn not_decide(ref e) = match e {
  Some(true) => Some(false),
  Some(false) => Some(true),
  None => None,
}

// A claim's one perform: the installed ledger answers its verdict — proven,
// refused, open — and the site reports a refusal from the body, inside every
// capture bracket the judgment installed, since an arm's performs resolve
// outside its own install. A label's presence is never claimed: a value may
// always be handled as though a source had reached it, so a position declared
// to hold the label demands nothing of what it is handed, and the walk reads
// the declaration as a source instead. Only the label's absence is owed.
fn verify_claim(modh, span, pred, reason) = match owed_of(pred) {
  None => Some(true),
  Some(owed) => {
    let verdict = verify(modh, span, owed, reason)
    match verdict {
      Some(false) => report_refinement_rejected(owed, span, reason),
      None | Some(_) => (),
    }
    verdict
  },
}

fn owed_of(pred) = {
  let owed = if pred_names_label(pred) { without_presence(pred) } else { pred }
  if owed == PTrue { None } else { Some(owed) }
}

fn without_presence(pred) = match pred {
  PBoolNode(h) => if label_of(h) == None { pred } else { PTrue },
  PAnd(a, b) => match without_presence(a) {
    PTrue => without_presence(b),
    oa @ (
      PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
      | PWithSelf(_, _) | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _)
    ) => match without_presence(b) {
      PTrue => oa,
      ob @ (
        PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
        | PWithSelf(_, _) | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _)
      ) => PAnd(oa, ob),
    },
  },
  POr(a, b) => match without_presence(a) {
    PTrue => PTrue,
    oa @ (
      PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
      | PWithSelf(_, _) | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _)
    ) => match without_presence(b) {
      PTrue => PTrue,
      ob @ (
        PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
        | PWithSelf(_, _) | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _)
      ) => POr(oa, ob),
    },
  },
  PWithSelf(s, inner) => match without_presence(inner) {
    PTrue => PTrue,
    owed @ (
      PCompare(_, _, _) | PAnd(_, _) | POr(_, _) | PNot(_) | PBoolNode(_) | PPatternMatch(_, _)
      | PWithSelf(_, _) | PTotalDiv(_, _, _) | PProvides(_) | PInBounds(_, _)
    ) => PWithSelf(s, owed),
  },
  PTrue | PCompare(_, _, _) | PNot(_) | PPatternMatch(_, _) | PTotalDiv(_, _, _) | PProvides(_)
  | PInBounds(_, _) => pred,
}

// Compile-time refusal at the construction site. The verifier proved
// the predicate false from constant inputs alone — the construction
// is invariant-violating by literal evidence. Span is the call site;
// reason carries the predicate-as-Why for the chain-walker.
fn report_refinement_rejected(ref pred, ref span, ref reason) with !Mutate =
  report(ERefinementRejected(pred, span, reason))

// The pending ledger speaks WHOLE — one line per obligation (span,
// class, predicate) before the summary count. The count alone hid the
// debt's composition: the 2026-07-30 sweep classified 138 obligations
// only by growing per-entry projections one file at a time; this is
// the complete projection at the one place the whole ledger is read.
// Spans render as the developer's own file:line through the graph's
// NModule seams — the weave coordinate was hand-mapped four times in
// one session before this projection existed.
fn report_verify_debt(debt) = if len(debt) == 0 {
  ()
} else {
  // The per-obligation lines apply the register's own law PER SPAN
  // (the diag_report arm's exact test): a user's OWN pending renders —
  // it is their teaching surface ("this claim was not checked") — while
  // the wheel's obligations (types.mn spans printed on every
  // hello-world, the audit's measured flood) stay the census
  // channel's. ScopeAll keeps every line; the SUMMARY counts the same
  // obligations the lines render — the project's own — so a six-line
  // program never answers for the runtime library's open claims. Measured
  // 2026-10-12 against the whole-ledger count this replaces: a hello-world
  // reported seventeen obligations it had no way to discharge, every one
  // the library's, while the lines beside the count filtered them out.
  let scope = diag_scope_of()
  debt |> each(debt_line(scope, ??))
  // The summary is reported at the module of an obligation it counts — the
  // project's own — never at whichever module the judgment entered last,
  // which under the project register could be the library's and hide it.
  match filter({ (modh, _, _, _) => debt_in_scope(modh, scope) }, debt) {
    [] => (),
    [first, ...rest] => match first {
      (modh, _, _, _) => report_at(modh, VPending(len(rest) + 1, span_zero())),
    },
  }
}

// One open obligation's line, where the scope renders it: the span is the
// developer's own coordinate and the module rides the obligation, so scoping
// is a compare of modules.
fn debt_line(ref scope, entry) = match entry {
  (modh, dspan, pred, _) => if debt_in_scope(modh, scope) {
    eprint_string("verify: {obligation_text(modh, dspan, pred)}\n")
  } else {
    ()
  },
}

// One open obligation said once: the ledger's summary lines and the Verify
// facet at a caret read the same sentence.
fn obligation_text(modh, dspan, pred) =
  "pending {classify_predicate(pred)} {show_predicate(pred)} at {module_name_of_handle(modh)}:{show_span(dspan)}"

fn debt_in_scope(modh, ref scope) = match scope {
  ScopeAll => true,
  ScopeNone => false,
  ScopeProject(layer) => module_layer_of_handle(modh) == layer,
}

fn classify_predicate(pred) with Pure = match pred {
  PTrue => "trivial",
  PNot(_) => "negation",
  PAnd(_, _) => "conjunction",
  POr(_, _) => "disjunction",
  PCompare(_, _, _) => "comparison",
  PBoolNode(_) => "graph-deferred",
  PPatternMatch(_, _) => "shape",
  // the binder classifies as its body
  PWithSelf(_, inner) => classify_predicate(inner),
  PTotalDiv(_, _, _) => "partiality",
  PInBounds(_, _) => "partiality",
  PProvides(_) => "provision",
}

// An open claim as an SMT-LIB query, asserting its NEGATION: an external
// solver's UNSAT proves the claim for every assignment and its SAT is a
// counterexample, so the text the smt facet prints is the question whose
// answer is a certificate the kernel can check.
fn predicate_to_smt_lib(ref pred) = "(assert {predicate_to_smt(pred)})\n(check-sat)"

fn predicate_to_smt(ref pred) = match pred {
  PTrue => "true",
  PCompare(op, l, r) => "({smt_cmp_op(op)} {handle_to_smt(l)} {handle_to_smt(r)})",
  PAnd(a, b) => smt_logop("and", a, b),
  POr(a, b) => smt_logop("or", a, b),
  PNot(inner) => "(not {predicate_to_smt(inner)})",
  PBoolNode(n) => handle_to_smt(n),
  PPatternMatch(_, n) => handle_to_smt(n),
  // The self binder renders as its body — `self` stays symbolic in SMT-LIB
  // (the solver's declared variable), exactly the diagnostic's reading.
  PWithSelf(_, inner) => predicate_to_smt(inner),
  PTotalDiv(op, a, b) => match op {
    BMod => "(distinct {handle_to_smt(b)} 0)",
    BAdd | BSub | BMul | BDiv | BEq | BNe | BLt | BGt | BLe | BGe | BAnd | BOr | BConcat => "(and (distinct {handle_to_smt(b)} 0) (or (distinct {handle_to_smt(b)} (- 1)) (distinct {handle_to_smt(a)} (- 2147483648))))",
  },
  PInBounds(recv, idx) => "(and (<= 0 {handle_to_smt(idx)}) (< {handle_to_smt(idx)} (len {handle_to_smt(recv)})))",
  PProvides(_) => "true",
}

fn smt_cmp_op(ref op) with Pure = match op {
  BEq => "=",
  BNe => "distinct",
  BLt => "<",
  BLe => "<=",
  BGt => ">",
  BGe => ">=",
  BAdd | BSub | BMul | BDiv | BMod | BAnd | BOr | BConcat => "=",
}

fn smt_logop(ref op, ref a, ref b) = "({op} {predicate_to_smt(a)} {predicate_to_smt(b)})"

// ONE SMT-render projection, keyed on HANDLES throughout (Carried-Truth: the
// predicate's operands ARE handles into the one graph; every operand — top-
// level and nested call arg — is resolved via graph_node_body and rendered
// uniformly, never a second node-destructure path). Follow the edge, read the
// live node — the AST-in-graph fabric makes every sub-node a resolvable handle.
// THE `body_to_smt(graph_node_body(h))` SPLIT WAS THE DEFECT, and the probe
// that found it is worth more than the fix. Wiring this serializer to a
// projection (`mentl query <f> "smt"`) ran it for the first time, and on the
// wheel's own `type Sample = Float where 0.0 - 1.0 <= self && …` it rendered
// `(- 66664 686237016)` where `show_predicate` — reading THE SAME predicate
// handles — rendered `0.0 - 1.0`. So the graph was sound and the serializer
// was not, which the comparison settled in one command.
//
// The second number MOVED between two builds of identical source (686234536 →
// 686237016), which is what named it: a heap POINTER printed through the
// `LitInt` arm, not a stored literal. The difference from the working sibling
// is that `show_pred_operand` matches `graph_node_body(handle)` INLINE while
// this passed the NodeBody across a call boundary first — so the float
// variant's payload arrived as a word and matched the wrong arm. Dropping the
// four `ref` markers first REFUTED the borrow-marker hypothesis (the numbers
// moved but stayed wrong), which is the only reason this one is trustworthy.
//
// The one read, inline, exactly as the sibling does it.
fn handle_to_smt(handle) = match graph_node_body(handle) {
  NExpr(LitInt(n)) => int_to_str(n),
  NExpr(LitFloat(f)) => float_to_str(f),
  NExpr(LitString(s)) => "\"{s}\"",
  NExpr(LitBool(b)) => if b { "true" } else { "false" },
  NExpr(VarRef(name)) => name,
  NExpr(CallExpr(callee, args)) => smt_call(callee, args),
  NExpr(BinOpExpr(op, l, r)) => smt_binop(op, l, r),
  NExpr(UnaryOpExpr(op, x)) => smt_unop(op, x),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => {
    report(EVerifyUnencodable(span_zero()))
    "false"
  },
}

// Every node-kind that can appear in a refinement-predicate operand is
// enumerated above; a genuinely non-encodable shape raises
// E_VerifyUnencodable (Located) and renders the unsat-forcing sentinel
// `false` — NEVER a fabricated `true` (a `true` fallback in a PROOF GATE
// claims proof of the unprovable — the most dangerous silent fallback in the
// compiler; the no-silent-fallback law, deleted not wrapped). A call's args
// are HANDLES (the AST-in-graph fabric), mapped through handle_to_smt — no
// i/n index loop.
//
// A call renders as `(fname arg…)` with every arg resolved through its handle
// (the operand-Node channel PCompare already uses); the fname is the callee's
// name read live from its node body, or the unencodable sentinel if it is not a
// bare name reference.
fn smt_call(callee, args) = {
  let fname = match graph_node_body(callee) {
    NExpr(VarRef(n)) => n,
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => {
      report(EVerifyUnencodable(span_zero()))
      "false"
    },
  }
  "({fname}{smt_arg_terms(args)})"
}

// Each arg is a handle — map through handle_to_smt and join (map/fold, never an
// imperative i/n counter; Anchor 6).
fn smt_arg_terms(args) = fold("", (acc, arg) => "{acc} {handle_to_smt(arg)}", args)

fn smt_binop(op, l, r) = "({smt_binop_sym(op)} {handle_to_smt(l)} {handle_to_smt(r)})"

fn smt_unop(op, x) = match op {
  UNot => "(not {handle_to_smt(x)})",
  UNeg => "(- {handle_to_smt(x)})",
}

// Every BinOp rendered to its SMT-LIB symbol — exhaustive over the ADT (no
// `_ => "="` fabrication that would mis-render `%`/`*` as equality in a
// predicate like `self % 2 == 0`).
fn smt_binop_sym(ref op) with Pure = match op {
  BAdd => "+",
  BSub => "-",
  BMul => "*",
  BDiv => "div",
  BMod => "mod",
  BEq => "=",
  BNe => "distinct",
  BLt => "<",
  BGt => ">",
  BLe => "<=",
  BGe => ">=",
  BAnd => "and",
  BOr => "or",
  BConcat => "str.++",
}
