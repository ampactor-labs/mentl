// verify.mn — refinement obligation ledger + decidable-subset
//             compile-time discharge (spec 02 · spec 06)
//
// verify_ledger is the substrate-level Verify handler. It accumulates
// every obligation (span, predicate, reason) without solving — code
// compiles; obligations are visible, countable, queryable via
// `mentl query verification`. Real solving is a sibling handler
// (verify_smt, dispatching to Z3 / cvc5 / Bitwuzla) installed by
// post-cascade Arc F.1; the swap surface IS the thesis. Source
// unchanged across the swap; the ~> chain names which handler
// discharges obligations at any given pipeline route.
//
// Per primitive #6 (refinement types), the wheel-canonical handler
// discharges ITS DECIDABLE SUBSET at compile time before deferring to
// the ledger. Predicates whose leaves are constants (PInt / PFloat /
// PString) decide to Some(true) | Some(false) via predicate_decide;
// proven-true predicates produce no debt; proven-false predicates emit
// E_RefinementRejected immediately at the construction site;
// undecidable predicates (PVar / PApp / PCall reachable through the
// recursion) fall through to the ledger as before. The Arc F.1 swap
// to verify_smt narrows the undecidable set further; the discharge
// path stays identical.
import types

import graph

import io

// Discharges the decidable subset compile-time; defers the rest to
// the ledger. The simplest demonstration that the handler-swap
// thesis works on the compiler's own core: the gap between "ledger
// only" and "full SMT solver" is hosted by the handler mechanism
// itself. Swap for `verify_smt` (Arc F.1) with zero source changes —
// the swap targets the undecidable arm; the decidable arm here stays
// load-bearing across the swap.
handler verify_ledger with debt = [] {
  verify(modh, span, predicate, reason) => match predicate_decide(predicate) {
    Some(true) => resume(Some(true)),
    Some(false) => resume(Some(false)),
    None => resume(None) with debt = [(modh, span, predicate, reason)] ++ debt,
  },
  verify_debt() => resume(debt),
  verify_reset() => resume() with debt = [],
}

// Compile-time decidable discharge. Returns Some(true) when the predicate
// proves true on its GROUND operands alone; Some(false) when it proves false;
// None at the undecidable boundary (a free variable with no `self` binding, a
// call, a non-constant expression) — defers to the ledger or the SMT tier.
//
// A PCompare decides iff BOTH operands reduce to ground constants under the
// current `self` binding — the decidable ARITHMETIC FRAGMENT: literals, `self`
// resolved to its value node, and +,-,*,/,% over same-kind Int/Float operands
// (node_const_at). litval_compare folds the comparison; cross-kind equality is
// Some(false), cross-kind ordering is None. PAnd/POr/PNot recurse with
// three-valued short-circuit; PWithSelf rebinds `self` over its inner predicate.
fn predicate_decide(ref pred) = predicate_decide_at(pred, NoSelf)

// What `self` resolves to while a predicate is decided: nothing (a bare
// claim — `self` is undecidable), the VALUE NODE a claim was raised over
// (PWithSelf's binder, read live through its joins), or a GROUND CONSTANT
// — the implication read, which asks a refinement whether it admits one
// point (`contract_excludes`). It was a handle with 0 for "none", the
// flag-as-int the drift catalog names; the three readings are three
// constructors now.
type SelfBind = NoSelf | SelfNode(Int) | SelfVal(LitValue)

fn predicate_decide_at(ref pred, bind) = match pred {
  PTrue => Some(true),
  PCompare(op, l, r) => compare_decide_at(op, l, r, bind),
  PAnd(a, b) => and_decide(predicate_decide_at(a, bind), predicate_decide_at(b, bind)),
  POr(a, b) => or_decide(predicate_decide_at(a, bind), predicate_decide_at(b, bind)),
  PNot(inner) => not_decide(predicate_decide_at(inner, bind)),
  PBoolNode(_) => // a bool expr node — the SMT tier resolves it live
  None,
  PPatternMatch(_, _) => // match-narrowing — the SMT tier evaluates
  None,
  PFlowLe(a, b) => // IFC: finite lattice, always decidable
  Some(flow_le(a, b)),
  PWithSelf(sh, inner) => // bind `self` = sh over inner, through its tails when sh is a join
  decide_with_self(inner, SelfNode(sh)),
  PTotalDiv(op, a, b) => total_div_decide(op, a, b, bind),
}

// ─── Partiality — a primitive's precondition decided as a claim (C5) ──
//
// Integer `/` and `%` trap on a zero divisor, and `/` on INT_MIN / -1 (the
// one quotient a signed word cannot hold). The claim decides from what the
// graph holds about the two operands: a constant decides a face outright,
// and a face a constant refutes REFUSES (`1 / 0` is never the program's
// meaning); a non-constant operand asks its refined type whether it EXCLUDES
// the fatal point — `Positive` excludes 0 and -1, a NonZero refinement
// excludes 0 alone, a NonNegative one on the dividend excludes INT_MIN —
// and an operand nothing bounds leaves the face open, which is the row
// fact `Trap` at the site. The answer is a ROW fact, so it stands only on
// what is proven or assumed under contract (`leaves_exclude`), never on a
// postcondition still owed or on the overflow-blind Add fold.
fn total_div_decide(op, a, b, bind) = match op {
  BMod => node_excludes(b, 0, bind),
  BDiv => and_decide(
    node_excludes(b, 0, bind),
    or_decide(node_excludes(b, 0 - 1, bind), node_excludes(a, i32_min(), bind))
  ),
  _ => Some(true),
}

// Is the value at `h` provably not `k`? A constant answers outright (equal
// is Some(false) — the refutation); otherwise every leaf of the value must
// exclude the point; otherwise open.
fn node_excludes(h, k, bind) = match node_const_at(h, bind) {
  Some(v) => not_decide(litval_eq(v, LVInt(k))),
  None => if leaves_exclude(value_leaves(h, bind), k) { Some(true) } else { None },
}

// THE IMPLICATION READ: a contract excludes a point exactly when one of its
// predicates decides FALSE with `self` bound to that point — `0 < self` at 0
// is false, so `Positive` excludes 0; `self % 2 == 0` at 0 is true, so an
// Even refinement admits it. Every predicate down the alias chain is asked,
// since a refinement of a refinement holds both. No implication engine: the
// fragment that decides claims decides this one, over the ground constant
// the SelfVal binding carries.
fn contract_excludes(c, k) = match c {
  TAlias(_, inner) => contract_excludes(inner, k),
  TRefined(base, pred) => pred_excludes(pred, k) || contract_excludes(base, k),
  TReprPin(_, base) => contract_excludes(base, k),
  _ => false,
}

fn pred_excludes(pred, k) = match predicate_decide_at(pred, SelfVal(LVInt(k))) {
  Some(false) => true,
  _ => false,
}

// The least signed word: the one dividend whose quotient by -1 does not fit.
fn i32_min() with Pure = 0 - 2147483647 - 1

// A claim about a JOIN's value is a claim about every value the join can
// take, and an `if`, a `match` or a block takes exactly its tails' values —
// so a claim over one decides as the AND of the claim over each tail
// (`and_decide`: true when every tail proves it, false the moment one
// refutes it, open otherwise). It reads STRUCTURE only, as the value walk
// below does; a join's leaves (`value_leaves`) are the same AND one altitude
// over, at the constant fragment.
// A tail the text writes is judged even where no execution reaches it: the
// signature claims every tail. Until 2026-09-27 a claim over a join was
// never decided, so `fn note_hz(k) -> Hz = match k { 0 => 220.0, … }` left a
// pending obligation behind every literal-armed match.
fn decide_with_self(inner, bind) = match bind {
  SelfNode(sh) => match join_tails(sh) {
    Some(tails) => fold(Some(true), decide_tail(inner, ??, ??), tails),
    None => predicate_decide_at(inner, bind),
  },
  _ => predicate_decide_at(inner, bind),
}

fn decide_tail(inner, acc, tail) = and_decide(acc, decide_with_self(inner, SelfNode(tail)))

// A JOIN's tails: the nodes whose values the join takes — an `if`'s two
// branches, every `match` arm's body, a block's final expression; None for
// a node that is not a join. One home for the structure that the claim
// decided over a join, the value walk and the claim noted over a join each
// fold.
fn join_tails(h) = match graph_node_body(h) {
  NExpr(IfExpr(_, t, e)) => Some([node_handle(t), node_handle(e)]),
  NExpr(MatchExpr(_, arms)) => Some(arms |> map(tail_of_arm)),
  NExpr(BlockExpr(_, final_expr)) => Some([node_handle(final_expr)]),
  _ => None,
}

fn tail_of_arm(arm) = match arm {
  (_, body) => node_handle(body),
}

// A comparison decides iff BOTH operands reduce to ground constants under the
// current `self` binding — or, with a ground LEFT and a structural right, the
// interval fragment proves `n <= X` from X's lower bound; otherwise None.
fn compare_decide_at(op, lh, rh, bind) = match node_const_at(lh, bind) {
  Some(lv) => match node_const_at(rh, bind) {
    Some(rv) => litval_compare(op, lv, rv),
    None => interval_ge_decide(op, lv, rh, bind),
  },
  None => None,
}

// `n <= X` / `n < X` with ground left: proves when X's structural LOWER BOUND
// reaches n. PROVES only, never refutes — a bound that fails to reach n says
// nothing about X's values (None keeps the obligation live and honest).
fn interval_ge_decide(ref op, ref lv, rh, bind) = match lv {
  LVInt(n) => match leaves_lo(value_leaves(rh, bind)) {
    Some(lo) => match op {
      BLe => if n <= lo { Some(true) } else { None },
      BLt => if n < lo { Some(true) } else { None },
      _ => None,
    },
    None => None,
  },
  _ => None,
}

// Resolve an operand HANDLE to a ground constant, reading the Expr LIVE from the
// graph — the decidable arithmetic fragment. A literal folds to itself; `self`
// resolves to the value node the enclosing PWithSelf bound; a BinOpExpr folds
// its two ground operands via litval_arith (+,-,*,/,% same-kind); a UnaryOpExpr
// negates its ground operand. NO node is minted — every leaf is read live and
// folded in place (the e-graph const-fold mints nodes and runs AFTER Verify;
// this is a pure read-and-fold at the proof gate). Carry the handle, read live.
fn node_const(handle) = node_const_at(handle, NoSelf)

fn node_const_at(handle, bind) = match graph_node_body(handle) {
  NExpr(LitInt(n)) => Some(LVInt(n)),
  NExpr(LitFloat(f)) => Some(LVFloat(f)),
  NExpr(LitString(s)) => Some(LVString(s)),
  NExpr(LitBool(b)) => Some(LVBool(b)),
  NExpr(VarRef(name)) => resolve_self_operand(name, bind),
  NExpr(BinOpExpr(op, l, r)) => match l {
    N(_, _, lh) => match r {
      N(_, _, rh) => litval_arith_opt(op, node_const_at(lh, bind), node_const_at(rh, bind)),
    },
  },
  NExpr(UnaryOpExpr(op, x)) => match x {
    N(_, _, xh) => litval_unary_opt(op, node_const_at(xh, bind)),
  },
  _ => None,
}

// `self` resolves through its binding — the value node, read as a ground
// constant, or the constant itself; a bare claim has no `self`. Any OTHER
// name is a constant exactly when it is a MODULE VALUE bound to one
// (`module_let_const`): `let spine_slots = 16384` is a fact the graph holds
// at the let's own node, and a division by it is total for that reason.
fn resolve_self_operand(name: String, bind) = if name == "self" {
  match bind {
    NoSelf => None,
    SelfNode(h) => node_const_at(h, NoSelf),
    SelfVal(v) => Some(v),
  }
} else {
  module_let_const(name)
}

// A module-level `let` bound to a constant — the innermost binding of the
// name must be the module's (a local of the same name shadows it, and the
// env answers which is in force), and the let's own node is in the decls
// column, judged before any reader of the name by the callee-first order.
// The newest note for the name is the judged generation's. A local let is
// path-sensitive and stays honest debt.
fn module_let_const(name: String) =
  if env_lookup_is_global(name) { module_let_scan(name, graph_decls_at()) } else { None }

fn module_let_scan(name: String, decls) = if len(decls) == 0 {
  None
} else {
  match graph_node_body(last(decls)) {
    NStmt(LetStmt(PVar(n), value, _)) => if n == name {
      node_const_at(node_handle(value), NoSelf)
    } else {
      module_let_scan(name, drop_last(decls))
    },
    _ => module_let_scan(name, drop_last(decls)),
  }
}

// ─── The value walk — what a value is, read along the edges it flowed ──
//
// A refinement is a fact about a VALUE, and the edges the value flowed
// through say what it is. Its unification class says nothing: a cell holds
// a shape (types.mn `shape_of`), because union-find merges every value a
// join can take and every operand an operator meets — the class model
// typed `x - 1` over `x: Positive` as Positive and `if c { n } else { 0 }`
// as Positive (P0, 2026-10-01). The walk reads a value as its LEAVES, each
// a graph READ minting nothing:
//   · a constant is its point (node_const_at folds literals, module
//     constants and the arithmetic over them at the word's own wrap)
//   · a reference reads its binder through its own link — a declared
//     parameter's precondition, a let's value, the claim's `self`
//   · an if / match / block is every tail's leaves — a join is all of them
//   · len / byte_len are lengths, by the sequence representation itself
//   · a call — and a pipe stage, the same application — is its callee's
//     declared return, or a function-typed parameter's contract on its
//     result
//   · Add folds its operands' lower bounds
// and each reader asks its own question of the leaves: a ROW fact
// (partiality, a guard) stands on constants, lengths and preconditions
// alone; a CLAIM's bound and echo may stand on a postcondition, which its
// callee owes at its declaration, and on the Add fold, which models Int as
// unbounded where the i32 floor wraps
// (Hβ.verify.interval-fragment-assumes-unbounded-int). It replaced the
// class reads and three compensations for them: a two-face "contamination
// law" that read types only where a class boundary was crossed, a licence
// refusing the echo to computation nodes, and a rebind exposing a let
// annotation on its value's class.
type Leaf
  // a constant — exact, at the word's own wrap
  = LPoint(LitValue)
  // a declared parameter's precondition: assumed here, owed by every
  // caller, and the parameter whose guard a row fact standing on it grows
  | LParam(Int, Ty)
  // a callee's declared return: the callee owes it at its own declaration,
  // and it is debt there until proven
  | LPost(Ty)
  // the Add fold's lower bound for a sum — overflow-blind
  | LSum(Option(Int))
  // len / byte_len: a length, never below zero
  | LLength
  // a callee's return still a free cell — nothing to any reader but the
  // summary of the declaration whose return it is, where a self-call is
  // the claim being proven (`proven_return`)
  | LRet(Int)
  // a value under a contract claimed of it where it was made — a `let`'s
  // annotation, a constructor field's declared refinement — owed there: a
  // claim may stand on the contract, a row fact only on the leaf beneath
  | LClaimed(Ty, Leaf)
  // nothing this walk can read
  | LUnknown

fn value_leaves(h, bind) = match node_const_at(h, bind) {
  Some(v) => [LPoint(v)],
  None => match join_tails(h) {
    Some(tails) => tails |> flat_map(value_leaves(??, bind)),
    None => match graph_node_body(h) {
      NExpr(VarRef(name)) => if name == "self" { self_leaves(bind) } else { binder_leaves(h) },
      NExpr(BinOpExpr(op, l, r)) => match op {
        BAdd => [LSum(lo_add(leaves_lo(value_leaves(node_handle(l), bind)), leaves_lo(value_leaves(node_handle(r), bind))))],
        _ => [LUnknown],
      },
      NExpr(CallExpr(callee, _)) => call_leaves(callee),
      NExpr(PipeExpr(PForward, _, stage)) => call_leaves(stage),
      NExpr(FieldExpr(recv, fname)) => part_leaves(node_handle(recv), PartField(fname)),
      _ => [LUnknown],
    },
  },
}

fn self_leaves(bind) = match bind {
  SelfNode(sh) => value_leaves(sh, NoSelf),
  SelfVal(v) => [LPoint(v)],
  NoSelf => [LUnknown],
}

// A reference's binder, through the reference's OWN link (graph_link_of),
// never its class.
fn binder_leaves(use_h) = match graph_link_of(use_h) {
  Some(b) => leaves_at_binder(b),
  None => [LUnknown],
}

// What a binder answers: a declared parameter its precondition; a
// destructured part what its whole was built from at that position (a
// field's declared contract, owed where the value was built, over it); a
// let its value under every contract the let claimed of it. Any other
// binder — a lambda's parameter — answers nothing.
fn leaves_at_binder(b) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => match pre_contract(f.pre) {
      Some(c) => [LParam(b, c)],
      None => [LUnknown],
    },
    PartFact(f) => match f.declared {
      Some(c) => claimed_under(part_leaves(f.whole, f.step), c),
      None => part_leaves(f.whole, f.step),
    },
  },
  None => match graph_node_body(b) {
    NExpr(_) => graph_claims_of(b) |> fold(value_leaves(b, NoSelf), claimed_under),
    _ => [LUnknown],
  },
}

fn claimed_under(leaves, contract) = leaves |> map(LClaimed(contract, ??))

// A claim pending over an authored hole is the hole's DEMAND, not a proof
// of its own: the fill discharges it, and the hole's position carries it.
fn claim_is_a_holes_demand(pred) = match pred {
  PWithSelf(h, _) => match graph_node_body(h) {
    NHole(_) => true,
    _ => false,
  },
  _ => false,
}

// The leaves of whatever stands at a handle: a binder's (a destructured
// part's, a parameter's) or an expression's.
fn node_leaves(h) = match graph_binder_of(h) {
  Some(_) => leaves_at_binder(h),
  None => value_leaves(h, NoSelf),
}

// ── Destructuring — a part read off its whole (P0) ──────────────────────
//
// A pattern's binder for a part of the value it matched carries the edge to
// that value (PartFact), and a field read names its receiver. The part's
// value is read off the whole: where the whole was BUILT in sight — a tuple,
// a constructor call, a record, a list literal, through a let's value and
// every tail of a join — the part IS the argument at that position; where it
// was not, the whole's own contracts are projected to the position (a
// parameter's `(Int, Positive)` precondition answers `Positive` at its
// second element).
fn part_leaves(whole, step) = match part_nodes(whole, step) {
  Some(nodes) => nodes |> flat_map(node_leaves),
  None => match step {
    PartRest => [LUnknown],
    _ => node_leaves(whole) |> map(project_leaf(??, step)),
  },
}

// The nodes a part can BE, read off its whole's construction; None when the
// whole was not built where the walk sees. A constructor call of another
// constructor holds no such part — the arm cannot match it — and answers no
// nodes at all.
fn part_nodes(whole, step) = match step {
  PartWhole => Some([whole]),
  _ => match graph_binder_of(whole) {
    Some(fact) => match fact {
      PartFact(f) => match part_nodes(f.whole, f.step) {
        Some(outer) => all_parts(outer, step),
        None => None,
      },
      ParamFact(_) => None,
    },
    None => match join_tails(whole) {
      Some(tails) => all_parts(tails, step),
      None => built_part(whole, step),
    },
  },
}

fn all_parts(wholes, step) = wholes |> fold(Some([]), gather_part(step, ??, ??))

fn gather_part(step, acc, whole) = match acc {
  Some(nodes) => match part_nodes(whole, step) {
    Some(more) => Some(nodes ++ more),
    None => None,
  },
  None => None,
}

fn built_part(whole, step) = match graph_node_body(whole) {
  NExpr(VarRef(_)) => match graph_link_of(whole) {
    Some(b) => part_nodes(b, step),
    None => None,
  },
  NExpr(MakeTupleExpr(elems)) => match step {
    PartIndex(i) => nth_handle(elems, i),
    _ => None,
  },
  NExpr(CallExpr(callee, args)) => match step {
    PartCtor(cname, i) => match graph_node_body(node_handle(callee)) {
      NExpr(VarRef(made)) => if made == cname { nth_handle(args, i) } else { None },
      _ => None,
    },
    _ => None,
  },
  NExpr(MakeRecordExpr(fields)) => field_part(fields, step),
  NExpr(NamedRecordExpr(_, fields)) => field_part(fields, step),
  NExpr(MakeListExpr(elems)) => match step {
    PartElem => Some(elems |> map(node_handle)),
    _ => None,
  },
  _ => None,
}

fn nth_handle(nodes, i) =
  if i < len(nodes) { Some([node_handle(list_index(nodes, i))]) } else { None }

fn field_part(fields, step) = match step {
  PartField(name) => match find({ (n, _) => n == name }, fields) {
    Some((_, v)) => Some([node_handle(v)]),
    None => None,
  },
  _ => None,
}

// A whole's leaf read at a position: a contract projects to the position's
// contract — assumed if the whole's was, owed if the whole's was — and a
// position that carries no refinement answers nothing.
fn project_leaf(leaf, step) = match leaf {
  LParam(b, c) => match refined_part(c, step) {
    Some(pc) => LParam(b, pc),
    None => LUnknown,
  },
  LPost(c) => match refined_part(c, step) {
    Some(pc) => LPost(pc),
    None => LUnknown,
  },
  LClaimed(c, beneath) => match refined_part(c, step) {
    Some(pc) => LClaimed(pc, project_leaf(beneath, step)),
    None => project_leaf(beneath, step),
  },
  LPoint(_) => // a constant, a sum, a length or a free return has no parts
  LUnknown,
  LSum(_) => LUnknown,
  LLength => LUnknown,
  LRet(_) => LUnknown,
  LUnknown => LUnknown,
}

fn refined_part(c, step) = match contract_part(c, step) {
  Some(pc) => if ty_carries_refinement(pc) { Some(pc) } else { None },
  None => None,
}

fn contract_part(c, step) = match c {
  TAlias(_, inner) => contract_part(inner, step),
  TReprPin(_, base) => contract_part(base, step),
  TTuple(es) => match step {
    PartIndex(i) => if i < len(es) { Some(list_index(es, i)) } else { None },
    _ => None,
  },
  TRecord(fs) => field_contract(fs, step),
  TRecordOpen(fs, _) => field_contract(fs, step),
  TList(e) => match step {
    PartElem => Some(e),
    _ => None,
  },
  _ => None,
}

fn field_contract(fs, step) = match step {
  PartField(name) => match find({ (n, _) => n == name }, fs) {
    Some((_, t)) => Some(t),
    None => None,
  },
  _ => None,
}

// A call is a length when the callee is len / byte_len; any other call is
// its callee's return — declared, or proven at the callee's exit — when
// that return states a refinement.
fn call_leaves(ref callee) = match graph_node_body(node_handle(callee)) {
  NExpr(VarRef(cname)) => if cname == "len" || cname == "byte_len" { [LLength] } else { applied_leaves(node_handle(callee)) },
  _ => applied_leaves(node_handle(callee)),
}

// A function-typed parameter applied: its result under the return contract
// the parameter carries — stated, or learned from the demand its result
// meets — assumed here as a precondition is and owed where a caller hands
// the function in, so a row fact standing on it grows the parameter's
// guard. Any other callee: its return.
fn applied_leaves(ch) = match param_result(ch) {
  Some(leaf) => [leaf],
  None => post_leaves(ch),
}

fn param_result(ch) = match graph_link_of(ch) {
  Some(b) => match graph_binder_of(b) {
    Some(fact) => match fact {
      ParamFact(f) => match pre_contract(f.pre) {
        Some(c) => match c {
          TFun(_, ret, _) => if ty_carries_refinement(ret) { Some(LParam(b, ret)) } else { None },
          _ => None,
        },
        None => None,
      },
      PartFact(_) => None,
    },
    None => match graph_node_body(b) {
      NExpr(VarRef(_)) => param_result(b),
      _ => None,
    },
  },
  None => None,
}

fn post_leaves(ch) = match graph_chase(ch) {
  GNode(NBound(TFun(_, ret, _)), _) => if ty_carries_refinement(ret) {
    [LPost(ret)]
  } else {
    match ret {
      TVar(r) => [LRet(r)],
      _ => [LUnknown],
    }
  },
  _ => [LUnknown],
}

// The return a declaration PROVES when it authored none: the contract every
// return tail's leaves carry, a self-call read co-inductively — it returns
// what the other tails return, or it never returns. None when a tail
// carries nothing, or every tail is the self-call. Published as the
// callee's return, it is a postcondition to its callers: a claim may stand
// on it, a row fact never (the arguments that made it true are owed by
// those same callers).
fn proven_return(body_h, ret_h) = {
  let root = graph_chase_handle(ret_h)
  value_leaves(body_h, NoSelf) |> filter({ l => !leaf_is_ret(root, l) }) |> leaves_contract
}

// The contract every leaf carries, named by one alias — the first leaf's,
// when every leaf names it. None when a leaf carries none. What a return
// proves of every tail and what an application provides at a position are
// this one read.
fn leaves_contract(leaves) = match leaves {
  [] => None,
  [first, ..._] => match leaf_contract(first) {
    Some(c) => match contract_alias(c) {
      Some(a) => if all(leaf_carries(a, ??), leaves) { Some(c) } else { None },
      None => None,
    },
    None => None,
  },
}

fn leaf_is_ret(root, leaf) = match leaf {
  LRet(r) => graph_chase_handle(r) == root,
  _ => false,
}

fn leaf_contract(leaf) = match leaf {
  LParam(_, c) => Some(c),
  LPost(c) => Some(c),
  LClaimed(c, _) => Some(c),
  _ => None,
}

// The alias a contract is named by, through refinements and width pins.
fn contract_alias(c) = match c {
  TAlias(n, _) => Some(n),
  TRefined(base, _) => contract_alias(base),
  TReprPin(_, base) => contract_alias(base),
  _ => None,
}

// ── What the leaves answer — each reader asks its own question ──────────
//
// A ROW fact: every leaf excludes the point, on what is proven (a constant,
// a length) or assumed under contract (a parameter's precondition) — never
// on a postcondition still owed or on the Add fold.
fn leaves_exclude(leaves, k) = len(leaves) > 0 && all(leaf_excludes(k, ??), leaves)

fn leaf_excludes(k, leaf) = match leaf {
  LPoint(v) => match litval_eq(v, LVInt(k)) {
    Some(eq) => !eq,
    None => false,
  },
  LParam(_, c) => contract_excludes(c, k),
  LLength => k < 0,
  LClaimed(_, beneath) => leaf_excludes(k, beneath),
  LPost(_) => false,
  LSum(_) => false,
  LRet(_) => false,
  LUnknown => false,
}

// A CLAIM's lower bound: the least of every leaf's, each answering — a
// postcondition and the Add fold included, since a claim's own debt is the
// ledger's to carry.
fn leaves_lo(leaves) =
  if len(leaves) == 0 { None } else { leaves |> fold(Some(int_max_word()), leaf_lo_meet) }

fn leaf_lo_meet(acc, leaf) = match acc {
  Some(a) => match leaf_lo(leaf) {
    Some(b) => Some(int_min(a, b)),
    None => None,
  },
  None => None,
}

fn leaf_lo(leaf) = match leaf {
  LPoint(v) => match v {
    LVInt(n) => Some(n),
    _ => None,
  },
  LParam(_, c) => domain_lo(ty_domain(c)),
  LPost(c) => domain_lo(ty_domain(c)),
  LClaimed(c, beneath) => // both hold of the one value, so the bounds MEET
  bound_meet(int_max, domain_lo(ty_domain(c)), leaf_lo(beneath)),
  LSum(lo) => lo,
  LLength => Some(0),
  LRet(_) => None,
  LUnknown => None,
}

// The largest signed word — the identity of the lower bound's meet.
fn int_max_word() with Pure = 2147483647

// The sum of two operand bounds — both must answer.
fn lo_add(ea, eb) = match ea {
  Some(a) => match eb {
    Some(b) => Some(a + b),
    None => None,
  },
  None => None,
}

// A CLAIM's echo: every leaf names the refinement — a parameter's
// precondition or a callee's postcondition carrying the alias — so the
// value is already a member, and its obligation was owed where the leaf
// was made.
fn value_carries_alias(h, aname: String) = {
  let leaves = value_leaves(h, NoSelf)
  len(leaves) > 0 && all(leaf_carries(aname, ??), leaves)
}

fn leaf_carries(aname: String, leaf) = match leaf {
  LParam(_, c) => ty_names_alias(c, aname),
  LPost(c) => ty_names_alias(c, aname),
  LClaimed(c, beneath) => ty_names_alias(c, aname) || leaf_carries(aname, beneath),
  _ => false,
}

fn ty_names_alias(ty, aname: String) = match ty {
  TAlias(n, inner) => n == aname || ty_names_alias(inner, aname),
  TRefined(base, _) => ty_names_alias(base, aname),
  TReprPin(_, base) => ty_names_alias(base, aname),
  _ => false,
}

// What a held claim STANDS ON, for the row it guards: the parameters whose
// preconditions it leaned on (the guard travels to them), and whether it
// leaned on anything that is not a row fact — a postcondition still owed,
// or the Add fold — in which case the guard is paid where the claim stands.
fn leaves_params(leaves) = leaves |> flat_map(leaf_param)

fn leaf_param(leaf) = match leaf {
  LParam(b, _) => [b],
  LClaimed(_, beneath) => leaf_param(beneath),
  _ => [],
}

fn leaves_unproven(leaves) = leaves |> any(leaf_unproven)

// A let's claim is owed where the let stands, and nothing says the claim
// decided here did not stand on it.
fn leaf_unproven(leaf) = match leaf {
  LPost(_) => true,
  LSum(_) => true,
  LClaimed(_, _) => true,
  _ => false,
}

// ── The flow label a value carries (§4⑥'s seed) ─────────────────────────
//
// A value is as classified as everything it was BUILT FROM, read along the
// edges it flowed and never off its class, which holds a shape since P0: a
// constant is Public; a reference reads its binder — a parameter's
// precondition, a destructured part's whole (at the position, where the
// whole was built in sight), a let's value joined with every contract the
// let claimed of it; a join is all of its tails; a call is its callee's
// declared return joined with its arguments; any other expression joins
// what it was computed from. On the P0 tree before this walk, `pw ++ "x"`,
// a record's classified field, `p ++ "!"` over a classified parameter and a
// value destructured from `Some(pw)` each read Public at a splice — the
// class had carried them, by the same merging that laundered refinements.
fn value_flow_label(h) = match node_const_at(h, NoSelf) {
  Some(_) => Public,
  None => match join_tails(h) {
    Some(tails) => labels_join(tails),
    None => match graph_node_body(h) {
      NExpr(VarRef(_)) => match graph_link_of(h) {
        Some(b) => binder_flow_label(b),
        None => Public,
      },
      NExpr(CallExpr(callee, args)) => flow_label_join(leaves_flow_label(call_leaves(callee)), labels_join(args |> map(node_handle))),
      NExpr(FieldExpr(recv, fname)) => part_flow_label(node_handle(recv), PartField(fname)),
      body => labels_join(body_child_handles(body)),
    },
  },
}

fn labels_join(hs) = hs |> map(node_flow_label) |> fold(Public, flow_label_join)

fn node_flow_label(h) = match graph_binder_of(h) {
  Some(_) => binder_flow_label(h),
  None => value_flow_label(h),
}

fn binder_flow_label(b) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => match pre_contract(f.pre) {
      Some(c) => query_flow_label(c),
      None => Public,
    },
    PartFact(f) => flow_label_join(declared_label(f.declared), part_flow_label(f.whole, f.step)),
  },
  None => match graph_node_body(b) {
    NExpr(_) => graph_claims_of(b) |> map(query_flow_label) |> fold(value_flow_label(b), flow_label_join),
    _ => Public,
  },
}

fn declared_label(declared) = match declared {
  Some(c) => query_flow_label(c),
  None => Public,
}

// A part is as classified as the nodes it can be where its whole was built
// in sight, and as its whole where it was not.
fn part_flow_label(whole, step) = match part_nodes(whole, step) {
  Some(nodes) => labels_join(nodes),
  None => node_flow_label(whole),
}

fn leaves_flow_label(leaves) = leaves |> map(leaf_flow_label) |> fold(Public, flow_label_join)

fn leaf_flow_label(leaf) = match leaf {
  LParam(_, c) => query_flow_label(c),
  LPost(c) => query_flow_label(c),
  LClaimed(c, beneath) => flow_label_join(query_flow_label(c), leaf_flow_label(beneath)),
  LPoint(_) => Public,
  LSum(_) => Public,
  LLength => Public,
  LRet(_) => Public,
  LUnknown => Public,
}

// The domain a CONTRACT states about its inhabitants. An alias is
// transparent, a refinement meets its base with its predicate's reading, a
// width pin narrows representation and never values; a variable is a cell,
// and a cell holds a shape, so it states nothing.
fn ty_domain(ty) = match ty {
  TAlias(_, inner) => ty_domain(inner),
  TRefined(base, pred) => domain_meet(ty_domain(base), pred_domain(pred)),
  TReprPin(_, base) => ty_domain(base),
  _ => dom_top(),
}

// ── The DOMAIN read — what a predicate states about `self` ───────────
//
// The whole fact, in one walk: both ends of what a refinement admits, read
// together. A walk that answers one end alone forces any consumer wanting the
// other to grow a mirror family beside it — two walks over one fact, the
// parallel-arrays drift at the function layer. A leaf's lower bound
// (`leaf_lo`) is this read projected through `domain_lo`, and the bound-meet
// is `domain_meet` at the domain altitude.
//
// It is an OVER-approximation by contract (Domain, types.mn): the reader may
// decide what to construct from it, never what to admit.
fn pred_domain(pred) = match pred {
  PTrue => dom_top(),
  PCompare(op, lh, rh) => compare_domain(op, lh, rh),
  PAnd(a, b) => domain_meet(pred_domain(a), pred_domain(b)),
  POr(a, b) => domain_join(pred_domain(a), pred_domain(b)),
  PNot(_) => // The complement of a range is two rays, which DRange cannot hold; the
  // top is the honest superset rather than a bound that would cut inhabitants.
  dom_top(),
  PBoolNode(_) => DUndecided,
  PPatternMatch(_, _) => DUndecided,
  PFlowLe(_, _) => // A flow obligation constrains WHERE a value may go, never which values it
  // may be — the domain is untouched, which is a reading, not a gap.
  dom_top(),
  PWithSelf(_, inner) => pred_domain(inner),
  PTotalDiv(_, _, _) => // a precondition on two operands states nothing about `self`
  dom_top(),
}

fn dom_top() = DRange(None, None)

fn is_self_node(handle) = match graph_node_body(handle) {
  NExpr(VarRef(name)) => name == "self",
  _ => false,
}

// One comparison, read from whichever side `self` stands on: the other side
// must fold to a ground constant, or the fragment stops (DUndecided) rather
// than guessing.
fn compare_domain(op, lh, rh) = if is_self_node(lh) {
  match node_const(rh) {
    Some(v) => self_op_const(op, v),
    None => DUndecided,
  }
} else if is_self_node(rh) {
  match node_const(lh) {
    Some(v) => self_op_const(flip_cmp(op), v),
    None => DUndecided,
  }
} else {
  DUndecided
}

// `n < self` read from self's side is `self > n`. Identity on anything that is
// not a comparison is correct because the one reader answers DUndecided there.
fn flip_cmp(op) with Pure = match op {
  BLt => BGt,
  BGt => BLt,
  BLe => BGe,
  BGe => BLe,
  _ => op,
}

// `self OP v`. The strict bounds step by one, which is why DRange is integral;
// a non-Int operand answers DUndecided for the ordering ops and still answers
// exactly for equality, where no predecessor is needed.
fn self_op_const(op, v) = match op {
  BEq => DFinite([v]),
  BNe => // The complement of one point is not a range; top is the honest superset.
  dom_top(),
  BLt => match v {
    LVInt(n) => DRange(None, Some(n - 1)),
    _ => DUndecided,
  },
  BLe => match v {
    LVInt(n) => DRange(None, Some(n)),
    _ => DUndecided,
  },
  BGt => match v {
    LVInt(n) => DRange(Some(n + 1), None),
    _ => DUndecided,
  },
  BGe => match v {
    LVInt(n) => DRange(Some(n), None),
    _ => DUndecided,
  },
  _ => // An arithmetic operator in a comparison slot states nothing this
  // fragment can read.
  DUndecided,
}

// MEET — both predicates hold, so the truth is the intersection. An unreadable
// side yields to the readable one: the intersection is a SUBSET of either side,
// so keeping the decided side stays the over-approximation the contract
// requires, and nothing real is cut.
fn domain_meet(a, b) = match a {
  DUndecided => b,
  DFinite(vs) => match b {
    DUndecided => a,
    DFinite(ws) => DFinite(vs |> filter(lit_in(??, ws))),
    DRange(lo, hi) => DFinite(vs |> filter(lit_in_range(??, lo, hi))),
  },
  DRange(la, ha) => match b {
    DUndecided => a,
    DFinite(ws) => DFinite(ws |> filter(lit_in_range(??, la, ha))),
    DRange(lb, hb) => DRange(bound_meet(int_max, la, lb), bound_meet(int_min, ha, hb)),
  },
}

// JOIN — either predicate may hold, so the truth is the union and the reading
// must COVER it. Two ranges give their hull; two finite sets give their
// concatenation, which is exact; anything mixed or unreadable widens to the
// top, because a bound that cannot cover the union would cut inhabitants.
fn domain_join(a, b) = match a {
  DUndecided => dom_top(),
  DFinite(vs) => match b {
    DFinite(ws) => DFinite(vs ++ ws),
    DRange(_, _) => dom_top(),
    DUndecided => dom_top(),
  },
  DRange(la, ha) => match b {
    DRange(lb, hb) => DRange(bound_join(int_min, la, lb), bound_join(int_max, ha, hb)),
    DFinite(_) => dom_top(),
    DUndecided => dom_top(),
  },
}

fn lit_same(a, b) = match litval_eq(a, b) {
  Some(x) => x,
  None => false,
}

fn lit_in(v, ws) = ws |> any(lit_same(v, ??))

// A value outside the range is cut; a value the integral range cannot speak
// about is KEPT, because the meet may only over-approximate.
fn lit_in_range(v, lo, hi) = match v {
  LVInt(n) => bound_admits_lo(lo, n) && bound_admits_hi(hi, n),
  _ => true,
}

fn bound_admits_lo(lo, n) with Pure = match lo {
  Some(l) => n >= l,
  None => true,
}

fn bound_admits_hi(hi, n) with Pure = match hi {
  Some(h) => n <= h,
  None => true,
}

// Two ways to combine a pair of bounds, and only two: under a MEET an open
// side yields to the closed one, because a constraint that says nothing cannot
// loosen a constraint that says something; under a JOIN an open side absorbs,
// because a union with an unbounded set is unbounded. Which END is being
// combined is the comparator, not a flag — the four near-identical combiners
// this replaces differed by one glyph each and were a family where a pair of
// higher-order reads belongs.
fn bound_meet(pick, ea, eb) = match ea {
  Some(a) => match eb {
    Some(b) => Some(pick(a, b)),
    None => ea,
  },
  None => eb,
}

fn bound_join(pick, ea, eb) = match ea {
  Some(a) => match eb {
    Some(b) => Some(pick(a, b)),
    None => None,
  },
  None => None,
}

fn int_max(a, b) with Pure = if a > b { a } else { b }

fn int_min(a, b) with Pure = if a < b { a } else { b }

// The bounds a domain states, for the readers that want one end. A finite set
// bounds itself; a member the integral bound cannot speak about leaves the end
// open rather than inventing one.
fn domain_lo(d) = match d {
  DRange(lo, _) => lo,
  DFinite(vs) => if vs |> all(is_lv_int) { vs |> fold(None, min_of_lit) } else { None },
  DUndecided => None,
}

fn domain_hi(d) = match d {
  DRange(_, hi) => hi,
  DFinite(vs) => if vs |> all(is_lv_int) { vs |> fold(None, max_of_lit) } else { None },
  DUndecided => None,
}

fn is_lv_int(v) with Pure = match v {
  LVInt(_) => true,
  _ => false,
}

// The guard above admits only integral members, so the other arm carries the
// accumulator untouched rather than inventing a bound for a value it cannot
// read.
fn min_of_lit(acc, v) = match v {
  LVInt(n) => match acc {
    Some(a) => if n < a { Some(n) } else { Some(a) },
    None => Some(n),
  },
  _ => acc,
}

fn max_of_lit(acc, v) = match v {
  LVInt(n) => match acc {
    Some(a) => if n > a { Some(n) } else { Some(a) },
    None => Some(n),
  },
  _ => acc,
}

// Bind the refinement's `self` to the value node being refined. A predicate's
// operands are node HANDLES (types.mn Predicate) and `self` may sit NESTED inside
// an arithmetic operand (`self + 1`, `self % 2`), so a physical operand swap
// could not reach it without minting a rewritten node. Carry the binding as data
// instead — PWithSelf(value_handle, pred) — and predicate_decide_at threads it
// into every node_const_at. One binder resolves every `self`, top-level and
// nested, the same way; carry the handle, read live, mint nothing.
fn subst_self(pred, value_handle) = PWithSelf(value_handle, pred)

// The candidate gate's refinement half: a candidate SURFACES only when the
// target's refinement DECIDES true on it (PLAN §5 sample-then-filter — the
// proven survivors, which may be none). An undecided predicate is not a
// proof, and assume-true is the Dafny {:axiom} cautionary the ledger
// exists to refuse. Transparent aliases recurse; an unrefined target
// admits by type alone.
fn refinement_admits(ty, value_handle) = match ty {
  TAlias(aname, inner) => // A candidate whose every leaf already NAMES the refinement — a
  // parameter's precondition, a callee's declared return — is admitted
  // by that identity, which proves the declaration, never its discharge.
  // The layering is deliberate, each proof question at its one home: a
  // callee's return obligation lives in the ledger AT ITS decl
  // (discharged, pending, or refuted THERE); a refuted callee already
  // fails the program's own check leg (E_RefinementRejected at the decl),
  // so admitting its call here changes nothing observable; and executable
  // refusal on remaining debt is R5's gate at the emit boundary. The synth
  // gate answers only "does this filling fit the target type" — it never
  // re-decides a proof another site owns.
  value_carries_alias(value_handle, aname) || refinement_admits(inner, value_handle),
  TRefined(base, pred) => refinement_admits(base, value_handle) && match predicate_decide(subst_self(pred, value_handle)) {
    Some(decided) => decided,
    None => false,
  },
  _ => true,
}

// Fold a comparison over two constant operand values.
// Total over the comparison operators: the three the grammar spells the
// other way round are the same three questions with the operands swapped
// or the answer negated, and `self != 0` is what a NonZero refinement says.
fn litval_compare(ref op, ref a, ref b) = match op {
  BEq => litval_eq(a, b),
  BNe => not_decide(litval_eq(a, b)),
  BLt => litval_lt(a, b),
  BLe => litval_le(a, b),
  BGt => litval_lt(b, a),
  BGe => litval_le(b, a),
  _ => None,
}

// Equality over constants. Same-kind compares; cross-kind is Some(false)
// (different-kind constants are unequal — a stronger refusal than None).
fn litval_eq(ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => Some(na == nb),
    LVFloat(_) => Some(false),
    LVString(_) => Some(false),
    LVBool(_) => Some(false),
  },
  LVFloat(fa) => match b {
    LVInt(_) => Some(false),
    LVFloat(fb) => Some(fa == fb),
    LVString(_) => Some(false),
    LVBool(_) => Some(false),
  },
  LVString(sa) => match b {
    LVInt(_) => Some(false),
    LVFloat(_) => Some(false),
    LVString(sb) => Some(sa == sb),
    LVBool(_) => Some(false),
  },
  LVBool(ba) => match b {
    LVInt(_) => Some(false),
    LVFloat(_) => Some(false),
    LVString(_) => Some(false),
    LVBool(bb) => Some(ba == bb),
  },
}

// Strict order over numeric constants; strings/bools carry no order
// here (None — defer); cross-kind numeric is None.
fn litval_lt(ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => Some(na < nb),
    LVFloat(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVFloat(fa) => match b {
    LVInt(_) => None,
    LVFloat(fb) => Some(fa < fb),
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVString(_) => None,
  LVBool(_) => None,
}

fn litval_le(ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => Some(na <= nb),
    LVFloat(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVFloat(fa) => match b {
    LVInt(_) => None,
    LVFloat(fb) => Some(fa <= fb),
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVString(_) => None,
  LVBool(_) => None,
}

// Fold an arithmetic BinOp over two OPTIONAL ground operands (the decidable
// fragment); either None makes the fold None.
fn litval_arith_opt(op, ref ea, ref eb) = match ea {
  Some(a) => match eb {
    Some(b) => litval_arith(op, a, b),
    None => None,
  },
  None => None,
}

// Fold +,-,*,/,% over two ground operands. SAME-KIND only: Int op Int -> Int,
// Float op Float -> Float; cross-kind -> None (a genuine type mismatch the
// comparison above already refuses). Strings/bools carry no arithmetic. The
// operands are bound through the LVInt/LVFloat PATTERN — exactly like
// litval_lt/litval_le — so na/nb are Int and fa/fb are Float; a bare helper
// param defaults to the i32 floor and stores an int where an f64 belongs.
// Int div/mod GUARD the zero divisor (the runtime traps on Int `/ 0` — folding
// one would LIE; None keeps the obligation live and honest). Float folds use the
// compiler's own f64 ops (identical wasm IEEE-754 semantics; f64 `/ 0.0` is
// inf/nan, not a trap). No float modulo; a comparison/logical op defers to None.
fn litval_arith(ref op, ref a, ref b) = match a {
  LVInt(na) => match b {
    LVInt(nb) => match op {
      BAdd => Some(LVInt(na + nb)),
      BSub => Some(LVInt(na - nb)),
      BMul => Some(LVInt(na * nb)),
      BDiv => if nb == 0 { None } else { Some(LVInt(na / nb)) },
      BMod => if nb == 0 { None } else { Some(LVInt(na % nb)) },
      _ => None,
    },
    LVFloat(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVFloat(fa) => match b {
    LVFloat(fb) => match op {
      BAdd => Some(LVFloat(fa + fb)),
      BSub => Some(LVFloat(fa - fb)),
      BMul => Some(LVFloat(fa * fb)),
      BDiv => Some(LVFloat(fa / fb)),
      _ => None,
    },
    LVInt(_) => None,
    LVString(_) => None,
    LVBool(_) => None,
  },
  LVString(_) => None,
  LVBool(_) => None,
}

// Fold a unary op over an OPTIONAL ground operand. UNeg negates a numeric
// constant (the source of `-1.0` / `-3`); UNot is boolean, outside the
// arithmetic fragment (defer to None).
fn litval_unary_opt(op, ref e) = match e {
  Some(v) => litval_unary(op, v),
  None => None,
}

fn litval_unary(ref op, ref v) = match op {
  UNeg => match v {
    LVInt(n) => Some(LVInt(0 - n)),
    LVFloat(f) => Some(LVFloat(0.0 - f)),
    LVString(_) => None,
    LVBool(_) => None,
  },
  UNot => None,
}

// Conjunction with three-valued short-circuit. Some(false) on either
// branch decides the conjunction false regardless; Some(true) on both
// decides true; mixed Some(true) + None defers to None (the unknown
// branch is still load-bearing); Some(true) + Some(true) is the only
// fully-decidable true.
fn and_decide(ref ea, ref eb) = match ea {
  Some(false) => Some(false),
  Some(true) => match eb {
    Some(false) => Some(false),
    Some(true) => Some(true),
    None => None,
  },
  None => match eb {
    Some(false) => Some(false),
    Some(true) => None,
    None => None,
  },
}

fn or_decide(ref ea, ref eb) = match ea {
  Some(true) => Some(true),
  Some(false) => match eb {
    Some(true) => Some(true),
    Some(false) => Some(false),
    None => None,
  },
  None => match eb {
    Some(true) => Some(true),
    Some(false) => None,
    None => None,
  },
}

fn not_decide(ref e) = match e {
  Some(true) => Some(false),
  Some(false) => Some(true),
  None => None,
}

// THE LEDGER DECIDES, THE SITE NARRATES (C5). A claim's one perform: the
// installed ledger answers its verdict (proven, refused, open) and the
// SITE reports a refusal — from the body, inside every capture bracket
// the judgment installed. The arms used to report it themselves, and an
// arm's performs resolve OUTER of its own install, so the refusal sailed
// past the battery's class capture: `mn-div-const-zero-refuses` counted
// one error and banked no class, the exact shape
// `Hβ.diag.an-arms-report-escapes-an-inner-capture` names at the occurs
// belt. An arm may note; only the body may narrate.
fn verify_claim(modh, span, pred, reason) = {
  let verdict = verify(modh, span, pred, reason)
  match verdict {
    Some(false) => report_refinement_rejected(pred, span, reason),
    _ => (),
  }
  verdict
}

// Compile-time refusal at the construction site. The verifier proved
// the predicate false from constant inputs alone — the construction
// is invariant-violating by literal evidence. Span is the call site;
// reason carries the predicate-as-Why for the chain-walker.
fn report_refinement_rejected(ref pred, ref span, ref reason) with !Mutate =
  report(ERefinementRejected(pred, span))

// The pending ledger speaks WHOLE — one line per obligation (span,
// class, predicate) before the summary count. The count alone hid the
// debt's composition: the 2026-07-30 sweep classified 138 obligations
// only by growing per-entry projections one file at a time; this is
// the complete projection at the one place the whole ledger is read.
// Spans render as the developer's own file:line through the graph's
// NModule seams — the weave coordinate was hand-mapped four times in
// one session before this projection existed.
fn report_verify_debt(debt) = if len(debt) == 0 {
  ()
} else {
  // The per-obligation lines apply the register's own law PER SPAN
  // (the diag_report arm's exact test): a user's OWN pending renders —
  // it is their teaching surface ("this claim was not checked") — while
  // the wheel's obligations (types.mn spans printed on every
  // hello-world, the audit's measured flood) stay the census
  // channel's. ScopeAll keeps every line; the SUMMARY count still
  // reports through diag_report in every scope.
  debt_lines(debt, diag_scope_of(), 0)
  report(VPending(len(debt), span_zero()))
}

// The seams argument is GONE with the weave: the span is already the
// developer's own coordinate, so there is no offset to subtract and no
// containment scan to run. The module rides the obligation, so scoping is a
// name compare instead of a line-range test that two files could both pass.
fn debt_lines(ref debt, ref scope, i) = if i >= len(debt) {
  ()
} else {
  match debt[i] {
    (modh, dspan, pred, _) => if debt_in_scope(modh, scope) {
      eprint_string("verify: pending {classify_predicate(pred)} {show_predicate(pred)} at {module_name_of_handle(modh)}:{show_span(dspan)}\n")
    } else {
      ()
    },
  }
  debt_lines(debt, scope, i + 1)
}

fn debt_in_scope(modh, ref scope) = match scope {
  ScopeAll => true,
  ScopeNone => false,
  ScopeModule(name) => module_name_of_handle(modh) == name,
}

fn classify_predicate(pred) with Pure = match pred {
  PTrue => "trivial",
  PNot(_) => "negation",
  PAnd(_, _) => "conjunction",
  POr(_, _) => "disjunction",
  PCompare(_, _, _) => "comparison",
  PBoolNode(_) => "graph-deferred",
  PPatternMatch(_, _) => "match-narrowing",
  PFlowLe(_, _) => // IFC: always decides at compile time via flow_le
  "ifc-flow",
  PWithSelf(_, inner) => // the binder classifies as its body
  classify_predicate(inner),
  PTotalDiv(_, _, _) => "partiality",
}

type SmtResult = SmtSat(String) | SmtUnsat | SmtUnknown

effect SmtSolver {
  smt_solve(String) -> SmtResult
}

handler verify_smt with witnesses = [], debt = [] {
  verify(modh, span, predicate, reason) => match predicate_decide(predicate) {
    Some(true) => resume(Some(true)),
    Some(false) => resume(Some(false)),
    None => // Only OPEN predicates reach the solver (predicate_decide short-circuits
    // ground ones above), so validity is the question — and validity is the
    // NEGATION's unsatisfiability. Solving the predicate itself and reading
    // SAT as discharge admits any predicate SOME assignment satisfies: the
    // inverted-polarity hole. UNSAT(¬P) proves P for every assignment;
    // SAT(¬P) hands back the violating assignment — a COUNTEREXAMPLE the
    // cursor surfaces at the rejection, not proof-evidence.
    match smt_solve(predicate_to_smt_lib(PNot(predicate))) {
      SmtUnsat => resume(Some(true)),
      SmtSat(counterexample) => resume(Some(false)) with witnesses = [(modh, span, predicate, counterexample)] ++ witnesses,
      SmtUnknown => // SmtUnknown is a GENUINELY undischarged obligation — accrue it as
      // pending debt (never silently resume, which would discharge an
      // obligation the solver could not prove; the no-silent-fallback law
      // at the proof gate). It lives in the SAME debt ledger verify_ledger
      // keeps, so verify_debt projects it live.
      resume(None) with debt = [(modh, span, predicate, reason)] ++ debt,
    },
  },
  verify_debt() => // verify_debt projects the SMT handler's residual LIVE (Carried-Truth — the
  // witnesses + the unknown-debt are graph state the handler proved; reading
  // resume([]) fabricated an empty ledger). SmtSat counterexamples are the
  // violating assignments behind each rejection (mentl-why walks to the model);
  // SmtUnknown obligations are retained debt. Both flow back as the residual,
  // never dropped.
  resume(verify_residual(debt, witnesses)),
  verify_reset() => // The generation clear drops the pending debt; the SAT witnesses stay —
  // a counterexample is a PROOF (of violation), not an obligation, and a
  // re-derivation that removed the violating claim simply never re-raises
  // it.
  resume() with debt = [],
}

// The SMT handler's residual: undischarged debt PLUS the SAT-witness ledger
// projected as proof-evidence entries (witness rendered into the reason via
// SVerifyWitness so the Why-walker reaches the counterexample/model). One
// list, read live — the cursor's projection of what the solver established
// and what it could not. (Surpasses Dafny/F*: the witness is a walkable Reason
// edge, not a separate counterexample dump.)
fn verify_residual(ref debt, ref witnesses) =
  debt ++ map({ (modh, span, pred, model) => (modh, span, pred, VerifyWitness(model)) }, witnesses)

fn predicate_to_smt_lib(ref pred) = "(assert {predicate_to_smt(pred)})\n(check-sat)"

fn predicate_to_smt(ref pred) = match pred {
  PTrue => "true",
  PCompare(op, l, r) => "({smt_cmp_op(op)} {handle_to_smt(l)} {handle_to_smt(r)})",
  PAnd(a, b) => smt_logop("and", a, b),
  POr(a, b) => smt_logop("or", a, b),
  PNot(inner) => "(not {predicate_to_smt(inner)})",
  PBoolNode(n) => handle_to_smt(n),
  PPatternMatch(_, n) => handle_to_smt(n),
  PFlowLe(a, b) => // finite lattice: literal
  // The self binder renders as its body — `self` stays symbolic in SMT-LIB
  // (the solver's declared variable), exactly the diagnostic's reading.
  if flow_le(a, b) { "true" } else { "false" },
  PWithSelf(_, inner) => predicate_to_smt(inner),
  PTotalDiv(op, a, b) => match op {
    BMod => "(distinct {handle_to_smt(b)} 0)",
    _ => "(and (distinct {handle_to_smt(b)} 0) (or (distinct {handle_to_smt(b)} (- 1)) (distinct {handle_to_smt(a)} (- 2147483648))))",
  },
}

fn smt_cmp_op(ref op) with Pure = match op {
  BEq => "=",
  BNe => "distinct",
  BLt => "<",
  BLe => "<=",
  BGt => ">",
  BGe => ">=",
  _ => "=",
}

fn smt_logop(ref op, ref a, ref b) = "({op} {predicate_to_smt(a)} {predicate_to_smt(b)})"

// ONE SMT-render projection, keyed on HANDLES throughout (Carried-Truth: the
// predicate's operands ARE handles into the one graph; every operand — top-
// level and nested call arg — is resolved via graph_node_body and rendered
// uniformly, never a second node-destructure path). Follow the edge, read the
// live node — the AST-in-graph fabric makes every sub-node a resolvable handle.
// THE `body_to_smt(graph_node_body(h))` SPLIT WAS THE DEFECT, and the probe
// that found it is worth more than the fix. Wiring this serializer to a
// projection (`mentl query <f> "smt"`) ran it for the first time, and on the
// wheel's own `type Sample = Float where 0.0 - 1.0 <= self && …` it rendered
// `(- 66664 686237016)` where `show_predicate` — reading THE SAME predicate
// handles — rendered `0.0 - 1.0`. So the graph was sound and the serializer
// was not, which the comparison settled in one command.
//
// The second number MOVED between two builds of identical source (686234536 →
// 686237016), which is what named it: a heap POINTER printed through the
// `LitInt` arm, not a stored literal. The difference from the working sibling
// is that `show_pred_operand` matches `graph_node_body(handle)` INLINE while
// this passed the NodeBody across a call boundary first — so the float
// variant's payload arrived as a word and matched the wrong arm. Dropping the
// four `ref` markers first REFUTED the borrow-marker hypothesis (the numbers
// moved but stayed wrong), which is the only reason this one is trustworthy.
//
// The one read, inline, exactly as the sibling does it.
fn handle_to_smt(handle) = match graph_node_body(handle) {
  NExpr(LitInt(n)) => int_to_str(n),
  NExpr(LitFloat(f)) => float_to_str(f),
  NExpr(LitString(s)) => "\"{s}\"",
  NExpr(LitBool(b)) => if b { "true" } else { "false" },
  NExpr(VarRef(name)) => name,
  NExpr(CallExpr(callee, args)) => smt_call(callee, args),
  NExpr(BinOpExpr(op, l, r)) => smt_binop(op, l, r),
  NExpr(UnaryOpExpr(op, x)) => smt_unop(op, x),
  _ => {
    report(EVerifyUnencodable(span_zero()))
    "false"
  },
}

// Every node-kind that can appear in a refinement-predicate operand is
// enumerated above; a genuinely non-encodable shape raises
// E_VerifyUnencodable (Located) and renders the unsat-forcing sentinel
// `false` — NEVER a fabricated `true` (a `true` fallback in a PROOF GATE
// claims proof of the unprovable — the most dangerous silent fallback in the
// compiler; the no-silent-fallback law, deleted not wrapped). A call's args
// are HANDLES (the AST-in-graph fabric), mapped through handle_to_smt — no
// i/n index loop.
//
// A call renders as `(fname arg…)` with every arg resolved through its handle
// (the operand-Node channel PCompare already uses); the fname is the callee's
// name read live from its node body, or the unencodable sentinel if it is not a
// bare name reference.
fn smt_call(callee, args) = match callee {
  N(cbody, _, _) => {
    let fname = match cbody {
      NExpr(VarRef(n)) => n,
      _ => {
        report(EVerifyUnencodable(span_zero()))
        "false"
      },
    }
    "({fname}{smt_arg_terms(args)})"
  },
}

// Each arg is a handle — map through handle_to_smt and join (map/fold, never an
// imperative i/n counter; Anchor 6).
fn smt_arg_terms(args) = fold(
  "",
  (acc, arg) => match arg {
    N(_, _, h) => "{acc} {handle_to_smt(h)}",
  },
  args
)

fn smt_binop(op, l, r) = match l {
  N(_, _, lh) => match r {
    N(_, _, rh) => "({smt_binop_sym(op)} {handle_to_smt(lh)} {handle_to_smt(rh)})",
  },
}

fn smt_unop(op, x) = match x {
  N(_, _, xh) => match op {
    UNot => "(not {handle_to_smt(xh)})",
    UNeg => "(- {handle_to_smt(xh)})",
  },
}

// Every BinOp rendered to its SMT-LIB symbol — exhaustive over the ADT (no
// `_ => "="` fabrication that would mis-render `%`/`*` as equality in a
// predicate like `self % 2 == 0`).
fn smt_binop_sym(ref op) with Pure = match op {
  BAdd => "+",
  BSub => "-",
  BMul => "*",
  BDiv => "div",
  BMod => "mod",
  BEq => "=",
  BNe => "distinct",
  BLt => "<",
  BGt => ">",
  BLe => "<=",
  BGe => ">=",
  BAnd => "and",
  BOr => "or",
  BConcat => "str.++",
}
