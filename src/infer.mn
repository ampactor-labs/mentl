// infer.mn — Hindley-Milner, one walk, graph-direct (spec 04)
//
// The engine. A single recursive walk over the typed AST that writes
// bindings directly into the Graph and effects into Env through
// effect-mediated access. Three operations: infer_expr, infer_stmt,
// generalize. No sidecar subst. No (env, subst) tuple threaded. The
// graph IS the subst; env IS ambient; both are performed.
//
// Effects required:
//   GraphRead + GraphWrite   — live graph mutation
//   EnvRead + EnvWrite                 — scoped bindings
//   Diagnostic                         — Hazel marked holes
//   FreshHandle                        — instantiate (one fn, two handlers)
//   Verify                             — refinement obligations
//   Consume                            — ownership at own-parameter use
//   InferCtx                           — infer-local: fn-row accumulation
//
// The effect row of a function is accumulated in InferCtx handler
// state during body inference, then bound into the graph on exit.
// This is the clean way: graph_bind is one-write-per-handle, so rows
// grow in handler state and write once.
//
// Classic Damas-Milner. Productive under error (Hazel): a mismatch
// binds NErrorHole and continues; ten mismatches yield ten error
// holes, not one-and-halt.
import graph

import arena

import canon

import choice

import effects

import env

import imap

import intern

import io

import lexer

import own

import parser

import types

import verify

// Infer-local effect for row accumulation.
// Each `FnStmt` / `LambdaExpr` pushes a `(row_handle, accumulated_row)`
// frame. Every effect-op CALL inside the body adds its effect to the
// accumulated row (the op's TFun row carries Closed[eff]; infer_call reads
// it live and inf_add_row joins it). On scope exit, the accumulated row
// binds to the handle via `graph_bind_row`. One write; no conflict.
effect InferCtx {
  inf_enter_fn(Int, Span, [(RowTerm, Bool, EConn)])
  // The frame's exit hands back what the CALLER finalizes — its authored
  // declaration, its row cell, the published row, its span — so the write
  // and the gate check that judges it run in the body's world (exit_frame),
  // never inside this handler's arm. A no-frame exit answers a negative cell.
  inf_exit_fn() -> ([(RowTerm, Bool, EConn)], Int, EffRow, Span)
  inf_frame_params([Int])
  // A block's run of fn declarations (`judge_fn_run`) pre-registers its
  // members mid-walk, above the pass's prereg ceiling, before any of their
  // bodies is read; while the run is judged, every exit keeps what those
  // registrations reach, as the ceiling keeps the module's.
  inf_keep_open([Int])
  inf_keep_close()
  inf_add_row(EffRow)
  // A frame that owns no record of its own: a fanout branch's thunk, and a
  // literal a verb applies in place. A feedback line's tick charges the
  // nearest frame that does (`inf_add_row_owner`), since the line is the
  // enclosing record's (SYNTAX §«<~»).
  inf_mark_transparent()
  inf_add_row_owner(EffRow)
  // Strip every edge reaching the cell from the open frame's accumulated row
  // — a handler's exit cutting its remainder world out of the residual
  // before it is published (register_handler).
  inf_cut_edge(Int)
  inf_current_row() -> EffRow
  inf_current_world() -> EffRow
  inf_enter_arm(Int, Ty)
  inf_exit_arm()
  inf_arm_tys() -> Option((Int, Ty))
  // The install-frame mark: a tee body's frame is ONE install's scope, so
  // same-named instance fragments of an effect ITS HANDLER answers (yield's
  // + result's) join by position; an effect the handler does not answer is
  // a plain accumulation there, as it is in every other frame (joining a
  // caller's independent callee instances unified Float with Int across the
  // wheel — the 286-error m3 census — and, inside persist's install, a cast
  // of a list with a cast of a thunk, which no handler serves).
  // The mark carries what the tee ABSORBS, so the accumulation seam knows
  // which instances are one install's.
  inf_mark_install_frame([EffName])
  inf_install_absorbs() -> [EffName]
  // The pass's prereg ceiling — graph_next at the moment pre-registration
  // completed, set once per pass by its driver. The finalize's completion
  // prune reads it: a free edge minted at or above it is an unconstrained
  // judgment copy (drops as pure); below it, a prereg live link (kept).
  set_mint_ceiling(Int)
  inf_mint_ceiling() -> Int
  // The OPEN declaration's entry mint — graph_next when the top-level
  // judgment in progress began, set at each statement's judgment when no
  // frame is open. With the ceiling it bounds the instance column to the
  // copies an exit install can miss: a root below the ceiling is a
  // pre-registered cell of an unjudged co-member, a root at or above the
  // entry is a cell of the declaration being judged (a self-reference's
  // copy); every other root belongs to an exited declaration whose gates
  // were installed before the copy was minted and are copied at the mint.
  inf_open_decl(Int)
  inf_decl_entry() -> Int
  // Does module `from` import module `to`, transitively? Read off the
  // module DAG's reachability table, built once per judgment from the
  // graph's own import edges (F0b): does `from` import `to` transitively,
  // or is `to` in the prelude's closure, which the driver links into every
  // compile unasked.
  inf_module_reaches(Int, Int) -> Bool
}

handler infer_ctx with stack = [], arm_stack = [], install_marks = [], mint_ceiling = 0, decl_entry = 0, reach = [], kept = [] {
  inf_module_reaches(from, to) => {
    let table = if len(reach) == 0 { module_reach_table() } else { reach }
    resume(reach_table_has(table, from, to)) with reach = table
  },
  inf_enter_fn(h, fn_span, effs) => // stack = [InferFrame, ...] where each InferFrame is a record:
  //   {accumulated_row: EffRow, declared: List, fn_span: Span, owner: Bool,
  //    params: [Int], row_handle: Int}
  //   declared = [(EffName, negated)] — the fn's authored annotation, born
  //   with the frame and returned by inf_exit_fn (nested fns get their own)
  // arm_stack = [(the continuation handle, the op's declared return), ...]
  //   — the typed-resume context (SYNTAX §Effect declarations): inside
  //   `op(args) => body` for `op : (P...) -> R` under a handler whose
  //   handle-result is S, `resume : R -> S`, and R as the op declares it,
  //   which every resumed value owes. ResumeExpr reads the top frame; a
  //   stack because handler decls nest inside arm bodies.
  {
    // The frame is BORN with its declaration: `effs` = the FnStmt's authored
    // [(EffName, negated)] list (empty for lambdas / tee bodies / arm scopes).
    // No ambient declared-scalar to clobber — a nested fn gets its own.
    let frame =
      {accumulated_row: mk_ef_pure(), declared: effs, fn_span, owner: true, params: [], row_handle: h}
    // drift-audit: ignore — bounded-depth frame PUSH (one per fn nesting level, popped at exit; §9 push-at-END), not a loop accumulator
    resume() with stack = stack ++ [frame]
  },
  inf_frame_params(ps) => // The frame's SIGNATURE CELLS — the handles whose live types the
  // completion prune must keep reachable at exit (a decl's params and
  // return, a lambda's params and body, a handler's config cells and
  // state). Recorded once after the frame's own mint; read at EVERY exit
  // below this frame, not only its own — see inf_exit_fn.
  if len(stack) == 0 {
    resume()
  } else {
    let frame = last(stack)
    resume() with stack = push(drop_last(stack), {...frame, params: ps})
  },
  inf_keep_open(cells) => resume() with kept = push(kept, cells),
  inf_keep_close() => if len(kept) == 0 { resume() } else { resume() with kept = drop_last(kept) },
  inf_exit_fn() => if len(stack) == 0 {
    resume(([], -1, mk_ef_pure(), span_zero()))
  } else {
    let frame = last(stack)
    // The published row is COMPUTED here and FINALIZED by the caller
    // (exit_frame): the finalize op, not the teaching bind — the frame's
    // accumulation is the decl's own total, and a JOIN would re-widen what
    // row_without_self strips (the teaching bind joins by the lattice law;
    // the exit REPLACES — two algebras, two ops) — and the gate check that
    // judges the value must report in the body's world, where every
    // capture bracket the judgment installed can see it (an arm's report
    // resolves OUTER of its own install, the graph_guard_drain law).
    //
    // THE KEEP-SET IS THE WHOLE STACK'S SIGNATURES, not this frame's own.
    // A nested frame — a lambda, a `~>` body, a fanout thunk — exits
    // INSIDE the declaration whose parameters its body may call, and a
    // parameter's row cell escapes through THAT declaration's signature,
    // exactly as the prune's own third keep category says. The nested
    // exits used to pass their own signature (the tee and the fanouts:
    // nothing; the lambda: its own params only), so a parameter's row was
    // dropped as judgment scratch before the declaration's gate could
    // read it: `fn run(f) = (f()) ~> h` published Pure, and a program that
    // performed an effect nobody handles compiled clean and trapped at the
    // root (tests/lens/negation, the prune probes — measured 2026-09-25).
    // The two forms this replaced were both measured on scratch copies of
    // the tree: no prune at nested exits keeps judgment scratch behind
    // the tee's mask cell, where neither the decl's prune nor the
    // quantifier reaches it, and ONE caller's effects then leak into a
    // library function's published row for every later caller (163
    // mismatches across the wheel); pruning with the inherited keep-set
    // keeps the parameter and drops the scratch (one under-declared
    // signature exposed, its own).
    // AND THE ENCLOSING FRAMES' OWN ROW CELLS: a mono self-reference from
    // inside a lambda charges the enclosing declaration's live accumulator
    // (`fn a(n) = … run(() => a(1))`), a judgment-era free cell in no
    // signature, and the prune dropped it as scratch — the lambda
    // published Pure while calling a fn that performs E, so a gate pushed
    // onto the lambda's row reached nothing and `run`'s `!E` was violated
    // with zero diagnostics (measured 2026-09-27, adv-self-arg). The cell
    // is a live link exactly as a pre-registered cell is; the declaration's
    // own exit cuts the edge to itself (row_without_self) as it always did.
    // AND THE OPEN RUNS' REGISTRATIONS: a block member judged before the
    // sibling it calls chains the sibling's pre-registered row cell, minted
    // above the ceiling and free until the sibling's own judgment fills it.
    let keep =
      signature_free_roots((stack |> map((fr) => fr.params) |> flatten) ++ flatten(kept)) ++ (drop_last(stack) |> map((fr) => fr.row_handle))
    let published =
      row_keep_completion(row_without_self(frame.accumulated_row, frame.row_handle), mint_ceiling, keep)
    // The popped frame's declaration comes back to the closer — the
    // enforcement site reads it from the resume value, no ambient read.
    // An install mark on THIS depth pops with its frame.
    let marks2 = if len(install_marks) > 0 {
      if mark_depth(last(install_marks)) == len(stack) { drop_last(install_marks) } else { install_marks }
    } else {
      install_marks
    }
    resume((frame.declared, frame.row_handle, published, frame.fn_span)) with stack = drop_last(stack), install_marks = marks2
  },
  inf_mark_install_frame(handled) => // drift-audit: ignore — bounded-depth mark PUSH paired with the exit's pop (§9 push-at-END), not a loop accumulator
  resume() with install_marks = push(install_marks, (len(stack), handled)),
  inf_install_absorbs() => resume(if len(install_marks) == 0 {
    []
  } else {
    match last(install_marks) {
      (depth, handled) => if depth == len(stack) { handled } else { [] },
    }
  }),
  inf_mark_transparent() => if len(stack) == 0 {
    resume()
  } else {
    resume() with stack = push(drop_last(stack), {...last(stack), owner: false})
  },
  inf_add_row_owner(row) => match owner_frame_at(stack, len(stack) - 1) {
    None => resume(),
    Some(i) => {
      let frame = list_index(stack, i)
      resume() with stack = take(i, stack) ++ [{...frame, accumulated_row: union_row(frame.accumulated_row, row)}] ++ drop(i + 1, stack)
    },
  },
  inf_add_row(row) => if len(stack) == 0 {
    // No frame is open only where nothing declares a row: a module value
    // let's init and a proposer's candidate. Each charge was noted on the
    // node that makes it first (`inf_add_row_at`), which is where a reader
    // finds it: the executable root gate reads a value let's init row off
    // its nodes (pipeline.mn's report_unhandled_init); the proof gate does
    // not yet read a candidate's (`Hβ.synth.candidate-row-is-unjudged`). An
    // authored return's claim reached here after its declaration's frame had
    // closed, and its payment was dropped until S6 moved the claim inside.
    resume()
  } else {
    // The union is a plain value join — never a resolve: a fold here
    // would unwrap a `~>` subtraction's opaque mask edge and re-inline
    // its underlying set raw, dropping the subtraction for
    // late-arriving content (the multieffect-leak class; measured as
    // this arm's own first fold form, reverted same day). Boundedness
    // is the QUANTIFICATION FLOOR's job at the publish, not a fold's
    // here.
    let frame = last(stack)
    let extended = union_row(frame.accumulated_row, row)
    // drift-audit: ignore — top-frame REPLACE on a bounded-depth stack (§9 push-at-END), not a loop accumulator
    resume() with stack = push(drop_last(stack), {...frame, accumulated_row: extended})
  },
  inf_cut_edge(cell) => if len(stack) == 0 {
    resume()
  } else {
    // The same cut the exit applies to the frame's own cell
    // (row_without_self), aimed at another: the row is folded, every edge
    // chasing to the cell drops, the rest stay open.
    let frame = last(stack)
    resume() with stack = push(drop_last(stack), {...frame, accumulated_row: row_without_self(frame.accumulated_row, cell)})
  },
  inf_current_row() => if len(stack) == 0 {
    resume(mk_ef_pure())
  } else {
    let frame = last(stack)
    resume(frame.accumulated_row)
  },
  inf_current_world() => // The continuation world is the current frame's LIVE row variable, not the
  // accumulated prefix observed at the suspension point. The frame binds that
  // variable on exit, so effects in the remainder are carried without a copy.
  {
    if len(stack) == 0 { resume(mk_ef_pure()) } else { resume(mk_ef_open([], last(stack).row_handle)) }
  },
  inf_enter_arm(continuation_h, declared) => // drift-audit: ignore — bounded-depth arm-frame PUSH (§9 push-at-END), not a loop accumulator
  resume() with arm_stack = arm_stack ++ [(continuation_h, declared)],
  inf_exit_arm() => if len(arm_stack) == 0 { resume() } else { resume() with arm_stack = drop_last(arm_stack) },
  inf_arm_tys() => if len(arm_stack) == 0 { resume(None) } else { resume(Some(last(arm_stack))) },
  set_mint_ceiling(n) => resume() with mint_ceiling = n,
  inf_mint_ceiling() => resume(mint_ceiling),
  inf_open_decl(n) => if len(stack) == 0 { resume() with decl_entry = n } else { resume() },
  inf_decl_entry() => resume(decl_entry),
}

// The nearest frame that owns a record, by position; the transparent frames
// above it keep their rows as they were.
fn owner_frame_at(stack, i) = if i < 0 {
  None
} else if frame_owns(list_index(stack, i)) {
  Some(i)
} else {
  owner_frame_at(stack, i - 1)
}

// The frame's exit, finished in the BODY's world: the arm computes the
// published row and hands it back; the finalize and its gate check run
// here, where a refusal reaches every bracket the judgment installed.
// Returns the frame's authored declaration for the enforcement site.
fn exit_frame() = match inf_exit_fn() {
  (declared, h, row, sp) => {
    // The decl-exit REPLACE is judged by `row_gate`, the install every
    // judgment runs under: a cell a caller's gate reached before this
    // declaration finalized (the co-member `run(a)` shape — `a`'s
    // pre-registered cell gated by `run`'s exit, then bound to `a`'s
    // judgment cell, which now finalizes) is checked against every gate it
    // carries there, and the gates ride the finalized value's free
    // terminals.
    if h < 0 { () } else { graph_finalize_row(h, row, Located(sp, Inferred("fn effect row"))) }
    declared
  },
}

// fresh_for_inference — the FreshHandle install inference runs under:
// `mint` resolves to real graph handles (graph_fresh_ty). Declared HERE, the
// op's own layer, so every re-inference chain (synth's candidate verify
// included) reaches it through `import infer`.
handler fresh_for_inference {
  mint(reason) => {
    let h = graph_fresh_ty(reason)
    resume(h)
  },
  mint_row(reason) => {
    let h = graph_fresh_row(reason)
    resume(h)
  },
}

// The callee-row accumulation seam. Same-named effect-instance FRAGMENTS
// join by position ONLY inside an INSTALL frame (a tee body — one
// install's scope: yield's Iterate(el, r) and result's Iterate(el', r')
// are fragments of ONE instance, and the name-set union would drop one).
// Everywhere else the frame is a plain accumulation: joining a CALLER's
// independent callee instances unified Float with Int across the wheel
// (fold over [Int] then fold over [Float] in one body — the 286-error m3
// census). The name-set keeping one entry per name across genuinely
// distinct instances is the standing representation tension
// (parameterized-negation-instance).
// THE ONE WRITER, TWICE OVER (C5): a construct's charge joins the frame's row
// cell AND is noted on the node that makes it, in one move — the frame
// keeps the declaration's total, the note keeps the sub-expression's share,
// and a subtree's row is then a read over structure (row_of_subtree,
// graph.mn) instead of the shape guess the e-graph's purity gate used to
// make. Every site that charges a node-owned cost calls this; the frame-
// only form below stays for the few charges no single node owns.
fn inf_add_row_at(h, row) = {
  graph_row_note(h, row)
  inf_add_row(row)
}

// A charge the node makes on behalf of the record that owns it — a feedback
// tick's — joined into the nearest owning frame.
fn inf_add_row_owner_at(h, row) = {
  graph_row_note(h, row)
  inf_add_row_owner(row)
}

// PARTIALITY IS A ROW FACT (C5). Integer `/` and `%` trap on a zero
// divisor, and `/` on INT_MIN / -1; the site raises the precondition as the
// claim it is (PTotalDiv, decided by Verify's fragment from the operands'
// constants and from what their refined types exclude — a Positive refinement proves
// both faces, a NonZero refinement the zero face, a constant either), and
// reads the ledger's verdict: proven charges nothing, a refutation is
// reported there (`1 / 0` refuses at the site), and a claim left OPEN
// charges `Trap` into the frame's row and onto the node, so `!Trap` proves
// its absence transitively and the e-graph never drops an operand that
// could trap. A Float division is total in the substrate (IEEE answers inf
// and NaN) and raises no claim; an operand whose type is still a variable
// is judged as an integer, since it may be instantiated at one.
fn partiality_gate(handle, op, lh, rh, span: ValidSpan) = match op {
  BDiv => partiality_claim(handle, op, lh, rh, span),
  BMod => partiality_claim(handle, op, lh, rh, span),
  _ => (),
}

fn partiality_claim(handle, op, lh, rh, span: ValidSpan) = if ty_is_float(chase_deep(TVar(lh))) {
  ()
} else {
  match verify_claim(
    graph_module_current(),
    span,
    PTotalDiv(op, lh, rh),
    Located(span, Inferred("integer division is partial"))
  ) {
    Some(held) => if held {
      // A precondition proved it total: the trap is what that parameter
      // now GUARDS, paid by any caller whose argument does not prove it.
      lean_guards(rh, trap_row())
      lean_guards(lh, trap_row())
    } else {
      ()
    },
    None => inf_add_row_at(handle, trap_row()),
  }
}

// The parameters whose preconditions a held row fact leaned on take the row
// into their guards (verify.mn's leaves: a parameter's precondition is the
// one assumption a row fact may stand on, and its callers discharge it).
fn lean_guards(h, row) = leaves_params(value_leaves(h, NoSelf)) |> each(carry_guard(row, ??))

fn trap_row() = mk_ef_closed([ENamed(intern_str("Trap"))])

fn mutate_row() = mk_ef_closed([ENamed(intern_str("Mutate"))])

fn row_without_mutate(row) = match row {
  EfRow(present, absent, tail) => ef_make(filter(names_other_than_mutate, present), absent, tail),
}

fn names_other_than_mutate(e) = !names_mutate(e)

fn ty_is_float(ty) = match ty {
  TFloat => true,
  TAlias(_, inner) => ty_is_float(inner),
  TRefined(base, _) => ty_is_float(base),
  TReprPin(_, base) => ty_is_float(base),
  _ => false,
}

fn inf_add_row_unified_at(h, row) = {
  graph_row_note(h, row)
  inf_add_row_unified(row)
}

fn inf_add_row_unified(row) = {
  let absorbed = inf_install_absorbs()
  if len(absorbed) > 0 {
    match row {
      EfRow(np, _, _) => match inf_current_row() {
        EfRow(cp, _, _) => each(
          {
            EParameterized(n, args_b) => if name_set_contains(absorbed, ENamed(n)) {
              match find({ EParameterized(cn, _) => cn == n, _ => false }, cp) {
                // Row-side args are EffArg (EAType-wrapped) — unwrap to the Ty
                // lists unify_instance_args joins; feeding the wrappers minted
                // garbage nodes and joined those instead of the elements.
                Some(EParameterized(_, args_a)) => unify_instance_args(eparam_arg_tys(args_a), eparam_arg_tys(args_b), 0, span_zero()),
                _ => (),
              }
            } else {
              ()
            },
            _ => (),
          },
          np
        ),
      },
    }
  } else {
    ()
  }
  inf_add_row(row)
}

// ─── comment references — the backtick contract ─────────────────────
//
// A comment is a Reason edge (SYNTAX §Comments); a `backticked`
// identifier inside one is a REFERENCE into the one namespace, authored
// as such — bare prose is prose and never resolved against code. After
// the walk the env is whole, so every reference either RESOLVES — and a
// reference to a declared node DRAWS the comment-reference edge
// (graph_attach_comment_ref), so the identity is carried and the name
// is a projection (comments heal under rename; the audit's
// referenced-by line is the reverse read) — or narrates
// W_CommentRefUnresolved through the ordinary diagnostics chain at the
// comment's own span. The resolution surfaces, in order: the binders of
// the commented node and of the declaration around it (`cited_binder`,
// whose citation draws the edge to the binder's node); the surface's
// vocabulary
// (keywords via the lexer's keyword_kind — its one home — and the repr
// words); the declared program (the decl index — these draw the edge);
// the env's primitive schemes. A `$`-opening span is the program's
// EMITTED vocabulary: judged against what the program's own string
// literals write, built lazily on first use — and a BARE ident that
// misses every Mentl surface takes the same lazy judgment before
// narrating (a name the program's own literals write is the program's
// word); a program whose comments all resolve in Mentl terms never
// pays the walk. Spans with
// non-ident bytes are quoted CODE (illustrative; compiling them is the
// doc-test frontier) and `<...>` marks a schematic template — neither
// is a reference.
fn comment_refs_check(parse_start, parse_end) = {
  // The walk's bounds are THIS pass's own parse range: comments attach
  // only at parse (graph_attach_comment, like graph_index_span), so
  // handles above the frontend's frontier are comment-free by
  // construction, and handles BELOW its start belong to prior
  // generations whose comment cells still hold text — the old 0-to-
  // graph_next walk judged every stale generation's copy and probed
  // the judgment's millions of mints for prose (the crc share of the
  // healed profile, 19%, 2026-07-26).
  let dollars = crc_walk(parse_start, parse_end, [])
  if len(dollars) > 0 {
    let lvix = lit_vocab_build(0, graph_next(), smap_new())
    crc_judge_dollars(dollars, 0, lvix)
  } else {
    ()
  }
}

// The top-level declaration a node stands inside: its ancestor whose parent
// is the module, read up the parent edge.
fn top_declaration_of(h) = match graph_parent_of(h) {
  Some(p) => match graph_node_body(p) {
    NModule(_) => Some(h),
    _ => top_declaration_of(p),
  },
  None => None,
}

fn crc_walk(h, n, dollars) = if h >= n {
  dollars
} else {
  let t = graph_comment_at(h)
  let d2 = if byte_len(t) > 0 { crc_scan(t, 0, byte_len(t), h, dollars) } else { dollars }
  crc_walk(h + 1, n, d2)
}

fn crc_scan(ref t, i, n, h, dollars) = if i >= n {
  dollars
} else {
  if byte_at(t, i) == 96 {
    let j = ctick_close(t, i + 1, n)
    if j < n { crc_scan(t, j + 1, n, h, crc_judge(t, i + 1, j, h, dollars)) } else { dollars }
  } else {
    crc_scan(t, i + 1, n, h, dollars)
  }
}

fn ctick_close(ref t, i, n) =
  if i < n && byte_at(t, i) != 96 { ctick_close(t, i + 1, n) } else { i }

// One span, one verdict. A `$`-opening ident span queues for the lazy
// emitted-vocabulary judgment; a pure ident span resolves now; anything
// else in backticks is quoted code or schema, not a reference.
fn crc_judge(ref t, a, b, h, dollars) = if b <= a {
  dollars
} else {
  if byte_at(t, a) == 36 {
    if span_is_ident(t, a + 1, b) { dollars ++ [(h, str_slice(t, a + 1, b))] } else { dollars }
  } else {
    if byte_at(t, a) == 95 {
      if span_is_ident(t, a, b) { dollars ++ [(h, str_slice(t, a, b))] } else { dollars }
    } else {
      if span_is_ident(t, a, b) {
        let name = str_slice(t, a, b)
        if crc_resolve(name, h) { dollars } else { dollars ++ [(h, name)] }
      } else {
        dollars
      }
    }
  }
}

// A reference starts [A-Za-z_]; a digit-start span (`0x`, `125`) is a
// quoted LEXEME, not a name.
fn span_is_ident(ref t, a, b) = if a >= b {
  false
} else {
  let c0 = byte_at(t, a)
  if c0 >= 97 && c0 <= 122 || c0 >= 65 && c0 <= 90 || c0 == 95 {
    span_ident_walk(t, a + 1, b)
  } else {
    false
  }
}

fn span_ident_walk(ref t, a, b) = if a >= b {
  true
} else {
  let c = byte_at(t, a)
  if c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 95 {
    span_ident_walk(t, a + 1, b)
  } else {
    false
  }
}

// A backticked name resolves in the COMMENT'S OWN MODULE: a declaration the
// scope holds and the module reaches through its imports (the same reach the
// manifest holds a reference to, inf_module_reaches), a keyword, a surface
// word or a binder of the commented node or the declaration around it. A
// declaration the whole link carries but this module never imports is no
// edge the module can draw, so it does not resolve — until 2026-10-12 the
// index and the env were read over the flattened link, so a library module's
// prose cited the compiler's declarations and checked clean, and the same
// prose judged alone as its own entry narrated 139 unresolved references the
// board never saw (Hβ.voice.comment-ref-gate-reads-the-flattened-link, M7).
// A resolved name draws the comment's edge to its declaration, a binder's
// as much as a module's, so a rename rewrites the mention along it. The
// binder search is an extent whose publication is the binder it finds: the
// child lists it walks die at its exit.
fn crc_resolve(ref name, h) = match cited_binder(h, name) ~> arena {
  Some(b) => {
    graph_attach_comment_ref(h, b)
    true
  },
  None => if cites_field(h, name) {
    true
  } else {
    match keyword_kind(name) {
      Some(_) => true,
      None => if is_surface_word(name) {
        true
      } else {
        match env_resolve(name) {
          Some(referent) => if inf_module_reaches(graph_module_of(h), graph_module_of(referent)) {
            graph_attach_comment_ref(h, referent)
            true
          } else {
            false
          },
          None => false,
        }
      },
    }
  },
}

// The `$`-vocabulary judgment: what the program's own literals write IS
// part of the program. `$`-names normalize by shedding the sigil and
// leading underscores on BOTH sides of the comparison.
fn crc_judge_dollars(ref dollars, i, ref lvix) = if i >= len(dollars) {
  ()
} else {
  match list_index(dollars, i) {
    (h, raw) => {
      let name = shed_underscores(raw, 0)
      let hit = if byte_len(name) == 0 {
        true
      } else {
        match smap_get(lvix, name) {
          Some(ms) => lit_modules_reach(h, ms),
          None => match env_resolve(name) {
            // A declaration the scope holds is not yet a reference: the link
            // lays every module side by side in one scope, and an edge that
            // exists only because of that is a name lookup wearing an edge's
            // name. The referent's module must BE the comment's own or be
            // imported by it — measured at the landing, the entry link
            // answered 0 while the modules answered 57, and the 57 were real:
            // references crossing an import edge the wrong way, one naming a
            // DELETED decl, and English words in backticks.
            Some(dh) => inf_module_reaches(graph_module_of(h), graph_module_of(dh)),
            None => false,
          },
        }
      }
      if hit {
        ()
      } else {
        // The report is about the module the COMMENT lives in, not whichever
        // one this whole-weave walk happened to leave in force. Read it from
        // the commented node's own handle — the same read every judgment does
        // at its stmt — or the register scopes lib prose into the user's
        // stderr (measured: eight W_CommentRefUnresolved lines from `last`,
        // `join_loop` and `str_contains` reaching a caret projection on one
        // eight-line file).
        graph_module_enter(graph_module_of(h))
        report(WCommentRefUnresolved(comment_owner(h), raw, graph_comment_span_at(h)))
      }
      crc_judge_dollars(dollars, i + 1, lvix)
    },
  }
}

fn shed_underscores(ref s, i) = if i < byte_len(s) && byte_at(s, i) == 95 {
  shed_underscores(s, i + 1)
} else {
  str_slice(s, i, byte_len(s))
}

// Every identifier run a literal writes joins the emitted vocabulary,
// normalized the same way (sigils split runs; leading underscores shed),
// UNDER THE MODULES THAT WRITE IT: the index maps a run to the module nodes
// whose literals write it, and a comment's word resolves against it only
// where the comment's module reaches one of them — the same reach a
// declaration needs (crc_resolve). So lib/io.mn's prose cannot resolve
// through literals the EMITTER writes, which io.mn never reaches, and reads
// the same judged as its own entry and judged inside the wheel's link — a
// flat index over the link resolves it one way and narrates it the other
// (M7's last face, Hβ.voice.comment-ref-gate-reads-the-flattened-link). The
// walk reads every generation the graph holds, so in a session a word only an
// edited-away literal wrote still resolves where its generation's module
// is reached: a module's current handles are no column of its node
// (`Hβ.graph.module-nodes-are-a-column`).
fn lit_vocab_build(h, n, idx) = if h >= n {
  idx
} else {
  let idx2 = match graph_node_body(h) {
    NExpr(LitString(s)) => lit_runs_add(s, 0, byte_len(s), idx, graph_module_of(h)),
    _ => idx,
  }
  lit_vocab_build(h + 1, n, idx2)
}

fn lit_runs_add(ref s, i, n, idx, m) = if i >= n {
  idx
} else {
  if ident_byte(byte_at(s, i)) {
    let j = lit_run_end(s, i + 1, n)
    let tok = shed_underscores(str_slice(s, i, j), 0)
    lit_runs_add(
      s,
      j,
      n,
      if byte_len(tok) > 0 { smap_add(idx, tok, lit_modules_with(idx, tok, m)) } else { idx },
      m
    )
  } else {
    lit_runs_add(s, i + 1, n, idx, m)
  }
}

// The modules already writing a run, with this one joined once.
fn lit_modules_with(idx, tok, m) = match smap_get(idx, tok) {
  Some(ms) => if any({ x => x == m }, ms) { ms } else { ms ++ [m] },
  None => [m],
}

// A literal-written word is in a comment's reach when one of the modules
// writing it is: the comment's own, or one it imports.
fn lit_modules_reach(h, ms) = {
  let cm = graph_module_of(h)
  any({ m => inf_module_reaches(cm, m) }, ms)
}

fn lit_run_end(ref s, i, n) =
  if i < n && ident_byte(byte_at(s, i)) { lit_run_end(s, i + 1, n) } else { i }

fn ident_byte(b) with Pure =
  b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 95

// SURFACE vocabulary that is not an env name: the repr words (SYNTAX
// §repr pins) and `self`, the refinement's own binder (SYNTAX §Refinement).
fn is_surface_word(ref name) =
  name == "self" || name == "_" || name == "i32" || name == "i64" || name == "f32" || name == "f64" || name == "v128"

fn comment_owner(h) = match decl_spelling(h) {
  Some(name) => name,
  None => "node {int_to_str(h)}",
}

// A name a comment cites resolves to a binder of the node the comment is
// attached to, or of the top-level declaration around it: a fn's
// parameters, a handler's config, state, the ops its arms serve and their
// arguments, an effect's ops, a type's constructors, and every binder
// written inside them. It is asked one name at a time and answered by the
// first binder found — its node, so the citation draws an edge as a
// declaration's does.
fn cited_binder(h, name: String) = match owner_binder(h, name) {
  Some(b) => Some(b),
  None => match top_declaration_of(h) {
    Some(top) => if top != h { owner_binder(top, name) } else { None },
    None => None,
  },
}

// A handler's arms name the ops they serve, an effect its ops and a type its
// constructors, each in an entry of the declaration; every other binder is
// written inside the node.
fn owner_binder(h, name: String) = match graph_node_body(h) {
  NStmt(HandlerDeclStmt(_, _, _, _, arms, _)) => match find(serves_op(name, ??), arms) {
    Some(arm) => handler_arm_op_decl(arm),
    None => binder_within(h, name),
  },
  NStmt(EffectDeclStmt(_, _, ops)) => match find(op_named(name, ??), ops) {
    Some(op) => Some(op_entry_node(op)),
    None => binder_within(h, name),
  },
  NStmt(TypeDefStmt(_, ctors)) => map_option(ctor_entry_node, find(ctor_named(name, ??), ctors)),
  NStmt(_)
  | NExpr(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => binder_within(h, name),
}

fn serves_op(name: String, arm) = handler_arm_op_name(arm) == name

fn op_named(name: String, op) = part_op_name(op) == name

fn op_entry_node(op) = match op {
  (_, _, _, n) => n,
}

fn ctor_named(name: String, ctor) = part_variant_name(ctor) == name

fn ctor_entry_node(ctor) = match ctor {
  (_, _, n) => n,
}

// The first binder named `name` written inside a node, in the order the one
// child projection meets them: a pattern's binder, or a nested fn's own name.
fn binder_within(h, name: String) =
  fold(None, binder_step(name, ??, ??), body_child_handles(graph_node_body(h)))

fn binder_step(name: String, found, c) = match found {
  Some(_) => found,
  None => if binds_name(c, name) { Some(c) } else { binder_within(c, name) },
}

fn binds_name(c, name: String) = match graph_node_body(c) {
  NPat(p) => binder_spelling(p) == Some(name),
  NStmt(FnStmt(n, _, _, _, _)) => n == name,
  NStmt(_)
  | NExpr(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => false,
}

// A field of a constructor's record payload: a name a comment may cite that
// no node declares.
fn cites_field(h, name: String) = owner_fields(h, name) || match top_declaration_of(h) {
  Some(top) => top != h && owner_fields(top, name),
  None => false,
}

fn owner_fields(h, name: String) = match graph_node_body(h) {
  NStmt(TypeDefStmt(_, ctors)) => any(ctor_has_field(name, ??), ctors),
  NStmt(_)
  | NExpr(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => false,
}

fn ctor_has_field(name: String, ctor) = match ctor {
  (_, tys, _) => any(record_has_field(name, ??), tys),
}

fn record_has_field(name: String, ty) = match ty {
  TRecord(fs) => any(record_field_named(name, ??), fs),
  _ => false,
}

fn record_field_named(name: String, field) = match field {
  (fname, _) => fname == name,
}

// float_of_int / float_to_int are PRIMITIVES — the Int↔Float conversions lower
// recognizes (→ f64.convert_i32_s / i32.trunc_f64_s) that no .mn body can
// express. Their TYPES belong in the env like any scheme, read live by a call
// site, instead of flooring to E_MissingVariable (175 in the wheel) — the free
// var an untyped float_of_int leaves cannot force `float_of_int(n) * x` to
// Float, so the product's other operand floors to i32. Registered before
// pre_register so every module sees them; pure, monomorphic.
//
// `tangent_of(v, w)` is the tangent of v in the shape of the seed w — what
// `d(v)` means under `~> grad(w)` (lib/ml/grad.mn). Its meaning exists
// only inside the derivative reading, so it has a type and no forward
// lowering: the one arm that writes it is read as a rewrite and never
// lowered, and a call anywhere else refuses at lower.
//
// A primitive is declared by the judgment itself, so its declaration is a
// cell the judgment mints in the prelude's module, which every module
// reaches, and its facts are published at that cell like any declaration's.
fn register_primitives() = {
  let here = graph_module_current()
  match link_prelude() {
    Some(p) => graph_module_enter(p),
    None => (),
  }
  let f2i = mint(Declared("float_of_int"))
  let i2f = mint(Declared("float_to_int"))
  let tan = mint(Declared("tangent_of"))
  graph_module_enter(here)
  env_extend(
    "float_of_int",
    Frozen([], TFun([mk_param("_", TInt)], TFloat, mk_ef_pure())),
    Declared("float_of_int"),
    FnScheme,
    f2i
  )
  env_extend(
    "float_to_int",
    Frozen([], TFun([mk_param("_", TFloat)], TInt, mk_ef_pure())),
    Declared("float_to_int"),
    FnScheme,
    i2f
  )
  let seed_shape = mint(Inferred("the seed's shape"))
  env_extend(
    "tangent_of",
    Frozen(
      [seed_shape],
      TFun([mk_param("_", TFloat), mk_param("_", TVar(seed_shape))], TVar(seed_shape), mk_ef_pure())
    ),
    Declared("tangent_of"),
    FnScheme,
    tan
  )
}

// Two phases, and the order is load-bearing. Aliases are pure env writes
// with no body dependence — pre-pass citizens — so they register FIRST,
// before any fn signature quantifies its params. A fn used before its
// alias is declared (`fn f(span: ValidSpan)` in parser.mn precedes
// `type ValidSpan` in types.mn — src/ sorts before types.mn, which sorts
// last in the concatenated wheel) then reads the LIVE alias edge instead
// of baking a bare nominal TName that the main walk can never refine
// (build_param_types re-resolves an alias name like Vs to TAlias(Vs, TRefined(Int, _)) and
// unify(bare-TName Vs, Int) floors at the leaf — the `Span vs ValidSpan`
// / `Int vs ValidOffset` class, 362 census errors, Carried-Truth: the
// graph drew the alias edge; quantify_ctor_ty re-derived a nominal name).
fn pre_register_decls(stmts) = {
  refuse_duplicate_type_decls(stmts, 0, len(stmts), smap_new())
  each(pre_register_alias, stmts)
  each(pre_register_effect, stmts)
  // The duplicate-fn refusal is keyed by THIS WALK's own seen-set, never
  // by the env: an existing FnScheme entry may be a PRIOR JUDGMENT of the
  // same tree (the incremental cursor re-registers a changed module into
  // the restored world; re-registration shadows, which IS the re-judgment
  // semantics) — only a second decl within one statement list is the
  // violation.
  fold(smap_new(), pre_register_stmt, stmts)
  ()
}

// One `type` namespace, one walk: every type head — transparent alias,
// refined alias, ADT/nominal record — claims its name once per registration
// walk; a second claim reports EDuplicateTypeName at ITS decl span. Without
// the refusal the decls silently MERGE: each decl's ctors tag from 0, so a
// cross-tag match returns the wrong arm with zero diagnostics (measured:
// exit 13 where 99 was meant — Halt, tag 0 of a second Signal decl, matched
// the first decl's Go arm). Membership is a WALK-LOCAL seen-set, never an
// env probe: a multi-variant decl registers only its CTOR names, so the env
// holds nothing under the type name to probe, and the same name legitimately
// re-registers across walks (the two-pass judge's trial and final; the main
// walk overwriting pre-registered entries). Registration proceeds past the
// report — productive under error; the armed class refuses the executable
// at the gate. Both registration walks run it: the trial's copy is absorbed
// by diag_quiet, the final's reports for real.
fn refuse_duplicate_type_decls(stmts, i, n, seen) = if i >= n {
  ()
} else {
  let h = list_index(stmts, i)
  let span = graph_span_of(h)
  let claimed = match graph_node_body(h) {
    NStmt(AliasStmt(name, _)) => type_decl_claim(seen, name, span),
    NStmt(RefineStmt(name, _, _)) => type_decl_claim(seen, name, span),
    NStmt(TypeDefStmt(name, _)) => type_decl_claim(seen, name, span),
    NStmt(RowAliasStmt(name, _)) => type_decl_claim(seen, name, span),
    _ => seen,
  }
  refuse_duplicate_type_decls(stmts, i + 1, n, claimed)
}

fn type_decl_claim(seen, name, span) = match smap_get(seen, name) {
  Some(_) => {
    report(EDuplicateTypeName(name, span))
    seen
  },
  None => smap_add(seen, name, 1),
}

// The alias edges — registration's ONE home. The main walk keeps only
// RefineStmt's predicate Verify obligation.
fn pre_register_alias(ref node) = match graph_node_body(node) {
  NStmt(RefineStmt(name, base_ty, pred)) => env_extend(
    name,
    Frozen([], TAlias(name, TRefined(base_ty, node_to_predicate(pred)))),
    Declared(name),
    FnScheme,
    node
  ),
  NStmt(AliasStmt(name, ty)) => env_extend(name, Frozen([], TAlias(name, ty)), Declared(name), FnScheme, node),
  // A named effect row is an ENV fact: the triples stored verbatim,
  // expansion at build_declared_row (Hβ.types.named-effect-rows).
  // The scheme's Ty is nominal only so the entry has a shape; the
  // row alias never participates in type unification.
  NStmt(RowAliasStmt(name, effs)) => env_extend(name, Frozen([], TName(name, [])), Declared(name), RowAliasKind(effs), node),
  _ => (),
}

// The effect decls — registration's OWN phase, before any handler sig
// (pre_register_alias's precedent one namespace over): a handler's
// identity derives its effect from the arms' op names THROUGH the effect
// env, so a HandlerDeclStmt that precedes its EffectDeclStmt in source
// order read an incomplete env and registered with a broken effect
// binding — the install then absorbed NOTHING and the executable gate
// refused a fully-handled program (measured 2026-07-29: intern_table
// moved to lexer.mn, which sorts before types.mn's `effect Intern`, and
// the whole wheel refused with "no install anywhere").
fn pre_register_effect(ref node) = match graph_node_body(node) {
  NStmt(EffectDeclStmt(name, params, ops)) => register_effect_ops(name, params, ops, node),
  _ => (),
}

fn pre_register_stmt(seen, ref node) = match graph_node_body(node) {
  NStmt(FnStmt(name, _, _, _, _)) => {
    // ONE NAME, TWO KINDS, judged at the fn's own write: effects register
    // before this fold, so an op of the same name is already in the env
    // and this declaration would silently WIN (every call then reaches
    // the fn, the linked module's own calls of its op mistyped — measured
    // 2026-09-17 as E_TypeMismatch noise inside threading.mn, exit 0,
    // WAT emitted). register_one_op's arm covers the other order. A
    // block's fn shadows an op lexically, as any local binding does, and
    // is not asked.
    match env_lookup(name) {
      Some((_, _, EffectOpScheme(prior_effect, _, _, _))) => report(EFnShadowsOp(name, prior_effect, graph_span_of(node))),
      _ => (),
    }
    pre_register_fn_once(seen, node)
  },
  NStmt(TypeDefStmt(name, variants)) => {
    register_type_constructors(name, variants, node)
    seen
  },
  NStmt(HandlerDeclStmt(hname, _ename, config, state, arms, _effs)) => {
    pre_register_handler_sig(hname, config, state, arms, node)
    seen
  },
  NStmt(HandlerChainStmt(name, chain)) => {
    // A chain's name registers beside the handlers' so an install anywhere
    // in the link resolves it (chain_of). Its type is unit: the name is
    // never a value — every install of it becomes its members' installs.
    env_extend(name, Frozen([], TUnit), Declared(name), HandlerChainKind(chain), node)
    seen
  },
  // EffectDeclStmt registered in the pre_register_effect phase above —
  // every handler sig in THIS fold reads a complete effect env.
  _ => seen,
}

// One fn declaration's pre-registration, refusing a second of its name in
// one namespace — the module's, or a block's run of fns (`judge_fn_run`).
fn pre_register_fn_once(seen, node) = match graph_node_body(node) {
  NStmt(FnStmt(name, params, ret_ann, _, _)) => match smap_get(seen, name) {
    Some(_) => {
      report(EDuplicateFnName(name, graph_span_of(node)))
      seen
    },
    None => {
      pre_register_fn_sig(name, params, ret_ann, node, graph_span_of(node))
      smap_add(seen, name, 1)
    },
  },
  // only a fn declaration pre-registers here
  _ => seen,
}

// The handler's identity IS a parsed fact: its effect (derivable from the
// arms' op names + the effect env entry), its instance type, its config shape,
// its residual row handle, and its HandlerKind. All of these read only parsed
// structure and the effect env (already registered by EffectDeclStmt above).
// Registering the identity here makes handler names resolve at forward-reference
// sites (`~> handler_name` before the handler's declaration in source order),
// and lets handler_e_r extract the HandlerKind for the ~> row algebra.
// The main walk's register_handler overwrites with the fully-inferred scheme
// after arm-body inference, reading the pre-registered r_handle so forward
// references share the same residual row handle.
fn pre_register_handler_sig(hname, config, state, arms, decl) = {
  let ename = derive_handler_ename(arms, hname)
  // A state field naming an op of the HANDLED effect is refused at the decl:
  // inside the arm bodies a bare `name` then means both the state read and
  // the op call — measured, the collision compiles clean and returns the
  // WRONG value (scratchpad collide: 5 where 42 was meant), and in a second
  // shape silently unbinds the arm's own parameter. The effect env is already
  // populated (EffectDeclStmt pre-registers above), so the op-ness read is
  // live; an effect declared after its handler in source order under-detects,
  // never falsely fires.
  each(
    (sf) => {
      let fname = state_field_name(sf)
      match env_lookup(fname) {
        Some(entry) => match entry {
          (_, _, kind) => match kind {
            EffectOpScheme(op_effect, _, _, _) => if op_effect == ename {
              report(EHandlerStateShadowsOp(hname, fname, graph_span_of(state_field_init(sf))))
            } else {
              ()
            },
            _ => (),
          },
        },
        None => (),
      }
    },
    state
  )
  let inst_vars = mint_instance_vars(ename, effect_instance_arity(ename), 0)
  let inst_ty = TName(ename, map(TVar, inst_vars))
  let inst_h = mint(Inferred("effect '{ename}' instance"))
  graph_bind(inst_h, inst_ty, Inferred("effect '{ename}' instance"))
  // A handler is typed by what it answers as well as by what it handles: an
  // arm's value is its install's value, so the answer is the second argument
  // of the handler's type, quantified like the instance, and every install
  // meets it with its own body's answer (`install_answer`).
  let answer_h = mint(Inferred("the answer of '{hname}'"))
  let handler_ty = TName("Handler", [inst_ty, TVar(answer_h)])
  let config_tparams = build_param_types(config)
  let scheme_body =
    if len(config) == 0 { handler_ty } else { TFun(config_tparams, handler_ty, mk_ef_closed([])) }
  let scheme_body_h = mint(Inferred("handler scheme of '{hname}'"))
  graph_bind(scheme_body_h, scheme_body, Inferred("handler scheme of '{hname}'"))
  let r_handle = graph_fresh_row(Inferred("residual of handler '{hname}'"))
  // The remainder world is minted HERE, below the pass's mint ceiling, so
  // the completion prune keeps it as a live link at every nested exit: a
  // lambda in an arm that resumes carries it in its row to whatever callee
  // it reaches.
  let w_handle = graph_fresh_row(Inferred("the remainder a resume of '{hname}' runs"))
  // The KIND carries the MINTED tparams, never the parse placeholders:
  // the residual's install read (residual_with_config_args) chases these
  // cells to the config fns' row roots, and a placeholder chases nowhere.
  env_extend(
    hname,
    Frozen(inst_vars ++ [answer_h], scheme_body),
    Declared(hname),
    HandlerKind(r_handle, w_handle, config_tparams, state, arms),
    decl
  )
  // The op→handler edges — each arm's discipline JOINED onto its op's
  // scheme, and the MultiShot cost onto the op's row — are drawn HERE,
  // before any body is judged: an arm's grade is parse structure plus the
  // program's tail facts, both in hand before pre-registration, so a
  // perform judged ahead of its handler in source order reads the same op
  // the one judged after it does. Until 2026-09-27 the edges were drawn
  // only at the walk's registration, so an op's discipline and cost were
  // facts of source ORDER. register_handler still draws them for a handler
  // declared inside a body, which this walk never reaches; the join is
  // idempotent.
  draw_op_edges(arms, decl)
}

// The duplicate-fn refusal lives in pre_register_stmt's walk-local
// seen-set (an env-based check misread a prior judgment's entry as a
// duplicate the moment the incremental cursor re-registered a module
// into the restored world).
fn pre_register_fn_sig(name, params, ret_ann, handle, span: ValidSpan) = {
  let (param_tys, sig_scope) = build_param_scope(params)
  // An authored `-> RetTy` is a CONSTRAINT the pre-scheme must CARRY, not
  // discard (the parse_let-annotation twin at the return position). Binding
  // it here grounds every FORWARD callsite: an unannotated forward ref
  // instantiates a quantified fresh return that its later real inference
  // never reaches, so a use with no local grounding floors to word width —
  // caret_proximity_weight's f64 result met an i32 definition, the indirect
  // call type mismatch the felt loop was the first to execute. Absent
  // annotation ⇒ the fresh var, inferred as before.
  let ret_handle = mint(FnReturn(name, Inferred("return of '{name}'")))
  // An AUTHORED return rides the TFun as the resolved Ty VALUE — the
  // declaration's postcondition, a contract — so the value walk's call
  // leaf (verify.mn `post_leaves`) reads it verbatim at every call: the
  // assume-the-signature induction a claim may stand on. The cell binds
  // the shape (forward-ref grounding + quantification); a cell never
  // holds a refinement (types.mn `shape_of`).
  let ret_component = match graph_node_body(ret_ann) {
    // Resolve through the alias edge FIRST (quantify_ctor_ty — the same
    // resolution build_param_types and apply_let_annotation use): binding
    // the raw syntactic TName made a refined alias look NOMINAL, so the
    // proposer enumerated constructors of Positive (zero) instead of
    // integer seeds under its refinement.
    NTypeAnn(ann_ty) => match quantify_ctor_ty(ann_ty, sig_scope, Located(span, Declared(name))) {
      (resolved_ret, _q) => {
        graph_bind(ret_handle, resolved_ret, Located(span, Declared(name)))
        resolved_ret
      },
    },
    // The absent-annotation marker (the parser mints LitUnit when no
    // `->` is authored): the return stays the fn's own minted cell —
    // the inferred form, not a fabricated absorber.
    //
    // drift-audit: ignore
    _ => TVar(ret_handle),
  }
  let row_handle = graph_fresh_row(Inferred("effects of '{name}'"))
  // THE PREREG ROW IS BARE (the movers' root, deleted 2026-08-07): it
  // carried the declared names as presents ("the inline-known half of
  // a forward-ref's row"), which was a DECLARATION entering the supply
  // side — the trial's self and intra-group charges folded the
  // declared flavor into published rows while the final (which skips
  // fn prereg) published the proof, and every over-declared fn became
  // a mover (fill_row's Memory+Alloc vs Memory, cornered by body
  // ablation). The forward-ref channel the carry served is the LIVE
  // EDGE now: a charge chains this prereg cell, the completion prune
  // keeps prereg cells as the cycle channel, and the callee's own
  // judgment fills it with PROVEN content the caller reads live. The
  // declaration lives in the GATE alone (ruling (1)).
  let fn_ty =
    TFun(with_guards(param_tys, guard_cells(params, name)), ret_component, mk_ef_open([], row_handle))
  graph_bind(handle, fn_ty, Located(span, Declared(name)))
  // Quantify the fresh param/return/row vars so a FORWARD reference — a fn used
  // before its own body is inferred (e.g. src/ inferred before lib/prelude, so
  // lower.mn's map/fold calls precede the prelude bodies that generalize them) —
  // is POLYMORPHIC, not a shared monotype. Frozen([]) here made every forward
  // call site reuse ONE set of param vars, so their argument record types all
  // unified into one (the handler-arm type {args,body,op_name} absorbing the
  // placement {ename,name,slot} + group {ename,arms} fields → the 7-field bloat
  // → arm.body@8). This IS HM generalization of forward refs: instantiate
  // freshens per call site. Recursion stays monomorphic — infer_fn binds the
  // handle (graph_bind above + the unify branch) so the vars are bound by the
  // time the body's self-calls instantiate this scheme.
  // The quantifier is generalize's own floor, ONE home: a hand-rolled
  // Frozen(free_in_ty(fn_ty), ...) here quantified the TOP-row cell —
  // free_in_ty(TFun) collects the row's free tail — so every forward
  // call site freshened its row copy above the mint ceiling, the
  // charge chained the copy, the completion prune dropped it as pure,
  // and the caller's trial row closed WITHOUT the callee's effects
  // (join_loop missing str_concat's Alloc — the movers' row channel).
  // generalize keeps row-sort cells unquantified-and-shared, so a
  // forward charge chains THIS prereg cell — the live link the prune
  // is designed to keep — and the callee's own judgment fills it.
  // Located so every reader of this entry's reason (the Why chain, the
  // executable gate's unhandled-effect diagnostic) projects the DECL's span.
  // The publish carries the CELL, not a snapshot of it: the quantifier is
  // a projection every reader runs at ITS moment of consumption
  // (judgment_ty / judgment_pair / instantiate, or the shallow chase below
  // the infer layer), so a decl the rest of the walk refines is read
  // refined instead of frozen at whatever it was when it finished.
  env_extend(name, Live(handle), Located(span, Declared(name)), FnScheme, handle)
}

// ─── THE ONE JUDGMENT (Hβ.infer.judge-once-per-scc) ─────────────────────
// One parse, one walk, callee-first by binding group, diagnostics shipping.
// This was the TRIAL of a two-pass tower, and the tower's own comment named
// the reason for the second pass: a forward reference under one pass reads
// the loose pre-registered scheme, so a verdict could depend on source
// order. The DAG walk below is the structural answer — callee-first order
// resolves every acyclic forward reference before its caller judges, and
// the cycle discipline judges each SCC as one unit — so what the second
// pass was actually supplying was measured, not assumed (2026-09-15): its
// handle numbering (a planned prefix-sum the parallel sweep needed), and a
// quantified view of every row var for the declared-row gate, which the
// gate now derives from its own signature. Both products replaced, the
// pass deletes; its price was 67% of the judgment's heap and the 5% that
// kept the wheel above the warm-start line.
fn infer_program_once(stmts, parse_start, parse_end) = {
  register_primitives()
  // The tail facts of these statements' functions join the program's BEFORE
  // pre-registration, which draws each handler's op edges from its arms'
  // grades (`arm_grade`), so every op's discipline — and the MultiShot cost
  // on its row — is settled before any body is judged. A function this
  // judgment does not judge keeps the facts the last one wrote.
  graph_tails_note(program_tails(stmts))
  pre_register_decls(stmts)
  // The completion prune's boundary: everything below this frontier is a
  // prereg cell (a decl's live accumulator — kept as a shared link);
  // everything minted above it during the walk is judgment scratch (a
  // still-free one drops as pure at its decl's finalize).
  set_mint_ceiling(graph_next())
  // The DAG is PARSE truth, read before any judgment: free names +
  // decl names give the Tarjan BINDING GROUPS, so the trial itself
  // walks callee-first with each cycle judged as one unit under the
  // cycle discipline. Its finals are MEANT to be the fixpoint on
  // arrival; the movers count is the measured distance from that claim.
  // This comment used to name the distance's cause as snapshot publishes
  // under-resolving, and to promise that live join-cells would drive it
  // to zero. MEASURED FALSE, 2026-09-01: both publishes became Live(handle)
  // and every reader was made total over the posture, and the count did not
  // move — 470 before, 470 after, the same four flips. The snapshot was
  // never stale WITHIN a pass, because this walk is callee-first and a decl
  // is finished when it publishes. The divergence is BETWEEN GENERATIONS: a
  // trial cell and a final cell are different nodes in different parses, and
  // no amount of liveness inside one pass can make two of them agree. So the
  // count cannot reach zero while both passes exist, and the retirement
  // condition below is not a gate the walk can pass — the pass is what has
  // to go. The layers ride out to order the final's planned sweep (one
  // collection, two readers). The walk is an extent whose publication is
  // the frees table alone, so it runs in an arena: every list it builds on
  // the way — each block's runs among them — dies at its exit.
  let frees_all = stmt_frees(stmts) ~> arena
  let name_idx = layer_name_index(map(stmt_decl_name, stmts), 0, smap_new())
  let groups = scc_groups(frees_all, name_idx)
  trial_group_walk(stmts, groups, 0)
  // The prose gate reads THIS judgment's own cells and nothing older: the
  // comment cells are the one generation the parse minted, [parse_start,
  // parse_end). The cold route parses from handle 0, so the range used to
  // start there — and the session's cone, which judges into a graph that
  // already holds every generation the session has seen, walked every
  // superseded generation's comment cells on every edit: three cone
  // judgments of one four-line lesson narrated the SAME thirty-six
  // unresolved references of types.mn three times over (the bank read 39,
  // then 79, then 119). The lazy `$`-vocabulary (lit_vocab_build) still
  // reads every generation's literals, which can only resolve more, never
  // less.
  comment_refs_check(parse_start, parse_end)
  // What can reach a value is a fact of the whole program, so the claims
  // naming a label are decided here, once every declaration is judged.
  flow_settle()
} ~> row_gate ~> store_ages ~> infer_ctx ~> fresh_for_inference

// Reports said to no one: the discovery parse's import read (the weave
// parse reports every lex diagnostic again, placeably) and the gradient's
// dry claims (a proposal judged on a scratch ledger, its refutation the
// answer and never a report). The counts answer zero, because nothing
// here judges the program.
handler diag_quiet {
  diag_report(_d, _msg, _dmod, _dlayer) => resume(),
  diag_errors() => resume(0),
  diag_narrations() => resume(0),
}

// diag_branch — the branch cursor's per-statement collector: each report
// held as the fact it carried (the kind, its message rendered at the
// perform against the branch's live values, its module); the local tally
// answers any in-branch diag_errors read with branch-local truth;
// diag_lines_taken hands the facts to the join, which re-performs each into
// the root chain, so every Diagnostic forwarder — the bank among them — sees
// a branch report exactly as a live one.
handler diag_branch with lines = make_list(16), count = 0, errors = 0 {
  diag_report(diag, msg, dmod, dlayer) => {
    let grown = list_set(list_extend_to(lines, count + 1), count, (diag, msg, dmod, dlayer))
    if diag_severity(diag) == SError {
      resume() with lines = grown, count = count + 1, errors = errors + 1
    } else {
      resume() with lines = grown, count = count + 1
    }
  },
  diag_errors() => resume(errors),
  diag_narrations() => resume(count - errors),
  diag_lines_taken() => resume(list_to_flat(slice(lines, 0, count))),
}

// The Mycroft speculation's release read (§11 5.3, the fragment) — the
// capture handler hands the driver its held list through this op, the
// diag_lines_taken precedent one bracket over.
effect PolyCapture {
  poly_captured() -> [(DiagKind, String, String, Layer)]
}

// The speculative judgment's diag CAPTURE: an attempt runs under it so
// a retried-and-succeeded judgment leaves no stain — reports HOLD in
// state as the facts they carried (the diag_branch precedent); the
// ledger reads forward live (a mid-attempt reader sees the enclosing
// counts — the v1 boundary, noted at the stamp); the driver replays the
// held list outward on accept or drops it for the honest re-run.
handler poly_capture with held = [] {
  diag_report(diag, msg, dmod, dlayer) => resume() with held = push(held, (diag, msg, dmod, dlayer)),
  diag_errors() => resume(diag_errors()),
  diag_narrations() => resume(diag_narrations()),
  poly_captured() => resume(held),
}

// A single source IS a module — the REPL line's, a proposal the gate judges
// — and the program a link of it alone: its declarations answer. There is no
// unattributed parse and therefore no absent case for any reader to carry:
// the column is total because entering a module is what parsing is.
fn infer_program_converged(src) = {
  let link = enter_link_root(User)
  let start = graph_next()
  let mh = mint_module("<stdin>", "<stdin>", src, User)
  link_register(link, Some(mh), [mh], None)
  infer_modules_converged([mh], start)
  module_of(mh).decls
}

// ─── The per-module parse — one text per module, never one weave ─────────
// THE ROOT the module-blind parse compensated for five ways (the out-of-band
// range map, NModule minted after the fact from that map, rehome_seam_comments
// whose own comment said "the parser cannot see seams", module_path_of_span's
// containment scan, and the seam-render family). The driver used to
// concatenate the dep DAG into ONE text, so every node was born in the weave's
// coordinate space unattributed and five machines existed to put back what
// that threw away.
//
// One-namespace judgment never required one TEXT, only one ENV. So: parse each
// module on its own, judge every module's declarations as one program. Spans
// are local from birth because each lex starts at line 1, and the module is on
// the node because the parse runs inside it.
//
// THE LINK, entered before anything else can mint or report. Without it the
// window between graph install and the first per-file parse has no module in
// force — discovery's E_MissingModule fires there — and the readers would
// each need a "which file, if any" arm, which is the absent case this column
// exists to not have. Its members are registered once the walk has found
// them (`link_register`).
fn enter_link_root(layer) = {
  let rspan = Span(1, 0, 1, 0)
  let link = mint_node(NLink({entry: None, layer, modules: [], prelude: None}), rspan)
  graph_module_enter(link)
  link
}

// The link's members, registered on its node: the module a person named, the
// modules in the order the walk judged them, and the prelude.
fn link_register(link, entry, modules, prelude) =
  graph_register_node(link, NLink({...link_of(link), entry, modules, prelude}))

// A module's node, minted with its text before any module is parsed, so every
// module can be an import edge of the others before one of them is judged.
fn mint_module(name: String, file: String, text: String, layer) = {
  let span = Span(1, 0, count_lines(text) + 2, 0)
  mint_node(NModule({decls: [], file, imports: [], layer, path: name, span, text}), span)
}

// The module nodes a module's import lines reach, drawn on its node.
fn module_imports_draw(mh, imports) = graph_register_node(mh, NModule({...module_of(mh), imports}))

// One module parsed inside its node, its declarations registered there —
// exactly the decls, with no span-containment filter, because there is no
// weave to cut.
fn parse_one_module(mh) = {
  let m = module_of(mh)
  graph_module_enter(mh)
  // The parse is an ARENA (lib/arena.mn): it publishes the module's
  // statements and the nodes it wrote into the graph, and the tokens and
  // everything built on the way to them die at its exit.
  let stmts = lex(m.text) |> parse_program |> import_set ~> arena
  graph_register_node(mh, NModule({...m, decls: stmts}))
  stmts
}

// A run of a module's lines read again, its text starting at line `line`:
// parsed inside the module's node, its tokens carrying the module's own
// coordinates, so the statements it answers are the ones the whole text's
// parse would have minted there. The module's node takes them when the edit
// is committed.
fn parse_lines(mh, run, line) = {
  graph_module_enter(mh)
  lex_lines(run, line) |> parse_program |> import_set ~> arena
}

// What a replaced or a judged handler serves, op by op: its name, the
// discipline each arm adds to the op it answers (an arm whose grade is the
// join's identity adds none), and the effects its arms' ops are declared in.
fn handler_served(h) = match handler_arms_of(h) {
  [] => [],
  arms => match decl_spelling(h) {
    Some(name) => [(name, arms |> map(arm_discipline) |> filter(adds_discipline), flat_map(arm_effect, arms))],
    None => [],
  },
}

fn arm_discipline(arm) = (handler_arm_op_name(arm), arm_disc_of(arm_grade(arm)))

fn adds_discipline(served) = match served {
  (_, OneShot) => false,
  (_, MultiShot) | (_, Abandon) => true,
}

fn arm_effect(arm) = match graph_ref_decl(handler_arm_op(arm)) {
  Some(d) => match enclosing_decl(d) {
    Some(e) => [e],
    None => [],
  },
  None => [],
}

fn handler_arms_of(h) = match graph_node_body(h) {
  NStmt(s) => match s {
    HandlerDeclStmt(_, _, _, _, arms, _) => arms,
    FnStmt(_, _, _, _, _)
    | TypeDefStmt(_, _)
    | EffectDeclStmt(_, _, _)
    | HandlerChainStmt(_, _)
    | RefineStmt(_, _, _)
    | AliasStmt(_, _)
    | RowAliasStmt(_, _)
    | LetStmt(_, _, _)
    | ExprStmt(_)
    | ImportStmt(_) => [],
  },
  NExpr(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => [],
}

// The effects whose ops' disciplines an edit moved: a handler's arms graded
// differently after the judgment than before, or a handler gone or new whose
// arms add a discipline. The join an op's entry carries only rises, so the
// effect declaring the op is judged again, from its own declaration, with
// every handler that serves it and every perform of it.
fn served_moved(before, after) = {
  let moved = flat_map(served_change(after, ??), before) ++ flat_map(served_new(before, ??), after)
  filter(graph_node_current, moved)
}

fn served_change(after, b) = match b {
  (name, discs, effects) => match find(served_named(name, ??), after) {
    Some(a) => match a {
      (_, now, now_effects) => if now == discs { [] } else { effects ++ now_effects },
    },
    None => if len(discs) == 0 { [] } else { effects },
  },
}

fn served_new(before, a) = match a {
  (name, discs, effects) => match find(served_named(name, ??), before) {
    Some(_) => [],
    None => if len(discs) == 0 { [] } else { effects },
  },
}

fn served_named(name: String, s) = match s {
  (n, _, _) => n == name,
}

// THE ONE JUDGE (Hβ.infer.order-independent-verdicts): every judgment
// site runs this — the stdin compile, the driver DAG (check/audit/
// teach/at/field/session), the warm path, the battery, the repl line.
// The single-pass walk it replaced read loose pre-registrations at
// every intra-module forward reference, so a forward-referenced fn's
// callers bound silently against a free scheme (measured: a
// [tuple]-returning fn declared after its caller flowed into a
// [String] consumer with no refusal — the b1 probe).
//
// ─── The judgment: trial, then a SECOND JUDGE the trial still needs ────
//
// The ROUNDS ARE DELETED (schemes-are-edges' first big rung — the tower
// comes down by deletion, never by better iteration). The trial walks
// callee-first over parse-truth layers with every Tarjan cycle judged
// as one unit under the cycle discipline; the twelve quiet rounds spent
// eleven re-derivations on what one walk should prove, and their own
// per-round re-parse REGENERATED the one oscillator they existed to
// settle (the bound-hit mover was rounds-resident, measured — no
// trial-side fix could clear a rounds-side artifact). The final
// re-judges EVERYTHING against the trial's finals — planned, bracketed,
// reporting. Call that what it is (Morgan's cut, 2026-07-31): NOT
// verification — on a mover it narrates the divergence and proceeds
// with ITS OWN answer, override wearing verification's name; a verifier
// refuses, or the divergence is impossible by construction. The second
// pass is the TWO-GENERATION tower at cadence two, and it takes NO
// improvements (Anchor 2's condemned-forms clause). Its retirement
// condition was written as "movers 0 makes this pass VACUOUS and it
// DELETES" — a gate the walk cannot pass, measured 2026-09-01: schemes
// ARE live join-cells now and the count did not move, because the
// divergence is between the two PARSES, not between a snapshot and a
// cell (the trial-walk comment carries the measurement). The honest
// condition is order-independence closing structurally — decl→site
// propagation, so ONE generation suffices — and then the pass deletes
// and the count goes with it, rather than the count falling first and
// licensing the deletion.
// Per-compile correctness is structural; whole-program verification
// lives at the march, once per landing, never as a standing cadence.
// The tax is measured — PLAN §5.O's cost law carries the curve.
// Broken judgment → diagnostic, never a crawl; the fixpoint oracle
// arbitrates behind it.
// ONE LEX, ONE PARSE, ONE JUDGMENT. The second parse existed so the second
// pass could walk a fresh generation of nodes; the second pass existed to
// re-judge with planned handle numbering and every scheme already
// published. Neither is needed by a callee-first walk whose declared-row
// gate reads its own signature (infer_program_once), so the driver is the
// walk plus the cost line the board reads.
//
// The cost line is the maintainer's instrument and rides the register's
// scope read: unscoped compiles (march / census / battery) print it, a
// user-target verb's ScopeModule quiets it. `heap` is where the line stands
// when the judgment ends — EXACT, because the line moves only where the
// program moves it, up at an allocation and down at an arena's exit, so
// byte-identical runs read one number where peak RSS measured 33MB of
// kernel jitter (Hβ.perf.cost-ratchet-reads-the-image). The arenas' census
// is read once the module is written (arena_line, pipeline.mn).
// The `passes:` line and the movers report both measured the second pass
// and go with it; the movers ratchet reads zero because there is nothing
// left for a scheme to move between.
//
// The modules arrive as their nodes, minted from `start` on, so the judgment's
// own generation begins where its modules were minted.
fn infer_modules_converged(ref modules, start) = {
  let stmts = modules |> map(parse_one_module) |> flatten
  infer_program_once(stmts, start, graph_next())
  match diag_scope_of() {
    ScopeAll => eprint_string("heap: {heap_mark()} byte(s) when the judgment ends\n"),
    _ => (),
  }
}

// Every stmt's free-name list, collected once from the parse tree.
// THE FREES ARE THE CALL DAG, WHOLE. Every reference is an edge here because
// collect_free_vars walks the source itself — which is why a statement kind
// that answers [] in that walk is a decl with no callees as far as the
// judgment's order can tell (the handler-arm hole, closed 2026-09-17).
// Free names that key no decl (lib vocabulary, locals) drop through the
// index miss. scc_groups is the one reader: Tarjan over these edges gives
// the binding groups the walk judges callee-first, each cycle as one unit.
fn stmt_frees(ref stmts) = stmt_frees_walk(stmts, make_list(len(stmts)), 0)

fn stmt_frees_walk(ref stmts, own out, i) = if i >= len(stmts) {
  out
} else {
  stmt_frees_walk(stmts, list_set(out, i, list_to_flat(collect_free_vars(stmts[i], []))), i + 1)
}

// ─── Binding groups — Tarjan SCCs over the same frees DAG ───────────────
// The classic form the SOTA still runs on (GHC's binding groups; Salsa's
// cycle recovery is the discover-at-runtime cousin — Mentl's DAG is parse
// truth known up front, so it gets the stronger static form): groups pop
// in callee-first topological order BY CONSTRUCTION (a sink SCC completes
// first), each group judged ONCE with members sharing LIVE monomorphic
// entries, generalized together at group exit — mutual recursion
// constrains itself through shared cells within one judgment instead of
// through published finals across rounds.
// The walk state is one 7-tuple — (ctr, groups, idx, low, onstk, sp,
// stk): next visit number · popped SCCs (callee-first) · visit number
// per stmt (0 = unvisited) · Tarjan lowlink · stack-membership bit ·
// stack cursor · stack buffer. Destructured whole at each step.
fn scc_groups(ref frees_all, ref name_idx) = {
  let n = len(frees_all)
  match scc_sweep(
    frees_all,
    name_idx,
    (1, [], make_list(n), make_list(n), make_list(n), 0, make_list(n)),
    0
  ) {
    (_, groups, _, _, _, _, _) => groups,
  }
}

fn scc_sweep(ref frees_all, ref name_idx, st, v) = if v >= len(frees_all) {
  st
} else {
  let st2 = match st {
    (ctr, groups, idx, low, onstk, sp, stk) => if idx[v] == 0 {
      scc_visit(frees_all, name_idx, (ctr, groups, idx, low, onstk, sp, stk), v)
    } else {
      (ctr, groups, idx, low, onstk, sp, stk)
    },
  }
  scc_sweep(frees_all, name_idx, st2, v + 1)
}

fn scc_visit(ref frees_all, ref name_idx, st, v) = match st {
  (ctr, groups, idx, low, onstk, sp, stk) => {
    let st1 = (
      ctr + 1,
      groups,
      list_set(idx, v, ctr),
      list_set(low, v, ctr),
      list_set(onstk, v, 1),
      sp + 1,
      list_set(stk, sp, v)
    )
    match scc_edges(frees_all, name_idx, st1, v, frees_all[v], 0) {
      (c2, g2, i2, l2, o2, s2, k2) => if l2[v] == i2[v] {
        scc_pop((c2, g2, i2, l2, o2, s2, k2), v, [])
      } else {
        (c2, g2, i2, l2, o2, s2, k2)
      },
    }
  },
}

fn scc_edges(ref frees_all, ref name_idx, st, v, ref frees, j) = if j >= len(frees) {
  st
} else {
  let st2 = scc_edge_one(frees_all, name_idx, st, v, frees[j])
  scc_edges(frees_all, name_idx, st2, v, frees, j + 1)
}

fn scc_edge_one(ref frees_all, ref name_idx, st, v, free) = match smap_get(name_idx, free) {
  None => st,
  Some(k) => match st {
    (ctr, groups, idx, low, onstk, sp, stk) => if idx[k] == 0 {
      match scc_visit(frees_all, name_idx, (ctr, groups, idx, low, onstk, sp, stk), k) {
        (c2, g2, i2, l2, o2, s2, k2) => {
          let lv = imin(l2[v], l2[k])
          (c2, g2, i2, list_set(l2, v, lv), o2, s2, k2)
        },
      }
    } else if onstk[k] == 1 {
      let lv = imin(low[v], idx[k])
      (ctr, groups, idx, list_set(low, v, lv), onstk, sp, stk)
    } else {
      (ctr, groups, idx, low, onstk, sp, stk)
    },
  },
}

fn scc_pop(st, v, members) = match st {
  (ctr, groups, idx, low, onstk, sp, stk) => {
    let w = stk[sp - 1]
    let members2 = push(members, w)
    let onstk2 = list_set(onstk, w, 0)
    if w == v {
      (ctr, push(groups, members2), idx, low, onstk2, sp - 1, stk)
    } else {
      scc_pop((ctr, groups, idx, low, onstk2, sp - 1, stk), v, members2)
    }
  },
}

fn imin(a, b) = if a < b { a } else { b }

// The judgment's walk — binding groups in callee-first order, each a
// singleton judged once or a CYCLE judged as ONE unit. Each group is an
// ARENA (lib/arena.mn): what its judgment allocated and did not publish
// dies at its end. The group publishes into the graph, the env and the
// intern table, and every store it makes into their older memory journals
// itself, with the type the store knows, where it happens.
fn trial_group_walk(ref stmts, ref groups, g) = if g >= len(groups) {
  ()
} else {
  trial_judge_group(stmts, sort(groups[g])) ~> arena
  trial_group_walk(stmts, groups, g + 1)
}

// A singleton judges once; a CYCLE iterates locally to its own fixpoint.
// The MEASURED negative that shaped this (2026-07-30): the classic
// binding-group MONO form — members sharing unquantified live cells,
// generalized at group exit — was built here whole and REFUTED by the
// wheel's own judgment: 29 E_TypeMismatch convictions (Int vs Float,
// List(Byte) vs Int) where a cycle member is used at TWO instantiations
// by its co-members. The rounds are a MYCROFT iteration (polymorphic
// recursion by fixpoint) and the wheel genuinely uses that power inside
// its cycles, so the weaker classic form cannot serve. The per-SCC LOCAL
// iteration built next was ALSO killed (the second record below); what
// landed is the cycle DISCIPLINE alone, and the terminal form needs no
// iteration at all — the row equation closes by idempotence at the read
// (the resolved design D3/D4).
// A cycle's members judge once, adjacent, in source order — and the
// SECOND counted kill of the rung stands recorded here (2026-07-30,
// same day as the mono-group kill): per-SCC LOCAL MYCROFT ITERATION —
// probe passes over rollback-refreshed parse nodes (rollback as the
// fresh-node supply), finals frozen to fully-quantified values
// (Frozen(free_in_ty(chase_deep(t)), ·) — the rollback-safe form,
// itself paid for: a carried quantifier set left probe-minted leaves
// unquantified, and the restored mint counter made the next probe
// REUSE their handle numbers) — was built whole and REFUTED by its own
// instrument: simple pairs converge in 2 probes (scan_string_loop /
// handle_escape, spec_resolve, module_imports all measured stable),
// but every generic/concrete-tension family ALTERNATES with period 2
// forever (chase_*_changes, the serialize family, emit_pat_*: params
// flip rl%0 ↔ rlNTy() probe over probe) — re-derivation-from-scratch
// is NOT MONOTONE, concreteness learned in probe k evaporates in k+1,
// and Salsa's own cycle-recovery contract names the cure: a JOIN
// against the last provisional value. Rows have their join
// (graph_bind_row's lattice); TYPE-scheme generality does not — and
// the widening join was then BUILT WHOLE and REVERTED by the vet
// (2026-07-30: tower regrowth, cost without cure). The remainder is
// rung 3's schemes-are-edges dissolution, never a better iteration;
// iterating without a join taxed a 45-member group forty-seven
// probes to no fixpoint, and that measurement stands as the kill's
// record.
// A SINGLETON SCC WITH A SELF-EDGE IS A CYCLE, and `len(members) > 1`
// said it was not — the discipline's own entry test was a wrong proxy
// for cyclicity (the audit's measurement: every self-recursive fn on
// every weave flips trial-open → final-closed, and that family
// SATURATES the movers display's sixteen slots, so a NEW mover in user
// code hid behind known lib movers — a gate that always fires). The
// two pieces that fix it apply to every group; only the exit sweep is
// genuinely multi-member work.
fn trial_judge_group(ref stmts, members) = {
  // THE CYCLE DISCIPLINE (the schemes-are-edges arc's first rung, replacing
  // the refuted iteration direction whole — the vet's redirect executed):
  // monomorphic recursion by default, the signature price for polymorphic
  // recursion. At group entry an UNSIG'D member's env view goes MONO —
  // Frozen([], fn_ty) over the SAME pre-registered skeleton — so an
  // intra-cycle forward use TEACHES the callee's actual param/ret cells
  // (instantiate of an empty-q scheme returns the live record) instead of
  // discarding its demand into a fresh copy (the disconnected-vars class:
  // the crawl's root, one stale link per round). A FULLY-ANNOTATED member
  // keeps its quantified pre-registration: its sig IS its declared
  // polymorphism, instantiated per use — polymorphic recursion by intent,
  // the price every HM judge charges (inference there is undecidable).
  // After the walk, EVERY member re-generalizes: the group-exit sweep
  // publishes finals over the group's fully-resolved cells, so an early
  // member's scheme carries a late member's resolution instead of
  // quantifying a then-free var the frozen-read law would forever freshen.
  let hs = map(member_decl(stmts, ??), members)
  group_mono_views(stmts, members, 0)
  ages_group_open(hs)
  group_judge_members(stmts, members, 0)
  settle_unit_writes()
  // The exit sweep is the one genuinely multi-member piece: it exists so
  // an EARLY member's scheme carries a LATE member's resolution. A
  // singleton has no late member — its own infer_fn publish IS the
  // final state, and re-publishing it would only append an identical
  // env entry per decl. THE COMPLETION FOLD runs first (D4's essential
  // half at the trial): every member's row cell re-finalizes with the
  // whole group judged, so the resolve folds co-member content through
  // the live edges and the re-published schemes carry the cycle's whole
  // truth instead of each decl-exit snapshot.
  if len(members) > 1 {
    settle_unit_guards(hs)
    group_completion_fold(stmts, members, 0)
    group_final_publish(stmts, members, 0)
  } else {
    ()
  }
}

fn member_decl(stmts, j) = stmts[j]

fn group_mono_views(ref stmts, ref members, j) = if j >= len(members) {
  ()
} else {
  let h = stmts[members[j]]
  match graph_node_body(h) {
    NStmt(FnStmt(name, params, ret_ann, _, _)) => if fn_fully_sigd(params, ret_ann) {
      ()
    } else {
      match graph_published(h) {
        Some((sch, reason, FnScheme)) => match judgment_pair(sch) {
          // TYPE cells share (mono — the intra-cycle demand teaches the
          // callee's actual param/ret cells); ROW handles stay QUANTIFIED,
          // freshening per use — a shared row cell would let every
          // application site's symmetric row unify contaminate the callee's
          // own row (measured: five declared-row mismatches the moment the
          // full-mono view landed — the directional-edge law's class, the
          // row channel is a FLOW, never a shared cap).
          (q, fn_ty) => env_extend(name, Frozen(row_handles_only(q, 0), fn_ty), reason, FnScheme, h),
        },
        _ => (),
      }
    },
    _ => (),
  }
  group_mono_views(stmts, members, j + 1)
}

// A member is SIG'D when every param carries an authored type and the return
// is authored. Lowercase type params in the annotations are the DECLARED
// polymorphism (the case rule), quantified by the pre-registration — exactly
// the generality the sig prices.
fn fn_fully_sigd(ref params, ref ret_ann) = match graph_node_body(ret_ann) {
  NTypeAnn(_) => all(param_annotated, params),
  _ => false,
}

fn row_handles_only(ref q, i) = if i >= len(q) {
  []
} else if is_row_handle(graph_chase_handle(q[i])) {
  [q[i]] ++ row_handles_only(q, i + 1)
} else {
  row_handles_only(q, i + 1)
}

// THE COMPLETION FOLD (D4's essential half, trial side): with every
// member judged, each member's row cell re-finalizes to its RESOLVED
// row — co-member content folds through the live edges the charges
// drew, so a cycle's whole truth lands in every member's published row
// instead of each decl-exit snapshot missing its later co-members (the
// movers' mutual-recursion families). The read is the decl exits' own
// resolve-on-stored shape — no new read form; termination at cycles is
// artifact-proven (both cycle fixtures + the march run these reads
// green). Identity-until-progress makes the no-op case free; the
// finalize is the exit's own REPLACE op, second use at the sweep.
fn group_completion_fold(ref stmts, ref members, j) = if j >= len(members) {
  ()
} else {
  let handle = stmts[members[j]]
  match graph_node_body(handle) {
    NStmt(FnStmt(_, _, _, _, _)) => match graph_chase(handle) {
      GNode(NBound(TFun(_, _, frow)), _) => match frow {
        EfRow(_, _, EtOpen(vs)) => fold_member_cells(vs, graph_span_of(handle)),
        _ => (),
      },
      _ => (),
    },
    _ => (),
  }
  group_completion_fold(stmts, members, j + 1)
}

fn fold_member_cells(ref vs: [RowEdge], ref span) = match vs {
  [] => (),
  [e, ...rest] => {
    let v = edge_cell(e)
    match graph_chase(v) {
      GNode(NRowBound(stored), _) => {
        // A residual edge chasing back to v contributes nothing
        // (R ∪ R = R) and, stored, would be a self-loop the unguarded
        // resolve recursion could ride — cut it before the store.
        let folded = match resolve_row(stored) {
          EfRow(fp, fa, EtOpen(ws)) => {
            let others = edges_without_self(ws, graph_chase_handle(v))
            if len(others) == 0 { ef_make(fp, fa, EtClosed) } else { ef_make(fp, fa, EtOpen(others)) }
          },
          r => r,
        }
        graph_finalize_row(v, folded, Located(span, Inferred("group completion fold")))
      },
      _ => (),
    }
    fold_member_cells(rest, span)
  },
}

fn group_final_publish(ref stmts, ref members, j) = if j >= len(members) {
  ()
} else {
  let handle = stmts[members[j]]
  match graph_node_body(handle) {
    NStmt(FnStmt(name, _, _, _, _)) => env_extend(name, Live(handle), Located(graph_span_of(handle), Declared(name)), FnScheme, handle),
    _ => (),
  }
  group_final_publish(stmts, members, j + 1)
}

fn group_judge_members(ref stmts, ref members, j) = if j >= len(members) {
  ()
} else {
  judge_stmt_one(stmts[members[j]])
  group_judge_members(stmts, members, j + 1)
}

// EVERY JUDGMENT RUNS INSIDE A MODULE. The stmt was attributed at its own
// parse, so the fact is already on its handle — read it, never thread it.
// Entering here means the type cells this judgment mints belong to the file
// that caused them, and the diagnostics register can stamp a report with the
// module it is about, which is what scopes narration now that spans are local
// and a line range no longer distinguishes one file from another.
fn enter_module_of(ref node) = node |> graph_module_of |> graph_module_enter

// This was stmt_measure_one, which also returned (name, handles minted) —
// the count the deleted second pass prefix-summed into planned handle bases.
// A judgment mints what it mints; nothing plans it any more.
fn judge_stmt_one(ref node) = {
  enter_module_of(node)
  // The open declaration's entry mint (the instance column's bound) —
  // set here, before any of the statement's cells are minted, so a
  // Mycroft round that rolls back and re-judges reads the same entry.
  inf_open_decl(graph_next())
  infer_stmt(node)
}

fn stmt_decl_name(ref node) = node |> graph_node_body |> body_decl_name

// The name of the top-level declaration holding a position (`enclosing_decl`):
// a declaration names itself, and a module value's binder — the value's own
// cell, which a variable pattern binds (`infer_pat`) — is named by the let
// that holds it. A position no declaration holds names nothing.
fn enclosing_decl_name(h) = match enclosing_decl(h) {
  None => "",
  Some(d) => stmt_decl_name(d),
}

// The name a declaration's body declares — read off the body, so a reader
// holding only a handle asks `graph_node_body` and lands here.
fn body_decl_name(body) = match body {
  NStmt(FnStmt(name, _, _, _, _)) => name,
  NStmt(TypeDefStmt(name, _)) => name,
  NStmt(EffectDeclStmt(name, _, _)) => name,
  NStmt(HandlerDeclStmt(name, _, _, _, _, _)) => name,
  NStmt(HandlerChainStmt(name, _)) => name,
  NStmt(RefineStmt(name, _, _)) => name,
  NStmt(AliasStmt(name, _)) => name,
  NStmt(RowAliasStmt(name, _)) => name,
  NStmt(LetStmt(pat, _, _)) => match pat_of(pat) {
    PVar(name) => name,
    // drift-audit: ignore — the documented no-key contract (a destructured let contributes no index entry; equal depths keep source order)
    _ => "",
  },
  // drift-audit: ignore — the documented no-key contract (an unnamed stmt contributes no index entry; equal depths keep source order)
  _ => "",
}

// ─── The stmt-layer index — decl name → stmt position ───────────────────
// The layer descent's edge resolver (stmt_layers_ast): a free name that
// names a top-level decl is a call-DAG edge; anything else (a local, a
// prelude primitive with no stmt) resolves to no edge. A stmt with no
// key (destructured let, expression stmt) contributes no entry; missing
// edges leave equal depths, and within-layer source order preserves the
// dependency-safe walk.
fn layer_name_index(ref names, i, idx) = if i >= len(names) {
  idx
} else {
  layer_name_index(
    names,
    i + 1,
    if byte_len(names[i]) > 0 { smap_add(idx, names[i], i) } else { idx }
  )
}

// THE BRANCH BRACKET — the ??-fan's candidate branches run this
// eleven-handler bracket over the shared image; the judgment's own stmt
// branches ran it too until the planned layer sweep went with the second
// pass. The fan's parallel form returns at Phase 9.2 on the deterministic
// handle partition with ATOMIC join writes — the lattice law that makes N
// branches teaching one row cell converge in any order (graph_bind_row's
// bound arm is a row JOIN; the decl-exit REPLACE is graph_finalize_row).
// The bracket mirrors the ambient chain's order whole (the final's
// trio innermost, then pipeline.mn's spine law — ledgers inside env
// inside diagnostics): infer_ctx's frames and fresh_for_inference are
// stmt-local, so fresh instances are exact. The affine instance seeds from the root's frozen consumed-set; its log
// replays at the join. verify accrues branch-locally; the debt
// replays by re-perform — EXACT because a predicate's operands live
// in the branch's own planned range, so no sibling bind can move a
// decision between judge and join. region_tracker needs NO replay:
// top-level values tag region 0 (global) by construction, and a
// fresh instance's None answers check_escape exactly as the root's
// Some((_, 0)) would — same verdict, zero cross-branch state. Their
// arms' reports resolve outward to diag_branch (rendered at
// collect), so every refusal a branch raises rides the banked lines.
// The graph instance is the C1c-2a config cashed out: the branch
// installs over the SHARED spine (pre-opened by the plan, stable for
// the walk) with its stmt's planned range as (next0, limit0) — the
// former root-side graph_mint_at dissolved into this config — the
// root's complete span index (parse-only writes), and its PRIVATE
// overflow band [bh, bh + quota) above the plan. An over-measure
// stmt jumps into its own band (the measured residue: deltas of 1–2
// on ~324 stmts); crossing the band trips the unseeded guard loudly.
// Numbering — jumps included — is therefore a pure function of the
// source and the plan, independent of execution order: the fan
// reproduces these bytes at any K. Trail and checkpoints are
// branch-local; binds land in shared cells the plan partitioned.
// ─── The SEGMENT bracket — the same chain, on the LIVE graph ─────────
//
// Every handler the deleted branch bracket installed EXCEPT `graph_handler`, so the
// body's graph performs resolve OUTER to the root's own instance and the
// judgment happens on the one live graph. Isolation is the forking
// handler's (`speculate`): the checkpoint and the world's top taken before
// the candidate's resumption and restored after it.
//
// The fresh ledgers stay, and that is the point of keeping the chain: the
// triple covers graph, heap and world ONLY, while a candidate's judgment
// also enters env scopes, accrues verify debt, tags allocations and reports
// diagnostics — none of it trailed. Those ride per-segment instances and
// the caller reads their facts before replaying, exactly as the copy did.
//
// What this DELETES is the graph copy: a candidate no longer judges against
// a fresh instance seeded from four root views inside a pre-planned band, so
// a fact proven in one segment is visible to the next, the hole's own cell
// is reachable, and the trail records the segment's binds where a diff can
// read them.
fn segment_bracket(body, base, iseed) = match base {
  (bb, bc, bi) => match iseed {
    (ib, ie, ic) => body() ~> row_gate ~> store_ages ~> infer_ctx ~> fresh_for_inference ~> affine_ledger ~> region_tracker ~> verify_ledger ~> lookup_ty_graph ~> env_handler(bb, bc, bi) ~> mutate_sink ~> diag_branch ~> intern_view(ib, ie, ic),
  },
}

// The join: replay the branch's facts into the root in occurrence order —
// publishes re-perform env_extend (the Reason edge rides whole), the
// rendered lines re-print, the tally folds. Runs AFTER the bracket
// closes, so every perform here resolves to the root instances.
fn branch_join(facts) = match facts {
  (pubs, dfacts, vdebt, clog) => {
    branch_replay_pubs(pubs, 0)
    // Both ledgers' logs are PREPEND-ordered; the replay walks from the
    // tail so the root re-performs in occurrence order. Consumes re-check
    // against the root's live set — a same-layer double-consume refuses
    // HERE, deterministically, exactly as the join protocol demands. Only
    // Own consumes ever enter the sites log (the arm's else branch), so
    // the replay's ownership arg is Own by construction.
    branch_replay_consumes(clog, len(clog) - 1)
    branch_replay_verify(vdebt, len(vdebt) - 1)
    // Each held report re-enters the root chain as a live one, so the
    // root arm counts it and every forwarder (the bank among them) sees it.
    each(replay_report, dfacts)
  },
}

// A held report, performed again: its message was rendered where the report
// was made, so the replay reads nothing and says what was true then.
fn replay_report(fact) = match fact {
  (d, msg, dmod, dlayer) => diag_report(d, msg, dmod, dlayer),
}

fn branch_replay_consumes(ref clog, i) = if i < 0 {
  ()
} else {
  match clog[i] {
    (name, span) => {
      consume(name, Own, span)
      branch_replay_consumes(clog, i - 1)
    },
  }
}

fn branch_replay_verify(ref vdebt, i) = if i < 0 {
  ()
} else {
  match vdebt[i] {
    (modh, span, pred, reason) => {
      verify_claim(modh, span, pred, reason)
      branch_replay_verify(vdebt, i - 1)
    },
  }
}

fn branch_replay_pubs(ref pubs, i) = if i >= len(pubs) {
  ()
} else {
  match pubs[i] {
    (name, scheme, reason, kind, decl) => {
      branch_replay_one(name, scheme, reason, kind, decl)
      branch_replay_pubs(pubs, i + 1)
    },
  }
}

// An EffectOpScheme publish is a READ-MODIFY-WRITE of the op→handler
// edge: replaying the branch's value would let two same-layer handlers
// each evolve the frozen base and the latest erase the first sighting. The
// join RE-RUNS draw_op_edges' own default/ambiguous algebra against the
// root's live entry, the branch's verdict as the sighting; disc joins
// monotone.
//
// THE VALUE BOUNDARY AT EVERY PUBLISH: the scheme crosses the join as
// a chase_deep'd VALUE — quantified vars stay free leaves; everything
// bound inlines its resolution — so no published entry of ANY kind
// carries a live cell a concurrent sibling could bind. FnScheme
// finals got this law first (the subst/quantification landing);
// op-scheme and handler-sig publishes still carried live handles,
// and a same-block race on one such cell was the K>1 flip's target
// set (measured: str_of_single_byte's can_yield chasing a row var
// bound in four of six runs, free in two — the k2 wrap flipping the
// whole float-format family).
fn branch_replay_one(name, scheme, reason, kind, decl) = match scheme {
  // A live cell replays AS a live cell: the branch's judgment wrote the
  // decl's graph cell in place (one graph, one truth), so the root's
  // readers resolve it live. Freezing here would publish a snapshot the
  // cell has already moved past — the two-generations disease this
  // landing deletes.
  Live(h) => env_extend(name, Live(h), reason, kind, decl),
  Frozen(q, sty) => {
    let fty = chase_deep(sty)
    // The quantifier RE-DERIVES from the frozen type: chase_deep folds
    // bound structure to values and canonicalizes free leaves to their
    // union-find ROOTS, so pre-fold qvars name surface aliases the
    // frozen tree no longer holds — any frozen leaf outside the
    // instantiation mapping is SHARED by every caller, and the callers'
    // teachings union into that one live cell (measured: infer_context
    // publishing a maskless GraphRead/Intern face it never performs —
    // the union of all fourteen chains' contexts — with stale-band and
    // duplicated qvars as the two-era tell). An EMPTY q is the
    // deliberate mono/two-phase share and stays empty.
    let frozen = if len(q) == 0 { Frozen([], fty) } else { Frozen(free_in_ty(fty), fty) }
    match kind {
      EffectOpScheme(ename, bd, ba, bdisc) => {
        let joined = match env_lookup(name) {
          Some((_, _, EffectOpScheme(_, rd, ra, rdisc))) => {
            let disc = disc_join(rdisc, bdisc)
            match if ra || rd == bd {
              (rd, ra)
            } else {
              match rd {
                None => (bd, ba),
                Some(_) => (rd, true),
              }
            } {
              (nd, na) => EffectOpScheme(ename, nd, na, disc),
            }
          },
          _ => kind,
        }
        env_extend(name, frozen, reason, joined, decl)
      },
      _ => env_extend(name, frozen, reason, kind, decl),
    }
  },
}

// A block's statements, judged run by run (`stmt_runs`). A lone statement
// judges as it stands. A run of fn declarations judges as the module's
// declarations do: every member is pre-registered before any body is read,
// so siblings reach each other in either direction, then the run's binding
// groups — Tarjan over the same free names — judge callee-first, each cycle
// as one unit under the cycle discipline.
fn infer_run(run) = match run {
  Lone(stmt) => infer_stmt(stmt),
  Joined(decls) => judge_fn_run(decls),
}

fn judge_fn_run(decls) = {
  fold(smap_new(), pre_register_fn_once, decls)
  inf_keep_open(decls)
  trial_group_walk(
    decls,
    scc_groups(stmt_frees(decls), layer_name_index(map(stmt_decl_name, decls), 0, smap_new())),
    0
  )
  inf_keep_close()
}

// A `fn` declared in a block is MINTED where it is declared: lowering builds
// its closure record there — its captures, or an empty record with none — so
// the declaring frame pays `Memory + Alloc` once per nested fn, as it pays
// for a lambda it mints (real 2026-09-30: `fn adder(k) with !Alloc = { fn
// add(x) = x + k; add }` checked clean and allocated, and every maker in
// lib/dsp returning its nested stage carried a row of `Pure`, found by the
// allocation audit's first frontier run). A nested fn capturing nothing could
// be the module's static record and cost nothing; that is a representation
// the lowering has not built, and the charge follows it when it does
// (Hβ.lower.captureless-nested-fn-is-static).
fn nested_fns_charge(stmts) = each(nested_fn_charge, stmts)

fn nested_fn_charge(node) = match graph_node_body(node) {
  NStmt(FnStmt(_, _, _, _, _)) => inf_add_row_at(node, construction_row()),
  _ => (),
}

// Statement inference
fn infer_stmt(ref node) = {
  let span = graph_span_of(node)
  match graph_node_body(node) {
    NStmt(LetStmt(pat, expr, ann)) => {
      // The decls column, second writer: a value binding IS a declaration,
      // and a MODULE-level one is an emittable entry (__init_lets runs
      // every module value let), so the relocation's reader resolves its
      // origin here. Nested fns already note through infer_fn, so the
      // column's contract was never top-level-only.
      note_decl(node)
      // A module value's init is a scope of its own, run once at start: every
      // module value it reads is older than it.
      match ages_top() {
        None => {
          ages_open(AgeClosure)
          infer_expr(expr)
          ages_pop()
        },
        Some(_) => {
          infer_expr(expr)
          ages_let(expr)
        },
      }
      // The let STATEMENT's value IS its expression: bind the stmt node to
      // the value's var (one union-find edge). Unbound, every block-let's
      // own node sat NFree while lower keys LLet by the STMT handle and two
      // emit width-readers lookup_ty it — two recovered E_UnresolvedType
      // per let, program-wide, and a word-floored LLet width where the
      // value's proof already existed one edge away.
      graph_bind(node, TVar(expr), Located(span, Inferred("let statement carries its value")))
      infer_pat(pat, expr, span)
      // The `: T` annotation is a CONSTRAINT verified against the value node.
      // Unlike the generic TRefined arm of unify_types (predicate + span only),
      // the value node (expr, which is its handle) is live here, so a
      // refinement's `self` operand binds to the value and Verify decides it
      // on the literal — `let bad: Sample = 1.5` rejects, `0.5` compiles.
      // Absent = LitUnit, skipped.
      match graph_node_body(ann) {
        NTypeAnn(ann_ty) => {
          link_written(ann)
          apply_let_annotation(ann, ann_ty, expr, graph_span_of(expr))
        },
        _ => (),
      }
    },
    NStmt(FnStmt(name, params, ret_ann, effs, body_node)) => if fn_fully_sigd(params, ret_ann) {
      infer_fn(name, params, body_node, ret_ann, effs, node, span, false)
    } else {
      // Every unsig'd decl judges SPECULATIVELY (§11 5.3's fragment):
      // the common mono case pays one checkpoint + one held list and
      // commits round 1; only a poly-fingerprinted refusal retries.
      infer_fn_speculative(name, params, body_node, ret_ann, effs, node, span)
    },
    // The decls column's fourth writer: a type, an effect and an alias
    // are declarations a name names, so `mentl where` finds them where it
    // finds a function — by what they declare, in the column — and the
    // decls facet lists them.
    NStmt(TypeDefStmt(name, variants)) => {
      each({ (_, _, vnode) => link_written(vnode) }, variants)
      declaration_noted(node, name)
    },
    NStmt(EffectDeclStmt(name, params, ops)) => {
      // Every name an op's signature writes resolves, judged HERE — after
      // every declaration of the link is registered — so an op naming an
      // effect declared below it in source is not refused for the order.
      link_params_written(params)
      each(link_op_written, ops)
      declaration_noted(node, name)
    },
    NStmt(HandlerDeclStmt(hname, ename, config, state, arms, effs)) => {
      // The decls column, third writer. An ARM is an emittable entry whose
      // name is composed at lower and cannot be parsed back to (handler,
      // op), so the arm's origin is its handler decl's node — noted here,
      // where the decl is judged. A handler declares a value, as a fn
      // does, so its node carries the handler's type once registered.
      note_decl(node)
      link_params_written(config)
      register_handler(hname, ename, config, state, arms, effs, span, node)
      match graph_published(node) {
        Some((Frozen(_, ty), _, _)) => bind_declared(node, ty, hname),
        _ => (),
      }
    },
    NStmt(ExprStmt(expr)) => {
      infer_expr(expr)
      // The statement's value IS its expression's, as a let statement's is:
      // one union-find edge, so no statement in a block is a cell nothing
      // judged.
      graph_bind(node, TVar(expr), Located(span, Inferred("statement carries its value")))
    },
    NStmt(HandlerChainStmt(name, chain)) => {
      // The decls column's fifth writer. The members are judged as the
      // references they are — a handler, or a chain standing for its
      // members — so the declaration's own cells are bound and `refs of h`
      // counts the chain; every install instantiates them again where it
      // stands (infer_chain_install).
      judge_chain(name, chain)
      declaration_noted(node, name)
    },
    NStmt(ImportStmt(path)) => bind_declared(node, TUnit, path),
    // Registered at pre_register_stmt (the one home — TAlias(name,
    // TRefined(base, pred)), so X and its base unify transparently and
    // the authored name travels for Reason chains). The predicate is judged
    // here as the expression it is; the declaration raises no claim of its
    // own — there is no value for `self` to be — and discharge lives at
    // CONSTRUCTION sites, where apply_refinement_constraint substitutes the
    // live value node for self (value-proof R2) and decides or pends against
    // a value that exists.
    NStmt(RefineStmt(name, base_ty, pred)) => {
      each(link_written, written_cells(base_ty))
      judge_predicate(name, base_ty, pred)
      declaration_noted(node, name)
    },
    // Transparent alias `type X = T`: registered at pre_register_stmt.
    // No predicate, no Verify — the difference from RefineStmt is exactly
    // the absent `where` (SYNTAX.md §«Type aliases»). Its body is read here,
    // where it is declared, so each name it writes is linked to the
    // declaration the name denotes.
    NStmt(AliasStmt(name, ty)) => {
      each(link_written, written_cells(ty))
      let _ = quantify_ctor_ty(ty, [], Declared(name))
      declaration_noted(node, name)
    },
    NStmt(RowAliasStmt(name, effs)) => {
      // A named row's terms are judged where they are written, as a
      // clause's are at its declaration: each names an effect, a row alias
      // or a row variable, and an instance's arguments meet its effect's
      // parameters. Registered at pre_register_alias; expanded where a
      // signature reads it.
      let resolved = resolve_declared_instances(effs)
      check_effect_names(resolved, span)
      check_instance_args(resolved, span)
      declaration_noted(node, name)
    },
    _ => (),
  }
}

// A refinement's predicate is an expression over the value it refines, judged
// where the type is declared with `self` that value at the base type: its
// calls are references, its nodes are cells, and a predicate that is not a
// Bool refuses here, where a chained bound (`-1.0 <= self <= 1.0`) degraded
// to debt at every value that claimed the type. A module scope has no store
// age of its own, so the judgment opens one as a module value's init does.
fn judge_predicate(name: String, base_ty, pred) = {
  let span = graph_span_of(pred)
  env_scope_enter()
  match quantify_ctor_ty(base_ty, [], Located(span, Declared(name))) {
    (base, _q) => {
      let self_h = mint(Located(span, Declared(name)))
      graph_bind(self_h, base, Located(span, Declared(name)))
      env_extend(
        "self",
        Frozen([], TVar(self_h)),
        Located(span, LetBinding("self", Declared(name))),
        ValueScheme,
        self_h
      )
    },
  }
  ages_open(AgeClosure)
  infer_expr(pred)
  ages_pop()
  unify_types(TVar(pred), TName("Bool", []), span, Inferred("a refinement's predicate"))
  env_scope_exit()
}

// A declaration with no value — a type, an effect, an alias — is noted in
// the decls column and its statement evaluates to unit.
fn declaration_noted(node, name: String) = {
  note_decl(node)
  bind_declared(node, TUnit, name)
}

// Classic let-generalization: allocate fresh handles for params,
// bind them in env, enter `InferCtx` for row accumulation, infer body,
// exit (which binds the row), generalize, re-extend env with scheme.
fn held_has_poly(held, name: String) = any(
  {
    (d, _, _, _) => match d {
      TPolyRecursionSignature(owner, _) => owner == name,
      _ => false,
    },
  },
  held
)

fn held_has_error(held) = any({ (d, _, _, _) => diag_severity(d) == SError }, held)

// The Mycroft ASSUMPTION at round 2 — the name pre-bound poly over its
// own FRESH cells (the sig'd path's shape with fresh vars standing for
// the unauthored types): self-calls instantiate per use instead of
// chaining the mono cells. The row is assumed fresh-open; a self-call's
// row ⊆ the body's own row by the fixpoint argument, so dropping the
// self-charge under-attributes nothing the body does not already carry.
fn mycroft_fresh_param(p) = TParam(
  param_binder(p),
  TVar(mint(Inferred("mycroft assumed param"))),
  param_marker(p),
  param_marker(p),
  param_dflt(p),
  guards_nothing()
)

fn mycroft_prebind(name: String, params, span: ValidSpan, decl) = {
  let fresh_params = map(mycroft_fresh_param, params)
  let fn_ty = TFun(
    fresh_params,
    TVar(mint(FnReturn(name, Inferred("mycroft assumed return")))),
    mk_ef_open([], graph_fresh_row(Inferred("mycroft assumed row of '{name}'")))
  )
  env_extend(name, Frozen(free_in_ty(fn_ty), fn_ty), Located(span, Declared(name)), FnScheme, decl)
}

// Alpha-equality over detached Ty values — the Mycroft accept's
// STABILITY BELT: the recheck round's published scheme must equal the
// assumed one up to a bijective renaming of quantified cells, or the
// acceptance is the unsound window (self-calls checked against a
// scheme that is not the one published). Pure structural walk; the
// mapping list carries the bijection. Rows compare by their SETS
// (presents/absents structural ==) with tails equal when both closed,
// both all, or both open — edge-set identity is cell-numbering and
// never survives a re-judgment, so the row half's stability rides the
// row machinery (the v1 boundary, named at the peer).
fn alpha_pairs_ok(m, x, y) = match m {
  [] => (true, [(x, y)]),
  [(a, b), ...rest] => if a == x {
    (b == y, m)
  } else if b == y {
    (false, m)
  } else {
    match alpha_pairs_ok(rest, x, y) {
      (ok, rest2) => (ok, if ok { [(a, b)] ++ rest2 } else { m }),
    }
  },
}

fn ty_alpha_eq(t1, t2, m) = match t1 {
  TVar(x) => match t2 {
    TVar(y) => alpha_pairs_ok(m, x, y),
    _ => (false, m),
  },
  TInt => (
    match t2 {
      TInt => true,
      _ => false,
    },
    m
  ),
  TFloat => (
    match t2 {
      TFloat => true,
      _ => false,
    },
    m
  ),
  TUnit => (
    match t2 {
      TUnit => true,
      _ => false,
    },
    m
  ),
  TByte => (
    match t2 {
      TByte => true,
      _ => false,
    },
    m
  ),
  TAddr => (
    match t2 {
      TAddr => true,
      _ => false,
    },
    m
  ),
  TList(e1) => match t2 {
    TList(e2) => ty_alpha_eq(e1, e2, m),
    _ => (false, m),
  },
  TTuple(es1) => match t2 {
    TTuple(es2) => ty_list_alpha_eq(es1, es2, m, 0),
    _ => (false, m),
  },
  TFun(ps1, r1, row1) => match t2 {
    TFun(ps2, r2, row2) => if len(ps1) != len(ps2) {
      (false, m)
    } else {
      match param_list_alpha_eq(ps1, ps2, m, 0) {
        (ok1, m1) => if ok1 {
          match ty_alpha_eq(r1, r2, m1) {
            (ok2, m2) => if ok2 { (row_alpha_shallow(row1, row2), m2) } else { (false, m2) },
          }
        } else {
          (false, m1)
        },
      }
    },
    _ => (false, m),
  },
  TName(n1, args1) => match t2 {
    TName(n2, args2) => if n1 == n2 { ty_list_alpha_eq(args1, args2, m, 0) } else { (false, m) },
    _ => (false, m),
  },
  TRecord(fs1) => match t2 {
    TRecord(fs2) => field_list_alpha_eq(fs1, fs2, m, 0),
    _ => (false, m),
  },
  TRecordOpen(fs1, v1) => match t2 {
    // Two rows compare as the records their chains spell, never link by link:
    // the same row can be reached through differently-shaped chains.
    TRecordOpen(fs2, v2) => match record_row_full(fs1, v1) {
      (all1, e1) => match record_row_full(fs2, v2) {
        (all2, e2) => row_ends_alpha_eq(field_canonicalize(all1), e1, field_canonicalize(all2), e2, m),
      },
    },
    _ => (false, m),
  },
  TRefined(b1, _) => match t2 {
    TRefined(b2, _) => ty_alpha_eq(b1, b2, m),
    _ => (false, m),
  },
  TAlias(n1, i1) => match t2 {
    TAlias(n2, i2) => if n1 == n2 { ty_alpha_eq(i1, i2, m) } else { (false, m) },
    _ => (false, m),
  },
  TReprPin(r1, b1) => match t2 {
    TReprPin(r2, b2) => if r1 == r2 { ty_alpha_eq(b1, b2, m) } else { (false, m) },
    _ => (false, m),
  },
  TCont(i1, a1, d1, w1) => match t2 {
    TCont(i2, a2, d2, w2) => if d1 == d2 {
      match ty_alpha_eq(i1, i2, m) {
        (ok1, m1) => if ok1 {
          match ty_alpha_eq(a1, a2, m1) {
            (ok2, m2) => if ok2 { (row_alpha_shallow(w1, w2), m2) } else { (false, m2) },
          }
        } else {
          (false, m1)
        },
      }
    } else {
      (false, m)
    },
    _ => (false, m),
  },
}

fn ty_list_alpha_eq(xs, ys, m, i) = if len(xs) != len(ys) {
  (false, m)
} else if i >= len(xs) {
  (true, m)
} else {
  match ty_alpha_eq(list_index(xs, i), list_index(ys, i), m) {
    (ok, m2) => if ok { ty_list_alpha_eq(xs, ys, m2, i + 1) } else { (false, m2) },
  }
}

fn param_list_alpha_eq(ps1, ps2, m, i) = if i >= len(ps1) {
  (true, m)
} else {
  match ty_alpha_eq(param_ty(list_index(ps1, i)), param_ty(list_index(ps2, i)), m) {
    (ok, m2) => if ok { param_list_alpha_eq(ps1, ps2, m2, i + 1) } else { (false, m2) },
  }
}

// Two flattened rows: equal fields, and ends that agree — both closed, or
// both free and paired by the renaming.
fn row_ends_alpha_eq(fs1, e1, fs2, e2, m) = match e1 {
  RowEndClosed => match e2 {
    RowEndClosed => field_list_alpha_eq(fs1, fs2, m, 0),
    RowEndFree(_) => (false, m),
  },
  RowEndFree(r1) => match e2 {
    RowEndFree(r2) => match alpha_pairs_ok(m, r1, r2) {
      (ok, m1) => if ok { field_list_alpha_eq(fs1, fs2, m1, 0) } else { (false, m1) },
    },
    RowEndClosed => (false, m),
  },
}

fn field_list_alpha_eq(fs1, fs2, m, i) = if len(fs1) != len(fs2) {
  (false, m)
} else if i >= len(fs1) {
  (true, m)
} else {
  match list_index(fs1, i) {
    (n1, t1) => match list_index(fs2, i) {
      (n2, t2) => if n1 == n2 {
        match ty_alpha_eq(t1, t2, m) {
          (ok, m2) => if ok { field_list_alpha_eq(fs1, fs2, m2, i + 1) } else { (false, m2) },
        }
      } else {
        (false, m)
      },
    },
  }
}

fn row_alpha_shallow(r1, r2) = match r1 {
  EfRow(p1, a1, t1) => match r2 {
    EfRow(p2, a2, t2) => if p1 == p2 {
      if a1 == a2 {
        match t1 {
          EtClosed => match t2 {
            EtClosed => true,
            _ => false,
          },
          EtAll => match t2 {
            EtAll => true,
            _ => false,
          },
          EtOpen(_) => match t2 {
            EtOpen(_) => true,
            _ => false,
          },
        }
      } else {
        false
      }
    } else {
      false
    },
  },
}

// The round-3 RECHECK's assumption — the round-2 RESULT scheme, detached
// from its rolled-back cells: the published Ty chased deep BEFORE the
// rollback (a heap value, rollback-proof), its quantified cells re-minted
// fresh and substituted, its row rebuilt fresh-open (the top row cell is
// unquantified and would dangle).
fn mycroft_recheck_pair(c) = (c, mint(Inferred("mycroft recheck var")))

fn rebind_recheck(name: String, q, ty0, span: ValidSpan, decl) = {
  let mapping = map(mycroft_recheck_pair, q)
  let ty1 = subst_ty(ty0, mapping)
  let ty2 = match ty1 {
    TFun(ps, r, _) => TFun(ps, r, mk_ef_open([], graph_fresh_row(Inferred("mycroft recheck row of '{name}'")))),
    other => other,
  }
  env_extend(
    name,
    Frozen(map({ (_, fresh) => fresh }, mapping), ty2),
    Located(span, Declared(name)),
    FnScheme,
    decl
  )
  // The assumed type rides back to the accept, whose gate transfer pairs
  // its cells with the published ones.
  ty2
}

// THE GATE TRANSFER at the Mycroft accept. The recheck round's self-calls
// instantiate the ASSUMED scheme's cells, not the judgment's, so the copies
// a performing callback binds are noted under the recheck cells — and the
// exit install landed on the judgment's terminals. The stability belt has
// just proven the two schemes alpha-equal, so their cells correspond
// position by position: every gate on a published row cell is installed
// on its recheck twin, which walks the twin's noted copies and judges them
// (`fn run(f, x) with !E = if depth(x) > 0 { run(() => op(), [x]) } else
// { f() }` — polymorphic recursion under a negation, with the leak on the
// recursive call). The pairing walks the two types together and pairs the
// cells of single-edge open row tails, the shape a parameter's row is; a
// multi-edge tail pairs nothing, since alpha-equality does not order its
// edges (named at the belt's own comment), and that shape reaches a
// declared negation through no signature this pass can write.
fn mycroft_gate_transfer(published, assumed, span: ValidSpan) =
  mycroft_transfer_pairs(mycroft_row_pairs(published, assumed, []), span)

fn mycroft_transfer_pairs(pairs, span: ValidSpan) = match pairs {
  [] => (),
  [(p, a), ...rest] => {
    mycroft_gates_onto(graph_gates_of(graph_chase_handle(p)), a, span)
    mycroft_transfer_pairs(rest, span)
  },
}

fn mycroft_gates_onto(gs, cell, span: ValidSpan) = match gs {
  [] => (),
  [g, ...rest] => {
    gate_install(cell, g, span)
    mycroft_gates_onto(rest, cell, span)
  },
}

fn mycroft_row_pairs(t1, t2, acc) = match t1 {
  TFun(ps1, r1, row1) => match t2 {
    TFun(ps2, r2, row2) => mycroft_row_pairs(r1, r2, mycroft_param_pairs(ps1, ps2, 0, mycroft_tail_pair(row1, row2, acc))),
    _ => acc,
  },
  TList(e1) => match t2 {
    TList(e2) => mycroft_row_pairs(e1, e2, acc),
    _ => acc,
  },
  TTuple(es1) => match t2 {
    TTuple(es2) => mycroft_list_pairs(es1, es2, 0, acc),
    _ => acc,
  },
  TName(_, as1) => match t2 {
    TName(_, as2) => mycroft_list_pairs(as1, as2, 0, acc),
    _ => acc,
  },
  TRecord(fs1) => match t2 {
    TRecord(fs2) => mycroft_field_pairs(fs1, fs2, 0, acc),
    _ => acc,
  },
  TRecordOpen(fs1, v1) => match t2 {
    TRecordOpen(fs2, v2) => match record_row_full(fs1, v1) {
      (all1, _) => match record_row_full(fs2, v2) {
        (all2, _) => mycroft_field_pairs(field_canonicalize(all1), field_canonicalize(all2), 0, acc),
      },
    },
    _ => acc,
  },
  TRefined(b1, _) => match t2 {
    TRefined(b2, _) => mycroft_row_pairs(b1, b2, acc),
    _ => acc,
  },
  TAlias(_, i1) => match t2 {
    TAlias(_, i2) => mycroft_row_pairs(i1, i2, acc),
    _ => acc,
  },
  TReprPin(_, b1) => match t2 {
    TReprPin(_, b2) => mycroft_row_pairs(b1, b2, acc),
    _ => acc,
  },
  TCont(i1, a1, _, w1) => match t2 {
    TCont(i2, a2, _, w2) => mycroft_row_pairs(a1, a2, mycroft_row_pairs(i1, i2, mycroft_tail_pair(w1, w2, acc))),
    _ => acc,
  },
  TVar(_) => acc,
  TInt => acc,
  TFloat => acc,
  TUnit => acc,
  TByte => acc,
  TAddr => acc,
}

fn mycroft_tail_pair(row1, row2, acc) = match row1 {
  EfRow(_, _, t1) => match row2 {
    EfRow(_, _, t2) => match t1 {
      EtOpen(vs1) => match t2 {
        EtOpen(vs2) => if len(vs1) == 1 && len(vs2) == 1 {
          push(acc, (edge_cell(list_index(vs1, 0)), edge_cell(list_index(vs2, 0))))
        } else {
          acc
        },
        _ => acc,
      },
      _ => acc,
    },
  },
}

fn mycroft_param_pairs(ps1, ps2, i, acc) = if i >= len(ps1) || i >= len(ps2) {
  acc
} else {
  mycroft_param_pairs(
    ps1,
    ps2,
    i + 1,
    mycroft_row_pairs(param_ty(list_index(ps1, i)), param_ty(list_index(ps2, i)), acc)
  )
}

fn mycroft_list_pairs(xs, ys, i, acc) = if i >= len(xs) || i >= len(ys) {
  acc
} else {
  mycroft_list_pairs(xs, ys, i + 1, mycroft_row_pairs(list_index(xs, i), list_index(ys, i), acc))
}

fn mycroft_field_pairs(fs1, fs2, i, acc) = if i >= len(fs1) || i >= len(fs2) {
  acc
} else {
  match (list_index(fs1, i), list_index(fs2, i)) {
    ((_, a), (_, b)) => mycroft_field_pairs(fs1, fs2, i + 1, mycroft_row_pairs(a, b, acc)),
  }
}

// The speculative decl judgment (§11 5.3's fragment — Mycroft iteration on
// the medium's own trail). Its rounds are the options of one choice, judged
// in order, and the first that holds is kept (`first_held`): the plain
// judgment under report capture, held when no refusal carries the poly
// teach's own fingerprint; the general assumption, judged and undone for the
// scheme it publishes, then RECHECKED under that scheme (the stability round
// that makes the acceptance sound: the self-call is checked against the
// scheme that will be published, per Mycroft; Henglein's single-call
// fragment is the termination argument); and the plain judgment again,
// whose refusal is the honest one — never worse than the plain judgment
// alone. That last round always holds, so which round held is the graph's
// to say and the install's answer is discarded.
fn infer_fn_speculative(name, params, body_node, ret_ann, effs, handle, span: ValidSpan) = {
  let _ = judged_round(
    name,
    params,
    body_node,
    ret_ann,
    effs,
    handle,
    span,
    choose([MonoRound, PolyRound, ReportRound])
  ) ~> first_held
  ()
}

fn judged_round(name, params, body_node, ret_ann, effs, handle, span: ValidSpan, round) = match round {
  MonoRound => {
    let held = {
      infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
      poly_captured()
    } ~> poly_capture
    if held_has_poly(held, name) {
      false
    } else {
      each(replay_report, held)
      true
    }
  },
  // The general assumption is a speculation of one: judged on a trail of its
  // own and undone, carrying out the scheme it published, chased off its
  // cells before the undo so the value outlives them.
  PolyRound => match general_scheme(choose([name]), params, body_node, ret_ann, effs, handle, span) ~> speculate {
    [] => false,
    [(q, detached), ..._] => rechecked(name, params, body_node, ret_ann, effs, handle, span, q, detached),
  },
  ReportRound => {
    infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
    true
  },
}

fn general_scheme(name, params, body_node, ret_ann, effs, handle, span: ValidSpan) = {
  let held = {
    mycroft_prebind(name, params, span, handle)
    infer_fn(name, params, body_node, ret_ann, effs, handle, span, true)
    poly_captured()
  } ~> poly_capture
  if held_has_error(held) {
    []
  } else {
    match env_lookup(name) {
      Some((sch, _, _)) => match judgment_pair(sch) {
        (q, ty) => [(q, chase_deep(ty))],
      },
      None => [],
    }
  }
}

// The recheck: the assumption is written before the capture bracket — it
// mints and binds, reports nothing, and its type rides to the accept's gate
// transfer. THE STABILITY BELT: the recheck's PUBLISHED scheme must be
// alpha-equal to the ASSUMED one, or the self-calls were checked against a
// scheme that is not the one published — the unsound window Mycroft's
// fixpoint exists to close. Both sides are detached value trees, so the
// bijective TVar pairing is what makes the comparison undo-safe; on a match
// the published cells' gates reach the assumed cells' noted copies — the
// self-calls' arguments, judged now.
fn rechecked(name, params, body_node, ret_ann, effs, handle, span: ValidSpan, q, detached) = {
  let assumed = rebind_recheck(name, q, detached, span, handle)
  let held = {
    infer_fn(name, params, body_node, ret_ann, effs, handle, span, true)
    poly_captured()
  } ~> poly_capture
  if held_has_error(held) {
    false
  } else {
    match env_lookup(name) {
      Some((sch, _, _)) => {
        let published = chase_deep(judgment_ty(sch))
        match ty_alpha_eq(published, detached, []) {
          (true, _) => {
            mycroft_gate_transfer(published, assumed, span)
            each(replay_report, held)
            true
          },
          (false, _) => false,
        }
      },
      None => false,
    }
  }
}

// The Mycroft rounds, in the order `first_held` judges them.
type Round = MonoRound | PolyRound | ReportRound

// One declaration judged: its parameters and body inferred under a frame,
// its row published, its scheme generalized and bound. Its tail reports what
// the graph's write guard refused while it ran. The guard cannot report where
// it stands, since an arm's report resolves OUTER and sails past the capture
// bracket infer_fn_speculative installs, so the arm notes and this body
// renders and reports each refusal in its own world, where every bracket that
// should see it does (Hβ.diag.an-arms-report-escapes-an-inner-capture).
fn infer_fn(name, params, body_node, ret_ann, effs, handle, span: ValidSpan, poly_hint) = {
  // The decls column, first writer: the FnStmt node handle, noted per
  // judgment (rounds re-note; readers dedup by handle). The let and
  // handler-decl arms of infer_stmt are the other two — a column of
  // every judged DECLARATION, which is what the relocation's reader
  // needs an origin from.
  note_decl(handle)
  env_scope_enter()
  let ret_handle = mint(FnReturn(name, Inferred("return of '{name}'")))
  let row_handle = graph_fresh_row(Inferred("effects of '{name}'"))
  // Resolve params to shared identities ONCE (binds the parameter nodes);
  // reused below for the ownership pass — never re-derived per consumer
  // (Carried-Truth). Each is then DECLARED: its pattern bound against its
  // node, its precondition noted where the value walk reads it, and its
  // guard cell the pre-registration's own, so a call judged against the
  // registered signature charges the cell this judgment fills.
  // One scope per signature: a lowercase name means one variable in every
  // parameter, the return and the clause (SYNTAX's case rule).
  let (param_tys, sig_scope) = build_param_scope(params)
  // A `with` row inside a parameter's or the return's type names effects the
  // link declares, or the declaration refuses (check_effect_names's law, at
  // the function-type altitude: `f: () -> a with !Network` constrained
  // nothing while no Network existed).
  link_params_written(params)
  if ret_ann != body_node { link_written(ret_ann) }
  declare_param_binders(params, name)
  let resolved_params = declare_params(params, param_tys, judged_guards(handle, params, name))
  // THE ASSUMED SIGNATURE RIDES THE SLOT AS A VALUE — prereg's own law
  // (pre_register_fn_sig: "a value inside the record cannot be
  // class-contaminated ... a chased ret VAR reaches the obligation's own
  // class through tail-call merging; the value never does"), applied at
  // the decl's live pin. The decl's fn_ty was the ONE construction still
  // carrying the var slot, and the rec-call is the one caller that reads
  // it: probe-measured 2026-08-12 on the interval fixture's seek, whose
  // own decide chased the slot to
  // the body join's first-bound bare Int because the old post-body pin
  // rebound the cell AFTER the body obligation had already decided — the
  // assumed signature arrived one statement late. Resolving BEFORE the
  // body makes the IH visible to the rec-call's callee read on time; the
  // cell still binds (forward-ref grounding + quantification), exactly as
  // at prereg. Absent annotation ⇒ the fresh var, inferred as before.
  let authored_pin = match graph_node_body(ret_ann) {
    // The annotation is a cell: its node holds the type it declares, where
    // the caret reads it.
    NTypeAnn(pin_ty) => match quantify_ctor_ty(pin_ty, sig_scope, Located(span, Declared(name))) {
      (resolved_pin, _pq) => {
        graph_bind(ret_handle, resolved_pin, Located(graph_span_of(ret_ann), Declared(name)))
        graph_bind(ret_ann, resolved_pin, Located(graph_span_of(ret_ann), Declared(name)))
        Some(resolved_pin)
      },
    },
    // The absent-annotation marker (the parser mints LitUnit when no
    // `->` is authored): no pin.
    _ => None,
  }
  let pinned_ret = match authored_pin {
    Some(resolved_pin) => resolved_pin,
    // The return stays the fn's own minted cell — the inferred form.
    None => TVar(ret_handle),
  }
  let fn_ty = TFun(resolved_params, pinned_ret, mk_ef_open([], row_handle))
  // Bind the name BEFORE body so recursive calls resolve.
  let existing = graph_chase(handle)
  match existing {
    GNode(NBound(existing_ty), _) => unify_types(existing_ty, fn_ty, span, Declared(name)),
    _ => {
      // A FULLY-signature'd decl keeps the prereg's QUANTIFIED scheme in
      // scope — self-calls instantiate it fresh per use, so signature'd
      // polymorphic recursion checks (Hβ.infer.sigd-polymorphic-recursion;
      // group_mono_views already exempts sig'd cycle members — this is
      // the same exemption at the intra-decl shadow, the one remaining
      // mono writer). The body still judges against fn_ty through the
      // graph_bind and the authored param/ret pins, so a body violating
      // its signature refuses at the pins. An unsig'd decl binds the
      // mono view — HM's mono recursion, the inference-soundness floor —
      // and a decl the prereg never registered keeps it too (the belt).
      match env_lookup(name) {
        Some(_) => if poly_hint {
          // The Mycroft rounds pre-bind the assumed poly scheme — the
          // mono shadow would erase the assumption (the driver's whole
          // point). The sig'd exemption below is the same skip for the
          // prereg quantified scheme.
          ()
        } else if fn_fully_sigd(params, ret_ann) {
          ()
        } else {
          env_extend(name, Frozen([], fn_ty), Located(span, Declared(name)), FnScheme, handle)
        },
        None => env_extend(name, Frozen([], fn_ty), Located(span, Declared(name)), FnScheme, handle),
      }
      graph_bind(handle, fn_ty, Located(span, Declared(name)))
    },
  }
  // Enter the row-accumulation scope and infer body. The frame is born with
  // the authored declaration; the exit hands it back for enforcement below.
  // The fn body IS a region (§5.O layer 3 — the per-decl granularity the
  // arena resets at): every value the body walk constructs tags with this
  // region; nested fn decls nest their own; the return check below either
  // TRANSFERS the body value to the parent region or proves the escape.
  inf_enter_fn(row_handle, span, effs)
  inf_frame_params(params ++ [ret_handle])
  let body_region = region_enter(span)
  // The body is a consume scope — its `own` params are its own linear
  // resources. Without this bracket, a name consumed here (affine_ledger
  // is installed once at the pipeline, not per body) stays in its used set and
  // collides in the NEXT function that names the same `own` param — the
  // cross-function buf/acc false positives.
  consume_enter_fn()
  // The linear obligations this body accepts, declared INSIDE the
  // bracket: an authored `own` param is the claim "this is mine to
  // finish", and consume_exit_fn reports whichever the body never
  // consumed — affine's exactly-once half
  // (Hβ.own.linear-tier-and-persist-value-barrier). Inside, not before:
  // consume_enter_fn opens a fresh frame and clears the list, so a
  // declaration made before the bracket is wiped before the walk (measured
  // — the first form reported nothing on a fn that plainly drops its
  // own param). Authored only: infer_ownership runs AFTER the body, so
  // the honest fact here is what the developer wrote.
  declare_authored_owns(params, span)
  ages_open_fn(params)
  claim_param_shapes(params)
  infer_expr(body_node)
  ages_close_fn(handle, params, body_node)
  // The authored return is claimed INSIDE the declaration's frame, where a
  // function crossing into it pays the guard of each demand the stated type
  // does not provide, and before the frame's own guards settle. Raised after
  // the exit, the payment joined whatever frame was open — none at module
  // scope, where it was dropped — so `fn mk() -> (Int) -> Int = inv` with
  // `mk()(0)` under `!Trap` checked clean and divided by zero (pin
  // 852184886f52a848, S6). The claim reads the body's own edges, so it
  // needs nothing the return unify below adds.
  claim_authored_return(ret_ann, body_node, name, span)
  settle_own_guards(params, row_handle)
  report_unconsumed(consume_exit_fn())
  let declared_effs = exit_frame()
  // Unify body's type with the declared return.
  // The `-> RetTy` annotation is PINNED BEFORE the body (the assumed-
  // signature slot value above), so this unify runs the body against the
  // bound cell — a disagreeing body surfaces E_TypeMismatch through that
  // one edge.
  unify(body_node, ret_handle, span, FnReturn(name, Inferred("body")))
  // H4: every fn return is an escape boundary — and a TRANSFER. The body
  // value tagged with THIS fn's region re-tags into the parent's (the
  // caller owns it now — Hβ.own.region-return-transfer); an outer-region
  // or global tag already outlives this return; a dead-region tag is the
  // genuine escape, reported with both spans. The check runs INSIDE the
  // body region (the arm reads the stack top to know which region is
  // "mine"); the exit follows.
  check_escape(body_node, span)
  region_exit(body_region)
  // ─── Ownership inference (§4⑤, arm 5) — the Hylo-quiet bar ──────
  // After the body is inferred, classify each Unmarked param's ownership
  // from its body use-count (0/1/2+ → Unmarked/Own/Ref); an authored own/ref
  // becomes a CONSTRAINT the inferred is checked against. The inferred params
  // are written BACK into the fn's TFun node (over the SAME param handles, so
  // types stay live as TVar(h)) — so lower's Consume-elision and affine_ledger
  // read the inferred ownership LIVE (Carried-Truth: written once at infer, read
  // live everywhere, never re-derived per consumer). The lifetime hazard — a
  // value outliving its region — is proven by check_escape (the region tracker,
  // above at :434).
  // REMOVED here (Stage 1b): a syntactic escape check that fired on
  // use-count-plus-bare-return with no hazard model — 356 false alarms, min and
  // every fold accumulator among them. The region tracker covers the real hazard.
  // A return no annotation states is handed to a caller this body
  // cannot see (`hand_on_value`); an authored one is crossed by its
  // claim above.
  match pinned_ret {
    TVar(_) => hand_on_value(body_node),
    _ => (),
  }
  let inferred_params = infer_ownership(resolved_params, map(param_pat, params), body_node)
  graph_bind(
    handle,
    // The ret slot carries the SAME pinned value the pre-body signature
    // rides: a declared return is the fn's postcondition, a contract,
    // and a function type's interior is where contracts live. The
    // params publish what the body learned of them (published_params).
    TFun(
      published_params(inferred_params, params, name, span),
      published_ret(pinned_ret, body_node, ret_handle),
      mk_ef_open([], row_handle)
    ),
    Located(span, Inferred("ownership-resolved params of '{name}'"))
  )
  // ─── Declared effects enforcement (gap 1 + 2) ──────────────────
  // If the FnStmt carries a declared effect row, verify the inferred
  // body's row is subsumed by it. If so, rebind row_handle to the
  // declared row so callers see the API contract. If not, emit
  // E_EffectMismatch (body does more than the declaration admits).
  // The declared row IS the gate — row_subsumes is the proof engine.
  // `declared_effs` arrived with inf_exit_fn's return above: the popped
  // frame's own declaration, so a nested fn can never clobber this one's.
  if len(declared_effs) > 0 {
    // D3 — `with Pure` is absolute: body row must be the pure row (not
    // merely ⊆ some sugar row named Pure). When Pure appears
    // anywhere in declared_effs, the declared row collapses to
    // the pure row and any other declared names are a contradiction (a
    // single warning surfaces them precisely in the contradiction
    // diagnostic).
    let has_pure = has_pure_declared(declared_effs)
    // The registration fold runs FIRST, so the instance typing,
    // the signed fold's meet (absent_contradicted_by), and the
    // pin all judge the value-distinct forms — resolution
    // happens once, at the one env-whole point, never inside
    // the row algebra's compares.
    let resolved_effs = resolve_declared_instances(declared_effs)
    check_effect_names(resolved_effs, span)
    check_instance_args(resolved_effs, span)
    let declared_row = build_declared_row_in(resolved_effs, sig_scope)
    // THE GATE RUNS ON THE RESOLVED ROW, at every exit — a cycle
    // member's, a HOF's, a solo's alike. It used to PARK a cycle
    // member's gate until the group's chains closed, because the
    // exit check was vacuous over a free edge and had to be re-run
    // once the co-member resolved it (a deferral channel, a group
    // drain, a pass-tail drain, and the signature-frees partition
    // that decided which parks could ever resolve). With the gate
    // carried BY the free edge, the write that resolves it is the
    // check: the exit installs unconditionally and nothing parks.
    enforce_row_gate(name, declared_row, has_pure, row_handle, span, Some(handle))
  }
  env_scope_exit()
  // Generalize and re-extend. Located: this is the entry every later
  // reader resolves (the flat env scans newest-first), so the decl span
  // rides the reason for the Why chain and the executable gate's
  // unhandled-effect diagnostic. A member of a cycle still being judged
  // quantifies its rows alone, as the view the group opened with does: a
  // type variable quantified here could be one a co-member judged later
  // binds, and that co-member's reference would read a fresh copy of it — a
  // call spliced into a string answered a type variable where it answered
  // String, and the emit refused the show (2026-10-15,
  // tests/micros/mn-cycle-member-read-mid-group.mn). The group publishes
  // every member's final as it closes (`group_final_publish`). A Mycroft
  // round's assumption is a polymorphic scheme by intent, and a signature is
  // its declared polymorphism.
  let scheme = match generalize_pair(handle) {
    (qs, ty) => if ages_in_cycle(handle) && !poly_hint && !fn_fully_sigd(params, ret_ann) {
      Frozen(row_handles_only(qs, 0), ty)
    } else {
      Frozen(qs, ty)
    },
  }
  env_extend(name, scheme, Located(span, Declared(name)), FnScheme, handle)
  each(report_guard_note, graph_guard_drain())
}

// A refusal the graph's write guard noted, rendered and reported here, beside
// the graph the guard protected — AT the module the guard noted, so its name
// and layer are read where every report reads them. (This call dropped a
// field on 2026-10-12, when the report grew a layer: with one field
// unsupplied it was a PARTIAL, a value `each` discarded, and every occurs
// refusal the guard noted vanished — `fn f(x) = x == [x]` checked clean and
// a polymorphic self-call judged monomorphic. The stage of `each` answers
// `()` now, so a dropped function value there is a type error.)
fn report_guard_note(note) = match note {
  (d, m) => report_at(m, d),
}

// ─── The instance-argument REGISTRATION FOLD ──
// A bare ident at an effect-arg position parses as EANode — the parser
// cannot resolve it (the env is infer's). HERE, at registration — the one
// deterministic point where the env is whole — the ident's env kind folds
// the constant cases to their value-distinct forms: an EFFECT name becomes
// EAEffect (its intern handle), a NULLARY ctor becomes EACon (its intern
// handle — a nullary ctor is a constant, its tag). Everything else keeps
// the conservative EANode arm: a let/param-bound name is a genuine runtime
// operand (leak-instance-node's contract), and a fielded ctor used bare is
// a function value, never a constant. The fold lives here and not in
// build_row_seen because the parser also calls that fold (fn-TYPE rows, at
// parse time, env part-built) — an env-dependent leaf there would make the
// row a function of parse ORDER, the decl-order disease 4.2 paid to kill.
fn resolve_declared_instances(effs) = map(resolve_instance_triple, effs)

fn resolve_instance_triple(eff) = match eff {
  (t, negated, conn) => (resolve_instance_term(t), negated, conn),
}

fn resolve_instance_term(t) = match t {
  RtEff(name, at) => RtEff(resolve_instance_name(name), at),
  RtGroup(ts) => RtGroup(resolve_declared_instances(ts)),
}

fn resolve_instance_name(name) = match name {
  EParameterized(h, args) => EParameterized(h, map(resolve_one_eff_arg, args)),
  ENamed(_) => name,
  EPure => name,
}

fn resolve_one_eff_arg(arg) = match arg {
  EANode(nh) => match graph_node_body(nh) {
    NExpr(VarRef(nm)) => match env_lookup(nm) {
      Some(entry) => match entry {
        (sch, _, kind) => match kind {
          EffectDeclKind(_, _) => EAEffect(intern_str(nm)),
          ConstructorScheme(_, _) => match judgment_ty(sch) {
            // nullary ctor: the scheme's result IS the TName (fielded
            // ctors carry TFun — scheme_result_is' own reading)
            TName(_, _) => EACon(intern_str(nm)),
            _ => arg,
          },
          _ => arg,
        },
      },
      None => arg,
    },
    _ => arg,
  },
  EAInt(_) => arg,
  EAFloat(_) => arg,
  EAString(_) => arg,
  EAType(_) => arg,
  EAEffect(_) => arg,
  EACon(_) => arg,
}

// The declared row's INSTANCE PIN — the constraint half the publish law
// keeps: the declaration publishes NOTHING, but it is still a CONSTRAINT
// the inferred is verified against (the Intent-Boundary law), and for a
// value-parameterized effect the authored scalar instance (`with
// S(48000)`) is exactly such a constraint on the charge's unknowable
// value dims (register_effect_ops' EANode positions). Position-wise,
// scalars only, never a name added or a tail touched — the EtAll
// fabrication the publish law deleted cannot ride this write.
fn pin_declared_instances(body_row, declared_row) = match declared_row {
  EfRow(dp, _, _) => match body_row {
    EfRow(bp, ba, bt) => ef_make(map((b) => pin_present_entry(b, dp), bp), ba, bt),
  },
}

fn pin_present_entry(b, dp) = match b {
  EParameterized(bn, bargs) => match find((d) => pin_source_for(bn, bargs, d), dp) {
    Some(d2) => match d2 {
      EParameterized(_, dargs) => EParameterized(bn, pin_arg_positions(bargs, dargs, 0)),
      ENamed(_) => b,
      EPure => b,
    },
    None => b,
  },
  ENamed(_) => b,
  EPure => b,
}

fn pin_source_for(bn, ref bargs, d) = match d {
  EParameterized(dn, dargs) => dn == bn && !eff_args_provably_distinct(dargs, bargs, 0),
  ENamed(_) => false,
  EPure => false,
}

fn pin_arg_positions(ref bargs, ref dargs, i) = if i >= len(bargs) {
  []
} else if i >= len(dargs) {
  [list_index(bargs, i)] ++ pin_arg_positions(bargs, dargs, i + 1)
} else {
  [pin_arg_position(list_index(bargs, i), list_index(dargs, i))] ++ pin_arg_positions(bargs, dargs, i + 1)
}

// A charge-side value dim (EANode) takes the declared scalar; a type dim
// (EAType) is the install flow's, never value-pinned; a concrete scalar
// keeps its own truth (the subsumes read judges it).
fn pin_arg_position(barg, darg) = match barg {
  EANode(_) => pin_scalar_or_keep(barg, darg),
  EAType(_) => barg,
  EAInt(_) => barg,
  EAFloat(_) => barg,
  EAString(_) => barg,
  // registration-fold constants: concrete, they keep their own truth
  // exactly as the scalar literals do (the subsumes read judges them)
  EAEffect(_) => barg,
  EACon(_) => barg,
}

fn pin_scalar_or_keep(barg, darg) = match darg {
  EAInt(_) => darg,
  EAFloat(_) => darg,
  EAString(_) => darg,
  EAType(_) => barg,
  // the registration fold's constants pin the charge's unknowable value
  // dim exactly as the scalar literals do — the declared instance IS the
  // decl's own truth
  EAEffect(_) => darg,
  EACon(_) => darg,
  // The declared NON-LITERAL instance pins exactly as a scalar does:
  // the charge's value dim is the entry's unknowable placeholder, and
  // the declared operand NODE is the decl's own instance truth — same
  // handle, so same-name instances compare equal and the false
  // declared-vs-charged mismatch dies (measured 2026-08-08:
  // `with Sample(rate)` refused its own body's tick()). The
  // conservative gate against a forbidden literal is untouched — an
  // EANode is still never provably distinct from it.
  EANode(_) => darg,
}

// The declared-row gate at a declaration's exit — ONE firing site. The
// body row is read through its cell and FOLDED (resolve_row, never
// graph_chase: a single-edge alias chases to the terminal and reports the
// bare cell, and a two-edge tail is its own terminal), so bound edges fold
// into the presents and free terminals survive as residual edges carrying
// the masks their paths accumulated. Three moves on that reading:
//   the GROUND check — presents against the declaration (row_subsumes,
//     whose free-tail admission is exactly right here: the tail is what
//     the install constrains);
//   the INSTALL — the declaration's negation, or its empty closed cap
//     (`with Pure`), enters every free terminal through the edge's mask
//     (effects.mn gate_install: the terminal's aliases, its current
//     content, and every copy minted while this declaration was open);
//   the over-declared TEACHING — narrated only on a GROUND row. A free
//     terminal means the body's row is a parameter's row, unjudged here,
//     and teaching from it fabricated the row it claimed to have read
//     (`mentl tighten` authored the patch — the medium recommended
//     narrowing a declaration to `Pure` on a body it had never judged).
// A positive declared row installs nothing yet: the wheel's authored
// positive rows are inventories, never caps
// (Hβ.effects.declared-positive-rows-under-count-callbacks), and gating
// them before A4 deletes the inventories would refuse every HOF; the
// negation half of a mixed clause (`with A + !B`) installs as `!B`.
// The pin (the entry's unknowable value dim becomes the declared scalar)
// is a decl-exit REPLACE on the STORED row — a finalize, judged like
// every replace — and runs first so the reading below sees it.
fn enforce_row_gate(name: String, declared_row, has_pure, row_handle, span: ValidSpan, decl) = {
  let why = Located(span, Declared(name))
  match graph_chase(row_handle) {
    GNode(NRowBound(raw_row), _) => {
      let pinned = pin_declared_instances(raw_row, declared_row)
      if pinned == raw_row { () } else { graph_finalize_row(row_handle, pinned, why) }
    },
    _ => (),
  }
  let body_row = resolve_row(mk_ef_open([], row_handle))
  if row_subsumes(body_row, declared_row) {
    // The ground reading the teaching may judge: a cell nothing ever
    // charged (free, its own root) is the pure body; a resolved row with
    // no free terminal is its own truth; a free terminal is unjudged.
    let ground = if graph_chase_handle(row_handle) == row_handle && row_var_is_free(row_handle) {
      Some(mk_ef_pure())
    } else if row_is_ground(body_row) {
      Some(body_row)
    } else {
      None
    }
    // THE TEACHING READS THE POSITIVE HALF ONLY (A4, 2026-09-27). A
    // negation is a proof claim, never an inventory, and comparing the
    // whole declared row narrated `!Mutate + Any` as "over-declared"
    // against a Pure body — false at every negation-only signature, which
    // is the normal signature once the positive row is inferred. So the
    // bare declared names are judged alone: beyond the proven row they are
    // over-declared; within it they are an inventory (the projected row
    // written by hand); absent, there is nothing to teach.
    match declared_bare_row(declared_row) {
      Some(bare) => match ground {
        Some(g) => if row_subsumes(bare, g) {
          report(TRowInventory(declared_row, g, name, span))
        } else {
          report(TOverDeclared(declared_row, g, name, span))
        },
        // An OPEN body row (a callback's row rides its tail): the bare
        // positive names are a CAP on what the callbacks may perform, and
        // the cap is a GATE (`declared_gate` below, A3-pos) — a deliberate
        // narrowing, not an inventory. This arm narrated the cap as an
        // inventory for exactly one landing (A4), while a positive row
        // installed nothing, which is how the wheel's 164 open-row caps
        // were swept; with the gate armed, nothing is said here.
        None => (),
      },
      None => (),
    }
  } else if has_pure {
    report(EPurityViolated(body_row, span))
  } else {
    report(EEffectMismatch(
      declared_row,
      body_row,
      mismatch_reason(name, declared_row, body_row, decl, span),
      span
    ))
  }
  match declared_gate(declared_row, has_pure, why) {
    Some(g) => gate_terminals(g, body_row, row_handle, span),
    None => (),
  }
}

// The declared row's bare positive names as a closed row of their own —
// what an inventory or an over-declaration is made of. Instance pins
// (`Sample(44100)`) are decisions and stay out of it; so do negations.
// None when the clause authors no bare positive name.
fn declared_bare_row(declared_row) = match declared_row {
  EfRow(p, _, _) => {
    let bare = filter({ ENamed(_) => true, _ => false }, p)
    if len(bare) == 0 { None } else { Some(EfRow(bare, [], EtClosed)) }
  },
}

// ── WHERE AN EFFECT ENTERS — the walk from a row to its site (2026-10-13) ──
//
// Every charge is noted on a node of the construct that makes it
// (`inf_add_row_at` — a pattern's rest charges the scrutinee it is cut from),
// so "where does WASI enter this declaration" is a descent the graph already
// carries: from a node to the earliest child whose subtree row carries the
// effect (`row_of_subtree`), until a node none of whose children carries it
// — the SITE. A call to an op is the perform, and the chain ends at the
// effect's declaration; a call to a declaration continues inside that
// declaration's body, since the one judgment holds every module's notes; a
// call through a value stops at the value; a callee whose own body does not
// carry the effect took it in through a function value, whose body the chain
// enters; a construct that charges by itself — a splice, a list literal, a
// constructor call — is named where it stands. Each hop is an `EffectEnters`
// Reason, so `E_EffectMismatch` carries the chain from the declaration whose
// negation the body violates, the caret's Why lists one per effect of a
// declaration's row, and `mentl why <entry> <fn> <Effect>` prints it.
//
// The refusal's reason: the declaration, then the first forbidden effect's
// chain from its body. The row's other forbidden effects are in the
// message's rows, and `mentl why` answers each; a handler's clause has no
// body here and keeps the declaration alone; a charge the body's nodes never
// noted (a guard a callee's precondition hands to its caller) is said in the
// chain's place.
fn mismatch_reason(name: String, declared_row, body_row, decl, span: ValidSpan) = match decl {
  None => Located(span, Declared(name)),
  Some(dh) => match offending_names(declared_row, body_row) {
    [] => Located(span, Declared(name)),
    [eff, ..._] => match graph_node_body(dh) {
      NStmt(FnStmt(_, _, _, _, body)) => Located(span, EffectEnters(eff_name_str(eff), dh, body_entry(eff, body, [dh]))),
      _ => Located(span, Declared(name)),
    },
  },
}

// The body's present effects the declaration refuses: a name its negation
// forbids, or — under a closed declared row, a cap — a name no declared
// positive admits.
fn offending_names(declared_row, body_row) = match declared_row {
  EfRow(dp, da, dt) => match body_row {
    EfRow(bp, _, _) => filter(not_admitted(dp, da, dt, ??), bp),
  },
}

fn not_admitted(dp, da, dt, present) = any(eff_forbids(??, present), da) || match dt {
  EtClosed => !any(eff_admits(??, present), dp),
  EtOpen(_) => false,
  EtAll => false,
}

// The chains a declaration's row is made of — one per effect its resolved
// row carries, each from the declaration to the site that charges it — read
// live for the caret's Why and the why verb, never stored.
fn effect_entries_of(h) = match graph_node_body(h) {
  NStmt(FnStmt(_, _, _, _, body)) => match chase_ty(TVar(h)) {
    TFun(_, _, row) => match resolve_row(row) {
      EfRow(present, _, _) => present |> filter({ EPure => false, _ => true }) |> map(decl_effect_entry(h, body, ??)),
    },
    _ => [],
  },
  _ => [],
}

fn decl_effect_entry(h, bh, eff) = EffectEnters(eff_name_str(eff), h, body_entry(eff, bh, [h]))

// The chain from a declaration's body: the descent where the body's nodes
// note the effect, else the one sentence for a charge no node owns.
fn body_entry(eff, bh, seen) = if carries(eff, bh) {
  effect_entry(eff, bh, seen)
} else {
  Inferred("the body's row without a site — a guard a callee's precondition hands to its caller")
}

// The descent: into the earliest child that carries the effect, else this
// node is the site.
fn effect_entry(eff, h, seen) = match entry_child(eff, h) {
  Some(c) => effect_entry(eff, c, seen),
  None => entry_at(eff, h, seen),
}

// Which child the walk enters, under `row_of_subtree`'s own reading of what
// runs when a node is evaluated: a lambda, a nested fn and a handler
// declaration mint and install nothing of their bodies; a tee's body may
// still carry what its handler does not absorb, and carries nothing of what
// it does, so an absorbed effect enters through the install itself — its
// arms, read at `entry_at`; a cycle's delay spec never runs; every other
// node's children run before it.
fn entry_child(eff, h) = match graph_node_body(h) {
  NExpr(LambdaExpr(_, _)) => None,
  NStmt(FnStmt(_, _, _, _, _)) => None,
  NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => None,
  NExpr(PipeExpr(PTee, l, hnd)) => if tee_absorbs_here(hnd, eff) { None } else { earliest_carrier(eff, [l]) },
  NExpr(PipeExpr(PFeedback, l, _)) => earliest_carrier(eff, [l]),
  body => earliest_carrier(eff, body_child_handles(body)),
}

// Whether the install at a tee absorbs the effect — its handler's arms name
// it, the same read the tee's row takes (`infer_pipe_tee`). What the body
// charges of an absorbed effect never reaches the declaration's row, so the
// walk that descended into the body there named a site the row did not
// carry: a root leak made by a handler's own arm was answered with another
// handler's arm under the same chain (measured 2026-10-13).
fn tee_absorbs_here(hnd, eff) = match tee_arms(hnd) {
  Some(arms) => any({ n => eff_name_str(n) == eff_name_str(eff) }, derive_handler_enames(arms, 0, [])),
  None => false,
}

// The site's hop: what the effect crosses there, and the chain beyond it.
fn entry_at(eff, h, seen) = match graph_node_body(h) {
  NExpr(CallExpr(f, args)) => EffectEnters(eff_name_str(eff), h, callee_entry(eff, f, args, seen)),
  NExpr(PipeExpr(PForward, l, stage)) => EffectEnters(eff_name_str(eff), h, stage_entry(eff, stage, [l], seen)),
  NExpr(PipeExpr(PTee, _, hnd)) => EffectEnters(eff_name_str(eff), h, install_entry(eff, hnd, seen)),
  body => EffectEnters(eff_name_str(eff), h, Inferred(charge_word_at(h, body))),
}

// What a node charges by itself, in words: a match the parse made of a
// destructuring `let` is the let, whose shape claim is the charge.
fn charge_word_at(h, body) =
  if graph_let_born(h) { "the destructuring let" } else { charge_word(body) }

// Through a stage: a reference or a call the pipe completes with the piped
// value, or a literal applied in place, whose body runs in this frame.
fn stage_entry(eff, stage_h, piped, seen) = match graph_node_body(stage_h) {
  NExpr(VarRef(_)) => callee_entry(eff, stage_h, piped, seen),
  NExpr(CallExpr(f, args)) => callee_entry(eff, f, args ++ piped, seen),
  NExpr(LambdaExpr(_, body)) => effect_entry(eff, body, seen),
  _ => Inferred("a call through a value"),
}

// Through an install: the handler's arms and state inits run under the tee,
// and the install itself charges its record.
fn install_entry(eff, hnd, seen) = match tee_handler_decl(hnd) {
  Some(dh) => match graph_node_body(dh) {
    NStmt(HandlerDeclStmt(hname, _, _, _, _, _)) => match earliest_carrier(eff, body_child_handles(graph_node_body(dh))) {
      Some(c) => effect_entry(eff, c, seen),
      None => Inferred("the install of `{hname}`"),
    },
    _ => Inferred("the install"),
  },
  None => Inferred("the install"),
}

// Through a callee, by its edge to what it names: an op of the effect is the
// perform, and the chain ends at the effect's declaration; a function is
// entered, a module's or a block's alike; a constructor builds its variant,
// which is the charge; a value in scope is where the walk stops.
fn callee_entry(eff, callee_h, arg_hs, seen) = match graph_node_body(callee_h) {
  NExpr(VarRef(name)) => match graph_ref_decl(callee_h) {
    Some(dh) => match graph_published(dh) {
      Some((_, _, EffectOpScheme(_, _, _, _))) => op_entry(eff, dh, name),
      Some((_, _, ConstructorScheme(_, _))) => Inferred("building `{name}`"),
      _ => match graph_node_body(dh) {
        NStmt(FnStmt(_, _, _, _, _)) => decl_entry(eff, name, dh, arg_hs, seen),
        _ => Inferred("the function value `{name}`"),
      },
    },
    None => Inferred("`{name}`, which no declaration in this link names"),
  },
  _ => Inferred("a call through a value"),
}

// An op's effect is its declaration's parent: the effect declaration whose
// body holds the op.
fn op_entry(eff, op_decl, opname: String) = match graph_parent_of(op_decl) {
  Some(effect_decl) => match graph_node_body(effect_decl) {
    NStmt(EffectDeclStmt(en, _, _)) => if en == eff_name_str(eff) {
      EffectEnters(en, effect_decl, Declared(opname))
    } else {
      Inferred(foreign_op_charge(opname, en))
    },
    _ => Declared(opname),
  },
  None => Declared(opname),
}

// An op the walk reaches for an effect not its own charges that effect by
// what the judgment reads of the call: a raw store whose address is older
// than the frame performs Mutate (`raw_store_target`).
fn foreign_op_charge(opname: String, en: String) = match raw_store_target(opname) {
  RsAt(_) | RsAll => "`{opname}`, a store into memory older than the frame it runs in",
  RsNone => "`{opname}`, an op of {en}",
}

// Into a declaration: its body where the body carries the effect; else the
// effect came in through a function value handed to it — a literal whose
// body carries it, or a named function whose row does.
fn decl_entry(eff, name: String, dh, arg_hs, seen) = if any({ x => x == dh }, seen) {
  Inferred("`{name}`, already on this path")
} else {
  match graph_node_body(dh) {
    NStmt(FnStmt(_, _, _, _, body)) => if carries(eff, body) {
      effect_entry(eff, body, push(seen, dh))
    } else {
      match find(value_carries(eff, ??), arg_hs) {
        Some(vh) => value_entry(eff, vh, seen),
        None => Inferred("a value handed to `{name}`"),
      }
    },
    _ => Inferred("the value `{name}`"),
  }
}

fn value_carries(eff, vh) = match graph_node_body(vh) {
  NExpr(LambdaExpr(_, body)) => carries(eff, body),
  _ => match chase_ty(TVar(vh)) {
    TFun(_, _, row) => row_carries(resolve_row(row), eff),
    _ => false,
  },
}

// A value handed in is entered where it runs: a literal's body, a named
// function, a partial application's callee.
fn value_entry(eff, vh, seen) = match graph_node_body(vh) {
  NExpr(LambdaExpr(_, body)) => EffectEnters(eff_name_str(eff), vh, effect_entry(eff, body, seen)),
  NExpr(VarRef(_)) => EffectEnters(eff_name_str(eff), vh, callee_entry(eff, vh, [], seen)),
  NExpr(CallExpr(f, args)) => EffectEnters(eff_name_str(eff), vh, callee_entry(eff, f, args, seen)),
  _ => Inferred("a function value handed in"),
}

// Whether a subtree's row carries the effect, by name.
fn carries(eff, h) = match row_of_subtree(h) {
  Some(row) => row_carries(row, eff),
  None => false,
}

fn row_carries(row, eff) = match row {
  EfRow(present, _, _) => any({ p => eff_name_handle(p) == eff_name_handle(eff) }, present),
}

// The earliest-placed child that carries the effect — evaluation order is
// source order among a node's children, and a child the parser placed
// nowhere never wins over one it did.
fn earliest_carrier(eff, hs) = fold(None, earlier_carrier(eff, ??, ??), hs)

fn earlier_carrier(eff, best, h) = if carries(eff, h) {
  match best {
    None => Some(h),
    Some(b) => if span_before(graph_span_of(h), graph_span_of(b)) { Some(h) } else { best },
  }
} else {
  best
}

fn span_before(a, b) = match a {
  Span(al, ac, _, _) => match b {
    Span(bl, bc, _, _) => al > 0 && (bl == 0 || al < bl || al == bl && ac < bc),
  },
}

// What a node charges by itself, for a site no call explains. A reference
// charges nothing of its own, so a note on one is a charge the judgment laid
// on the value's node for a construct around it — a pattern's rest cut from
// the scrutinee, a product built from a piped value.
fn charge_word(body) = match body {
  NExpr(e) => expr_charge_word(e),
  NStmt(s) => stmt_charge_word(s),
  NPat(_) => "the pattern",
  NHole(_) => "the hole",
  NModule(_) => "the module",
  NLink(_) => "the link",
  NRow(_) => "the row",
  NTypeAnn(_) => "the annotation",
  NName(_) => "the row",
  NParam(_) => "the parameter",
}

fn expr_charge_word(e) = match e {
  LitInt(_) => "the literal",
  LitFloat(_) => "the literal",
  LitString(_) => "the literal",
  LitBool(_) => "the literal",
  LitUnit => "the literal",
  VarRef(name) => "what is built from `{name}` here",
  BinOpExpr(op, _, _) => "the operator {binop_to_str(op)}",
  UnaryOpExpr(_, _) => "the operator",
  CallExpr(_, _) => "the call",
  LabeledArg(_, _) => "the argument",
  LambdaExpr(_, _) => "minting the function value",
  IfExpr(_, _, _) => "the if",
  BlockExpr(_, _) => "the block",
  MatchExpr(_, _) => "the match",
  ResumeExpr(_, _) => "the resume",
  MakeListExpr(_) => "building the list",
  MakeTupleExpr(_) => "building the tuple",
  MakeRecordExpr(_) => "building the record",
  RecordUpdateExpr(_, _) => "building the record",
  NamedRecordExpr(_, _) => "building the record",
  IndexExpr(_, _) => "the index",
  MakeStringExpr(_) => "the string interpolation",
  ShowExpr(_) => "rendering the value",
  FieldExpr(_, _) => "the field read",
  PipeExpr(kind, _, _) => pipe_charge_word(kind),
  FanoutExpr(_) => "the fanout",
  RestExpr(_) => "the rest",
  ExprPlaceholder => "the placeholder",
}

fn pipe_charge_word(kind) = match kind {
  PFeedback => "the tick, a store into the feedback line its record owns",
  PForward | PFanout(_) | PTee => "the verb",
}

fn stmt_charge_word(s) = match s {
  LetStmt(_, _, _) => "the binding",
  FnStmt(_, _, _, _, _) => "minting the nested function",
  TypeDefStmt(_, _) => "the type declaration",
  EffectDeclStmt(_, _, _) => "the effect declaration",
  HandlerDeclStmt(_, _, _, _, _, _) => "the handler declaration",
  HandlerChainStmt(_, _) => "the handler chain declaration",
  ExprStmt(_) => "the statement",
  ImportStmt(_) => "the import",
  RefineStmt(_, _, _) => "the refinement",
  AliasStmt(_, _) => "the alias",
  RowAliasStmt(_, _) => "the row alias",
}

// A judged declaration enters the decls column, which holds a block's `let`s
// and nested fns beside a module's own.
fn note_decl(node) = graph_decl_note(node)

fn decl_is_named(name: String, h) = body_decl_name(graph_node_body(h)) == name

// The gate a declaration installs: its empty closed cap (`Pure`), its
// negation (`!E`, a universe-minus row), or — A3-pos, 2026-09-27 — the
// CLOSED row itself: a declared `with E + !F` is a cap, "at most E, never
// F", and it reaches every free terminal of the body's row through each
// edge's mask (`gate_through_mask`'s closed arm: `Pg ∪ mask`, `A ∖ mask`),
// so a HOF's callbacks may perform at most what the cap admits. It used to
// install the negation half alone, and a positive cap constrained nothing:
// `fn run(f) with E = f()` accepted `run(() => op_f())` (measured on boot
// d27fc81d before this landing).
fn declared_gate(declared_row, has_pure, why) = if has_pure {
  Some(mk_gate(mk_ef_pure(), why))
} else {
  match declared_row {
    EfRow(_, _, t) => match t {
      EtAll => Some(mk_gate(declared_row, why)),
      EtClosed => Some(mk_gate(declared_row, why)),
      EtOpen(_) => None,
    },
  }
}

// Every free terminal of the resolved body row takes the gate through its
// edge's mask, installed on the terminal's ROOT (the cell the writes land
// on). The declaration's own cell, when it is itself the free terminal
// (nothing charged it), takes nothing — no write will ever reach it.
fn gate_terminals(g, body_row, row_handle, span: ValidSpan) = match body_row {
  EfRow(_, _, t) => match t {
    EtOpen(vs) => gate_terminal_edges(g, vs, row_handle, span),
    _ => (),
  },
}

fn gate_terminal_edges(g, vs: [RowEdge], row_handle, span: ValidSpan) = match vs {
  [] => (),
  [e, ...rest] => {
    let r = graph_chase_handle(edge_cell(e))
    if r == row_handle {
      ()
    } else {
      match gate_through_mask(g, edge_mask(e)) {
        Some(g2) => gate_install(r, g2, span),
        None => (),
      }
    }
    gate_terminal_edges(g, rest, row_handle, span)
  },
}

// H4 helper — does a CallExpr's callee resolve to an alloc-returning
// scheme? Constructors (ConstructorScheme) emit LMakeVariant which
// heap-allocates; nominal records (RecordSchemeKind, H2.3) reach
// here only via degenerate CallExpr — canonical form is
// NamedRecordExpr. Either way the result handle deserves region
// tracking.
fn call_is_alloc_returning(func) = match callee_binding(func) {
  Some((_, _, kind)) => match kind {
    ConstructorScheme(_, _) => true,
    RecordSchemeKind(_) => true,
    _ => false,
  },
  None => false,
}

// The binding a callee's edge reaches — a reference's declaration or binder,
// or for a callee applied to its configuration the reference it applies — as
// that declaration published it: what an env lookup of the spelling answered
// before the judgment linked the reference, read off the link instead, so a
// local that shares a module-level name is the local.
fn callee_binding(h) = match tee_handler_decl(h) {
  Some(d) => graph_published(d),
  None => None,
}

// H4 alloc-region tracking (region_enter/region_exit) opened a region
// when a `handle` block absorbed Alloc. With `handle` dissolved into
// `~>` (the one install verb), region-opening belongs on the PTee
// install when the installed handler absorbs Alloc — the cursor reads
// the handler's HandlerKind row live and opens a region iff Alloc ∈ E.
// Positive-form peer: Hβ.infer.region-on-tee-alloc-absorb. Until then the
// region effect + own.mn handler stand as dormant capability surface.
//
// Build an `EffRow` from the authored effect terms — each (EffName,
// negated, EConn). The with-clause is a SIGNED SET, not a running union:
// positive terms name what the body may perform (composed by the authored
// connective via the effects.mn algebra); negated terms name what it
// provably must NOT (one forbidden set — complements compose by
// intersection). The row is their meet:
//
//   P only       → Closed[P]
//   !N only      → ¬Closed[N]                       (the universe-minus stance)
//   P + !N mixed → Closed[P] ∩ ¬Closed[N] = Closed[P ∖ N]
//
// A raw union would collapse `Cursor + IC + !Mutate` to ¬Mutate — set-true
// but contract-false: the positives ARE the published API (callers thread
// evidence from them); the negation is the GATE. An authored `Pure` is
// absolute (D3) and dominates the clause at every caller, not only those
// that pre-check has_pure_declared. A name both admitted and forbidden
// drops out of the meet, so the body's own perform fails the subsumption
// gate LOUDLY (E_EffectMismatch) — never a silent contradiction.
// ─── Instance-arg typing (SYNTAX §«Parameterized effect») ────────────
// Each authored instance in a with-clause judges against the effect's
// registered signature — the TTuple scheme register_effect_ops
// publishes (the one home). Arity disagreement reports as the
// constructor-arity class at the declaration; a scalar-literal arg
// whose ground type disagrees with the declared param reports the
// mismatch. Type- and node-shaped args carry the instance-unification
// flow (the modal frontier's admit-through-instantiation face) and
// pass this ground check.
// Every name a clause or a named row writes RESOLVES — to an effect the link
// declares or to a row alias — or the declaration refuses. A lowercase name is
// a row variable (SYNTAX's case rule) and `Pure` is the identity; anything
// else that the env does not hold as an effect is a word the program
// invented, and a negation of it constrains nothing: `with !Network` over a
// link that declares no Network checked clean and proved nothing until
// 2026-10-12 (lib/persist.mn carried one). The refusal is E_MissingVariable,
// the same class a reference to an undeclared name takes, with the term
// named as an effect.
fn check_effect_names(effs, span: ValidSpan) = each(
  {
    (RtGroup(ts), _negated, _conn) => check_effect_names(ts, span),
    (RtEff(ename, at), _negated, _conn) => check_effect_name(ename, at, span),
  },
  effs
)

// One name of a row, resolved: a row variable, `Pure`, an effect the env
// declares or a row alias; anything else is refused at the span given. A
// name an author wrote is linked, at the node it is written at, to the
// declaration it names, so `refs of` an effect answers the rows that name it.
fn check_effect_name(ename, at, span: ValidSpan) = if row_var_spelled(ename) || is_pure_eff_name(ename) {
  ()
} else {
  match env_resolve(eff_name_str(ename)) {
    Some(d) => match graph_published(d) {
      Some((_, _, kind)) => match kind {
        EffectDeclKind(_, _) | RowAliasKind(_) => match at {
          Some(n) => graph_ref_link(n, d),
          None => (),
        },
        FnScheme
        | ValueScheme
        | ParamScheme(_)
        | EffectOpScheme(_, _, _, _)
        | HandlerKind(_, _, _, _, _)
        | HandlerChainKind(_)
        | ConstructorScheme(_, _)
        | RecordSchemeKind(_)
        | TypeVariants(_) => report(EMissingVariable("effect: {eff_name_str(ename)}", span)),
      },
      None => report(EMissingVariable("effect: {eff_name_str(ename)}", span)),
    },
    None => report(EMissingVariable("effect: {eff_name_str(ename)}", span)),
  }
}

// An op's signature, its names linked where the link is whole: the return
// its node holds, and each parameter's type.
fn link_op_written(op) = match op {
  (_, op_params, _, op_node) => {
    link_written(op_node)
    each({ p => each(link_written, written_cells(param_ty(p))) }, op_params)
  },
}

// A parameter list's written annotations, each name linked where the link is
// whole.
fn link_params_written(params) = each(
  {
    p => match param_ann(p) {
      Some(a) => link_written(a),
      None => (),
    },
  },
  params
)

fn check_instance_args(effs, span: ValidSpan) = each(
  {
    (RtGroup(ts), _negated, _conn) => check_instance_args(ts, span),
    (RtEff(ename, _), _negated, _conn) => match ename {
      EParameterized(h, args) => match env_lookup(intern_name_of(h)) {
        Some(entry) => match entry {
          (sch, _, EffectDeclKind(_, _)) => match judgment_ty(sch) {
            TTuple(ptys) => if len(args) != len(ptys) {
              report(EConstructorArity(intern_name_of(h), len(ptys), len(args), span))
            } else {
              each(
                (i) => check_one_instance_arg(list_index(args, i), list_index(ptys, i), span),
                range(0, len(args))
              )
            },
            _ => (),
          },
          _ => (),
        },
        None => (),
      },
      _ => (),
    },
  },
  effs
)

// A string literal's type is the String sequence, which is no ground scalar,
// so the ground compare alone refused `!E("A")` against its own
// `effect E(name: String)`. Compare the stripped types structurally beside
// the scalar-ground shortcut.
fn check_one_instance_arg(arg, pty, span: ValidSpan) = match instance_arg_scalar_ty(arg) {
  Some(aty) => if same_ground(aty, fold_strip(pty)) || fold_strip(aty) == fold_strip(pty) {
    ()
  } else {
    report(ETypeMismatch(aty, pty, Inferred("a parameterized effect's instance argument"), span))
  },
  None => (),
}

// A scalar literal arg's ground type; type/node args answer None (their
// typing is the instance-unification flow, not a ground compare).
fn instance_arg_scalar_ty(arg) = match arg {
  EAInt(_) => Some(TInt),
  EAFloat(_) => Some(TFloat),
  EAString(_) => Some(ty_string),
  EAType(_) => None,
  EANode(_) => None,
  // interned identities: an effect name has no ground value type, and a
  // ctor's result rides the instance-unification flow — both pass the
  // ground check the way the node arm does
  EAEffect(_) => None,
  EACon(_) => None,
}

// is_pure_eff_name / apply_connective / has_pure_declared /
// build_declared_row live in effects.mn now — pure row algebra over the
// parsed signed triples, ONE home serving this judge and the parser's
// fn-type `with` rows alike.
//
// Expression inference
fn infer_expr(ref handle) = {
  let span = graph_span_of(handle)
  match graph_node_body(handle) {
    NExpr(LitInt(_)) => graph_bind(handle, TInt, Located(span, Inferred("int literal"))),
    NExpr(LitFloat(_)) => graph_bind(handle, TFloat, Located(span, Inferred("float literal"))),
    NExpr(LitString(_)) => graph_bind(handle, ty_string, Located(span, Inferred("string literal"))),
    NExpr(LitBool(_)) => graph_bind(handle, TName("Bool", []), Located(span, Inferred("bool literal"))),
    NExpr(LitUnit) => graph_bind(handle, TUnit, Located(span, Inferred("unit"))),
    NExpr(VarRef(name)) => infer_var_ref(name, handle, span, RefValued),
    NExpr(BinOpExpr(op, left, right)) => {
      infer_operand(left)
      infer_operand(right)
      infer_binop(handle, op, left, right, span)
    },
    NExpr(UnaryOpExpr(op, inner)) => {
      infer_operand(inner)
      infer_unaryop(handle, op, inner, span)
    },
    NExpr(CallExpr(func, args)) => infer_call_expr(func, args, handle, span, AtCall),
    NExpr(IfExpr(cond, then_e, else_e)) => {
      // The condition is READ to decide the branch — a read-SHAPE
      // condition borrows; a call condition infers normally (its args
      // move; ref-param borrows already come from the callee-product
      // read). The shared shape gate, all four surfaces.
      infer_borrowed_read(cond)
      // then / else are ALTERNATIVE arms — exactly one runs — so an `own`
      // value consumed in both is one consume on the taken path, never a
      // double. The affine ledger unions the arms' deltas without a
      // collision check (BAlternative), the same mechanism `><` / `<|`
      // use with BParallel. Without this, every `if c { use(buf) } else {
      // use(buf) }` threading an owned accumulator floored E_OwnershipViolation.
      branch_enter(BAlternative)
      infer_expr(then_e)
      branch_divider(span)
      infer_expr(else_e)
      branch_exit(span)
      unify_types(TVar(cond), TName("Bool", []), span, IfBranch(Inferred("condition")))
      // E_IfMissingElse per SYNTAX.md: detect synthesized-LitUnit else
      // (parser produces LitUnit when no else clause — src/parser.mn:1275).
      // If the then-branch produces a non-unit value, the missing else
      // is structurally invalid: the if would have to "produce nothing"
      // on the false path. Emit before unify so user sees the structural
      // cause, not the downstream E_TypeMismatch.
      let else_is_synthesized_unit = match graph_node_body(else_e) {
        NExpr(LitUnit) => true,
        _ => false,
      }
      if else_is_synthesized_unit {
        let then_ty = lookup_ty(then_e)
        match then_ty {
          // Unit's REAL constructor is TUnit — the old TName("Unit") arm
          // matched a nominal spelling the inferencer never produces, so
          // every genuinely-unit then (`if c { wat_emit(...) }`, 25 wheel
          // sites) was judged non-unit. The probe that settled it printed
          // then_ty=() for all 25.
          TUnit => (),
          TName("Unit", _) => (),
          // An UNRESOLVED then is not evidence either — an effect-op
          // call's result resolves through the unify just below (6 wheel
          // sites). The unify against the synthesized unit decides: a
          // genuinely non-unit then mismatches loudly there.
          TVar(_) => (),
          _ => report(EIfMissingElse(span)),
        }
      }
      unify(then_e, else_e, span, IfBranch(Inferred("branches must match")))
      graph_bind(handle, TVar(then_e), Located(span, IfBranch(Inferred("if result"))))
    },
    NExpr(BlockExpr(stmts, final_expr)) => {
      env_scope_enter()
      each(infer_run, stmt_runs(stmts))
      nested_fns_charge(stmts)
      infer_expr(final_expr)
      graph_bind(handle, TVar(final_expr), Located(span, Inferred("block result")))
      env_scope_exit()
    },
    NExpr(MatchExpr(scrutinee, arms)) => {
      // The scrutinee is READ to dispatch — a read-shape scrutinee
      // (`match kind { ... }`) borrows and stays available in the arms;
      // a CALL scrutinee (`match lex_from(..., buf, ...)`) infers
      // normally so its own-param moves record (the splice scanners'
      // false unconsumed, healed by the shared shape gate).
      infer_borrowed_read(scrutinee)
      // The arms meet in a result cell the judgment mints, and the match
      // node reads it, as an if's node reads its branches: an arm unified
      // into the node itself made the node the class's root, carrying the
      // reason the parser minted it with.
      let result_h = mint(Located(span, Inferred("match result")))
      infer_match_arms(arms, scrutinee, result_h, handle, span)
      graph_bind(
        handle,
        TVar(result_h),
        Located(span, MatchBranch(Inferred("arm body"), Inferred("result")))
      )
    },
    NExpr(MakeListExpr(elems)) => {
      infer_expr_list(elems)
      // The literal allocates its header even empty — the charge covers
      // both branches (construction_row's law).
      inf_add_row_at(handle, construction_row())
      if len(elems) == 0 {
        let elem_h = mint(Inferred("empty list element"))
        graph_bind(handle, TList(TVar(elem_h)), Located(span, Inferred("empty list")))
      } else {
        let fh = last(elems)
        unify_list_elems(drop_last(elems), fh, span)
        graph_bind(handle, TList(TVar(fh)), Located(span, Inferred("list literal")))
      }
      // H4.1: list elements may carry inner-region pointers; join.
      tag_alloc_join(handle, elems)
    },
    NExpr(MakeTupleExpr(elems)) => {
      infer_expr_list(elems)
      // A product is a RECORD only where it escapes: one a consumer takes
      // apart where it is built — a positional destructure, the N-ary stage
      // a `|>` fills — is its parts in registers, which is what its `let`
      // spelling costs (`product_fate`, graph.mn; the lowering reads the same
      // facts, `destructure_subs` and `product_fills_stage`, to bind them).
      charge_product(handle)
      graph_bind(handle, TTuple(collect_tvar_types(elems)), Located(span, Inferred("tuple literal")))
      tag_alloc_join(handle, elems)
    },
    NExpr(IndexExpr(receiver, index)) => {
      // Per #139 — semantic subscript. Infer receiver + index; the result
      // chases the receiver's element. Force = UNIFY, never overwrite
      // (seq_force's own law, one table over): the old graph_bind here
      // DISCARDED the receiver's proven TList(elem) and orphaned a fresh
      // element class per subscript — the union-find FRACTURE that forced
      // the monomorphization free-leaf rule (probe-pinned 2026-07-22:
      // merge's condition subscripts rooted apart from its own param
      // element; unifying collapses them to ONE class). A TList force on a
      // proven-String receiver is SATISFIED (§4① — a String IS a
      // sequence); its element is the byte. Tuple-const-index /
      // record-int-key remain the named peer Hβ.infer.index-expr-dispatch.
      // An INDEX READ is a borrow — the read-is-a-borrow law's fourth
      // surface beside the if condition, the match scrutinee, and the
      // field receiver: xs[i] reads an element without moving xs, so an
      // `own` list indexed then passed onward is one consume, not two
      // (measured: the fan's join arm read recs[jn] before threading
      // recs, and the ledger demanded restructuring provably-safe code —
      // the Hylo-quiet bar naming the inference gap).
      infer_borrowed_read(receiver)
      infer_expr(index)
      let exp_i = mint(Inferred("index value"))
      graph_bind(exp_i, TInt, Located(span, Inferred("index value")))
      unify(index, exp_i, span, Inferred("index value"))
      // Tuple-const-index — the judge's half of the dispatch lower
      // already performs (its LFieldLoad prefix-sum): a receiver
      // CHASED to a tuple, indexed by a literal, types as that
      // position's element (SYNTAX §Indexing's compile-time
      // extraction, H6 bounds at the judgment). The read is the
      // SHALLOW root binding (graph_chase — one union-find walk,
      // no deep fold: chase_deep_at mid-inference tripped its own
      // depth belt on the wheel's unconverged chains, measured at
      // the m3 leg). A FREE receiver (a generic body's param)
      // still takes the list force — the open POSITIONAL demand
      // (TRecordOpen's tuple sibling) is the named remainder of
      // Hβ.infer.index-expr-dispatch; a literal-indexed tuple in
      // a generic body destructures until it lands.
      match index_receiver_shallow(receiver) {
        TTuple(elems) => match graph_node_body(index) {
          NExpr(LitInt(k)) => if k >= 0 && k < len(elems) {
            graph_bind(handle, list_index(elems, k), Located(span, Inferred("tuple element")))
          } else {
            // H6 at the judgment: the literal names a position the
            // product does not have — expected arity vs the index.
            report(EConstructorArity("tuple index", len(elems), k, span))
            graph_bind(
              handle,
              TVar(mint(Inferred("tuple index out of range"))),
              Located(span, Inferred("tuple index out of range"))
            )
          },
          // a runtime-variable index cannot type a heterogeneous
          // product — the list force below reports the honest mismatch
          _ => infer_index_force(receiver, index, handle, span),
        },
        _ => infer_index_force(receiver, index, handle, span),
      }
    },
    NExpr(MakeStringExpr(fragments)) => {
      // A splice fragment keeps ITS OWN inferred type (SYNTAX Strings:
      // "a {expr} splice carries the spliced node's type"); rendering is
      // the structural show at lower/emit. The old unify_string_fragments
      // bound every fragment to String — a fabrication that clobbered an
      // Int splice's truth, split the emit's show dispatch (VarRef dodged
      // through its binding-time handle; a literal read the clobber and
      // emitted BARE — Hβ.emit.int-splice-empty's judge half), and would
      // refuse "{3}" outright if unify were strict. Deleted whole.
      infer_expr_list(fragments)
      // The interior-concat cells, minted ONCE here (the concat-key
      // dossier's settled design): lower's fold reads them from the
      // boundary column instead of minting per run — every
      // program-derived key collides with a call-keyed handle in its
      // own subtree, and a judge mint is trailed and reproducible.
      // The count mirrors lower's elision (empty literals drop).
      let cells = interp_concat_cells(fragments, span)
      graph_boundary_set(handle, InterpBoundary(cells))
      // Each interior concat IS a call to the byte-sequence concat, so the
      // interpolation calls it as `++` calls its own, and carries its row.
      if len(cells) > 0 { sugar_calls(handle, handle, interpolation_callee()) } else { () }
      graph_bind(handle, ty_string, Located(span, Inferred("string interpolation")))
    },
    NExpr(ShowExpr(inner)) => {
      // The splice's structural show as a judged node (γ's splice
      // half): the inner keeps its own inferred type — the show
      // accepts ANY type by construction (the dispatch is emit's
      // structural read) — and the node itself IS a String, the
      // handle lower's LShow reads instead of minting a cell. The show
      // reads the inner's whole structure.
      infer_expr(inner)
      shape_demand(inner, WholeShape)
      // The show builds the string it answers. A String splice answers
      // itself and builds nothing, so this charges one case the emit does
      // not allocate for — sound, and the only over-charge in the rule.
      inf_add_row_at(handle, construction_row())
      graph_bind(handle, ty_string, Located(span, Inferred("splice show")))
    },
    NExpr(MakeRecordExpr(fields)) => {
      // Each field's value is inferred; the record's type is
      // TRecord((field_name, TVar(value_handle))) sorted by name.
      // Parser already sorted; lower / emit honor the same order.
      infer_record_field_values(fields)
      inf_add_row_at(handle, construction_row())
      let field_types = build_record_field_types(fields)
      graph_bind(handle, TRecord(field_types), Located(span, Inferred("record literal")))
      // H4.1: record fields may carry inner-region pointers; join.
      tag_alloc_join(handle, record_field_handles(fields))
    },
    NExpr(RecordUpdateExpr(base, overrides)) => {
      // {...base, f: v} — a new record: the fields it writes, then a copy of
      // the base past them. The base MUST be record-shaped — the same
      // open-record constraint field access erects, so `{...5, f: v}` is a
      // type error at the spread, never a zero-field fabrication — and the
      // copy is the base's row without the written names (`rows_copy`): a
      // field the base holds under a written name is replaced, whatever its
      // type, and every other field is kept, including those not known
      // where the update is judged.
      infer_expr(base)
      let written = build_record_field_types(overrides)
      let names = map(field_name, written)
      let base_row = graph_fresh_row(Inferred("the row an update copies"))
      let expected_h = mint(Inferred("record update base"))
      graph_bind(expected_h, mk_record_open([], base_row), Located(span, Inferred("expected record")))
      unify(base, expected_h, span, Inferred("record spread base"))
      let copy = graph_fresh_row(Inferred("the copy past an update's fields"))
      // The copy reads each field of the base by name, and lays out the
      // record it builds by the fields the copy holds.
      shape_demand(base, OuterShape)
      infer_record_field_values(overrides)
      inf_add_row_at(handle, construction_row())
      graph_bind(handle, mk_record_open(written, copy), Located(span, Inferred("record update")))
      shape_demand(handle, OuterShape)
      rows_relate(base_row, copy, names, span, Inferred("record update"))
      tag_alloc_join(handle, record_field_handles(overrides))
    },
    NExpr(NamedRecordExpr(head, fields)) => {
      // A nominal record literal: the head names a record type, whose
      // declared fields the literal's are checked against, and the head —
      // a reference to that type — is the type it names.
      infer_record_field_values(fields)
      inf_add_row_at(handle, construction_row())
      let head_span = graph_span_of(head)
      match graph_node_body(head) {
        NExpr(VarRef(type_name)) => match ref_resolve(type_name, head) |> and_then(graph_published) {
          None => report(EMissingVariable("record type: {type_name}", head_span)),
          Some(entry) => match entry {
            (_, _, kind) => match kind {
              RecordSchemeKind(declared) => {
                check_nominal_record_fields(declared, fields, type_name, span)
                graph_bind(
                  head,
                  TName(type_name, []),
                  Located(head_span, Inferred("the record type '{type_name}'"))
                )
                graph_bind(handle, TName(type_name, []), Located(span, Inferred("nominal record literal")))
              },
              _ => report(ENotARecordType(type_name, head_span)),
            },
          },
        },
        _ => report(ENotARecordType("a head that names no type", head_span)),
      }
      tag_alloc_join(handle, record_field_handles(fields))
    },
    NExpr(ResumeExpr(val, state_updates)) => {
      // Typed-resume law (SYNTAX §Effect declarations): inside
      // `op(args) => body` for `op : (P...) -> R` under a handler
      // whose handle-result is S, `resume : R -> S`. The value flows
      // to the perform site (v unifies with R); the expression's own
      // value is the continuation's completion (S).
      infer_expr(val)
      match inf_arm_tys() {
        Some((continuation_h, declared)) => match graph_chase(continuation_h) {
          GNode(NBound(TCont(resume_input, answer, disc, world)), _) => {
            let r_h = mint(Inferred("op result at resume"))
            graph_bind(r_h, resume_input, Located(span, Inferred("resume carries the continuation input")))
            unify(val, r_h, span, Inferred("resume carries the continuation input"))
            // The op's declared return is a contract every resumed value
            // owes, claimed here in the arm's frame as a declared field's
            // is at every construction, so a performer stands on it as on
            // a declared function's return: a refinement it states is
            // decided of the value, a label's absence is owed, and a
            // function demanding more than the declared type provides
            // pays its guard here, where the performer, reading the
            // declaration, cannot. The continuation's cell holds the
            // shape, so the contract is the declaration the arm read.
            claim_refinement(declared, val, span)
            graph_bind(handle, answer, Located(span, Inferred("resume yields the continuation answer")))
            // A HELD continuation is a record this resume CALLS, so its
            // remainder runs here, inside whatever frame holds the resume —
            // the arm, or a lambda the arm hands to a callee, whose extent
            // then contains everything the remainder performs. The resume
            // performs its world. `fn apply(f) with !IO = f() + 0` accepted
            // `apply(() => resume(1))` while the remainder printed inside
            // apply (measured 2026-10-01, boot 477bb667): a resume charged
            // nothing, so the callback's row was Pure and apply's gate had
            // nothing to judge. The record's world is its own segment rooted
            // on the world the resume stands in, copied where the resume
            // enters it from a world other than the one its install caught
            // it in, so a held resume also builds. A stack return runs the
            // remainder after the arm returns, outside every frame here, and
            // charges nothing.
            if continuation_held(disc) {
              inf_add_row_at(handle, world)
              inf_add_row_at(handle, construction_row())
            } else {
              ()
            }
          },
          _ => report(EUnresolvedType(continuation_h, graph_epoch(), span)),
        },
        // resume outside any arm — parse admitted it; surface the
        // structural fact rather than fabricating a type.
        None => report(EResumeOutsideArm(span)),
      }
      // State updates: each `with name = expr` EVOLVES the handler state, so the
      // update's type MUST unify with the state field's type (carried in arm
      // scope as TVar(init_handle) by bind_handler_state_names). DROPPING them —
      // as this arm did — leaves the field at ONLY its init type: an empty-list
      // init stays List(?free), and a later `state_field.field` read on that free
      // element is exactly the lower_scope ls_push_scope trap (resolve_field_offset
      // returns -1 → unreachable). Carry the update's type into the field; never
      // discard what the graph could prove (Carried-Truth).
      // The field an update writes is the edge its name drew where the handler
      // bound its states (`link_update`); the name's node is the field's cell
      // where the update is written.
      each(
        (upd) => {
          infer_expr(state_field_init(upd))
          let uh = state_field_init(upd)
          let nh = state_field_node(upd)
          match graph_ref_decl(nh) {
            Some(field) => match graph_published(field) {
              Some((scheme, reason, _)) => {
                let fty = instantiate(scheme)
                graph_bind(nh, fty, Located(graph_span_of(nh), VarLookup(state_field_name(upd), reason)))
                unify(uh, nh, span, Inferred("resume state update carries the state field's type"))
                // The commit stores into the install's record: its claim is
                // on the state field it names.
                match fty {
                  TVar(sb) => ages_store_binder(sb, [uh]),
                  _ => demand_move(uh),
                }
              },
              None => (),
            },
            None => (),
          }
        },
        state_updates
      )
    },
    // `a.b` is structural field access on the record `a`'s type, read
    // live from the graph. A qualified `module.name` reference resolves
    // by following the import edge to the module env node (SYNTAX.md
    // §Imports) — never a flattened `module.name` env key (Carried-Truth:
    // the dotted-string lookup was the canonical re-derivation, now
    // deleted with its write side; edge-following overlay = peer
    // Hβ.driver.per-module-env-overlay).
    NExpr(FieldExpr(rec, field)) => infer_field_access_record(rec, field, handle, span),
    NExpr(LambdaExpr(params, body_node)) => {
      // Minting the closure allocates its record, in the frame that mints
      // it — every lambda the lowering does not inline into a `<~` cycle.
      // `!Alloc` accepted a lambda minted per call (16 bytes with one
      // capture, 8 with none, measured 2026-09-28).
      inf_add_row_at(handle, construction_row())
      infer_lambda(params, body_node, handle, span, BoundByCallers, MintedHere)
    },
    // Branching verbs install affine-ledger snapshots around their
    // sub-infers so parallel branches cannot silently consume the
    // same own-name. Non-branching verbs use the straight-through
    // infer-both-sides / then-infer_pipe pattern.
    NExpr(PipeExpr(kind, left, right)) => match kind {
      PFanout(fan_own) => infer_fanout(fan_own, left, right, handle, span),
      PForward => {
        infer_expr(left)
        infer_stage(right, pipe_stage_arity(left))
        infer_pipe(kind, left, right, handle, span)
      },
      PTee => infer_pipe_tee(left, right, handle, span),
      PFeedback => {
        // A recurrence lambda is inlined into the cycle, so it is judged as a
        // lambda and charged no mint; any other left side is an ordinary value.
        match inlinable_lambda(left) {
          Some((params, body)) => infer_lambda(params, body, left, graph_span_of(left), BoundByTheCycle, AppliedInPlace),
          None => infer_expr(left),
        }
        // The spec stays a VALUE — `infer_pipe` checks it as a FeedbackSpec —
        // but its construction never executes: the depth is read at lower
        // (lower.mn's feedback_line_depth) and emit drops the lowered spec. So it is
        // judged in a frame of its own whose row is dropped, never charged to
        // this one. Measured 2026-09-25: `((prev) => ramp(prev)) <~ Delay(3)`
        // under `!Alloc` refused with `!Alloc + Any vs Memory + Alloc`, the
        // constructor charging an allocation that never happens; with
        // E_EffectMismatch armed that false charge became a false REFUSAL of
        // tests/micros/mn-feedback-iir, which is what closed it. This is
        // branch A of the fork banked under Hβ.effects.feedback-row-substitutes;
        // branch B — the RHS as a static depth annotation, the lowering
        // deleted — stays open and would delete this frame with it.
        let spec_row_h = graph_fresh_row(Inferred("feedback spec — static, its row never charges"))
        inf_enter_fn(spec_row_h, span, [])
        infer_expr(right)
        exit_frame()
        infer_pipe(kind, left, right, handle, span)
        // Each tick stores the output into a ring its record owns, which an
        // arena opened inside the record's life outlives, so the arena's
        // barrier reads the output as a move.
        shape_demand(handle, MovedShape)
        tick_mutation(handle)
      },
    },
    NExpr(FanoutExpr(branches)) => infer_fanout_nary(branches, handle, span),
    // the cover-grammar rest outside its one legal home (a
    // destructuring lambda parameter, where expr_to_pat consumed it):
    // loud refusal, handle left free — productive-under-error.
    NExpr(RestExpr(_)) => report(ERestOutsideDestructure(span)),
    // ? — handle already NFree at parse
    NExpr(ExprPlaceholder) => (),
    // A labeled call arg is resolved to positional by resolve_call_args
    // BEFORE infer_expr ever sees it; reaching here means a LabeledArg leaked
    // outside a call's arg list. Locate it (productive-under-error) rather
    // than fabricate a type — the no-silent-fallback law over a load-bearing
    // node-kind.
    NExpr(LabeledArg(label, _)) => report(EUnknownArgLabel("labeled argument `{label} = …` is only valid in a call's argument list", span)),
    // Hazel marked hole — inference leaves NFree
    NHole(_) => (),
    // statement at expression position — parser
    // should have wrapped in ExprStmt; no-op
    // is the safe fallback
    NStmt(_) => (),
    // pattern at expression position — degenerate;
    // parser emits in match-arm contexts only
    NPat(_) => (),
    // the synthetic per-file module handle at
    // expression position — degenerate; NModule
    // is never itself an expression node
    NModule(_) => (),
    NLink(_) => (),
    NRow(_) => (),
    // an authored type annotation at expression
    // position — degenerate; NTypeAnn is read
    // directly by return-type/let-annotation call
    // sites, never reached through infer_expr
    NTypeAnn(_) => (),
    // a row's name is linked where its row is judged, an arm's op where its
    // handler is
    NName(_) => (),
    // a parameter is judged by the declaration that holds it
    NParam(_) => (),
  }
}

// Factored out of the `FieldExpr` match arm so the qualified-name
// fallback path (modules-as-env-entries) can share this without
// duplication. The record-open unification is unchanged from its
// original arm form.
//
// THE READ-SHAPE PROJECTION — the read-is-a-borrow law's ONE shape test,
// shared by all four borrow surfaces (if condition, match scrutinee,
// index receiver, field receiver). A READ SHAPE is decision arithmetic —
// a VarRef, field/index access rooted in one, a literal, or unary/binop
// composition of those (`buf != 0`, `a.n < b.n`): reading it decides or
// projects without moving anything. A CALL is NOT a read shape — its
// arguments follow the CALLEE'S param product (a declared/inferred ref
// borrows via the call-arg-borrow law; an own param genuinely moves), so
// bracketing a call here suppressed real consumes into own params AND
// would silence a real double-move (`if take(buf) > 0 { take(buf) }` —
// the old blanket condition-borrow was unsound, not merely noisy; the
// relevant tier made the suppressed consume REPORTABLE and two
// splice-scanner owns fired falsely through exactly this hole). The
// field site carried the call narrowing from its birth; the other three
// surfaces now read the same projection — the uniform pass replacing
// the per-site family.
fn is_read_shape(node) = match graph_node_body(node) {
  NExpr(VarRef(_)) => true,
  NExpr(FieldExpr(recv, _)) => is_read_shape(recv),
  NExpr(IndexExpr(recv, _)) => is_read_shape(recv),
  NExpr(LitInt(_)) => true,
  NExpr(LitFloat(_)) => true,
  NExpr(LitString(_)) => true,
  NExpr(LitBool(_)) => true,
  NExpr(LitUnit) => true,
  NExpr(UnaryOpExpr(_, inner)) => is_read_shape(inner),
  NExpr(BinOpExpr(_, l, r)) => is_read_shape(l) && is_read_shape(r),
  _ => false,
}

// The borrow bracket, shape-gated: a read shape infers borrowed; any
// other expression infers normally (its own moves record).
fn infer_borrowed_read(node) = if is_read_shape(node) {
  borrow_enter()
  infer_expr(node)
  borrow_exit()
} else {
  infer_expr(node)
}

// Reading `.field` borrows the receiver — it never moves the record;
// the shared read-shape projection gates the bracket.
fn infer_field_access_record(rec, field, handle, span: ValidSpan) = {
  infer_borrowed_read(rec)
  let field_h = mint(Inferred("field type"))
  let row_h = graph_fresh_row(Inferred("record row"))
  let expected = mk_record_open([(field, TVar(field_h))], row_h)
  let expected_h = mint(Inferred("record access"))
  graph_bind(expected_h, expected, Located(span, Inferred("expected record")))
  unify(rec, expected_h, span, Inferred("field access"))
  // The load's offset reads which fields the receiver's row holds.
  shape_demand(rec, OuterShape)
  graph_bind(handle, TVar(field_h), Located(span, Inferred("field type")))
}

// Instantiate the scheme from env, bind the handle, then consume
// if the binding is an `own` parameter. The affine-ledger handler
// in `own.mn` decides which names are own-marked; `check_consume_at_use`
// performs unconditionally and lets the handler decide.
// How a reference is used: as a call's callee, or as a value. A
// constructor or op name in VALUE position is the parameter product with
// every field unsupplied (SYNTAX §«Partial application» — a bare name IS the
// name applied to nothing), so its judgment writes that product; a callee
// reference writes nothing, the call's product being the call node's.
type RefUse = RefCalled | RefValued

// A call's callee, judged as the reference it is (`RefCalled`); every other
// callee expression is judged as the value it is.
fn infer_callee(func) = match graph_node_body(func) {
  NExpr(VarRef(name)) => infer_var_ref(name, func, graph_span_of(func), RefCalled),
  _ => infer_expr(func),
}

// A bare constructor or op reference's product: no arguments, one cell per
// slot, so the partial the lowering mints for it reads each open slot at its
// own width. A nullary constructor's reference is the value itself, not an
// arrow, and writes none.
fn bare_reference_product(handle, ty, span: ValidSpan) = match ty {
  TFun(ps, _, _) => graph_product_note(handle, [], open_slot_cells(ps, 0, span), CallSuspended),
  _ => (),
}

fn infer_var_ref(name, handle, span: ValidSpan, use) = match ref_resolve(name, handle) {
  None => {
    report(EMissingVariable(name, span))
    // The miss IS the fact — poison, never a normal-looking var. The old
    // TVar(handle) self-bind tripped graph_bind's own occurs check (a
    // spurious 0:0 E_OccursCheck per missing name) and read downstream as
    // an unconstrained var (the ownership move-default false positives).
    // A hole no-ops in unify, preserves the handle through generalize, and
    // keeps every consumer silent: one miss, one diagnostic.
    graph_bind_hole(handle, Located(span, MissingVar(name)))
  },
  Some(decl) => {
    // F0b (2026-09-27): a name that resolves only because the whole link
    // carries it — declared in a module this reference's module never
    // imports — refuses HERE, at the reference. The declarer is the module
    // its declaration was born in; a local binder is born in the
    // reference's own module, and a primitive in the prelude, which every
    // module reaches.
    let rm = graph_module_of(handle)
    let dm = graph_module_of(decl)
    if dm != rm && !inf_module_reaches(rm, dm) {
      report(EMissingImport(name, module_name_of_handle(rm), module_name_of_handle(dm), span))
    } else {
      ()
    }
    match graph_published(decl) {
      Some((scheme, reason, kind)) => judge_reference(name, handle, span, use, scheme, reason, kind),
      None => graph_bind_hole(handle, Located(span, MissingVar(name))),
    }
  },
}

// THE REFERENCE LINK (M1): the one place a name resolves, so the one place a
// reference is joined to what declares it. A reference already linked
// answers its link — an install's handler side is resolved before the body
// it governs is judged (`install_decl`) — and every reader after this follows
// the link and never resolves the name again.
fn ref_resolve(name: String, handle) = match graph_ref_decl(handle) {
  Some(decl) => Some(decl),
  None => match env_resolve(name) {
    Some(decl) => {
      graph_ref_link(handle, decl)
      Some(decl)
    },
    None => None,
  },
}

// A resolved reference judged against what its declaration published.
fn judge_reference(name: String, handle, span: ValidSpan, use, scheme, reason, kind) = {
  // A seq-op MENTION types as its FACE, never the raw body's scheme (the
  // substrate boundary: list_set's `l + 8` types l Int, and only the op's
  // own body may read that; the saturated and holed CALL paths already
  // force the face — the bare mention was the last raw-scheme leak,
  // measured as `xs |> len` unifying List against Int while emitting
  // correctly, the 3.3 false-diagnostic drift). The row stays the callee's
  // own declared row.
  let ty = if reaches_substrate(handle) { seq_face_ty(name, scheme) } else { instantiate(scheme) }
  graph_bind(handle, ty, Located(span, VarLookup(name, reason)))
  // Carry parameter ownership from the declaration into Consume. No
  // recovery lookup: SchemeKind names the binding's construction origin.
  check_consume_at_use(name, kind, span)
  match use {
    RefCalled => (),
    RefValued => match kind {
      ConstructorScheme(_, _) => bare_reference_product(handle, ty, span),
      EffectOpScheme(_, _, _, _) => bare_reference_product(handle, ty, span),
      _ => (),
    },
  }
}

fn seq_face_ty(name: String, scheme) = {
  let elem = TVar(mint(Inferred("sequence element")))
  match seq_op_sig(name, elem) {
    Some(sig) => match sig {
      (ptys, ret) => match instantiate(scheme) {
        TFun(_, _, crow) => TFun(build_ctor_params(ptys, 0), ret, crow),
        // a seq-op whose scheme is not fn-shaped keeps its own read
        other => other,
      },
    },
    // the two tables enumerate the same names; productive if they diverge
    None => instantiate(scheme),
  }
}

// A NAMED callee that resolved to nothing — the shape whose parameter
// product the move-vs-borrow read cannot ground: a reference the judgment
// could not link (`infer_var_ref`). Param-position and lambda callees have
// resolvable schemes and keep normal inference; only the VarRef-with-no-link
// shape borrows its direct args (the miss already reported once).
fn callee_missing_in_env(ref func) = match graph_node_body(func) {
  NExpr(VarRef(_)) => graph_ref_decl(func) == None,
  _ => false,
}

// The authored-own declarations of one signature, in the body's own
// consume frame. A `ref` or unmarked param declares nothing: only an
// authored `own` is a promise to finish.
fn declare_authored_owns(ref params, span: ValidSpan) = params |> each((p) => match param_marker(p) {
  Own => match pat_of(param_pat(p)) {
    PVar(n) => consume_declare(n, span),
    PAs(n, _) => consume_declare(n, span),
    PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) => (),
  },
  Ref => (),
  Unmarked => (),
})

fn check_consume_at_use(name, kind, span: ValidSpan) = match kind {
  ParamScheme(authored) => consume(name, authored, span),
  _ => consume(name, Unmarked, span),
}

// RX.4 — extract callee name from func node for Why chain.
fn callee_name(func_node) = match graph_node_body(func_node) {
  NExpr(VarRef(name)) => name,
  NExpr(FieldExpr(_, field)) => field,
  // A config handler `~> h(args)` is a CallExpr; the handler's name IS
  // the callee. Recurse so handler_e_r resolves its HandlerKind and the
  // residual row applies — without this every config handler
  // (map_collector(f), fold_handler(f,init)) silently loses its arm effects.
  NExpr(CallExpr(callee, _)) => callee_name(callee),
  _ => "<expr>",
}

// A callee's declared parameters, read off the callee NODE's own type — the
// product a call resolves its labels and defaults against. Whatever the
// callee expression is (a name, a field, a call's result), the judgment
// bound its node before the arguments are read, and that binding is the one
// home: a parameter or a field callee carries ITS type, never a module
// function's that shares the name (`fn run(f) = f(7)` beside a two-parameter
// top-level f with a default spliced that default into the callback's
// call, measured 2026-09-30 on boot 523f1732). [] when the node is not a
// function type: no labels to resolve, the arguments pass through
// positionally.
fn callee_params_at(fh) = match lookup_ty(fh) {
  TFun(params, _, _) => params,
  _ => [],
}

// is_seq_op — the names of the sequence node-kind's projections. A sequence is
// ONE kernel node-kind (§4①); these are the cursor reading or building it.
// Routed to `infer_seq_op` so each types by the ELEMENT, never by its
// `load_i32`/`alloc` substrate body (whose inferred type erases `[a]` to `Int`
// — the value-ontology violation that poisoned the whole compiler's list
// handling). Strings are `[byte]`: `byte_at` IS `list_index`, `byte_len` IS
// `len`, `str_concat` IS `list_concat` — the same projections over a different
// element, so the string ops route here too (the §IX four-set unification).
// cname pins : String — the Intent Boundary that proves ALL sixteen `==`
// below STRUCTURAL (str_eq), not the pointer-eq i32.eq an unproven operand
// floors to. Unproven, whether `len` was recognized as a sequence op was a
// LAYOUT LOTTERY (interned "len" in the data section vs the heap cname from
// the token): m2's allocation happened to recognize it, m3's did not, so
// m3 routed `len(argv)` through the normal path, mistyped the compare, and
// `len(argv) < 2` emitted `list_compare` — m3 dispatched every stdin
// compile (incl. the wheel → m4) to CLI help. The mint_params handle-bind
// (this session) is what makes this pin propagate. The by-name fork itself
// is drift-8; its ultimate dissolution — the seq ops carry authored
// signatures (`len(xs: [a]) -> Int`) so inference reads the signature not
// the load_i32 word-idiom body, retiring is_seq_op — is the named peer
// Hβ.infer.seq-op-signature-driven (DEP Hβ.infer.authored-typaram-rigid).
//
// The SUBSTRATE primitives only — their bodies do pointer arithmetic
// (load_i32(list + 4)) that erases [a] to Int, so inference reads the element
// type here instead (the value-ontology boundary, §4①, named peer
// Hβ.value.repr-projection-primitives). The FUNCTORS are GONE from here: they
// DERIVE their own types from their bodies now that Iterate.result returns the
// handler-delivered value (result() -> r, prelude.mn) instead of a fabricated
// (). Zero re-derivation — the type is read from the one place it lives.
// A primitive's face belongs to its declaration: a reference takes it along
// the edge that reaches the primitive — a module-level declaration of a name
// in the table — and a parameter, a local or a nested fn sharing that name is
// judged as itself.
fn reaches_substrate(ref_h) = match graph_ref_decl(ref_h) {
  Some(d) => at_module_level(d) && is_seq_op(callee_name(ref_h)),
  None => false,
}

fn is_seq_op(cname: String) with Pure = cname == "len" || cname == "list_index" || cname == "last" || cname == "drop_last" || cname == "list_set" || cname == "list_concat" || cname == "list_to_flat" || cname == "make_list" || cname == "slice" || cname == "push" ||
// The String-builder half of the same boundary: int_to_str assembles a
// [len][bytes] record by address arithmetic (a word), and the table
// projects the String its consumers read — the §4① seam at the text face.
cname == "int_to_str" ||
// The Option-of-handle niche's READ (types.mn slot_present): typed
// `a -> Bool` here so a presence test never pins its operand's element
// type; the raw body compares the word.
cname == "slot_present" ||
// The show/hash surfaces: lower intercepts both names into structural
// LShow/LHash nodes (emit-dispatched), so the table carries their
// generic faces (a -> String, a -> Int) and the raw bodies never run.
cname == "to_string" || cname == "hash" ||
// The String face of the sequence node-kind (the comment above: byte_at IS
// list_index, byte_len IS len). Typed here so consumers holding a String
// type against the projection, never the load_i32 word-idiom body — the
// exact list_index pattern (self-consistent raw body, typed calls).
cname == "byte_len" || cname == "byte_at" ||
// The String BUILDERS: their bodies alloc a [count][tag][bytes] record and
// return its address (self-consistent inside, the int_to_str pattern);
// typed here so the projected RESULT is the String consumers read, never the
// raw buffer. str_payload is the reader that resolves a String to the
// address of its contiguous stride-1 payload — String in, address out (the
// WASI materialization boundary; the seq-addr down-cast in table form).
cname == "str_slice" || cname == "str_concat" || cname == "str_of_single_byte" || cname == "str_payload" || cname == "str_of_buf" || cname == "float_to_str" || cname == "float_zero_pad" || cname == "float_format_fixed" || cname == "float_format_scientific" || cname == "float_render_positive" || cname == "float_digits_to_str"

// seq_force — bind the i-th argument's type to `ty` (a no-op past the end).
// `graph_bind` on a VarRef handle propagates to the bound variable (the same
// mechanism the `xs[i]` IndexExpr arm uses to force its receiver).
fn seq_force(ah, i, ty, span: ValidSpan) = if len(ah) > i {
  // Force = UNIFY, never overwrite. graph_bind would DISCARD the arg's proven
  // type (a Carried-Truth violation — `fold([], …)` loses that `[]` is a list,
  // so the accumulator var never learns `[a]`); unify unions the arg's root
  // with the expected type, reading BOTH truths and propagating structurally
  // into a lambda's params / an empty literal's element.
  //
  // §4① made total: a String IS its byte-list alias, so a TList-shaped
  // force unifies through the peel and `len(name)` on a String is
  // canonical with no receiver probe — the sentinel special-case this
  // replaces guarded a nullary Ty that no longer exists.
  let expected = mint(Inferred("sequence operand"))
  graph_bind(expected, ty, Located(span, Inferred("sequence operand")))
  unify(list_index(ah, i), expected, span, Inferred("sequence operand"))
} else {
  ()
}

// The sequence node-kind's projections — typed by the element, the cursor
// reading or building a sequence. A sequence is `[a]`; the i32 pointer is
// substrate BELOW the type. These REPLACE the load_i32 library typing: the
// body is what `lower` emits (the rope walk, the offset load), the TYPE is THIS
// projection. One fresh `a` per call binds the receiver(s) to `[a]`, indices to
// `Int`, values to `a`. `lower` still calls the lib fns; only their TYPE moves
// here, to the node-kind that owns it.
// The substrate FACE table — ONE home for every seq-op's typed signature
// (params, result) over a caller-minted element var. Both readers derive
// from it: the saturated fast path forces each argument position against
// its face type (infer_seq_op below), and a HOLED/under-applied call
// builds its product-with-holes from the same face (infer_call) — the env
// scheme is the RAW body's (list_set's `l + 8` types l Int) and must
// never type a caller (the lib-first order made that scheme visible and
// every `|> list_set(??, …)` pipe mismatched — 14 wheel sites). A
// position typed by a fresh var (seq_unconstrained) is deliberately
// unconstrained: the presence test (slot_present) reads any slot's word.
fn seq_op_sig(cname: String, elem) = match cname {
  "last" => Some(([TList(elem)], elem)),
  "list_index" => Some(([TList(elem), TInt], elem)),
  "int_to_str" => Some(([TInt], ty_string)),
  // The String face: byte_at IS list_index over [byte], byte_len IS len.
  "byte_len" => Some(([ty_string], TInt)),
  "byte_at" => Some(([ty_string, TInt], TInt)),
  "str_slice" => Some(([ty_string, TInt, TInt], ty_string)),
  "str_concat" => Some(([ty_string, ty_string], ty_string)),
  "str_of_single_byte" => Some(([TInt], ty_string)),
  // str_payload resolves a String to the address of its contiguous stride-1
  // payload; str_of_buf is the way back, a filled buffer's address read as
  // the String it holds.
  "str_payload" => Some(([ty_string], TAddr)),
  "str_of_buf" => Some(([TAddr], ty_string)),
  "float_to_str" => Some(([TFloat], ty_string)),
  "float_render_positive" => Some(([TFloat], ty_string)),
  "float_zero_pad" => Some(([TInt], ty_string)),
  "float_format_fixed" => Some(([TList(TInt), TInt], ty_string)),
  "float_format_scientific" => Some(([TList(TInt), TInt], ty_string)),
  "float_digits_to_str" => Some(([TList(TInt), TInt, TInt], ty_string)),
  "slot_present" => Some(([seq_unconstrained()], TName("Bool", []))),
  "to_string" => Some(([seq_read_whole()], ty_string)),
  "hash" => Some(([seq_read_whole()], TInt)),
  "len" => Some(([TList(elem)], TInt)),
  "drop_last" => Some(([TList(elem)], TList(elem))),
  "list_set" => Some(([TList(elem), TInt, elem], TList(elem))),
  "push" => Some(([TList(elem), elem], TList(elem))),
  "slice" => Some(([TList(elem), TInt, TInt], TList(elem))),
  "list_concat" => Some(([TList(elem), TList(elem)], TList(elem))),
  // Flatten is representation-only: type-preserving [a] -> [a] (flat_raw is
  // its raw altitude; a raw-typed list_to_flat poisoned iterate's element).
  "list_to_flat" => Some(([TList(elem)], TList(elem))),
  "make_list" => Some(([TInt], TList(elem))),
  _ => None,
}

fn seq_unconstrained() = TVar(mint(Inferred("unconstrained substrate operand")))

// The show and hash faces' operand: any type, read whole — the demand is the
// primitive's own typing rule, so it reaches the argument at a call and the
// callback's parameter where the name is passed as a value.
fn seq_read_whole() = {
  let h = mint(Inferred("structurally read operand"))
  shape_install(h, WholeShape)
  TVar(h)
}

fn seq_force_list(ah, ptys, i, span: ValidSpan) = if i >= len(ptys) {
  ()
} else {
  seq_force(ah, i, list_index(ptys, i), span)
  seq_force_list(ah, ptys, i + 1, span)
}

fn infer_seq_op(cname, fh, args, handle, span: ValidSpan) = {
  let elem = TVar(mint(Inferred("sequence element")))
  match seq_op_sig(cname, elem) {
    Some(sig) => match sig {
      (ptys, ret) => {
        seq_force_list(args, ptys, 0, span)
        graph_bind(handle, ret, Located(span, Inferred("substrate face of '{cname}'")))
        // An in-place store: its claim is on the buffer it writes.
        if cname == "list_set" && len(args) == 3 {
          ages_store(list_index(args, 0), [list_index(args, 2)])
        } else {
          ()
        }
      },
    },
    // A table member with no face row is unreachable by construction
    // (is_seq_op and seq_op_sig enumerate the same names); the floor keeps
    // productive-under-error alive if they ever diverge.
    None => graph_bind(handle, TList(elem), Located(span, Inferred("sequence"))),
  }
  // Hβ.infer.seq-op-row-from-callee RESOLVED (2026-07-24): the callee's OWN
  // declared row, read live — the same Carried-Truth read
  // infer_call_saturated makes. The seq-op family's honest rows
  // (push/slice/list_concat/make_list carry Memory + Alloc, lists.mn) now
  // attribute at every call site. The 2026-07-17 revert's OOM was one
  // representation era stale (measured then on the 559k-line wheel against
  // the 4GB ceiling; the current wheel compiles at ~694MB peak — the
  // re-measurement, not the arena, un-gated this). The Memory floor
  // survives only for an unresolved callee (productive-under-error, the
  // seq_op_sig None floor's twin).
  match graph_chase(fh) {
    GNode(NBound(TFun(_, _, crow)), _) => inf_add_row_at(handle, mutation_masked(fh, crow)),
    _ => inf_add_row_at(handle, mk_ef_closed([ENamed(intern_str("Memory"))])),
  }
  // What the face writes, asked of the arguments it writes.
  ages_mutation_call(handle, fh, args)
}

// What a call's judgment built: the applied result, the product with holes —
// the closure a partial application mints wherever it is not completed in
// place — or a holed substrate call, which the lowering never mints (its pipe
// completes it, and a hole left in value position is refused as a hole). A
// holed form carries the cells typing the slots left open past the
// arguments (`open_slot_cells`), which ride the call node's product.
type CallForm = CallSaturated | CallPartial([Int]) | CallSubstrateHoled([Int])

// Where a call stands. A call at a STAGE — a `|>`'s right side, a `<|`
// branch — is handed the piped value, and where its callee's arrow is not
// yet known the Stage Law fixes its product: the arguments written, then
// the datum's slot. A call at an OPERAND — of `+`, `==`, a unary `-` — can
// be handed nothing later, so an authored `??` among its arguments is a
// VALUE hole the proposer fills under the slot's contract, never the field a
// partial suspends at: `choose(??) + 1` is the applied call, while
// `f(choose(??))` and `let c = choose(??)` keep the suspension (2026-10-13;
// before that the operand form was the product with a hole, and `+` refused
// it as arithmetic on a function).
type CallSite = AtCall | AtStage | AtOperand

fn site_is_operand(site) = match site {
  AtOperand => true,
  AtCall => false,
  AtStage => false,
}

fn form_holes(form) = match form {
  CallSaturated => [],
  CallPartial(cells) => cells,
  CallSubstrateHoled(cells) => cells,
}

// The shape the judgment decided, written on the product for the lowering
// and the gradient to read.
fn form_shape(form) = match form {
  CallSaturated => CallApplied,
  CallPartial(_) => CallSuspended,
  CallSubstrateHoled(_) => CallSuspended,
}

// A call judged where it stands, the closure a partial mints charged to the
// frame that forms it.
fn infer_call_expr(func, args, handle, span: ValidSpan, site) = match infer_call_node(func, args, handle, span, site) {
  // A partial application mints the closure that holds its supplied
  // fields, in the frame that forms it (16 bytes over one literal, and
  // `!Alloc` accepted it, measured 2026-09-28). A pipe's right-hand stage
  // is completed in place and mints nothing, which is why the pipe judges
  // its stage through `infer_call_node` alone.
  CallPartial(_) => inf_add_row_at(handle, construction_row()),
  CallSaturated => (),
  CallSubstrateHoled(_) => (),
}

// An operator's operand: a call standing there is judged at the operand,
// where an argument hole is a value hole; anything else is judged as the
// expression it is.
fn infer_operand(node) = match graph_node_body(node) {
  NExpr(CallExpr(func, args)) => infer_call_expr(func, args, node, graph_span_of(node), AtOperand),
  _ => infer_expr(node),
}

// A call node's judgment, returning which form it built.
fn infer_call_node(func, args, handle, span: ValidSpan, site) = {
  infer_callee(func)
  // The arg list is the callee's positional product: resolve labeled args
  // to positional order and fill absent fields with param defaults, against
  // the parameters the callee NODE carries. The LabeledArg wrappers never
  // reach infer_expr — resolution strips them.
  let cname = callee_name(func)
  let params = callee_params_at(func)
  let pos_args = resolve_call_args(params, args, cname)
  // A named callee that MISSES env already reported (one miss, one
  // diagnostic); its parameter product is unreadable, so the move-vs-
  // borrow read has no ground. Compounding the miss with a move default
  // was the ownership false-positive cascade (`len(buf)` unresolved
  // consuming buf). Borrow the args under the miss; param-position and
  // lambda callees keep normal inference (their schemes resolve).
  if callee_missing_in_env(func) {
    borrow_enter()
    infer_call_arg_list(pos_args, params, 0)
    borrow_exit()
  } else {
    infer_call_arg_list(pos_args, params, 0)
  }
  let form = infer_call(func, pos_args, handle, span, site)
  // The product is a fact of the call node: written once, here, and read
  // by the lowering (the call-product column) — the nodes in declaration
  // order, the cells typing the slots a partial leaves open past them, and
  // the shape decided here, applied or suspended.
  graph_product_note(handle, pos_args, form_holes(form), form_shape(form))
  // H4: constructor calls allocate a heap record. Tag the
  // resulting handle so check_escape at fn return can verify
  // the value doesn't outlive its region. H4.1: constructor
  // ARGS ARE the fields — the resulting record's region pins
  // to the deepest field region.
  if call_is_alloc_returning(func) { tag_alloc_join(handle, pos_args) }
  form
}

fn infer_call(func, args, handle, span: ValidSpan, site) = {
  let cname = callee_name(func)
  // The substrate fast-path fires only for a SATURATED, hole-free call —
  // both facts read live (the hole from the arg's own body, the arity from
  // the callee's declared product) — and for a saturated call at an
  // operand, where the hole is a value. It previously fired on
  // shape-of-name alone, so `list_set(??, i, v)` was typed saturated: the
  // `??` never became the partial the pipe completes, and every seq-op
  // pipe stage mismatched (14 census sites). An under-applied or holed
  // seq-op call is the product-with-holes like any other call.
  if reaches_substrate(func) && (call_hole_index(args, 0) < 0 || site_is_operand(site)) && len(args) == len(callee_params_at(func)) {
    infer_seq_op(cname, func, args, handle, span)
    CallSaturated
  }
  // A HOLED/under-applied substrate call is the product-with-holes built
  // from the FACE (seq_op_sig — the same one home the saturated path
  // forces against), never from the env scheme: the scheme is the raw
  // body's own (list_set's `l + 8` types l Int), and typing a caller's
  // partial from it unified every `|> list_set(??, …)` pipe datum with
  // Int the moment the lib-first order made the scheme visible.
  else if reaches_substrate(func) {
    let elem = TVar(mint(Inferred("sequence element")))
    match seq_op_sig(cname, elem) {
      Some(sig) => match sig {
        (ptys, ret) => CallSubstrateHoled(infer_call_partial(
          args,
          build_ctor_params(ptys, 0),
          ret,
          mk_ef_closed([ENamed(intern_str("Memory"))]),
          handle,
          span,
          cname
        )),
      },
      // A table member with no face row is unreachable by construction
      // (the two enumerate the same names); the floor keeps
      // productive-under-error alive if they ever diverge.
      None => {
        graph_bind(handle, TList(elem), Located(span, Inferred("sequence")))
        CallSaturated
      },
    }
  } else {
    // The single-variant record ctor in the ONE application syntax —
    // `X({...})` (SYNTAX §Constructor calls: same syntax as function calls).
    // The env binds X to its RESULT (TName under RecordSchemeKind), so the
    // plain chase below met a non-arrow and every such call mismatched (29
    // census sites, the tail's biggest root). The ARROW is a VIEW built at
    // the read — the same view the pattern path already builds (infer_pat's
    // RecordSchemeKind arm): one view, two readers; the ordinary saturated
    // machinery does the rest.
    match record_ctor_arrow_view(func, cname, span) {
      Some(vh) => {
        infer_call_saturated(args, vh, handle, span, cname)
        CallSaturated
      },
      // HOLE-COMPLETION (SYNTAX §«Partial application — the product with a
      // hole»): a call whose args leave declaration-order params unfilled — a
      // positional-prefix k<n, or an authored `??` slot — IS the product with
      // holes: its type is the fn of the UNFILLED params. The callee's TParam
      // nodes are reused whole (the param product's identity carries); the row
      // rides the result fn — a partial performs nothing, and forming it
      // mints the closure its caller is charged for. At an operand the `??`
      // is a value hole and the call applies (`CallSite`).
      None => match graph_chase(func) {
        GNode(NBound(TFun(ps, pret, prow)), _) => if len(args) < len(ps) || call_hole_index(args, 0) >= 0 && !site_is_operand(site) {
          CallPartial(infer_call_partial(args, ps, pret, prow, handle, span, cname))
        } else {
          infer_call_saturated(args, func, handle, span, cname)
          CallSaturated
        },
        // A stage whose callee's arrow is not yet known — a field of an
        // unannotated record, a parameter, a forward local. Judged as an
        // ordinary call it read COMPLETE and its result as the function the
        // pipe applies, so `x |> rig.tone(320.0)` typed the field `(Float)
        // -> (Float) -> Float`: the curried reading SYNTAX says the medium
        // has no mechanism for. Pulse's filter field, built `(Hz, Float) ->
        // Float`, was then called with one argument and trapped at the
        // indirect call (2026-10-06).
        _ => match site {
          AtStage => if call_hole_index(args, 0) < 0 {
            bind_stage_product(func, args, span, cname)
            match graph_chase(func) {
              GNode(NBound(TFun(ps, pret, prow)), _) => CallPartial(infer_call_partial(args, ps, pret, prow, handle, span, cname)),
              _ => {
                infer_call_saturated(args, func, handle, span, cname)
                CallSaturated
              },
            }
          } else {
            infer_call_saturated(args, func, handle, span, cname)
            CallSaturated
          },
          AtCall => {
            infer_call_saturated(args, func, handle, span, cname)
            CallSaturated
          },
          AtOperand => {
            infer_call_saturated(args, func, handle, span, cname)
            CallSaturated
          },
        },
      },
    }
  }
}

// A stage's free callee takes the product the Stage Law reads: a parameter
// per argument written, then the piped value's slot, last.
fn bind_stage_product(fh, args, span: ValidSpan, cname) = {
  let slot = mk_param("_", TVar(mint(InferredCallReturn(cname, Inferred("the piped value's slot")))))
  let ps = build_inferred_params_masked(args, []) ++ [slot]
  let row = mk_ef_open([], graph_fresh_row(InferredCallReturn(cname, Inferred("effects"))))
  let ret = TVar(mint(InferredCallReturn(cname, Inferred("result"))))
  unify_types(
    TVar(fh),
    TFun(ps, ret, row),
    span,
    InferredCallReturn(cname, Inferred("a stage: its arguments, then the piped value"))
  )
}

// The record ctor's arrow VIEW, minted at the read — Some(handle bound to
// TFun([TRecord(declared)], TName(X, ...), Pure)) when the callee's edge
// reaches a nominal record's constructor, None otherwise. The identical
// instantiation the pattern path's RecordSchemeKind arm performs; the
// published scheme stays the RESULT (one home), the arrow exists only as
// this projection.
fn record_ctor_arrow_view(func, cname: String, span: ValidSpan) = match callee_binding(func) {
  Some((scheme, reason, kind)) => match kind {
    RecordSchemeKind(declared_fields) => match judgment_pair(scheme) {
      (q, body) => {
        let view =
          instantiate(Frozen(q, TFun(build_ctor_params([TRecord(declared_fields)], 0), body, mk_ef_pure())))
        let vh = mint(Inferred("record-ctor arrow view of '{cname}'"))
        graph_bind(vh, view, Located(span, VarLookup(cname, reason)))
        Some(vh)
      },
    },
    _ => None,
  },
  None => None,
}

fn infer_call_arg_list(args, params, i) = if i >= len(args) {
  ()
} else {
  let arg = list_index(args, i)
  if i < len(params) { infer_call_arg(arg, list_index(params, i)) } else { infer_expr(arg) }
  infer_call_arg_list(args, params, i + 1)
}

fn infer_call_arg(arg, param) = match graph_node_body(arg) {
  // param_borrows (types.mn, the classification's one home — the
  // ownership grade's mode walk reads the same test at decl time).
  NExpr(VarRef(_)) => if param_borrows(param) {
    borrow_enter()
    infer_expr(arg)
    borrow_exit()
  } else {
    infer_expr(arg)
  },
  _ => infer_expr(arg),
}

// The `??` hole's declaration-order index among a call's raw args (-1: none).
// An AUTHORED hole (a caret id) in argument position is the partial's field
// marker; a hole the proposer MINTED (id 0) is a value the next fill
// supplies — `Some(??)` offered at an `Option(Int)` hole is `Some` of a value
// to be proposed next, never `Some` awaiting its field (C7: until then the
// enumerator's fielded constructors judged as partials and were refused
// against the hole they were built for).
fn call_hole_index(args, i) = if i >= len(args) {
  -1
} else {
  match graph_node_body(list_index(args, i)) {
    NHole(id) => if id == 0 { call_hole_index(args, i + 1) } else { i },
    _ => call_hole_index(args, i + 1),
  }
}

// Each arg — the `??` holes included, so a hole learns its expected type
// (the gradient's food at the absence) — unifies with its declaration-
// position param; the call's type is the fn of the params left unfilled.
fn infer_call_partial(args, params, pret, prow, handle, span: ValidSpan, cname) = {
  unify_args_positionally(args, params, 0, span, handle)
  let remaining = unfilled_params(args, params)
  graph_bind(
    handle,
    TFun(remaining, pret, prow),
    Located(
      span,
      InferredCallReturn(cname, Inferred("partial application — the product with a hole"))
    )
  )
  open_slot_cells(params, len(args), span)
}

// The cells typing the slots a partial leaves open PAST its arguments — one
// per tail parameter, bound to that parameter's type here, so the lowering
// reads each open slot at its own width (a slot an authored `??` holds is
// typed by the hole node itself). A tail slot used to be typed by the
// partial node, whose type is the product's own arrow, so a wide tail
// parameter's local was declared at the arrow's word and never defined:
// `fadd(1.5)` over a Float pair checked clean and did not assemble
// (measured 2026-09-30 on boot 523f1732).
fn open_slot_cells(params, from, span: ValidSpan) = if from >= len(params) {
  []
} else {
  map(open_slot_cell(span, ??), slice(params, from, len(params)))
}

fn open_slot_cell(span: ValidSpan, p) = {
  let c = mint(Inferred("a slot the call leaves open"))
  graph_bind(c, param_ty(p), Located(span, Inferred("declaration-order param")))
  c
}

fn unify_args_positionally(args, params, i, span: ValidSpan, call_h) = if i < len(args) && i < len(params) {
  let ah = list_index(args, i)
  let pty_h = mint(Inferred("declared param at partial call"))
  graph_bind(
    pty_h,
    param_ty(list_index(params, i)),
    Located(span, Inferred("declaration-order param"))
  )
  unify(ah, pty_h, span, Inferred("argument fills its declaration-order param"))
  // A SUPPLIED slot is a refinement construction site like any call arg.
  // A hole holds no value yet, so it raises nothing — its obligation
  // lands when the suspension is filled — but the slot's contract is
  // noted on it, so what the medium proposes there satisfies what the
  // parameter demands: `choose(??)` over `n: Positive` proposed `0`
  // before, the hole's claims being empty.
  match graph_node_body(ah) {
    NHole(_) => note_contract(param_ty(list_index(params, i)), ah),
    _ => discharge_arg(list_index(params, i), ah, span, call_h),
  }
  unify_args_positionally(args, params, i + 1, span, call_h)
}

// The unfilled params: the authored `??` slots among the given prefix, then
// every param past the given count — declaration order preserved.
fn unfilled_params(args, params) =
  hole_params(args, params, 0) ++ slice(params, len(args), len(params))

fn hole_params(args, params, i) = if i >= len(args) {
  []
} else {
  match graph_node_body(list_index(args, i)) {
    NHole(id) => if id == 0 {
      hole_params(args, params, i + 1)
    } else {
      [list_index(params, i)] ++ hole_params(args, params, i + 1)
    },
    _ => hole_params(args, params, i + 1),
  }
}

// ─── The directional fn-arg edge (Hβ.effects.directional-fn-row-edge) ──
//
// A position masks when BOTH sides are bound TFuns of equal arity: the
// non-row components meet symmetrically here (nested params, the
// return), the TOP rows meet by row_subsumes(arg, param) — the param's
// declared row is the CAP, and a quieter argument always fits under it.
// An arg not yet TFun-bound keeps the symmetric path whole (a lambda
// learns its shape FROM the param); an arity mismatch keeps it too (the
// wholesale unify owns that refusal). Returns the masked positions.
//
// A flow position teaches its row variable only once every position has
// spoken: two callbacks typed by one variable (`f: () -> Int with e, g: ()
// -> Int with e`) hand it the union of their rows, a lower bound. Bound at
// the first position met, the variable read as a closed cap at the next, and
// a pure callback beside an effectful one refused the call.
fn fn_arg_directional_positions(dps, arg_handles, span: ValidSpan) = {
  let (masked, flows) = zip(dps, arg_handles) |> enumerate |> fold(([], []), directional_step(span, ??, ??))
  learn_flow_rows(flows, span)
  masked
}

fn directional_step(span: ValidSpan, acc, entry) = match acc {
  (masked, flows) => match entry {
    (i, (dp, ah)) => match fold_strip(chase_deep(param_ty(dp))) {
      // The directional meet fires only when the param's declared row is a
      // CONCRETE cap (closed or the !-stance EtAll) — a VAR-tailed param
      // row is the effect-polymorphic FLOW channel (map's f: the arg's
      // row must UNIFY into the var so the caller carries it; masking it
      // severed the flow and the wheel's census convicted 297 sites in
      // one march), never a cap to subsume under.
      TFun(pps, pret, prow) => if row_cap_form(prow) {
        match fn_arg_of(ah, len(pps)) {
          Some((aps, aret, arow)) => {
            fn_arg_component_meet(aps, pps, aret, pret, span)
            if row_subsumes(arow, prow) {
              ()
            } else {
              report_effect_mismatch(
                arow,
                prow,
                span,
                Inferred("a fn argument's row exceeds its param's declared cap")
              )
            }
            (push(masked, i), flows)
          },
          None => acc,
        }
      } else {
        // B2 (rung 3, the arg edge goes TOTAL-directional): the pure-flow
        // shape — the param's row resolving to EfRow([], [], EtOpen(vs)),
        // every surviving edge free by the chase's own construction — masks
        // the position and binds ONE-WAY: the instantiated caller-private
        // param cells learn the arg's row (`learn_flow_rows`), the arg's
        // SHARED cell is never written, so a named fn passed to map's f stops
        // teaching its own decl cell one edge per call site while the
        // 297-site flow survives as a read. A MIXED open shape (presents or
        // absents beside the var tail) keeps the symmetric path with the
        // named census marker — expected zero on the wheel; a nonzero grep
        // is the counter.
        match chase_row_deep(prow, 0) {
          EfRow(pres2, abs2, EtOpen(vs)) => if len(pres2) == 0 && len(abs2) == 0 && edges_unmasked(vs) {
            match fn_arg_of(ah, len(pps)) {
              Some((aps, aret, arow)) => {
                fn_arg_component_meet(aps, pps, aret, pret, span)
                (push(masked, i), flows ++ map(flow_pair(arow, ??), vs))
              },
              None => acc,
            }
          } else {
            eprint_string("B2-mixed-open arg-edge\n")
            acc
          },
          _ => acc,
        }
      },
      _ => acc,
    },
  },
}

// The argument at a function-typed position, when it is a bound function of
// the position's arity: its parameters, return and row.
fn fn_arg_of(ah, arity) = match graph_chase(ah) {
  GNode(NBound(aty), _) => match fold_strip(chase_deep(aty)) {
    TFun(aps, aret, arow) => if len(aps) == arity { Some((aps, aret, arow)) } else { None },
    _ => None,
  },
  _ => None,
}

fn flow_pair(arow, w) = (edge_cell(w), arow)

// Each flow cell learns, once, every row the call hands it: the one row when
// one position flows into it, their union when several share it.
fn learn_flow_rows(flows, span: ValidSpan) =
  flows |> map(flow_cell) |> unique |> each(learn_flow_row(flows, span, ??))

fn flow_cell(pair) = match pair {
  (c, _) => c,
}

fn learn_flow_row(flows, span: ValidSpan, cell) = {
  let rows = flows |> filter(flows_into(cell, ??)) |> map(flow_row)
  let row = match rows {
    [one] => one,
    _ => fold(EfRow([], [], EtClosed), union_row, rows),
  }
  graph_bind_row(cell, row, Located(span, Inferred("the arg edge teaches the param's flow row")))
}

fn flows_into(cell, pair) = match pair {
  (c, _) => c == cell,
}

fn flow_row(pair) = match pair {
  (_, r) => r,
}

// A declared param row is a CAP exactly when its tail is concrete —
// EtClosed (`with Tick`) or EtAll (`with !WASI`); an open tail is the
// polymorphic flow channel. Bound edges resolve through the chase.
fn row_cap_form(row) = match chase_row_deep(row, 0) {
  EfRow(_, _, EtClosed) => true,
  EfRow(_, _, EtAll) => true,
  _ => false,
}

fn fn_arg_component_meet(aps, pps, aret, pret, span: ValidSpan) = {
  each(
    {
      (ap, pp) => unify_types(
        param_ty(ap),
        param_ty(pp),
        span,
        Inferred("a fn argument's param meets the declared param")
      ),
    },
    zip(aps, pps)
  )
  unify_types(aret, pret, span, Inferred("a fn argument's return meets the declared return"))
}

// The wholesale-unify slots: a masked position takes a fresh
// unconstrained var (its meet already ran directionally above); every
// other position carries its argument's own handle as before.
fn build_inferred_params_masked(handles, masked) = masked_params_walk(handles, masked, 0)

fn masked_params_walk(ref handles, ref masked, i) = if i >= len(handles) {
  []
} else {
  let slot = if int_in(masked, i, 0) {
    mk_param("_", TVar(mint(Inferred("directionally-met fn-arg slot"))))
  } else {
    mk_param("_", TVar(list_index(handles, i)))
  }
  [slot] ++ masked_params_walk(handles, masked, i + 1)
}

fn int_in(ref xs, target, i) = if i >= len(xs) {
  false
} else {
  if list_index(xs, i) == target { true } else { int_in(xs, target, i + 1) }
}

// ─── The replay value barrier (Hβ.own.linear-tier-and-persist-value-barrier) ──
//
// The ROW half landed first: a fn-typed param whose declared row severs
// the host under the !-stance (!WASI + !Filesystem, EtAll tail —
// persist_branch's own contract) IS a replay boundary: the callee re-runs
// the thunk, and the row severs what a replay cannot un-send. This is the VALUE half: a frame-declared
// authored `own` FREE in that thunk crosses the wire as bytes while its
// duty-to-finish stays behind — each resumed run re-consumes it. Replay
// is the parallel fan on the TIME axis, so BParallel's collision law
// applies across runs exactly as across `><` arms: one ledger, both
// axes. Narration tier per the census arming law; the message teaches
// the two honest moves.
fn replay_barrier_gate(dps, args, span: ValidSpan, i) = if i >= len(dps) || i >= len(args) {
  ()
} else {
  match fold_strip(chase_deep(param_ty(list_index(dps, i)))) {
    TFun(_, _, prow) => if row_severs_replay(prow) {
      report_owns_across(consume_declared(), collect_free_vars(list_index(args, i), []), span)
    },
    _ => (),
  }
  replay_barrier_gate(dps, args, span, i + 1)
}

// A row severs replay when its !-stance forbids the host — WASI, the
// boundary itself, and Filesystem, the capability over it — the exact
// contract persist_branch's declared row states. The stance is a GATE now
// (the universe appears in gates and nowhere else): an authored `!WASI +
// !Filesystem` on the thunk's type is a
// free row terminal whose cell carries the negation, so the read follows
// the row to its one terminal and reads the bound there; the value form
// stays readable for a row that still folds to the universe.
fn row_severs_replay(row) = match chase_row_deep(row, 0) {
  EfRow(_, absent, EtAll) => absent_severs(absent),
  EfRow(_, _, EtOpen(edges)) => match edges {
    [e] => gates_sever(gates_at(edge_cell(e))),
    _ => false,
  },
  _ => false,
}

// The host pair, by name — the effects whose absence severs a branch from
// the host. Each is declared in every link that persists, and the row law
// (check_effect_names) refuses a clause naming an effect no declaration backs,
// so this conjunction cannot demand a phantom: a name here that nothing
// declares would constrain nothing, and the barrier it guards would vanish
// with it (the frontier's persist value-barrier leg holds the narration,
// T_OwnAcrossReplay, against the boot).
fn absent_severs(absent) = absent_forbids(absent, "WASI") && absent_forbids(absent, "Filesystem")

// The negation gates at a terminal, read as one forbidden set.
fn gates_sever(gs: [Gate]) = absent_severs(gates_forbidden(gs))

fn gates_forbidden(gs: [Gate]) = match gs {
  [] => [],
  [g, ...rest] => match gate_row(g) {
    EfRow(_, a, EtAll) => name_set_union(a, gates_forbidden(rest)),
    _ => gates_forbidden(rest),
  },
}

fn absent_forbids(ref absent, target: String) = any((e) => eff_name_str(e) == target, absent)

fn report_owns_across(ref owns, ref frees, span: ValidSpan) = each(
  (name) => if string_in_list(frees, name) { report(TOwnAcrossReplay(across_replay_msg(name), span)) },
  owns
)

// The message's one mint, String-pinned (spec_mangle's law — the each
// lambda judges datum-last while the name is still free; the pin
// anchors at the named call, unconsumed_msg's twin).
fn across_replay_msg(name: String) =
  "'{name}' is an open own captured across a replay boundary — a resumed run consumes it again; finish it before the persist, or move its whole lifetime inside the thunk"

fn infer_call_saturated(args, fh, handle, span: ValidSpan, cname) = {
  // drift-audit: ignore — "return" is a Reason string, not an imperative keyword
  let ret_h = mint(InferredCallReturn(cname, Inferred("return")))
  // THE ONE-WAY CALL EDGE (D9 rung 1's B1+B3+charge arc). One pre-unify
  // chase serves all three reads. The directional fn-arg edge: a
  // fn-typed argument's TOP row meets its declared fn-typed param by
  // SUBSUMPTION (arg ⊆ the param's declared cap), never by the
  // wholesale unify's symmetric equality — a Pure fn is admitted
  // wherever a `with Tick` fn is expected (the equality refused it,
  // measured); masked positions get fresh slots so the symmetric meet
  // never re-runs. The TOP-LEVEL row is one-way the same wing: on the
  // bound path the expectation's row IS the callee's own crow, so
  // unify_row meets identical rows and no-ops — a use of a name never
  // teaches the name's row (D5 at the call edge; the hub's per-caller
  // teach-back deleted with zero new unify machinery). On the free path
  // the callee has no row to read — fh := expected wholesale, and the
  // fresh row cell BECOMES the callee's row cell (the forward/param
  // channel, unsevered).
  let chased_f = graph_chase(fh)
  let masked = match chased_f {
    GNode(NBound(TFun(dps0, _, _)), _) => {
      // AN ARITY CHECK CANNOT LIVE HERE, and the attempt is worth recording
      // because the site looks perfect: the callee is BOUND to a TFun and
      // the args are in hand, so both counts are right there. A probe over
      // the whole micro corpus printed 1052 hits across eight distinct
      // shapes and `len(args)` NEVER differed from `len(dps0)` — not even
      // for `add(1, 2, 3)`, which arrived as `cname=add args=2 dps0=2`.
      // The surplus is dropped upstream, in fill_arg_slots, whose slot
      // buffer is sized by the parameter product; by the time any judgment
      // runs the counts are equal by construction and the evidence is gone.
      // The refusal lives at that drop (src/types.mn place_positional).
      replay_barrier_gate(dps0, args, span, 0)
      fn_arg_directional_positions(dps0, args, span)
    },
    _ => [],
  }
  let erow = match chased_f {
    GNode(NBound(TFun(_, _, crow0)), _) => crow0,
    _ => mk_ef_open([], graph_fresh_row(InferredCallReturn(cname, Inferred("effects")))),
  }
  let expected = TFun(build_inferred_params_masked(args, masked), TVar(ret_h), erow)
  let expected_h = mint(InferredCallReturn(cname, Inferred("expected function type")))
  graph_bind(expected_h, expected, Located(span, InferredCallReturn(cname, Inferred("expected"))))
  unify(fh, expected_h, span, InferredCallReturn(cname, Inferred("unification")))
  graph_bind(handle, TVar(ret_h), Located(span, InferredCallReturn(cname, Inferred("result"))))
  // THE CHARGE IS THE CALLEE'S ROW VERBATIM — its live tail edges
  // intact, never a resolve's fold (the B1 revert's payment: a resolve
  // at charge time folds a possibly-unjudged callee's row to a bare
  // VALUE the caller banks forever — Carried-Truth inverted, a snapshot
  // where an edge belonged; charging verbatim keeps every read fresh by
  // construction, folding at READ time where reads are pure). For a
  // prereg'd callee crow is the bare edge to its live accumulator cell;
  // for a published scheme it is the instantiated caller-private copy;
  // for a pre-free callee (an effect-polymorphic param, a local
  // closure, a loose forward) fh is bound to expected by the unify
  // above, so crow IS the fresh row cell — the polymorphic share
  // generalize quantifies and call sites instantiate. One arm serves
  // every case; the union beneath (tail_join's set union) is what lets
  // a second callee's edge survive the frame's accumulation. The
  // unify-failure path charges nothing (the mismatch already reported).
  match graph_chase(fh) {
    GNode(NBound(TFun(_, _, crow)), _) => inf_add_row_unified_at(
      handle,
      grounded_perform_row(fh, cname, mutation_masked(fh, crow), args, span)
    ),
    _ => (),
  }
  // The call boundary is a refinement CONSTRUCTION site: each declared
  // refined param discharges against ITS argument's live node (subst_self
  // — value-proof R2's third site, beside the let annotation and the fn
  // return). This is the one value-bearing home for the obligation;
  // unify_types' wrapper arm has no value node in scope and accrues
  // nothing (its old raw-pred verify pended one forever-undecidable entry
  // per refined-param unification — noise the debt surfacing exposed).
  // The partial path's supplied-arg discharge is the same law at
  // unify_args_positionally. What the call owes is what every function the
  // callee can be demands, read along its edges (`call_owes`).
  call_owes(fn_leaves(fh), args, handle, span)
  ages_call(handle, fh, cname, args)
}

// THE PERFORM GROUNDS ITS INSTANCE (E1). An op parameter that shares its name
// with one of its effect's own parameters IS that parameter at the perform:
// under `effect Environ(name: String) { env(name: String) -> String }`,
// `env("PORT")` charges `Environ("PORT")`. The op's registered row carries one
// opaque value dim per effect parameter (`register_effect_ops`), whose only
// writer was the declaration's pin (`pin_declared_instances`) — so the
// instance had to be written twice, once at the read and once in a `with`
// clause, with nothing checking they agree. The perform's literal argument is
// the second writer, into the charge, after the arguments are judged. A
// computed argument leaves the dim opaque: an ungrounded instance, provably
// distinct from none, so a negation over it holds exactly when the reads it
// guards are literal.
fn grounded_perform_row(fh, cname: String, crow, args, span: ValidSpan) = match perform_dim_slots(fh) {
  None => crow,
  Some((en, slots)) => {
    let dims = map(perform_slot_value(args, ??), slots)
    if env_read_is_ungrounded(en, cname, dims) { report(EEnvNameUngrounded(span)) } else { () }
    match crow {
      EfRow(ps, ab, t) => ef_make(map(perform_ground_entry(intern_str(en), dims, ??), ps), ab, t),
    }
  },
}

// The (argument position, dim position) pairs an op grounds, with its
// effect's name — None for a callee whose edge reaches no op, or an op none
// of whose parameters names its effect's.
fn perform_dim_slots(func) = match callee_binding(func) {
  Some((sch, _, EffectOpScheme(en, _, _, _))) => match judgment_ty(sch) {
    TFun(ps, _, _) => {
      let dims = effect_dim_names(en)
      let slots = fold([], perform_slot_of(dims, ??, ??), enumerate(ps))
      if len(slots) == 0 { None } else { Some((en, slots)) }
    },
    _ => None,
  },
  _ => None,
}

fn effect_dim_names(en: String) = match env_lookup(en) {
  Some(entry) => match entry {
    (_, _, EffectDeclKind(_, ds)) => ds,
    _ => [],
  },
  None => [],
}

fn perform_slot_of(dims, acc, ip) = match ip {
  (ai, p) => match find({ (_, d) => d == param_name(p) }, enumerate(dims)) {
    Some((di, _)) => push(acc, (ai, di)),
    None => acc,
  },
}

// A slot's value at this perform: the argument's literal, or None where the
// argument is computed (or the call leaves the slot to a default or a hole).
fn perform_slot_value(args, slot) = match slot {
  (ai, di) => (di, if ai < len(args) { literal_eff_arg(list_index(args, ai)) } else { None }),
}

fn literal_eff_arg(arg) = match graph_node_body(arg) {
  NExpr(LitString(s)) => Some(EAString(s)),
  NExpr(LitInt(k)) => Some(EAInt(k)),
  NExpr(LitFloat(f)) => Some(EAFloat(f)),
  _ => None,
}

fn perform_ground_entry(enh, dims, e) = match e {
  EParameterized(n, eargs) => if n == enh {
    EParameterized(n, map({ (i, a) => perform_ground_dim(dims, i, a) }, enumerate(eargs)))
  } else {
    e
  },
  ENamed(_) => e,
  EPure => e,
}

// Only an opaque dim takes the literal: a type dim is the install flow's, and
// a scalar already there keeps its own truth.
fn perform_ground_dim(dims, i, a) = match a {
  EANode(_) => match find({ (d, _) => d == i }, dims) {
    Some((_, v)) => match v {
      Some(lit) => lit,
      None => a,
    },
    None => a,
  },
  EAType(_) => a,
  EAInt(_) => a,
  EAFloat(_) => a,
  EAString(_) => a,
  EAEffect(_) => a,
  EACon(_) => a,
}

// A REQUIRED environment read must name its variable at the read: lib's
// `env` op of `Environ` (lib/environ.mn) — host vocabulary the medium names, as
// it names `Alloc` and `Trap` — with its name dim left opaque has no name the
// launch gate can check (env_demand_check in lib/environ.mn). `env_opt`, the
// optional read, takes any name.
fn env_read_is_ungrounded(en: String, cname: String, dims) =
  en == "Environ" && cname == "env" && any({ (_, None) => true, (_, Some(_)) => false }, dims)

// What an application owes the functions its callee can be: each learning
// parameter among them learns what the application hands it
// (`learn_provision`), the rest owe the meet of their contracts
// (`fn_contract`), and a generic callee carries the functions its arguments
// hand in to the callbacks it hands them to (`channel_crossing`). The meet
// of one contract is that contract, read off its node — the common
// application, which allocates nothing to learn that it owes nothing. A
// callee out of sight — a function a call returned, a part of a value this
// body cannot see into — states no use of what it is handed, so each
// argument goes where nothing here can see (`handed_unknowingly`). Each
// top-level declaration the callee can be is noted as applied here, so a
// reader asking where it is applied follows the edge (`note_application`).
fn call_owes(callees, args, call_h, span: ValidSpan) = {
  callees |> each(note_application(call_h, ??))
  match callees {
    [one] => {
      match learning_path(one) {
        Some(at) => applied_by_choice(at, args),
        None => {
          match graph_chase(one) {
            GNode(NBound(t), _) => contract_owes(t, args, call_h, span),
            _ => (),
          }
          if callee_in_sight(one) { () } else { args |> each(handed_unknowingly(call_h, span, ??)) }
        },
      }
      channel_leaf(args, call_h, span, one)
    },
    _ => {
      callees |> each(learn_provision(??, args))
      match fn_contract(callees) {
        Some(c) => contract_owes(c, args, call_h, span),
        None => (),
      }
      if all(callee_seen, callees) { () } else { args |> each(handed_unknowingly(call_h, span, ??)) }
      channel_crossing(callees, args, call_h, span)
    },
  }
}

// The application edge, drawn where the application is judged: a reference
// to a declaration among the functions the callee can be — the callee
// itself, a pipe's stage, the value a local holds — enters the application
// among the in-edges of the declaration it links to (D4: the gradient's
// precondition bracket read the calls of a declaration by scanning the whole
// graph for call nodes, and a pipe stage was never one). A value binder the
// reference reads is the local, not a declaration it applies.
fn note_application(call_h, leaf) = match graph_node_body(leaf) {
  NExpr(VarRef(_)) => match binder_read_by(leaf) {
    None => match graph_ref_decl(leaf) {
      Some(decl) => graph_apply_note(decl, call_h),
      None => (),
    },
    Some(_) => (),
  },
  _ => (),
}

// A callee whose use of what it is handed this body can read: a
// declaration of the program, a lambda in sight, a parameter whose type was
// written, and what a call of one returns — a partial completing it, or the
// function its declared return states. A learning parameter is its
// caller's choice and is read apart (`applied_by_choice`); a call of one
// returns its caller's choice too.
fn callee_in_sight(leaf) = match graph_node_body(leaf) {
  NExpr(LambdaExpr(_, _)) => true,
  NExpr(VarRef(_)) => if reaches_module_decl(leaf) { true } else { stated_parameter(leaf) },
  NExpr(CallExpr(callee, _)) => callee_in_sight(callee),
  NExpr(PipeExpr(PForward, _, stage)) => callee_in_sight(stage),
  _ => false,
}

fn callee_seen(leaf) = learning_param(leaf) || callee_in_sight(leaf)

// Whether a reference's edge reaches a declaration of the program's own
// scope — a module-level declaration, or a constructor or an op declared
// inside one — never a local that shares its spelling.
fn reaches_module_decl(r) = match graph_ref_decl(r) {
  Some(d) => at_module_level(d) || match graph_parent_of(d) {
    Some(p) => at_module_level(p),
    None => false,
  },
  None => false,
}

fn stated_parameter(leaf) = match binder_read_by(leaf) {
  Some(b) => match graph_binder_of(b) {
    Some(fact) => match fact {
      ParamFact(_) => !learning_binder(b),
      PartFact(_) => false,
      StateFact(_) => false,
    },
    None => false,
  },
  None => false,
}

// An argument handed where nothing states its use: every function it holds
// meets that use as `source_unknowingly` reads it — a learning parameter's
// learns it, a function in sight owes its demands as debt.
fn handed_unknowingly(call_h, span: ValidSpan, ah) =
  value_fn_positions(ah) |> each(unknowingly_at(call_h, span, ah, ??))

fn unknowingly_at(call_h, span: ValidSpan, ah, pos) = match pos {
  (_, path, _) => sources_at(ah, path) |> each(source_unknowingly(call_h, span, ??)),
}

// A contract is owed where the application fills its parameters: each
// refined one claims of its argument (`discharge_arg`).
fn contract_owes(t, args, call_h, span: ValidSpan) = match t {
  TFun(dps, _, _) => if len(dps) == len(args) { discharge_arg_refinements(dps, args, 0, span, call_h) } else { () },
  _ => (),
}

fn discharge_arg_refinements(dps, arg_handles, i, span: ValidSpan, call_h) = if i >= len(dps) || i >= len(arg_handles) {
  ()
} else {
  let p = list_index(dps, i)
  let ah = list_index(arg_handles, i)
  // An authored hole holds no value yet and raises nothing; the slot's
  // contract is noted on it so what is proposed there satisfies what the
  // parameter demands — the partial path's law (unify_args_positionally),
  // met here by an applied call holding a value hole (`choose(??) + 1`).
  match graph_node_body(ah) {
    NHole(id) => if id == 0 { discharge_arg(p, ah, span, call_h) } else { note_contract(param_ty(p), ah) },
    _ => discharge_arg(p, ah, span, call_h),
  }
  discharge_arg_refinements(dps, arg_handles, i + 1, span, call_h)
}

// `~>` handler attachment — the row algebra's handler operator. A handler is
// (a ! E+r) ⟿ (a ! R+r): row(expr ~> h) = (row(expr) − E) ⊕ R. The body is
// inferred in a NESTED row scope so its effects do NOT leak (subtraction would
// be impossible once leaked — the install discipline); the handler value is
// installed (binding its config args, so a config-param handler's R picks up
// the actual arg's effect); then (body_row − E) ⊕ R joins the caller's row.
// Reading the RHS handler's HandlerKind(E, R) is what completes the row algebra
// — without it map/each lose every effect performed in their arms.
// A lambda's judgment: its parameters in a scope of their own and its body
// in a frame of its own. ABSTRACTION IS PURE in what it performs — the body's
// row rides the lambda's TYPE, and every APPLIER is charged by the call edge,
// an escaping closure included (its eventual call site reads the row off the
// closure's type), while the runtime evidence resolves through the live
// install chain at the perform site (world-as-value R2 — a thunk performs
// where CALLED). The former create-flows-row edge charged the CREATOR with the
// closure's whole row — a mint-time-evidence relic that made every
// absorbed-thunk pattern leak: a thunk passed to an absorbing bracket polluted
// the creator's row with effects the bracket provably absorbs. What minting
// COSTS is the record, charged by the arm that mints; a recurrence lambda the
// lowering inlines into its cycle is judged here and mints nothing.
//
// A parameter its CALLERS bind is declared as a function's is: it learns
// the precondition its body hands it to and guards what that precondition
// proves, and the lambda's type publishes both — every application reads
// them there (a call through the value, a function crossing, a pipe
// stage). A `<~` cycle's prior binds its parameter with no application to
// raise a claim, so that parameter learns nothing and a demand inside the
// body stays the body's own.
type ParamBinder = BoundByCallers | BoundByTheCycle

// Where a literal stands: minted into a closure record, or applied where it
// stands by a verb — the stage of a `|>` or a `<|`, the left of a `<~` — and
// so no record at all. An applied literal's body is judged in the scope of
// the frame it stands in, and a feedback tick inside it charges the record
// that frame owns.
type LambdaSite = MintedHere | AppliedInPlace

fn infer_lambda(params, body_node, handle, span: ValidSpan, binder, site) = {
  env_scope_enter()
  let row_handle = graph_fresh_row(Inferred("lambda effects"))
  let typed = build_param_types(params)
  declare_param_binders(params, "lambda")
  let declared = match binder {
    BoundByCallers => declare_params(params, typed, guard_cells(params, "lambda")),
    BoundByTheCycle => typed,
  }
  inf_enter_fn(row_handle, span, [])
  inf_frame_params(params ++ [body_node])
  claim_param_shapes(params)
  match site {
    MintedHere => {
      ages_open(AgeClosure)
      infer_expr(body_node)
      ages_pop()
    },
    AppliedInPlace => {
      inf_mark_transparent()
      infer_expr(body_node)
    },
  }
  exit_frame()
  hand_on_value(body_node)
  let published = match binder {
    BoundByCallers => published_params(declared, params, "lambda", span),
    BoundByTheCycle => declared,
  }
  graph_bind(
    handle,
    TFun(published, published_fn_ret(TVar(body_node), body_node), mk_ef_open([], row_handle)),
    Located(span, Inferred("lambda"))
  )
  // H4: every lambda allocates a closure record on the heap.
  tag_alloc(handle)
  env_scope_exit()
}

// A single-parameter lambda literal. Where a verb applies it in place — the
// left of `<~`, whose parameter binds the prior, and the right of `|>`, whose
// parameter binds the piped value — the lowering binds the parameter and
// lowers the body in the frame it stands in (lower.mn's lower_feedback_body
// and lower_pipe_complete), so no closure is minted and the judgment charges
// none. One test, both readers.
fn inlinable_lambda(node) = match graph_node_body(node) {
  NExpr(LambdaExpr(params, body)) => if len(params) == 1 { Some((params, body)) } else { None },
  _ => None,
}

// A lambda a verb applies in place with N values to give it — the merge's
// stage, whose parameters are the product's parts. One parameter is
// `inlinable_lambda`'s own case; the test is the same one, read at the
// arity the site supplies.
fn inlinable_lambda_arity(node, n) = match graph_node_body(node) {
  NExpr(LambdaExpr(params, body)) => if len(params) == n { Some((params, body)) } else { None },
  _ => None,
}

// A STAGE — a `|>`'s right side, and each branch a `<|` applies to its one
// borrowed input — is APPLIED where it stands: a call there is completed in
// place, the value filling its hole, so it mints no partial; a literal there
// is the value bound to its parameters, so it mints no closure. The
// lowering applies it the same way (lower.mn's lower_pipe_complete_many), which is
// what keeps the stage's cost in the row exactly what the emit builds.
fn infer_stage(stage, arity) = match graph_node_body(stage) {
  NExpr(CallExpr(rf, rargs)) => match infer_call_node(rf, rargs, stage, graph_span_of(stage), AtStage) {
    CallPartial(_) => (),
    CallSaturated => (),
    CallSubstrateHoled(_) => (),
  },
  _ => match inlinable_lambda_arity(stage, arity) {
    Some((params, body)) => infer_lambda(params, body, stage, graph_span_of(stage), BoundByCallers, AppliedInPlace),
    None => infer_expr(stage),
  },
}

// How many values a pipe's stage is given: one, or the parts of a product
// the site builds (the merge). The literal standing as that stage takes
// exactly that many parameters and is applied in place, minting nothing.
fn pipe_stage_arity(left) = {
  let n = product_arity_at(left)
  if n > 1 { n } else { 1 }
}

// The parameters a pipe's stage is expected to take: the piped value's one,
// or — where the left is a product the site builds and the stage's open
// slots are exactly its parts — one per part, which is the merge.
fn pipe_stage_params(lh, right) = if product_fills_stage(lh, right) {
  match lookup_ty(lh) {
    TTuple(ts) => map(product_slot_param, ts),
    other => [mk_param("_", other)],
  }
} else {
  [mk_param("_", TVar(lh))]
}

fn product_slot_param(t) = mk_param("_", t)

// An install whose right side names a HANDLER CHAIN becomes its members'
// installs by one write at the install node (`infer_chain_install`); every
// other install is judged as the one install it is. Either way its handler is
// resolved once, first: the body's judgment reads what the install absorbs.
fn infer_pipe_tee(left, right, handle, span: ValidSpan) = {
  let hd = install_decl(right)
  match chain_of(hd, right) {
    Some((name, members)) => infer_chain_install(left, right, name, members, handle, span),
    None => infer_pipe_tee_one(left, right, hd, handle, span, install_reason(hd, right, span)),
  }
}

// The declaration a handler reference names — an install's right side or a
// chain's member, bare or applied to its config — resolved where it is
// judged and linked there, so the reference's own judgment answers the link.
// A member a chain instantiates at an install is a fresh node, resolved here.
fn install_decl(right) = {
  let r = tee_ref(right)
  match graph_node_body(r) {
    NExpr(VarRef(name)) => ref_resolve(name, r),
    _ => None,
  }
}

// What a declaration was published as — an install's handler, a call's
// callee — None where no declaration stands.
fn published_kind(hd) = match hd {
  Some(d) => match graph_published(d) {
    Some((_, _, kind)) => Some(kind),
    None => None,
  },
  None => None,
}

// THE ONE WRITE (S3, 2026-10-13): `body ~> NAME` over `handler NAME = h1 ~>
// h2` is the install of h1 under the install of h2, and the graph holds
// exactly that after this write — the members instantiated at the
// reference's span, nested innermost-first over the body, and the install's
// own node REGISTERED AGAIN as the outermost of them — so every reader after
// the judgment (the row fold, the entry walk, the lowering, the formatter)
// asks the graph and sees the installs the author would have spelled. The
// authored reference stays the site's own node, bound so the Why at the
// glyph names the chain and `refs of NAME` counts the install; the install
// node is bound `ChainInstall`, which the formatter reads to write the name
// back. A chain applied to arguments is refused: a chain carries no config of
// its own, its members do. Until this landed the only way to hand a body to
// a fixed stack of handlers was a thunk and a wrapper function (pipeline's
// infer_context and the 23 thunks into it, measured 2026-09-20).
fn infer_chain_install(left, right, name: String, members, handle, span: ValidSpan) = {
  let rspan = graph_span_of(right)
  match graph_node_body(right) {
    NExpr(CallExpr(_, _)) => report(EHandlerChainShape(
      "`{name}` is a chain of handlers, not a handler with config — install it bare; its members carry their own arguments",
      rspan
    )),
    _ => (),
  }
  graph_bind(
    right,
    TUnit,
    Located(
      rspan,
      Inferred("the handler chain {name}, installed here as its {int_to_str(len(members))} member(s)")
    )
  )
  let inner = member_installs(name, left, drop_last(members), rspan, span)
  let outermost = chain_instance(name, last(members), rspan)
  graph_register_node(handle, NExpr(PipeExpr(PTee, inner, outermost)))
  infer_pipe_tee_one(
    inner,
    outermost,
    install_decl(outermost),
    handle,
    span,
    Located(span, ChainInstall(right, len(members)))
  )
}

// The installs of every member but the outermost, innermost first: each is a
// fresh install node over the body so far, its member instantiated at the
// reference's span.
fn member_installs(name: String, body, members, rspan: ValidSpan, span: ValidSpan) = match members {
  [] => body,
  [m, ...rest] => member_installs(name, member_install(body, chain_instance(name, m, rspan), span), rest, rspan, span),
}

fn member_install(body, member, span: ValidSpan) = {
  let h = fresh_handle_as(span, Located(span, Inferred("an install of a chain's member")))
  graph_register_node(h, NExpr(PipeExpr(PTee, body, member)))
  h
}

// The chain an install's handler side names and its members, flattened — a
// member that names another chain stands for that chain's members. None for
// a handler, a value or an anonymous install.
fn chain_of(hd, right) = match published_kind(hd) {
  Some(HandlerChainKind(chain)) => Some((callee_name(right), chain_members(chain))),
  _ => None,
}

fn chain_members(h) = match graph_node_body(h) {
  NExpr(PipeExpr(PTee, l, r)) => chain_members(l) ++ chain_member(r),
  _ => chain_member(h),
}

fn chain_member(h) = match chain_of(install_decl(h), h) {
  Some((_, members)) => members,
  None => [h],
}

// A chain declaration's own judgment: each member is a handler reference —
// bare or applied to its config — or another chain; a joint of the tree is
// bound to unit so no cell of the declaration is left unjudged. The
// declaration never installs anything; its members are judged here as the
// references they are and instantiated again at every install.
fn judge_chain(name: String, h) = match graph_node_body(h) {
  NExpr(PipeExpr(PTee, l, r)) => {
    judge_chain(name, l)
    judge_chain_member(name, r)
    graph_bind(h, TUnit, Located(graph_span_of(h), Inferred("a joint of the handler chain {name}")))
  },
  _ => judge_chain_member(name, h),
}

fn judge_chain_member(name: String, h) = match published_kind(install_decl(h)) {
  Some(HandlerKind(_, _, _, _, _)) => {
    member_declarations(h) |> each(member_declared(name, ??))
    infer_expr(h)
  },
  Some(HandlerChainKind(_)) => graph_bind(
    h,
    TUnit,
    Located(graph_span_of(h), Inferred("the handler chain {callee_name(h)}, a member of {name}"))
  ),
  _ => report(EHandlerChainShape(
    "`{callee_name(h)}`, a member of the chain {name}, is not a handler — a chain is handlers, each a name or a name applied to its config",
    graph_span_of(h)
  )),
}

// A member's arguments are VALUES. A declaration anywhere inside one — a
// function, a handler, a type, an import — is refused here, at the chain's
// declaration, where the member is judged once; every install then
// instantiates values alone. A let or an expression statement inside an
// argument's block is a value's own scaffolding and is walked through.
fn member_declarations(h) = match graph_node_body(h) {
  NStmt(LetStmt(_, _, _)) => flat_map(member_declarations, body_child_handles(graph_node_body(h))),
  NStmt(ExprStmt(_)) => flat_map(member_declarations, body_child_handles(graph_node_body(h))),
  NStmt(FnStmt(_, _, _, _, _)) => [h],
  NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => [h],
  NStmt(HandlerChainStmt(_, _)) => [h],
  NStmt(TypeDefStmt(_, _)) => [h],
  NStmt(EffectDeclStmt(_, _, _)) => [h],
  NStmt(ImportStmt(_)) => [h],
  NStmt(RefineStmt(_, _, _)) => [h],
  NStmt(AliasStmt(_, _)) => [h],
  NStmt(RowAliasStmt(_, _)) => [h],
  body => flat_map(member_declarations, body_child_handles(body)),
}

fn member_declared(chain: String, d) = report(EHandlerChainShape(
  "a member of the chain {chain} declares `{body_decl_name(graph_node_body(d))}` — a chain is handlers applied to values; declare it beside the chain",
  graph_span_of(d)
))

// A CHAIN'S MEMBER, INSTANTIATED WHERE THE CHAIN IS INSTALLED. A member of
// `handler NAME = h1 ~> h2(cfg)` is the declaration's own node, and an
// install is a frame of its own: the handler's instance, its answer and its
// config arguments are the install's, so a member judged at two installs
// through one node would unify two instances into one cell. The install
// therefore COPIES the member's subtree at the reference's span — the move a
// row alias makes when a signature reads its terms — and the copy is what
// the install judges and lowers. A `??` in a member is a hole of the copy's
// own, since a hole's id is its cell; a declaration inside a member's
// argument was refused where the chain was judged (`member_declarations`),
// because a chain is handlers applied to values, so the copy leaves it as it
// stands.
fn chain_instance(chain: String, h, span: ValidSpan) = {
  let copy = fresh_handle_as(
    span,
    Located(span, Inferred("a member of the handler chain {chain}, instantiated at this install"))
  )
  graph_register_node(copy, instance_body(chain, graph_node_body(h), copy, span))
  // A destructuring `let` stays one in the copy: its birth is a fact of the
  // node, read by the judgment (a shape claim, not a dispatch) and the render.
  if graph_let_born(h) { graph_let_born_note(copy) } else { () }
  copy
}

fn instance_body(chain: String, body, copy, span: ValidSpan) = match body {
  NExpr(e) => NExpr(instance_expr(chain, e, span)),
  NStmt(s) => NStmt(instance_stmt(chain, s, span)),
  NHole(_) => NHole(copy),
  NPat(p) => NPat(instance_pat(chain, p, span)),
  // A parameter is copied with its pattern, its annotation and its default:
  // the copy is the cell of the copy's argument.
  NParam(p) => NParam({
    ann: map_option(instance_of(chain, span, ??), p.ann),
    dflt: map_option(instance_of(chain, span, ??), p.dflt),
    marker: p.marker,
    pat: chain_instance(chain, p.pat, span),
  }),
  NTypeAnn(t) => NTypeAnn(t),
  NModule(m) => NModule(m),
  NLink(l) => NLink(l),
  NRow(t) => NRow(t),
  NName(written) => NName(written),
}

fn instance_of(chain: String, span: ValidSpan, h) = chain_instance(chain, h, span)

fn instance_pair(chain: String, span: ValidSpan, field) = match field {
  (n, v) => (n, chain_instance(chain, v, span)),
}

fn instance_arm(chain: String, span: ValidSpan, arm) = match arm {
  (p, b) => (chain_instance(chain, p, span), chain_instance(chain, b, span)),
}

// A pattern is copied whole: each of its nodes is the cell of what it takes
// apart and declares the binder it writes, so two installs judge two
// patterns.
fn instance_pat(chain: String, p, span: ValidSpan) = {
  let go = instance_of(chain, span, ??)
  match p {
    PVar(name) => PVar(name),
    PWild => PWild,
    PLit(v) => PLit(v),
    PCon(name, subs) => PCon(name, map(go, subs)),
    PTuple(subs) => PTuple(map(go, subs)),
    PList(subs, rest) => PList(map(go, subs), map_option(go, rest)),
    PRecord(fields, rest) => PRecord(map(instance_pair(chain, span, ??), fields), map_option(go, rest)),
    PAlt(branches) => PAlt(map(go, branches)),
    PAs(name, inner) => PAs(name, go(inner)),
  }
}

fn instance_update(chain: String, span: ValidSpan, u) = {
  init: chain_instance(chain, state_field_init(u), span),
  name: chain_instance(chain, state_field_node(u), span),
}

fn instance_expr(chain: String, e, span: ValidSpan) = {
  let go = instance_of(chain, span, ??)
  match e {
    LitInt(n) => LitInt(n),
    LitFloat(f) => LitFloat(f),
    LitString(s) => LitString(s),
    LitBool(b) => LitBool(b),
    LitUnit => LitUnit,
    VarRef(name) => VarRef(name),
    BinOpExpr(op, l, r) => BinOpExpr(op, go(l), go(r)),
    UnaryOpExpr(op, n) => UnaryOpExpr(op, go(n)),
    CallExpr(f, args) => CallExpr(go(f), map(go, args)),
    LabeledArg(name, v) => LabeledArg(name, go(v)),
    LambdaExpr(params, body) => LambdaExpr(map(go, params), go(body)),
    IfExpr(c, t, f) => IfExpr(go(c), go(t), go(f)),
    BlockExpr(stmts, fin) => BlockExpr(map(go, stmts), go(fin)),
    MatchExpr(scrut, arms) => MatchExpr(go(scrut), map(instance_arm(chain, span, ??), arms)),
    ResumeExpr(v, updates) => ResumeExpr(go(v), map(instance_update(chain, span, ??), updates)),
    MakeListExpr(elems) => MakeListExpr(map(go, elems)),
    MakeTupleExpr(elems) => MakeTupleExpr(map(go, elems)),
    MakeRecordExpr(fields) => MakeRecordExpr(map(instance_pair(chain, span, ??), fields)),
    RecordUpdateExpr(base, fields) => RecordUpdateExpr(go(base), map(instance_pair(chain, span, ??), fields)),
    NamedRecordExpr(head, fields) => NamedRecordExpr(go(head), map(instance_pair(chain, span, ??), fields)),
    IndexExpr(recv, idx) => IndexExpr(go(recv), go(idx)),
    MakeStringExpr(frags) => MakeStringExpr(map(go, frags)),
    ShowExpr(inner) => ShowExpr(go(inner)),
    FieldExpr(recv, name) => FieldExpr(go(recv), name),
    PipeExpr(k, l, r) => PipeExpr(k, go(l), go(r)),
    FanoutExpr(branches) => FanoutExpr(map(go, branches)),
    RestExpr(name) => RestExpr(name),
    ExprPlaceholder => ExprPlaceholder,
  }
}

// A block inside a member's argument: its lets and expression statements are
// copied; a declaration there was refused at the chain's declaration
// (`member_declarations`) and is left as it stands.
fn instance_stmt(chain: String, s, span: ValidSpan) = match s {
  LetStmt(pat, value, ann) => {
    let v = chain_instance(chain, value, span)
    // an absent annotation IS the value node (the parser's sentinel), so the
    // copy keeps the alias
    LetStmt(
      chain_instance(chain, pat, span),
      v,
      if ann == value { v } else { chain_instance(chain, ann, span) }
    )
  },
  ExprStmt(e) => ExprStmt(chain_instance(chain, e, span)),
  FnStmt(_, _, _, _, _) => s,
  HandlerDeclStmt(_, _, _, _, _, _) => s,
  HandlerChainStmt(_, _) => s,
  TypeDefStmt(_, _) => s,
  EffectDeclStmt(_, _, _) => s,
  ImportStmt(_) => s,
  RefineStmt(_, _, _) => s,
  AliasStmt(_, _) => s,
  RowAliasStmt(_, _) => s,
}

// One install, judged as the one install it is.
fn infer_pipe_tee_one(left, right, hd, handle, span: ValidSpan, born) = {
  let body_row_h = graph_fresh_row(Inferred("~> body row"))
  // drift-audit: ignore — two independent frame inputs (row handle, answer handle) — one frame record's fields, not parallel arrays
  // The tee body is ONE install's scope — its effect-instance fragments
  // join at the accumulation seam (inf_add_row_unified's gate).
  // The FULL handled set — every distinct effect the arms touch — read
  // from the HandlerKind the identity comes from, BEFORE the body is
  // judged: the install mark carries it, so a perform site inside the
  // body knows which enclosing tee delimits its remainder (A5). A single-
  // name subtraction left a multi-effect handler's sibling effect on the
  // caller's row.
  let arm_names = match tee_arms(right) {
    Some(arms) => derive_handler_enames(arms, 0, []),
    None => [],
  }
  // What the install is, read off the one roster that also decides what
  // it costs and what it lowers to. An arena's body is an epoch of its
  // own: what the scope held before it is older than every store inside.
  let projection = projection_of_effects(map(eff_name_str, arm_names))
  let opens_arena = install_opens_arena(projection)
  if opens_arena { ages_depth(1) } else { () }
  inf_enter_fn(body_row_h, span, [])
  inf_mark_install_frame(arm_names)
  infer_expr(left)
  exit_frame()
  if opens_arena { ages_depth(-1) } else { () }
  infer_expr(right)
  let attach = install_reason(hd, right, span)
  install_answer(right, left, span, attach)
  // The install itself, in the frame it stands in: a dispatched install
  // builds its record and pushes its world, so it allocates, and `!Alloc`
  // accepted every one while the heap grew per call (40 bytes for a
  // stateless handler, measured 2026-09-28).
  inf_add_row_at(handle, install_cost(projection))
  install_reads(projection, left)
  let body_row = read_bound_row(body_row_h)
  ages_install(hd, body_row)
  match handler_e_r(hd, right) {
    Some(er) => {
      note_bare_handler_product(right)
      // THE INSTALL CONNECTION: flow the op payload performer→handler.
      // The body performs E(a); the handler is Handler(E(P)); unify a = P,
      // so the handler's arm param (elem : P) becomes the performed value
      // type. This is what makes `field` in `map((field)=>field.name, xs)`
      // resolve to xs's element. The dispatch gradient applied to data.
      unify_install_payload(body_row, er.ename, right, span)
      let handled_names = if len(arm_names) == 0 { [ENamed(intern_str(er.ename))] } else { arm_names }
      // A5 — the arm-world rule at the install (LENS §2.4): resuming
      // inside an arm of h continues the REMAINDER under h, so h's own
      // declared negation binds the remainder's requirement with h's
      // absorption removed. The remainder is this install's body, so
      // the check is here, per install, where the body is known — never
      // a join across installs into the handler's one row, which would
      // charge every install with every other install's remainder.
      remainder_gates_check(er.residual, body_row, handled_names, span)
      // The same judgment for every callee a held resume of h runs its
      // remainder through: their gates rode the resume's world into the
      // handler's remainder-world cell when the arms were judged, and
      // this install's remainder is what that cell stands for here.
      remainder_gates_check(er.world, body_row, handled_names, span)
      // A gate that reaches the world later — the caller of a continuation
      // the arms handed out, judged after this install — meets this
      // install's remainder through an instance of the world cell, so the
      // verdict does not wait on which of the two the program states first.
      note_world_remainder(er.world, body_row, handled_names, span)
      inf_add_row_at(
        handle,
        absorb_row(
          body_row,
          mk_ef_closed(handled_names),
          install_mutation(handle, right, residual_with_config_args(er.residual, er.config, right))
        )
      )
    },
    // A handler held by a value — a let, a parameter — names no handler
    // declaration, so the body's row passes through.
    None => inf_add_row_at(handle, body_row),
  }
  graph_bind(handle, TVar(left), born)
}

// An install answers for what its arms write of the config it hands them, as
// a call answers for what its callee writes of its arguments
// (`ages_close_arms`): the config is the install's product, written at the
// handler's call or, for a bare reference, at the reference
// (`note_bare_handler_product`), and the claim is the declaration's the
// handler side's edge reaches.
fn install_mutation(site, right, residual) = match tee_handler_decl(right) {
  Some(dh) => match graph_store_claim_of(dh) {
    Some(StoreClaim(s)) => {
      each(mutation_transport(site, install_config(right), ??), s.mutated)
      if s.beyond { residual } else { row_without_mutate(residual) }
    },
    None => residual,
  },
  None => residual,
}

fn install_config(right) = match graph_product_at(right) {
  ProductOf(nodes, _, _) => nodes,
  NoProduct => [],
}

// What an install costs the frame it stands in, by its class (the roster in
// src/effects.mn): a dispatched install — a schedule's included — builds the
// record its arms run against and pushes its world; a derivative reading
// replaces the install with the extent's derivative program and builds
// nothing; an arena builds no record either, but its exit moves what
// survives into the frame's own region and asks every handler around it to
// name the slots it wrote in place. An install whose handler does not
// resolve is dispatched.
fn install_cost(projection) = match projection {
  PDerivative => mk_ef_pure(),
  PSchedule(_) => construction_row(),
  PDispatch => construction_row(),
  PArena => mk_ef_closed([ENamed(intern_str("Memory")), ENamed(intern_str("Alloc")), ENamed(intern_str("Arena"))]),
}

fn install_opens_arena(projection) = match projection {
  PArena => true,
  PDerivative => false,
  PSchedule(_) => false,
  PDispatch => false,
}

// What an install's own exit reads of its value: an arena carries the value
// out of the region it reclaims, so the value's type is read as a move and
// every instantiation keys its own twin by the class that move needs. The
// other classes read nothing of it.
fn install_reads(projection, left) = match projection {
  PArena => shape_demand(left, MovedShape),
  PDerivative => (),
  PSchedule(_) => (),
  PDispatch => (),
}

// The stack depth an install mark was pushed at; the tee body frame is the
// one below it.
fn mark_depth(mark) = match mark {
  (depth, _handled) => depth,
}

// Whether the frame owns a record, read through the frame record's declared
// shape — the Intent Boundary an INTERIOR field read needs: an element of the
// frame stack arrives at emit with its row unresolved, and an unprovable
// offset is a refusal (E_FieldOffsetUnprovable), never a read.
fn frame_owns(frame: {accumulated_row: EffRow, declared: [(RowTerm, Bool, EConn)], fn_span: Span, owner: Bool, params: [Int], row_handle: Int}) =
  frame.owner

// The effect an op name performs; None for a name that is not an op (a
// pipe or fanout boundary stages under its own operator's name).
fn op_effect_of(cname: String) = match env_lookup(cname) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      EffectOpScheme(en, _, _, _) => Some(en),
      FnScheme => None,
      ConstructorScheme(_, _) => None,
      RecordSchemeKind(_) => None,
      EffectDeclKind(_, _) => None,
      HandlerKind(_, _, _, _, _) => None,
      HandlerChainKind(_) => None,
      ParamScheme(_) => None,
      RowAliasKind(_) => None,
      TypeVariants(_) => None,
      ValueScheme => None,
    },
  },
  None => None,
}

// The handler's authored row at its exit — the fn path's own steps (the
// pure collapse, the instance resolution and its argument check, the
// declared row, the gate on the arms' row) — then the NEGATION half stored
// on the residual cell itself, so every install reads it against its own
// remainder (remainder_gates_check).
fn enforce_handler_clause(hname: String, declared_effs, r_handle, span: ValidSpan) = if len(declared_effs) == 0 {
  ()
} else {
  let has_pure = has_pure_declared(declared_effs)
  let resolved_effs = resolve_declared_instances(declared_effs)
  check_effect_names(resolved_effs, span)
  check_instance_args(resolved_effs, span)
  let declared_row = build_declared_row(resolved_effs)
  enforce_row_gate(hname, declared_row, has_pure, r_handle, span, None)
  match declared_row {
    EfRow(_, absent, _) => if len(absent) == 0 {
      ()
    } else {
      graph_gate_add(r_handle, mk_gate(mk_ef_neg(absent), Located(span, Declared(hname))))
    },
  }
}

// One install's remainder, held as an instance of its handler's world cell:
// a row cell bound to what the body performs past the effects the install
// handles. `gate_install` reaches every instance of a cell it gates, so a
// negation that lands on the world after the install judges this remainder
// where it stands.
fn note_world_remainder(world_h, body_row, handled_names, span: ValidSpan) = {
  let why = Located(span, Inferred("the remainder an install hands its continuations"))
  let cell = graph_fresh_row(why)
  graph_bind_row(cell, diff_row(resolve_row(body_row), mk_ef_closed(handled_names)), why)
  graph_instance_note(graph_chase_handle(world_h), cell)
}

// A5: the remainder's requirement at one install of h, judged against h's
// own negation seen through h's absorption — the gate its registration
// stored on the residual cell, minus the effects this install handles —
// and pushed onto the body row's free terminals, so a callback a later
// caller resolves is judged the same way.
fn remainder_gates_check(resid_h, body_row, handled_names, span: ValidSpan) = match gates_at(resid_h) {
  [] => (),
  gs => {
    let v = resolve_row(body_row)
    each(
      {
        g => match gate_through_mask(g, handled_names) {
          Some(g2) => gate_judge_push(g2, v, span),
          None => (),
        },
      },
      gs
    )
  },
}

fn handler_e_r(hd, right) = match published_kind(hd) {
  // The handled effect is a live projection of the arms (§2 follow-the-
  // edge), never a stored field — arms→op→EffectOpScheme carries it.
  // The config TParams ride along for the residual's install read, and
  // the remainder world for the install's judgment of its gates.
  Some(HandlerKind(r, w, config, _, arms)) => Some({config, ename: derive_handler_ename(arms, callee_name(right)), residual: r, world: w}),
  _ => None,
}

// A bare `~> h` of a handler with config is the zero-argument product:
// every field fills from its declaration default, and that product is
// written at the reference node, where the lowering reads an install's
// config arguments (lower.mn's extract_handler_config_args) — a `~> h(args)`
// install is a call and writes its product at the call node. A handler
// without config writes none.
fn note_bare_handler_product(right) = match graph_node_body(right) {
  NExpr(VarRef(name)) => {
    let params = callee_params_at(right)
    if len(params) == 0 {
      ()
    } else {
      graph_product_note(right, resolve_call_args(params, [], name), [], CallApplied)
    }
  },
  _ => (),
}

// The residual READ at the install — the instantiation the raw handle
// bypasses, done live at the one seam it matters
// (Hβ.infer.handler-residual-outside-the-scheme): an arm's call into a
// config fn charged the DECL param's row cell (a one-way edge), while
// the install's CallExpr unified the actual arg into the SCHEME's
// freshened copy — so the decl cell stays free forever and the residual
// folds nothing for it. The graph holds both ends: the residual's edge
// set names WHICH config params the arms call (their row roots), and
// the install's own arg nodes carry the actual rows. Join each CALLED
// config arg's row into the residual — carry the handles, read live; an
// uncalled config fn's arg contributes nothing (its root is not in the
// edge set), so the charge stays exact. A labeled or arity-short
// install falls back to the raw residual (positions are the pairing;
// resolve_call_args' full label resolution is the refinement).
fn residual_with_config_args(resid_h, config, right) = match graph_node_body(right) {
  NExpr(CallExpr(_, args)) => {
    // The residual rides the CELL AS AN EDGE — the shape a scheme's row
    // rides (mk_ef_open on the handle), never read_bound_row: a residual
    // that is exactly one config-var edge finalizes as an ALIAS of that
    // free cell (the flat store's canonical form), and a bound-row read
    // of a free root answers pure — the measured root-FREE loss.
    // resolve_row folds bound content and keeps free tails, so both
    // shapes read true.
    let resid = resolve_row(mk_ef_open([], resid_h))
    if len(args) != len(config) || any_arg_labeled(args) {
      resid
    } else {
      fold(
        resid,
        (acc, pair) => match pair {
          (i, p) => if any((r) => residual_has_root(acc, r), config_row_roots(p)) {
            match arg_fn_row(args, i) {
              Some(arow) => union_row(acc, arow),
              None => acc,
            }
          } else {
            acc
          },
        },
        enumerate(config)
      )
    }
  },
  _ => resolve_row(mk_ef_open([], resid_h)),
}

fn any_arg_labeled(ref args) = any(
  {
    a => match graph_node_body(a) {
      NExpr(LabeledArg(_, _)) => true,
      _ => false,
    },
  },
  args
)

// The config param's row-sort roots, read through its live cell — after
// arm inference the cell is bound to the config fn's type, and its row's
// free roots are exactly what the arms' call edges chase to. The SAME
// collection the keep-set uses (signature_free_roots — one walk, the
// trio discipline), filtered to the row sort the membership compares.
fn config_row_roots(p) = match param_ty(p) {
  TVar(h) => filter(is_row_handle, signature_free_roots([h])),
  _ => [],
}

fn residual_has_root(resid, root) = match resid {
  EfRow(_, _, EtOpen(vs)) => any((e) => graph_chase_handle(edge_cell(e)) == root, vs),
  _ => false,
}

fn arg_fn_row(ref args, i) = match chase_deep(lookup_ty(list_index(args, i))) {
  TFun(_, _, arow) => Some(arow),
  _ => None,
}

// Flow the effect INSTANCE performer→handler at the install: the body performs
// `E(a1..an)` (in its row), the handler value is `Handler(E(P1..Pn))`; unify the
// WHOLE instance POSITION-WISE (a1=P1 .. an=Pn) by carrying it as the nominal
// type `TName(E, [a..])` and letting unify_types walk the args. The old flow
// unified EVERY payload to ONE var (unify_payload_in_names) — fine when an effect
// had a single payload, but result()->r gives Iterate two (element, r), and
// collapsing them cross-wires the element to the result var: `a ~ r ~ [b] ~
// [f(a)] ~ …`, the infinite type the occurs-check then rejects. One instance,
// one unify; the positions never cross (register_effect_ops names this: "the
// install unifies the whole instance per-position").
fn unify_install_payload(body_row, handled, right, span: ValidSpan) = match handler_payload_ty(lookup_ty(right)) {
  None => (),
  // Unify the handler's ONE instance with EVERY same-named instance the body
  // performed — not just the last. A multi-payload effect fragments across its
  // perform sites (yield's Iterate(el,r), result's Iterate(el',r')); the
  // handler is where the single instance is established (§4③), so every
  // fragment collapses to it HERE. Reading `last(insts)` left the others
  // floating — result()->r's accumulator never threaded, so the `++` operand
  // floored to emit_concat_unresolved (the m3 concat census). This is the
  // Carried-Truth read at the install: the row already knows Iterate's
  // instances; the install unifies them all to the handler, never a side-car
  // reconcile pass re-deriving the fact after the fact.
  Some(pty) => unify_instances_to(pty, instances_in_row(body_row, handled), 0, span),
}

// Unify a target instance `pty` with each of `insts`, collapsing every fragment
// of one effect to a single identity. The arg positions are unified by joining
// their HANDLES directly (ty_arg_handle) — a `TVar`'s handle IS its graph node,
// so union-find needs no wrapper. Minting a wrapper node per pair was the
// allocation that wrapped the never-freeing bump image (the old reconcile's
// wild-write); this join is allocation-free on the common var-arg case, so it is
// safe even on the hot per-add seam. Top-level recursion (never `each`): unify
// performs Graph and an effectful lambda under a functor hits the arm-internal-
// perform gap.
fn unify_instances_to(pty, insts, i, span: ValidSpan) = if i >= len(insts) {
  ()
} else {
  unify_instance_args(tname_args(pty), tname_args(list_index(insts, i)), 0, span)
  unify_instances_to(pty, insts, i + 1, span)
}

// Unify two instances' arg Tys position-wise by their handles (union-find join).
fn unify_instance_args(args_a, args_b, i, span: ValidSpan) = if i >= len(args_a) || i >= len(args_b) {
  ()
} else {
  unify(
    ty_arg_handle(list_index(args_a, i)),
    ty_arg_handle(list_index(args_b, i)),
    span,
    Inferred("effect instance position")
  )
  unify_instance_args(args_a, args_b, i + 1, span)
}

// A Ty's graph handle: a TVar IS its handle (join directly, no allocation); a
// concrete arg is minted+bound once (rare — instance args are fresh vars).
fn ty_arg_handle(ty) = match ty {
  TVar(h) => h,
  _ => {
    let h = mint(Inferred("instance arg"))
    graph_bind(h, ty, Inferred("instance arg"))
    h
  },
}

fn tname_args(ty) = match ty {
  TName(_, args) => args,
  _ => [],
}

// The handler's instance type from a `Handler(P, A)` value type. P is the
// WHOLE effect instance (bound by unify_op_payload to `TName(E, [args])`), so
// unify_types walks it per-position against the body's performed instance.
fn handler_payload_ty(ty) = match ty {
  TName(n, args) => if n == "Handler" {
    match args {
      [inner, _] => Some(inner),
      _ => None,
    }
  } else {
    None
  },
  _ => None,
}

// What a handler answers, from its value type `Handler(P, A)` — or from the
// result of a configured handler's scheme, which a bare reference to it
// instantiates whole.
fn handler_answer_ty(ty) = match ty {
  TName(n, args) => if n == "Handler" {
    match args {
      [_, answer] => Some(answer),
      _ => None,
    }
  } else {
    None
  },
  TFun(_, res, _) => handler_answer_ty(res),
  _ => None,
}

// AN ARM'S VALUE IS THE INSTALL'S VALUE. An arm that does not resume answers
// the install, and one that resumes answers it with what the remainder
// answered, so every arm is judged into the handler's answer, and each
// install meets that answer with its own body's. Until 2026-10-03 the
// handler's type carried its effect's instance and not its answer, and no
// install ever met it: an arm answering a String under an Int body compiled
// clean and ran (`tests/micros/mn-arm-answer-is-the-install.mn`), and an arm
// that observed its answer was emitted at the floor, its answer a variable
// no install bound (`tests/micros/mn-arm-answer-observed.mn`).
// The right side IS a handler: whatever it is — a declaration, a value, a
// parameter — its type meets `Handler(P, A)` at the install, so a field
// holding an Int or a function is refused where it stands, and an install of
// it was silent until 2026-10-15 (`tests/micros/mn-install-of-a-non-handler.mn`).
fn install_answer(right, body_answer_h, span: ValidSpan, reason) = unify_types(
  installed_handler_ty(lookup_ty(right)),
  TName("Handler", [TVar(mint(Inferred("the instance an install handles"))), TVar(body_answer_h)]),
  span,
  reason
)

// A configured handler named bare is the zero-argument product
// (`note_bare_handler_product`): what it installs is its scheme's result.
fn installed_handler_ty(ty) = match ty {
  TFun(_, res, _) => res,
  TInt
  | TFloat
  | TUnit
  | TByte
  | TAddr
  | TList(_)
  | TTuple(_)
  | TVar(_)
  | TName(_, _)
  | TRecord(_)
  | TRecordOpen(_, _)
  | TRefined(_, _)
  | TReprPin(_, _)
  | TCont(_, _, _, _)
  | TAlias(_, _) => ty,
}

// What an install's value stands on — the one reason the tee node is bound
// with and the install's unify is asked with: through `~>`, the first arm
// whose value is its own, located where it was written (a `resume` tail
// hands the remainder's answer through, which is the body's), or the
// attachment itself when every arm resumes. So a mismatch at the install
// reads `Int vs List(Byte) — ~> pipe → at 13:3-13:27: inferred from the arm
// bail of handler h`, and the caret's Why at the tee reaches the arm.
fn install_reason(hd, right, span: ValidSpan) =
  Located(span, InferredPipeResult("~>", answer_reason(hd, right)))

fn answer_reason(hd, right) = match published_kind(hd) {
  Some(HandlerKind(_, _, _, _, arms)) => match find(arm_own_value, arms) {
    Some(arm) => Located(
      graph_span_of(arm.body),
      Inferred("the arm {handler_arm_op_name(arm)} of handler {callee_name(right)}")
    ),
    None => Inferred("handler attachment"),
  },
  _ => Inferred("handler attachment"),
}

// An arm whose value is the install's: a tail of its own past every
// `resume` (`arm_tails`, the value walk's reader of the same fact).
fn arm_own_value(arm) = len(arm_tails(arm.body)) > 0

// The type args of a parameterized effect's payload (EAType only; a scalar
// effect arg like Sample(44100) carries no type).
fn eparam_arg_tys(args) = flatten(map({ EAType(t) => [t], _ => [] }, args))

// EVERY performed instance of effect `ename` in a row, each as the nominal type
// `TName(E, [a1..an])` (so unify walks it position-wise). A multi-payload effect
// yields one entry per perform site; the install (unify_instances_to) collapses
// them to the handler's one instance. list_to_flat so the caller's list_index is
// O(1). Bare ENamed / EPure carry no instance and contribute nothing.
fn instances_in_row(row, ename) = match row {
  EfRow(names, _, _) => instances_in_names(names, ename),
  _ => [],
}

fn instances_in_names(names, ename: String) = {
  let enh = intern_str(ename)
  list_to_flat(flatten(map(
    {
      EParameterized(nm, args) => if nm == enh { [TName(ename, eparam_arg_tys(args))] } else { [] },
      ENamed(_) => [],
      // EffName is ENamed | EParameterized | EPure — TOTAL. EPure carries no
      // instance (nothing-drops law, peer subst_eff_names).
      EPure => [],
    },
    names
  )))
}

// The five verbs, each inferred by its topology.
// `PFanout` (`<|`/`><`) and `PTee` are handled BEFORE `infer_pipe` fires
// (see `PipeExpr` arm in `infer_expr`); their arms here are unreachable stubs.
fn infer_pipe(kind, left, right, handle, span: ValidSpan) = match kind {
  // |> converge — right applied to left. Transparent wire;
  // unification pairs slots structurally (Parameters ARE tuples).
  // THE ONE-WAY PIPE EDGE (the call edge's twin — D9 rung 1's
  // B1+B3+charge arc): on the bound path the expectation's row IS
  // the stage's own row, so unify_row meets identical rows and
  // no-ops — a pipe never teaches its stage's cell (D5) — and the
  // charge is the stage's row VERBATIM, live edges intact, folding
  // at read time. A pre-free stage (a lambda, a local, a loose
  // forward) binds to the expectation wholesale, so the fresh row
  // cell becomes its own row cell and the same charge arm carries
  // the polymorphic share; the old FnScheme share-guard dissolves —
  // one-way discipline makes the shared cell read-only to callers,
  // and a loose forward's edge now resolves late instead of
  // charging nothing. The unify-failure path charges nothing.
  PForward => {
    // drift-audit: ignore — "return" is a Reason string; "|>" is a string literal key, not a pipe verb
    let ret_h = mint(InferredPipeResult("|>", Inferred("return")))
    let erow = match graph_chase(right) {
      GNode(NBound(TFun(_, _, srow0)), _) => srow0,
      _ => mk_ef_open([], graph_fresh_row(InferredPipeResult("|>", Inferred("effects")))),
    }
    // THE MERGE (PLAN §4②, Faust's `,` then `:`): a product the site
    // BUILDS, piped into a stage whose N slots are open, fills them —
    // `(a) >< (b) |> f` is `f(a, b)` and costs what it costs, since the
    // tuple is never built (`product_fills_stage`, graph.mn, read here
    // for the expectation and at lower for the splice). A stage with ONE
    // open slot takes the product whole, as any value does.
    let expected = TFun(pipe_stage_params(left, right), TVar(ret_h), erow)
    let expected_h = mint(InferredPipeResult("|>", Inferred("expected fn")))
    graph_bind(expected_h, expected, Located(span, InferredPipeResult("|>", Inferred("expected"))))
    unify(right, expected_h, span, InferredPipeResult("|>", Inferred("target")))
    graph_bind(handle, TVar(ret_h), Located(span, InferredPipeResult("|>", Inferred("result"))))
    // A stage is APPLIED to the piped value, so the pipe is a refinement
    // construction site as a call's argument is: the stage's parameter
    // claims of the value what its contract demands, pays the row the
    // precondition guards where the claim is open, and a parameter stage
    // learns what it is handed. The pipe raised nothing until P0·H:
    // `0 |> inv` under `!Trap` checked clean and divided by zero (boot
    // 13e8484a and the P0 tree alike).
    // The left product's own charge, decided here because the stage's
    // arrow is what decides it: a merge builds nothing, and a product
    // the stage takes WHOLE is the record it was (`product_fate`'s
    // `PfByPipe`, graph.mn).
    if product_arity_at(left) > 1 && !product_fills_stage(left, right) {
      inf_add_row_at(left, construction_row())
    } else {
      ()
    }
    call_owes(fn_leaves(right), [left], handle, span)
    match graph_chase(right) {
      GNode(NBound(TFun(_, _, crow)), _) => inf_add_row_unified_at(
        handle,
        if product_fills_stage(left, right) { crow } else { stage_row(handle, right, left, crow) }
      ),
      _ => (),
    }
  },
  // PFanout (<| and ><) is handled BEFORE infer_pipe fires (see the
  // PipeExpr arm in infer_expr → infer_fanout). Its branches run under
  // a branching-ledger scope so parallel consumes collide correctly.
  //
  // unreachable; handled in infer_fanout
  PFanout(_) => (),
  // A tee is judged by `infer_pipe_tee` before `infer_pipe` fires (the
  // PipeExpr arm in infer_expr dispatches it there): the install's answer
  // met with the body's, its row, its reason naming the arm that answers.
  //
  // unreachable; handled in infer_pipe_tee
  PTee => (),
  // <~ feedback types by unification, its RHS checked as a FeedbackSpec.
  // The iterative context is the clock, inferred rather than demanded
  // (SYNTAX §«<~»): a `<~` prior is a per-site line the enclosing
  // function's next call advances, so the site requires no ambient effect.
  PFeedback => {
    // SYNTAX §«<~» — the recurrence form: `((prev) => body) <~ delay(1)`
    // binds PREV to the PRIOR ITERATION'S OUTPUT, so the lambda's param
    // unifies with its own result (y[n-1] has y's type — the prior
    // carries the forward path's refinement row for free) and the verb's
    // value IS that result. A bare LHS is the feed-forward form: the verb
    // carries its value through. The RHS names WHAT flows back — a
    // FeedbackSpec value — and is checked as one; it is never unified
    // with the FLOW (the arrow~spec unify that stood here mismatched all
    // 15 recurrence sites, SYNTAX's own canonical lowpass included).
    match graph_chase(left) {
      // THE BODY'S ROW IS THE SITE'S ROW. This destructure sent the
      // recurrence lambda's row to `_row` and dropped it, so a forbidden
      // effect performed inside the cycle never reached the enclosing
      // fn: `fn cycle() with !E` around `((prev) => prev + bump()) <~
      // Delay(1)` CHECKED CLEAN. The verb is pure topology, but what the
      // body performs is still performed — the edge JOINS, it does not
      // substitute (Hβ.effects.feedback-row-substitutes; repros at
      // tests/frontier/mn-feedback-negation.mn and -transport.mn).
      GNode(NBound(TFun(params, ret_ty, lam_row)), _) => {
        inf_add_row_at(handle, lam_row)
        if len(params) == 1 {
          unify_types(
            param_ty(list_index(params, 0)),
            ret_ty,
            span,
            InferredPipeResult("<~", Inferred("the prior is the prior output"))
          )
          graph_bind(handle, ret_ty, Located(span, InferredPipeResult("<~", Inferred("recurrence result"))))
        } else {
          graph_bind(handle, TVar(left), Located(span, InferredPipeResult("<~", Inferred("feedback"))))
        }
      },
      _ => graph_bind(handle, TVar(left), Located(span, InferredPipeResult("<~", Inferred("feedback")))),
    }
    unify_types(
      TVar(right),
      TName("FeedbackSpec", [TVar(mint(Inferred("feedback state element")))]),
      span,
      InferredPipeResult("<~", Inferred("the RHS is a state element"))
    )
    // What the site's declared depth has to answer for, both arms of
    // the one read that also SIZES the line at lower.
    //
    // THE CAUSALITY RULE — Faust's, at Mentl's typed altitude: a cycle
    // whose declared delay is ZERO has no computable value, the prior
    // being the very output being computed. (Negative reads the same
    // way, and cannot size a line either.)
    //
    // THE SAYABILITY RULE: a line is a fixed set of declared slots, so
    // a depth known only at runtime is a depth the medium cannot hold
    // — and handing that site one slot is the silent wrong this whole
    // read exists to end.
    //
    // Both productive (report, keep typing) and both ARMED, so neither
    // reaches an executable.
    match feedback_depth(right) {
      DepthLiteral(n) => if n <= 0 { report(EZeroDelayFeedback(span)) } else { () },
      DepthComputed => report(EComputedDelayDepth(span)),
      DepthUnstated => (),
    }
  },
}

// What depth does this `<~` RHS DECLARE? One read, and every judgment
// about a feedback site's delay line is an arm of it: the causality
// refusal above, and lower's slot count for the line itself.
//
// The depth is decidable exactly when it is written as a literal —
// `delay(3)` through the prelude fn or `Delay(3)` through the
// constructor, the two spellings of one FeedbackSpec variant. The callee
// name IS the authored intent, and reading it is reading the graph.
type FeedbackDepth
  // an authored literal — the line is exactly this many priors deep
  = DepthLiteral(Int)
  // `delay(n - 1)` — the depth is a runtime value, so no static line
  // can hold it; refused at the arm rather than silently given one slot
  | DepthComputed
  // a state element that names no depth (accumulate / filter_spec): its
  // prior is the previous tick's value, one slot, nothing to read
  | DepthUnstated

fn feedback_depth(spec) = match graph_node_body(spec) {
  NExpr(CallExpr(callee, args)) => match graph_node_body(callee) {
    NExpr(VarRef(fname)) => if is_delay_spec_name(fname) { delay_arg_depth(args) } else { DepthUnstated },
    _ => DepthUnstated,
  },
  _ => DepthUnstated,
}

// The two spellings of the FeedbackSpec depth variant — prelude's `delay`
// wrapper and the `Delay` constructor it builds.
fn is_delay_spec_name(fname: String) = fname == "delay" || fname == "Delay"

fn delay_arg_depth(args) = if len(args) == 0 {
  DepthUnstated
} else {
  match graph_node_body(list_index(args, 0)) {
    NExpr(LitInt(n)) => DepthLiteral(n),
    _ => DepthComputed,
  }
}

// Fanout-verb inference (W2 · W3) — ONE path for `<|` and `>< `, the
// two surfaces of the one parallel-fanout topology discriminated by
// input ownership (the `FanOwnership` aspect the glyph authors). Both
// run their sub-branches inside an `affine_ledger` branching frame
// (`branch_enter` / `branch_divider` / `branch_exit`); the handler
// pairwise-checks cross-branch consumes at `branch_exit`, reporting
// `E_OwnershipViolation` for any name consumed in two or more parallel
// branches.
//
// A VERB DRAWS AN EDGE; IT DOES NOT SCHEDULE. The fanout contributes
// ZERO effects of its own — `effects_of(fanout) = ⋃ branch rows` — so
// there is NO injected `Thread` row (the deleted category error: a verb
// writing an EXECUTION fact into the topology layer). WHO runs the
// branches is a `~>` handler choice (Seq/Thread/Simd/Gpu), read LIVE at
// lower from the installed chain — never re-derived here. Closes peer
// Hβ.infer.pcompose-independence-not-thread (named at the old
// infer.mn:1131 Thread inject).
//
// The two AST shapes are reconciled by the ownership aspect:
//   `FanDistribute` (`><`) — the N-ary FanoutExpr carrier (the N-ary
//       law, Hβ.parser.pcompose-nary): branches are PEERS in a list,
//       each its own value boundary. Result `TTuple` of N branch types.
//       The PipeExpr(PFanout(FanDistribute)) arm delegates — the kind
//       survives as the census/glyph key, not a constructed shape.
//   `FanShare` (`<|`) — INPUT-vs-N-tuple: one input ref-borrowed into a
//       `MakeTupleExpr` of N branches (degenerate single-branch + empty
//       `<| ()` forms). Result `TTuple` of branch return types, or the
//       single branch's type.
// Net-new follow-up (positive-form, NOT folded into this collapse):
// Hβ.infer.fanout-ownership-from-use-count — derive the share-vs-own
// reading from branch-input use-count (the 0/1/2+ inference that drives
// own/ref, §4⑤) and project the glyph at fmt, so an `own` value through
// `<|` surfaces E_OwnershipViolation and a shared input under `><`
// fmt-canonicalizes to `<|`. Today the aspect is authored by the glyph;
// ownership CHECKS coherence in that follow-up.
fn infer_fanout(fan_own, left, right, handle, span: ValidSpan) = match fan_own {
  FanDistribute => infer_fanout_nary([left, right], handle, span),
  FanShare => infer_fanout_share(left, right, handle, span),
}

fn infer_fanout_nary(branches, handle, span: ValidSpan) = {
  branch_enter(BParallel)
  let edges = infer_fanout_nary_branches(branches, span, 0, len(branches))
  branch_exit(span)
  // THE VERB COSTS WHAT ITS DESUGARING COSTS. Under the sequential schedule
  // the branches are evaluated in the frame the fanout stands in and the
  // tuple of their results is a record only where it ESCAPES, so a fanout
  // taken apart where it stands charges nothing — its `let` spelling
  // charges nothing (`product_fate`, graph.mn, whose facts the lowering
  // reads to bind the parts). A spawning schedule's thunks and
  // tickets are the install's cost, which the install itself charges, and
  // a schedule TWIN demanded into a callee whose row does not say `Alloc`
  // is refused at the settle point by the allocation audit
  // (`Hβ.effects.schedule-twin-row`).
  charge_product(handle)
  graph_boundary_set(handle, FanoutBoundary(edges))
  graph_bind(
    handle,
    TTuple(map(boundary_result_ty, edges)),
    Located(span, Inferred(">< parallel fanout — branches affinity-checked"))
  )
}

// Each branch its own value boundary, a divider between consecutive
// pairs (infer_fanout_share_branches' exact shape, one label per
// position so the boundary Reasons stay distinguishable).
fn infer_fanout_nary_branches(branches, span: ValidSpan, i, n) = if i >= n {
  []
} else {
  let edge = infer_fanout_value_boundary(list_index(branches, i), span, int_to_str(i))
  if i + 1 < n { branch_divider(span) }
  let rest = infer_fanout_nary_branches(branches, span, i + 1, n)
  [edge] ++ rest
}

// A `><` branch is evaluated behind a compiler-created zero-argument boundary.
// Give every layer of that boundary its own graph identity: `result_h` is the
// branch evaluation, `carrier_h` is the one-field product transported through a
// word-uniform scheduler, and `thunk_h` is the executable
// `() -> carrier_h`. The nested InferCtx frame owns the thunk's exact row; once
// closed, that row flows into the enclosing fanout just as a lambda row does.
fn infer_fanout_value_boundary(branch, span: ValidSpan, label: String) = {
  let result_h = mint(InferredPipeResult("><", Inferred("{label} branch result")))
  let carrier_h = mint(InferredPipeResult("><", Inferred("{label} branch carrier")))
  let thunk_h = mint(InferredPipeResult("><", Inferred("{label} executable boundary")))
  let thread_ticket_h = mint(InferredPipeResult("><", Inferred("{label} thread schedule ticket")))
  let persist_ticket_h = mint(InferredPipeResult("><", Inferred("{label} persist schedule ticket")))
  let thunk_row_h = graph_fresh_row(InferredPipeResult("><", Inferred("{label} boundary effects")))
  // drift-audit: ignore — two independent frame inputs (row handle, answer handle) — one frame record's fields, not parallel arrays
  inf_enter_fn(thunk_row_h, span, [])
  inf_mark_transparent()
  ages_branch_open(branch)
  infer_expr(branch)
  graph_bind(
    result_h,
    TVar(branch),
    Located(span, InferredPipeResult("><", Inferred("{label} branch evaluation")))
  )
  let older_stores = ages_branch_close()
  exit_frame()
  let thunk_row = mk_ef_open([], thunk_row_h)
  graph_bind(
    carrier_h,
    TTuple([TVar(result_h)]),
    Located(span, InferredPipeResult("><", Inferred("{label} boundary carrier")))
  )
  graph_bind(
    thunk_h,
    TFun([], TVar(carrier_h), thunk_row),
    Located(span, InferredPipeResult("><", Inferred("{label} zero-argument boundary")))
  )
  graph_bind(
    thread_ticket_h,
    TName("ThreadHandle", []),
    Located(span, InferredPipeResult("><", Inferred("{label} thread schedule ticket")))
  )
  graph_bind(
    persist_ticket_h,
    TName("PersistHandle", []),
    Located(span, InferredPipeResult("><", Inferred("{label} persist schedule ticket")))
  )
  inf_add_row_at(branch, thunk_row)
  BoundaryEdge(result_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h, older_stores)
}

fn boundary_result_ty(edge) = match edge {
  BoundaryEdge(result_h, _, _, _, _, _) => TVar(result_h),
}

// The `FanShare` (`<|`) shape of fanout inference — one input
// ref-borrowed into N branches. Input is inferred once; each branch
// receives a BORROW of the input's value. Branches run under the
// branching ledger so any two branches that consume the same
// outer-scope own collide.
fn infer_fanout_share(left, right, handle, span: ValidSpan) = {
  infer_expr(left)
  // The stages the parse guarantees: a tuple of two or more, since a `<|`
  // over one stage is the pipe (`share_stages`, graph.mn).
  let branches = share_stages(right)
  branch_enter(BParallel)
  let edges = infer_fanout_share_branches(branches, left, span, 0, len(branches))
  branch_exit(span)
  // The tuple of the branches' results, a record only where it
  // escapes — the same rule, and the same cost, `><` pays.
  charge_product(handle)
  // The right side is the tuple of STAGES it denotes; the fanout node alone
  // owns the tuple of application results.
  graph_bind(
    right,
    TTuple(collect_tvar_types(branches)),
    Located(span, Inferred("<| fanout — tuple of branch stages"))
  )
  graph_boundary_set(handle, FanoutBoundary(edges))
  graph_bind(
    handle,
    TTuple(map(boundary_result_ty, edges)),
    Located(span, Inferred("<| fanout — result type is branch-output tuple"))
  )
}

// Each `<|` branch is APPLIED to the borrowed input — lower emits
// `LCall(branch, input)`, so infer must model the SAME application or the two
// disagree: a stateful branch's effect row (`verify_pending_at → Verify`) never
// reaches the enclosing scope, so its evidence goes uncaptured (the felt-read
// ev-seam), and the result is mistyped as the branch FUNCTION rather than its
// OUTPUT. This mirrors `infer_call_saturated`, with one borrowed input arg.
fn infer_fanout_share_branches(branches, input_h, span: ValidSpan, i, n) = if i >= n {
  []
} else {
  let edge = infer_fanout_apply_one(list_index(branches, i), input_h, span)
  if i + 1 < n { branch_divider(span) }
  // Keep the recursive tail named. A bare `[edge]` immediately after the
  // `if` is postfix indexing in Mentl's grammar, so it indexes the divider's
  // Unit result instead of constructing the branch-edge prefix.
  let rest = infer_fanout_share_branches(branches, input_h, span, i + 1, n)
  [edge] ++ rest
}

fn infer_fanout_apply_one(branch, input_h, span: ValidSpan) = {
  let ret_h = mint(InferredPipeResult("<|", Inferred("branch result")))
  let carrier_h = mint(InferredPipeResult("<|", Inferred("branch carrier")))
  let thunk_h = mint(InferredPipeResult("<|", Inferred("executable boundary")))
  let thread_ticket_h = mint(InferredPipeResult("<|", Inferred("thread schedule ticket")))
  let persist_ticket_h = mint(InferredPipeResult("<|", Inferred("persist schedule ticket")))
  let thunk_row_h = graph_fresh_row(InferredPipeResult("<|", Inferred("boundary effects")))
  let call_row_h = graph_fresh_row(InferredPipeResult("<|", Inferred("implicit application effects")))
  let expected = TFun(build_inferred_params([input_h]), TVar(ret_h), mk_ef_open([], call_row_h))
  let expected_h = mint(Inferred("<| branch expected fn"))
  // Infer the authored stage and its implicit application inside the boundary's
  // row frame. The frame closes onto thunk_row_h; only that exact row is then
  // projected into the enclosing function.
  //
  // drift-audit: ignore — two independent frame inputs (row handle, answer handle) — one frame record's fields, not parallel arrays
  inf_enter_fn(thunk_row_h, span, [])
  inf_mark_transparent()
  ages_branch_open(branch)
  // The branch is a STAGE applied to the borrowed input, judged as a `|>`
  // stage is: completed or bound in place, minting nothing.
  infer_stage(branch, 1)
  graph_bind(expected_h, expected, Located(span, Inferred("<| branch applied to the borrowed input")))
  unify(branch, expected_h, span, Inferred("<| branch borrows the shared input"))
  // The branch call's row flows into the boundary frame — the same
  // read-the-callee's-own-row discipline infer_call_saturated uses — and
  // what the stage writes is asked of the input it is handed.
  match graph_chase(branch) {
    GNode(NBound(TFun(_, _, brow)), _) => inf_add_row_unified_at(branch, stage_row(branch, branch, input_h, brow)),
    _ => match graph_chase(call_row_h) {
      GNode(NRowBound(row), _) => inf_add_row_unified_at(branch, row),
      GNode(NRowFree(_), _) => inf_add_row_at(branch, mk_ef_open([], call_row_h)),
      _ => (),
    },
  }
  let older_stores = ages_branch_close()
  exit_frame()
  let thunk_row = mk_ef_open([], thunk_row_h)
  graph_bind(
    carrier_h,
    TTuple([TVar(ret_h)]),
    Located(span, InferredPipeResult("<|", Inferred("boundary carrier")))
  )
  graph_bind(
    thunk_h,
    TFun([], TVar(carrier_h), thunk_row),
    Located(span, InferredPipeResult("<|", Inferred("zero-argument boundary")))
  )
  graph_bind(
    thread_ticket_h,
    TName("ThreadHandle", []),
    Located(span, InferredPipeResult("<|", Inferred("thread schedule ticket")))
  )
  graph_bind(
    persist_ticket_h,
    TName("PersistHandle", []),
    Located(span, InferredPipeResult("<|", Inferred("persist schedule ticket")))
  )
  inf_add_row_at(branch, thunk_row)
  BoundaryEdge(ret_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h, older_stores)
}

// Unification — graph-direct, Hazel-productive.
// Every unification carries the span of the AST site that triggered
// it. `span` threads through the recursive walk; `graph_bind` writes
// store `Located(span, reason)`, which is what `graph_reason_at` reads
// back at any handle the walk touched.
fn unify(h_a, h_b, span: ValidSpan, reason) = {
  // Union-find: find both ROOTS (graph_chase_handle follows the TVar
  // chain to the canonical handle), then union the ROOTS — never the
  // surface aliases. Binding the surface re-points an aliased use-site
  // (NBound(TVar(root))) and strands `root` free, so lower reads the
  // param local type-blind and `word == "fn"` emits pointer i32.eq. The
  // root-equality guard stops a root being bound to a handle that chases
  // back to it (the self-cycle a record unification would loop on).
  let ra = graph_chase_handle(h_a)
  let rb = graph_chase_handle(h_b)
  if ra == rb {
    ()
  } else {
    let na = graph_chase(ra)
    let nb = graph_chase(rb)
    match na {
      GNode(ka, _) => match nb {
        GNode(kb, _) => match ka {
          NFree(_) => {
            // The demands the vanishing root carries ride to the surviving
            // root (demands_ride) before the alias is drawn.
            demands_ride(ra, rb, span)
            graph_bind(ra, TVar(rb), Located(span, reason))
          },
          NBound(ta) => match kb {
            NFree(_) => {
              demands_push(graph_demands_of(rb), ta, span)
              graph_bind(rb, TVar(ra), Located(span, reason))
            },
            NBound(tb) => unify_types(ta, tb, span, reason),
            NErrorHole(_) => (),
            _ => (),
          },
          NErrorHole(_) => (),
          _ => (),
        },
      },
    }
  }
}

// Type-name equality with the String proof pinned at the boundary (the sibling
// of effects.mn's field_name_eq). A bare `==` on two nominal type names emits
// pointer-eq under the seed, so names interned in different passes never match;
// pinning `: String` makes it the structural str_eq. One home for the compare.
fn type_name_eq(a: String, b: String) with Pure = a == b

fn unify_types(ref a, ref b, span: ValidSpan, reason) = {
  let right_is_wrapper = match b {
    TAlias(_, _) => true,
    TRefined(_, _) => true,
    TReprPin(_, _) => true,
    _ => false,
  }
  let left_is_wrapper_or_var = match a {
    TVar(_) => true,
    TAlias(_, _) => true,
    TRefined(_, _) => true,
    TReprPin(_, _) => true,
    _ => false,
  }
  if right_is_wrapper && !left_is_wrapper_or_var {
    match b {
      TAlias(_, inner_b) => unify_types(a, inner_b, span, reason),
      // The pin is a gradient INPUT (§4① — an annotation, not a type):
      // identity unifies at the base; only emission reads the width.
      TReprPin(_, base_b) => unify_types(a, base_b, span, reason),
      // A concrete type meets the refined wrapper: unify against the BASE
      // only. The refinement OBLIGATION is never accrued here — this arm
      // has no value node, so its old verify pended the raw predicate with
      // `self` unsubstituted, forever undecidable, one noise entry per
      // refined-param unification. The value-bearing homes own the
      // discharge: the let annotation and the fn return
      // (apply_refinement_constraint via subst_self) and the call boundary
      // (discharge_arg_refinements — R2's third site).
      TRefined(base_b, _) => unify_types(a, base_b, span, reason),
      _ => (),
    }
  } else {
    match a {
      TInt => expect_same(a, b, span, reason),
      TFloat => expect_same(a, b, span, reason),
      // String IS [byte] (§4①): a String unifies with a byte list, and with any
      TUnit => expect_same(a, b, span, reason),
      // The byte scalar routes through the ground check like every word
      // (expect_same reads same_ground's Byte~Byte and the Byte~Int
      // value-equality); without this arm TByte fell to the catch-all's
      // type_mismatch and refused Byte vs Byte itself.
      TByte => expect_same(a, b, span, reason),
      // An address meets only an address: same_ground holds no Int arm
      // for it, so the number an address is never was and is a mismatch.
      TAddr => expect_same(a, b, span, reason),
      TVar(ha) => match b {
        TVar(hb) => unify(ha, hb, span, reason),
        // A cell holds a shape (`shape_of`), so a refinement never enters
        // it: the variable meets the BASE, as every other arm meets a
        // refinement. Binding the wrapper ran the occurs check over a base
        // that may be the cell itself — a provision over a function's
        // position is `TRefined(TVar(c), …)` around that position's own cell
        // — and `fn max_by(f, xs) = reduce(xs, …)` in the prelude refused as
        // an infinite type (H4·D's first m2).
        TRefined(base_b, _) => unify_types(a, base_b, span, reason),
        // CARRIED-TRUTH: the left handle may ALREADY be bound (a use-site handle the graph
        // proved — e.g. a lambda arg's `(r) -> ret`). Read it live: if NBound,
        // unify `b` AGAINST that existing type, never `graph_bind` over it. The
        // raw bind discards the proof and orphans its inner vars — the config-fn
        // /HOF field-access disconnect (a callee's resolved param type bound
        // onto the lambda handle erased the lambda's own arrow, so the param
        // never met the binder and its field read floored on an open row). A
        // genuinely-free var still binds.
        _ => {
          let root = graph_chase_handle(ha)
          match graph_chase(root) {
            GNode(NBound(inner), _) => unify_types(inner, b, span, reason),
            GNode(_, mint_reason) => if occurs_in_live(root, b) {
              report(EOccursCheck(root, b, span))
              // The poly-recursion teach rides the refusal: an infinite
              // type running through a fn's OWN param/return mint is the
              // self-call-at-a-different-type shape's fingerprint — name
              // the fn and the signature route (the refusal stands; the
              // narration is the question that beats the guess).
              match mint_reason {
                FnParam(owner, _, _) => report(TPolyRecursionSignature(owner, span)),
                FnReturn(owner, _) => report(TPolyRecursionSignature(owner, span)),
                _ => (),
              }
            } else {
              // A FUNCTION type entering a gated cell is a row write: the
              // gate on the cell (a terminal whose sort was still open when
              // the declaration gated it) judges the fn's row here, since
              // graph_bind is not graph_bind_row and would otherwise carry
              // the row past every gate.
              match b {
                TFun(_, _, brow) => gate_check_push(root, brow, span),
                _ => (),
              }
              // The same writer's demand half: every demand the cell carries
              // judges or reads the type entering it (demands_push).
              demands_push(graph_demands_of(root), b, span)
              graph_bind(root, b, Located(span, reason))
            },
          }
        },
      },
      TList(ea) => match b {
        TList(eb) => unify_types(ea, eb, span, ListElement(reason)),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TTuple(ea) => match b {
        TTuple(eb) => unify_type_lists(ea, eb, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TFun(pa, ra, ea) => match b {
        TFun(pb, rb, eb) => {
          // DESIGN Ch 2 Insight 7: parameters ARE tuples. When arities
          // match, pair positionally. When one side has a single-param
          // TTuple(N) and the other has N params, decompose and pair
          // element-wise. When one side has a single TVar param, bind
          // it to a TTuple of the other side's param types. The same
          // rule handles `fn f(a, b) = ...` called via `|>` with a
          // 2-tuple — no splat operator, no adapter, just structural
          // pairing that the graph already knows how to do.
          pair_fn_params(pa, pb, span, reason)
          unify_types(ra, rb, span, FnReturn("fn", reason))
          unify_row(ea, eb, span, reason)
        },
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TName(na, aa) => match b {
        // type_name_eq pins the String proof: a bare `na == nb` on two type
        // names carries no proof through the seed's weak inference and emits
        // POINTER-eq, so a name interned in one pass ("Iterate" at
        // register_effect_ops) never matches the byte-identical name interned
        // in another (the handler's instance at register_handler) — the args
        // then skip unify_type_lists and every effect-instance position stays
        // free (fold's accumulator floored at `acc ++ xs`). The §9 name-compare
        // class; the field_name_eq precedent, one home for the type-name compare.
        TName(nb, ab) => if type_name_eq(na, nb) {
          unify_type_lists(aa, ab, span, reason)
        } else {
          type_mismatch(a, b, span, reason)
        },
        // A nominal RECORD satisfies a structural field demand by its own
        // declaration, read through the live env edge (RecordSchemeKind —
        // the same channel the literal check and the ctor arrow view
        // read). The brand never erases: this side stays TName; only the
        // demand's field vars and row residual bind. This is what makes
        // `p.age` on a nominal receiver and a row-polymorphic parameter
        // (`{name: String, ...}`) accept a nominal record — the canonical
        // SYNTAX forms; before this arm both falsely mismatched. A CLOSED
        // structural demand still refuses (exact-shape identity is the
        // brand's point).
        TRecordOpen(fb, vb) => match nominal_record_fields(na) {
          Some(declared) => unify_record_open_against_closed(declared, fb, vb, span, reason),
          None => type_mismatch(a, b, span, reason),
        },
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TRecord(fa) => match b {
        TRecord(fb) => unify_record_fields_closed(fa, fb, span, reason),
        TRecordOpen(fb, vb) => unify_record_open_against_closed(fa, fb, vb, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TRecordOpen(fa, va) => match b {
        TRecord(fb) => unify_record_open_against_closed(fb, fa, va, span, reason),
        TRecordOpen(fb, vb) => unify_two_open_records(fa, va, fb, vb, span, reason),
        TName(_, _) => unify_types(b, a, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      // Refined types unify by their BASES; no arm here accrues an
      // obligation — unification has no value node, so a raw-pred verify
      // pends `self` unsubstituted forever (the noise class the debt
      // surfacing exposed). The value-bearing homes own the discharge:
      // the let annotation, the fn return, and the call boundary
      // (apply_refinement_constraint / discharge_arg_refinements —
      // subst_self against the live node). Refined-vs-refined predicate
      // IMPLICATION is the SMT band's question (Hβ.verify.smt-handler-swap),
      // never a conjunction pended at the unify.
      TRefined(base_a, _) => match b {
        TRefined(base_b, _) => unify_types(base_a, base_b, span, reason),
        _ => unify_types(base_a, b, span, reason),
      },
      TCont(ria, saa, da, wa) => match b {
        TCont(rib, sab, db, wb) => {
          // The continuation's TYPE carries four facts; unify ALL four. (1)
          // resume input R. (2) answer S. (3) resume cardinality:
          // OneShot/MultiShot are distinct
          // representations (stack frame vs heap record), so a mismatch is a
          // hard E_ResumeWorldMismatch. (4) the effect-WORLD: a row unification at the
          // resume edge — resuming a continuation under a changed handler-set
          // is unify(captured_world, resume_site_world). !E lifted to the TIME
          // axis (§4③ modal frontier); a now-unhandled resume is a compile/load
          // error, never a silent memcpy'd miscompile (Law 7).
          unify_types(ria, rib, span, reason)
          unify_types(saa, sab, span, reason)
          if disciplines_compatible(da, db) { () } else { report(EResumeWorldMismatch(da, db, span)) }
          unify_row(wa, wb, span, reason)
        },
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      // RN.2 — Unification alias preservation
      TAlias(name, inner_a) => match b {
        TVar(_) => unify_types(b, a, span, reason),
        TAlias(_, inner_b) => unify_types(inner_a, inner_b, span, reason),
        _ => unify_types(inner_a, b, span, reason),
      },
      // The pin peels like the alias (RN.2's shape): a var binds the
      // PINNED type (repr_of chases to the pin); anything else meets the base.
      TReprPin(_, base_a) => match b {
        TVar(_) => unify_types(b, a, span, reason),
        _ => unify_types(base_a, b, span, reason),
      },
      _ => match b {
        TVar(_) => unify_types(b, a, span, reason),
        TAlias(_, inner_b) => unify_types(a, inner_b, span, reason),
        TRefined(base_b, _) => unify_types(a, base_b, span, reason),
        TReprPin(_, base_b) => unify_types(a, base_b, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
    }
  }
}

fn expect_same(ref a, ref b, span: ValidSpan, reason) = match b {
  // The var may ALREADY be bound — a constructor-argument reference is
  // NBound(TVar(binder)), the graph's live proof that the arg IS the
  // param. A raw graph_bind(hb, a) CLOBBERS that binding, orphaning the
  // binder: the arg reference learns the scalar, the parameter never does
  // (a Float ctor field left the param an unresolved var → i32 floor →
  // f64-through-i32 trap). Flip to the one canonical var path (every other
  // unify arm does) — it chases hb live, unifies the scalar against the
  // bound inner (binding the binder for a free chain, reporting a genuine
  // mismatch for a bound-to-conflicting-scalar chain the raw bind masked).
  TVar(_) => unify_types(b, a, span, reason),
  _ => if same_ground(a, b) { () } else { type_mismatch(a, b, span, reason) },
}

// H6: exhaustive Ty enumeration. Ground scalars match their same-
// variant; compound types are structurally equal only if their
// sub-parts are unified separately (that's unify_types' job, not
// same_ground's). A new scalar Ty must be added here explicitly.
fn same_ground(ref a, ref b) with Pure = match a {
  // §4①/STEP 0: a byte VALUE and an Int are ground-EQUAL — both are the one
  // word (repr RI32) — and this acceptance is CHECK-level only: same_ground
  // never binds, so a [byte] node never REWRITES to [Int] (no re-stride by
  // unification, ever; fold_sig keeps "b" != "i"). The check-level form is
  // forced by inference order: under the Stage Law the datum infers LAST, so
  // `map((b) => b - 32, s)` types the lambda while `b` is still free — b binds
  // Int, and only the CALL's param unify meets TByte; a strict split would
  // refuse the canonical case. The SLOT stays protected where slots actually
  // live: reads follow the runtime stride carrier (any stride, always honest),
  // construction follows the RESULT type, the one typed stride-1 store traps
  // out-of-range (store_strided, the bounds-trap precedent), and str_payload
  // normalizes stride at the materialization boundary. The compile-time
  // narrowing gate (ground Int proven 0..255 via R3) is the named refinement
  // tier on top — Hβ.infer.byte-narrowing-ground-discharge.
  TInt => match b {
    TInt => true,
    TByte => true,
    _ => false,
  },
  TFloat => match b {
    TFloat => true,
    _ => false,
  },
  TUnit => match b {
    TUnit => true,
    _ => false,
  },
  TByte => match b {
    TByte => true,
    TInt => true,
    _ => false,
  },
  TAddr => match b {
    TAddr => true,
    _ => false,
  },
  // Compound types: same_ground rejects; unify_types handles structurally
  TVar(_) => false,
  TList(_) => false,
  TTuple(_) => false,
  TFun(_, _, _) => false,
  TName(_, _) => false,
  TRecord(_) => false,
  TRecordOpen(_, _) => false,
  TRefined(_, _) => false,
  TCont(_, _, _, _) => false,
  TAlias(_, inner) => same_ground(inner, b),
  // The pin is a gradient INPUT (an annotation, not a type — §4①):
  // identity is the base's; only emission reads the width.
  TReprPin(_, base) => same_ground(base, b),
}

// Two resume cardinalities unify iff they pick the SAME representation: the
// stack frame (OneShot), the heap continuation record (MultiShot) and the
// dead continuation (Abandon) are three, and any two that differ are the
// conflict E_ResumeWorldMismatch names. The pins carry the equality's proof.
fn disciplines_compatible(a: ResumeDiscipline, b: ResumeDiscipline) with Pure = a == b

fn unify_type_lists(as_list, bs_list, span: ValidSpan, reason) = if len(as_list) == 0 && len(bs_list) == 0 {
  ()
} else if len(as_list) == 0 || len(bs_list) == 0 {
  // Arity mismatch: tuple/list lengths differ.
  report(ETypeArityMismatch(len(as_list), len(bs_list), span))
} else {
  unify_types(last(as_list), last(bs_list), span, reason)
  unify_type_lists(drop_last(as_list), drop_last(bs_list), span, reason)
}

// Both field lists arrive sorted by name (parser invariant + smart
// constructor `mk_record_open`). Closed×closed: pointwise field
// equality (length match + name match + type unify). Closed×open:
// the closed record must include every open-side field; remaining
// fields bind the open's row variable. Open×open: intersect known
// fields; bind one variable to the residual relative to the other.
fn unify_record_fields_closed(fa, fb, span: ValidSpan, reason) = if len(fa) != len(fb) {
  type_mismatch(TRecord(fa), TRecord(fb), span, reason)
} else {
  unify_record_fields_loop(fa, fb, 0, len(fa), span, reason)
}

fn unify_record_fields_loop(fa, fb, i, n, span: ValidSpan, reason) = if i >= n {
  ()
} else {
  match list_index(fa, i) {
    (na, ta) => match list_index(fb, i) {
      (nb, tb) => if field_name_eq(na, nb) {
        unify_types(ta, tb, span, reason)
        unify_record_fields_loop(fa, fb, i + 1, n, span, reason)
      } else {
        type_mismatch(TRecord(fa), TRecord(fb), span, reason)
      },
    },
  }
}

// The nominal record's declared fields, read through the live env edge —
// the third reader of RecordSchemeKind (the literal check and the ctor
// arrow view are the other two; one channel, three readers). None for a
// name that is not a nominal record.
fn nominal_record_fields(name) = match env_lookup(name) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      RecordSchemeKind(declared) => Some(declared),
      _ => None,
    },
  },
  None => None,
}

// AN OPEN ROW MEETS A CLOSED RECORD. The open row is read to its end: every
// field its chain has learned must be a field of the record (their types
// unify), and the rest — the chain's free terminal — is exactly what the
// record has left. Only the terminal is written. Writing the row's HEAD
// instead, as this did until 2026-09-28, overwrote whatever residual the
// head already carried, so a second call site's record replaced the first's
// in the same cell.
fn unify_record_open_against_closed(closed_fields, open_fields, open_var, span: ValidSpan, reason) = match record_row_full(open_fields, open_var) {
  (known, end) => {
    unify_record_open_subset(known, closed_fields, span, reason)
    let residual = record_fields_diff(closed_fields, known)
    match end {
      // PROVEN. The other side is closed, so its fields are the whole set
      // and the rest is exactly what remains — nothing further can arrive.
      RowEndFree(t) => record_row_write(t, residual, RowClosed, span, reason),
      // Both ends closed: one record, so one field set.
      RowEndClosed => if len(residual) == 0 {
        ()
      } else {
        type_mismatch(TRecord(closed_fields), TRecord(known), span, reason)
      },
    }
  },
}

fn unify_record_open_subset(needed, available, span: ValidSpan, reason) = if len(needed) == 0 {
  ()
} else {
  match last(needed) {
    (n, t) => {
      let pos = find_record_field_pos(available, n)
      if pos < 0 {
        type_mismatch(TRecord(needed), TRecord(available), span, reason)
      } else {
        match list_index(available, pos) {
          (_, t2) => {
            unify_types(t, t2, span, reason)
            unify_record_open_subset(drop_last(needed), available, span, reason)
          },
        }
      }
    },
  }
}

// TWO OPEN ROWS MEET, and a record row variable is a union-find citizen like
// any type variable: both rows are read to their ends, the fields both know
// unify (a field access's demand is CHECKED against what the graph proved,
// never written over it), and each side's free rest learns the fields only
// the other knew. A closed end refuses a field it does not have — a
// residual proven whole makes a name outside it provably absent (`{a: 1, b:
// 2}` destructured once let `rest.aa` read b's slot). Only free terminals
// are written, so no fact already in a chain is ever overwritten.
fn unify_two_open_records(fa, va, fb, vb, span: ValidSpan, reason) = match record_row_full(fa, va) {
  (ka, ea) => match record_row_full(fb, vb) {
    (kb, eb) => {
      unify_record_fields_loop_shared(ka, kb, intersect_record_fields(ka, kb), span, reason)
      let extra_a = record_fields_diff(ka, kb)
      let extra_b = record_fields_diff(kb, ka)
      match ea {
        RowEndClosed => match eb {
          RowEndClosed => if len(extra_a) == 0 && len(extra_b) == 0 {
            ()
          } else {
            type_mismatch(TRecord(ka), TRecord(kb), span, reason)
          },
          RowEndFree(tb) => row_end_closes(tb, extra_a, extra_b, ka, kb, span, reason),
        },
        RowEndFree(ta) => match eb {
          RowEndClosed => row_end_closes(ta, extra_b, extra_a, kb, ka, span, reason),
          RowEndFree(tb) => rows_meet(ta, extra_b, tb, extra_a, ka, kb, span, reason),
        },
      }
    },
  },
}

// A free rest meeting a closed record: it is exactly what the record has and
// the open side lacks — and the open side may not know anything the record
// does not.
fn row_end_closes(t, rest, stray, closed, open, span: ValidSpan, reason) = if len(stray) == 0 {
  record_row_write(t, rest, RowClosed, span, reason)
} else {
  type_mismatch(TRecord(closed), TRecord(open), span, reason)
}

// Two free rests. The same rest with different known fields is one record
// disagreeing with itself. Different rests with the same fields ARE one
// row, so one aliases the other. Otherwise each rest is what the other side
// knew plus whatever neither has seen, and that unseen part is ONE row
// variable both continue at: a later closing through either side reaches
// the other, and it is a variable, so generalization quantifies it and every
// caller closes its own. The rows these once met as, the union written as
// the whole row with nothing standing for the rest, was the defect
// `Hβ.infer.record-row-vars-are-not-unioned` named: no variable to
// generalize, so every caller of a helper reading two fields shared one
// residual and the last caller's record set every caller's offsets.
fn rows_meet(ta, extra_b, tb, extra_a, ka, kb, span: ValidSpan, reason) = if ta == tb {
  if len(extra_a) == 0 && len(extra_b) == 0 {
    ()
  } else {
    type_mismatch(TRecord(ka), TRecord(kb), span, reason)
  }
} else if len(extra_a) == 0 && len(extra_b) == 0 {
  demands_ride(tb, ta, span)
  graph_bind(tb, TVar(ta), Located(span, reason))
} else if len(extra_b) == 0 {
  record_row_write(tb, extra_a, RowContinues(ta), span, reason)
} else if len(extra_a) == 0 {
  record_row_write(ta, extra_b, RowContinues(tb), span, reason)
} else {
  let unseen = graph_fresh_row(Located(span, reason))
  record_row_write(ta, extra_b, RowContinues(unseen), span, reason)
  row_learns_past(tb, extra_a, unseen, span, reason)
}

// A write the first one may have moved: the first write's row can be the
// base or the copy of an update this row is the other side of, so this row
// is read to its end again — a field it learned meanwhile is one field with
// the written one — and what remains is written there, the row continuing at
// the rest both sides share.
fn row_learns_past(t, fields, next, span: ValidSpan, reason) = match record_row_full([], t) {
  (known, end) => {
    unify_record_fields_loop_shared(fields, known, intersect_record_fields(fields, known), span, reason)
    let fresh = record_fields_diff(fields, known)
    match end {
      RowEndFree(e) => {
        let re = graph_chase_handle(e)
        let rn = graph_chase_handle(next)
        if len(fresh) > 0 {
          let behind = if re == rn { graph_fresh_row(Located(span, reason)) } else { rn }
          record_row_write(re, fresh, RowContinues(behind), span, reason)
        } else if re == rn {
          ()
        } else {
          demands_ride(re, rn, span)
          graph_bind(re, TVar(rn), Located(span, reason))
        }
      },
      RowEndClosed => if len(fresh) == 0 { () } else { type_mismatch(TRecord(fields), TRecord(known), span, reason) },
    }
  },
}

fn unify_record_fields_loop_shared(fa, fb, names, span: ValidSpan, reason) = if len(names) == 0 {
  ()
} else {
  let n = last(names)
  let pa = find_record_field_pos(fa, n)
  let pb = find_record_field_pos(fb, n)
  if pa >= 0 && pb >= 0 {
    match list_index(fa, pa) {
      (_, ta) => match list_index(fb, pb) {
        (_, tb) => unify_types(ta, tb, span, reason),
      },
    }
  }
  unify_record_fields_loop_shared(fa, fb, drop_last(names), span, reason)
}

fn intersect_record_fields(fa, fb) = {
  let n = len(fa)
  match intersect_record_fields_loop(fa, fb, 0, n, make_list(n), 0) {
    (buf, count) => slice(buf, 0, count),
  }
}

fn intersect_record_fields_loop(fa, fb, i, n, own buf, count) = if i >= n {
  (buf, count)
} else {
  match list_index(fa, i) {
    (name, _) => match if find_record_field_pos(fb, name) >= 0 {
      let extended = list_extend_to(buf, count + 1)
      let written = list_set(extended, count, name)
      (written, count + 1)
    } else {
      (buf, count)
    } {
      (next_buf, next_count) => intersect_record_fields_loop(fa, fb, i + 1, n, next_buf, next_count),
    },
  }
}

fn record_fields_diff(left, right) = {
  let n = len(left)
  match record_fields_diff_loop(left, right, 0, n, make_list(n), 0) {
    (buf, count) => slice(buf, 0, count),
  }
}

fn record_fields_diff_loop(left, right, i, n, own buf, count) = if i >= n {
  (buf, count)
} else {
  let entry = list_index(left, i)
  match entry {
    (name, _) => match if find_record_field_pos(right, name) < 0 {
      let extended = list_extend_to(buf, count + 1)
      let written = list_set(extended, count, entry)
      (written, count + 1)
    } else {
      (buf, count)
    } {
      (next_buf, next_count) => record_fields_diff_loop(left, right, i + 1, n, next_buf, next_count),
    },
  }
}

fn find_record_field_pos(fields, name) = find_record_field_pos_loop(fields, name, 0, len(fields))

fn find_record_field_pos_loop(fields, name: String, i, n) = if i >= n {
  -1
} else {
  match list_index(fields, i) {
    (existing, _) => if field_name_eq(existing, name) { i } else { find_record_field_pos_loop(fields, name, i + 1, n) },
  }
}

// Infer each field's value expression; result handles are used by
// callers to build `TRecord` field-type lists and region-join sets.
fn infer_record_field_values(fields) = if len(fields) == 0 {
  ()
} else {
  match last(fields) {
    (_, value) => {
      infer_expr(value)
      infer_record_field_values(drop_last(fields))
    },
  }
}

fn build_record_field_types(fields) = map({ (name, value) => (name, TVar(value)) }, fields)

// H4.1 projection — pull the value handles out of a record-field list
// for region-join lookup. Field names aren't needed for region
// tracking; only the per-value handles matter.
fn record_field_handles(fields) = map({ (_, value) => value }, fields)

// H2.3: validate a nominal record literal's fields against the
// declared schema. Both lists arrive sorted by field name (parser
// sort + RecordSchemeKind sort invariant). Pointwise check:
//   - missing declared field    → E_RecordFieldMissing
//   - extra unknown field       → E_RecordFieldExtra
//   - matched name              → unify value's handle with declared ty
fn check_nominal_record_fields(declared, provided, type_name, span: ValidSpan) =
  check_nominal_record_loop(declared, provided, type_name, span, 0, 0, len(declared), len(provided))

fn check_nominal_record_loop(declared, provided, type_name, span: ValidSpan, i, j, ni, nj) = if i >= ni && j >= nj {
  ()
} else if i >= ni {
  // Provided has extras
  match list_index(provided, j) {
    (extra, _) => {
      report(ERecordFieldExtra(extra, type_name, span))
      check_nominal_record_loop(declared, provided, type_name, span, i, j + 1, ni, nj)
    },
  }
} else if j >= nj {
  match list_index(declared, i) {
    (missing, _) => {
      report(ERecordFieldMissing(missing, type_name, span))
      check_nominal_record_loop(declared, provided, type_name, span, i + 1, j, ni, nj)
    },
  }
} else {
  match list_index(declared, i) {
    (dn, dt) => match list_index(provided, j) {
      (pn, pv) => if field_name_eq(dn, pn) {
        let expect_h = mint(Inferred("record field type"))
        graph_bind(expect_h, dt, Located(span, Inferred("declared field type")))
        unify(pv, expect_h, span, OpConstraint("record field", Inferred("declared"), Inferred("provided")))
        // A declared field type is a STATED position, claimed as a
        // constructor's argument is: a refined value claims its
        // refinement, a function crossing in pays what it demands beyond
        // what the field type provides, and an unannotated parameter
        // placed there learns the contract. The unify alone met the
        // shapes, so `R{den: 0}` under `type R = {den: Positive}`
        // compiled clean, and `Ops{f: inv}` under `{f: (Int) -> Int}`,
        // built behind `fn mk()`, let `mk().f(0)` divide by zero under
        // `!Trap` (pin 852184886f52a848, S6).
        learn_precondition(pv, dt)
        claim_refinement(dt, pv, graph_span_of(pv))
        check_nominal_record_loop(declared, provided, type_name, span, i + 1, j + 1, ni, nj)
      } else if str_lt(dn, pn) {
        report(ERecordFieldMissing(dn, type_name, span))
        check_nominal_record_loop(declared, provided, type_name, span, i + 1, j, ni, nj)
      } else {
        report(ERecordFieldExtra(pn, type_name, span))
        check_nominal_record_loop(declared, provided, type_name, span, i, j + 1, ni, nj)
      },
    },
  }
}

fn unify_param_lists(ref a, ref b, span: ValidSpan, reason) = if len(a) == 0 || len(b) == 0 {
  ()
} else {
  let ta = param_ty(last(a))
  let tb = param_ty(last(b))
  unify_types(ta, tb, span, reason)
  unify_param_lists(drop_last(a), drop_last(b), span, reason)
}

// Parameters pair POSITIONALLY, arity for arity. This fn carried a second
// rule until 2026-09-27 — "parameters ARE tuples": a single tuple-typed or
// free parameter decomposed against N parameters, so a pipe could deliver
// a pair to a two-parameter function without a splat. The emit never
// realized that rule on any shape, measured the day a pair-destructuring
// arm literal handed to fold trapped inside the wheel's own build: piping
// a pair into a two-parameter function trapped at the indirect call,
// calling one with a single pair returned 0 silently, and a two-parameter
// function passed where a pair-taking callback was called trapped — four
// programs that checked clean and executed unproven. A type-layer rule
// the calling convention does not carry is a miscompile with a signature,
// so the shapes REFUSE here (E_FnArityMismatch) and the capability is the
// calling-convention landing, `Hβ.lower.parameter-product-calling-convention`.
fn pair_fn_params(pa, pb, span: ValidSpan, reason) = if len(pa) == len(pb) {
  unify_param_lists(pa, pb, span, reason)
} else {
  arity_mismatch(len(pa), len(pb), span)
}

fn arity_mismatch(la, lb, span: ValidSpan) = report(EFnArityMismatch(la, lb, span))

// The subscript's generic path — total over sequences: the receiver
// forces to a list of the fresh element (a String receiver peels
// through its alias to the byte list, so the element binds TByte).
// The tuple-const route in the IndexExpr arm runs FIRST; this force is
// what a free or sequence receiver takes, and what reports the honest
// mismatch when a runtime-variable index meets a heterogeneous product.
// The subscript receiver's SHALLOW read: the root's own binding,
// alias-peeled — never the deep fold (chase_deep_at's depth belt is
// for value-boundary folds, not a mid-judgment probe). An unbound or
// non-tuple root answers TUnit here, which no tuple arm matches — the
// caller falls to the generic force.
fn index_receiver_shallow(rh) = match graph_chase(rh) {
  GNode(NBound(rty), _) => fold_strip(rty),
  _ => TUnit,
}

fn infer_index_force(rh, ih, handle, span: ValidSpan) = {
  let elem_h = mint(Inferred("subscript element"))
  let exp_r = mint(Inferred("subscript receiver"))
  graph_bind(exp_r, TList(TVar(elem_h)), Located(span, Inferred("subscript receiver")))
  unify(rh, exp_r, span, Inferred("subscript receiver"))
  graph_bind(handle, TVar(elem_h), Located(span, Inferred("subscript result")))
  // PARTIALITY IS A ROW FACT, one primitive over (TRAP): the read traps
  // where `0 <= i < len(xs)` fails, so the site raises that precondition as
  // the claim it is (PInBounds) and reads the ledger's verdict — proven, the
  // read is the unchecked traversal and charges no Trap; refuted, the ledger
  // refuses at the site; open, the checked read's own row carries the Trap.
  // The verdict is written on the index node where the lowering reads which
  // read to emit, both ways, so a handle a rolled-back judgment wrote is
  // overwritten by the judgment of the node that holds it now.
  let proven = match verify_claim(
    graph_module_current(),
    span,
    PInBounds(rh, ih),
    Located(span, Inferred("a sequence read is partial"))
  ) {
    Some(held) => held,
    None => false,
  }
  graph_narrow_set(ih, if proven { 1 } else { 0 })
  // An open claim is the site's own row fact, as an open division's is: the
  // Trap is charged here, read off the claim, never only through whichever
  // callee the link happens to carry (a program judged with no library
  // still traps at the read).
  if proven { () } else { inf_add_row_at(handle, trap_row()) }
  // The sugar calls what its lowering performs: `xs[i]` emits the read the
  // claim's verdict chose, so the node is linked to it and charges its
  // declared row (`sugar_calls`). The tuple-const route stays chargeless:
  // its extraction is compile-time.
  sugar_calls(handle, handle, subscript_callee(proven))
}

fn type_mismatch(ref a, ref b, span: ValidSpan, reason) = report(ETypeMismatch(a, b, reason, span))

// ─── The numeric gate — arithmetic's demand on a type cell ───────────
// `+ - * / %` and unary `-` unify their operands and ask one more thing of
// them: a NUMBER. A bound operand is judged on the spot
// (arith_operand_class); a free one carries the demand as a gate
// (NumericGate, the gate mechanism's type-cell arm beside the row gate).
// The one writer — unify's var binds — judges every type that later
// enters a gated cell: a word passes, a variable inherits the gates, an
// aggregate refuses E_ArithOnAggregate naming the arithmetic's site.
// Instantiation copies the gates onto the fresh var (demands_copy), and a
// copy minted before the demand is reached through the instance column.
// So `{x: 1} * {x: 2}` refuses at the operator, a generic `a * b` refuses
// `{x: 1}` at the call that instantiates it, and a floor twin's arithmetic
// at emit is a word by construction — a wide instantiation mints its own
// twin and binds the var under it; an aggregate never reaches a bind. The
// gate is one kind in the cell's demand column (TypeDemand); the shape
// read below is the other, and both ride the same writer.
fn numeric_gates_of(cell) = flat_map(demand_number, graph_demands_of(cell))

fn demand_number(d) = match d {
  DemandNumber(g) => [g],
  DemandShape(_) | DemandLacks(_) | DemandCopy(_, _, _) => [],
}

fn numeric_demand(lh, op, span: ValidSpan) = {
  let root = graph_chase_handle(lh)
  match graph_chase(root) {
    GNode(kind, _) => match kind {
      NFree(_) => numeric_gate_install(root, NumericGate({op, span}), span),
      NBound(ty) => match arith_operand_class(ty) {
        AoWord => (),
        AoAggregate => report(EArithOnAggregate("`{binop_to_str(op)}` on {show_type(ty)}", span)),
        AoUnproven(v) => numeric_gate_install(v, NumericGate({op, span}), span),
      },
      NErrorHole(_) => (),
      _ => (),
    },
  }
}

// An operand already bound to an aggregate refuses its arithmetic site — the
// demand's bound case, judged before the operands meet so it is the site's
// one diagnostic.
fn arith_refuses(h, op, span: ValidSpan) = match graph_chase(graph_chase_handle(h)) {
  GNode(NBound(ty), _) => match arith_operand_class(ty) {
    AoAggregate => {
      report(EArithOnAggregate("`{binop_to_str(op)}` on {show_type(ty)}", span))
      true
    },
    _ => false,
  },
  _ => false,
}

fn numeric_gate_op(g: NumericGate) = match g {
  NumericGate(r) => r.op,
}

fn numeric_gate_span(g: NumericGate) = match g {
  NumericGate(r) => r.span,
}

// Dedup at the install, BY SITE: one arithmetic site enters a cell once,
// however many paths reach it (an alias hop, an instance already bound
// back to its root) — which is also what terminates the walk on a cycle.
fn numeric_gate_present(gs: [NumericGate], g: NumericGate) = match gs {
  [] => false,
  [h, ...rest] => if numeric_gate_span(h) == numeric_gate_span(g) { true } else { numeric_gate_present(rest, g) },
}

// Install on a cell: enter the gate, judge what the cell ALREADY holds (a
// copy bound before its root was demanded of), reach every instance the
// column noted under it, and follow an alias to the free terminal the
// writes land on — the row gate's gate_install, one sort over.
fn numeric_gate_install(cell, g: NumericGate, span: ValidSpan) = if numeric_gate_present(numeric_gates_of(cell), g) {
  ()
} else {
  graph_demand_add(cell, DemandNumber(g))
  match graph_chase(cell) {
    GNode(kind, _) => match kind {
      NBound(ty) => numeric_judge_push([g], ty, span),
      _ => (),
    },
  }
  numeric_install_instances(graph_instances_of(cell), g, span)
  let r = graph_chase_handle(cell)
  if r == cell { () } else if numeric_cell_is_free(r) { numeric_gate_install(r, g, span) } else { () }
}

fn numeric_cell_is_free(v) = match graph_chase(v) {
  GNode(NFree(_), _) => true,
  _ => false,
}

fn numeric_install_instances(is, g: NumericGate, span: ValidSpan) = match is {
  [] => (),
  [i, ...rest] => {
    numeric_gate_install(i, g, span)
    numeric_install_instances(rest, g, span)
  },
}

fn numeric_gates_install(gs: [NumericGate], cell, span: ValidSpan) = match gs {
  [] => (),
  [g, ...rest] => {
    numeric_gate_install(cell, g, span)
    numeric_gates_install(rest, cell, span)
  },
}

// Judge a type entering gated cells: a word passes, a variable (under any
// wrapper) inherits every gate, an aggregate refuses once, naming the
// first demand's site.
fn numeric_judge_push(gs: [NumericGate], ty, span: ValidSpan) = match gs {
  [] => (),
  [g, ..._] => match arith_operand_class(ty) {
    AoWord => (),
    AoAggregate => report(EArithOnAggregate(
      "`{binop_to_str(numeric_gate_op(g))}` on {show_type(ty)}, demanded at {show_span(numeric_gate_span(g))}",
      span
    )),
    AoUnproven(v) => numeric_gates_install(gs, v, span),
  },
}

// The checking writer at a var→var bind: every demand the vanishing root
// carries rides to the surviving root — judged or pushed against what it
// holds, or entered on it while it is free.
fn demands_ride(ra, rb, span: ValidSpan) = {
  let ds = graph_demands_of(ra)
  if len(ds) == 0 {
    ()
  } else {
    match graph_chase(rb) {
      GNode(kind, _) => match kind {
        NFree(_) => demands_install(ds, rb, span),
        NRowFree(_) => demands_install(ds, rb, span),
        NBound(tb) => demands_push(ds, tb, span),
        NRecordRowBound(fields, tail) => {
          each(shape_push_row(??, fields, tail), flat_map(demand_shape, ds))
          rows_reach(ds, rb, span)
        },
        _ => (),
      },
    }
  }
}

// A row variable's demands reaching a row already bound: what it lacks is
// judged against the fields the row holds and carried to its free end, and
// an update's relation is kept in step from there.
fn rows_reach(ds, rb, span: ValidSpan) = match record_row_full([], rb) {
  (fields, end) => {
    let lacks = flat_map(demand_lacks, ds)
    let held = filter(field_named_in(lacks, ??), fields)
    if len(held) > 0 { row_lacks_refuse(held, rb, span, Inferred("a row variable's alias")) }
    let copies = flat_map(demand_copy, ds)
    match end {
      RowEndFree(t) => {
        row_lacks_install(t, lacks)
        each(row_copy_carry(t, ??), copies)
      },
      RowEndClosed => (),
    }
    each(rows_in_step(??, span, Inferred("a row variable's alias")), copies)
  },
}

// A type entering a cell that carries demands: each number judges it, each
// shape pushes into the variables it holds.
fn demands_push(ds: [TypeDemand], ty, span: ValidSpan) = {
  numeric_judge_push(flat_map(demand_number, ds), ty, span)
  each(shape_push(??, ty), flat_map(demand_shape, ds))
}

fn demands_install(ds: [TypeDemand], cell, span: ValidSpan) =
  each(demand_install(cell, ??, span), ds)

fn demand_install(cell, d, span: ValidSpan) = match d {
  DemandNumber(g) => numeric_gate_install(cell, g, span),
  DemandShape(read) => shape_install(cell, read),
  DemandLacks(_) | DemandCopy(_, _, _) => graph_demand_add(cell, d),
}

fn demand_shape(d) = match d {
  DemandShape(read) => [read],
  DemandNumber(_) | DemandLacks(_) | DemandCopy(_, _, _) => [],
}

fn demand_lacks(d) = match d {
  DemandLacks(names) => names,
  DemandNumber(_) | DemandShape(_) | DemandCopy(_, _, _) => [],
}

// Instantiation's copy: the fresh var carries every demand its root does
// (the qualified-type reading, `∀t. numeric(t) ⇒ …`, with the constraint on
// the variable — the row gate's gates_copy, one sort over). For a shape it
// is the whole propagation: a callee's read, copied onto the instance, meets
// the caller's own variable at the argument edge and marks it. An update's
// relation names another cell, so it is copied once every quantified cell
// has its copy (`relations_copy`).
fn demands_copy(ds: [TypeDemand], fresh) = match ds {
  [] => (),
  [d, ...rest] => {
    match d {
      DemandNumber(_) | DemandShape(_) | DemandLacks(_) => graph_demand_add(fresh, d),
      DemandCopy(_, _, _) => (),
    }
    demands_copy(rest, fresh)
  },
}

// An update's relation, copied with its two rows on their copies. The
// relation names the two whole rows, and by the time a scheme is taken they
// agree on every field either knows, so the instance relates what is still
// unknown: each row's free end, read through the mapping — whole only once
// every quantified cell has been minted. An end the scheme did not quantify,
// or a row already closed, stays the cell it is.
fn relations_copy(mapping) = each(relation_copy(mapping, ??), mapping)

fn relation_copy(mapping, pair) = match pair {
  (root, fresh) => each(relation_copy_one(mapping, fresh, ??), graph_demands_of(root)),
}

fn relation_copy_one(mapping, fresh, d) = match d {
  DemandCopy(base, copy, names) => graph_demand_add(fresh, DemandCopy(mapped_end(mapping, base), mapped_end(mapping, copy), names)),
  DemandNumber(_) | DemandShape(_) | DemandLacks(_) => (),
}

fn mapped_end(mapping, h) = match record_row_full([], h) {
  (_, end) => match end {
    RowEndFree(t) => {
      let r = graph_chase_handle(t)
      let m = find_mapping(mapping, r)
      if m >= 0 { m } else { r }
    },
    RowEndClosed => h,
  },
}

// ─── The shape read — a structural read's demand on a type cell ───────
// The emit dispatches on a type's STRUCTURE at a comparison, a show and a
// hash (the whole type) and at a concat, a field load and a record pattern
// (the outer shape: a list or not, which fields a row holds); everywhere
// else it reads a width. So the variables a body reads the structure of are
// exactly the ones a twin of that body keys by structure, and every other
// one keys by its representation digit (lower.mn's twin_key). The judgment
// holds each such read at its site, so the read is entered there and the
// cells carry it as they carry the numeric gate: pushed into what a marked
// cell is bound to, ridden across an alias, copied at instantiation — which
// is what carries a callee's read into every caller — and reached through
// the instance column. It never refuses. A read the judgment does not mark
// meets a free variable at emit and floors loudly, where the census counts
// it, never onto another instantiation's layout.
//
// It replaced a table the emit built after lowering: a walk of every base
// body and a fixpoint over the call graph that re-ran what instantiation
// and unification had already carried, measured at 66 MB of scratch per
// self-compile (2026-09-28).
fn shape_demand(h, read) = shape_install(graph_chase_handle(h), read)

// A read reaching a cell lands on its root: a free root carries it, and a
// bound one passes it into what it is bound to, so the variables a key can
// ask about hold a mark and the rest of the graph does not. The copies
// instantiation minted from a cell while it was a root are reached through
// the instance column.
fn shape_install(cell, read) = {
  let r = graph_chase_handle(cell)
  match graph_chase(r) {
    GNode(kind, _) => match kind {
      NBound(ty) => {
        shape_push(read, ty)
        shape_reach(r, read)
      },
      NRecordRowBound(fields, tail) => {
        shape_push_row(read, fields, tail)
        shape_reach(r, read)
      },
      _ => shape_mark(r, read),
    },
  }
  if r == cell { () } else { shape_reach(cell, read) }
}

// A free root takes the mark, then its instances do.
fn shape_mark(r, read) = if any(shape_covers(read, ??), graph_demands_of(r)) {
  ()
} else {
  graph_demand_add(r, DemandShape(read))
  each(shape_install(??, read), graph_instances_of(r))
}

// A bound cell's instances, reached once. An instance can alias back to the
// cell it was copied from — a recursive call unifies its copy with the
// declaration's own variable — so the cell keeps the mark as the visit, and
// only where it has instances to reach (without one, the self-compile's
// first form recursed until the stack ran out).
fn shape_reach(cell, read) = match graph_instances_of(cell) {
  [] => (),
  is => if any(shape_covers(read, ??), graph_demands_of(cell)) {
    ()
  } else {
    graph_demand_add(cell, DemandShape(read))
    each(shape_install(??, read), is)
  },
}

// A whole read covers an outer one and a move, since it keys every type it
// meets by its structure and reaches every variable in it. A move reaches as
// far but keys coarser, and an outer read keys as fine but reaches less, so
// neither covers the other. The dedup is also what ends the walk on a cycle.
fn shape_covers(read, d) = match d {
  DemandNumber(_) | DemandLacks(_) | DemandCopy(_, _, _) => false,
  DemandShape(have) => match have {
    WholeShape => true,
    OuterShape => match read {
      OuterShape => true,
      WholeShape => false,
      MovedShape => false,
    },
    MovedShape => match read {
      MovedShape => true,
      WholeShape => false,
      OuterShape => false,
    },
  },
}

fn shape_push(read, ty) = match read {
  WholeShape => each(shape_install(??, WholeShape), shape_whole_roots(ty)),
  OuterShape => each(shape_install(??, OuterShape), shape_outer_roots(ty)),
  MovedShape => each(shape_install(??, MovedShape), shape_whole_roots(ty)),
}

// A record row variable bound to more fields and what follows them.
fn shape_push_row(read, fields, tail) = {
  match read {
    WholeShape => each(shape_install(??, WholeShape), flat_map(field_whole_roots, fields)),
    MovedShape => each(shape_install(??, MovedShape), flat_map(field_whole_roots, fields)),
    OuterShape => (),
  }
  match tail {
    RowClosed => (),
    RowContinues(v) => shape_install(graph_chase_handle(v), read),
  }
}

// Every variable a whole read reaches: the free terminals of the type, read
// through the bindings — a record's fields and the rest of its row, a
// function's parameters and result.
fn shape_whole_roots(t) = match t {
  TVar(h) => match graph_chase(h) {
    GNode(kind, _) => match kind {
      NBound(bound) => shape_whole_roots(bound),
      NFree(_) => [graph_chase_handle(h)],
      _ => [],
    },
  },
  TInt => [],
  TFloat => [],
  TUnit => [],
  TByte => [],
  TAddr => [],
  TList(e) => shape_whole_roots(e),
  TTuple(es) => flat_map(shape_whole_roots, es),
  TFun(ps, r, _) => flat_map(param_whole_roots, ps) ++ shape_whole_roots(r),
  TName(_, args) => flat_map(shape_whole_roots, args),
  TRecord(fs) => flat_map(field_whole_roots, fs),
  TRecordOpen(fs, v) => match record_row_full(fs, v) {
    (all, end) => flat_map(field_whole_roots, all) ++ row_end_roots(end),
  },
  TRefined(b, _) => shape_whole_roots(b),
  TReprPin(_, b) => shape_whole_roots(b),
  TCont(i, a, _, _) => shape_whole_roots(i) ++ shape_whole_roots(a),
  TAlias(_, i) => shape_whole_roots(i),
}

fn param_whole_roots(p) = shape_whole_roots(param_ty(p))

fn field_whole_roots(f) = match f {
  (_, ft) => shape_whole_roots(ft),
}

// The variable an outer read reaches: the one the type is, or the rest of
// the row a record holds. A list, a tuple or a closed record already has
// its outer shape.
fn shape_outer_roots(t) = match t {
  TVar(h) => match graph_chase(h) {
    GNode(kind, _) => match kind {
      NBound(bound) => shape_outer_roots(bound),
      NFree(_) => [graph_chase_handle(h)],
      _ => [],
    },
  },
  TRecordOpen(fs, v) => match record_row_full(fs, v) {
    (_, end) => row_end_roots(end),
  },
  TAlias(_, i) => shape_outer_roots(i),
  TRefined(b, _) => shape_outer_roots(b),
  TInt => [],
  TFloat => [],
  TUnit => [],
  TByte => [],
  TAddr => [],
  TList(_) => [],
  TTuple(_) => [],
  TFun(_, _, _) => [],
  TName(_, _) => [],
  TRecord(_) => [],
  TReprPin(_, _) => [],
  TCont(_, _, _, _) => [],
}

fn row_end_roots(end) = match end {
  RowEndFree(t) => [graph_chase_handle(t)],
  RowEndClosed => [],
}

// A record row variable's write: what it is bound to learns the reads the
// variable carries, then the bind. Every row writer goes through here. A
// field the row lacks refuses, since a record holds one field of each name.
// A row is said to lack names only where a view reads it without the fields
// in front of it — a bound rest, a rest named twice in a signature — since
// every other view holds those fields in front and cannot learn them again;
// so the row past the written fields lacks them, and everything this row
// lacked, exactly when this row lacked anything. Every update relation this
// row's free end carried rides to the next, and the other side of each
// learns what this row learned.
fn record_row_write(t, fields, tail, span: ValidSpan, reason) = {
  let ds = graph_demands_of(t)
  let lacks = flat_map(demand_lacks, ds)
  let held = filter(field_named_in(lacks, ??), fields)
  if len(held) > 0 {
    row_lacks_refuse(held, t, span, reason)
  } else {
    let copies = flat_map(demand_copy, ds)
    each(shape_push_row(??, fields, tail), flat_map(demand_shape, ds))
    graph_bind_record_row(t, fields, tail, Located(span, reason))
    match tail {
      RowContinues(next) => {
        if len(lacks) > 0 { row_lacks_install(next, lacks ++ map(field_name, fields)) }
        each(row_copy_carry(next, ??), copies)
      },
      RowClosed => (),
    }
    each(rows_in_step(??, span, reason), copies)
  }
}

fn demand_copy(d) = match d {
  DemandCopy(_, _, _) => [d],
  DemandNumber(_) | DemandShape(_) | DemandLacks(_) => [],
}

// A row's free end carries a relation once.
fn row_copy_carry(end, d) = {
  let r = graph_chase_handle(end)
  if any({ have => have == d }, graph_demands_of(r)) { () } else { graph_demand_add(r, d) }
}

fn rows_in_step(d, span: ValidSpan, reason) = match d {
  DemandCopy(base, copy, names) => rows_copy(base, copy, names, span, reason),
  DemandNumber(_) | DemandShape(_) | DemandLacks(_) => (),
}

// An update's relation drawn: carried by the free end of both rows, then the
// two brought into step.
fn rows_relate(base, copy, names, span: ValidSpan, reason) = {
  let d = DemandCopy(base, copy, names)
  each(row_copy_carry(??, d), row_free_ends(base) ++ row_free_ends(copy))
  rows_copy(base, copy, names, span, reason)
}

fn row_free_ends(h) = match record_row_full([], h) {
  (_, end) => match end {
    RowEndFree(t) => [t],
    RowEndClosed => [],
  },
}

fn field_name(f) = match f {
  (n, _) => n,
}

fn field_named_in(names, f) = match f {
  (n, _) => any({ m => m == n }, names),
}

fn row_lacks(t) = flat_map(demand_lacks, graph_demands_of(graph_chase_handle(t)))

fn row_lacks_install(t, names) = {
  let r = graph_chase_handle(t)
  let lacked = row_lacks(r)
  let more = filter({ n => !any({ m => m == n }, lacked) }, names)
  if len(more) == 0 { () } else { graph_demand_add(r, DemandLacks(more)) }
}

// THE COPY AN UPDATE MAKES, kept in step with the base it copies: every field
// the base holds outside the written names is a field of the copy, at the
// same type, and every field of the copy is the base's. Both whole rows are
// read to their ends; a field both know is one field, and a field only one
// side knows is written into the other — whose free end carries the
// relation, so that write brings the two into step again — and once the two
// agree on every name either knows, what lies past them is settled.
fn rows_copy(base, copy, names, span: ValidSpan, reason) = match record_row_full([], base) {
  (kb, eb) => match record_row_full([], copy) {
    (kc, ec) => {
      unify_record_fields_loop_shared(kb, kc, intersect_record_fields(kb, kc), span, reason)
      let to_copy = record_fields_diff(filter({ f => !field_named_in(names, f) }, kb), kc)
      let to_base = record_fields_diff(kc, kb)
      if len(to_copy) > 0 {
        row_learns(ec, to_copy, kc, span, reason)
      } else if len(to_base) > 0 {
        row_learns(eb, to_base, kb, span, reason)
      } else {
        // The base's free end lacks every field in front of it, so a
        // written name the base holds is settled; the rest stay open.
        rows_copy_rest(eb, ec, filter({ n => !any({ f => field_name(f) == n }, kb) }, names), span, reason)
      }
    },
  },
}

fn row_lacks_refuse(held, t, span: ValidSpan, reason) = {
  let names = show_list(map(field_name, held), { n => "`{n}`" }, ", ")
  let why = Inferred("a row that lacks {names}, since a field in front of it holds the name")
  type_mismatch(TRecord(held), mk_record_open([], t), span, Unified(reason, why))
}

// One side learns fields the other holds, written at its free end with a
// fresh rest behind them; a closed end holds no more, so the two disagree.
fn row_learns(end, fields, have, span: ValidSpan, reason) = match end {
  RowEndFree(t) => record_row_write(t, fields, RowContinues(graph_fresh_row(Located(span, reason))), span, reason),
  RowEndClosed => type_mismatch(TRecord(fields), TRecord(have), span, reason),
}

// The two rows agree on every name either knows, so only what lies past them
// is open. Past a closed base the copy closes. Past a closed copy the base
// may hold only the written names, which the relation its end carries keeps
// checking. Past two free ends the relation stays on both — until the base
// lacks every written name, when the copy IS the base's rest and the two
// ends are one row.
fn rows_copy_rest(eb, ec, names, span: ValidSpan, reason) = match eb {
  RowEndClosed => match ec {
    RowEndClosed => (),
    RowEndFree(c) => record_row_write(c, [], RowClosed, span, reason),
  },
  RowEndFree(b) => {
    let lacked = row_lacks(b)
    let open = filter({ n => !any({ m => m == n }, lacked) }, names)
    match ec {
      RowEndClosed => if len(open) == 0 { record_row_write(b, [], RowClosed, span, reason) } else { () },
      RowEndFree(c) => {
        let rb = graph_chase_handle(b)
        let rc = graph_chase_handle(c)
        if rb == rc {
          row_lacks_install(rb, open)
        } else if len(open) == 0 {
          demands_ride(rc, rb, span)
          graph_bind(rc, TVar(rb), Located(span, reason))
        } else {
          ()
        }
      },
    }
  },
}

// ─── THE ARENA'S STORE CLAIM — a store's target is as old as what it names ──
//
// An arena's barrier journals a store into memory older than the arena with
// the leaf its value moves through, and a variable's leaf is known only in a
// twin keyed by it, so a store of a variable's value twins its body by the
// class the move needs (`MovedShape`). Keying EVERY store that way was the
// first form (2026-10-03), and it twinned the prelude for buffers no arena
// outlives — `map` 117 times, `fold` 102, the list substrate 152 each — until
// the emission's growth ate the whole of what the arenas reclaimed. A store
// needs the leaf only where its TARGET can be older than an arena open at the
// store, and that is a fact the graph carries along the value's edges:
//   - a target the scope allocated — `alloc`, a literal, a call whose result
//     is fresh — owes nothing;
//   - a declared function's PARAMETER is its callers' question: the function
//     publishes the parameter as stored into, with the cells a move demands
//     (types.mn `StoreClaim`), and each call asks it of its argument
//     (`ages_call`);
//   - a handler's STATE is its installs' question: an install whose body can
//     open an arena demands every cell the arms store into the state
//     (`ages_install`);
//   - anything else — a capture, a module value, a part of another value, an
//     op's result, a closure's parameter — and any target older than an arena
//     the scope opened around the store, demands at the store.
// The barrier itself stands wherever an arena lives and is sound whatever
// this answers: a store whose type the emission cannot see journals opaque,
// and its arena keeps its region. So a wrong answer here costs a kept region
// or a twin, never a wrong program.
//
// The same targets answer what a store CHANGES (`ages_mutation`, below), and
// there a wrong answer is a false proof, so that reading asks of every store:
// the list substrate's, a raw Memory store's, and each argument a callee
// writes.
type StoreTarget = TgParam(Int) | TgState(Int) | TgOlder

// What a scope is to a store: a declared function with its parameters, a
// closure (whose parameters and captures predate any call of it), or a
// handler's arms with its state fields and its config parameters.
type AgeScopeKind = AgeFn([Int]) | AgeClosure | AgeArm(String, [Int], [Int])

// A scope being judged: its kind, the lets it bound with the depth of the
// arenas it had opened around each, the depth now, the parameter stores it
// has noted for an arena, the parameters it writes, the fanout branches open
// in it, each with the sites it has written older memory at, and the calls
// it made into members of its own cycle, read when the cycle ends.
// Each deferred call is its node, its callee and, per argument, what the
// argument is to the frame that hands it: memory older than the frame, and
// the frame's parameters it may be.
type AgeScope = {
  branches: [(Int, [Int])],
  deferred: [(Int, Int, [(Bool, [Int])])],
  depth: Int,
  kind: AgeScopeKind,
  lets: [(Int, Int)],
  mutated: [Int],
  stores: [(Int, [Int])],
}

// The scopes being judged and the binding groups open around them. A
// declaration's claim is the graph's (`graph_store_claim_note`), keyed by
// the declaration, where a call reads it off the edge it already follows and
// a warm start finds it in the image.
effect StoreAges {
  ages_open(AgeScopeKind)
  ages_pop()
  ages_top() -> Option(AgeScope)
  ages_put(AgeScope)
  // A binding group's members, while the group is judged; the calls among
  // them each member defers; and the group's close, handing both back.
  ages_group_open([Int])
  ages_in_group(Int) -> Bool
  // Whether the declaration is a member of a cycle being judged: a group of
  // two or more, whose members' views stay monomorphic until it closes.
  ages_in_cycle(Int) -> Bool
  ages_defer(Int, [(Int, Int, [(Bool, [Int])])])
  ages_group_close() -> ([Int], [(Int, Int, Int, [(Bool, [Int])])])
}

// Groups nest, as a block's run of fns is judged inside a member of the
// group around it.
handler store_ages with scopes = [], groups = [] {
  ages_open(kind) => resume() with scopes = scopes ++ [AgeScope({branches: [], deferred: [], depth: 0, kind, lets: [], mutated: [], stores: []})],
  ages_pop() => resume() with scopes = drop_last(scopes),
  ages_top() => resume(if len(scopes) == 0 { None } else { Some(last(scopes)) }),
  ages_put(s) => resume() with scopes = drop_last(scopes) ++ [s],
  ages_group_open(members) => resume() with groups = push(groups, (members, [])),
  ages_in_group(decl) => resume(if len(groups) == 0 {
    false
  } else {
    match last(groups) {
      (members, _) => any(handle_is(decl, ??), members),
    }
  }),
  ages_defer(caller, calls) => if len(groups) == 0 {
    resume()
  } else {
    match last(groups) {
      (members, deferred) => resume() with groups = push(drop_last(groups), (members, deferred ++ map(deferred_by(caller, ??), calls))),
    }
  },
  ages_in_cycle(decl) => resume(if len(groups) == 0 {
    false
  } else {
    match last(groups) {
      (members, _) => len(members) > 1 && any(handle_is(decl, ??), members),
    }
  }),
  ages_group_close() => if len(groups) == 0 {
    resume(([], []))
  } else {
    resume(last(groups)) with groups = drop_last(groups)
  },
}

fn deferred_by(caller, call) = match call {
  (site, callee, ages) => (caller, site, callee, ages),
}

// A declared function's scope at its top level, a closure's anywhere else: a
// function judged inside another is a value its body can carry anywhere.
fn ages_open_fn(param_handles) = match ages_top() {
  None => ages_open(AgeFn(param_handles)),
  Some(_) => ages_open(AgeClosure),
}

// The claim a declared function publishes as its judgment ends; a nested one
// publishes nothing, its stores having demanded where they stood. A function
// that returns its own recursive call reads that call through the claim being
// formed, so the claim is its LEAST FIXPOINT: it starts at "fresh" and is
// read again through what the last round found until a round adds nothing —
// `list_copy_into` returns its dst parameter or itself, so it returns dst, where
// reading the unpublished call as older made every buffer it grows older too
// (the measured first form: `map` still twinned 119 times). A round can only
// add a parameter or fall to older, so the rounds are bounded by the
// parameters.
//
// A write into a parameter's memory performs Mutate in the function that
// makes it, since `!Mutate` claims its parameters are read only; a caller pays
// it only where the argument it hands is older than its own frame
// (`mutation_masked`). So it joins the row here, after the body's own Mutate
// has said whether the function writes anything beyond them.
fn ages_close_fn(decl, param_handles, body_h) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => match r.kind {
      AgeFn(_) => {
        let stores = map(store_at_index(param_handles, ??), r.stores)
        let mutated = r.mutated |> map(handle_position(param_handles, ??)) |> filter(is_position)
        let beyond = row_names_mutate(inf_current_row())
        if len(mutated) > 0 { inf_add_row(mutate_row()) } else { () }
        ages_defer(decl, r.deferred)
        ages_claim_fixpoint(
          decl,
          scope,
          body_h,
          param_handles,
          {beyond, mutated, returns: Some([]), stores}
        )
        ages_pop()
      },
      AgeClosure => ages_pop(),
      AgeArm(_, _, _) => ages_pop(),
    },
  },
  None => (),
}

// The arms' claim, published where they end, read by each install as a call
// reads its callee's: the config parameters they write, by position, and
// whether they write memory older than the install beyond them. A line they
// tick is the install's own record, which no install pays for.
fn ages_close_arms(decl, config_cells) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => {
      let mutated = r.mutated |> map(handle_position(config_cells, ??)) |> filter(is_position)
      let beyond = row_names_mutate(inf_current_row())
      if len(r.mutated) > 0 { inf_add_row(mutate_row()) } else { () }
      graph_store_claim_note(decl, StoreClaim({beyond, mutated, returns: None, stores: []}))
      ages_pop()
    },
  },
  None => (),
}

fn is_position(i) = i >= 0

fn ages_claim_fixpoint(decl, scope, body_h, params, summary) = {
  graph_store_claim_note(decl, StoreClaim(summary))
  let next = returns_of(store_targets(body_h, scope, ToArena), params)
  if same_claim(next, summary.returns) {
    ()
  } else {
    ages_claim_fixpoint(decl, scope, body_h, params, {...summary, returns: next})
  }
}

fn same_claim(a, b) = match a {
  Some(xs) => match b {
    Some(ys) => len(xs) == len(ys) && all(index_in(ys, ??), xs),
    None => false,
  },
  None => match b {
    Some(_) => false,
    None => true,
  },
}

fn index_in(ys, x) = any(handle_is(x, ??), ys)

// The parameters a result may be, each once.
fn returns_of(targets, params) = if all(target_is_param, targets) {
  Some(fold([], add_index, map(target_param_index(params, ??), targets)))
} else {
  None
}

fn add_index(acc, i) = if index_in(acc, i) { acc } else { push(acc, i) }

fn target_is_param(t) = match t {
  TgParam(_) => true,
  TgState(_) => false,
  TgOlder => false,
}

fn target_param_index(params, t) = match t {
  TgParam(b) => handle_position(params, b),
  TgState(_) => -1,
  TgOlder => -1,
}

fn store_at_index(params, entry) = match entry {
  (b, cells) => (handle_position(params, b), cells),
}

fn handle_position(params, b) = match find(pair_at_handle(b, ??), enumerate(params)) {
  Some(pair) => match pair {
    (i, _) => i,
  },
  None => -1,
}

fn pair_at_handle(b, pair) = match pair {
  (_, h) => h == b,
}

fn handle_is(a, b) = a == b

// A let's value, bound at the depth of the arenas the scope has opened around
// it.
fn ages_let(h) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => ages_put(AgeScope({...r, lets: push(r.lets, (h, r.depth))})),
  },
  None => (),
}

// An arena the scope opens around what follows (1), and closes (-1): what the
// scope held before it is older than every store inside it.
fn ages_depth(delta) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => ages_put(AgeScope({...r, depth: r.depth + delta})),
  },
  None => (),
}

// A store of values of the cells' types into the value at `target_h`.
fn ages_store(target_h, cells) = match ages_top() {
  Some(scope) => each(ages_settle(scope, cells, ??), store_targets(target_h, scope, ToArena)),
  None => each(demand_move, cells),
}

// A store into a binder itself — a state commit's. A commit into the arm's
// own state is already the field's write (`StateFact.writes`, noted before
// any arm was judged), so it notes nothing more: the install reads it there.
fn ages_store_binder(b, cells) = match ages_top() {
  Some(scope) => each(commit_settle(scope, cells, ??), binder_targets(b, scope, ToArena)),
  None => each(demand_move, cells),
}

fn commit_settle(scope, cells, t) = match t {
  TgState(_) => (),
  TgParam(_) => ages_settle(scope, cells, t),
  TgOlder => ages_settle(scope, cells, t),
}

fn ages_settle(scope, cells, t) = match t {
  TgOlder => each(demand_move, cells),
  TgParam(b) => match ages_top() {
    Some(now) => match now {
      AgeScope(r) => ages_put(AgeScope({...r, stores: push(r.stores, (b, cells))})),
    },
    None => each(demand_move, cells),
  },
  TgState(b) => match scope {
    AgeScope(r) => match r.kind {
      AgeArm(_, _, _) => state_store_note(b, cells),
      AgeFn(_) => each(demand_move, cells),
      AgeClosure => each(demand_move, cells),
    },
  },
}

fn demand_move(cell) = shape_demand(cell, MovedShape)

// THE WRITE'S AGE. The same targets, read for what a store CHANGES. A store into memory the
// frame allocated builds a value and changes nothing that existed before the
// frame ran. A store into older memory changes it, and two extents ask: the
// FRAME, whose row then carries `Mutate` (lib/memory.mn), and each fanout
// BRANCH open around the store, whose boundary records the site, since two
// spawned instances of the branch would both write it (`BoundaryEdge`). The
// site is the node that makes the store — the call, the stage, the install —
// so the Why walk that reaches it enters the callee whose store it is.
fn ages_mutation(site, target_h) = match ages_top() {
  Some(scope) => {
    frame_settle(site, scope, store_targets(target_h, scope, ToFrame))
    branch_mutation(site, target_h)
  },
  None => (),
}

// Which extent a target is read against: an arena open around the store (the
// barrier's move), the frame that makes it (Mutate), or a fanout branch (the
// race). One walk serves the three, each its own test at a binder.
type AgeView = ToArena | ToFrame | ToBranch(Int)

// A target older than the frame performs Mutate where the store stands. A
// declared function's parameter is its callers' memory, and a handler's
// config its install's: the site is noted and the parameter published as
// written (`ages_close_fn`, `ages_close_arms`). An arm's own state is the
// install's record, which the installing frame allocated, unless the state
// was handed in.
fn frame_settle(site, scope, targets) = {
  let params = filter(target_is_param, targets)
  each(param_written, params)
  if any(older_than_frame(scope, ??), targets) {
    inf_add_row_at(site, mutate_row())
  } else if len(params) > 0 {
    graph_row_note(site, mutate_row())
  } else {
    ()
  }
}

fn param_written(t) = match t {
  TgParam(b) => ages_note_mutated(b),
  TgState(_) | TgOlder => (),
}

fn older_than_frame(scope, t) = match t {
  TgOlder => true,
  TgParam(_) => false,
  TgState(b) => len(store_targets(b, scope, ToFrame)) > 0,
}

fn ages_note_mutated(b) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => if any(handle_is(b, ??), r.mutated) {
      ()
    } else {
      ages_put(AgeScope({...r, mutated: push(r.mutated, b)}))
    },
  },
  None => (),
}

// Every fanout branch open in the scope whose start the target predates
// records the site.
fn branch_mutation(site, target_h) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => if len(r.branches) == 0 {
      ()
    } else {
      ages_put(AgeScope({...r, branches: map(branch_settle(site, target_h, scope, ??), r.branches)}))
    },
  },
  None => (),
}

fn branch_settle(site, target_h, scope, entry) = match entry {
  (br, sites) => if len(store_targets(target_h, scope, ToBranch(br))) > 0 && !index_in(sites, site) {
    (br, push(sites, site))
  } else {
    entry
  },
}

// Whether the view counts a parameter or a state field as the scope's own: an
// arena's only where the scope opened no arena; the frame's always; a
// branch's never, since each predates it.
fn view_owns_binders(view, depth) = match view {
  ToArena => depth == 0,
  ToFrame => true,
  ToBranch(_) => false,
}

fn view_is_frame(view) = match view {
  ToFrame => true,
  ToArena => false,
  ToBranch(_) => false,
}

// Whether a let at arena depth `d` is the view's own: an arena's at the depth
// the store stands at; the frame's wherever it was bound; a branch's when it
// was bound inside the branch.
fn view_owns_let(view, b, d, depth) = match view {
  ToArena => d == depth,
  ToFrame => true,
  ToBranch(br) => node_within(b, br),
}

fn node_within(h, root) = if h == root {
  true
} else {
  match graph_parent_of(h) {
    Some(p) => node_within(p, root),
    None => false,
  }
}

// A fanout branch is an extent: what the scope held before it is older than
// every store inside it. The sites it closes with ride its boundary.
fn ages_branch_open(br) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => ages_put(AgeScope({...r, branches: push(r.branches, (br, []))})),
  },
  None => (),
}

fn ages_branch_close() = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => if len(r.branches) == 0 {
      []
    } else {
      match last(r.branches) {
        (_, sites) => {
          ages_put(AgeScope({...r, branches: drop_last(r.branches)}))
          sites
        },
      }
    },
  },
  None => [],
}

// A declared function's store claim, read off the declaration its callee's
// edge reaches; a value binder — a closure, a parameter — has none.
fn callee_summary(callee_h) = match binder_read_by(callee_h) {
  Some(_) => None,
  None => match graph_ref_decl(callee_h) {
    Some(d) => graph_store_claim_of(d),
    None => None,
  },
}

// A callee's write claim as a call reads it: a declared function's, final; a
// member of the caller's own binding group's, not said yet, so the call
// defers what it hands to the group's end (`settle_unit_writes`); a value's,
// none — its writes ride its type's row. Only a declared function's own frame
// defers: a closure or an arm inside it is a value of its own, whose row has
// no later moment to take what the member writes, so its call charges the
// member's row as it stands — the row cell the group's members share.
type WriteClaim = ClaimFinal(StoreClaim) | ClaimDeferred(Int) | ClaimNone

fn callee_claim(callee_h) = match binder_read_by(callee_h) {
  Some(_) => ClaimNone,
  None => match graph_ref_decl(callee_h) {
    Some(d) => if ages_in_group(d) {
      if ages_frame_defers() { ClaimDeferred(d) } else { ClaimNone }
    } else {
      match graph_store_claim_of(d) {
        Some(s) => ClaimFinal(s),
        None => ClaimNone,
      }
    },
    None => ClaimNone,
  },
}

// The callee's row as a direct call charges it: Mutate that only writes the
// callee's parameters leaves the row, since each argument it writes is asked
// where it stands (`ages_mutation_call`); Mutate beyond them stays. A group
// member's leaves too: what it writes beyond its parameters reaches the
// caller when the group ends.
fn mutation_masked(callee_h, row) = if row_names_mutate(row) {
  match callee_claim(callee_h) {
    ClaimFinal(claim) => match claim {
      StoreClaim(s) => if s.beyond { row } else { row_without_mutate(row) },
    },
    ClaimDeferred(_) => row_without_mutate(row),
    ClaimNone => row,
  }
} else {
  row
}

fn ages_frame_defers() = match ages_top() {
  Some(AgeScope(r)) => match r.kind {
    AgeFn(_) => true,
    AgeClosure | AgeArm(_, _, _) => false,
  },
  None => false,
}

fn ages_mutation_call(site, callee_h, args) = match callee_claim(callee_h) {
  ClaimFinal(claim) => match claim {
    StoreClaim(s) => each(mutation_transport(site, args, ??), s.mutated),
  },
  ClaimDeferred(d) => ages_note_deferred(site, d, args),
  ClaimNone => (),
}

// A call into a member of the caller's own group, kept until the group ends:
// each argument aged against the frame. Every fanout branch open around the
// call records the call wherever an argument is older than the branch, since
// what the callee writes is not said yet.
fn ages_note_deferred(site, callee, args) = {
  each(branch_mutation(site, ??), args)
  match ages_top() {
    Some(scope) => match scope {
      AgeScope(r) => match r.kind {
        AgeFn(params) => ages_put(AgeScope({...r, deferred: push(r.deferred, (site, callee, map(arg_age(scope, params, ??), args)))})),
        AgeClosure | AgeArm(_, _, _) => (),
      },
    },
    None => (),
  }
}

fn arg_age(scope, params, ah) =
  fold((false, []), add_target_age(scope, params, ??, ??), store_targets(ah, scope, ToFrame))

fn add_target_age(scope, params, age, t) = match age {
  (older, ps) => match t {
    TgOlder => (true, ps),
    TgParam(b) => (older, add_index(ps, handle_position(params, b))),
    TgState(b) => if len(store_targets(b, scope, ToFrame)) > 0 { (true, ps) } else { age },
  },
}

// A group's members are judged one at a time, so a member may call one that
// has not said what it writes. When the group's judgment ends every member
// has: each deferred call is read against its callee's claim — the caller
// writes each parameter of its own it handed to a parameter the callee
// writes, and memory older than its frame wherever it handed such memory
// there or the callee writes beyond its parameters — until no claim grows.
// Then a member whose claim says it writes, and whose row does not yet say
// so, takes Mutate late, and its declaration is judged again.
fn settle_unit_writes() = match ages_group_close() {
  (members, deferred) => if len(deferred) == 0 {
    ()
  } else {
    settle_writes_rounds(deferred)
    each(deferred_site_note, deferred)
    each(member_writes_late, members)
  },
}

// A deferred call that writes memory older than its caller's frame, or a
// parameter of the caller's, is where the caller's late Mutate enters: the
// call's node is noted, as a call whose callee had said what it writes is.
fn deferred_site_note(entry) = match entry {
  (_, site, callee, ages) => if call_writes_older(graph_store_claim_of(callee), ages) {
    graph_row_note(site, mutate_row())
  } else {
    ()
  },
}

fn call_writes_older(claim, ages) = match claim {
  Some(StoreClaim(g)) => g.beyond || any(arg_written_older(ages, ??), g.mutated),
  None => true,
}

fn arg_written_older(ages, i) = written_older(ages, i) || len(written_params(ages, i)) > 0

fn member_writes_late(decl) = match graph_store_claim_of(decl) {
  Some(StoreClaim(s)) => if s.beyond || len(s.mutated) > 0 {
    member_takes(decl, mutate_row(), "a cycle's writes, read when the cycle ended")
  } else {
    ()
  },
  None => (),
}

fn settle_writes_rounds(deferred) =
  if fold(false, settle_deferred, deferred) { settle_writes_rounds(deferred) } else { () }

fn settle_deferred(grew, entry) = match entry {
  (caller, _, callee, ages) => match graph_store_claim_of(caller) {
    Some(StoreClaim(c)) => {
      let next = callee_writes_through(c, graph_store_claim_of(callee), ages)
      if len(next.mutated) == len(c.mutated) && next.beyond == c.beyond {
        grew
      } else {
        graph_store_claim_note(caller, StoreClaim(next))
        true
      }
    },
    None => grew,
  },
}

fn callee_writes_through(c, callee_claim, ages) = match callee_claim {
  Some(StoreClaim(g)) => {
    beyond: c.beyond || g.beyond || any(written_older(ages, ??), g.mutated),
    mutated: g.mutated |> flat_map(written_params(ages, ??)) |> fold(c.mutated, add_index),
    returns: c.returns,
    stores: c.stores,
  },
  None => {beyond: true, mutated: c.mutated, returns: c.returns, stores: c.stores},
}

// An argument the call did not hand — a parameter its default fills — is read
// as older, since nothing here says what the default names.
fn written_older(ages, i) = if i < len(ages) {
  match list_index(ages, i) {
    (older, _) => older,
  }
} else {
  true
}

fn written_params(ages, i) = if i < len(ages) {
  match list_index(ages, i) {
    (_, ps) => ps,
  }
} else {
  []
}

fn mutation_transport(site, args, i) = if i < len(args) {
  ages_mutation(site, list_index(args, i))
} else {
  inf_add_row_at(site, mutate_row())
}

// A stage names a declared function — a bare reference, a call completed in
// place — and its application is a call of that function with the piped
// value in the open slot (`stage_application`): the row it charges and the
// writes it makes are a call's. A literal applied in place was judged in the
// frame's own scope.
fn stage_row(site, stage, piped, crow) = match stage_application(stage, [piped]) {
  Some((callee, args)) => {
    ages_mutation_call(site, callee, args)
    mutation_masked(callee, crow)
  },
  None => crow,
}

// A tick stores the output into the line its record owns, older than every
// call of its owner, which performs Mutate for it. An arm's record is its
// install's: the arms write it as they write a config they were handed — the
// site noted and the arms' row charged where they end (`ages_close_arms`),
// each install answering it — so the race rule reads it off their row.
fn tick_mutation(handle) = match ages_top() {
  Some(scope) => match scope {
    AgeScope(r) => match r.kind {
      AgeArm(_, _, _) => {
        graph_row_note(handle, mutate_row())
        ages_note_mutated(handle)
      },
      AgeFn(_) => inf_add_row_owner_at(handle, mutate_row()),
      AgeClosure => inf_add_row_owner_at(handle, mutate_row()),
    },
  },
  None => (),
}

// An arm's in-place store into a state field is the field's second writer:
// the cells join the field's own fact, where the install's arena demand and
// the race rule read it (types.mn `StateFact`).
fn state_store_note(b, cells) = match graph_binder_of(b) {
  Some(fact) => match fact {
    StateFact(f) => graph_binder_note(b, StateFact({...f, stores: f.stores ++ cells})),
    ParamFact(_) => each(demand_move, cells),
    PartFact(_) => each(demand_move, cells),
  },
  None => each(demand_move, cells),
}

// Every cell an arm of the installed handler writes into its state, by
// either writer — the values its commits write past the init, and what it
// stores in place — read off the state fields' facts: what an install's
// arena must move.
fn handler_state_writes(hd) = match published_kind(hd) {
  Some(HandlerKind(_, _, _, state, _)) => flat_map(state_field_written_cells, state),
  _ => [],
}

fn state_field_written_cells(sf) = match graph_binder_of(state_field_init(sf)) {
  Some(fact) => match fact {
    StateFact(f) => drop(1, f.writes) ++ f.stores,
    ParamFact(_) => [],
    PartFact(_) => [],
  },
  None => [],
}

// The targets a store into the value at `h` reaches, read from the scope the
// store stands in against the view's extent — none when the extent allocated
// it.
fn store_targets(h, scope, view) = match graph_node_body(h) {
  NExpr(VarRef(_)) => match binder_read_by(h) {
    Some(b) => binder_targets(b, scope, view),
    None => [TgOlder],
  },
  NExpr(CallExpr(callee, args)) => call_targets(callee, args, scope, view),
  NExpr(PipeExpr(PForward, left, stage)) => match stage_application(stage, [left]) {
    Some((callee, args)) => call_targets(callee, args, scope, view),
    None => [TgOlder],
  },
  NExpr(MakeListExpr(_)) => [],
  NExpr(BlockExpr(_, f)) => store_targets(f, scope, view),
  NExpr(IfExpr(_, t, e)) => store_targets(t, scope, view) ++ store_targets(e, scope, view),
  NExpr(MatchExpr(_, arms)) => flat_map(arm_targets(scope, view, ??), arms),
  _ => [TgOlder],
}

fn arm_targets(scope, view, arm) = match arm {
  (_, body) => store_targets(body, scope, view),
}

// A handler's config parameter is a cell with no binder fact of its own; to
// the frame its arms run in it is the install's memory, as a declared
// function's parameter is its caller's.
fn binder_targets(b, scope, view) = match scope {
  AgeScope(r) => match graph_binder_of(b) {
    Some(fact) => match fact {
      ParamFact(_) => match r.kind {
        AgeFn(params) => if view_owns_binders(view, r.depth) && any(handle_is(b, ??), params) {
          [TgParam(b)]
        } else {
          [TgOlder]
        },
        AgeClosure => [TgOlder],
        AgeArm(_, _, _) => [TgOlder],
      },
      StateFact(_) => match r.kind {
        AgeArm(_, states, _) => if view_owns_binders(view, r.depth) && any(handle_is(b, ??), states) {
          [TgState(b)]
        } else {
          [TgOlder]
        },
        AgeFn(_) => [TgOlder],
        AgeClosure => [TgOlder],
      },
      PartFact(_) => [TgOlder],
    },
    None => match r.kind {
      AgeArm(_, _, configs) => if view_is_frame(view) && any(handle_is(b, ??), configs) {
        [TgParam(b)]
      } else {
        let_targets(b, scope, view)
      },
      AgeFn(_) => let_targets(b, scope, view),
      AgeClosure => let_targets(b, scope, view),
    },
  },
}

fn let_targets(b, scope, view) = match scope {
  AgeScope(r) => match find(let_at(b, ??), r.lets) {
    Some(found) => match found {
      (_, d) => if view_owns_let(view, b, d, r.depth) { store_targets(b, scope, view) } else { [TgOlder] },
    },
    None => [TgOlder],
  },
}

fn let_at(b, entry) = match entry {
  (h, _) => h == b,
}

// A call's result: `alloc`'s is fresh by what the op is, an address `addr_at`
// moves stays in the allocation its base names, a declared function's is what
// its claim says of the arguments it returns, and any other's is older than
// the call.
fn call_targets(callee, args, scope, view) = match graph_node_body(callee) {
  NExpr(VarRef(cname)) => match binder_read_by(callee) {
    Some(_) => [TgOlder],
    None => if cname == "alloc" {
      []
    } else if cname == "addr_at" {
      arg_targets(args, scope, view, 0)
    } else {
      match callee_summary(callee) {
        Some(StoreClaim(s)) => match s.returns {
          Some(idxs) => flat_map(arg_targets(args, scope, view, ??), idxs),
          None => [TgOlder],
        },
        None => [TgOlder],
      }
    },
  },
  _ => [TgOlder],
}

fn arg_targets(args, scope, view, i) = if i >= 0 && i < len(args) {
  let ah = list_index(args, i)
  match graph_node_body(ah) {
    NExpr(LabeledArg(_, _)) => [TgOlder],
    _ => store_targets(ah, scope, view),
  }
} else {
  [TgOlder]
}

// A call into a declared function asks every parameter the function stores
// into of the argument that fills it: for an arena, the parameters it stores
// cells into; for the write, the parameters it writes. A raw store asks of
// the address it writes.
fn ages_call(site, callee_h, cname: String, arg_handles) = match raw_store_target(cname) {
  RsAt(i) => mutation_transport(site, arg_handles, i),
  RsAll => inf_add_row_at(site, mutate_row()),
  RsNone => {
    match callee_summary(callee_h) {
      Some(StoreClaim(s)) => each(ages_transport(arg_handles, ??), s.stores),
      None => (),
    }
    ages_mutation_call(site, callee_h, arg_handles)
  },
}

fn ages_transport(args, entry) = match entry {
  (i, cells) => if i >= 0 && i < len(args) {
    ages_store(list_index(args, i), cells ++ [list_index(args, i)])
  } else {
    each(demand_move, cells)
  },
}

// An install answers for its handler's state: one whose body can open an
// arena runs the arms inside an arena the state predates, so every cell the
// arms store into the state is a move.
fn ages_install(hd, body_row) = match handler_state_writes(hd) {
  [] => (),
  cells => if row_may_open_arena(body_row) { each(demand_move, cells) } else { () },
}

fn row_may_open_arena(row) = match resolve_row(row) {
  EfRow(present, _, tail) => any(names_arena_effect, present) || tail_may_grow(tail),
}

fn names_arena_effect(e) = eff_name_str(e) == "Arena"

fn tail_may_grow(tail) = match tail {
  EtClosed => false,
  EtOpen(edges) => len(edges) > 0,
  EtAll => true,
}

// `BinOp` / `UnaryOp` inference — dispatched on `BinOpKind`.
// `binop_kind` (declared in `types.mn`) maps each `BinOp` to one of four
// `BinOpKind` variants — the behavior class used for inference rules.
// Two orthogonal axes: `BinOp` carries specific operator identity
// (14 variants, surfaced at Reason/emit boundaries); `BinOpKind`
// carries semantic behavior class (arith, cmp, bool, concat). No
// `String` intermediary at any dispatch site.
fn infer_binop(handle, op, lh, rh, span: ValidSpan) = {
  let lbl = binop_to_str(op)
  match binop_kind(op) {
    // The demand is judged on both operands BEFORE they meet: an aggregate
    // on either side refuses the site once, the unify that would report the
    // same mistake as a mismatch is skipped, and the result is a hole, so
    // the refusal does not echo where the result is used. Unified first,
    // `p + 8` over an address reported the mismatch and the refusal both,
    // and `8 + p` only mismatches — at the operator and again at the use.
    BKArith => if arith_refuses(lh, op, span) || arith_refuses(rh, op, span) {
      graph_bind_hole(handle, Located(span, OpConstraint(lbl, Inferred("refused"), Inferred("operand"))))
    } else {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      numeric_demand(lh, op, span)
      partiality_gate(handle, op, lh, rh, span)
      graph_bind(
        handle,
        TVar(lh),
        Located(span, OpConstraint(lbl, Inferred("result"), Inferred("operand")))
      )
    },
    BKCmp => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      // A comparison is structural over its operands' whole type, so it
      // reads the structure of every variable in it.
      shape_demand(lh, WholeShape)
      graph_bind(
        handle,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("comparison"), Declared("bool")))
      )
    },
    BKBool => {
      graph_bind(
        lh,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("left"), Declared("bool")))
      )
      graph_bind(
        rh,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("right"), Declared("bool")))
      )
      graph_bind(
        handle,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("result"), Declared("bool")))
      )
    },
    BKConcat => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      // A concat reads its operands' outer shape: which sequence it is.
      shape_demand(lh, OuterShape)
      graph_bind(
        handle,
        TVar(lh),
        Located(span, OpConstraint(lbl, Inferred("concat"), Inferred("operand")))
      )
      // `++` IS a call to the concat primitive, so it contributes that
      // callee's row — exactly what infer_call does at :1176
      // (inf_add_row(crow), "the callee's effect row flows into the
      // caller's row"). This arm did not, so `++` was attributed Pure while
      // both primitives it lowers to declare `with Memory + Alloc`. The
      // measured consequence was the crown's own arm failing open:
      //   fn f(ref n) with !Alloc = "a" ++ n     -> row projects Pure,
      //     T_OverDeclared advises TIGHTENING to the false claim, and it
      //     compiles and runs
      //   fn f(ref n) with !Alloc = str_concat("a", n)   -> E_EffectMismatch
      // Byte-identical work, opposite verdicts, because one path read the
      // row the graph proved and the other re-derived it as nothing.
      sugar_calls(handle, handle, concat_callee())
    },
  }
}

// A sugar calls its primitive as `f(x)` calls f: the node that writes it is
// linked, once, to the primitive the link declares under the vocabulary's
// name — never a local the name binds where the sugar stands — so `refs of`
// the primitive answers the sugar, the lowering reads the edge, and the
// primitive's row is charged where the sugar's cost lands, read off the
// declaration. The free-name walk draws the same names, so the primitive is
// judged before any fn whose sugar calls it. A primitive absent from the
// link draws no edge and charges nothing — the sugar cannot be calling it,
// and the lowering fails at the callee, where that absence lives.
fn sugar_calls(at, charged, name: String) = match env_resolve_linked(name) {
  Some(d) => {
    graph_ref_link(at, d)
    match graph_published(d) {
      Some((scheme, _, _)) => match instantiate(scheme) {
        TFun(_, _, row) => inf_add_row_at(charged, row),
        _ => (),
      },
      None => (),
    }
  },
  None => (),
}

// The op is the parser's UnaryOp ADT (UNeg | UNot — types.mn), matched
// exhaustively. The old string arms compared "Neg"/"Not" against ADT
// values, never matched, and every unary op fell to a fabricating
// catch-all — `!x` typed as its operand instead of Bool (caught by the
// order-independent judge, 2026-07-25).
fn infer_unaryop(handle, op, ih, span: ValidSpan) = match op {
  UNeg => {
    // Negation is arithmetic: the same demand `-` the binary form makes.
    numeric_demand(ih, BSub, span)
    graph_bind(
      handle,
      TVar(ih),
      Located(span, OpConstraint("Neg", Inferred("negate"), Inferred("operand")))
    )
  },
  UNot => {
    graph_bind(
      ih,
      TName("Bool", []),
      Located(span, OpConstraint("Not", Inferred("not"), Declared("bool")))
    )
    graph_bind(
      handle,
      TName("Bool", []),
      Located(span, OpConstraint("Not", Inferred("result"), Declared("bool")))
    )
  },
}

// Pattern inference
//
// A pattern's shape CONSTRAINS the scrutinee — it never overwrites it.
// graph_bind on the scrutinee's own handle clobbered its proven type
// (the fanout tuple's f64 elements re-bound to fresh free vars: the
// writer stored at the proven widths, the pattern's reader floored to
// words — the split-truth miscompile). The pattern's own node holds the
// shape and the scrutinee UNIFIES with it, so proven element/payload types
// flow into the binders and a shape mismatch is a diagnostic, never a
// silent retype.
fn constrain_scrutinee(pat, scrutinee_h, ty, span: ValidSpan, reason) = if pat == scrutinee_h {
  // A sub-pattern is its part's cell, bound to the part's type where the
  // whole was taken apart: its shape meets that type.
  unify_types(TVar(pat), ty, span, reason)
} else {
  graph_bind(pat, ty, Located(graph_span_of(pat), reason))
  // drift-audit: ignore — the two sides of ONE unification edge (scrutinee node, pattern-shape node), not parallel arrays
  unify(scrutinee_h, pat, span, reason)
}

// A pattern that asks nothing of its value's shape is that value: its node
// is bound to the scrutinee's cell, and a sub-pattern's node is its part's.
fn pat_is_value(pat, handle) = if pat == handle {
  ()
} else {
  graph_bind(pat, TVar(handle), Located(graph_span_of(pat), Inferred("pattern")))
}

// Every pattern node is judged here, once: the shape it asks of the value
// at its position, the names it binds, and at a constructor the edge to the
// declaration its name resolves to. `handle` is the cell of the value the
// pattern takes apart — the scrutinee for a pattern a match or a let holds,
// the pattern's own node for a sub-pattern, which is the cell of the part it
// takes apart — and a binder is declared at its pattern's node, where it is
// written.
fn infer_pat(pat, handle, span: ValidSpan) = match pat_of(pat) {
  PVar(name) => {
    pat_is_value(pat, handle)
    declare_binder(name, pat, handle, Inferred("pattern"))
  },
  PWild => pat_is_value(pat, handle),
  PLit(v) => {
    let ty = match v {
      LVInt(_) => TInt,
      LVFloat(_) => TFloat,
      LVString(_) => ty_string,
      LVBool(_) => TName("Bool", []),
    }
    constrain_scrutinee(pat, handle, ty, span, Inferred("literal pattern"))
  },
  // A pattern IS a reference: the constructor resolves here, once, and the
  // edge is drawn on the pattern's own node as a value reference's is, so
  // `refs of` the constructor answers the patterns that take its values
  // apart. Arity and exhaustiveness read the very scheme the edge reaches.
  PCon(name, sub_pats) => match ref_resolve(name, pat) {
    None => {
      pat_is_value(pat, handle)
      report(EMissingVariable("constructor: {name}", graph_span_of(pat)))
      each(infer_pat_unknown_part(??, span), sub_pats)
    },
    Some(decl) => match graph_published(decl) {
      None => {
        pat_is_value(pat, handle)
        each(infer_pat_unknown_part(??, span), sub_pats)
      },
      // ConstructorScheme bindings carry one of two ty shapes:
      //   nullary  → TName(type_name, args)         — bind scrutinee to it
      //   fielded  → TFun(params, TName(...), Pure) — bind scrutinee to RETURN,
      //                                                 sub_pats to PARAMS.
      // A nominal record's entry (RecordSchemeKind) binds the bare TName —
      // the construction view for `Pri{...}` literals, no arrow. Its
      // ctor-PATTERN view is the single-field arrow
      // `Pri : TRecord(declared) → TName`: rebuild the arrow AROUND the
      // scheme's body so ONE instantiate substitutes both halves, and the
      // shared TFun path below binds scrutinee + the sub-pattern. (The
      // seed's kind-132 arm has read this view since the m2 march; the
      // wheel lagged its own seed — every `let Pri(pa) = a` lost pa.)
      // FnScheme bindings reaching here are user-level matches on a
      // plain function value — degenerate but harmless; bind the
      // scrutinee to the looked-up type and skip sub-pat plumbing.
      Some(entry) => match entry {
        (scheme, reason, kind) => {
          let ty = match kind {
            RecordSchemeKind(declared_fields) => match judgment_pair(scheme) {
              (q, body) => instantiate(Frozen(q, TFun(build_ctor_params([TRecord(declared_fields)], 0), body, mk_ef_pure()))),
            },
            _ => instantiate(scheme),
          }
          match ty {
            TFun(params, ret_ty, _row) => {
              constrain_scrutinee(pat, handle, ret_ty, span, VarLookup(name, reason))
              bind_pcon_subpats(params, sub_pats, handle, span, reason, name)
            },
            _ => constrain_scrutinee(pat, handle, ty, span, VarLookup(name, reason)),
          }
        },
      },
    },
  },
  PTuple(pats) => infer_pat_tuple(pat, pats, handle, span),
  PList(pats, rest) => infer_pat_list(pat, pats, rest, handle, span),
  PRecord(flds, rest) => {
    // Bind scrutinee to TRecordOpen of the named fields with a
    // fresh row variable — the pattern accepts any record with AT
    // LEAST these fields. Each field's sub-pattern is the cell of
    // that field; field-puning patterns are PVar and bind into env
    // via infer_pat's recursion.
    let row_h = graph_fresh_row(Inferred("record pattern row"))
    let field_specs = build_pat_record_field_specs(flds, span)
    // A bound rest reads the row without the named fields in front of it,
    // so the row lacks them, or the rest could learn one and the record
    // hold it twice.
    if rest_names_a_binder(rest) { row_lacks_install(row_h, map(field_name, field_specs)) }
    let pat_ty = mk_record_open(field_specs, row_h)
    constrain_scrutinee(pat, handle, pat_ty, span, Inferred("record pattern"))
    // The pattern places each field by the receiver's whole field set.
    shape_demand(handle, OuterShape)
    infer_pat_record_subs(flds, field_specs, handle, span)
    match rest {
      // The rest is the record of the REMAINING fields — the SAME residual
      // row the open pattern carries, as a record with no named fields of
      // its own: when the scrutinee resolves, the row does, and the rest's
      // type IS that record (SYNTAX §"Pattern syntax for records").
      Some(r) => {
        infer_pat_part(
          r,
          mk_record_open([], row_h),
          part_of(handle, PartRest),
          Inferred("record pattern rest"),
          span
        )
        // a bound rest's fields are copied into a record built here
        if rest_names_a_binder(rest) { inf_add_row_at(handle, construction_row()) }
      },
      None => (),
    }
  },
  PAlt(branches) => {
    // Every branch constrains the SAME scrutinee handle — branch
    // pattern types unify through it by construction. The binding
    // law (the pattern-alternation walkthrough §3): branches bind the
    // same names with unifiable types; the body sees the unified
    // type. Each branch's binder types are read back IMMEDIATELY
    // after its walk (env entries shadow across branches; the law
    // check needs per-branch snapshots).
    pat_is_value(pat, handle)
    let branch_binds = map((b) => infer_pat_alt_branch(b, handle, span), branches)
    enforce_alt_binding_law(branch_binds, span)
  },
  PAs(name, inner) => {
    // The as-pattern binds the WHOLE value its position takes apart, as a
    // binder standing alone does, and the inner pattern destructures the
    // same value.
    pat_is_value(pat, handle)
    declare_binder(name, pat, handle, Inferred("as-pattern"))
    infer_pat(inner, handle, span)
  },
}

// A binder is declared where it is written, at its pattern's node, and is
// the cell of the value at its position: a sub-pattern's node is that cell
// itself, and a pattern a match or a let holds names the value it is handed
// whole, whose cell it publishes.
fn declare_binder(name: String, pat, handle, why) = env_extend(
  name,
  Frozen([], TVar(handle)),
  Located(graph_span_of(pat), LetBinding(name, why)),
  ValueScheme,
  pat
)

// A sub-pattern is the cell of the part it takes apart: its node is bound to
// the part's type, carries the edge to the whole it was taken from, and is
// judged as the value it is — a binder it writes declared at it.
fn infer_pat_part(sub, ty, fact, reason, span: ValidSpan) = {
  graph_bind(sub, ty, Located(graph_span_of(sub), reason))
  graph_binder_note(sub, fact)
  infer_pat(sub, sub, span)
}

// A sub-pattern under a constructor no declaration answers is its own cell,
// of a type nothing constrains; it takes apart no known part.
fn infer_pat_unknown_part(sub, span: ValidSpan) = {
  let reason = Inferred("a pattern under an unknown constructor")
  graph_bind(sub, TVar(mint(reason)), Located(graph_span_of(sub), reason))
  infer_pat(sub, sub, span)
}

// The edge from a part to the whole it was destructured from, where nothing
// declares the part's contract.
fn part_of(whole, step) = PartFact({declared: None, step, whole})

// Walk one alternation branch, then snapshot its (name, type) binds
// while they are still the latest env entries.
fn infer_pat_alt_branch(b, handle, span: ValidSpan) = {
  infer_pat(b, handle, span)
  map((n) => (n, alt_binder_ty(n, span)), pat_binder_names(b))
}

fn alt_binder_ty(ref n, span: ValidSpan) = match env_lookup(n) {
  Some(entry) => match entry {
    (scheme, _, _) => instantiate(scheme),
  },
  None => {
    // pat_binders said n binds, the walk did not extend it — the
    // branch's binding genuinely failed; surface as the law's
    // diagnostic rather than fabricating a type.
    report(EPatternAlternationBindingMismatch("alternation binder never bound: {n}", span))
    TVar(mint(Located(span, Inferred("alternation binder lost"))))
  },
}

// SYNTAX.md §"Pattern alternation — rule": all branches bind the
// same name set; per-name types unify across branches (the body
// sees the unified type). Branch 0 is the reference set.
fn enforce_alt_binding_law(branch_binds, span: ValidSpan) = match branch_binds {
  [] => (),
  [first, ...rest] => each(
    (bi) => if alt_same_name_set(first, bi) {
      each(
        {
          (n, ty_i) => match find({ (m, _) => m == n }, first) {
            Some(q0) => match q0 {
              (_, ty_0) => unify_types(ty_0, ty_i, span, Located(span, Inferred("alternation common type"))),
            },
            None => (),
          },
        },
        bi
      )
    } else {
      report(EPatternAlternationBindingMismatch("alternation branches bind different names", span))
    },
    rest
  ),
}

fn alt_same_name_set(a, b) = len(a) == len(b) && all({ (n, _) => any({ (m, _) => m == n }, b) }, a)

// A record pattern's field types, one variable each, the record the pattern
// asks of its value built from them.
fn build_pat_record_field_specs(flds, span: ValidSpan) = map(
  {
    (name, _) => {
      let h = mint(Inferred("record pattern field"))
      (name, TVar(h))
    },
  },
  flds
)

// Each field's sub-pattern is the cell of that field.
fn infer_pat_record_subs(flds, specs, whole, span: ValidSpan) = each(
  {
    ((fname, sub_pat), (_, ty)) => infer_pat_part(
      sub_pat,
      ty,
      part_of(whole, PartField(fname)),
      Inferred("record pattern field"),
      span
    ),
  },
  zip(flds, specs)
)

// Each element's sub-pattern is the cell of its position, at a type of its
// own the tuple the pattern asks of its value is built from.
fn infer_pat_tuple(pat, pats, parent_handle, span: ValidSpan) = {
  let elem_tys = map(
    {
      (i, p) => {
        let ty = TVar(mint(Inferred("tuple pattern element")))
        infer_pat_part(p, ty, part_of(parent_handle, PartIndex(i)), Inferred("tuple pattern element"), span)
        ty
      },
    },
    enumerate(pats)
  )
  // The scrutinee's proven element types flow into the bound vars, and
  // an arity mismatch is a unification failure at this edge — the exact
  // constraint the sibling infer_pat_list draws for lists.
  constrain_scrutinee(pat, parent_handle, TTuple(elem_tys), span, Inferred("tuple pattern"))
}

// A list's elements share one type, and each element's sub-pattern is its
// own cell of it — two binders of one list pattern are two values. The rest
// is the cell of the list past the prefix.
fn infer_pat_list(pat, pats, rest, parent_handle, span: ValidSpan) = {
  let elem_ty = TVar(mint(Inferred("list pattern element")))
  each(
    infer_pat_part(
      ??,
      elem_ty,
      part_of(parent_handle, PartElem),
      Inferred("list pattern element"),
      span
    ),
    pats
  )
  let list_ty = TList(elem_ty)
  constrain_scrutinee(pat, parent_handle, list_ty, span, Inferred("list pattern"))
  match rest {
    None => (),
    Some(r) => {
      infer_pat_part(r, list_ty, part_of(parent_handle, PartRest), Inferred("list rest pattern"), span)
      // a bound rest is cut as a slice at run time: the pattern calls the
      // slice and the list it cuts pays what the slice costs
      if rest_names_a_binder(rest) { sugar_calls(pat, parent_handle, list_rest_callee()) }
    },
  }
}

// Each PCon sub-pattern is the cell of its constructor field, at the field's
// type. Its fact is the edge to the value it was destructured from, with the
// field's declared refinement — owed by every construction where it was
// built. An arity mismatch reports EConstructorArity FIRST; the aligned
// prefix still binds (productive-under-error).
fn bind_pcon_subpats(params, sub_pats, whole, span: ValidSpan, reason, ctor_name) = {
  if len(params) != len(sub_pats) {
    report(EConstructorArity(ctor_name, len(params), len(sub_pats), span))
  }
  each(
    {
      (i, (param, sub_pat)) => infer_pat_part(
        sub_pat,
        param_ty(param),
        PartFact({declared: refined_or_none(param_ty(param)), step: PartCtor(ctor_name, i), whole}),
        VarLookup(ctor_name, reason),
        span
      ),
    },
    enumerate(zip(params, sub_pats))
  )
}

fn refined_or_none(ty) = if ty_carries_refinement(ty) { Some(ty) } else { None }

fn infer_match_arms(arms, scrut, result_h, handle, span: ValidSpan) = {
  // Match arms are ALTERNATIVE — exactly one runs — so an `own` value
  // consumed in several arms is one consume on the taken path, unioned
  // by the affine ledger without a collision (BAlternative), the same
  // bracket `><` / `<|` use with BParallel. Empty match has no arms to
  // bracket.
  let n = len(arms)
  if n > 0 { branch_enter(BAlternative) }
  infer_match_arm_iter(arms, scrut, result_h, span, 0, n)
  if n > 0 { branch_exit(span) }
  // THE EXHAUSTIVENESS CHECK (H3), over the WHOLE pattern (2026-10-13). The
  // arms are a matrix of pattern rows and the question is whether a value
  // escapes every row — decided column by column as Maranget decides it: a
  // column of constructors is complete when the arms name every variant of
  // the type (the roster is the type's own entry, TypeVariants) and each
  // variant's specialization is itself covered; incomplete, the rows with a
  // wildcard there must cover the rest, else the first missing constructor
  // is the witness. Until this landed the check read each arm's TOP
  // constructor alone, so `NStmt(FnStmt(…)) | NStmt(LetStmt(…)) | NExpr(…)`
  // passed with a Stmt variant missing inside NStmt and the program trapped
  // at the arm nobody wrote — found the day a Stmt variant was added and the
  // compiler's own classifier walk (`collect_fn_decls`) trapped on it with
  // `mentl check` clean. The refusal names the value that escapes, as a
  // pattern (`NStmt(HandlerChainStmt(_, _))`), never a count.
  //
  // TWO LAWS, read off the arms. A match of several arms DISPATCHES: they
  // are the roster of what it handles, and a value none of them reaches is a
  // case nobody wrote, so it refuses. A match of ONE arm DESTRUCTURES,
  // whatever its spelling — a `let`, a parameter written as a pattern, a
  // one-arm literal, `match v { p => e }` — and asserts its value's shape
  // where several arms would dispatch on it: the read is partial as `xs[i]`
  // is, so the site raises the shape as the claim it is (`claim_shape`), the
  // escaping value riding the claim's reason. The spelling is the render's to
  // keep (`graph_let_born`), never the meaning's: the binder form
  // `([h, ...t]) => h` and the arm list `mentl fmt` writes it as are one graph.
  match uncovered(flat_map(arm_row, arms), 1) {
    Some(witness) => match arms {
      [arm] => claim_shape(scrut, handle, join(", ", witness), arm),
      [] | [_, _, ..._] => report(EPatternInexhaustive(join(", ", witness), span)),
    },
    None => (),
  }
}

// A destructuring pattern's shape, claimed of its value as a partial read's
// precondition is (the TRAP law at `infer_index_force`), and located at that
// value: proven, it costs nothing; refuted, the ledger refuses there
// (E_RefinementRejected); open, the let's own row carries the Trap a mismatch
// is, and `with !Trap` refuses it until the shape is proven or matched. The
// value walk decides it (`shape_decide`, verify.mn) from what the value's
// edges say it is.
fn claim_shape(scrut, handle, witness: String, arm) = match arm {
  (pat, _) => {
    let at = graph_span_of(scrut)
    let proven = match verify_claim(
      graph_module_current(),
      at,
      PPatternMatch(pat, scrut),
      Located(at, Inferred("a destructuring pattern is partial: `{witness}` escapes it"))
    ) {
      Some(held) => held,
      None => false,
    }
    if proven { () } else { inf_add_row_at(handle, trap_row()) }
  },
}

// A matrix row holds patterns as values; a sub-pattern enters a row as the
// pattern its node holds.
fn arm_row(arm) = match arm {
  (pat, _body) => [[pat_of(pat)]],
}

// Some value of width `n` that escapes every row of the matrix, as one
// rendered pattern per column, or None when the rows cover everything. The
// first column decides by what stands at its heads: constructors (Bool's two
// literals among them, by `norm_row`) through the type's roster, each
// constructor's payloads folded back under its name; tuples by their
// positions; a list as the sum it is, empty or a head before a rest; a
// record by the union of the fields its patterns name, an unnamed field `_`;
// and any other literal only by a row that is wild there, since no set of
// literals covers a word or a text. The read is STRICT where it used to take
// a literal, list or record column as covered: three readers stand on it —
// the refusal, the roster a catch-all is written as, and the last arm of an
// exhaustive match running untested — and the lenient read wrote `None =>
// ()` for a `_` after `Some(false)`, so `Some(true)` reached no arm and the
// wheel trapped in `verify_claim` (measured 2026-10-14).
fn uncovered(rows, n) = if n == 0 {
  if len(rows) == 0 { Some([]) } else { None }
} else {
  let rs = flat_map(norm_row, rows)
  match column_ctors(rs) {
    [] => match tuple_width(rs) {
      Some(k) => witness_tuple(k, uncovered(map(tuple_row(k, ??), rs), k + n - 1)),
      None => if any(row_list_at_front, rs) {
        uncovered_list(rs, n)
      } else {
        match record_fields_at_front(rs) {
          [] => uncovered_literals(rs, n),
          fields => witness_record(fields, uncovered(flat_map(record_row(fields, ??), rs), len(fields) + n - 1)),
        }
      },
    },
    heads => match ctor_roster(list_index(heads, 0)) {
      // no roster for the type (a nominal record's one constructor registers
      // none): the column is read as covered, as before
      [] => witness_prefix("_", uncovered(map(rest, rs), n - 1)),
      roster => match filter(roster_missing(heads, ??), roster) {
        [] => first_uncovered(roster, rs, n),
        [(_, cname, tys), ..._] => witness_prefix(
          witness_ctor(cname, map({ _ => "_" }, tys)),
          uncovered(map(rest, filter(row_wild_at_front, rs)), n - 1)
        ),
      },
    },
  }
}

// A row's first column, normalized: an as-pattern is its inner pattern, an
// alternation is one row per branch, and a Bool literal is the constructor
// it names, since `Bool` is the sum `False | True` (the prelude).
fn norm_row(row) = match row {
  [PAs(_, inner), ...tail] => norm_row([pat_of(inner)] ++ tail),
  [PAlt(branches), ...tail] => flat_map({ b => norm_row([pat_of(b)] ++ tail) }, branches),
  [PLit(LVBool(b)), ...tail] => [[PCon(bool_ctor_name(b), [])] ++ tail],
  _ => [row],
}

fn bool_ctor_name(b) = if b { "True" } else { "False" }

// A literal column: each literal present is covered by the rows that name it
// or are wild there, and every other value by the wild rows alone.
fn uncovered_literals(rs, n) = match fold(None, literal_step(rs, n, ??, ??), literal_heads(rs)) {
  Some(w) => Some(w),
  None => witness_prefix("_", uncovered(map(rest, filter(row_wild_at_front, rs)), n - 1)),
}

fn literal_step(rs, n, acc, lv) = match acc {
  Some(w) => Some(w),
  None => witness_prefix(lit_witness(lv), uncovered(map(rest, filter(row_lit_or_wild(lv, ??), rs)), n - 1)),
}

fn literal_heads(rs) = fold([], literal_head, rs)

fn literal_head(acc, row) = match row {
  [PLit(lv), ..._] => if any({ x => x == lv }, acc) { acc } else { push(acc, lv) },
  _ => acc,
}

fn row_lit_or_wild(lv, row) = match row {
  [PLit(x), ..._] => x == lv,
  [PWild, ..._] => true,
  [PVar(_), ..._] => true,
  _ => false,
}

fn lit_witness(lv) = match lv {
  LVInt(n) => int_to_str(n),
  LVFloat(f) => float_to_str(f),
  LVString(s) => "\"{s}\"",
  LVBool(b) => if b { "true" } else { "false" },
}

// A list column as the sum it is: a row covers `[]` by an empty or a
// rest-only pattern, and a head before a rest by a prefix, whose first
// element and remaining list become two columns of their own.
fn uncovered_list(rs, n) = match uncovered(flat_map(list_nil_row, rs), n - 1) {
  Some(w) => Some(["[]"] ++ w),
  None => match uncovered(flat_map(list_cons_row, rs), n + 1) {
    Some([h, t, ...more]) => Some([witness_list(h, t)] ++ more),
    Some(short) => Some(short),
    None => None,
  },
}

fn witness_list(h: String, t: String) = if t == "[]" { "[{h}]" } else { "[{h}, ...]" }

fn row_list_at_front(row) = match row {
  [PList(_, _), ..._] => true,
  _ => false,
}

fn list_nil_row(row) = match row {
  [PList([], _), ...tail] => [tail],
  [PList(_, _), ..._] => [],
  [PWild, ...tail] => [tail],
  [PVar(_), ...tail] => [tail],
  _ => [],
}

fn list_cons_row(row) = match row {
  [PList([], None), ..._] => [],
  [PList([], Some(_)), ...tail] => [[PWild, PWild] ++ tail],
  [PList([p, ...ps], rst), ...tail] => [[pat_of(p), PList(ps, rst)] ++ tail],
  [PWild, ...tail] => [[PWild, PWild] ++ tail],
  [PVar(_), ...tail] => [[PWild, PWild] ++ tail],
  _ => [],
}

// A record column: the union of the fields its patterns name, each row's
// pattern for a field it names and `_` for one it leaves to the rest.
fn record_fields_at_front(rs) = fold([], record_field_names, rs)

fn record_field_names(acc, row) = match row {
  [PRecord(fields, _), ..._] => fold(acc, add_field_name, fields),
  _ => acc,
}

fn add_field_name(acc, field) = match field {
  (name, _) => if any({ x => x == name }, acc) { acc } else { push(acc, name) },
}

fn record_row(fields, row) = match row {
  [PRecord(flds, _), ...tail] => [map(field_pattern(flds, ??), fields) ++ tail],
  [PWild, ...tail] => [wildcards(len(fields)) ++ tail],
  [PVar(_), ...tail] => [wildcards(len(fields)) ++ tail],
  _ => [],
}

fn field_pattern(flds, name: String) = match find({ (f, _) => f == name }, flds) {
  Some((_, p)) => pat_of(p),
  None => PWild,
}

fn witness_record(fields, w) = match w {
  Some(ws) => Some(["\{{join(", ", field_witnesses(fields, take(len(fields), ws)))}\}"] ++ drop(len(fields), ws)),
  None => None,
}

fn field_witnesses(fields, ws) = match (fields, ws) {
  ([f, ...fs], [w, ...rest]) => ["{f}: {w}"] ++ field_witnesses(fs, rest),
  _ => [],
}

fn row_wild_at_front(row) = match row {
  [PWild, ..._] => true,
  [PVar(_), ..._] => true,
  _ => false,
}

// The constructors the first column names, each once, in row order.
fn column_ctors(rs) = fold([], column_ctor, rs)

fn column_ctor(acc, row) = match row {
  [PCon(name, _), ..._] => if any({ n => n == name }, acc) { acc } else { push(acc, name) },
  _ => acc,
}

fn roster_missing(heads, spec) = match spec {
  (_, cname, _) => !any({ h => h == cname }, heads),
}

// Every constructor named: the first whose specialization some value escapes
// is the witness, its payload columns folded back under its name.
fn first_uncovered(roster, rs, n) = match roster {
  [] => None,
  [(_, cname, tys), ...more] => {
    let k = len(tys)
    match uncovered(flat_map(specialize_row(cname, k, ??), rs), k + n - 1) {
      Some(w) => Some([witness_ctor(cname, take(k, w))] ++ drop(k, w)),
      None => first_uncovered(more, rs, n),
    }
  },
}

// The row under constructor `cname` of arity `k`: its payload patterns in
// place of the constructor, a wildcard's `k` wildcards, another
// constructor's row gone.
fn specialize_row(cname: String, k, row) = match row {
  [PCon(c, ps), ...tail] => if c == cname {
    if len(ps) == k { [map(pat_of, ps) ++ tail] } else { [wildcards(k) ++ tail] }
  } else {
    []
  },
  [PWild, ...tail] => [wildcards(k) ++ tail],
  [PVar(_), ...tail] => [wildcards(k) ++ tail],
  _ => [],
}

// A CATCH-ALL ARM OVER A SUM IS THE ROSTER THE AUTHOR DECLINED TO WRITE
// (Morgan, 2026-10-13). What `_` or a bare binder swallows there is the
// scrutinee's constructors less what the arms before it cover whole, and a
// constructor declared later joins it unread — drift mode 10 at the arm
// itself. This is that roster as the pattern that names it: each escaping
// constructor with its payload left to `_` (a wildcard inside a constructor
// is honest), under the arm's binder when it bound one, Bool's two by their
// literals. None when the arm is no catch-all, when the scrutinee is no sum
// (a word, a sequence, a product, a function — `_` there is the honest
// complement), or when nothing escapes the arms before it (the arm is
// dead). The census counts it (CsWildcardOverSum, src/query.mn), `mentl
// tighten` writes it, and the refusal at zero will read it
// (`Hβ.match.catch-all-over-a-sum-is-the-roster`).
fn roster_of(scrut, before, pat) = match sum_roster(lookup_ty(scrut)) {
  [] => None,
  roster => match filter(ctor_escapes(flat_map(norm_row, flat_map(arm_row, before)), ??), roster) {
    [] => None,
    escaping => Some(Roster(roster_binder(pat), map(ctor_roster_entry, escaping))),
  },
}

// The first catch-all arm of a match over a sum: its index, its pattern and
// the pattern that names its roster; a later catch-all is dead and is not
// counted twice.
fn catch_all_arm(scrut, arms) = fold(None, catch_all_first(scrut, arms, ??, ??), enumerate(arms))

// A match's only arm is a binding, never a dispatch — `{ x => body }` is the
// one-parameter function literal, `match v { x => … }` a `let` — so a
// catch-all is convicted only after an arm it could be the roster of.
fn catch_all_first(scrut, arms, acc, indexed) = match acc {
  Some(found) => Some(found),
  None => match indexed {
    (i, (pat, _)) => if i > 0 && pat_is_catch_all(pat) {
      match roster_of(scrut, take(i, arms), pat) {
        Some(roster) => Some((i, pat, roster)),
        None => None,
      }
    } else {
      None
    },
  },
}

fn pat_is_catch_all(pat) = match pat_of(pat) {
  PWild => true,
  PVar(_) => true,
  PAs(_, inner) => pat_is_catch_all(inner),
  PAlt(branches) => any(pat_is_catch_all, branches),
  PCon(_, _) => false,
  PLit(_) => false,
  PTuple(_) => false,
  PList(_, _) => false,
  PRecord(_, _) => false,
}

// The constructors of a scrutinee's type when it is a sum, through an alias,
// a refinement or a pin; empty for every other shape and for a nominal
// record, which registers none.
fn sum_roster(ty) = match ty {
  TName(name, _) => variant_named_specs_at(TName(name, [])),
  TAlias(_, base) => sum_roster(base),
  TRefined(base, _) => sum_roster(base),
  TReprPin(_, base) => sum_roster(base),
  TInt => [],
  TFloat => [],
  TUnit => [],
  TByte => [],
  TAddr => [],
  TList(_) => [],
  TTuple(_) => [],
  TFun(_, _, _) => [],
  TVar(_) => [],
  TRecord(_) => [],
  TRecordOpen(_, _) => [],
  TCont(_, _, _, _) => [],
}

// Whether some value of the constructor escapes the rows before the arm —
// the same specialization the witness walk makes, over rows `norm_row` has
// already read (Bool's literals as its two constructors among them).
fn ctor_escapes(before, spec) = match spec {
  (_, cname, tys) => match uncovered(flat_map(specialize_row(cname, len(tys), ??), before), len(tys)) {
    Some(_) => true,
    None => false,
  },
}

// One escaping constructor as the roster names it: its name and its payload
// count.
fn ctor_roster_entry(spec) = match spec {
  (_, cname, tys) => (cname, len(tys)),
}

// The arm's catch-all spelled out: the escaping constructors under the
// arm's binder when it bound one (`b @ (C(_) | D)`), bare otherwise. An
// alternation holding a `_` stood for the whole roster, so the roster
// replaces it whole.
fn roster_binder(pat) = match pat_of(pat) {
  PVar(name) => Some(name),
  PAs(name, _) => Some(name),
  PWild | PAlt(_) | PCon(_, _) | PLit(_) | PTuple(_) | PList(_, _) | PRecord(_, _) => None,
}

fn wildcards(k) = if k <= 0 { [] } else { [PWild] ++ wildcards(k - 1) }

// A tuple column: the width of any tuple pattern in it.
fn tuple_width(rs) = match find(row_tuple_at_front, rs) {
  Some([PTuple(ps), ..._]) => Some(len(ps)),
  _ => None,
}

fn row_tuple_at_front(row) = match row {
  [PTuple(_), ..._] => true,
  _ => false,
}

fn tuple_row(k, row) = match row {
  [PTuple(ps), ...tail] => if len(ps) == k { map(pat_of, ps) ++ tail } else { wildcards(k) ++ tail },
  [_, ...tail] => wildcards(k) ++ tail,
  [] => [],
}

fn witness_prefix(first: String, w) = match w {
  Some(cols) => Some([first] ++ cols),
  None => None,
}

fn witness_tuple(k, w) = match w {
  Some(cols) => Some(["({join(", ", take(k, cols))})"] ++ drop(k, cols)),
  None => None,
}

fn witness_ctor(cname: String, payload) =
  if len(payload) == 0 { cname } else { "{cname}({join(", ", payload)})" }

fn infer_match_arm_iter(arms, scrut, result_h, span: ValidSpan, i, n) = if i >= n {
  ()
} else {
  match list_index(arms, i) {
    (pat, body) => {
      env_scope_enter()
      binders_once(pat_binders(pat))
      infer_pat(pat, scrut, span)
      infer_expr(body)
      unify(body, result_h, span, MatchBranch(Inferred("arm body"), Inferred("result")))
      env_scope_exit()
      // Divide BETWEEN arms only — the affine ledger resets its used set to the
      // frame base so the next arm sees the pre-match scope, never the
      // prior arm's consumes.
      if i + 1 < n { branch_divider(span) }
      infer_match_arm_iter(arms, scrut, result_h, span, i + 1, n)
    },
  }
}

// One arm under the typed-resume law (SYNTAX §Effect declarations).
// `op(args) => body` for `op : (P...) -> R` under handle-result S:
// args bind to the op's DECLARED params (the graph already knows
// them — fresh vars would discard that); resume reads (R, S) from
// arm context; the body's own value unifies with S — the arm's
// value IS the handle result, whether it resumes or aborts.
//
// drift-audit: ignore — result_h (arm result) and inst_h (effect instance) are distinct handles
fn infer_one_handler_arm(arm: {args: [Node], body: Node, op: Node}, result_h, inst_h, world_h) = {
  let arm_span = graph_span_of(arm.body)
  let op_name = handler_arm_op_name(arm)
  // The op the arm serves resolves once, here, and the name the arm writes
  // is linked to its declaration, so `refs of` the op answers the arm.
  let op_ret_ty = match env_resolve(op_name) {
    Some(d) => {
      graph_ref_link(arm.op, d)
      match graph_published(d) {
        Some((scheme, _, _)) => match instantiate(scheme) {
          TFun(params, ret_ty, op_row) => {
            // The op's instantiated payload (Iterate(a) ⇒ a) IS this
            // handler's P, so the arm param binds the var `~>` unifies with
            // the body's performed E. Payload flows performer→handler
            // through P.
            unify_op_payload(op_row, inst_h, arm_span)
            bind_arm_args(arm.args, params, op_name, arm_span)
            ret_ty
          },
          // An op registered without param structure IS its result type.
          other => other,
        },
        None => undeclared_arm_op(op_name, arm_span),
      }
    },
    None => undeclared_arm_op(op_name, arm_span),
  }
  let continuation_h = mint(Inferred("handler arm continuation"))
  // The continuation's DISCIPLINE is the representation the resume is lowered
  // at, which is the OP's — every handler's arm grades joined
  // (`op_resume_discipline`, drawn at pre-registration) — never this arm's
  // grade alone: an arm that resumes at its tail still calls a record when
  // another handler holds the same op. Its WORLD is the remainder the
  // continuation runs: the handler's remainder-world cell, which no write
  // binds and every install judges (`remainder_gates_check`). It was the
  // arm frame's own row cell, which is what the arms PERFORM, not what a
  // resume RUNS.
  let continuation_disc =
    disc_join(arm_disc_of(arm_grade(arm)), op_resume_discipline(graph_ref_decl(arm.op)))
  graph_bind(
    continuation_h,
    TCont(op_ret_ty, TVar(result_h), continuation_disc, mk_ef_open([], world_h)),
    Located(arm_span, Inferred("handler arm continuation R -> S"))
  )
  inf_enter_arm(continuation_h, op_ret_ty)
  infer_expr(arm.body)
  inf_exit_arm()
  unify(arm.body, result_h, arm_span, Inferred("handler arm result"))
}

// An arm naming no op the link declares is refused at the arm, and its result
// is a variable nothing binds.
fn undeclared_arm_op(op_name: String, arm_span: ValidSpan) = {
  report(EMissingVariable("handler arm op: {op_name}", arm_span))
  TVar(mint(Inferred("undeclared op result")))
}

// An arm may not resume an op declared `-> !` (`EResumeOfNever`): its result
// is quantified per perform, so the value the arm would hand back has no one
// type every performer can receive.
fn never_resume_check(hname: String, arm: {args: [Node], body: Node, op: Node}) = if op_never_returns(graph_ref_decl(arm.op)) && arm_grade(arm) != RNone {
  report(EResumeOfNever(hname, handler_arm_op_name(arm), graph_span_of(arm.body)))
}

// An op whose result is a variable its own scheme quantifies and nothing else
// in it names — not a parameter, not the effect's instance: the never type,
// minted per occurrence and quantified per perform. The structure IS the
// declaration's `!`; no marker is kept beside it.
fn op_never_returns(od) = match published_at(od) {
  Some(entry) => match entry {
    (scheme, _, EffectOpScheme(_, _, _, _)) => match judgment_pair(scheme) {
      (qs, TFun(params, TVar(r), row)) => any({ q => q == r }, qs) && !any({ v => v == r }, free_in_params(params) ++ free_in_row(row)),
      _ => false,
    },
    _ => false,
  },
  None => false,
}

// An arm's parameters take the op's declared parameter types, positionally:
// each parameter node is the cell of the op's argument at its position, and
// its pattern is declared there as a function's is. An arity mismatch
// reports EHandlerArmArity FIRST; the aligned prefix still binds
// (productive-under-error).
fn bind_arm_args(args, params, op_name, span: ValidSpan) = {
  if len(args) != len(params) { report(EHandlerArmArity(op_name, len(params), len(args), span)) }
  each(bind_arm_arg(op_name, ??), zip(args, params))
  declare_param_binders(args, op_name)
}

fn bind_arm_arg(op_name: String, pair) = match pair {
  (a, param) => graph_bind(a, param_ty(param), Located(graph_span_of(a), Declared(op_name))),
}

// Unify a handler's payload var with the op's payload type carried in its
// (instantiated) row — Iterate(a) ⇒ unify a with P. This is the handler
// half of the payload flow; `~>` then unifies P with the body's E(performed).
// Bind the handler's instance var to the op's instance `TName(E, [args])`, read
// from the (instantiated) op row — so every arm of the handler shares ONE instance
// (yield/result share `element`; get()/set(v:s) share `s`) and `~>` unifies it
// per-position with the body's performed instance. Was: unify EACH arg to one
// payload_h, which crossed positions on a multi-payload effect (the result()->r
// element~result cycle). One instance, one unify; positions never cross.
fn unify_op_payload(op_row, inst_h, span: ValidSpan) = match op_instance_ty(op_row) {
  None => (),
  Some(inst) => {
    let ih = mint(Located(span, Inferred("op instance")))
    graph_bind(ih, inst, Located(span, Inferred("op instance")))
    unify(ih, inst_h, span, Inferred("effect instance to handler"))
  },
}

// The op's OWN instance `TName(E, [args])` from its single-effect row — the
// effect name is read LIVE from the row's EParameterized (Carried-Truth: the
// name is already there, never passed in), so `~>` unifies it per-position with
// the body's performed instance and every arm of the handler shares one instance.
fn op_instance_ty(row) = match row {
  EfRow(names, _, _) => op_instance_in_names(names),
  _ => None,
}

fn op_instance_in_names(names) = {
  let insts = flatten(map(
    {
      EParameterized(nm, args) => [TName(intern_name_of(nm), eparam_arg_tys(args))],
      ENamed(_) => [],
      EPure => [],
    },
    names
  ))
  if len(insts) == 0 { None } else { Some(last(insts)) }
}

// The effect's payload arity — the number of type positions in its instance
// (register_effect_ops' eff_vars). Read LIVE from its first op's row; 0 for a
// bare (unparameterized) effect. The handler exposes one fresh var per position
// so generalize quantifies each and every install freshens the whole instance.
fn effect_instance_arity(ename) = {
  let ops = match env_lookup(ename) {
    Some(entry) => match entry {
      (_, _, EffectDeclKind(o, _)) => o,
      _ => [],
    },
    None => [],
  }
  match ops {
    [] => 0,
    [op0, ..._] => match env_lookup(op0) {
      Some(oe) => match oe {
        (sch, _, _) => op_scheme_arity(sch),
      },
      None => 0,
    },
  }
}

fn op_scheme_arity(sch) = match judgment_ty(sch) {
  TFun(_, _, row) => match op_instance_ty(row) {
    Some(TName(_, args)) => len(args),
    // drift-audit: ignore — a bare/non-instance row HAS arity 0; the read's honest answer, not a fabricated default
    _ => 0,
  },
  // drift-audit: ignore — a non-fn scheme has no op instance; arity 0 is the honest answer
  _ => 0,
}

// n fresh instance vars for a handler's `Handler(E(v1..vn))` — one per the
// effect's payload position, exposed so generalize quantifies each.
fn mint_instance_vars(ename: String, n, i) = if i >= n {
  []
} else {
  [mint(Inferred("effect '{ename}' instance {i}"))] ++ mint_instance_vars(ename, n, i + 1)
}

// Generalization — Damas-Milner let-gen.
// Quantify handles that are free in the body but NOT free in env.
// CONDEMNED FORM (the resolved design D1/D2): in the terminal judgment
// generalize writes NOTHING — a parameter is the completion-bit read
// over the decl's planned band, and the stored Forall snapshot this fn
// mints is the disease the whole tower compensates for. Deletes at
// rung 3; takes no improvements until then (Anchor 2's condemned
// clause).
//
// H6: exhaustive NodeKind enumeration. Fabricated-value danger:
// a wildcard arm returning Frozen([], TVar(handle)) silently
// fabricates a monotype for every non-NBound kind — CLAUDE.md
// Session Zero names this as a dangerous wildcard. Each non-bound
// kind gets its own arm with the same fallback spelled out; if a
// new NodeKind is added, this function fails to compile until its
// generalization semantic is decided.
fn generalize_signature(handle) = {
  let node = graph_chase(handle)
  match node {
    GNode(kind, _) => match kind {
      NBound(ty) => {
        let body_ty = chase_deep(ty)
        // A fn quantifies its SIGNATURE's frees only — params and return
        // (D1's own sentence: instantiate mints fresh cells for exactly
        // the decl's parameter cells). A free cell reachable only through
        // the TOP row is never the decl's polymorphism: it is a LIVE LINK
        // (a co-member's cell, a forward decl's accumulator, an unbound
        // charge) that instantiation must SHARE, not freshen — freshening
        // severs it (the B1-revert's mechanism), and quantifying it
        // multiplies: each reference re-mints every quantified charge
        // copy, the copies stay free, the caller's exit re-quantifies
        // them — qvars(f) = Σ refs × qvars(callee), measured to the 4GB
        // guard inside instantiate on a 6,458-line lib blob (the
        // one-way-edge arc's prefix bisection). Effect polymorphism
        // survives whole: map's e occurs in its PARAM type, so the
        // signature collection carries every genuine poly var.
        // The row's own frees SPLIT by sort: an EAType payload var inside
        // an instance (Iterate's element) is TYPE-sort substitutable
        // polymorphism and must freshen per use — dropping it shared one
        // element cell across every caller (Float vs Int at the dsp
        // weave, the 286-class, measured the hour the bare-sig form
        // ran). Only ROW-sort cells reachable solely through the top row
        // stay unquantified-and-shared.
        match body_ty {
          TFun(dps, ret, frow) => (
            unique(free_in_params(dps) ++ free_in_ty(ret) ++ filter((h) => if is_row_handle(h) { false } else { true }, free_in_row(frow))),
            body_ty
          ),
          // The continuation's world is a row POSITION exactly as a fn's
          // top row is (TCont carries an EffRow): its row-sort roots are
          // live links instantiation must SHARE, its EAType payload vars
          // are TYPE-sort polymorphism that freshens — the TFun arm's
          // split at the TIME altitude. H6: exhaustive Ty arms below —
          // the former wildcard quantified a continuation's world rows
          // and silently absorbed every future variant.
          TCont(input, answer, _, world) => (
            unique(free_in_ty(input) ++ free_in_ty(answer) ++ filter((h) => if is_row_handle(h) { false } else { true }, free_in_row(world))),
            body_ty
          ),
          TInt => ([], body_ty),
          TFloat => ([], body_ty),
          TUnit => ([], body_ty),
          TByte => ([], body_ty),
          TAddr => ([], body_ty),
          TVar(v) => ([v], body_ty),
          TList(_) => (free_in_ty(body_ty), body_ty),
          TTuple(_) => (free_in_ty(body_ty), body_ty),
          TName(_, _) => (free_in_ty(body_ty), body_ty),
          TRecord(_) => (free_in_ty(body_ty), body_ty),
          TRecordOpen(_, _) => (free_in_ty(body_ty), body_ty),
          TRefined(_, _) => (free_in_ty(body_ty), body_ty),
          TAlias(_, _) => (free_in_ty(body_ty), body_ty),
          TReprPin(_, _) => (free_in_ty(body_ty), body_ty),
        }
      },
      // An unresolved publish QUANTIFIES its own cell: sharing the live cell
      // let every caller bind it (callers teaching the decl through the
      // publish — the order-conditional disease at the value boundary; under
      // the converged judge the decl learns only through its own re-judgment,
      // and the parallel fan's branches must never bind a shared cell). Each
      // instantiation freshens into its own band; the decl's cell stays the
      // decl's own verdict.
      NFree(_) => ([handle], TVar(handle)),
      // row handle — BOUND content; shared reads only
      NRowBound(_) => ([], TVar(handle)),
      // record-row residual — bound; row sort
      NRecordRowBound(_, _) => ([], TVar(handle)),
      // unresolved row — quantified like NFree; instantiate's row-sort mint freshens
      NRowFree(_) => ([handle], TVar(handle)),
      // error — preserve handle for diagnostics
      NErrorHole(_) => ([], TVar(handle)),
    },
  }
}

// The cell→scheme projection: generalize_pair's verdict wrapped as the env's
// currency. Publishers freeze through it; instantiate clones through it.
// A signature's quantified variables, with every row an update relates to
// one of them: the relation is copied with the scheme, so its two ends are
// freshened together, or a copy's end would still name the declaration's
// own cell and every caller would write into it.
fn generalize_pair(handle) = match generalize_signature(handle) {
  (qs, ty) => if any(row_carries_copy, qs) { (rows_related_closure(qs, qs), ty) } else { (qs, ty) },
}

fn row_carries_copy(q) =
  is_row_handle(q) && any(is_copy_demand, graph_demands_of(graph_chase_handle(q)))

fn is_copy_demand(d) = match d {
  DemandCopy(_, _, _) => true,
  DemandNumber(_) | DemandShape(_) | DemandLacks(_) => false,
}

fn rows_related_closure(seen, todo) = match todo {
  [] => seen,
  [q, ...rest] => {
    let ps = filter({ p => !any({ s => s == p }, seen) }, row_relatives(q))
    rows_related_closure(seen ++ ps, rest ++ ps)
  },
}

fn row_relatives(q) = flat_map(demand_relative, graph_demands_of(graph_chase_handle(q)))

fn demand_relative(d) = match d {
  DemandCopy(base, copy, _) => filter(row_var_is_free, row_free_ends(base) ++ row_free_ends(copy)),
  DemandNumber(_) | DemandShape(_) | DemandLacks(_) => [],
}

fn generalize(handle) = match generalize_pair(handle) {
  (qs, ty) => Frozen(qs, ty),
}

// The one reader-side read of an env judgment: a frozen decl reads straight
// through; a live one rides the decl's own split rule at THIS read — the
// projection is never stored. A new posture arms here, not at every reader.
fn judgment_ty(b) = match b {
  Frozen(_, ty) => ty,
  Live(h) => match generalize_pair(h) {
    (_, ty) => ty,
  },
}

// The pair form, for readers that re-quantify or alpha-compare the set.
fn judgment_pair(b) = match b {
  Frozen(qs, ty) => (qs, ty),
  Live(h) => generalize_pair(h),
}

// H6: exhaustive Ty enumeration. Scalars terminate; aggregates
// recurse. Identity for unresolved TVars (when graph_chase lands
// on a non-NBound kind). A new Ty with embedded sub-types that
// could contain TVars would need its own recursive arm — fails
// to compile here until the decision is made.
// PRODUCTIVE-UNDER-ERROR at the read (the HANG law, CLAUDE.md ⟲): a graph
// CYCLE — however it got past the write guards — must project as a
// diagnostic, never a stack exhaustion. The depth bound is structural
// paranoia, not a semantics: no real resolved type nests 200 deep, so
// crossing it IS the cycle, reported once with the shape in hand.
fn chase_deep(ty) = chase_deep_at(ty, 0)

fn chase_probe_tag(ty) = match ty {
  TVar(h) => "TVar({int_to_str(h)})",
  TFun(ps, _, _) => "TFun/{int_to_str(len(ps))}",
  TList(_) => "TList",
  TTuple(_) => "TTuple",
  TName(n, _) => "TName({n})",
  TRecord(_) => "TRecord",
  TRecordOpen(_, _) => "TRecordOpen",
  TRefined(_, _) => "TRefined",
  TCont(_, _, _, _) => "TCont",
  TAlias(n, _) => "TAlias({n})",
  TInt => "TInt",
  TFloat => "TFloat",
  TUnit => "TUnit",
  TByte => "TByte",
  TAddr => "TAddr",
  TReprPin(_, _) => "TReprPin",
}

// The canonical snapshot SHARES every unchanged subtree (A.3 — the second
// unconditional reconstructor beside subst_ty, per the adversarial panel).
// CHECK-THEN-BUILD: a Bool change-walk (word returns — zero allocation)
// gates the eager build, and the build recurses through the sharing face,
// so every unchanged sub-subtree inside a changed parent re-shares. The
// first sharing form flag-threaded a tuple per arm return, and the
// artifact refuted it: tuples are heap records here, so the scalar arms
// minted garbage that canceled the sharing — a measured +6% on the
// self-compile. Unchanged subtrees now pay ONE pure walk and zero
// records; only the changed spine walks twice. Output SHAPE is exactly
// the eager walk's; sharing changes where records come from, never what
// they hold (Ty records are immutable values — the graph is the mutable
// layer).
fn chase_deep_at(ty, d) = if chase_changes(ty, d) { chase_deep_build(ty, d) } else { ty }

// Would the canonical snapshot differ from this record? An NBound var
// inlines its binding (always differs); a free var differs only when it
// canonicalizes off-root; aggregates OR their children (short-circuit —
// the first change decides). The depth tripwire answers TRUE so the build
// path runs and reports the cycle.
fn chase_changes(ty, d) = if d > 200 {
  true
} else {
  match ty {
    TInt => false,
    TFloat => false,
    TUnit => false,
    TByte => false,
    TAddr => false,
    TVar(h) => match graph_chase(h) {
      GNode(kind, _) => match kind {
        NBound(_) => true,
        NFree(_) => graph_chase_handle(h) != h,
        NRowBound(_) => false,
        NRecordRowBound(_, _) => false,
        NRowFree(_) => false,
        NErrorHole(_) => false,
      },
    },
    TList(elem) => chase_changes(elem, d + 1),
    TTuple(elems) => chase_list_changes(elems, d + 1, 0, len(elems)),
    TFun(params, ret, eff) => chase_params_changes(params, d + 1, 0, len(params)) || chase_changes(ret, d + 1) || chase_row_changes(eff, d + 1),
    TName(_, args) => chase_list_changes(args, d + 1, 0, len(args)),
    TRecord(fields) => chase_fields_changes(fields, d + 1, 0, len(fields)),
    TRecordOpen(fields, v) => chase_fields_changes(fields, d + 1, 0, len(fields)) || record_rest_moves(v),
    TRefined(base, _) => chase_changes(base, d + 1),
    TCont(input, answer, _, world) => chase_changes(input, d + 1) || chase_changes(answer, d + 1) || chase_row_changes(world, d + 1),
    TAlias(_, inner) => chase_changes(inner, d + 1),
    TReprPin(_, base) => chase_changes(base, d + 1),
  }
}

fn chase_list_changes(tys, d, i, n) = if i >= n {
  false
} else if chase_changes(list_index(tys, i), d) {
  true
} else {
  chase_list_changes(tys, d, i + 1, n)
}

fn chase_params_changes(params, d, i, n) = if i >= n {
  false
} else if chase_changes(param_ty(list_index(params, i)), d) {
  true
} else {
  chase_params_changes(params, d, i + 1, n)
}

fn chase_fields_changes(fields, d, i, n) = if i >= n {
  false
} else {
  match list_index(fields, i) {
    (_, ty) => if chase_changes(ty, d) { true } else { chase_fields_changes(fields, d, i + 1, n) },
  }
}

// Whether the snapshot reads a record row's rest as anything but the rest
// written: a link past it, or the free rest under another name — the cases
// record_row_full walks.
fn record_rest_moves(v) = match graph_chase(v) {
  GNode(NRecordRowBound(_, _), _) => true,
  GNode(NBound(TRecordOpen(_, _)), _) => true,
  GNode(NBound(TRecord(_)), _) => true,
  _ => graph_chase_handle(v) != v,
}

fn chase_row_changes(eff, d) = match eff {
  EfRow(p, a, t) => {
    // A BOUND edge is ALWAYS a change: the build folds the binding to its
    // VALUE (subst_row_changes' law at the chase face). Free edges stay —
    // generalize's NRowFree arm quantifies them.
    let tail_hit = match t {
      EtOpen(vs) => edges_any_bound(vs) || edges_masks_change(vs, d),
      _ => false,
    }
    tail_hit || chase_names_changes(p, d, 0, len(p)) || chase_names_changes(a, d, 0, len(a))
  },
}

// A BOUND edge is ALWAYS a change (folding IS the change — the build
// arm folds bindings by recursion, freshening nested frees at any
// depth; answering false shared whole chains, the window-8 race).
// Structural walk, the row walks' discipline.
fn edges_any_bound(ref vs: [RowEdge]) = match vs {
  [] => false,
  [e, ...rest] => match graph_chase(edge_cell(e)) {
    GNode(NRowBound(_), _) => true,
    _ => edges_any_bound(rest),
  },
}

// A mask's parameterized names carry payload types exactly as the present
// set's do, so the canonical form reaches them too (the trio law).
fn edges_masks_change(vs: [RowEdge], d) = match vs {
  [] => false,
  [e, ...rest] => chase_names_changes(edge_mask(e), d, 0, len(edge_mask(e))) || edges_masks_change(rest, d),
}

fn chase_names_changes(names, d, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(names, i) {
    EParameterized(_, args) => chase_args_changes(args, d, 0, len(args)),
    ENamed(_) => false,
    EPure => false,
  }
  if hit { true } else { chase_names_changes(names, d, i + 1, n) }
}

fn chase_args_changes(args, d, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(args, i) {
    EAType(t2) => chase_changes(t2, d),
    _ => false,
  }
  if hit { true } else { chase_args_changes(args, d, i + 1, n) }
}

// The eager build — runs only under a proven change; children recurse
// through chase_deep_at, so unchanged subtrees re-share at every level.
fn chase_deep_build(ty, d) = if d > 200 {
  // Unreachable once the occurs guard recurses bindings (no cycle can enter
  // the graph); a firing here means a write path slipped the guard — the
  // tripwire names the shape without recursing it (show_type would spin),
  // as the internal-invariant refusal it is. Through boot 6e35c6db it was a
  // raw write to stderr, and the first chain `mentl why src/main.mn
  // infer_var_ref WASI` printed (2026-10-13) ended here: the compiler's
  // judgment of every variable reference performed the host for a sentence
  // meant never to print.
  report(EInternalInvariant(
    "chase_deep depth tripwire — cyclic graph at {chase_probe_tag(ty)}",
    span_zero()
  ))
  ty
} else {
  match ty {
    TInt => ty,
    TFloat => ty,
    TUnit => ty,
    TByte => ty,
    TAddr => ty,
    TVar(h) => match graph_chase(h) {
      GNode(kind, _) => match kind {
        NBound(inner) => chase_deep_at(inner, d + 1),
        // A free var canonicalizes to its union-find ROOT, never the surface
        // alias: a scheme snapshot holding two aliases of ONE class quantifies
        // both, and instantiate then freshens them separately — the class
        // SPLITS at every use (fold_handler's acc/init/instance-r measured as
        // one live root 12914 yet stored as t12917 vs t12914 vs t12913, so
        // every fold/map/filter caller rode an element-orphaned scheme — the
        // subscript-fracture law at the generalize/instantiate layer).
        NFree(_) => TVar(graph_chase_handle(h)),
        // row handle used as Ty — stays
        NRowBound(_) => ty,
        // record-row residual — row sort; stays
        NRecordRowBound(_, _) => ty,
        // unresolved row handle — stays
        NRowFree(_) => ty,
        // error node — preserve TVar for diagnostics
        NErrorHole(_) => ty,
      },
    },
    TList(elem) => TList(chase_deep_at(elem, d + 1)),
    TTuple(elems) => TTuple(map_chase_ty(elems, d + 1)),
    // The ROW canonicalizes with the type: an EParameterized instance's
    // EAType vars are the row's substitutable payload (free_in_row and
    // subst_row both descend them), so a snapshot that skipped the row kept
    // SURFACE aliases there while the type side stored roots — the same
    // class-split at the row layer (fold's xs-element never reached f's elem
    // through iterate's published instance). The three vars-of-a-type walks
    // must agree over rows (the occurs-law trio); the snapshot now feeds all
    // three the same canonical form.
    TFun(params, ret, eff) => TFun(chase_params(params, d + 1), chase_deep_at(ret, d + 1), chase_row_deep(eff, d + 1)),
    TName(name, args) => TName(name, map_chase_ty(args, d + 1)),
    TRecord(fields) => TRecord(chase_fields(fields, d + 1)),
    // The row is read to its END, as `free_in_record_row` and
    // `subst_row_walk` read it: every link's fields chased, the rest the free
    // root or the proven close. A snapshot that kept the head's fields over an
    // unread rest carried each later link's field types raw, so the quantifier
    // took their BOUND variables as free and every instance freshened them
    // without their binding: a record parameter crossing a call kept the first
    // field it read and lost the rest, and a field of the wrong arity was
    // never refused (tests/micros/mn-record-chain-crosses-call.mn).
    TRecordOpen(fields, v) => match record_row_full(fields, v) {
      (all, end) => match end {
        RowEndFree(t) => mk_record_open(chase_fields(all, d + 1), t),
        RowEndClosed => TRecord(field_canonicalize(chase_fields(all, d + 1))),
      },
    },
    TRefined(base, pred) => TRefined(chase_deep_at(base, d + 1), pred),
    TCont(input, answer, disc, world) => TCont(chase_deep_at(input, d + 1), chase_deep_at(answer, d + 1), disc, chase_row_deep(world, d + 1)),
    TAlias(name, inner) => TAlias(name, chase_deep_at(inner, d + 1)),
    TReprPin(r, base) => TReprPin(r, chase_deep_at(base, d + 1)),
  }
}

// An unchanged row IS its own canonical form (rows are canonical at
// birth), so the sharing face returns it whole.
fn chase_row_deep(eff, d) = if chase_row_changes(eff, d) {
  match eff {
    EfRow(p, a, t) => {
      let p2 = chase_eff_names(p, d)
      let a2 = chase_eff_names(a, d)
      // THE VALUE BOUNDARY AT THE CHASE FACE (the bind census's verdict:
      // a declared fn's BOUND row cell rode EtVar through generalize's
      // chase into its published scheme — a live pointer into the decl's
      // band that concurrent callers folded mid-flight, the six-battery's
      // 5-1 split on driver_extract_imports' cell). A bound tail folds to
      // its VALUE by recursion, exactly as subst_row_build's arm, under
      // resolve_row's read law: the inner present joins MINUS this
      // face's absent — the pending `~>` subtraction filters what the
      // tail delivers (an unfiltered union hands ef_make a present∩absent
      // collision and canonicalization deletes the ABSENT: the mask
      // INVERTS — measured as GraphRead/Intern surviving infer_context's
      // bracket into every verb run's published row). A published scheme
      // is then a value or a quantified var, never a live pointer.
      match t {
        EtOpen(vs) => match chase_edges_deep(edges_masked(vs, a2), (p2, [], [], false), d) {
          (rp, am, res, saw_all) => row_of_fold(rp, am, res, saw_all),
        },
        _ => ef_make(p2, a2, t),
      }
    },
  }
} else {
  eff
}

// The chase-face edge walk, structural (the row walks stay off the
// Iterate vocabulary): a bound edge folds its DEEP value through the
// shared assembly (edge_content_into — the same reading-law joins
// resolve rides); a free edge survives into the residual set.
fn chase_edges_deep(ref vs: [RowEdge], acc, d) = match vs {
  [] => acc,
  [e, ...rest] => match acc {
    (p, am, res, saw_all) => {
      // An unmasked edge is its own canonical form — no copy (the chase
      // face's sharing law: an unchanged value is returned whole).
      let e2 =
        if len(edge_mask(e)) == 0 { e } else { row_edge(edge_cell(e), chase_eff_names(edge_mask(e), d)) }
      let next = match graph_chase(edge_cell(e)) {
        GNode(kind, _) => match edge_row_of(kind) {
          Some(inner) => match edge_content_into(p, am, res, saw_all, edge_mask(e2), chase_row_deep(inner, d + 1)) {
            (p2, am2, r2, s2, _) => (p2, am2, r2, s2),
          },
          None => (p, am, tail_set_insert(res, e2), saw_all),
        },
      }
      chase_edges_deep(rest, next, d)
    },
  },
}

fn chase_eff_names(names, d) = map(
  {
    EParameterized(n, args) => EParameterized(n, map({ EAType(t2) => EAType(chase_deep_at(t2, d)), other => other }, args)),
    other => other,
  },
  names
)

fn map_chase_ty(tys, d) = map((t) => chase_deep_at(t, d), tys)

fn chase_params(params, d) = map((p) => param_with_ty(p, chase_deep_at(param_ty(p), d)), params)

fn chase_fields(fields, d) = map({ (name, ty) => (name, chase_deep_at(ty, d)) }, fields)

// H6: exhaustive Ty enumeration. Scalars have no free handles;
// aggregates recurse; TVar IS a free handle; TRecordOpen's row
// var is free. A new Ty containing TVars would need its own arm —
// `_ => []` would silently miss them.
fn free_in_ty(ty) = match ty {
  TInt => [],
  TFloat => [],
  TUnit => [],
  TByte => [],
  TAddr => [],
  TVar(id) => [id],
  TList(elem) => free_in_ty(elem),
  TTuple(elems) => free_in_list(elems),
  TFun(params, ret, eff) => free_in_params(params) ++ free_in_ty(ret) ++ free_in_row(eff),
  TName(_, args) => free_in_list(args),
  TRecord(fields) => free_in_fields(fields),
  TRecordOpen(fields, v) => free_in_record_row(v) ++ free_in_fields(fields),
  TRefined(base, _) => free_in_ty(base),
  TCont(input, answer, _, world) => free_in_ty(input) ++ free_in_ty(answer) ++ free_in_row(world),
  TAlias(_, inner) => free_in_ty(inner),
  TReprPin(_, base) => free_in_ty(base),
}

// A record row's free variable is what its residual still leaves unknown —
// the identical rule free_in_row states for an effect row six lines below,
// which this sort never applied. Collecting the cell unconditionally called
// a BOUND row free, so generalize quantified a proven residual and
// instantiate minted a fresh empty one in its place: measured on
// mn-findtag, the annotation closed row 24730 and the field access read
// 24736, six cells later, with the offset unprovable in between. The proof
// was severed by the collector, not lost by the unifier.
//
// The row is read to its END, the same walk every reader takes: its fields'
// frees, and the free rest past them when there is one. A rest reached
// through an error cell is not a variable, so it contributes nothing — a
// true reading, not a floor.
fn free_in_record_row(v) = match record_row_full([], v) {
  (fields, end) => free_in_fields(fields) ++ free_record_rest(end),
}

fn free_record_rest(end) = match end {
  RowEndFree(t) => if row_var_is_free(t) { [t] } else { [] },
  RowEndClosed => [],
}

fn free_in_list(tys) = tys |> map(free_in_ty) |> flatten

fn free_in_params(params) = params |> map((p) => free_in_ty(param_ty(p))) |> flatten

fn free_in_fields(fields) = fields |> map({ (_, ty) => free_in_ty(ty) }) |> flatten

// A row's free variable is its open tail — the same first-class graph
// node a type variable is. Effect-polymorphism IS value-polymorphism over
// the row domain; the row var is quantified exactly like a TVar. Collect
// the tail ONLY when it is genuinely free (NRowFree): a tail already bound
// to a concrete row is not a free var, and quantifying it would re-freshen
// a monomorphic fn's row at every call site. chase_deep leaves the row
// verbatim, so the freeness check happens here (the row mirror of how
// chase_deep resolves bound TVars before free_in_ty collects the free ones).
fn free_in_row(eff) = match eff {
  // ONE triple walk: a parameterized effect carries its op-payload TYPE
  // (Iterate(a)) on either field; the payload's free vars are the row's
  // free vars, and a free TAIL root joins them — generalize quantifies,
  // instantiate freshens (effect-polymorphism as HM over the row sort).
  EfRow(p, a, t) => {
    let tail = match t {
      EtOpen(vs) => free_in_edges(vs),
      _ => [],
    }
    free_in_eff_names(p) ++ free_in_eff_names(a) ++ tail
  },
}

// The edge collection, structural: a free edge contributes its chased
// root; a BOUND edge is not itself a var — but subst_row's merge arm
// traverses INTO its binding (the closed-tail instance merge), so
// collection must reach the same leaves: the inner row's payload vars
// are this row's free vars (the trio law — free/occurs/subst agree
// over rows, here through every edge's binding).
fn free_in_edges(ref vs: [RowEdge]) = match vs {
  [] => [],
  [e, ...rest] => {
    let r = graph_chase_handle(edge_cell(e))
    let here = if row_var_is_free(r) {
      [r]
    } else {
      match graph_chase(r) {
        GNode(kind, _) => match edge_row_of(kind) {
          Some(inner) => free_in_row(inner),
          None => [],
        },
      }
    }
    // The mask's payload vars are the row's too — subst freshens them.
    free_in_eff_names(edge_mask(e)) ++ here ++ free_in_edges(rest)
  },
}

// The free type vars inside an effect-row's parameterized payloads
// (Iterate(a) ⇒ a's free vars). Bare ENamed effects carry none.
fn free_in_eff_names(names) = names |> map({
  ENamed(_) => [],
  // the identity carries no free vars
  EPure => [],
  EParameterized(_, args) => args |> map(free_in_eff_arg) |> flatten,
}) |> flatten

fn free_in_eff_arg(arg) = match arg {
  EAInt(_) => [],
  EAFloat(_) => [],
  EAString(_) => [],
  EAType(ty) => free_in_ty(ty),
  // an opaque operand-node handle, not an
  // embedded Ty — carries no free type vars
  EANode(_) => [],
  // interned identities — no embedded Ty, no free vars
  EAEffect(_) => [],
  EACon(_) => [],
}

// The decl's signature frees, read at exit time THROUGH the live cells —
// params + return deep-chased, so a HOF parameter's row var (minted by the
// body's own call site, above the prereg ceiling) is collected from the
// cell the body actually bound, never from a declared-slot snapshot. The
// completion prune keeps these roots: a free edge the signature reaches
// escapes through instantiate at every call site (generalize's signature
// collection quantifies exactly these), so the prune's "no constraint can
// arrive" reading is false for them.
fn signature_free_roots(cells) =
  cells |> map((c) => free_in_ty(chase_deep(TVar(c)))) |> flatten |> unique

fn row_var_is_free(v) = match graph_chase(v) {
  GNode(NRowFree(_), _) => true,
  // A free node in ROW POSITION is a free row var regardless of its
  // mint sort: the loose pre-registration and parse_type_ty mint
  // function-type row vars as TYPE handles (NFree, reason e0 — the
  // named parser residue), and a sort-blind freeness check made those
  // tails INVISIBLE to collection while subst_row's catch-all SHARED
  // them — every caller of an effect-polymorphic scheme then chained
  // one live row (measured: infer_context's stored scheme mutating
  // between its callers' reads; the E_EffectMismatch quartet). The
  // three walks agree by tolerating the sort at the same leaf.
  GNode(NFree(_), _) => true,
  _ => false,
}

// Instantiation — one function, two handlers.
// inference handler: `mint(r) => resume(perform graph_fresh_ty(r))`
// query handler:     `mint(r) => resume(next_display_id(r))`
// Same function; different semantics via handler swap.
// CONDEMNED FORM (the resolved design D1/D5): terminal instantiation
// mints fresh cells for the decl's parameter cells and draws one
// one-way CORRESPONDENCE EDGE per pair — teaching then propagates
// decl→site as joins, and the clone-the-type walk deletes.
fn instantiate(scheme) = match scheme {
  Frozen(qs, ty) => if len(qs) == 0 {
    ty
  } else {
    let mapping = build_inst_mapping(qs)
    relations_copy(mapping)
    subst_ty(ty, mapping)
  },
  // A judgment-published decl: the quantifier is a projection the caller
  // runs — generalize's split rule reads the LIVE cell at this moment of
  // consumption (never a stored materialization), and the clone rides the
  // mapped spine as before.
  Live(h) => instantiate(generalize(h)),
}

// A quantified var's domain is carried in the graph — NRowFree means a row
// variable, minted fresh as a row (graph_fresh_row); NFree means a type
// variable (graph_fresh_ty). The mint/mint_row op split mirrors
// graph_fresh_ty/graph_fresh_row and keeps the handler swap total (query
// renders both as display ids). Read the domain live; never re-derive it.
fn build_inst_mapping(qs) = map(
  (old) => {
    // Key by the union-find ROOT, matching subst_ty's root-keyed lookup: a
    // quantified var aliased after generalize still freshens (read the root,
    // carry the whole instance).
    let root = graph_chase_handle(old)
    let fresh = if is_row_handle(root) {
      mint_row(Instantiation("inst", Fresh(root)))
    } else {
      mint(Instantiation("inst", Fresh(root)))
    }
    // THE COPY IS GATED AS ITS ROOT IS — the gate is a property of the
    // cell, read live at instantiation and never frozen into the scheme
    // (the qualified-type reading, `∀r. (E ∉ r) ⇒ …`, with the constraint
    // on the variable). And a copy minted while the root's declaration is
    // still OPEN — a self-reference instantiating the pre-registered or
    // assumed scheme, a cycle member instantiating an unjudged
    // co-member's — is NOTED under the root, so the exit install that has
    // not happened yet reaches it (a gate reaching a root walks its
    // instances). The bound is exact: a root below the prereg ceiling is
    // an unjudged co-member's cell, one at or above the open entry is this
    // declaration's own; every other root belongs to an exited declaration
    // whose gates the copy above already carries.
    gates_copy(graph_gates_of(root), fresh)
    demands_copy(graph_demands_of(root), fresh)
    if root < inf_mint_ceiling() || root >= inf_decl_entry() {
      graph_instance_note(root, fresh)
    } else {
      ()
    }
    (root, fresh)
  },
  qs
)

fn gates_copy(gs, fresh) = match gs {
  [] => (),
  [g, ...rest] => {
    graph_gate_add(fresh, g)
    gates_copy(rest, fresh)
  },
}

fn is_row_handle(h) = match graph_chase(h) {
  GNode(NRowFree(_), _) => true,
  GNode(NRowBound(_), _) => true,
  GNode(NRecordRowBound(_, _), _) => true,
  _ => false,
}

// H6: exhaustive Ty enumeration. Scalars pass through; aggregates recurse.
// Substitution is identity for unresolved sites where mapping doesn't have
// the handle — and identity SHARES (A.3: instantiate shares, never clones).
// CHECK-THEN-BUILD, the chase_deep_at shape: subst_changes is the Bool
// change-walk (word returns — zero allocation), and the eager build
// recurses through this sharing face so unchanged sub-subtrees re-share.
// A polymorphic reference's clone volume collapses to the mapped spine.
fn subst_ty(ty, mapping) = if subst_changes(ty, mapping) { subst_ty_build(ty, mapping) } else { ty }

// Would substitution differ from this record? An NBound var inlines its
// binding (always differs); a free var differs only when the mapping
// carries its root; aggregates OR their children (short-circuit).
fn subst_changes(ty, mapping) = match ty {
  TInt => false,
  TFloat => false,
  TUnit => false,
  TByte => false,
  TAddr => false,
  // THE CHECK CHASES, SO THE BUILD CAN SHARE. This answered TRUE for every
  // bound var — "an NBound var inlines its binding (always differs)" — and
  // in a JUDGED decl most vars are bound, so check-then-build was here but
  // never got to answer no: every polymorphic reference rebuilt the callee's
  // whole type tree. That is Hβ.infer.instantiate-shares-never-clones, whose
  // cost the docs place on the ALLOCATION channel rather than time.
  // Following the edge and asking whether the CONTENT changes is the same
  // question asked where the answer lives: a bound cell holding no mapped
  // var answers false and its entire subtree SHARES; only a path that
  // actually reaches a quantified var rebuilds, and it rebuilds exactly as
  // before. Privacy is untouched — the mapping still decides first, so a
  // quantified var freshens per use.
  // Answering by the mapping ALONE is the opposite error and was measured on
  // the way here: a quantified var sitting BEHIND a binding goes unseen,
  // never freshens, and polymorphism severs silently.
  // Termination is the occurs invariant's — graph_bind refuses a type cell
  // containing itself; the row sort's benign self-loops go through
  // subst_row_changes, not this walk.
  TVar(id) => if find_mapping(mapping, graph_chase_handle(id)) >= 0 {
    true
  } else {
    match graph_chase(id) {
      GNode(NBound(inner), _) => subst_changes(inner, mapping),
      _ => false,
    }
  },
  TList(elem) => subst_changes(elem, mapping),
  TTuple(elems) => subst_list_changes(elems, mapping, 0, len(elems)),
  TFun(params, ret, eff) => subst_params_changes(params, mapping, 0, len(params)) || subst_changes(ret, mapping) || subst_row_changes(eff, mapping),
  TName(_, args) => subst_list_changes(args, mapping, 0, len(args)),
  TRecord(fields) => subst_fields_changes(fields, mapping, 0, len(fields)),
  // Mapping-first, matching the build: a quantified rest freshens even
  // when since-bound, so any hit IS a change — at the head or at any link
  // of the chain the build walks.
  TRecordOpen(fields, v) => subst_fields_changes(fields, mapping, 0, len(fields)) || subst_row_chain_changes(v, mapping),
  TRefined(base, _) => subst_changes(base, mapping),
  TCont(input, answer, _, world) => subst_changes(input, mapping) || subst_changes(answer, mapping) || subst_row_changes(world, mapping),
  TAlias(_, inner) => subst_changes(inner, mapping),
  TReprPin(_, base) => subst_changes(base, mapping),
}

fn subst_list_changes(tys, mapping, i, n) = if i >= n {
  false
} else if subst_changes(list_index(tys, i), mapping) {
  true
} else {
  subst_list_changes(tys, mapping, i + 1, n)
}

fn subst_params_changes(params, mapping, i, n) = if i >= n {
  false
} else if subst_changes(param_ty(list_index(params, i)), mapping) {
  true
} else {
  subst_params_changes(params, mapping, i + 1, n)
}

fn subst_fields_changes(fields, mapping, i, n) = if i >= n {
  false
} else {
  match list_index(fields, i) {
    (_, ty) => if subst_changes(ty, mapping) { true } else { subst_fields_changes(fields, mapping, i + 1, n) },
  }
}

// The row's change test mirrors subst_row's arms exactly: a merge with a
// solved bound row always rebuilds; a mapped tail always rebuilds; else
// only a changed EParameterized payload does.
fn subst_row_changes(eff, mapping) = match eff {
  EfRow(ns, ab, t) => {
    let tail_hit = match t {
      EtOpen(vs) => subst_edges_changed(vs, mapping),
      _ => false,
    }
    tail_hit || subst_names_changes(ns, mapping, 0, len(ns)) || subst_names_changes(ab, mapping, 0, len(ab))
  },
}

// The subst change test per edge, structural: a bound edge ALWAYS
// rebuilds (folding IS the change — the one-level t2 check let a
// two-deep chain's free terminal ride into every caller, the window-8
// first-binder race); a free edge of either sort (row_var_is_free's
// T-handle tolerance) changes exactly on a mapping hit.
fn subst_edges_changed(ref vs: [RowEdge], mapping) = match vs {
  [] => false,
  [e, ...rest] => {
    let v = edge_cell(e)
    let hit = match graph_chase(v) {
      GNode(NRowBound(_), _) => true,
      GNode(NRowFree(_), _) => find_mapping(mapping, graph_chase_handle(v)) >= 0,
      GNode(NFree(_), _) => find_mapping(mapping, graph_chase_handle(v)) >= 0,
      _ => false,
    }
    if hit || subst_names_changes(edge_mask(e), mapping, 0, len(edge_mask(e))) {
      true
    } else {
      subst_edges_changed(rest, mapping)
    }
  },
}

fn subst_names_changes(names, mapping, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(names, i) {
    EParameterized(_, args) => subst_args_changes(args, mapping, 0, len(args)),
    ENamed(_) => false,
    EPure => false,
  }
  if hit { true } else { subst_names_changes(names, mapping, i + 1, n) }
}

fn subst_args_changes(args, mapping, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(args, i) {
    EAType(ty) => subst_changes(ty, mapping),
    _ => false,
  }
  if hit { true } else { subst_args_changes(args, mapping, i + 1, n) }
}

// The eager build — runs only under a proven change; children recurse
// through subst_ty, so unchanged subtrees re-share at every level.
// CONDEMNED FORM (the resolved design D1): substitution IS the
// union-find chase; both subst builds delete with the scheme snapshot
// they serve.
fn subst_ty_build(ty, mapping) = match ty {
  TInt => ty,
  TFloat => ty,
  TUnit => ty,
  TByte => ty,
  TAddr => ty,
  TVar(id) => {
    // THE FROZEN READ — the mapping decides BEFORE any live chase. A var in
    // the mapping was free at the freeze, so whatever bound it since is
    // post-freeze teaching (another caller's private constraint under the
    // parallel fan) — it freshens, never reads through (Carried-Truth at the
    // scheme boundary: the freeze exists so readers never read live). Only a
    // MISS chases: a var deliberately unquantified — the handler
    // config↔payload two-phase case (config vars are not in the handler
    // scheme's q, so the arm-walk's later binding legitimately resolves
    // here), monomorphic self-entries, and pre-freeze-bound structure. The
    // root-keyed lookup keeps aliased qvars freshening.
    let replacement = find_mapping(mapping, graph_chase_handle(id))
    if replacement >= 0 {
      TVar(replacement)
    } else {
      match graph_chase(id) {
        GNode(NBound(inner), _) => subst_ty(inner, mapping),
        _ => ty,
      }
    }
  },
  TList(elem) => TList(subst_ty(elem, mapping)),
  TTuple(elems) => TTuple(subst_list(elems, mapping)),
  TFun(params, ret, eff) => TFun(subst_params(params, mapping), subst_ty(ret, mapping), subst_row(eff, mapping)),
  TName(name, args) => TName(name, subst_list(args, mapping)),
  TRecord(fields) => TRecord(subst_fields(fields, mapping)),
  // Freshen the rest, mirroring subst_row's edge walk: free_in_ty collects
  // the row's free rest, so generalize quantifies it and instantiate MUST
  // freshen it. The row is a CHAIN, and the instance is built from all of
  // it: stopping at the head shared every link past it across every
  // instantiation, so each caller of a helper that reads two fields wrote
  // its own record into ONE residual and the last caller's shape set every
  // caller's offsets (tests/micros/mn-row-two-fields-two-shapes.mn). The
  // instance is the chain flattened, each field substituted, the rest a
  // fresh variable of this use or the proven end.
  TRecordOpen(fields, v) => match subst_row_walk(fields, v, mapping) {
    (all, end) => match end {
      RowEndFree(t) => mk_record_open(subst_fields(all, mapping), t),
      RowEndClosed => TRecord(field_canonicalize(subst_fields(all, mapping))),
    },
  },
  TRefined(base, pred) => TRefined(subst_ty(base, mapping), pred),
  TCont(input, answer, disc, world) => TCont(
    subst_ty(input, mapping),
    subst_ty(answer, mapping),
    disc,
    // world is a row: freshen its row-var like TFun's eff (free_in/subst symmetry)
    subst_row(world, mapping)
  ),
  TAlias(name, inner) => TAlias(name, subst_ty(inner, mapping)),
  TReprPin(r, base) => TReprPin(r, subst_ty(base, mapping)),
}

fn subst_list(tys, mapping) = map((t) => subst_ty(t, mapping), tys)

fn subst_params(params, mapping) =
  map((p) => param_with_ty(p, subst_ty(param_ty(p), mapping)), params)

fn subst_fields(fields, mapping) = map({ (name, ty) => (name, subst_ty(ty, mapping)) }, fields)

// A record row's chain read under an instantiation, MAPPING-FIRST at every
// link — subst_ty's own rule for a type variable: a link the scheme
// quantified freshens where it stands (whatever was written past it since
// belongs to the declaration's cells, never to this use), and a link bound
// before the scheme was taken is walked through.
fn subst_row_walk(fields, v, mapping) = {
  let r = graph_chase_handle(v)
  let fresh = find_mapping(mapping, r)
  if fresh >= 0 {
    (fields, RowEndFree(fresh))
  } else {
    match graph_chase(r) {
      GNode(kind, _) => match kind {
        NRecordRowBound(residual, RowClosed) => (fields ++ residual, RowEndClosed),
        NRecordRowBound(residual, RowContinues(next)) => subst_row_walk(fields ++ residual, next, mapping),
        NBound(t) => match t {
          TRecordOpen(more, next) => subst_row_walk(fields ++ more, next, mapping),
          TRecord(more) => (fields ++ more, RowEndClosed),
          _ => (fields, RowEndFree(r)),
        },
        NFree(_) => (fields, RowEndFree(r)),
        NRowFree(_) => (fields, RowEndFree(r)),
        NErrorHole(_) => (fields, RowEndFree(r)),
        NRowBound(_) => (fields, RowEndFree(r)),
      },
    }
  }
}

// Whether an instantiation changes a record row's chain: a quantified link,
// or a substituted field type anywhere along it. A chain with neither is a
// monomorphic fact, and the instance shares it.
fn subst_row_chain_changes(v, mapping) = {
  let r = graph_chase_handle(v)
  if find_mapping(mapping, r) >= 0 {
    true
  } else {
    match graph_chase(r) {
      GNode(kind, _) => match kind {
        NRecordRowBound(residual, RowClosed) => subst_fields_changes(residual, mapping, 0, len(residual)),
        NRecordRowBound(residual, RowContinues(next)) => subst_fields_changes(residual, mapping, 0, len(residual)) || subst_row_chain_changes(next, mapping),
        NBound(t) => match t {
          TRecordOpen(more, next) => subst_fields_changes(more, mapping, 0, len(more)) || subst_row_chain_changes(next, mapping),
          TRecord(more) => subst_fields_changes(more, mapping, 0, len(more)),
          _ => false,
        },
        NFree(_) => false,
        NRowFree(_) => false,
        NErrorHole(_) => false,
        NRowBound(_) => false,
      },
    }
  }
}

// Substitution over the row domain — the open tail var is replaced by its
// fresh instance from the same mapping subst_ty reads. Row handles and type
// handles are disjoint graph nodes, so the shared mapping never collides:
// an open tail only ever matches a row entry, a TVar only a type entry.
// An unchanged row IS its own canonical form (canonical at birth), so the
// sharing face returns it whole.
fn subst_row(eff, mapping) =
  if subst_row_changes(eff, mapping) { subst_row_build(eff, mapping) } else { eff }

// The triple, freshened: parameterized payload TYPES substitute on both
// fields (each op USE a fresh effect instance); each open EDGE resolves
// live and substitutes its quantified ROOT, carrying the concrete
// effects the edge performs (dropping them loses the evidence a caller
// must thread — Carried-Truth). CONDEMNED FORM (the resolved design
// D1): deletes with subst_ty_build when schemes are live cells.
fn subst_row_build(eff, mapping) = match eff {
  EfRow(ns, ab, t) => {
    let ns2 = subst_eff_names(ns, mapping)
    let ab2 = subst_eff_names(ab, mapping)
    match t {
      EtOpen(vs) => match subst_edges_build(edges_masked(vs, ab2), (ns2, [], [], false), mapping) {
        (rp, am, res, saw_all) => row_of_fold(rp, am, res, saw_all),
      },
      _ => ef_make(ns2, ab2, t),
    }
  },
}

// The subst edge walk, structural (off the Iterate vocabulary).
fn subst_edges_build(ref vs: [RowEdge], acc, mapping) = match vs {
  [] => acc,
  [e, ...rest] => subst_edges_build(rest, subst_edge_build_into(acc, e, mapping), mapping),
}

// THE FROZEN READ at the row sort, per EDGE — the mapping decides BEFORE
// any live chase (the TVar arm's law, one sort over): a quantified edge
// was free at the freeze, so a later binding is another caller's
// post-freeze teaching and must freshen — the fresh edge joins the
// residual. Only a MISS chases: pre-freeze-bound chains fold by
// RECURSION through the shared assembly (descending exactly as deep as
// free_in_row's collection — the trio law; the one-level form shared
// two-deep chains, the measured window-8 first-binder race on
// handle_to_smt's cell), and a genuinely unquantified free edge (either
// sort — row_var_is_free's tolerance; the mono self-entry and two-phase
// registration shapes) SHARES into the residual.
fn subst_edge_build_into(acc, e, mapping) = match acc {
  (p, am, res, saw_all) => {
    let v = edge_cell(e)
    let m = if len(edge_mask(e)) == 0 { edge_mask(e) } else { subst_eff_names(edge_mask(e), mapping) }
    let r0 = find_mapping(mapping, graph_chase_handle(v))
    if r0 >= 0 {
      (p, am, tail_set_insert(res, row_edge(r0, m)), saw_all)
    } else {
      match graph_chase(v) {
        GNode(kind, _) => match edge_row_of(kind) {
          Some(inner) => match edge_content_into(p, am, res, saw_all, m, subst_row_build(inner, mapping)) {
            (p2, am2, r2, s2, _) => (p2, am2, r2, s2),
          },
          // An unmapped free edge SHARES: with an unmasked path it is
          // itself, never a copy.
          None => (p, am, tail_set_insert(res, if len(m) == 0 { e } else { row_edge(v, m) }), saw_all),
        },
      }
    }
  },
}

// Substitute parameterized payload types through an effect-name list
// (the row mirror of subst_ty over the row's carried types).
fn subst_eff_names(names, mapping) = map(
  (n) => match n {
    // ONLY EParameterized carries substitutable payload TYPES (Iterate(a) ⇒
    // Iterate(fresh)) — reconstruct it with the fresh args.
    EParameterized(s, args) => EParameterized(
      s,
      map(
        (arg) => match arg {
          EAType(ty) => EAType(subst_ty(ty, mapping)),
          _ => arg,
        },
        args
      )
    ),
    // ENamed and EPure carry NOTHING to substitute — carry the live value,
    // never re-derive it (nothing-drops; carrying the value sidesteps the copy).
    ENamed(_) => n,
    EPure => n,
  },
  names
)

// The mapping probe — a direct walk, no per-leaf filter materialization
// (the filter allocated a hits list at every TVar leaf of every
// instantiation; the walk allocates nothing).
fn find_mapping(mapping, id) = find_mapping_from(mapping, id, 0, len(mapping))

fn find_mapping_from(mapping, id, i, n) = if i >= n {
  -1
} else {
  match list_index(mapping, i) {
    (old, fresh) => if old == id { fresh } else { find_mapping_from(mapping, id, i + 1, n) },
  }
}

// Registration — ADT constructors, effect ops, handlers
//
// A parameter is a node of its own (`NParam`), the cell of the argument its
// position takes, and its pattern binds against it as a let's pattern binds
// against its value. build_param_types resolves a signature's parameters to
// ONE shared identity each, binding the parameter's node to it so the body's
// reads (the binder's TVar) and the generalized scheme share one cell
// (Carried-Truth). It threads ONE qmap across the whole signature, so the
// case rule (a lowercase TName leaf → a shared quantified TVar, through
// quantify_ctor_ty's TFun/TList recursion) makes `init: b` and the `b` inside
// `f: (b,a) -> b` the SAME var — `fold`'s accumulator propagates. A concrete
// annotation (`name: String`, a refinement, a repr pin) binds the node too
// (the Intent Boundary read live), and the annotation's own node beside it,
// where the caret reads it. An unannotated parameter is a bare variable: its
// node IS its fresh var (quantified). Without the shared conversion a
// lowercase TName is a RIGID nominal that mismatches every concrete arg
// (recovered, word-floored) — the pureElem class.
fn param_cell_is_free(ph) = match graph_chase(ph) {
  GNode(NFree(_), _) => true,
  _ => false,
}

fn build_param_types(params) = match build_param_scope(params) {
  (tys, _scope) => tys,
}

// The parameters' types and the signature's scope they leave: every
// variable a lowercase name declared (type variables by name, row variables
// and named rests by their keys), so the return and the clause read the
// same cells.
fn build_param_scope(params) = build_param_types_loop(params, [], 0)

fn build_param_types_loop(params, qmap, i) = if i >= len(params) {
  ([], qmap)
} else {
  let p = list_index(params, i)
  let name = param_binder(p)
  match match param_ann(p) {
    None => (TVar(p), qmap),
    // A written type is quantified into the parameter's cell. The first
    // judgment of a signature binds the cell; a later one — the declaration's
    // own after its pre-registration, a Mycroft round — finds it bound and
    // meets it there.
    Some(a) => match quantify_ctor_ty(ann_ty_of(a), qmap, graph_reason_at(p)) {
      (conv, q) => {
        let at = graph_span_of(a)
        if param_cell_is_free(p) {
          graph_bind(p, conv, Located(at, Declared(name)))
        } else {
          unify_types(TVar(p), conv, at, Declared(name))
        }
        if param_cell_is_free(a) { graph_bind(a, conv, Located(at, Declared(name))) } else { () }
        (conv, q)
      },
    },
  } {
    (chosen, qmap1) => match build_param_types_loop(params, qmap1, i + 1) {
      (rest, qmap2) => (
        [TParam(name, chosen, param_marker(p), param_marker(p), param_dflt(p), guards_nothing())] ++ rest,
        qmap2
      ),
    },
  }
}

// A parameter's pattern binds against the parameter's node, the cell of the
// argument its position takes, as a let's pattern binds against its value. A
// bare name is declared at its own node — so a reference's edge reaches the
// name in the head, and `binder_read_by` answers the parameter's cell — under
// the parameter's own reason and its authored ownership marker; an as-pattern
// binds the whole the same way; any other pattern takes the argument apart,
// each part declared at its own node (`infer_pat`). The head binds in two
// passes, the order the lowering binds in: every parameter's whole first, so
// of two parameters of one name the later is read, then the parts each
// destructuring pattern takes apart where the body begins, which hide a
// whole of their name.
fn declare_param_binders(params, owner: String) = {
  binders_once(flat_map({ p => pat_binders(param_pat(p)) }, params))
  params |> enumerate |> each(declare_param_whole(owner, ??))
  each(declare_param_parts, params)
}

// A head, across its parameters and their patterns, and a pattern bind each
// name once: of two binders of one name a use could reach either, and a
// parameter list holds one field per name. The second is refused, naming
// the first.
fn binders_once(binders) = binders |> enumerate |> each(binder_once(binders, ??))

fn binder_once(binders, ib) = match ib {
  (i, (name, node)) => match find({ (m, _) => m == name }, take(i, binders)) {
    Some((_, first)) => report(EDuplicateBinder(name, graph_span_of(first), graph_span_of(node))),
    None => (),
  },
}

// A parameter's whole is declared under the parameter's own reason, at the
// name: its binder is the cell of the argument, and the Why at a use and at
// the binder both name the parameter.
fn declare_param_whole(owner: String, ip) = match ip {
  (i, p) => {
    let pat = param_pat(p)
    match pat_of(pat) {
      PVar(name) | PAs(name, _) => {
        let why = Located(graph_span_of(pat), FnParam(owner, i, Inferred("param of '{owner}'")))
        graph_bind(pat, TVar(p), why)
        env_extend(name, Frozen([], TVar(p)), why, ParamScheme(param_marker(p)), pat)
      },
      PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) => (),
    }
  },
}

fn declare_param_parts(p) = {
  let pat = param_pat(p)
  match pat_of(pat) {
    PVar(_) => (),
    PAs(_, inner) => infer_pat(inner, p, graph_span_of(p)),
    PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) => infer_pat(pat, p, graph_span_of(p)),
  }
}

// A parameter written as a destructuring pattern asserts the argument's
// shape, as a match of one arm asserts its scrutinee's: the
// value a pattern leaves uncovered is the claim, located at the parameter —
// proven along the argument's edges, refuted there, or open with the frame's
// row carrying the `Trap` a mismatch is. Raised inside the frame, after the
// parameter's fact is noted, so the walk reads the precondition and the
// charge lands in the declaration's row.
fn claim_param_shapes(params) = params |> each({
  p => {
    let pat = param_pat(p)
    match uncovered([[pat_of(pat)]], 1) {
      Some(witness) => claim_shape(p, p, join(", ", witness), (pat, p)),
      None => (),
    }
  },
})

// ─── A declared parameter's precondition and what it guards (P0) ────────
//
// Every parameter of a DECLARED function carries a row cell — what its
// precondition guards, paid by a call whose argument's claim is not proven
// there — born open where the signature is first registered and written
// once, at the judgment's exit, with what the judgment charged to the
// parameter's fact: `Trap` for a division the precondition proved total,
// a callee's own guard for a precondition carried into that callee's, and
// nothing at all when nothing was charged. A caller judged first holds the
// open cell by its edge and reads the exit's write; a cell that grew while
// callers read it would have handed each a stale copy.
fn guard_cells(params, owner: String) = {
  let why = Inferred("what a precondition of '{owner}' guards")
  params |> map({ _ => graph_fresh_row(why) })
}

fn with_guards(tparams, guards) =
  tparams |> enumerate |> map({ (i, p) => param_with_row(p, mk_ef_open([], list_index(guards, i))) })

// The judgment's guard cells are the registration's — read off the
// signature the declaration's handle already carries, so a forward or
// recursive call judged against it charged the very cells filled below. A
// declaration nobody registered (a nested fn) mints its own.
fn judged_guards(handle, params, owner: String) = match graph_chase(handle) {
  GNode(NBound(TFun(pps, _, _)), _) => if len(pps) == len(params) {
    pps |> map(guard_cell_of(owner, ??))
  } else {
    guard_cells(params, owner)
  },
  _ => guard_cells(params, owner),
}

fn guard_cell_of(owner: String, p) = match param_row(p) {
  EfRow([], [], EtOpen([e])) => edge_cell(e),
  _ => graph_fresh_row(Inferred("what a precondition of '{owner}' guards")),
}

// Each parameter DECLARED: its precondition noted under its handle, where
// the value walk (verify.mn) reads it through a reference's link — the
// cell itself holds the shape alone — and its row the guard cell's.
fn declare_params(params, resolved, guards) = resolved |> enumerate |> map({
  (i, tp) => {
    let g = list_index(guards, i)
    let p = list_index(params, i)
    graph_binder_note(
      p,
      ParamFact({guard: g, owes: guards_nothing(), pre: stated_pre(p, param_ty(tp))})
    )
    param_with_row(tp, mk_ef_open([], g))
  },
})

// What the developer wrote: a refinement is a stated precondition, a plain
// type states none (and learns none), and no annotation leaves the
// parameter to learn one from the edges it is handed through.
fn stated_pre(p, resolved) = if param_annotated(p) {
  if ty_carries_refinement(resolved) { Stated(resolved) } else { Unrefined }
} else {
  Unstated
}

// At the exit a parameter publishes what it learned — its callers owe the
// precondition from here on — and its guard cell is written with what the
// judgment charged, through the judged finalize: a gate a caller pushed onto
// the open cell is checked here, where the charge it forbids arrives.
fn published_params(params, handles, owner: String, span: ValidSpan) = {
  let why = Located(span, Inferred("what a precondition of '{owner}' guards"))
  params |> enumerate |> map({
    (i, p) => match graph_binder_of(list_index(handles, i)) {
      Some(fact) => match fact {
        ParamFact(f) => {
          graph_finalize_row(f.guard, f.owes, why)
          match f.pre {
            Learned(c) => param_with_ty(p, c),
            Stated(_) => p,
            Unstated => p,
            Unrefined => p,
          }
        },
        PartFact(_) => p,
        StateFact(_) => p,
      },
      None => p,
    },
  })
}

// Value-proof R2 at the return: an authored `->` is claimed of the judged
// body node, the let annotation's twin — `fn choose() -> Positive = 1`
// proves 0 < 1 on the literal, a non-constant body stays honest V_Pending,
// and a function crossing into a stated function type pays what it demands
// beyond what the type provides. Read after the body, so the decide reads
// judged cells, with the IH already visible through the slot pinned before
// the body (the old post-body rebind landed after this decide and the decl's
// own obligation read the join's bare base; probe-measured 2026-08-12).
fn claim_authored_return(ret_ann, body_node, name: String, span: ValidSpan) = match graph_node_body(ret_ann) {
  NTypeAnn(ann_ty) => match quantify_ctor_ty(ann_ty, [], Located(span, Declared(name))) {
    (resolved_ann, _) => {
      // A label the return states is the declaration's statement — a source,
      // or an endorsement where it is negated — and never a claim of the body.
      claim_refinement(ty_without_labels(resolved_ann), body_node, graph_span_of(ret_ann))
      ()
    },
  },
  _ => (),
}

// The return the exit publishes: an authored `->` stands as written; with
// none, the contract the body proves of every tail (verify.mn
// `proven_return`), or the return cell itself when it proves none.
fn published_ret(pinned_ret, body_h, ret_h) = match pinned_ret {
  TVar(_) => match proven_return(body_h, ret_h) {
    Some(c) => c,
    None => published_fn_ret(pinned_ret, body_h),
  },
  _ => pinned_ret,
}

// A declaration or a lambda returning functions publishes, at every position
// of its return that holds one, the meet of every function the position can
// hold: its callers apply whichever arrives, so they owe every precondition
// and are promised only what every one guarantees. The class kept the first
// branch's contract — `pick(false)(0)` over `if c { inv2 } else { inv }`
// divided by zero under `!Trap` (higher-order face 4), and until S6 so did a
// function inside the structure a call returns: `pick(false).f(0)` over `if c
// { {f: succ} } else { {f: inv} }`, a tuple's, an `Option`'s and a list's,
// through a relay, a parameter, a module let and a lambda (pin
// 852184886f52a848). Every other part of the return stays as the class states
// it.
fn published_fn_ret(pinned_ret, body_h) =
  value_fn_positions(body_h) |> fold(pinned_ret, publish_position(body_h, ??, ??))

fn publish_position(body_h, ret, pos) = match pos {
  (_, path, _) => {
    let sources = sources_at(body_h, path)
    if len(sources) < 2 {
      ret
    } else {
      match sources |> fold(None, meet_source) {
        Some(t) => fn_at_path(ret, path, t, id),
        None => ret,
      }
    }
  },
}

fn meet_source(acc, src) = match source_fn_type(src) {
  Some(t) => match acc {
    Some(a) => Some(fn_meet(a, t)),
    None => Some(t),
  },
  None => acc,
}

// The function contract a source states: a function in sight its own type, a
// part out of sight what its whole's class states at the part — a
// declaration's publication, a parameter's learned contract — and nothing for
// a learning parameter's, which the return hands on (`hand_on_value`).
fn source_fn_type(src) = match source_learning(src) {
  Some(_) => None,
  None => match src {
    SrcLeaf(leaf) => leaf_fn_type(leaf),
    SrcPart(h, path) => match contract_at(chase_deep(TVar(h)), path) {
      Some(t) => fn_type_of(t),
      None => None,
    },
    SrcContract(c, _) => fn_type_of(c),
    SrcUnknown => None,
  },
}

fn fn_type_of(t) = match t {
  TFun(ps, r, row) => Some(TFun(ps, r, row)),
  TAlias(_, inner) => fn_type_of(inner),
  TRefined(base, _) => fn_type_of(base),
  _ => None,
}

// A call through this declaration's own guard while its body was judged —
// self-recursion, or a lambda of the body calling back — owes what the
// body charged that guard, which is known now, before the frame's row is
// written: the frame's own payment joins its accumulation, a nested
// frame's (already written) takes a join, and a guard of a cycle member
// still open beneath it passes the payer on to that guard.
fn settle_own_guards(handles, row_handle) = handles |> each({
  h => match graph_binder_of(h) {
    Some(fact) => match fact {
      ParamFact(f) => late_charge(f.owes, graph_late_payers(f.guard), Some(row_handle)),
      PartFact(_) => (),
      StateFact(_) => (),
    },
    None => (),
  },
})

// `judging` is the frame still being judged, whose row is not yet written:
// its payment joins the accumulation; every other payer's cell is written.
fn late_charge(owes, payers, judging) = if len(payers) == 0 {
  ()
} else {
  match resolve_row(owes) {
    EfRow(p, _, t) => payers |> each({
      payer => {
        if len(p) == 0 {
          ()
        } else if judging == Some(payer) {
          inf_add_row(mk_ef_closed(p))
        } else {
          graph_bind_row(
            payer,
            mk_ef_closed(p),
            Inferred("a call through a guard its declaration had not written")
          )
        }
        match t {
          EtOpen(vs) => vs |> each({ e => graph_owe_late(edge_cell(e), payer) }),
          _ => (),
        }
      },
    }),
  }
}

// A cycle's members are judged one at a time, so a member may call one
// judged after it through a guard that member's exit had not written. Every
// such guard is written now: what it owes reaches its payers and — since
// every member of a cycle reaches every other — every member's row, each
// checked again against its own declaration.
fn settle_unit_guards(hs) = {
  let owed = hs |> map(member_owed_late) |> fold(guards_nothing(), row_join)
  match owed {
    EfRow(p, _, _) => if len(p) == 0 {
      ()
    } else {
      hs |> each(member_takes(??, mk_ef_closed(p), "a cycle's late precondition guard"))
    },
  }
}

// What a member's guards owe the callers that reached them open, charged
// to those callers on the way.
fn member_owed_late(h) = match graph_chase(h) {
  GNode(NBound(TFun(pps, _, _)), _) => pps |> map(param_owed_late) |> fold(guards_nothing(), row_join),
  _ => guards_nothing(),
}

// What one parameter's guard owes, charged on the way to the callers that
// reached it open.
fn param_owed_late(p) = match param_row(p) {
  EfRow([], [], EtOpen([e])) => {
    let payers = graph_late_payers(edge_cell(e))
    if len(payers) == 0 {
      guards_nothing()
    } else {
      let owes = resolve_row(mk_ef_open([], edge_cell(e)))
      late_charge(owes, payers, None)
      owes
    }
  },
  _ => guards_nothing(),
}

// A member whose row grows past its exit takes the growth into its row and
// is judged again against its declaration; a row that already carries every
// name grows nothing, and was judged when those names entered it.
fn member_takes(handle, owed, why: String) = match graph_node_body(handle) {
  NStmt(FnStmt(name, _, _, effs, _)) => match graph_chase(handle) {
    GNode(NBound(TFun(_, _, frow)), _) => match frow {
      EfRow(_, _, EtOpen([e])) => if row_holds_names(resolve_row(mk_ef_open([], edge_cell(e))), owed) {
        ()
      } else {
        let span = graph_span_of(handle)
        graph_bind_row(edge_cell(e), owed, Located(span, Inferred(why)))
        declared_holds(handle, name, effs, edge_cell(e), span)
      },
      _ => (),
    },
    _ => (),
  },
  _ => (),
}

fn row_holds_names(row, owed) = match row {
  EfRow(have, _, _) => match owed {
    EfRow(need, _, _) => all({ n => any({ h => eff_name_str(h) == eff_name_str(n) }, have) }, need),
  },
}

// A member's declaration judged again after its row grew past its exit; the
// refusal carries the chain to where the late effect entered, as the gate
// at the exit does (`mismatch_reason`).
fn declared_holds(decl, name: String, effs, row_handle, span: ValidSpan) = if len(effs) == 0 {
  ()
} else {
  let declared_row = build_declared_row(resolve_declared_instances(effs))
  let body_row = resolve_row(mk_ef_open([], row_handle))
  if row_subsumes(body_row, declared_row) {
    ()
  } else if has_pure_declared(effs) {
    report(EPurityViolated(body_row, span))
  } else {
    report(EEffectMismatch(
      declared_row,
      body_row,
      mismatch_reason(name, declared_row, body_row, Some(decl), span),
      span
    ))
  }
}

fn guards_nothing_row(row) = match row {
  EfRow([], [], EtClosed) => true,
  _ => false,
}

// A guarded precondition's claim at a call: inferred onto a parameter
// handed straight through, raised and decided, and the row it guards paid
// at the call unless the claim held STRICTLY — on constants, lengths and
// preconditions, which the guard then travels to (`carry_guard`).
fn discharge_arg(p, ah, span: ValidSpan, call_h) = {
  let contract = param_ty(p)
  learn_precondition(ah, contract)
  let verdict = claim_refinement(contract, ah, span)
  pay_guard(param_row(p), contract, verdict, ah, call_h)
}

fn pay_guard(row, contract, verdict, ah, call_h) = if guard_owes_nothing(row) {
  ()
} else if claim_held(verdict) && ty_carries_refinement(contract) {
  let leaves = claim_leaves(contract, ah)
  if leaves_unproven(leaves) {
    pay_row(row, call_h)
  } else {
    leaves_params(leaves) |> each(carry_guard(row, ??))
  }
} else {
  pay_row(row, call_h)
}

// What a held claim stood on: the value's own leaves, and under a structured
// contract every claimed part's — a part built in sight at each node it can
// be, a part out of sight off the whole's leaves at the part. A structure
// literal's own leaf is unknown, and reading it alone let a claim on its
// parts pay no guard and carry none.
fn claim_leaves(contract, h) =
  value_leaves(h, NoSelf) ++ (value_parts(contract) |> flat_map(part_claim_leaves(h, ??)))

fn part_claim_leaves(h, part) = match part {
  (step, pt) => match part_read(h, step, claim_leaves_read(pt, ??)) {
    Some(leaves) => leaves,
    None => path_leaves(h, [step]),
  },
}

fn claim_leaves_read(pt, n) = Some(claim_leaves(pt, n))

// A guard's row as a call pays it: what its cell already holds is charged
// at the call as closed names, and every cell still open — a declaration
// of this judgment unit that has not exited: the caller itself, or a later
// member of its cycle — takes the caller's row cell as a late payer
// (`settle_own_guards`, `settle_unit_guards`). A frame row never holds a
// guard cell: a free cell in an effect row is a row variable, the
// unifier and the quantifier read it as one, and a guard bound by a
// unification would hand its payers somebody else's effects.
fn pay_row(row, at) = match resolve_row(row) {
  EfRow(p, _, t) => {
    if len(p) > 0 { inf_add_row_at(at, mk_ef_closed(p)) } else { () }
    match t {
      EtOpen(vs) => match inf_current_world() {
        EfRow(_, _, EtOpen([w])) => vs |> each({ e => graph_owe_late(edge_cell(e), edge_cell(w)) }),
        _ => (),
      },
      _ => (),
    }
  },
}

// A guard that owes nothing: a lambda's (born guarding nothing) or a
// declared parameter's whose judgment exited having charged nothing — the
// common case, since a callee is judged before its callers. An open cell
// (a forward or recursive callee still being judged) owes what its exit
// will write, so the call charges its edge and reads the write. Paying a
// closed empty guard at every argument of every call cost the wheel's
// judgment 128 MB of row joins and notes (measured 2026-10-01).
fn guard_owes_nothing(row) = match row {
  EfRow([], [], EtOpen([e])) => match graph_chase(edge_cell(e)) {
    GNode(NRowBound(r), _) => guards_nothing_row(r),
    _ => false,
  },
  _ => guards_nothing_row(row),
}

fn claim_held(verdict) = match verdict {
  Some(held) => held,
  None => false,
}

// A row charged to a parameter's precondition — `Trap` for a division it
// proved total, a callee's guard for a claim it discharged — joins what the
// parameter's fact owes; the exit writes the sum into the guard cell.
fn carry_guard(row, param_h) = match graph_binder_of(param_h) {
  Some(fact) => match fact {
    ParamFact(f) => graph_binder_note(param_h, ParamFact({guard: f.guard, owes: row_join(f.owes, row), pre: f.pre})),
    PartFact(_) => (),
    StateFact(_) => (),
  },
  None => (),
}

// An UNANNOTATED parameter handed straight to a refined one LEARNS that
// precondition: its own callers owe it from then on, and the claim here is
// discharged by it. Only a pure flow learns — the parameter itself, or a
// let of it — since a join or a computation is not the parameter's value.
// A provision is what a position is handed, never a demand on it. A label is
// what can influence a value, which a computation carries and a learned
// precondition would not, so a contract naming one is owed where the settle
// finds its demands (verify.mn's `flow_settle`), never learned here.
fn learn_precondition(ah, contract) = if ty_carries_refinement(contract) && !is_provision(contract) && !ty_names_a_label(contract) {
  match flow_param(ah) {
    Some(b) => match graph_binder_of(b) {
      Some(fact) => match fact {
        ParamFact(f) => match f.pre {
          Unstated => graph_binder_note(b, ParamFact({guard: f.guard, owes: f.owes, pre: Learned(contract)})),
          Stated(_) => (),
          Learned(_) => (),
          Unrefined => (),
        },
        PartFact(_) => (),
        StateFact(_) => (),
      },
      None => (),
    },
    None => learn_result_demand(ah, contract),
  }
} else {
  ()
}

// A FUNCTION-typed parameter learns its contract from how the body applies
// it, as a value parameter learns its precondition from where the body
// hands it: what every application provides at each position, and what a
// refined position demands of its result. It publishes with the parameter
// (`published_params`), and a caller's function crossing judges the
// function it hands in against both (`fun_refinement_crossing`) — `fn
// drive(f, c: Hz) = f(c)` publishes its function applied at its own
// parameter, and `fn run(f) = alpha(f())` publishes `f: () -> Hz`. Both had
// ridden the unification class, and three proof-exactness fixtures went red
// the day P0 stripped refinements from cells.
//
// A function at a PART of a parameter learns the same way, where the part
// is applied — `fs[0](k)` teaches the list's elements — and the parameter's
// contract becomes a structure with the learned function at that path, the
// parts beside it scrubbed of whatever the class merged into them (H4·D: an
// element applied inside `fn first(fs) = fs[0](0)` was judged against
// nothing, and `first([inv])` under `!Trap` checked clean and divided by
// zero on boot 13e8484a and pin e23392f6).
//
// The function a learning parameter holds at a path: a part its learned
// contract holds as a type of its own is what was learned there; a part
// still a cell — the whole parameter, while nothing is learned — is the
// class's, read SCRUBBED (`class_scrub`): every position no application
// has reached yet, and no demand on the result, since a class merges
// whatever a unification met and its contract is nobody's.
fn learnable_at(pre, b, path) = match pre {
  Unstated => fn_at(TVar(b), path),
  Learned(c) => fn_at(c, path),
  Stated(_) => None,
  Unrefined => None,
}

fn fn_at(t, path) = match t {
  TVar(_) => match chase_ty(t) {
    TVar(_) => None,
    u => fn_at(class_scrub(u), path),
  },
  TAlias(_, inner) => fn_at(inner, path),
  _ => match path {
    [] => match t {
      TFun(ps, ret, row) => Some((ps, ret, row)),
      _ => None,
    },
    [step, ...rest] => match contract_part(t, step) {
      Some(part) => fn_at(part, rest),
      None => None,
    },
  },
}

// A type read through its cell: a variable bound to a type is that type
// (the chase follows variable chains), a free one itself.
fn chase_ty(t) = match t {
  TVar(h) => match graph_chase(h) {
    GNode(NBound(u), _) => u,
    _ => t,
  },
  _ => t,
}

// A class's structure as nothing learned: every function position handed
// nothing yet, no guard on its row, and no demand on a result.
fn class_scrub(t) = match t {
  TFun(ps, ret, row) => TFun(ps |> map(unprovided_param), class_scrub(ret), row),
  TList(e) => TList(class_scrub(e)),
  TTuple(es) => TTuple(es |> map(class_scrub)),
  TRecord(fs) => TRecord(fs |> map(scrub_field)),
  TRecordOpen(fs, v) => TRecordOpen(fs |> map(scrub_field), v),
  TName(n, args) => TName(n, args |> map(class_scrub)),
  TAlias(_, _) => match shape_of(t) {
    TAlias(n, inner) => TAlias(n, class_scrub(inner)),
    s => class_scrub(s),
  },
  _ => shape_of(t),
}

fn scrub_field(f) = match f {
  (n, t) => (n, class_scrub(t)),
}

fn unprovided_param(p) =
  param_with_row(param_with_ty(p, provided_ty(param_ty(p), ProvidedNone)), guards_nothing())

// The parameter's contract with the function at a path replaced; the parts
// beside it are the class's, scrubbed where the walk enters the class.
fn with_fn_at(t, path, part) = fn_at_path(t, path, part, class_scrub)

// A type with the function at a path replaced, the class entered along the
// path read through `read`: scrubbed for what a parameter learns, as it
// stands for what a return publishes — whose other positions keep the
// contracts the class states for them.
fn fn_at_path(t, path, part, read) = match path {
  [] => part,
  [step, ...rest] => match t {
    TVar(_) => match chase_ty(t) {
      TVar(_) => t,
      u => fn_at_path(read(u), path, part, read),
    },
    TList(e) => match step {
      PartElem => TList(fn_at_path(e, rest, part, read)),
      _ => t,
    },
    TTuple(es) => match step {
      PartIndex(i) => TTuple(es |> enumerate |> map(fn_in_slot(i, rest, part, read, ??))),
      _ => t,
    },
    TRecord(fs) => TRecord(fs |> map(fn_in_field(step, rest, part, read, ??))),
    TRecordOpen(fs, v) => TRecordOpen(fs |> map(fn_in_field(step, rest, part, read, ??)), v),
    TName(n, args) => match step {
      PartTypeArg(k) => TName(n, args |> enumerate |> map(fn_in_slot(k, rest, part, read, ??))),
      _ => t,
    },
    TAlias(n, inner) => TAlias(n, fn_at_path(inner, path, part, read)),
    TRefined(base, pred) => TRefined(fn_at_path(base, path, part, read), pred),
    _ => t,
  },
}

fn fn_in_slot(i, rest, part, read, slot) = match slot {
  (j, e) => if j == i { fn_at_path(e, rest, part, read) } else { e },
}

fn fn_in_field(step, rest, part, read, field) = match field {
  (n, ft) => match step {
    PartField(m) => if n == m { (n, fn_at_path(ft, rest, part, read)) } else { (n, ft) },
    _ => (n, ft),
  },
}

fn note_learned(b, f, path, part) = {
  let base = match f.pre {
    Learned(c) => c,
    _ => TVar(b),
  }
  graph_binder_note(
    b,
    ParamFact({guard: f.guard, owes: f.owes, pre: Learned(with_fn_at(base, path, part))})
  )
}

// One learning at a path: `learn` reads the function the parameter holds
// there — its positions, its result and its row — and answers what it
// becomes, or nothing to learn.
fn learn_fn_at(b, path, learn) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => match learnable_at(f.pre, b, path) {
      Some(found) => match learn(found) {
        Some(part) => note_learned(b, f, path, part),
        None => (),
      },
      None => (),
    },
    PartFact(_) => (),
    StateFact(_) => (),
  },
  None => (),
}

// An APPLICATION reaching the function at a path: each position joins what
// this application hands it, and a demand the application makes of the
// result becomes the function's own unless one is already learned — a
// second, other demand stays the body's own claim, open over the first.
fn learn_application(b, path, provisions, demand) =
  learn_fn_at(b, path, applied_with(provisions, demand, ??))

fn applied_with(provisions, demand, found) = match found {
  (ps, ret, row) => if len(ps) == len(provisions) {
    Some(TFun(zip(ps, provisions) |> map(provided_with), learned_result(ret, demand), row))
  } else {
    None
  },
}

fn provided_with(pair) = match pair {
  (p, provision) => param_with_ty(p, provision_join(param_ty(p), provision_ty(param_ty(p), provision))),
}

fn learned_result(ret, demand) = if ty_carries_contract(ret) {
  ret
} else {
  match demand {
    Some(d) => if ty_carries_contract(d) { d } else { ret },
    None => ret,
  }
}

// What one application hands each position: an EDGE to the node it hands —
// the value itself, read live wherever a function crosses into this
// contract — joined with what earlier applications handed it. It was a
// contract copied off the node's leaves, which a constant never has, so
// `fn apply5(f) = f(5)` published its function applied at nothing known,
// and `apply5(inv)` under `!Trap` paid the guard on the precondition of the
// function it handed in, for a division by 5.
fn learn_provision(callee_h, arg_handles) = match learning_path(callee_h) {
  Some(at) => applied_by_choice(at, arg_handles),
  None => (),
}

// A learning parameter applied: it learns what each position is handed,
// and what it is handed goes where this body cannot see — its caller chose
// the function — so a learning function among the arguments is handed on
// (`hand_on_value`).
fn applied_by_choice(at, arg_handles) = {
  learn_at(at, arg_handles)
  arg_handles |> each(hand_on_value)
}

fn learn_at(at, arg_handles) = match at {
  (b, path) => learn_application(b, path, arg_handles |> map({ ah => Handed(ProvidedAt([ah])) }), None),
}

// What an application hands one position: values it hands — by their
// nodes, or beyond what can be named — or a contract it states for every
// value it hands.
type Provision = Handed(Provided) | ByContract(Ty)

fn provision_ty(t, provision) = match provision {
  Handed(provided) => provided_ty(t, provided),
  ByContract(c) => c,
}

fn handed_unknown() = Handed(ProvidedBeyond([]))

// Two provisions of one position, joined: the nodes of both, and beyond
// them whatever either cannot name.
fn provided_union(a, b) = match a {
  ProvidedNone => b,
  ProvidedAt(xs) => match b {
    ProvidedNone => a,
    ProvidedAt(ys) => ProvidedAt(nodes_union(xs, ys)),
    ProvidedBeyond(ys) => ProvidedBeyond(nodes_union(xs, ys)),
  },
  ProvidedBeyond(xs) => match b {
    ProvidedNone => a,
    ProvidedAt(ys) => ProvidedBeyond(nodes_union(xs, ys)),
    ProvidedBeyond(ys) => ProvidedBeyond(nodes_union(xs, ys)),
  },
}

fn nodes_union(xs, ys) = xs ++ filter({ y => !any({ x => x == y }, xs) }, ys)

// A position's type under a provision: its shape, scrubbed, refined by
// what it is handed.
fn provided_ty(t, provided) = TRefined(provision_base(t), PProvides(provided))

fn provision_base(t) = match t {
  TRefined(base, PProvides(_)) => base,
  _ => class_scrub(t),
}

// What a position's type says it is handed; None for a contract — a
// refinement or a function type the provider states.
fn provided_of(t) = match t {
  TRefined(_, PProvides(provided)) => Some(provided),
  _ => None,
}

fn is_provision(t) = match provided_of(t) {
  Some(_) => true,
  None => false,
}

// The provision a receiver's position states, as an application handing on
// to it provides it: an edge or a contract carries over, and a position
// stating nothing is handed values nothing here can name.
fn provision_of_ty(t) = match provided_of(t) {
  Some(provided) => Handed(provided),
  None => if ty_carries_contract(t) { ByContract(t) } else { handed_unknown() },
}

// Provisions join: nothing handed is the identity, the nodes every
// application handed are their union, a contract joins only the same
// contract, and anything else keeps the nodes it can name beside values it
// cannot.
fn provision_join(prior, next) = match provided_of(prior) {
  Some(p) => match p {
    ProvidedNone => next,
    _ => match provided_of(next) {
      Some(n) => provided_ty(prior, provided_union(p, n)),
      None => provided_ty(prior, provided_union(p, ProvidedBeyond([]))),
    },
  },
  None => match provided_of(next) {
    Some(n) => match n {
      ProvidedNone => prior,
      _ => provided_ty(prior, provided_union(n, ProvidedBeyond([]))),
    },
    None => if same_contract(prior, next) { prior } else { provided_ty(prior, ProvidedBeyond([])) },
  },
}

// A type states something a crossing is judged against: a refinement, a
// provision that has reached it, or a function contract with one inside.
fn ty_carries_contract(t) = match t {
  TFun(ps, ret, _) => any(param_carries_contract, ps) || ty_carries_contract(ret),
  TList(e) => ty_carries_contract(e),
  TTuple(es) => any(ty_carries_contract, es),
  TRecord(fs) => any(field_carries_contract, fs),
  TRecordOpen(fs, _) => any(field_carries_contract, fs),
  TName(_, args) => any(ty_carries_contract, args),
  TRefined(_, PProvides(ProvidedNone)) => false,
  TAlias(_, inner) => ty_carries_contract(inner) || ty_carries_refinement(t),
  _ => ty_carries_refinement(t),
}

fn param_carries_contract(p) = ty_carries_contract(param_ty(p)) || !guard_owes_nothing(param_row(p))

fn field_carries_contract(f) = match f {
  (_, t) => ty_carries_contract(t),
}

// Two contracts the same refinement: named by one alias.
fn same_contract(a, b) = match contract_alias(a) {
  Some(n) => match contract_alias(b) {
    Some(m) => n == m,
    None => false,
  },
  None => false,
}

// A refined position demands of the result of applying a function-typed
// parameter: the parameter learns the demand as its return contract, and
// the claim here stands on it (verify.mn `call_leaves`). A second, other
// demand on the same result is not met into the first — it stays the
// body's own claim, open over the first.
fn learn_result_demand(ah, contract) = match applied_path(ah) {
  Some(at) => match at {
    (b, path) => learn_fn_at(b, path, demanded_with(contract, ??)),
  },
  None => (),
}

fn demanded_with(contract, found) = match found {
  (ps, ret, row) => if ty_carries_contract(ret) { None } else { Some(TFun(ps, contract, row)) },
}

// The learning parameter — or the function at a part of one — a value is
// the result of APPLYING: a call or a pipe stage whose callee it is,
// through references and lets.
fn applied_path(h) = match graph_node_body(h) {
  NExpr(CallExpr(callee, _)) => learning_path(callee),
  NExpr(PipeExpr(PForward, _, stage)) => learning_path(stage),
  NExpr(BlockExpr(_, f)) => applied_path(f),
  _ => None,
}

// ─── What applying a function value owes (H4) ───────────────────────────
//
// A function-typed parameter that LEARNS its contract — no annotation, or
// one it has learned — is a function this body cannot see: the one its
// caller hands in is judged at that caller's crossing, against what this
// body provides it. Its own type demands nothing here, and reading it as a
// demand refused `g(30000.0)` in `fn outer(g) = drive(g, 440.0) +
// g(30000.0)` because the callee PROVIDES an Hz value to its callback (higher-order
// face 5). An authored function type is the body's own promise, and binds.
fn learning_param(h) = match learning_path(h) {
  Some(_) => true,
  None => false,
}

// The learning parameter a value is — itself, or a part of it (verify.mn
// `flow_param_path`) — with the path to the part.
fn learning_path(h) = match flow_param_path(h) {
  Some(at) => match at {
    (b, path) => if learning_binder(b) { Some((b, path)) } else { None },
  },
  None => None,
}

fn learning_binder(b) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(f) => match f.pre {
      Unstated => true,
      Learned(_) => true,
      Stated(_) => false,
      Unrefined => false,
    },
    PartFact(_) => false,
    StateFact(_) => false,
  },
  None => false,
}

// What every function a value can be demands, met: per position the
// preconditions conjoined and the guards joined — an application owes each
// — and the result the join of what each guarantees. None where no leaf is
// a function this body can read.
fn fn_contract(leaves) = leaves |> fold(None, meet_leaf)

fn meet_leaf(acc, leaf) = match leaf_fn_type(leaf) {
  Some(t) => match acc {
    Some(a) => Some(fn_meet(a, t)),
    None => Some(t),
  },
  None => acc,
}

fn leaf_fn_type(leaf) = if learning_param(leaf) {
  None
} else {
  match graph_chase(leaf) {
    GNode(NBound(TFun(ps, ret, row)), _) => Some(TFun(ps, ret, row)),
    _ => None,
  }
}

fn fn_meet(a, b) = match a {
  TFun(pa, ra, row) => match b {
    TFun(pb, rb, _) => if len(pa) == len(pb) { TFun(zip(pa, pb) |> map(param_meet), ret_join(ra, rb), row) } else { a },
    _ => a,
  },
  _ => a,
}

fn param_meet(pair) = match pair {
  (p, q) => param_with_row(
    param_with_ty(p, contract_meet(param_ty(p), param_ty(q))),
    row_join(param_row(p), param_row(q))
  ),
}

// Two preconditions on one position, both owed: a side that demands nothing
// owes nothing, one refinement twice is owed once, and two different ones
// are conjoined over the shape they share.
fn contract_meet(a, b) = match demand_refinement(b) {
  None => a,
  Some(db) => match demand_refinement(a) {
    None => b,
    Some(da) => if same_contract(a, b) {
      a
    } else {
      match da {
        (_, pa) => match db {
          (_, pb) => TRefined(shape_of(a), PAnd(pa, pb)),
        },
      }
    },
  },
}

// Two guarantees on one result, either delivered: kept only where both are
// the same refinement.
fn ret_join(a, b) = if same_contract(a, b) { a } else { shape_of(a) }

// A learning parameter handed on to a function-typed position learns that
// position's contract: what the receiver hands each position joins what it
// has been handed, and what the receiver demands of its result becomes its
// own — the function its caller hands in meets both at that caller's
// crossing. The function at a part of a parameter learns the same way.
fn transport_at(b, path, eps, eret) =
  learn_application(b, path, eps |> map({ ep => provision_of_ty(param_ty(ep)) }), Some(eret))

// The declared parameter a value IS, through references and lets — the
// whole parameter, never a part of it.
fn flow_param(h) = match flow_param_path(h) {
  Some(at) => match at {
    (b, path) => if len(path) == 0 { Some(b) } else { None },
  },
  None => None,
}

// Apply a let-binding's `: T` annotation as a refinement constraint on the
// value node. The value's node HANDLE is live here (unlike the generic TRefined
// arm of unify_types, which carries only the predicate + span), so subst_self
// binds `self` to the value and Verify decides the predicate on the literal —
// `let bad: Sample = 1.5` rejects, `let ok: Sample = 0.5` compiles; a
// non-constant value stays V_Pending (node_const → None). Resolve the annotation
// through its alias edge (quantify_ctor_ty — the same resolution build_param_types
// uses), then discharge the refinement. The annotation's node is a cell holding
// the type it declares.
fn apply_let_annotation(ann, ann_ty, value_handle, span: ValidSpan) = match quantify_ctor_ty(ann_ty, [], Located(span, Inferred("let annotation"))) {
  (resolved, _q) => {
    graph_bind(ann, resolved, Located(graph_span_of(ann), Inferred("let annotation")))
    // The refinement is a CLAIM about the value, decided where the value
    // is made; a reader of the binder reads the value itself (the value
    // walk follows the reference's link to it), so an open claim stays
    // debt and never becomes a fact. It used to be rebound onto the value's
    // class whatever its verdict — `let k: Positive = e - 1` read Positive
    // at `100 / k` while the ledger still owed `0 < e - 1` (P0).
    claim_refinement(resolved, value_handle, span)
    // The base unify: the annotation is a real CONSTRAINT, not decoration —
    // `let x: Int = "hi"` refused here (measured passing clean before this
    // edge existed).
    unify_types(TVar(value_handle), resolved, span, Inferred("let annotation pins the value"))
  },
}

// Peel the resolved annotation to its refinement. A transparent alias recurses
// to its inner type; a TRefined discharges its (self-substituted) predicate
// against the value node; any other resolved type carries no refinement
// obligation here (base-type unification lives at the CALLERS — the let's
// adopting unify in apply_let_annotation, the return's ann pin — so this
// projection stays purely the refinement's discharge).
// The verdict comes back: Some(true) when the claim held (or there was none
// to raise), Some(false) refuted, None open — a guarded precondition's call
// site reads it to decide who pays the row the precondition guards.
//
// Every claim site — a return, an argument, a let annotation, a lambda's
// result — raises through `claim_refinement`, which decides the claim and
// notes the contract on the value's node and on every tail the node joins:
// a claim about a join is a claim about each value it takes. A later reader
// stands on the claim where it was made: a hole's proposals must satisfy
// it, a reader of a let's binder may lean on its annotation.
fn claim_refinement(ty, value_handle, span: ValidSpan) = {
  let verdict = apply_refinement_constraint(ty, value_handle, span)
  note_contract(ty, value_handle)
  verdict
}

// The contract a node stands under, noted where its later readers look: a
// refinement only, never a provision.
fn note_contract(ty, h) =
  if ty_carries_refinement(ty) && !is_provision(ty) { note_claim(ty, h) } else { () }

fn note_claim(ty, h) = {
  graph_claim_note(h, ty)
  match join_tails(h) {
    Some(tails) => tails |> each(note_claim(ty, ??)),
    None => (),
  }
}

fn apply_refinement_constraint(ty, value_handle, span: ValidSpan) = match ty {
  // TYPED IDENTITY (refinement_admits' layering, at the accrual): a value
  // whose every leaf already NAMES the alias — a parameter's precondition,
  // a callee's declared return — carries that alias's obligation at its
  // OWN first-claim site (the caller that owes the precondition, the
  // declaration that owes the return) — discharged, pending, or refuted
  // THERE. Accruing again per consumer echoes one claim N times up the
  // chain (a fixture with one honest claim surfaced five pendings); the
  // ledger owns each proof question at one home, so the echo accrues
  // nothing. A computation has no such leaf and raises, decided where it
  // stands.
  TAlias(aname, inner) => if value_carries_alias(value_handle, aname) {
    Some(true)
  } else {
    apply_refinement_constraint(inner, value_handle, span)
  },
  // a provision states what a position is handed; it claims nothing
  TRefined(_, PProvides(_)) => Some(true),
  // a refined structure claims its predicate and its parts
  TRefined(base, pred) => and_decide(
    verify_claim(graph_module_current(), span, subst_self(pred, value_handle), Refinement(pred, PTrue)),
    cross_parts(base, value_handle, span)
  ),
  TFun(eps, eret, _) => {
    fun_refinement_crossing(eps, eret, value_handle, span)
    Some(true)
  },
  TList(_) => cross_parts(ty, value_handle, span),
  TTuple(_) => cross_parts(ty, value_handle, span),
  TRecord(_) => cross_parts(ty, value_handle, span),
  TRecordOpen(_, _) => cross_parts(ty, value_handle, span),
  TName(_, _) => cross_parts(ty, value_handle, span),
  TVar(_) => {
    // A position whose contract is a variable states no use of what it is
    // handed. A function in sight carries its own contract on to wherever it
    // is applied, and a learning parameter's — whose contract is only what
    // its uses here teach it — is handed on (`hand_on_value`), its
    // structures' parts included. The arm crossed a function into the shape
    // it was unified with until H4: `Some(inv)` under `!Trap` paid the
    // guard of the function it held and refused (boot e23392f6), and a
    // caller's function inside a list handed to `fn keep_list(xs) = xs` and
    // applied off the result crossed nothing and trapped. A structured
    // contract with variable parts — `fold`'s `[a]` — is the channel's to
    // judge (`cross_parts`).
    hand_on_value(value_handle)
    Some(true)
  },
  _ => Some(true),
}

// A STRUCTURE claimed under a structured contract is claimed part by part,
// and its verdict is theirs, met: every part holds, or one is refuted, or one
// is owed. A VALUE part built in sight is claimed where it stands — `{den: 0}`
// under `{den: Positive}` refuses at the `0` — and a value part of a whole
// built out of sight is read off the whole's leaves at the part, or owed. A
// FUNCTION part crosses into its contract (H4·D): each element of `[inv]`
// into the element contract a parameter learned where its body applied
// `fs[0]`, a part of a learning parameter teaching it, a part of any other
// value read off its class, which is lossy. Until S4 a structure crossed its
// function parts alone and answered held, while a callee ASSUMED its value
// parts (`r.den` read as Positive under `r: {den: Positive}`), so
// `den_inv({den: 0})` under `!Trap` checked clean and divided by zero on boots
// e23392f6 and 1a68ecc0 — and so did a tuple's part, a list's element taken
// by a pattern, a nested record, and a record a `let` built or an
// unannotated parameter filled.
fn cross_parts(ty, value_handle, span: ValidSpan) =
  and_decide(fn_parts_verdict(ty, value_handle, span), value_parts_verdict(ty, value_handle, span))

fn fn_parts_verdict(ty, value_handle, span: ValidSpan) = if contract_holds_fn(ty) {
  contract_parts(ty) |> fold(Some(true), cross_part(value_handle, span, ??, ??))
} else {
  Some(true)
}

fn value_parts_verdict(ty, value_handle, span: ValidSpan) = if ty_carries_refinement(ty) {
  value_parts(ty) |> fold(Some(true), claim_value_part(value_handle, span, ??, ??))
} else {
  Some(true)
}

// A contract's parts that hold a function, each with its step.
fn contract_parts(ty) = match ty {
  TList(e) => fn_parts([(PartElem, e)]),
  TTuple(es) => fn_parts(es |> enumerate |> map(index_step_of)),
  TRecord(fs) => fn_parts(fs |> map(field_step)),
  TRecordOpen(fs, _) => fn_parts(fs |> map(field_step)),
  TName(_, args) => fn_parts(args |> enumerate |> map(type_arg_step)),
  TAlias(_, inner) => contract_parts(inner),
  _ => [],
}

// A contract's parts that carry a refinement and hold no function — a part
// holding one is a function part, whose crossing claims the refinements
// inside it as it goes. A nominal contract's parts are its constructors'
// fields at their declared types read at the contract's arguments, those
// fields the arguments reach: a field with a refinement of its own is claimed
// where the constructor is applied.
fn value_parts(ty) = match ty {
  TList(e) => refined_parts([(PartElem, e)]),
  TTuple(es) => refined_parts(es |> enumerate |> map(index_step_of)),
  TRecord(fs) => refined_parts(fs |> map(field_step)),
  TRecordOpen(fs, _) => refined_parts(fs |> map(field_step)),
  TName(n, _) => refined_parts(zip(variant_named_specs_at(TName(n, [])), variant_named_specs_at(ty)) |> flat_map(argument_fields)),
  TAlias(_, inner) => value_parts(inner),
  TRefined(base, _) => value_parts(base),
  _ => [],
}

fn refined_parts(parts) = parts |> filter(part_is_refined)

fn part_is_refined(part) = match part {
  (_, t) => ty_carries_refinement(t) && !contract_holds_fn(t),
}

// A constructor's fields its type's arguments reach: those whose declared
// type the arguments changed, each at its grounded type.
fn argument_fields(pair) = match pair {
  (declared, grounded) => match declared {
    (_, cname, dtys) => match grounded {
      (_, _, gtys) => zip(dtys, gtys) |> enumerate |> flat_map(argument_field(cname, ??)),
    },
  },
}

fn argument_field(cname: String, slot) = match slot {
  (i, pair) => match pair {
    (d, g) => if d == g { [] } else { [(PartCtor(cname, i), g)] },
  },
}

fn index_step_of(slot) = match slot {
  (i, e) => (PartIndex(i), e),
}

fn type_arg_step(slot) = match slot {
  (k, a) => (PartTypeArg(k), a),
}

fn field_step(f) = match f {
  (n, t) => (PartField(n), t),
}

fn claim_value_part(value_handle, span: ValidSpan, acc, part) =
  and_decide(acc, value_part_claim(value_handle, span, part))

// One value part claimed: where the whole was built in sight, at every node
// the part can be — an unannotated parameter placed there learns the
// contract, as one handed straight in does — and otherwise off the whole's
// leaves at the part.
fn value_part_claim(value_handle, span: ValidSpan, part) = match part {
  (step, pt) => match part_read(value_handle, step, claim_value_node(pt, span, ??)) {
    Some(verdicts) => verdicts |> fold(Some(true), and_decide),
    None => opaque_value_part(value_handle, [step], pt, span),
  },
}

fn claim_value_node(pt, span: ValidSpan, n) = {
  learn_precondition(n, pt)
  Some([claim_refinement(pt, n, span)])
}

// A part of a whole built out of sight is read off the whole's leaves at the
// part (verify.mn `path_leaves`): where every leaf states the part's
// refinement — a parameter's precondition, a declared return, a let's claim,
// each projected to the position — the claim holds on it, and otherwise it
// is owed here. What can bring a label to the part can bring it to the
// whole, so the part's labels are claimed of the whole. A structured part is
// read the same way at each of its own.
fn opaque_value_part(h, path, pt, span: ValidSpan) = and_decide(
  opaque_surface(h, path, pt, span),
  value_parts(pt) |> fold(Some(true), opaque_sub_part(h, path, span, ??, ??))
)

fn opaque_sub_part(h, path, span: ValidSpan, acc, part) = match part {
  (step, sub) => and_decide(acc, opaque_value_part(h, path ++ [step], sub, span)),
}

fn opaque_surface(h, path, pt, span: ValidSpan) = match demand_refinement(pt) {
  Some(found) => match found {
    (aname, pred) => if leaves_carry_alias(path_leaves(h, path), aname) {
      Some(true)
    } else if pred_names_label(pred) {
      and_decide(
        verify_claim(graph_module_current(), span, pred_without_labels(pred), Refinement(pred, PTrue)),
        verify_claim(
          graph_module_current(),
          span,
          subst_self(pred_only_labels(pred), h),
          Refinement(pred, PTrue)
        )
      )
    } else {
      verify_claim(graph_module_current(), span, pred, Refinement(pred, PTrue))
    },
  },
  None => Some(true),
}

// A part whose contract is still a cell is one the receiver never applied:
// what it does with the value — hand it on to a generic callee's callback —
// is judged where it hands it (`channel_crossing`), not here, and reading
// the cell's class would judge the function against whatever unification
// merged into it.
fn fn_parts(parts) = parts |> filter({ (_, t) => contract_holds_fn(t) })

fn contract_holds_fn(t) = match t {
  TFun(_, _, _) => true,
  TList(e) => contract_holds_fn(e),
  TTuple(es) => any(contract_holds_fn, es),
  TRecord(fs) => any(field_holds_fn, fs),
  TRecordOpen(fs, _) => any(field_holds_fn, fs),
  TName(_, args) => len(args) > 0 && any(contract_holds_fn, args),
  TAlias(_, inner) => contract_holds_fn(inner),
  TRefined(base, _) => contract_holds_fn(base),
  _ => false,
}

fn field_holds_fn(f) = match f {
  (_, t) => contract_holds_fn(t),
}

// Does a type hold a function anywhere a part path reaches?
fn ty_has_fn(t) = match t {
  TFun(_, _, _) => true,
  TVar(_) => match chase_ty(t) {
    TVar(_) => false,
    u => ty_has_fn(u),
  },
  TList(e) => ty_has_fn(e),
  TTuple(es) => any(ty_has_fn, es),
  TRecord(fs) => any(field_has_fn, fs),
  TRecordOpen(fs, _) => any(field_has_fn, fs),
  TName(_, args) => len(args) > 0 && any(ty_has_fn, args),
  TAlias(_, inner) => ty_has_fn(inner),
  TRefined(base, _) => ty_has_fn(base),
  _ => false,
}

fn field_has_fn(f) = match f {
  (_, t) => ty_has_fn(t),
}

fn cross_part(value_handle, span: ValidSpan, acc, part) = match part {
  (step, pt) => and_decide(
    acc,
    match part_read(value_handle, step, cross_node(pt, span, ??)) {
      Some(verdicts) => verdicts |> fold(Some(true), and_decide),
      None => opaque_part(value_handle, [step], pt, span),
    }
  ),
}

fn cross_node(pt, span: ValidSpan, n) = Some([apply_refinement_constraint(pt, n, span)])

// A function part of a whole built out of sight: a learning parameter's part
// learns it, any other is read off the class; the refinements beside the
// functions in it are claimed off the whole's leaves as any value part is.
fn opaque_part(h, path, pt, span: ValidSpan) = {
  match learning_path(h) {
    Some(at) => match at {
      (b, lp) => teach_part(b, lp ++ path, pt),
    },
    None => match contract_at(chase_deep(TVar(h)), path) {
      Some(ct) => class_part(ct, pt, h, span),
      None => (),
    },
  }
  opaque_value_part(h, path, pt, span)
}

// A part of a learning parameter learns what its function parts cross into.
fn teach_part(b, path, pt) = match fn_usage(pt) {
  Some(usage) => match usage {
    (kps, kret) => transport_at(b, path, kps, kret),
  },
  None => contract_parts(pt) |> each({ (step, sub) => teach_part(b, path ++ [step], sub) }),
}

// A part read off a value's class crosses as the function contract the
// class states there.
fn class_part(ct, pt, h, span: ValidSpan) = match fn_usage(pt) {
  Some(usage) => match usage {
    (kps, kret) => match fn_usage(ct) {
      Some(stated) => match stated {
        (sps, sret) => cross_contract_at(sps, sret, kps, kret, None, h, span),
      },
      None => (),
    },
  },
  None => (),
}

// A FUNCTION crossing a construction site carries its refinements across in
// both directions. Unification meets a refined position with a concrete base
// by checking the base alone — it holds no value to judge — so until
// 2026-09-28 both directions were dropped: `run(() => 30000.0)` into `fn
// run(f) = alpha(f())` checked clean over an Hz-refined parameter, and so did a
// filter demanding Hz handed a 70,900 Hz sweep through an inferred
// parameter (Pulse, measured). Each position is judged where its value is:
// - the RESULT is the function's own value leaving it (covariant): a
//   lambda's body is judged against the demanded refinement as a return is,
//   join-aware, at the body's own span; any other function's result is
//   covered only by a declaration naming the same refinement;
// - a PARAMETER is the callee's values arriving (contravariant): nothing at
//   this edge holds them, so a refinement the argument demands and the
//   parameter does not carry is honest debt here. The values live in the
//   callee's body, where `Hβ.verify.higher-order-refinement`'s refinement
//   variables would reach them.
// The crossing value is every function it can be (`fn_leaves`, H4): each is
// judged on its own, and a learning parameter handed on learns the
// position's contract instead (`transport_at`) — the function its own
// caller hands in meets that contract at that caller's crossing.
fn fun_refinement_crossing(eps, eret, value_handle, span: ValidSpan) =
  fn_leaves(value_handle) |> each(cross_leaf(eps, eret, value_handle, span, ??))

// One function crossing into a contract: its own type, read off its node —
// never chased through its positions' cells, which hold what unification
// met, not what this function demands.
fn cross_leaf(eps, eret, value_handle, span: ValidSpan, leaf) = match learning_path(leaf) {
  Some(at) => match at {
    (b, path) => transport_at(b, path, eps, eret),
  },
  None => match graph_chase(leaf) {
    GNode(NBound(TFun(aps, aret, _)), _) => cross_contract_at(aps, aret, eps, eret, lambda_body(leaf), value_handle, span),
    _ => (),
  },
}

// A function stated by its positions `aps` and result `aret` against what
// a receiver hands each position (`eps`) and demands of the result (`eret`).
// The positions are judged where the values arrive — contravariant — and
// the result where it leaves, covariant: a lambda's body is judged as a
// return is.
fn cross_contract_at(aps, aret, eps, eret, body, value_handle, span: ValidSpan) = {
  if len(aps) == len(eps) {
    zip(aps, eps) |> each(cross_position(value_handle, span, ??))
  } else {
    ()
  }
  cross_result(aret, eret, body, value_handle, span)
}

fn lambda_body(leaf) = match graph_node_body(leaf) {
  NExpr(LambdaExpr(_, body)) => Some(body),
  _ => None,
}

// One position: a value position decides the function's demand against
// what the receiver hands it, and the row the demand guards is paid where
// the function crosses unless the values handed prove it outright; a
// FUNCTION position hands the function a function, whose own demands the
// first function's usage of it must meet.
fn cross_position(value_handle, span: ValidSpan, pair) = match pair {
  (ap, ep) => if fn_position(param_ty(ap)) || fn_position(param_ty(ep)) {
    cross_fn_position(param_ty(ap), param_ty(ep), value_handle, span)
  } else {
    match provision_verdict(param_ty(ep), param_ty(ap), span) {
      PvStrict => (),
      PvHeld => pay_crossing(param_row(ap), value_handle),
      PvOpen => pay_crossing(param_row(ap), value_handle),
    }
  },
}

fn fn_position(t) = match t {
  TFun(_, _, _) => true,
  TRefined(base, _) => fn_position(base),
  TAlias(_, inner) => fn_position(inner),
  TVar(_) => match chase_ty(t) {
    TFun(_, _, _) => true,
    _ => false,
  },
  _ => false,
}

// How a function uses the function it is handed at a position: what it
// hands each of that function's positions, and what it demands of its
// result. None where nothing is known of the use.
fn fn_usage(t) = match t {
  TFun(ps, ret, _) => Some((ps, ret)),
  TAlias(_, inner) => fn_usage(inner),
  _ => None,
}

// What a position's values are judged by. A demand decided against values
// handed is STRICT when every one folds to a constant that proves it — the
// guard is not owed — and HELD when it stands on a precondition or a
// postcondition, whose guard is paid where the function crosses; OPEN is
// debt, raised here.
type ProvidedVerdict = PvStrict | PvHeld | PvOpen

fn provision_verdict(provided, demand, span: ValidSpan) = match demand_refinement(demand) {
  None => PvHeld,
  Some(found) => match found {
    (aname, pred) => match provided_of(provided) {
      Some(p) => match p {
        ProvidedAt(ns) => provided_claims(demand, span, ns),
        ProvidedBeyond(ns) => provided_meet(provided_claims(demand, span, ns), open_demand(pred, span)),
        ProvidedNone => open_demand(pred, span),
      },
      None => if refined_as(provided, aname) { PvHeld } else { open_demand(pred, span) },
    },
  },
}

fn provided_claims(demand, span: ValidSpan, ns) =
  ns |> map(provided_claim(demand, span, ??)) |> fold(PvStrict, provided_meet)

// A demand decided against one value handed, at that value's node: the
// claim's own verdict, then what it stood on.
fn provided_claim(demand, span: ValidSpan, n) = match apply_refinement_constraint(demand, n, span) {
  Some(held) => if held {
    let leaves = value_leaves(n, NoSelf)
    if leaves_unproven(leaves) || len(leaves_params(leaves)) > 0 { PvHeld } else { PvStrict }
  } else {
    PvOpen
  },
  None => PvOpen,
}

fn provided_meet(a, b) = match a {
  PvOpen => PvOpen,
  PvHeld => match b {
    PvOpen => PvOpen,
    _ => PvHeld,
  },
  PvStrict => b,
}

fn open_demand(pred, span: ValidSpan) = {
  verify_claim(graph_module_current(), span, pred, Refinement(pred, PTrue))
  PvOpen
}

// The refinement a type demands at its surface — a provision demands
// nothing.
fn demand_refinement(t) = match surface_refinement(t) {
  Some(found) => match found {
    (n, pred) => match pred {
      PProvides(_) => None,
      _ => Some((n, pred)),
    },
  },
  None => None,
}

// A function position: the functions the receiver hands there meet the
// usage the crossing function states of what it is handed — the receiver's
// provision names them by their nodes (each read along its edges), or by a
// contract it states.
fn cross_fn_position(a_t, e_t, value_handle, span: ValidSpan) = match provided_of(e_t) {
  Some(p) => match p {
    ProvidedAt(ns) => ns |> flat_map(fn_leaves) |> each(cross_provided(fn_usage(a_t), value_handle, span, ??)),
    ProvidedBeyond(ns) => {
      ns |> flat_map(fn_leaves) |> each(cross_provided(fn_usage(a_t), value_handle, span, ??))
      usage_of_unknown(fn_usage(a_t), span)
    },
    ProvidedNone => usage_of_unknown(fn_usage(a_t), span),
  },
  None => match fn_usage(e_t) {
    Some(stated) => match stated {
      (sps, sret) => match fn_usage(a_t) {
        Some(usage) => match usage {
          (kps, kret) => cross_contract_at(sps, sret, kps, kret, None, value_handle, span),
        },
        None => applied_unknowingly(sps, value_handle, span),
      },
    },
    None => usage_of_unknown(fn_usage(a_t), span),
  },
}

// A function the receiver handed, crossing into the usage. A learning
// parameter of the RECEIVER's body is a value its own callers chose: the
// crossing that would judge it is theirs
// (Hβ.verify.relational-provision).
fn cross_provided(usage, value_handle, span: ValidSpan, leaf) = if learning_param(leaf) {
  ()
} else {
  match provided_contract(leaf) {
    Some(found) => match found {
      (aps, aret, body) => match usage {
        Some(u) => match u {
          (kps, kret) => cross_contract_at(aps, aret, kps, kret, body, value_handle, span),
        },
        None => applied_unknowingly(aps, value_handle, span),
      },
    },
    None => (),
  }
}

// What a provided function states of itself: its own type, read off its
// node. A value this crossing cannot see as a function states nothing
// here: a function inside a structure is reached where the structure was
// built, through its part (`PartTypeArg` for a nominal type's), never off
// the class a unification merged it into.
fn provided_contract(leaf) = match graph_chase(leaf) {
  GNode(NBound(TFun(aps, aret, _)), _) => Some((aps, aret, lambda_body(leaf))),
  _ => None,
}

// A function applied with values nothing here can name: each demand is
// debt, and its guard is paid where the function crosses.
fn applied_unknowingly(aps, value_handle, span: ValidSpan) = aps |> each({
  ap => if fn_position(param_ty(ap)) {
    ()
  } else {
    match demand_refinement(param_ty(ap)) {
      Some(found) => match found {
        (_, pred) => {
          open_demand(pred, span)
          pay_crossing(param_row(ap), value_handle)
        },
      },
      None => pay_crossing(param_row(ap), value_handle),
    }
  },
})

// A function nothing here can name, handed where a usage demands of its
// result: the demand is debt.
fn usage_of_unknown(usage, span: ValidSpan) = match usage {
  Some(found) => match found {
    (_, kret) => match demand_refinement(kret) {
      Some(d) => match d {
        (_, pred) => {
          open_demand(pred, span)
          ()
        },
      },
      None => (),
    },
  },
  None => (),
}

// The result leaving the crossing function, against the receiver's demand:
// a value demand is claimed of a lambda's body as a return is, and any
// other function's result is covered only by a return naming the same
// refinement; a FUNCTION demand — the receiver applies the result — judges
// the functions the result can be against that usage.
fn cross_result(aret, eret, body, value_handle, span: ValidSpan) = match fn_usage(eret) {
  Some(usage) => match usage {
    (kps, kret) => match body {
      Some(b) => fun_refinement_crossing(kps, kret, b, span),
      None => match fn_usage(aret) {
        Some(stated) => match stated {
          (sps, sret) => cross_contract_at(sps, sret, kps, kret, None, value_handle, span),
        },
        None => (),
      },
    },
  },
  None => {
    match demand_refinement(eret) {
      Some(found) => match found {
        (ename, pred) => if refined_as(aret, ename) {
          ()
        } else {
          match body {
            Some(b) => {
              claim_refinement(eret, b, graph_span_of(b))
              ()
            },
            None => {
              verify_claim(graph_module_current(), span, pred, Refinement(pred, PTrue))
              ()
            },
          }
        },
      },
      None => (),
    }
    if ty_has_fn(eret) {
      cross_result_fns(aret, chase_deep(eret), body, value_handle, span)
    } else {
      ()
    }
  },
}

// The functions inside a structured result go wherever the receiver takes
// them: each function the receiver's usage holds at a path meets what the
// crossing function returns there — a lambda's body read at the path, any
// other function's stated result at the path. A result's function parts
// crossed nothing until S6: `run(pick)` over `fn run(g) = g(false).f(0)`
// divided by zero under `!Trap` while the declaration handed in published,
// at its result's `.f`, a function demanding a Positive refinement (pin
// 852184886f52a848).
fn cross_result_fns(aret, eret, body, value_handle, span: ValidSpan) =
  fn_positions(0, eret, []) |> each(cross_result_fn(aret, eret, body, value_handle, span, ??))

fn cross_result_fn(aret, eret, body, value_handle, span: ValidSpan, pos) = match pos {
  (_, path, _) => match contract_at(eret, path) {
    Some(ept) => match fn_usage(ept) {
      Some(usage) => match usage {
        (kps, kret) => match body {
          Some(b) => sources_at(b, path) |> each(cross_result_source(kps, kret, value_handle, span, ??)),
          None => match contract_at(chase_deep(aret), path) {
            Some(apt) => match fn_usage(apt) {
              Some(stated) => match stated {
                (sps, sret) => cross_contract_at(sps, sret, kps, kret, None, value_handle, span),
              },
              None => (),
            },
            None => (),
          },
        },
      },
      None => (),
    },
    None => (),
  },
}

// One function a lambda's body returns at the path: a function in sight
// crosses as an argument does, a learning parameter's part learns the usage,
// and a part out of sight crosses as the contract its class states.
fn cross_result_source(kps, kret, value_handle, span: ValidSpan, src) = match src {
  SrcLeaf(leaf) => cross_leaf(kps, kret, value_handle, span, leaf),
  _ => match source_learning(src) {
    Some(at) => match at {
      (b, path) => transport_at(b, path, kps, kret),
    },
    None => match source_fn_type(src) {
      Some(t) => match fn_usage(t) {
        Some(stated) => match stated {
          (sps, sret) => cross_contract_at(sps, sret, kps, kret, None, value_handle, span),
        },
        None => (),
      },
      None => (),
    },
  },
}

// A function crossing an argument edge goes where its callers' values are
// made beyond this edge, so nothing here proves its preconditions: the
// row each one guards is paid where the function crosses.
fn pay_crossing(row, value_handle) =
  if guard_owes_nothing(row) { () } else { pay_row(row, value_handle) }

// The refinement a type carries at its surface — the predicate under its
// alias chain, with the alias it hangs from ("" for an unnamed refinement).
fn surface_refinement(ty) = match ty {
  TAlias(name, inner) => match surface_refinement(inner) {
    Some((_, pred)) => Some((name, pred)),
    None => None,
  },
  TRefined(_, pred) => Some(("", pred)),
  _ => None,
}

// Does `ty` carry the named refinement? An unnamed one is never provably the
// same claim, so it answers false — debt, never a silent pass.
fn refined_as(ty, name: String) = match surface_refinement(ty) {
  Some((n, _)) => name != "" && n == name,
  None => false,
}

// ─── The functions a value can BE (H4) ───────────────────────────────────
//
// A function value's contract is read along the edges it flowed, as any
// value's refinement is: a join is every tail, a reference its binder's
// value — a let's, a destructured part's construction — a field or an
// element its whole's construction at the position, and a generic call's
// result the arguments its declared signature returns (`result_leaves`). A
// parameter is itself, and so is any other node, whose own type is its own
// contract: a reference to a declaration, a lambda, a call's result. The
// class says nothing — a join of two function values merged their types and
// kept the first branch's interior, so `if c { inv2 } else { inv }` called
// at 0 under `!Trap` checked clean and divided by zero (boot 13e8484a, pin
// e23392f6).
fn fn_leaves(h) = match value_tails(h) {
  Some(tails) => tails |> flat_map(fn_leaves),
  None => match graph_node_body(h) {
    NExpr(VarRef(_)) => match binder_read_by(h) {
      Some(b) => fn_leaves_at_binder(b, h),
      None => [h],
    },
    NExpr(FieldExpr(recv, fname)) => fn_leaves_of_part(recv, PartField(fname), h),
    NExpr(IndexExpr(recv, idx)) => fn_leaves_of_part(recv, index_step(recv, idx), h),
    NExpr(CallExpr(_, _)) => result_leaves(h),
    NExpr(PipeExpr(PForward, _, _)) => result_leaves(h),
    _ => [h],
  },
}

fn fn_leaves_at_binder(b, use_h) = match graph_binder_of(b) {
  Some(fact) => match fact {
    ParamFact(_) => [use_h],
    PartFact(f) => fn_leaves_of_part(f.whole, f.step, use_h),
    StateFact(f) => state_fn_leaves(b, f.writes, use_h),
  },
  None => match graph_node_body(b) {
    NExpr(_) => fn_leaves(b),
    _ => [use_h],
  },
}

// A function held in a handler's state is every function written into it,
// each writer read as the expression it is. Inside its own writers it is the
// reference itself, read off its class like any value nothing here names.
fn state_fn_leaves(b, writes, use_h) =
  if walking_state(b) { [use_h] } else { writes |> flat_map(fn_leaves) ~> walking_state_of(b) }

fn fn_leaves_of_part(whole, step, h) = match part_read(whole, step, fn_leaves_read) {
  Some(leaves) => leaves,
  None => [h],
}

fn fn_leaves_read(n) = Some(fn_leaves(n))

// A generic call's result is what its declared signature returns of its
// arguments: a result typed by a quantified variable its row carries no
// value of is one of the values the arguments hand in at that variable —
// parametricity: the callee cannot make one of its own — so `id(if c {
// inv2 } else { inv })` is whichever branch's function the join took. Any
// other result is the call itself, read off its class.
fn result_leaves(h) = match chase_ty(TVar(h)) {
  TFun(_, _, _) => match application_of(h) {
    Some(app) => match app {
      (callee_h, args) => match declared_scheme(callee_h) {
        Some(sch) => match sch {
          (qs, dps, dret, drow) => match result_var(qs, dret, drow) {
            Some(q) => match var_leaves(qs, dps, args, q) {
              Some(leaves) => leaves,
              None => [h],
            },
            None => [h],
          },
        },
        None => [h],
      },
    },
    None => [h],
  },
  _ => [h],
}

fn result_var(qs, dret, drow) = match bare_var(qs, dret) {
  Some(q) => if any({ v => v == q }, free_in_row(drow)) { None } else { Some(q) },
  None => None,
}

// The leaves of every source of a variable, when each source is a node in
// sight.
fn var_leaves(qs, dps, args, q) = {
  let sources =
    scheme_occurrences(qs, dps) |> filter(occ_source_of(q, ??)) |> flat_map(occurrence_sources(args, ??))
  if len(sources) > 0 && all(source_in_sight, sources) {
    Some(sources |> flat_map(source_leaf))
  } else {
    None
  }
}

fn source_in_sight(src) = match src {
  SrcLeaf(_) => true,
  SrcPart(_, _) => false,
  SrcContract(_, _) => false,
  SrcUnknown => false,
}

fn source_leaf(src) = match src {
  SrcLeaf(leaf) => [leaf],
  SrcPart(_, _) => [],
  SrcContract(_, _) => [],
  SrcUnknown => [],
}

// The callee and the arguments a node applies: an applied call's product
// (the shape the judgment decided, read off the product), or a pipe stage
// completed by the piped value.
fn application_of(h) = match graph_node_body(h) {
  NExpr(CallExpr(callee, _)) => match graph_product_at(h) {
    ProductOf(nodes, _, CallApplied) => match fn_leaves(callee) {
      [one] => Some((one, nodes)),
      _ => None,
    },
    ProductOf(_, _, CallSuspended) => None,
    NoProduct => None,
  },
  NExpr(PipeExpr(PForward, left, stage)) => match fn_leaves(stage) {
    [one] => stage_application(one, [left]),
    _ => None,
  },
  _ => None,
}

// A declared function's signature with its quantified variables, read off
// the module-level declaration the reference's edge reaches — the reference
// holds an instance, never the scheme.
fn declared_scheme(callee_h) = match graph_ref_decl(callee_h) {
  Some(d) => if at_module_level(d) {
    match graph_published(d) {
      Some((binding, _, FnScheme)) => match judgment_pair(binding) {
        (qs, ty) => match ty {
          TFun(dps, dret, drow) => Some((qs, dps, dret, drow)),
          _ => None,
        },
      },
      _ => None,
    }
  } else {
    None
  },
  None => None,
}

// ─── The channel through a generic call (H4·D) ──────────────────────────
//
// A generic callee moves values of a quantified variable without looking
// at them — parametricity — so a value an argument hands in at a variable
// is a value the callee may hand a function argument at the same variable.
// Each such SOURCE crosses into each such SINK: `fold(0, (acc, f) => acc +
// f(0), [inv])` hands the list's function to the callback's second
// parameter, which applies it at 0. The callee's body is never read — `fold` hands its callback to a
// handler — only its declared signature. A callback that is a learning
// parameter of the caller learns the application instead: what each of its
// positions is handed. On boot 13e8484a and pin e23392f6 that program
// checked clean under `!Trap` and divided by zero.
fn channel_crossing(callees, applied, call_h, span: ValidSpan) =
  callees |> each(channel_leaf(applied, call_h, span, ??))

// A reference is applied to the arguments as they stand; a partial stage
// is completed by them first (`stage_application`).
fn channel_leaf(applied, call_h, span: ValidSpan, leaf) = match graph_node_body(leaf) {
  NExpr(VarRef(_)) => channel_application(leaf, applied, call_h, span),
  _ => match stage_application(leaf, applied) {
    Some(app) => match app {
      (callee_h, args) => channel_application(callee_h, args, call_h, span),
    },
    None => (),
  },
}

fn channel_application(callee_h, args, call_h, span: ValidSpan) = if channel_candidate(args) {
  match declared_scheme(callee_h) {
    Some(sch) => match sch {
      (qs, dps, _, _) => channel_at(qs, dps, args, call_h, span),
    },
    None => (),
  }
} else {
  ()
}

// A channel can carry a function only where an argument is a function
// that is handed one, and another argument holds a function too — so
// never through an application of one argument, a pipe stage among them.
fn channel_candidate(args) =
  len(args) >= 2 && any(receives_a_function, args) && count(holds_a_function, args) >= 2

fn receives_a_function(h) = match graph_chase(h) {
  GNode(NBound(TFun(ps, _, _)), _) => any({ p => ty_has_fn(param_ty(p)) }, ps),
  _ => false,
}

fn holds_a_function(h) = match graph_chase(h) {
  GNode(NBound(t), _) => ty_has_fn(t),
  _ => false,
}

// Where a quantified variable stands in a declared signature: in an
// argument's value at a path, or at a function argument's position or
// result — that function found at a path in the argument — at a path
// inside that end.
type FnEnd = AtValue | AtParam(Int) | AtResult

type Occurrence = Occ(Int, Int, [PartStep], FnEnd, [PartStep])

// Where the values a variable takes come from at one application: a
// function or value in sight, a part of an argument this walk cannot see
// into, a contract a callback's declaration states for its result, or
// nothing nameable.
type ChannelSource = SrcLeaf(Int) | SrcPart(Int, [PartStep]) | SrcContract(Ty, Int) | SrcUnknown

fn channel_at(qs, dps, args, call_h, span: ValidSpan) = {
  let occs = scheme_occurrences(qs, dps)
  let sources =
    qs |> map({ q => (q, occs |> filter(occ_source_of(q, ??)) |> flat_map(occurrence_sources(args, ??))) })
  callback_positions(dps) |> each(channel_callback(qs, sources, args, call_h, span, ??))
}

fn scheme_occurrences(qs, dps) =
  dps |> enumerate |> flat_map({ (i, dp) => value_occurrences(qs, i, param_ty(dp), []) })

fn value_occurrences(qs, i, t, path) = match t {
  TVar(v) => if any({ q => q == v }, qs) { [Occ(v, i, path, AtValue, [])] } else { [] },
  TList(e) => value_occurrences(qs, i, e, path ++ [PartElem]),
  TTuple(es) => es |> enumerate |> flat_map({ (k, e) => value_occurrences(qs, i, e, path ++ [PartIndex(k)]) }),
  TRecord(fs) => fs |> flat_map({ (n, ft) => value_occurrences(qs, i, ft, path ++ [PartField(n)]) }),
  TRecordOpen(fs, _) => fs |> flat_map({ (n, ft) => value_occurrences(qs, i, ft, path ++ [PartField(n)]) }),
  TFun(ps, r, _) => {
    let at_params =
      ps |> enumerate |> flat_map({ (j, p) => end_occurrences(qs, i, path, AtParam(j), param_ty(p), []) })
    at_params ++ end_occurrences(qs, i, path, AtResult, r, [])
  },
  TName(_, args) => args |> enumerate |> flat_map(type_arg_values(qs, i, path, ??)),
  TAlias(_, inner) => value_occurrences(qs, i, inner, path),
  TRefined(base, _) => value_occurrences(qs, i, base, path),
  TReprPin(_, base) => value_occurrences(qs, i, base, path),
  _ => [],
}

// A nominal type is read as a container of its type arguments' values: the
// variable standing at argument `k` is reached at `PartTypeArg(k)`, whose
// parts are the fields of a construction in sight (verify.mn `built_part`).
// `Option(a)` went unread until H4, so the function `Some(inv)` carries
// reached no callback, and `opt_apply({ g => g(0) }, Some(inv))` over a
// generic `opt_apply(f, o)` checked clean under `!Trap` and trapped.
fn type_arg_values(qs, i, path, slot) = match slot {
  (k, a) => value_occurrences(qs, i, a, path ++ [PartTypeArg(k)]),
}

// One end of a function argument: a function nested inside it is not read
// (Hβ.verify.channel-depth-one).
fn end_occurrences(qs, i, path, end, t, sub) = match t {
  TVar(v) => if any({ q => q == v }, qs) { [Occ(v, i, path, end, sub)] } else { [] },
  TList(e) => end_occurrences(qs, i, path, end, e, sub ++ [PartElem]),
  TTuple(es) => es |> enumerate |> flat_map({ (k, e) => end_occurrences(qs, i, path, end, e, sub ++ [PartIndex(k)]) }),
  TRecord(fs) => fs |> flat_map({ (n, ft) => end_occurrences(qs, i, path, end, ft, sub ++ [PartField(n)]) }),
  TRecordOpen(fs, _) => fs |> flat_map({ (n, ft) => end_occurrences(qs, i, path, end, ft, sub ++ [PartField(n)]) }),
  TName(_, args) => args |> enumerate |> flat_map(type_arg_ends(qs, i, path, end, sub, ??)),
  TAlias(_, inner) => end_occurrences(qs, i, path, end, inner, sub),
  TRefined(base, _) => end_occurrences(qs, i, path, end, base, sub),
  TReprPin(_, base) => end_occurrences(qs, i, path, end, base, sub),
  _ => [],
}

fn type_arg_ends(qs, i, path, end, sub, slot) = match slot {
  (k, a) => end_occurrences(qs, i, path, end, a, sub ++ [PartTypeArg(k)]),
}

fn occ_source_of(q, occ) = match occ {
  Occ(v, _, _, end, _) => if v == q { is_source_end(end) } else { false },
}

fn is_source_end(end) = match end {
  AtValue => true,
  AtResult => true,
  AtParam(_) => false,
}

fn occurrence_sources(args, occ) = match occ {
  Occ(_, i, path, end, sub) => match take(1, drop(i, args)) {
    [a] => arg_sources(path, end, sub, a),
    _ => [SrcUnknown],
  },
}

fn arg_sources(path, end, sub, a) = match end {
  AtValue => sources_at(a, path),
  AtResult => sources_at(a, path) |> flat_map(result_sources(sub, ??)),
  AtParam(_) => [],
}

// The values at a path of an argument, along its edges: each part the value
// was built with in sight, and its function leaves; a part out of sight is
// the whole with the rest of the path.
fn sources_at(h, path) = match path {
  [] => fn_leaves(h) |> map(SrcLeaf),
  [step, ...rest] => match part_read(h, step, sources_read(rest, ??)) {
    Some(sources) => sources,
    None => [SrcPart(h, path)],
  },
}

fn sources_read(rest, n) = Some(sources_at(n, rest))

// What a callback hands back, at a path in its result: a lambda's body, a
// declared function's return contract. A callback that is a learning
// parameter — its own caller's choice — hands back nothing nameable
// (Hβ.verify.channel-through-callback-results).
fn result_sources(sub, src) = match src {
  SrcLeaf(leaf) => if learning_param(leaf) {
    [SrcUnknown]
  } else {
    match lambda_body(leaf) {
      Some(body) => sources_at(body, sub),
      None => match graph_chase(leaf) {
        GNode(NBound(TFun(_, ret, _)), _) => [contract_source(ret, sub, leaf)],
        _ => [SrcUnknown],
      },
    }
  },
  SrcPart(_, _) => [SrcUnknown],
  SrcContract(c, at) => match fn_usage(c) {
    Some(stated) => match stated {
      (_, sret) => [contract_source(sret, sub, at)],
    },
    None => [SrcUnknown],
  },
  SrcUnknown => [SrcUnknown],
}

fn contract_source(t, sub, at) = match contract_at(t, sub) {
  Some(c) => if ty_carries_contract(c) { SrcContract(c, at) } else { SrcUnknown },
  None => SrcUnknown,
}

// Every function a declared parameter holds, at its path in the argument.
fn callback_positions(dps) =
  dps |> enumerate |> flat_map({ (i, dp) => fn_positions(i, param_ty(dp), []) })

fn fn_positions(i, t, path) = match t {
  TFun(ps, _, _) => [(i, path, ps)],
  TList(e) => fn_positions(i, e, path ++ [PartElem]),
  TTuple(es) => es |> enumerate |> flat_map({ (k, e) => fn_positions(i, e, path ++ [PartIndex(k)]) }),
  TRecord(fs) => fs |> flat_map({ (n, ft) => fn_positions(i, ft, path ++ [PartField(n)]) }),
  TRecordOpen(fs, _) => fs |> flat_map({ (n, ft) => fn_positions(i, ft, path ++ [PartField(n)]) }),
  TName(_, args) => args |> enumerate |> flat_map(type_arg_positions(i, path, ??)),
  TAlias(_, inner) => fn_positions(i, inner, path),
  TRefined(base, _) => fn_positions(i, base, path),
  _ => [],
}

fn type_arg_positions(i, path, slot) = match slot {
  (k, a) => fn_positions(i, a, path ++ [PartTypeArg(k)]),
}

fn channel_callback(qs, sources, args, call_h, span: ValidSpan, cb) = match cb {
  (i, path, cps) => if i < len(args) && any(position_holds_var(qs, ??), cps) {
    sources_at(args[i], path) |> each(callback_crossing(qs, sources, cps, call_h, span, ??))
  } else {
    ()
  },
}

fn position_holds_var(qs, cp) = len(end_occurrences(qs, 0, [], AtValue, param_ty(cp), [])) > 0

// One function the callee is handed at a callback position. A learning
// parameter of the caller learns the application — what each position is
// handed, and values nothing here can name at a position no variable
// carries; a function in sight is judged at each position the variables'
// sources reach, against the usage its own type states there.
fn callback_crossing(qs, sources, cps, call_h, span: ValidSpan, cb) = match source_learning(cb) {
  Some(at) => {
    match at {
      (b, lp) => learn_application(b, lp, cps |> map(channel_provision(qs, sources, ??)), None),
    }
    cps |> each(hand_on_position(qs, sources, ??))
  },
  None => cps |> enumerate |> each(position_crossing(qs, sources, source_positions(cb), call_h, span, ??)),
}

// What a learning callback is handed goes where this body cannot see: each
// learning function among the sources reaching its positions is handed on.
fn hand_on_position(qs, sources, cp) =
  end_occurrences(qs, 0, [], AtValue, param_ty(cp), []) |> each(hand_on_occurrence(sources, ??))

fn hand_on_occurrence(sources, occ) = match occ {
  Occ(q, _, _, _, _) => var_sources(sources, q) |> each(hand_on),
}

// The learning parameter a source is a function of — itself, or a part of
// it at a path — with the path to the function.
fn source_learning(src) = match src {
  SrcLeaf(leaf) => learning_path(leaf),
  SrcPart(h, path) => match learning_path(h) {
    Some(at) => match at {
      (b, lp) => Some((b, lp ++ path)),
    },
    None => None,
  },
  SrcContract(_, _) => None,
  SrcUnknown => None,
}

// The positions a function in sight states of itself.
fn source_positions(src) = match src {
  SrcLeaf(leaf) => match graph_chase(leaf) {
    GNode(NBound(TFun(aps, _, _)), _) => Some(aps),
    _ => None,
  },
  SrcPart(_, _) => None,
  SrcContract(_, _) => None,
  SrcUnknown => None,
}

// What a callback position is handed: the sources of its variable, joined
// — a contract where the one source is a contract — and values nothing here
// can name where no variable stands bare.
fn channel_provision(qs, sources, cp) = match bare_var(qs, param_ty(cp)) {
  Some(q) => sources_provision(var_sources(sources, q)),
  None => handed_unknown(),
}

fn sources_provision(srcs) = match srcs {
  [SrcContract(c, _)] => ByContract(c),
  _ => Handed(srcs |> fold(ProvidedNone, source_provided)),
}

fn source_provided(acc, src) = provided_union(acc, provided_of_source(src))

fn provided_of_source(src) = match src {
  SrcLeaf(leaf) => if learning_param(leaf) { ProvidedBeyond([]) } else { ProvidedAt([leaf]) },
  SrcPart(_, _) => ProvidedBeyond([]),
  SrcContract(_, _) => ProvidedBeyond([]),
  SrcUnknown => ProvidedBeyond([]),
}

fn bare_var(qs, t) = match t {
  TVar(v) => if any({ q => q == v }, qs) { Some(v) } else { None },
  TAlias(_, inner) => bare_var(qs, inner),
  TRefined(base, _) => bare_var(qs, base),
  TReprPin(_, base) => bare_var(qs, base),
  _ => None,
}

fn var_sources(sources, q) = match find({ (v, _) => v == q }, sources) {
  Some(found) => match found {
    (_, srcs) => srcs,
  },
  None => [],
}

// One callback position: each variable standing there, at its path in the
// position, carries its sources into the usage the callback states there.
fn position_crossing(qs, sources, aps, call_h, span: ValidSpan, slot) = match slot {
  (j, cp) => end_occurrences(qs, 0, [], AtValue, param_ty(cp), []) |> each(occurrence_crossing(sources, aps, j, call_h, span, ??)),
}

fn occurrence_crossing(sources, aps, j, call_h, span: ValidSpan, occ) = match occ {
  Occ(q, _, _, _, sub) => var_sources(sources, q) |> each(source_into(usage_at(aps, j, sub), call_h, span, ??)),
}

fn usage_at(aps, j, sub) = match aps {
  Some(ps) => if j < len(ps) {
    match contract_at(param_ty(ps[j]), sub) {
      Some(t) => fn_usage(t),
      None => None,
    }
  } else {
    None
  },
  None => None,
}

// A source crossing into a usage: a function in sight is judged against it
// (a learning parameter learns it), a part out of sight of a learning
// parameter learns it there, and a contract read off a class or a
// declaration crosses as the contract it states. Under a usage nothing is
// known of, every demand is debt.
fn source_into(usage, call_h, span: ValidSpan, src) = match usage {
  Some(found) => match found {
    (kps, kret) => match src {
      SrcLeaf(leaf) => cross_leaf(kps, kret, leaf, span, leaf),
      SrcPart(h, path) => match learning_path(h) {
        Some(at) => match at {
          (b, lp) => transport_at(b, lp ++ path, kps, kret),
        },
        None => match contract_at(chase_deep(TVar(h)), path) {
          Some(ct) => class_part(ct, TFun(kps, kret, mk_ef_pure()), h, span),
          None => (),
        },
      },
      SrcContract(c, at) => class_part(c, TFun(kps, kret, mk_ef_pure()), at, span),
      SrcUnknown => usage_of_unknown(usage, span),
    },
  },
  None => source_unknowingly(call_h, span, src),
}

// A source handed where nothing is known of its use: a function in sight
// owes each demand as debt, and a learning parameter's function learns
// that each position is handed values nothing here can name.
fn source_unknowingly(call_h, span: ValidSpan, src) = match source_learning(src) {
  Some(at) => learn_unknown_use(at),
  None => match src {
    SrcLeaf(leaf) => match graph_chase(leaf) {
      GNode(NBound(TFun(aps, _, _)), _) => applied_unknowingly(aps, leaf, span),
      _ => (),
    },
    SrcPart(_, _) => (),
    SrcContract(c, at) => match fn_usage(c) {
      Some(stated) => match stated {
        (sps, _) => applied_unknowingly(sps, at, span),
      },
      None => (),
    },
    SrcUnknown => (),
  },
}

fn learn_unknown_use(at) = match at {
  (b, lp) => learn_fn_at(b, lp, unknown_with),
}

// ─── What this body cannot see (H4) ─────────────────────────────────────
//
// A learning parameter's usage is what its uses in sight teach it — the
// applications of it and the contracts it crosses into. Everywhere else its
// function goes is a use nothing here states: the caller's own function,
// when it is handed to another learning parameter (`applied_by_choice`) or
// to a generic callee's callback that is one (`hand_on_position`), and the
// caller itself, when the body returns it. There it learns that each
// position is handed values nothing here can name, since the provisions it
// learned in sight are only what THIS body hands it. On the H4 tree before
// this rule, `wrap(inv)(0)` over `wrap(g) = { let _ = g(5); g }` and
// `run({ k => k(0) }, inv)` over `run(g, h) = { let _ = h(5); g(h) }` —
// and five shapes like them — checked clean under `!Trap` and divided by
// zero: the provision 5 was read precisely, and the use that applied the
// function at 0 was out of sight. Boot e23392f6 refused each only because a
// constant argument provided nothing there.
fn hand_on_value(h) = value_fn_positions(h) |> each(hand_on_at(h, ??))

// The functions a value's type holds, at their paths. A type that holds none
// answers none before its deep chase is built — most values handed on hold
// no function, and building a whole type to find nothing in it is a
// derivation nothing asked for.
fn value_fn_positions(h) =
  if ty_has_fn(TVar(h)) { fn_positions(0, chase_deep(TVar(h)), []) } else { [] }

fn hand_on_at(h, pos) = match pos {
  (_, path, _) => sources_at(h, path) |> each(hand_on),
}

fn hand_on(src) = match source_learning(src) {
  Some(at) => learn_unknown_use(at),
  None => (),
}

fn unknown_with(found) = match found {
  (ps, ret, row) => Some(TFun(ps |> map({ p => provided_with((p, handed_unknown())) }), ret, row)),
}

fn build_inferred_params(handles) = map((h) => mk_param("_", TVar(h)), handles)

fn register_type_constructors(type_name, variants, decl) = {
  let total = len(variants)
  // ONE quantification map per DECL (HM: every ctor of a type
  // quantifies the type's full parameter set — None : Option(a)
  // too). Lowercase TName leaves ARE the parameters: the case rule
  // IS the declaration; no angle-bracket list exists to keep in sync.
  match quantify_variants(variants, make_list(total), 0, total, [], Declared(type_name)) {
    (converted, qmap) => {
      // result_ty's argument list is the TYPE parameters only (the type is applied
      // as `TName(type_name, [params])`). A function field's ROW the author did
      // not write is no parameter of the type, so it is one cell of the
      // declaration, quantified by no scheme: every construction writes the row
      // of the function it stores into that cell, and every match reads the
      // cell back, so a function taken out of the field performs what any
      // function put in it performs. Freshened per use, as it was until
      // 2026-10-16, it was a different row at each construction and each
      // match, so `fn bad() with !E = match make() { Holds(f) => f(), … }`
      // over `Holds(() -> Int)` checked clean and performed E
      // (tests/crown/leak-field-row-unwritten.mn).
      let all_handles = map({ (_, h) => h }, qmap)
      let param_handles = filter((h) => !is_row_handle(h), all_handles)
      let result_ty = TName(type_name, map(TVar, param_handles))
      let qhandles = param_handles
      // THE GROUPING IS CARRIED, NEVER RE-DERIVED: the type's own env entry
      // holds its variant specs — minted here where the list is already in
      // hand. Every reader (the eq/show sum leaves, the worthiness witness's
      // structure test) was re-deriving this grouping by scanning the WHOLE
      // env snapshot backward per read — 46% of the two-pass self-compile
      // once the env doubled. The nominal-record shape registers none
      // (RecordSchemeKind is its channel), mirroring exactly the set the
      // deleted scans produced.
      let single_record = if total == 1 {
        match list_index(variants, 0) {
          (cn0, _, _) => {
            let f0 = list_index(converted, 0)
            if len(f0) == 1 && cn0 == type_name { is_record_ty(list_index(f0, 0)) } else { false }
          },
        }
      } else {
        false
      }
      if single_record {
        ()
      } else {
        // Registered BEFORE the ctors so a same-named single-variant ctor
        // (type Instant = Instant(Int)) SHADOWS this entry for value-position
        // resolution — the kind-filtered env_lookup_variants walk is the one
        // reader that reaches past the shadow (the KIND IS THE NAMESPACE).
        env_extend(
          type_name,
          Frozen(qhandles, result_ty),
          Declared(type_name),
          TypeVariants(map(
            {
              (tag_id, v) => match v {
                (cn, _, _) => (tag_id, cn, list_index(converted, tag_id)),
              },
            },
            enumerate(variants)
          )),
          decl
        )
      }
      each(
        {
          (tag_id, variant) => register_one_variant(
            type_name,
            result_ty,
            qhandles,
            list_index(converted, tag_id),
            variant,
            tag_id,
            total
          ),
        },
        enumerate(variants)
      )
    },
  }
}

// Pass 1 — convert + quantify each variant's field types, threading
// the decl-wide (name, handle) parameter map.
fn quantify_variants(variants, buf, i, n, qmap, owner) = if i >= n {
  (slice(buf, 0, n), qmap)
} else {
  match list_index(variants, i) {
    (_, field_types, _) => match quantify_ty_list(field_types, qmap, owner) {
      (fields2, q2) => quantify_variants(variants, list_set(buf, i, fields2), i + 1, n, q2, owner),
    },
  }
}

fn quantify_ty_list(tys, qmap, owner) = if len(tys) == 0 {
  ([], qmap)
} else {
  match quantify_ctor_ty(list_index(tys, 0), qmap, owner) {
    (head2, q1) => match quantify_ty_list(slice(tys, 1, len(tys)), q1, owner) {
      (rest2, q2) => ([head2] ++ rest2, q2),
    },
  }
}

// quantify_ctor_row — re-mint a function field's OPEN row edges as genuine row
// variables and quantify them (push onto qmap; result_ty filters row handles out).
// A CLOSED row (`-> B with IO`) is monomorphic — no polymorphic tail — so it
// passes through unchanged; each open edge (the default `-> B`'s, or one an
// author named, `with e`) becomes a quantified row var (`quantify_row_edge`).
// AN AUTHORED NEGATION on a function type (`f: () -> Int with !E`) is a
// GATED quantified row var, never a universe VALUE: it used to pass
// through as `([], [E], EtAll)`, which every fold beside it read as
// "anything" — `fn both(f: () -> Int with !E, g) with !F = f() + g()`
// refused `!F + Any vs Any` with g performing nothing forbidden, and the
// sibling terminal was dropped from the published row (measured
// 2026-09-27). The cell is free, each use instantiates it fresh with the
// gate copied (build_inst_mapping), and the argument edge's write is
// where the negation is judged. `owner` names the declaration the
// annotation belongs to, so the refusal at a call site can say so.
fn quantify_ctor_row(row, qmap, owner) = match row {
  EfRow(names, ab, t) => match t {
    EtOpen(edges) => match fold(([], qmap), quantify_row_edge, edges) {
      (edges2, q2) => (ef_make(names, ab, EtOpen(edges2)), q2),
    },
    EtAll => if len(names) == 0 {
      let rv = graph_fresh_row(Inferred("negation-gated effect row of a stored function"))
      gate_install(rv, mk_gate(mk_ef_neg(ab), owner), span_zero())
      (ef_make([], [], EtOpen([bare_edge(rv)])), push(qmap, ("", rv)))
    } else {
      (row, qmap)
    },
    EtClosed => (row, qmap),
  },
}

// A function type's row as its author wrote it — the cell whose node holds
// the terms — read for what the terms mean. A row the type was given any
// other way is what it says.
fn written_fn_row(row, owner) = match row {
  EfRow(_, _, EtOpen([e])) => match graph_node_body(edge_cell(e)) {
    NRow(terms) => written_row_meaning(edge_cell(e), terms, owner),
    NExpr(_)
    | NStmt(_)
    | NPat(_)
    | NHole(_)
    | NModule(_)
    | NLink(_)
    | NTypeAnn(_)
    | NName(_)
    | NParam(_) => row,
  },
  EfRow(_, _, EtOpen(_)) | EfRow(_, _, EtClosed) | EfRow(_, _, EtAll) => row,
}

// What a written row means: its terms folded where the type is first read,
// after every named row is registered, and its cell bound to the fold, so
// every later read reads the same row.
fn written_row_meaning(c, terms, owner) = match graph_chase(c) {
  GNode(NRowBound(bound), _) => bound,
  GNode(NBound(_), _)
  | GNode(NFree(_), _)
  | GNode(NRowFree(_), _)
  | GNode(NRecordRowBound(_, _), _)
  | GNode(NErrorHole(_), _) => {
    let folded = build_declared_row(terms)
    graph_bind_row(c, folded, owner)
    folded
  },
}

// Every written row under an annotation's node, read for its meaning — an
// alias's body is read through the alias, never through the intake, and a use
// the walk reaches before the alias's own judgment reads the row it means,
// never a variable a call could bind.
fn read_written_rows(c, owner) = {
  match graph_node_body(c) {
    NRow(terms) => {
      let _ = written_row_meaning(c, terms, owner)
      ()
    },
    NExpr(_)
    | NStmt(_)
    | NPat(_)
    | NHole(_)
    | NModule(_)
    | NLink(_)
    | NTypeAnn(_)
    | NName(_)
    | NParam(_) => (),
  }
  each(read_written_rows(??, owner), body_child_handles(graph_node_body(c)))
}

// Each open edge becomes a quantified row variable, its mask kept: one the
// author named (`with e`) is the signature's one cell for that name, the
// parse's anonymous tail a cell of its own.
fn quantify_row_edge(acc, e) = match acc {
  (es, q) => match declared_var_name(edge_cell(e)) {
    Some(n) => match qmap_find(q, row_var_key(n)) {
      Some(rv) => (push(es, row_edge(rv, edge_mask(e))), q),
      None => {
        let rv = graph_fresh_row(Declared(n))
        (push(es, row_edge(rv, edge_mask(e))), push(q, (row_var_key(n), rv)))
      },
    },
    None => {
      let rv = graph_fresh_row(Inferred("polymorphic effect row of a stored function"))
      (push(es, row_edge(rv, edge_mask(e))), push(q, ("", rv)))
    },
  },
}

// Lowercase TName leaves become quantified TVars; capitalized names
// keep nominal identity (args recurse); compound forms recurse. `owner`
// is the Reason of the declaration whose annotation is being read — the
// gate a `with !E` on a stored function type installs carries it.
fn quantify_ctor_ty(ty, qmap, owner) = match ty {
  // `!` — the never-returns bottom (parse_type_atom's TBang). Each
  // occurrence mints its OWN fresh var, never a shared qmap entry: bottom
  // is per-site, so `abort() -> !` instantiates to a type every consumer
  // unifies with, at every call independently.
  TName(name, args) => if len(args) == 0 && type_name_eq(name, "!") {
    (TVar(graph_fresh_ty(Inferred("bottom: never returns"))), qmap)
  } else if len(args) == 0 && first_char_code(name) >= 97 && first_char_code(name) <= 122 {
    match qmap_find(qmap, name) {
      Some(h) => (TVar(h), qmap),
      None => {
        let h = graph_fresh_ty(Declared(name))
        (TVar(h), push(qmap, (name, h)))
      },
    }
  } else if len(args) == 0 {
    // A capitalized nullary name resolves through the env edge its type
    // declaration drew (§2 follow-the-edge): a transparent / refined
    // alias binds as its LIVE TAlias, so unification sees through it and
    // fold_strip / repr_of reach the base scalar. Binding the raw
    // syntactic TName instead minted a nominal sum-compare for a refined
    // Int — $compare_nValidOffset tag-compared byte POSITIONS ≥ heap_base,
    // so m3's lexer cut every input at 4096 bytes (2026-07-09). A nominal
    // record / ADT / not-yet-declared name stays TName: its identity IS
    // nominal; only a TAlias-bodied entry is transparent. The read is the
    // TYPE-position lookup: an effect decl may share the name (`effect
    // Sample` + `type Sample`), and the plain newest-entry read would let
    // the effect shadow the alias — the kind is the namespace.
    (named_type(name, env_resolve_type(name)), qmap)
  } else {
    match quantify_ty_list(args, qmap, owner) {
      (args2, q2) => (TName(name, args2), q2),
    }
  },
  TList(elem) => match quantify_ctor_ty(elem, qmap, owner) {
    (e2, q2) => (TList(e2), q2),
  },
  TTuple(elems) => match quantify_ty_list(elems, qmap, owner) {
    (es2, q2) => (TTuple(es2), q2),
  },
  TFun(params, ret, row) => match quantify_tparam_list(params, qmap, owner) {
    (ps2, q1) => match quantify_ctor_ty(ret, q1, owner) {
      // A function-typed FIELD is effect-POLYMORPHIC: its open row tail must be a
      // genuine ROW variable, quantified into the ctor scheme so each USE of the
      // ctor instantiates a FRESH row (a stored function carries its own effects;
      // a table of them unifies their rows by the row algebra). parse_type_ty
      // mints the tail as a TYPE handle (fresh_handle → graph_fresh_ty), which
      // free_in_row never collects and instantiate can't freshen, so the tail
      // stayed a single free var that finalize closed to Pure — every effectful
      // stored closure then "violated Pure" (the CLI verb table). Re-mint the tail
      // as a row var here and quantify it; result_ty filters row handles out by
      // node-kind, so the type stays non-parametric.
      (r2, q2) => match quantify_ctor_row(written_fn_row(row, owner), q2, owner) {
        (row2, q3) => (TFun(ps2, r2, row2), q3),
      },
    },
  },
  TRecord(fields) => match quantify_field_list(fields, qmap, owner) {
    (fs2, q2) => (TRecord(fs2), q2),
  },
  TVar(h) => resolve_written(h, ty, qmap, owner),
  // An open record's fields quantify as a closed one's; a rest its author
  // named (`...r`) is the signature's one row variable for that name, so
  // `{name: String, ...r} -> {name: String, age: Int, ...r}` carries the
  // same remainder through, lacking every field written in front of it.
  TRecordOpen(fields, v) => match quantify_field_list(fields, qmap, owner) {
    (fs2, q2) => match declared_var_name(v) {
      Some(r) => match qmap_find(q2, "...{r}") {
        Some(h) => {
          row_lacks_install(h, map(field_name, fs2))
          (TRecordOpen(fs2, h), q2)
        },
        None => {
          let h = graph_fresh_row(Declared(r))
          row_lacks_install(h, map(field_name, fs2))
          (TRecordOpen(fs2, h), push(q2, ("...{r}", h)))
        },
      },
      None => (TRecordOpen(fs2, v), q2),
    },
  },
  _ => (ty, qmap),
}

// A name an author wrote in a type (parser.mn's written_type_name): resolved
// here, where the annotation is read and its scope is in force — its node
// linked to the declaration the name denotes, so `refs of` the type answers
// the annotation, and bound to the type the name resolves to. Any other
// variable is the judgment's own and passes through.
fn resolve_written(h, ty, qmap, owner) = match graph_node_body(h) {
  NTypeAnn(TName(name, args)) => {
    let decl = type_decl_named(name)
    match decl {
      Some(d) => graph_ref_link(h, d),
      None => (),
    }
    match if len(args) == 0 {
      (named_type(name, decl), qmap)
    } else {
      match quantify_ty_list(args, qmap, owner) {
        (args2, q2) => (TName(name, args2), q2),
      }
    } {
      (resolved, q) => {
        graph_bind(h, resolved, Located(graph_span_of(h), owner))
        (resolved, q)
      },
    }
  },
  NTypeAnn(_)
  | NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => (ty, qmap),
}

// A written name linked where every declaration of the link is registered,
// then the names its children write: a type name to the type it denotes, and
// an effect name in a function type's row to the effect or named row it
// denotes, refused when it denotes neither. A constructor's fields and an
// op's signature are read when their declarations register, before a type
// declared later in the link — or the declaring type itself — has a
// declaration to link to.
fn link_written(c) = {
  match graph_node_body(c) {
    NTypeAnn(TName(name, _)) => match type_decl_named(name) {
      Some(d) => graph_ref_link(c, d),
      None => (),
    },
    NName(RowEffect(ename)) => check_effect_name(ename, Some(c), graph_span_of(c)),
    NTypeAnn(_)
    | NExpr(_)
    | NStmt(_)
    | NPat(_)
    | NHole(_)
    | NModule(_)
    | NLink(_)
    | NName(ArmOp(_))
    | NName(StateWrite(_))
    | NRow(_)
    | NParam(_) => (),
  }
  each(link_written, body_child_handles(graph_node_body(c)))
}

// The declaration a type name denotes: an alias or a nominal record, else a
// sum type's variants — the kind is the namespace, so an effect or a
// constructor of the name never answers.
fn type_decl_named(name: String) = match env_resolve_type(name) {
  Some(d) => Some(d),
  None => env_resolve_variants(name),
}

// A capitalized name standing alone: an alias binds as its TAlias, so
// unification sees through it to its base; any other declaration keeps its
// nominal identity. The alias's declared type holds the names its author
// wrote as cells, and the type handed out reads each through to what it is
// bound to: a type value is walked by readers that take a variable for a
// variable (a helper's sig, a scheme's quantifier), and a written name is
// never one.
fn named_type(name: String, decl) = match decl {
  Some(d) => match graph_published(d) {
    Some((scheme, _, _)) => match judgment_ty(scheme) {
      TAlias(an, inner) => {
        each(read_written_rows(??, Declared(an)), written_cells(inner))
        TAlias(an, chase_deep(inner))
      },
      _ => TName(name, []),
    },
    None => TName(name, []),
  },
  None => TName(name, []),
}

fn quantify_tparam_list(params, qmap, owner) = if len(params) == 0 {
  ([], qmap)
} else {
  let p0 = list_index(params, 0)
  match quantify_ctor_ty(param_ty(p0), qmap, owner) {
    (pty2, q1) => match quantify_tparam_list(slice(params, 1, len(params)), q1, owner) {
      // default→None is a DELIBERATE quantification reset (NOT a Carried-Truth
      // drop): a generalized ctor scheme carries no call-site default. The other
      // four aspects are projected live; only the default slot is cleared.
      (rest2, q2) => (
        [TParam(param_name(p0), pty2, param_authored(p0), param_resolved(p0), None, param_row(p0))] ++ rest2,
        q2
      ),
    },
  }
}

fn quantify_field_list(fields, qmap, owner) = if len(fields) == 0 {
  ([], qmap)
} else {
  match list_index(fields, 0) {
    (fname, fty) => match quantify_ctor_ty(fty, qmap, owner) {
      (fty2, q1) => match quantify_field_list(slice(fields, 1, len(fields)), q1, owner) {
        (rest2, q2) => ([(fname, fty2)] ++ rest2, q2),
      },
    },
  }
}

fn qmap_find(qmap, name: String) = if len(qmap) == 0 {
  None
} else {
  match list_index(qmap, 0) {
    (n, h) => if n == name { Some(h) } else { qmap_find(slice(qmap, 1, len(qmap)), name) },
  }
}

// Every value CONSTRUCTION lowers to alloc + stores, so the judgment
// charges what the lowering performs (the sugar-charge law at the value
// layer). Measured before the charge existed (2026-08-01, the four-face
// and ctor probes): tuple/list/record literals AND payload ctors all
// published Pure while allocating — a false `with Pure` proof at every
// literal, and the real-time `!Alloc` teaching unsound against them.
// Presents, no edges (values — freshness moot); nullary tags and the
// tuple-const READ charge nothing (immediate words, no allocation).
fn construction_row() = mk_ef_closed([ENamed(intern_str("Memory")), ENamed(intern_str("Alloc"))])

// A PRODUCT'S CHARGE: the record it builds, where it builds one. A tuple
// literal and a fanout each answer a product, and a consumer that takes the
// product apart where it stands — a one-arm positional destructure, the
// N-ary stage a `|>` fills — reads its parts out of registers, so nothing is
// built and nothing is charged. The lowering reads the SAME facts
// (`destructure_subs`, `product_fills_stage`) to bind those registers, which
// is what keeps the row and the emit from disagreeing about the cost.
fn charge_product(handle) = match product_fate(handle) {
  PfConsumed => (),
  PfByPipe => (),
  PfEscapes => inf_add_row_at(handle, construction_row()),
}

fn register_one_variant(type_name: String, result_ty, qhandles, field_types, variant, tag_id, total) = match variant {
  (ctor_name, _, vnode) => {
    // H2.3 nominal record: a single-variant type whose body is a
    // TRecord registers as RecordSchemeKind, not ConstructorScheme.
    // The env entry binds the type's name to TName directly (no
    // function arrow); NamedRecordExpr inference reads the
    // RecordSchemeKind to validate and lower constructions.
    // The record-payload probe under an explicit guard: list_index(_, 0) on a
    // ZERO-field variant is out of bounds, and the eager `&&` ran it for every
    // nullary ctor (None, Leaf, EtClosed…) — silent garbage into is_record_ty,
    // surfaced by the bounds trap. The control-flow guard is valid under BOTH
    // lowerings, which the bootstrap requires: an m2 body compiled by the
    // still-eager boot carries the checked list_index in the same binary.
    let single_record_payload = if total == 1 && len(field_types) == 1 && ctor_name == type_name {
      is_record_ty(list_index(field_types, 0))
    } else {
      false
    }
    // The variant's own node carries what the name declares, so the caret at
    // a constructor reads its type (it read `Circle : a`, a cell the parser
    // minted and nothing judged).
    let declared = if single_record_payload { result_ty } else { ctor_type(result_ty, field_types) }
    bind_declared(vnode, declared, ctor_name)
    if single_record_payload {
      match list_index(field_types, 0) {
        TRecord(declared_fields) => env_extend(
          ctor_name,
          Frozen(qhandles, declared),
          Declared(ctor_name),
          RecordSchemeKind(declared_fields),
          vnode
        ),
        // is_record_ty above proves TRecord — the impossible branch (SYNTAX
        // §exhaustiveness); the refutable let-destructure that stood here was
        // the census's own "misses 13 of 14" finding, true by the law.
        _ => (),
      }
    } else {
      env_extend(
        ctor_name,
        Frozen(qhandles, declared),
        Declared(ctor_name),
        ConstructorScheme(tag_id, total),
        vnode
      )
    }
  },
}

// A constructor's type: its result alone when it has no field, else the
// arrow from its fields — which carries the construction row, since the
// variant record allocates and the call path charges it through the one-way
// crow read like any callee (the ctor-probe face: payload_ctor published
// Pure under the mk_ef_pure arrow).
fn ctor_type(result_ty, field_types) = if len(field_types) == 0 {
  result_ty
} else {
  TFun(build_ctor_params(field_types, 0), result_ty, construction_row())
}

// A declaration's node carries what it declares, bound where the judgment
// registers it: a variant its constructor, an op its operation, a statement
// the unit it evaluates to. A declaration position nothing binds is a cell
// the parser minted and nothing judged.
fn bind_declared(node, ty, name: String) =
  graph_bind(node, ty, Located(graph_span_of(node), Declared(name)))

fn is_record_ty(ty) with Pure = match ty {
  TRecord(_) => true,
  _ => false,
}

fn build_ctor_params(field_types, base_idx) =
  map({ (i, ty) => mk_param("_{int_to_str(base_idx + i)}", ty) }, enumerate(field_types))

fn register_effect_ops(effect_name, params, ops, decl) = {
  // Register the effect name itself with its op names.
  // EffectDeclKind is the graph's vocabulary for "this is an effect
  // declaration carrying these ops." The world-chain dispatch reads it;
  // the Cursor can project it at any position mentioning the effect.
  // The SCHEME is the effect's INSTANCE SIGNATURE — the declared
  // params' types as a tuple (`effect Sample(rate: Int)` publishes
  // TTuple([Int])), the one home every authored `Sample(44100)`
  // instance judges its args against; a bare effect publishes the
  // empty tuple. The formerly-empty tuple here was a placeholder.
  let op_names = map({ (n, _, _, _) => n }, ops)
  let tps = build_param_types(params)
  env_extend(
    effect_name,
    Frozen([], TTuple(map(param_ty, tps))),
    Declared(effect_name),
    EffectDeclKind(op_names, map(param_name, tps)),
    decl
  )
  // THE EFFECT'S COMPLETE TYPE-VAR STRUCTURE: the free type vars across ALL
  // its ops' signatures (params + returns), deduped — the effect's type
  // params. An effect whose ops are all CONCRETE has zero vars → bare
  // ENamed (no payload, no spurious unification). Every op shares ONE row —
  // EParameterized(E, the vars) — so yield(a)/result() both carry Iterate(a)
  // (the SAME a); the install unifies the whole instance per-position. This
  // is per-EFFECT-instance carrying ALL its vars — NOT one-payload-per-effect.
  // Quantify the ops' lowercase type-var leaves (the case rule) BEFORE reading
  // their free vars. Raw, `yield(element)`'s `element` is a TName leaf;
  // effect_type_vars finds no var; Iterate stays a bare ENamed; the payload
  // type never flows performer→handler, so every collector handler (map/fold/
  // iterate's buffer) goes `[free]` and the iteration machinery ERASES the
  // element — the §4① value-ontology violation at the effect boundary, and the
  // root of both the list-as-Int erasure and the emitter's heap-dump.
  // A `-> !` result is quantified per PERFORM, never at the effect: the
  // effect's parameters are the variables its ops NAME (the qmap), and the
  // never type names none — it mints a fresh variable per occurrence. Only
  // the op's own scheme quantifies it, so each perform instantiates its own,
  // which is sound exactly because a `-> !` op never resumes
  // (`EResumeOfNever`). Made the effect's parameter, it rode every row in
  // the program as `WASI(a)` and joined two performs at two result types.
  let quantified = quantify_effect_ops(ops)
  let qops = quantified.ops
  let eff_vars = qops |> effect_type_vars |> unique |> filter(var_is_named(quantified.named, ??))
  let enh = intern_str(effect_name)
  // The instance's VALUE dimensions — one opaque node per declared effect
  // param (`effect Sample(rate: Int)` carries one), FIRST so an authored
  // instance's args (`Sample(48000)` — declared-param positions) align
  // position-wise with the charge's. EANode by design: eparam_arg_tys
  // skips it, so the type-space install flow (handler payload arity,
  // unify_op_payload, instances_in_row) never meets a value dim;
  // free_in_eff_arg answers [], so it never quantifies and rides
  // instantiation verbatim; the declared gate's pin
  // (pin_declared_instances) is its one writer. Deriving the instance
  // from op type vars ALONE minted a bare ENamed for a concrete-op
  // value-parameterized effect, so every charge erased the instance
  // identity the row algebra distinguishes (SYNTAX §Parameterized
  // effect) — masked while the gate published the declared row verbatim,
  // exposed by the publish law (the inst-sibling fixture's record).
  let value_dims = map((_) => EANode(mint(Inferred("effect '{effect_name}' value dim"))), params)
  let eff_name = if len(params) == 0 && len(eff_vars) == 0 {
    ENamed(enh)
  } else {
    EParameterized(enh, value_dims ++ map((v) => EAType(TVar(v)), eff_vars))
  }
  each((op) => register_one_op(effect_name, eff_name, op), qops)
}

// The free type vars across all an effect's ops' signatures — the effect's
// type-parameter set (the instance's polymorphic dimensions).
//
// quantify_effect_ops — convert each op's lowercase TName leaves to quantified
// TVars, sharing by NAME across the effect's ops (so `get() -> s` and
// `set(v: s)` share the one `s`) via a threaded qmap. The SAME quantify_ctor_ty
// the type-constructor path uses — one case-rule primitive for ctors AND effect
// ops (Mentl solves Mentl). Uppercase leaves (`Int`) stay nominal, so Memory's
// `load_i32(Int)` correctly does NOT parameterize.
fn quantify_effect_ops(ops) = match quantify_effect_ops_loop(ops, [], 0) {
  (qops, qmap) => {named: map(qmap_handle, qmap), ops: qops},
}

fn qmap_handle(entry) = match entry {
  (_, h) => h,
}

// A variable the effect's ops named (or a stored function's row tail they
// wrote): every one but the never type's.
fn var_is_named(named, v) = any({ n => n == v }, named)

fn quantify_effect_ops_loop(ops, qmap, i) = if i >= len(ops) {
  ([], qmap)
} else {
  match list_index(ops, i) {
    (name, params, rty, cn) => match quantify_ty_list(map(param_ty, params), qmap, Declared(name)) {
      (qptys, q1) => match quantify_ctor_ty(rty, q1, Declared(name)) {
        (qrty, q2) => match quantify_effect_ops_loop(ops, q2, i + 1) {
          (rest, q3) => ([(name, map(requantified_param, zip(params, qptys)), qrty, cn)] ++ rest, q3),
        },
      },
    },
  }
}

// The param keeps its authored name; only its type is re-minted.
fn requantified_param(pq) = match pq {
  (p, qty) => mk_param(param_name(p), qty),
}

fn effect_type_vars(ops) =
  ops |> map({ (_, params, rty, _) => free_in_params(params) ++ free_in_ty(rty) }) |> flatten

// VARIANCE at the op's result. A parameter's unannotated fn-type row is a
// VAR on purpose — the effect-polymorphic flow channel `map`'s function
// parameter needs, and masking it convicted 297 wheel sites in one march.
// A RESULT is the
// other direction: nothing flows in, so a var there is not a channel but an
// unstated promise, and the arm that produces the value teaches the
// declaration its row instead of meeting it. Measured 2026-08-18: a closure
// performing E, resumed out and called under `with !E`, checked clean and
// ran; writing `with Pure` on the same return made it refuse. Capping the
// result's own row closes that by construction. No op in src or lib returns
// a fn type, so the crucible pair is this rule's only oracle.
// STRUCTURAL, because the whole result is covariant and a closure hides in
// any of its containers: `give() -> [() -> Int]` and `give() -> (Int, () ->
// Int)` both leaked while the bare `give() -> (() -> Int)` refused
// (measured 2026-08-18 — the first cut matched only a top-level TFun).
// A returned fn's own RESULT is covariant too and recurses; its PARAMS are
// contravariant — a demand on whoever calls it — and keep their vars.
// TOTAL over Ty, with no catch-all, and that totality is the fix rather
// than a style. Three cuts of this walk each shipped a hole a probe then
// found: first only a top-level TFun (a list and a tuple leaked), then the
// three containers (an alias and a variant payload leaked). A `_ => t` arm
// over a load-bearing ADT is exactly the residue the audit names, and here
// it silently answered "nothing to cap" for every shape nobody had thought
// of yet. Enumerated, a new Ty constructor cannot compile until someone
// decides what it means for a result.
//
// TName is a NOMINAL type and its payloads live on the constructors'
// schemes, registered elsewhere — capping its args would cap type
// ARGUMENTS, which is the wrong altitude. The variant-payload leak is real
// and belongs at the type declaration: `Hβ.effects.variant-payload-fn-row`.
fn cap_result_fn_row(t) = match t {
  TFun(ps, r, row) => {
    let capped = if row_cap_form(row) { row } else { mk_ef_pure() }
    TFun(ps, cap_result_fn_row(r), capped)
  },
  TList(e) => TList(cap_result_fn_row(e)),
  TTuple(es) => TTuple(map(cap_result_fn_row, es)),
  TRecord(fs) => TRecord(map(cap_result_field, fs)),
  TRecordOpen(fs, v) => TRecordOpen(map(cap_result_field, fs), v),
  TAlias(n, inner) => TAlias(n, cap_result_fn_row(inner)),
  TRefined(inner, p) => TRefined(cap_result_fn_row(inner), p),
  TReprPin(r, inner) => TReprPin(r, cap_result_fn_row(inner)),
  // A continuation's own R and S are the resume boundary, typed by the
  // typed-resume law at the arm; the result cap has no business rewriting
  // them.
  TCont(a, b, d, w) => TCont(a, b, d, w),
  TName(n, args) => TName(n, args),
  TVar(h) => TVar(h),
  TInt => TInt,
  TFloat => TFloat,
  TUnit => TUnit,
  TByte => TByte,
  TAddr => TAddr,
}

fn cap_result_field(f) = match f {
  (n, ft) => (n, cap_result_fn_row(ft)),
}

// An op's scheme names each parameter: the author's name where one was
// written, the positional `_0`, `_1` a constructor's fields take where the
// op wrote a bare type.
fn op_scheme_param(ip) = match ip {
  (i, p) => if param_name(p) == "_" { mk_param("_{int_to_str(i)}", param_ty(p)) } else { p },
}

fn register_one_op(effect_name, eff_name, op) = match op {
  // The fourth field is the op's own NTypeAnn node, minted at its span by
  // parse_effect_ops — so the site that must be renamed has a real span here
  // and a diagnostic never has to reach for span_zero.
  (op_name, op_params, raw_ret_type, op_node) => {
    let ret_type = cap_result_fn_row(raw_ret_type)
    let params = map(op_scheme_param, enumerate(op_params))
    // Every op of the effect carries the SAME instance row (eff_name), so the
    // payload flows performer→handler at the install. Generalize over the
    // op's free vars INCLUDING the instance's (free_in_row) ⇒ each op USE is a
    // fresh effect instance the handle reconciles to the handler's.
    let row = mk_ef_closed([eff_name])
    let qvars = unique(free_in_params(params) ++ free_in_ty(ret_type) ++ free_in_row(row))
    // ONE NAME, TWO KINDS. The env is append-only and read last-write-wins,
    // and the op re-registers after the entry module's own declarations, so
    // a user fn of the same name loses silently. This write is the one place
    // both claims are present; no reading site can see it, because by the
    // time a reader looks one kind has already won.
    // The span is the LOSING declaration's own, read from the Reason the
    // env stored when it was registered — the fn is the thing to rename.
    // EXHAUSTIVE over SchemeKind, because `_ => ()` here is the silent skip
    // that let the op-vs-op collision through: this arm read the FnScheme pair
    // and dropped the other eight, at the one site whose own comment says both
    // claims are present. Every kind is decided below, and the ones that
    // report nothing say why rather than falling into a wildcard.
    match env_lookup(op_name) {
      Some(prior) => match prior {
        (_, prior_reason, prior_kind) => match prior_kind {
          FnScheme | ValueScheme => match prior_reason {
            Located(fn_span, _) => report(EFnShadowsOp(op_name, effect_name, fn_span)),
            _ => (),
          },
          // A DIFFERENT effect already claims this name. The env holds one
          // entry per name, so this write replaces rather than joins, and
          // every prior call retypes. Same effect re-registering (the final
          // pass walks the decls again) is the same op and says nothing.
          EffectOpScheme(prior_effect, _, _, _) => if prior_effect == effect_name {
            ()
          } else {
            report(EOpShadowsOp(op_name, prior_effect, effect_name, graph_span_of(op_node)))
          },
          // A handler NAME beside an op name is measured harmless: they
          // resolve in disjoint positions (`~> h` installs, `h()` performs),
          // so both entries are reachable and neither shadows the other.
          HandlerKind(_, _, _, _, _) => (),
          // A chain's name stands where a handler's does, at `~>`, and
          // nowhere an op's does.
          HandlerChainKind(_) => (),
          // Uppercase by the case rule (SYNTAX §«Generic type parameters» —
          // nominal types and constructors are capitalized, ops are not), so
          // an op name can never collide with one of these.
          ConstructorScheme(_, _) => (),
          RecordSchemeKind(_) => (),
          EffectDeclKind(_, _) => (),
          TypeVariants(_) => (),
          RowAliasKind(_) => (),
          // A parameter binding is scoped to its own fn and cannot stand as
          // the prior claim on a top-level op registration.
          ParamScheme(_) => (),
        },
      },
      None => (),
    }
    // The op's own node carries the operation it declares (bind_declared).
    bind_declared(op_node, TFun(params, ret_type, row), op_name)
    env_extend(
      op_name,
      Frozen(qvars, TFun(params, ret_type, row)),
      Declared(op_name),
      // OneShot is the join identity (grade UZero → OneShot): an op with no
      // handler stays the fast path; each handler's arm joins its grade in.
      EffectOpScheme(effect_name, None, false, OneShot),
      op_node
    )
  },
}

// The handler's effect name, read LIVE from the op→effect edge (§2 follow-the-
// edge): each arm handles an op, and that op's EffectOpScheme carries the effect
// that declared it. The parser names no effect (leaves ename ""), so reading the
// real name here is what makes the whole instance flow — unify_op_payload (the
// arm half) and unify_install_payload (the `~>` half) — key on the true effect
// `Iterate` instead of a blank `""` that matches nothing (the m3 concat floors:
// the accumulator's fragments never found each other through a nameless
// instance). Falls back to the handler's own name when it is its own effect's
// sole declaration (Hβ.infer.handler-effect-name-is-live-edge, now live).
// The FULL handled set — every distinct effect the arms touch, as EffNames.
// A handler may absorb several effects (multieffect's buffer handles Emit AND
// Collect); the install's subtraction takes the whole set — subtracting only
// derive_handler_ename's single pick left the sibling effect on the caller's
// row (the false E_EffectUnhandled on an absorbed effect).
fn derive_handler_enames(arms, i, own acc) = if i >= len(arms) {
  acc
} else {
  let acc2 = match env_lookup(handler_arm_op_name(list_index(arms, i))) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        EffectOpScheme(en, _, _, _) => {
          let enn = ENamed(intern_str(en))
          if name_set_contains(acc, enn) { acc } else { push(acc, enn) }
        },
        _ => acc,
      },
    },
    None => acc,
  }
  derive_handler_enames(arms, i + 1, acc2)
}

// THE HANDLER IS EXHAUSTIVE OVER EVERY EFFECT ITS ARMS ANSWER — the
// match-exhaustiveness law at a handler (SYNTAX §Handler declarations). An
// install subtracts from its body's row the effects its arms answer, by
// name, so the subtraction is exact only when every op of each such effect
// has an arm: a perform of an op with no arm walks past the install at
// runtime and reaches whatever is outside it, which the row never saw.
// Measured 2026-09-30 (tests/micros/mn-handler-partial-refuses.mn): a
// handler answering one op of a two-op effect, installed under a declared
// negation of that effect, compiled clean and trapped reading the evidence
// at the root. A handler that means to answer
// some ops of an effect forwards the rest — an arm performing its own op
// resolves to the enclosing handler, and the row carries it — or declares
// the ops it answers as their own effect. Judged at the walk's registration,
// where every effect's op list is in the env whatever the source order.
fn handler_exhaustive_check(hname: String, arms, span: ValidSpan) = each(
  {
    en => match handler_missing_ops(en, arms) {
      [] => (),
      missing => report(EHandlerInexhaustive(hname, en, missing, span)),
    },
  },
  handler_effect_names(arms)
)

// The distinct effects a handler's arms answer, in arm order.
fn handler_effect_names(arms) = fold([], handler_effect_names_step, arms)

fn handler_effect_names_step(acc, arm) = match op_effect_of(handler_arm_op_name(arm)) {
  Some(en) => if string_in_list(acc, en) { acc } else { push(acc, en) },
  None => acc,
}

// The effect's declared ops no arm answers.
fn handler_missing_ops(en: String, arms) = filter(
  { op => !any({ arm => field_name_eq(handler_arm_op_name(arm), op) }, arms) },
  effect_op_names(en)
)

// An effect declaration's ops in declaration order — the order a handler's
// arm region is laid out in — read off its env entry. Effects register after
// types, so the effect answers where a type shares its name (`effect Sample`
// beside `type Sample`); a name no effect declares has no ops, which is the
// honest answer, never a fabricated list.
fn effect_op_names(en: String) = match env_lookup(en) {
  Some(entry) => match entry {
    (_, _, EffectDeclKind(ops, _)) => ops,
    _ => [],
  },
  None => [],
}

// What a handler answers, read off the scheme it published: the second
// argument of its `Handler` type, under the config arrow when the handler
// takes config — ground once an arm's own value bound it, a variable while
// every arm resumes and the answer is each install's body's. `mentl where`
// renders it beside what the arms absorb.
fn handler_answer_of(hname: String) = match env_lookup(hname) {
  Some(entry) => match entry {
    (scheme, _, kind) => match kind {
      HandlerKind(_, _, _, _, _) => match scheme {
        Frozen(_, body) => handler_answer_ty(body),
        _ => None,
      },
      _ => None,
    },
  },
  None => None,
}

// The answer cell a pre-registration minted for a handler
// (`pre_register_handler_sig`): its answer while it is still that variable.
fn prereg_answer_cell(hname: String) = match handler_answer_of(hname) {
  Some(TVar(a)) => Some(a),
  Some(_) => None,
  None => None,
}

fn derive_handler_ename(arms, fallback: String) = if len(arms) == 0 {
  fallback
} else {
  match env_lookup(handler_arm_op_name(last(arms))) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        EffectOpScheme(en, _, _, _) => en,
        _ => derive_handler_ename(drop_last(arms), fallback),
      },
    },
    None => derive_handler_ename(drop_last(arms), fallback),
  }
}

fn register_handler(hname, ename_parsed, config, state, arms, effs, span: ValidSpan, decl) = {
  // The handler's identity (effect, instance, config, HandlerKind) was registered
  // at pre_register_handler_sig — a parsed fact, not an inferred one. The main
  // walk reads the pre-registered r_handle from the env so forward references
  // that resolved against the pre-registered HandlerKind share the same residual
  // row handle. Fresh instance vars and config tparams are minted here for the
  // arm inference; the pre-registered scheme is overwritten by env_extend below
  // and again at re-generalization after the arms.
  let ename = derive_handler_ename(arms, hname)
  handler_exhaustive_check(hname, arms, span)
  let inst_vars = mint_instance_vars(ename, effect_instance_arity(ename), 0)
  let inst_ty = TName(ename, map(TVar, inst_vars))
  let inst_h = mint(Inferred("effect '{ename}' instance"))
  graph_bind(inst_h, inst_ty, Inferred("effect '{ename}' instance"))
  // The cell every arm's value is judged into: an arm answers its install,
  // so this is the second argument of the handler's type, and generalized
  // with it after the arms, each install meets it with its body's answer.
  // READ off the pre-registered type, as `r_handle` and `w_handle` are read
  // below — one cell, minted once — so a forward reference judged against
  // the pre-registered scheme and the arms meet the same answer; a handler
  // declared inside a body was never pre-registered and mints its own.
  let s_h = match prereg_answer_cell(hname) {
    Some(a) => a,
    None => mint(Inferred("handler result of '{hname}'")),
  }
  let handler_ty = TName("Handler", [inst_ty, TVar(s_h)])
  let config_tparams = build_param_types(config)
  let scheme_body =
    if len(config) == 0 { handler_ty } else { TFun(config_tparams, handler_ty, mk_ef_closed([])) }
  // Bind the scheme body to a handle so it can be RE-GENERALIZED after the arms
  // run: the arms unify the instance's result position with the state and the
  // config (fold_handler's `acc = init` and `resume(acc)` join r_h ~ acc ~
  // init). A scheme quantified BEFORE the arms (Frozen(inst_vars, ...)) misses
  // the config tparams and predates those unifications, so `fold`'s init / f-arg
  // / return never share a var — the accumulator floors at `acc ++ xs`. generalize
  // chase_deeps to roots and quantifies EVERY free var, so post-arms it collapses
  // the unified positions to one — the caught-up caller threads.
  let scheme_body_h = mint(Inferred("handler scheme of '{hname}'"))
  graph_bind(scheme_body_h, scheme_body, Inferred("handler scheme of '{hname}'"))
  // The handler's residual row R. READ the pre-registered r_handle from the env
  // so forward references share the same residual row — the row algebra at ~>
  // sites that resolved before this decl in source order uses THIS handle.
  // Carried-Truth: the handle was minted once at pre_register; read it live.
  let r_handle = match env_lookup(hname) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        HandlerKind(r, _, _, _, _) => r,
        _ => graph_fresh_row(Inferred("residual of handler '{hname}'")),
      },
    },
    None => graph_fresh_row(Inferred("residual of handler '{hname}'")),
  }
  // The remainder world, read the same way: a handler declared inside a body
  // was never pre-registered, so it mints its own here.
  let w_handle = match env_lookup(hname) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        HandlerKind(_, w, _, _, _) => w,
        _ => graph_fresh_row(Inferred("the remainder a resume of '{hname}' runs")),
      },
    },
    None => graph_fresh_row(Inferred("the remainder a resume of '{hname}' runs")),
  }
  env_extend(
    hname,
    Frozen(inst_vars ++ [s_h], scheme_body),
    Declared(hname),
    HandlerKind(r_handle, w_handle, config_tparams, state, arms),
    decl
  )
  // Resume cardinality IS written here, on the op's EffectOpScheme (draw_op_edges
  // below joins each arm's resume_grade). The body IS the contract, so the
  // cardinality is inferred from the arm body — but it is a TYPE-LEVEL fact (the
  // op's continuation multiplicity), so its home is the op's scheme in the graph,
  // NOT a hand-walk lower re-does per resume (the deleted infer_resume_cardinality
  // was that re-walk, at the wrong layer, over a broken immutable-buffer collector
  // that never accumulated its pushes — the mn-multishot dormancy). Inference is
  // the one writer; lower PROJECTS disc off the scheme (op_resume_discipline), the
  // way it projects repr off a type and world off a row. Not a side-ledger: the
  // scheme is the op's type home, the one graph. STEP 5's TCont carries the same
  // disc for cross-context unification (E_ResumeWorldMismatch) — peer
  // Hβ.types.tcont-carries-cardinality-and-world.
  // Typed-resume arm typing (SYNTAX §Effect declarations): every arm
  // body walks under the law with one per-decl handle-result S.
  // Config params bind through the SAME TParam handles the scheme
  // carries (install-site args constrain arm-body usage through them);
  // state fields bind to their init expressions' inferred types — the
  // graph already knows them, fresh vars would discard that.
  // Config params bound FIRST — before the state inits are inferred — so a
  // state init that references a config param (`with acc = init`) READS the
  // live config, not an unbound name flooring to a fresh var. That
  // read-before-bind disconnected fold's accumulator acc from its `init`
  // config: fold's type became four separate vars (init / f-param / f-result /
  // return), the lambda's acc never resolved to a list, and `acc ++ xs`
  // floored (the m3 concat census). One outer env scope holds config + state
  // for every arm; per-arm scopes isolate only the op params.
  env_scope_enter()
  let config_cells = bind_handler_config_params(config, hname)
  // Accumulate the arms' residual row R into r_handle: inferring each arm
  // body under this row scope routes every effect it performs (incl. a call
  // to a function-valued config arg) into r_handle via inf_add_effect/
  // inf_add_row. On
  // exit, r_handle binds to R — the row `~> h` adds to the caller.
  inf_enter_fn(r_handle, span, effs)
  // The remainder world is part of the handler's signature: a lambda in an
  // arm carries it out of its own frame, and the completion prune keeps what
  // the signature names.
  inf_frame_params(config ++ [s_h, w_handle])
  // EVERYTHING THE INSTALL EVALUATES BELONGS INSIDE THIS SCOPE — the config
  // DEFAULTS and the state INITS both, because both run where the arms' own
  // effects run: at the install, in the installer's world. Judged outside it
  // their rows landed on whatever frame was judging the DECL and reached no
  // installer at all. Both were measured leaking the same way, one field
  // apart: `handler hf with s = op()` and `handler hf(k: Int = op())`, each
  // installed by `fn bad() with !E = (g()) ~> hf`, checked clean while the
  // expression genuinely performed E — give `op` a handler returning 7 and
  // the value arrives, exit 7. SYNTAX's tee rule already carries this: they
  // are parts of the handler, so their rows are part of row(h), and r_handle
  // is where row(h) is accumulated
  // (`Hβ.effects.handler-state-init-row-never-installed`).
  //
  // A config DEFAULT is still typed at its one home — the handler's own
  // parameter scope (SYNTAX §«Default parameter values»: one home, the
  // signature node; one evaluation context, the callee). The bare `~> h`
  // install has no call node to splice the default through, so the decl is
  // the scope that grounds it, and an omitting explicit install (`~> h()`)
  // re-infers the spliced node at its site through resolve_call_args.
  each(
    (p) => match param_default(p) {
      Some(d) => {
        infer_expr(d)
        let dsp = graph_span_of(d)
        unify_types(TVar(d), param_ty(p), dsp, DefaultReason(param_name(p), dsp))
      },
      None => (),
    },
    config_tparams
  )
  infer_handler_state_inits(state)
  bind_handler_state_names(state, arms, hname)
  // The arms store into the state their install allocated, and an install
  // answers for it (`ages_install`), as it answers for the config it hands
  // the arms (`install_mutation`).
  ages_open(AgeArm(hname, map(state_field_init, state), config_cells))
  each(
    (arm) => {
      env_scope_enter()
      // drift-audit: ignore — s_h (arm result) and inst_h (effect instance) are distinct, not parallel arrays
      infer_one_handler_arm(arm, s_h, inst_h, w_handle)
      never_resume_check(hname, arm)
      env_scope_exit()
    },
    arms
  )
  ages_close_arms(decl, config_cells)
  // The arm scope's SIGNATURE is the handler's config cells + its result:
  // an arm's call into a config fn charges a judgment-era row edge that
  // escapes through the scheme at every install (the config tparam rides
  // the published TFun), so the completion prune's signature keep applies
  // here exactly as at a named decl's exit — with an empty keep the
  // residual dropped the config-fn edge and folded nothing (measured:
  // zero residual edges on the leak-handler-residual crucible).
  //
  // The REMAINDER WORLD leaves the residual before it is published. A held
  // resume charges it into the frame it stands in, so the arms' row reaches
  // it whenever a resume runs in an arm or in a callee the arm hands one
  // to; but the remainder is the installed body's own, counted at each
  // install as the body minus what this handler absorbs, and left in the
  // residual it would reach every installer as a free edge and carry the
  // handler's own clause onto the remainder (A5 already judges that clause
  // against each remainder, and a cap on the arms is not a cap on the body).
  inf_cut_edge(w_handle)
  let declared_effs = exit_frame()
  env_scope_exit()
  // The handler's own `with` row, judged exactly as a fn's at its exit (one
  // path for fns and handlers): the arms' row against the clause, the
  // negation gated onto the row's free terminals — and, for the install
  // sites, the negation half stored on the residual cell itself, where the
  // tee reads it against each remainder (A5).
  enforce_handler_clause(hname, declared_effs, r_handle, span)
  // Re-store the handler's scheme now that the arms have unified the instance's
  // result position with the state and config (r_h ~ acc ~ init). generalize
  // chase_deeps scheme_body to its roots and quantifies every free var, so the
  // config tparams and instance positions the arms joined collapse to shared
  // vars — a caller's `~> h(args)` freshens them consistently and the accumulator
  // threads. The Frozen(inst_vars, ...) bound before the arms is the pre-arms
  // scheme a recursive arm reference resolves against; this re-store carries the
  // arms' unifications the caller reads (Carried-Truth: read the grounded roots).
  env_extend(
    hname,
    generalize(scheme_body_h),
    Declared(hname),
    HandlerKind(r_handle, w_handle, config_tparams, state, arms),
    decl
  )
  // Draw the op→handler edge onto each op's EffectOpScheme HERE — in the body,
  // OUTSIDE the arm `each` and inf_enter_fn's InferCtx install. An env_extend
  // performed inside those (an arm-internal perform) never reaches the outer
  // env_handler and silently vanishes before lower (the not-yet-substrate gap,
  // prelude.mn); the same env_extend at this body level persists, exactly as the
  // HandlerKind bind above does. `arms` are read via handler_arm_op_name, whose
  // annotated param type resolves op_name from any context (no in-scope type
  // closure needed). The op binding IS the dispatch fact — lower reads it to cash
  // a non-lexical perform of a uniquely-handled op to a direct call of its arm.
  draw_op_edges(arms, decl)
}

// Recur over a handler's arms, drawing op→handler onto each op's EffectOpScheme.
// A top-level recursive definition, never an each-lambda, so the env_extend
// writes through a fn body and reaches env_handler. `hd` is the handler's own
// declaration, so the edge is drawn to the node and no reader resolves its
// name again.
fn draw_op_edges(arms, hd) = if len(arms) == 0 {
  ()
} else {
  let arm = last(arms)
  let op_name = handler_arm_op_name(arm)
  // The arm's resume cardinality, read off the arm's parse structure
  // (`arm_grade` — the ResumeUse fold), JOINED onto the op's scheme. This
  // is the write: cardinality is inference's, carried on the op's type, read
  // live by lower — no second hand-walk at lower. The join is monotone
  // toward MultiShot, so a re-drawn arm only ever raises disc.
  let grade = arm_grade(arm)
  match env_resolve(op_name) {
    Some(decl) => match graph_published(decl) {
      Some((scheme, reason, kind)) => match kind {
        EffectOpScheme(ename, cur_default, ambiguous, cur_disc) => {
          // An arm that never resumes ABANDONS: its value is the install's,
          // delivered by the driver (the arm returns without calling k and
          // the loop exits flag-clear with it), whatever the op's declared
          // return — `arm_disc_of` carries the record of the bottom-return
          // hedge this replaced.
          let arm_disc = arm_disc_of(grade)
          let disc = disc_join(cur_disc, arm_disc)
          match default_joined(cur_default, ambiguous, hd) {
            (nd, na) => env_extend(
              op_name,
              scheme_with_disc_cost(scheme, disc),
              reason,
              EffectOpScheme(ename, nd, na, disc),
              decl
            ),
          }
        },
        _ => (),
      },
      None => (),
    },
    None => (),
  }
  draw_op_edges(drop_last(arms), hd)
}

// The op's handler once `hd` declares an arm for it: the first handler to
// name the op is its default, a second distinct one makes it ambiguous, and
// the same handler again, or an already-ambiguous op, changes nothing.
fn default_joined(cur, ambiguous, hd: Int) = match cur {
  None => if ambiguous { (cur, true) } else { (Some(hd), false) },
  // A handler an edit replaced is no handler of the op: its next version
  // takes its place rather than making the op ambiguous.
  Some(d) => if graph_node_current(d) {
    (cur, ambiguous || d != hd)
  } else {
    default_joined(None, ambiguous, hd)
  },
}

// A MultiShot op's row carries the remainder record. The perform site
// reifies the continuation as a heap record (LMakeContinuation, through the
// one allocator), so performing the op IS an allocation, and the row says
// so — `!Alloc` over a two-resume op refuses
// (tests/micros/mn-multishot-perform-alloc.mn, which compiled clean while
// the row read Pure: a false absence proof at a shape the crown never
// wrote). The row is the one home every reader already reads — the call
// site, the address surface, the root gate — so no site charges it twice;
// the union is idempotent, so a re-drawn arm never doubles it.
fn scheme_with_disc_cost(scheme, disc) = match disc {
  MultiShot => match scheme {
    Frozen(q, ty) => Frozen(q, ty_with_row_added(ty, construction_row())),
    Live(h) => Live(h),
  },
  OneShot => scheme,
  Abandon => scheme,
}

fn ty_with_row_added(ty, extra) = match ty {
  TFun(ps, ret, row) => TFun(ps, ret, union_row(row, extra)),
  other => other,
}

// Walk each state field's init ONCE per decl; the init's inferred
// type IS the field's type in arm scope.
fn infer_handler_state_inits(state) = each({ sf => infer_expr(state_field_init(sf)) }, state)

// A config parameter is a parameter node like a function's, the cell its
// install's argument fills: its name is declared where it is written, and
// its references link there. The cells come back in order, for the arms'
// age scope.
fn bind_handler_config_params(config, hname: String) = {
  declare_param_binders(config, hname)
  config
}

fn bind_handler_state_names(state, arms, hname) = {
  let updates = arms |> flat_map(arm_updates)
  updates |> each(link_update(state, ??))
  state |> each(bind_handler_state_name(updates, hname, ??))
}

// The field an update writes resolves once, among its handler's state
// fields, where the name was typed, and its node is linked to the field's
// binder. An update naming no field writes nothing anything reads, so it is
// refused, never dropped: `resume(0) with m = n + 1` beside `with n = 0`
// compiled clean and `n` stayed 0 (pin 53f7404b).
fn link_update(state, upd) = match find({ sf => state_field_name(sf) == state_field_name(upd) }, state) {
  Some(sf) => graph_ref_link(state_field_node(upd), state_field_node(sf)),
  None => report(EMissingVariable("state field: {state_field_name(upd)}", graph_span_of(state_field_node(upd)))),
}

// A state field is declared where its name is written, its binder the cell
// of its init, and the init is one of its values among the arms' writes —
// each update whose name links to it: noted before any arm is judged, so no
// claim an arm raises over the state reads it as its init alone.
fn bind_handler_state_name(updates, hname: String, sf) = {
  let name = state_field_name(sf)
  let nh = state_field_node(sf)
  let ih = state_field_init(sf)
  let why = Located(graph_span_of(nh), StateBinding(name, hname))
  graph_bind(nh, TVar(ih), why)
  env_extend(name, Frozen([], TVar(ih)), why, ValueScheme, nh)
  graph_binder_note(
    ih,
    StateFact({stores: [], writes: [ih] ++ (updates |> filter(writes_field(nh, ??)) |> map(state_field_init))})
  )
}

fn writes_field(nh, upd) = graph_ref_decl(state_field_node(upd)) == Some(nh)

// Every `resume … with` update in an arm's body, read off the one total
// child projection before the arm is judged.
fn arm_updates(arm) = subtree_updates(handler_arm_body(arm))

fn subtree_updates(h) = {
  let body = graph_node_body(h)
  let here = match body {
    NExpr(ResumeExpr(_, updates)) => updates,
    _ => [],
  }
  here ++ (body_child_handles(body) |> flat_map(subtree_updates))
}

// ─── Resume cardinality — the arm's continuation multiplicity (Usage) ─────
//
// resume_grade folds the arm body to its Usage grade (types.mn): each
// `resume` is UOne; sequential composition ⊗-combines (two resumes on ONE
// path → UMany → MultiShot); alternation ⊔-joins (disjoint branches → the
// join, so `if c {resume(a)} else {resume(b)}` stays UOne → OneShot — the
// ~85% direct-return fast path survives a branchy one-shot arm). This IS
// ownership's use-count (own.mn classify_usage) with `resume` as the counted
// use: cardinality and ownership are ONE lattice (types.mn Usage), arm 5 and
// the TIME axis reading the same value-multiplicity. ONE pure compositional
// fold over the arm structure infer just typed — no buffer, no O(N²)
// pairwise-disjoint scan, no second walk. (The deleted 12-fn collector used a
// Buffer whose push returned a NEW record the walk discarded, so pushes
// never accumulated: every arm classified 0-site → OneShot and the multi-shot
// producer stayed dormant — mn-multishot exit 10 not 30.) Drift refused: 1
// (structural fold, no vtable); 8 (Usage / ResumeDiscipline are ADTs, never
// counts-as-int). A continuation re-invoked by a passed lambda or a
// tail-recursive self-call reads as its STRUCTURAL grade — the named edge peer
// Hβ.infer.tail-recursion-resume-cardinality (the old walk was no better: it
// only detected a never-emitted NLoopExpr ancestor).
//
// An arm's grade sees the resumes of the functions it calls: a call to a
// function with a resume summary contributes it (`resume_grade`'s
// substitution), so an arm that hands `fold` a nested fn that resumes is a
// resuming arm, and backtrack's try_each, calling itself through a resuming
// lambda, saturates to RMany by its second round. A `resume` stands only
// inside an arm, so the only functions with a summary are the ones declared
// inside an arm, and each is in scope only there: an arm's summaries are a
// fixpoint over the functions its own body declares, which nothing outside
// it reads (`arm_grade`). Every other callee contributes the parameters it
// calls at its own tail, a parse fact of the program's top-level
// declarations (`program_tails`), whose names the link holds once each
// (real, 2026-10-16). The summaries were one table for the whole program
// keyed by name until then, so a local `let step` anywhere read a resuming
// nested fn's summary: the function holding it was graded as resuming, the
// lowering bound it to the handler by its spelling, and a correct program
// whose two handlers' arms called it was refused as an ambiguous resume
// (tests/micros/mn-resume-summary-is-the-arms.mn).
effect ResumeSummaries {
  summary_of(String) -> ResumeUse
  tail_params_of(String) -> [Int]
}

// One arm's summaries: the grade of a function its body declares, two of
// one name there joining theirs (either is the one a reference may reach),
// and the parameters a callee calls at its own tail — read off the arm's own
// declaration of the name first, the program's second.
handler arm_summaries(grades, decls, tidx) {
  summary_of(name) => resume(fold(RNone, join_named(name, ??, ??), grades)),
  tail_params_of(name) => resume(match find(declares(name, ??), decls) {
    Some((_, _, t)) => t,
    None => match smap_get(tidx, name) {
      Some(t) => t,
      None => [],
    },
  }),
}

fn join_named(name: String, acc, entry) = match entry {
  (n, g) => if n == name { resume_join(acc, g) } else { acc },
}

fn declares(name: String, decl) = match decl {
  (n, _, _) => n == name,
}

// An arm's resume grade: its body's, against the functions it declares and
// the program's tail facts. The one reader of an arm's discipline — the op
// edge it draws, the never-returning op it may not resume, the session's
// comparison of what a handler served.
fn arm_grade(arm) = {
  let body = handler_arm_body(arm)
  let decls = collect_fn_decls(body, [])
  let tidx = graph_tails()
  let grades = arm_rounds(decls, tidx, map(ungraded, decls))
  resume_grade(body) ~> arm_summaries(grades, decls, tidx)
}

fn ungraded(decl) = match decl {
  (n, _, _) => (n, RNone),
}

// The arm's declarations graded to their fixpoint: each round grades every
// one under the last round's grades, and the rounds climb a finite lattice,
// so they settle.
fn arm_rounds(decls, tidx, grades) = {
  let next = {
    decls |> map(classify_grade)
  } ~> arm_summaries(grades, decls, tidx)
  if next == grades { next } else { arm_rounds(decls, tidx, next) }
}

fn classify_grade(decl) = match decl {
  (n, b, _) => (n, resume_grade(b)),
}

// The parameters each top-level function of these statements calls only at
// its own tail (`tail_transparent_params`) — the one program-wide fact an
// arm's grade reads beside its own declarations.
fn program_tails(stmts) = flat_map(top_tails, stmts)

fn top_tails(s) = match graph_node_body(s) {
  NStmt(stmt) => match stmt {
    FnStmt(name, params, _, _, b) => [(name, tail_transparent_params(params, b))],
    LetStmt(_, _, _)
    | ExprStmt(_)
    | TypeDefStmt(_, _)
    | EffectDeclStmt(_, _, _)
    | HandlerDeclStmt(_, _, _, _, _, _)
    | HandlerChainStmt(_, _)
    | ImportStmt(_)
    | RefineStmt(_, _, _)
    | AliasStmt(_, _)
    | RowAliasStmt(_, _) => [],
  },
  NExpr(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NRow(_) | NTypeAnn(_) | NName(_) | NParam(_) => [],
}

// ─── Tail-transparent parameters — a proof, never an accident ─────────
// `fn call_thunk(f) = f()` calls its parameter ONLY at its own result
// position, so a lambda handed to it runs at the CALL's result: a resume
// inside that lambda is still the arm's tail, and the stack return is
// exact. `fn twice(f) = f() + f()`, `fn wrap(f) = run(f)` and
// `fn keep(f) = () => f()` are not — a resume handed to them is HELD, and
// the arm's grade says so. Before 2026-09-27 a lambda-wrapped resume was
// graded as if the lambda's caller were transparent, which was true of
// the thunk caller in tests/micros/mn-oneshot-lambda-commit.mn by accident
// and false of the one in tests/micros/mn-held-resume-in-thunk.mn, which
// answered 22 where the deep-handler contract says 21. Read off the
// callee's parse structure at collection: every mention of the parameter
// in the body must be a callee at a tail position (a block's final, both
// branches, every arm); a mention anywhere else — as an argument, in a
// condition, inside a returned closure — disqualifies it. The indices are
// what `resume_grade` reads through `tail_params_of`, positionally against
// the call's arguments.
// The cost is on the board: the first form walked every parameter of every
// declaration through a free-variable collection and raised the wheel's
// self-compile peak by ~100MB of transient lists (the march refused the
// repin). Almost no declaration calls a parameter at its tail, so the tail
// spine is read FIRST — an O(depth) walk with no allocation — and the
// collection runs only for the parameters that appear there.
fn tail_transparent_params(params, body) = {
  let callees = tail_callee_names(body, [])
  if len(callees) == 0 { [] } else { tail_transparent_loop(params, body, callees, 0, []) }
}

fn tail_transparent_loop(params, body, callees, i, acc) = if i >= len(params) {
  acc
} else {
  let pname = param_binder(list_index(params, i))
  let acc2 =
    if string_in_list(callees, pname) && tail_transparent(body, pname) { push(acc, i) } else { acc }
  tail_transparent_loop(params, body, callees, i + 1, acc2)
}

// The names in callee position at the body's tail positions — the block's
// final, both branches, every arm — and nothing else.
fn tail_callee_names(node, acc) = match graph_node_body(node) {
  NExpr(BlockExpr(_, final)) => tail_callee_names(final, acc),
  NExpr(IfExpr(_, t, e)) => tail_callee_names(e, tail_callee_names(t, acc)),
  NExpr(MatchExpr(_, arms)) => tail_callee_names_arms(arms, acc),
  NExpr(CallExpr(f, _)) => match graph_node_body(f) {
    NExpr(VarRef(n)) => push(acc, n),
    _ => acc,
  },
  _ => acc,
}

fn tail_callee_names_arms(arms, acc) = if len(arms) == 0 {
  acc
} else {
  match last(arms) {
    (_, body) => tail_callee_names_arms(drop_last(arms), tail_callee_names(body, acc)),
  }
}

// Every mention of `p` in `node` is a callee at a tail position.
fn tail_transparent(node, p: String) = match graph_node_body(node) {
  NExpr(BlockExpr(stmts, final)) => match free_vars_stmts(stmts, [], []) {
    (uses, _) => !free_uses_contains(uses, p) && tail_transparent(final, p),
  },
  NExpr(IfExpr(c, t, e)) => !string_in_list(collect_free_vars(c, []), p) && tail_transparent(t, p) && tail_transparent(e, p),
  NExpr(MatchExpr(scrut, arms)) => !string_in_list(collect_free_vars(scrut, []), p) && all({ (_, body) => tail_transparent(body, p) }, arms),
  NExpr(CallExpr(f, args)) => match graph_node_body(f) {
    NExpr(VarRef(n)) => if n == p {
      !any({ a => string_in_list(collect_free_vars(a, []), p) }, args)
    } else {
      !string_in_list(collect_free_vars(node, []), p)
    },
    _ => !string_in_list(collect_free_vars(node, []), p),
  },
  _ => !string_in_list(collect_free_vars(node, []), p),
}

// Every fn declared under a node — the node itself, and every one nested in
// it — as (name, body, tail-transparent parameter indices). The walk mirrors
// resume_grade's enumeration (the same child-bearing forms); a form added to
// one without the other starves an arm's summaries.
fn collect_fn_decls_list(nodes, acc) = if len(nodes) == 0 {
  acc
} else {
  collect_fn_decls_list(drop_last(nodes), collect_fn_decls(last(nodes), acc))
}

fn collect_fn_decls(node, acc) = match graph_node_body(node) {
  // drift-audit: ignore — decl-count-bounded cons, not a hot loop
  NStmt(FnStmt(name, params, _, _, b)) => collect_fn_decls(b, [(name, b, tail_transparent_params(params, b))] ++ acc),
  NStmt(HandlerDeclStmt(_, _, _, _, arms, _)) => collect_fn_decls_arms(arms, acc),
  NStmt(HandlerChainStmt(_, chain)) => collect_fn_decls(chain, acc),
  NStmt(LetStmt(_, v, _)) => collect_fn_decls(v, acc),
  NStmt(ExprStmt(e)) => collect_fn_decls(e, acc),
  NExpr(BlockExpr(stmts, final)) => collect_fn_decls(final, collect_fn_decls_list(stmts, acc)),
  NExpr(IfExpr(c, t, e)) => collect_fn_decls(e, collect_fn_decls(t, collect_fn_decls(c, acc))),
  NExpr(MatchExpr(scrut, arms)) => collect_fn_decls_match(arms, collect_fn_decls(scrut, acc)),
  NExpr(CallExpr(f, args)) => collect_fn_decls_list(args, collect_fn_decls(f, acc)),
  NExpr(BinOpExpr(_, l, r)) => collect_fn_decls(r, collect_fn_decls(l, acc)),
  NExpr(UnaryOpExpr(_, x)) => collect_fn_decls(x, acc),
  NExpr(LambdaExpr(_, lbody)) => collect_fn_decls(lbody, acc),
  NExpr(MakeListExpr(elems)) => collect_fn_decls_list(elems, acc),
  NExpr(MakeTupleExpr(elems)) => collect_fn_decls_list(elems, acc),
  NExpr(MakeRecordExpr(fields)) => collect_fn_decls_fields(fields, acc),
  NExpr(RecordUpdateExpr(base, fields)) => collect_fn_decls_fields(fields, collect_fn_decls(base, acc)),
  NExpr(NamedRecordExpr(_, fields)) => collect_fn_decls_fields(fields, acc),
  NExpr(FieldExpr(b, _)) => collect_fn_decls(b, acc),
  NExpr(IndexExpr(receiver, index)) => collect_fn_decls(index, collect_fn_decls(receiver, acc)),
  NExpr(PipeExpr(_, l, r)) => collect_fn_decls(r, collect_fn_decls(l, acc)),
  NExpr(FanoutExpr(branches)) => collect_fn_decls_list(branches, acc),
  NExpr(RestExpr(_)) => acc,
  NExpr(MakeStringExpr(frags)) => collect_fn_decls_list(frags, acc),
  NExpr(ShowExpr(inner)) => collect_fn_decls(inner, acc),
  NExpr(LabeledArg(_, v)) => collect_fn_decls(v, acc),
  NExpr(ResumeExpr(v, us)) => collect_fn_decls_updates(us, collect_fn_decls(v, acc)),
  NStmt(TypeDefStmt(_, _)) => acc,
  NStmt(EffectDeclStmt(_, _, _)) => acc,
  NStmt(ImportStmt(_)) => acc,
  NStmt(RefineStmt(_, _, _)) => acc,
  NStmt(AliasStmt(_, _)) => acc,
  NStmt(RowAliasStmt(_, _)) => acc,
  NExpr(LitInt(_)) => acc,
  NExpr(LitFloat(_)) => acc,
  NExpr(LitString(_)) => acc,
  NExpr(LitBool(_)) => acc,
  NExpr(LitUnit) => acc,
  NExpr(VarRef(_)) => acc,
  NExpr(ExprPlaceholder) => acc,
  NHole(_) => acc,
  NPat(_) => acc,
  NModule(_) => acc,
  NLink(_) => acc,
  NRow(_) => acc,
  NTypeAnn(_) => acc,
  NName(_) => acc,
  NParam(_) => acc,
}

fn collect_fn_decls_arms(arms, acc) = if len(arms) == 0 {
  acc
} else {
  collect_fn_decls_arms(drop_last(arms), collect_fn_decls(handler_arm_body(last(arms)), acc))
}

fn collect_fn_decls_match(arms, acc) = if len(arms) == 0 {
  acc
} else {
  match last(arms) {
    (_, b) => collect_fn_decls_match(drop_last(arms), collect_fn_decls(b, acc)),
  }
}

fn collect_fn_decls_fields(fields, acc) = if len(fields) == 0 {
  acc
} else {
  match last(fields) {
    (_, v) => collect_fn_decls_fields(drop_last(fields), collect_fn_decls(v, acc)),
  }
}

fn collect_fn_decls_updates(updates, acc) = if len(updates) == 0 {
  acc
} else {
  collect_fn_decls_updates(drop_last(updates), collect_fn_decls(state_field_init(last(updates)), acc))
}

// usage_seq (⊗) and usage_join (⊔) live in types.mn beside the Usage ADT
// they fold — one lattice home for this walk and own.mn's mode-paired
// ownership grade (§11 4.2; own cannot import infer).
//
// The resume grade decides the op's discipline. RMany drives a real k
// (MultiShot); RDeep is the same record called once; RTail is the stack
// return (OneShot). RNone — the arm NEVER resumes — is ABANDON: the arm's
// value is the install's value (AN-1) and the continuation is dead, so the
// perform unwinds to the install. There is no "bottom return" exception.
// `fail -> a` graded OneShot handed the arm's value back to the perform site
// as whatever `a` had unified with — `let s: String = fail("x"); len(s) +
// 100` answered 100 on boot 311479e1, the arm's 7 read as a String — and
// `abort -> !` parses TUnit, a value like any other. The wheel's
// never-resuming handler, `fail_exit`, abandons (AN-2, 2026-10-03); the
// other, catch_abort, left with the dead Abort subsystem on 2026-10-12.
fn arm_disc_of(grade) = match grade {
  RMany => MultiShot,
  // ONE use, HELD: the arm computes after the remainder returns, so the
  // remainder is reified as the continuation record and called once — the
  // deep form on the record path (the record is the representation; how
  // often the arm calls it is the arm's own business). Graded UOne and
  // lowered as the stack return until 2026-09-27, which deleted the code
  // after the resume (tests/micros/mn-oneshot-nontail-resume.mn).
  RDeep => MultiShot,
  RTail => OneShot,
  RNone => Abandon,
}

// disc_join — the monotone op-level join: OneShot is the identity, MultiShot
// absorbs.
fn disc_join(a, b) = match a {
  MultiShot => MultiShot,
  // M4 — the join order is OneShot < Abandon < MultiShot: any resuming arm
  // (MultiShot) dominates (the real-k path serves every catch); else any
  // abandoning arm makes the op Abandon; else OneShot. So an op with one
  // resume-once arm and one abandon arm in different handlers is MultiShot
  // (the perform can't know at lower which catches → the live-k path).
  Abandon => match b {
    MultiShot => MultiShot,
    OneShot | Abandon => Abandon,
  },
  OneShot => b,
}

// Whether a resume of this discipline CALLS its continuation, so the
// remainder runs inside the resume's own frame: the record path the lowering
// takes for both (lower.mn's lower_resume_callk). A one-shot resume is the stack
// return, and the remainder runs after the arm has returned.
fn continuation_held(disc) = match disc {
  MultiShot => true,
  Abandon => true,
  OneShot => false,
}

// The grade is a `ResumeUse` (types.mn): the multiplicity of the arm's
// resumes AND the position of the one use. A node hands its own grade up
// as "at my result"; every construct that CONSUMES a child's value —
// an operand, an argument, an element, a field, a let RHS, a lambda body —
// wraps the child in `resume_interior`, and every sequence runs
// `resume_seq` in source order, so a use with code after it is held.
fn resume_grade(node) = match graph_node_body(node) {
  NExpr(ResumeExpr(_, _)) => RTail,
  NExpr(BlockExpr(stmts, final)) => resume_seq(grade_nodes(stmts), resume_grade(final)),
  NExpr(IfExpr(c, t, e)) => resume_seq(resume_grade(c), resume_join(resume_grade(t), resume_grade(e))),
  NExpr(MatchExpr(scrut, arms)) => resume_seq(resume_grade(scrut), grade_join_arms(arms)),
  // Call-substitution: a call to a fn with a resume summary contributes
  // that summary (the arm's fixpoint wrote it; summary_of answers RNone for
  // every name the arm does not declare). This is what makes backtrack's
  // try_each recursion saturate to RMany by round 2 and lets an arm's grade
  // see resumes in the fns it CALLS. The callee's uses sit at the CALL's result: a tail call into a helper
  // that resumes at its own tail is still the stack return, while a
  // resume inside an argument is held by the call that follows it.
  NExpr(CallExpr(f, args)) => match match graph_node_body(f) {
    // A named callee runs its body at the call, so its uses count once, as
    // the call's own — never again as a value handed out.
    NExpr(VarRef(cn)) => (RNone, summary_of(cn), tail_params_of(cn)),
    _ => (resume_grade(f), RNone, []),
  } {
    // The callee's own evaluation, the arguments in order, the callee's own
    // uses, then the arguments the callee calls at its tail — those run at
    // the CALL's result (tail_transparent_params), so a lambda there keeps
    // its body's grade and a reference there contributes its summary.
    (callee_value, callee_g, tails) => resume_seq(
      resume_seq(resume_seq(callee_value, grade_args_interior(args, tails, 0, RNone)), callee_g),
      grade_args_tail(args, tails, 0, RNone)
    ),
  },
  NExpr(BinOpExpr(_, l, r)) => resume_interior(resume_seq(resume_grade(l), resume_grade(r))),
  NExpr(UnaryOpExpr(_, x)) => resume_interior(resume_grade(x)),
  // A resume inside a lambda runs when the lambda is called, from wherever
  // that is — never provably at the arm's result, so the arm holds it.
  NExpr(LambdaExpr(_, lbody)) => resume_interior(resume_grade(lbody)),
  NExpr(MakeListExpr(elems)) => resume_interior(grade_nodes(elems)),
  NExpr(MakeTupleExpr(elems)) => resume_interior(grade_nodes(elems)),
  NExpr(MakeRecordExpr(fields)) => resume_interior(grade_fields(fields)),
  NExpr(RecordUpdateExpr(base, fields)) => resume_interior(resume_seq(resume_grade(base), grade_fields(fields))),
  NExpr(NamedRecordExpr(_, fields)) => resume_interior(grade_fields(fields)),
  NExpr(FieldExpr(b, _)) => resume_interior(resume_grade(b)),
  NExpr(IndexExpr(receiver, index)) => resume_interior(resume_seq(resume_grade(receiver), resume_grade(index))),
  NExpr(PipeExpr(_, l, r)) => resume_interior(resume_seq(resume_grade(l), resume_grade(r))),
  NExpr(FanoutExpr(branches)) => resume_interior(grade_nodes(branches)),
  NExpr(RestExpr(_)) => RNone,
  NExpr(MakeStringExpr(frags)) => resume_interior(grade_nodes(frags)),
  NExpr(ShowExpr(inner)) => resume_interior(resume_grade(inner)),
  NExpr(LabeledArg(_, v)) => resume_grade(v),
  NStmt(LetStmt(_, v, _)) => resume_interior(resume_grade(v)),
  NStmt(ExprStmt(e)) => resume_grade(e),
  // A nested fn DECLARATION is not an execution — its resumes count at its
  // CALL sites and its references via the summary substitution (the pre-cut
  // descend double-counted a define-once-call-once helper into RMany).
  NStmt(FnStmt(_, _, _, _, _)) => RNone,
  // Decls nested in an arm carry no resume of THIS arm's continuation; leaves
  // carry no children. Both are the grade identity RNone (explicit, never a
  // wildcard fabricating a grade for an un-enumerated child-bearing variant).
  NStmt(TypeDefStmt(_, _)) => RNone,
  NStmt(EffectDeclStmt(_, _, _)) => RNone,
  NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => RNone,
  NStmt(HandlerChainStmt(_, _)) => RNone,
  NStmt(ImportStmt(_)) => RNone,
  NStmt(RefineStmt(_, _, _)) => RNone,
  NStmt(AliasStmt(_, _)) => RNone,
  NStmt(RowAliasStmt(_, _)) => RNone,
  NExpr(LitInt(_)) => RNone,
  NExpr(LitFloat(_)) => RNone,
  NExpr(LitString(_)) => RNone,
  NExpr(LitBool(_)) => RNone,
  NExpr(LitUnit) => RNone,
  // A reference hands a function out as a value, to be called from wherever
  // it is called and as often, so the uses its body holds are held, as a
  // lambda's are: an arm that hands `fold` a nested fn that resumes is a
  // resuming arm, never an abandoning one whose `resume` answers its
  // argument without running the remainder
  // (tests/micros/mn-resume-in-referenced-fn.mn). A name with no summary — a
  // parameter, a local, an op — carries none.
  NExpr(VarRef(n)) => resume_interior(summary_of(n)),
  NExpr(ExprPlaceholder) => RNone,
  NHole(_) => RNone,
  NPat(_) => RNone,
  NModule(_) => RNone,
  NLink(_) => RNone,
  NRow(_) => RNone,
  NTypeAnn(_) => RNone,
  NName(_) => RNone,
  NParam(_) => RNone,
}

// Sequential composition over a node list (block stmts, call args, list
// elems, string frags): all execute on one path, in SOURCE ORDER. The
// order is load-bearing — `resume_seq` is not symmetric, because a use
// followed by more code is a held use — so the fold seqs everything before
// `last` first and puts `last` at the sequence's result. last/drop_last are
// the O(1) snoc-end reads, so the fold is O(N).
fn grade_nodes(nodes) = if len(nodes) == 0 {
  RNone
} else {
  resume_seq(grade_nodes(drop_last(nodes)), resume_grade(last(nodes)))
}

// A call's arguments other than the callee's tail-transparent ones, in
// source order, each consumed by the call that follows it.
fn grade_args_interior(args, tails, i, acc) = if i >= len(args) {
  acc
} else {
  let g = if int_in(tails, i, 0) { RNone } else { resume_grade(list_index(args, i)) }
  grade_args_interior(args, tails, i + 1, resume_seq(acc, g))
}

// The arguments the callee calls only at its tail: a lambda's BODY grade
// (its resume is at the call's result, not inside a value the arm holds),
// a reference's summary. Joined — the callee's tail runs one of them per
// path.
fn grade_args_tail(args, tails, i, acc) = if i >= len(args) {
  acc
} else {
  let g = if int_in(tails, i, 0) {
    match graph_node_body(list_index(args, i)) {
      NExpr(LambdaExpr(_, lbody)) => resume_grade(lbody),
      NExpr(VarRef(an)) => summary_of(an),
      _ => resume_grade(list_index(args, i)),
    }
  } else {
    RNone
  }
  grade_args_tail(args, tails, i + 1, resume_join(acc, g))
}

// Alternation over match arms ((pat, body) tuples): exactly one arm runs, so
// ⊔-join their grades — two resumes in sibling arms is still one per path.
fn grade_join_arms(arms) = if len(arms) == 0 {
  RNone
} else {
  match last(arms) {
    (_, b) => resume_join(resume_grade(b), grade_join_arms(drop_last(arms))),
  }
}

// Record fields ((name, value) tuples) all evaluate on one path, in order.
fn grade_fields(fields) = if len(fields) == 0 {
  RNone
} else {
  match last(fields) {
    (_, v) => resume_seq(grade_fields(drop_last(fields)), resume_grade(v)),
  }
}

// Config is [TParam] (the fn-param carrier), and it mints exactly as a
// function's parameters do: one graph handle each, superseding the
// parse-time placeholder, with an authored annotation bound to it
// (`build_param_types`) and the NAME, markers and DEFAULT riding through —
// the default's one home is the TParam's fifth slot, read by
// resolve_call_args at every install that omits the field (SYNTAX
// §«Default parameter values»). A fresh variable per parameter dropped
// every annotation, so `handler acc(init: Float, step: Float)` was generic
// and its arms added and compared the addresses of the install's boxes:
// `sum > init` answered 1 for 3.0 against 5.0, measured 2026-09-28 on boot
// b29e319b.
// Utilities
fn infer_expr_list(ref nodes) = each(infer_expr, nodes)

fn collect_tvar_types(ref nodes) = map(TVar, nodes)

fn unify_list_elems(elems, target_h, span: ValidSpan) =
  each({ e => unify(e, target_h, span, ListElement(Inferred("list element"))) }, elems)

// The judge-side mirror of lower's empty-literal elision: a fragment
// elides iff it is the "" literal the parser keeps for the alternation
// invariant. M surviving fragments need M−1 interior concat cells; the
// last concat re-keys to the interp node itself at lower, so the cells
// cover the interior joins only.
fn interp_concat_cells(fragments, span: ValidSpan) = {
  let m = count_nonempty_fragments(fragments, 0, 0)
  mint_concat_cells(if m > 1 { m - 1 } else { 0 }, span, [])
}

fn count_nonempty_fragments(fragments, i, acc) = if i >= len(fragments) {
  acc
} else {
  match graph_node_body(list_index(fragments, i)) {
    NExpr(LitString(s)) => count_nonempty_fragments(fragments, i + 1, if byte_len(s) == 0 { acc } else { acc + 1 }),
    _ => count_nonempty_fragments(fragments, i + 1, acc + 1),
  }
}

fn mint_concat_cells(n, span: ValidSpan, acc) = if n <= 0 {
  acc
} else {
  // drift-audit: ignore — bounded by a string's fragment count, not a hot loop
  mint_concat_cells(
    n - 1,
    span,
    acc ++ [graph_fresh_ty(Located(span, Inferred("interp segment concat")))]
  )
}

// Effect-name projection of a row — the handled-name set read live from
// a row's NRowBound. Used by pipeline.mn's reached-effect report.
fn row_names(row) with Pure = match row {
  EfRow(names, _, _) => names,
}

// A frame row whose whole content is ONE free edge chases to that free
// cell (the single-edge alias rule), and the reading of such a row IS the
// edge — never Pure. The catch-all used to fabricate Pure here, so a `~>`
// body that only called a parameter (`fn run(f) = (f()) ~> h`) published
// no row at all, and a program performing an effect nobody handled
// compiled clean and trapped at the root (measured 2026-09-25, the tee
// probe in tests/lens/negation).
fn read_bound_row(handle) = match graph_chase(handle) {
  GNode(NRowBound(row), _) => row,
  _ => mk_ef_open([], handle),
}
