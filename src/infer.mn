// infer.mn — Hindley-Milner, one walk, graph-direct (spec 04)
//
// The engine. A single recursive walk over the typed AST that writes
// bindings directly into the Graph and effects into Env through
// effect-mediated access. Three operations: infer_expr, infer_stmt,
// generalize. No sidecar subst. No (env, subst) tuple threaded. The
// graph IS the subst; env IS ambient; both are performed.
//
// Effects required:
//   GraphRead + GraphWrite   — live graph mutation
//   EnvRead + EnvWrite                 — scoped bindings
//   Diagnostic                         — Hazel marked holes
//   FreshHandle                        — instantiate (one fn, two handlers)
//   Verify                             — refinement obligations
//   Consume                            — ownership at own-parameter use
//   InferCtx                           — infer-local: fn-row accumulation
//
// The effect row of a function is accumulated in InferCtx handler
// state during body inference, then bound into the graph on exit.
// This is the clean way: graph_bind is one-write-per-handle, so rows
// grow in handler state and write once.
//
// Classic Damas-Milner. Productive under error (Hazel): a mismatch
// binds NErrorHole and continues; ten mismatches yield ten error
// holes, not one-and-halt.
import graph

import verify

import env

import intern

import lexer

import effects

import types

import canon

import own

import imap

import io

import parser

import io

import verify

// Infer-local effect for row accumulation.
// Each `FnStmt` / `LambdaExpr` pushes a `(row_handle, accumulated_row)`
// frame. Every effect-op CALL inside the body adds its effect to the
// accumulated row (the op's TFun row carries Closed[eff]; infer_call reads
// it live and inf_add_row joins it). On scope exit, the accumulated row
// binds to the handle via `graph_bind_row`. One write; no conflict.
effect InferCtx {
  inf_enter_fn(Int, Int, Span, [(EffName, Bool, EConn)])
  inf_exit_fn([Int]) -> [(EffName, Bool, EConn)]
  inf_add_effect(EffName)
  inf_add_row(EffRow)
  inf_current_row() -> EffRow
  inf_current_world() -> EffRow
  inf_current_answer() -> Int
  inf_enter_arm(Int)
  inf_exit_arm()
  inf_arm_tys() -> Option(Int)
  // The install-frame mark: a tee body's frame is ONE install's scope, so
  // same-named effect-instance fragments inside it (yield's + result's)
  // join by position; any other frame is a plain accumulation (joining a
  // caller's independent callee instances unified Float with Int across
  // the wheel — the 286-error m3 census).
  inf_mark_install_frame()
  inf_frame_is_install() -> Bool
  // The declared-row gate's deferral channel: a gate whose body tail is
  // still an open chain at decl exit (a cycle's non-last member — the
  // callee roots it charged resolve only when the cycle's last member
  // cuts) parks here and drains at the pass tail, where every chain has
  // closed. Per-pass by construction: each pass installs its own
  // infer_ctx, so a trial's parked gates die with the trial's bracket.
  defer_row_gate((String, EffRow, Bool, Int, Span))
  drain_row_gates() -> [(String, EffRow, Bool, Int, Span)]
  // The binding group in judgment — PARSE truth (scc_groups), set by the
  // trial around each cycle's walk. ONE consumer: the declared-row
  // deferral (a cycle member's gate parks until the pass tail, where
  // every co-member chain has closed; a non-member enforces eagerly at
  // decl exit). B4's completion drains absorb this — the gate then
  // fires at the group's own completion event and the pass-tail drain
  // demotes to an assert-empty.
  set_group_members([String])
  group_member(String) -> Bool
  // The pass's prereg ceiling — graph_next at the moment pre-registration
  // completed, set once per pass by its driver. The finalize's completion
  // prune reads it: a free edge minted at or above it is an unconstrained
  // judgment copy (drops as pure); below it, a prereg live link (kept).
  set_mint_ceiling(Int)
}

handler infer_ctx with stack = [], arm_stack = [], install_marks = [], pending_gates = [], group_names = [], mint_ceiling = 0 {
  inf_enter_fn(h, answer_h, fn_span, effs) => // stack = [InferFrame, ...] where each InferFrame is a record:
  //   {accumulated_row: EffRow, answer_handle: Int, declared: List,
  //    fn_span: Span, row_handle: Int}
  //   declared = [(EffName, negated)] — the fn's authored annotation, born
  //   with the frame and returned by inf_exit_fn (nested fns get their own)
  // arm_stack = [the continuation handle, ...] — the typed-resume
  //   context (SYNTAX §Effect declarations): inside `op(args) => body` for
  //   `op : (P...) -> R` under a handler whose handle-result is S,
  //   `resume : R -> S`. ResumeExpr reads the top frame; a stack because
  //   handler decls nest inside arm bodies.
  {
    // The frame is BORN with its declaration: `effs` = the FnStmt's authored
    // [(EffName, negated)] list (empty for lambdas / tee bodies / arm scopes).
    // No ambient declared-scalar to clobber — a nested fn gets its own.
    let frame =
      {accumulated_row: mk_ef_pure(), answer_handle: answer_h, declared: effs, fn_span: fn_span, row_handle: h}
    // drift-audit: ignore — bounded-depth frame PUSH (one per fn nesting level, popped at exit; §9 push-at-END), not a loop accumulator
    resume() with stack = stack ++ [frame]
  },
  inf_exit_fn(sig_keep) => if len(stack) == 0 {
    resume([])
  } else {
    let frame = last(stack)
    // The finalize op, not the teaching bind: the frame's accumulation
    // is the decl's own total, and a JOIN here would re-widen what
    // row_without_self strips (the teaching bind joins by the lattice
    // law; the exit REPLACES — two algebras, two ops).
    graph_finalize_row(
      frame.row_handle,
      row_keep_completion(
        row_without_self(frame.accumulated_row, frame.row_handle),
        mint_ceiling,
        sig_keep
      ),
      Located(frame.fn_span, Inferred("fn effect row"))
    )
    // The popped frame's declaration comes back to the closer — the
    // enforcement site reads it from the resume value, no ambient read.
    // An install mark on THIS depth pops with its frame.
    let marks2 = if len(install_marks) > 0 {
      if last(install_marks) == len(stack) { drop_last(install_marks) } else { install_marks }
    } else {
      install_marks
    }
    resume(frame.declared) with stack = drop_last(stack), install_marks = marks2
  },
  inf_mark_install_frame() => // drift-audit: ignore — bounded-depth mark PUSH paired with the exit's pop (§9 push-at-END), not a loop accumulator
  resume() with install_marks = push(install_marks, len(stack)),
  inf_frame_is_install() => resume(if len(install_marks) == 0 { false } else { last(install_marks) == len(stack) }),
  inf_add_effect(name) => if len(stack) == 0 {
    resume()
  } else {
    let frame = last(stack)
    // `name` is an EffName — joined into the row directly. The single-name
    // case of inf_add_row; parameterized effects flow through inf_add_row.
    let extended = union_row(frame.accumulated_row, mk_ef_closed([name]))
    let updated =
      {accumulated_row: extended, answer_handle: frame.answer_handle, declared: frame.declared, fn_span: frame.fn_span, row_handle: frame.row_handle}
    // drift-audit: ignore — top-frame REPLACE on a bounded-depth stack (§9 push-at-END), not a loop accumulator
    resume() with stack = drop_last(stack) ++ [updated]
  },
  inf_add_row(row) => if len(stack) == 0 {
    resume()
  } else {
    // The union is a plain value join — never a resolve: a fold here
    // would unwrap a `~>` subtraction's opaque mask edge and re-inline
    // its underlying set raw, dropping the subtraction for
    // late-arriving content (the multieffect-leak class; measured as
    // this arm's own first fold form, reverted same day). Boundedness
    // is the QUANTIFICATION FLOOR's job at the publish, not a fold's
    // here.
    let frame = last(stack)
    let extended = union_row(frame.accumulated_row, row)
    let updated =
      {accumulated_row: extended, answer_handle: frame.answer_handle, declared: frame.declared, fn_span: frame.fn_span, row_handle: frame.row_handle}
    // drift-audit: ignore — top-frame REPLACE on a bounded-depth stack (§9 push-at-END), not a loop accumulator
    resume() with stack = drop_last(stack) ++ [updated]
  },
  inf_current_row() => if len(stack) == 0 {
    resume(mk_ef_pure())
  } else {
    let frame = last(stack)
    resume(frame.accumulated_row)
  },
  inf_current_world() => // The continuation world is the current frame's LIVE row variable, not the
  // accumulated prefix observed at the suspension point. The frame binds that
  // variable on exit, so effects in the remainder are carried without a copy.
  {
    if len(stack) == 0 { resume(mk_ef_pure()) } else { resume(mk_ef_open([], last(stack).row_handle)) }
  },
  inf_current_answer() => if len(stack) == 0 { resume(-1) } else { resume(last(stack).answer_handle) },
  inf_enter_arm(continuation_h) => // drift-audit: ignore — bounded-depth arm-frame PUSH (§9 push-at-END), not a loop accumulator
  resume() with arm_stack = arm_stack ++ [continuation_h],
  inf_exit_arm() => if len(arm_stack) == 0 { resume() } else { resume() with arm_stack = drop_last(arm_stack) },
  inf_arm_tys() => if len(arm_stack) == 0 { resume(None) } else { resume(Some(last(arm_stack))) },
  defer_row_gate(g) => // drift-audit: ignore — judgment-scoped gate PARK drained once at the pass tail (§9 push-at-END), not a loop accumulator
  resume() with pending_gates = push(pending_gates, g),
  drain_row_gates() => resume(pending_gates) with pending_gates = [],
  set_group_members(ns) => resume() with group_names = ns,
  group_member(n) => resume(string_in_list(group_names, n)),
  set_mint_ceiling(n) => resume() with mint_ceiling = n,
}

// fresh_for_inference — the FreshHandle install inference runs under:
// `mint` resolves to real graph handles (graph_fresh_ty), never display
// ids. Declared HERE, the op's own layer, so every re-inference chain
// (synth's candidate verify included) reaches it through `import infer`;
// the query/teach entry installs `fresh_for_query` (pipeline.mn) for
// ephemeral display ids — the swappable peer.
handler fresh_for_inference {
  mint(reason) => {
    let h = graph_fresh_ty(reason)
    resume(h)
  },
  mint_row(reason) => {
    let h = graph_fresh_row(reason)
    resume(h)
  },
}

// Entry point — wraps the walk in `infer_ctx` (row accumulation) and
// `fresh_for_inference` (the FreshHandle install: `mint` resolves to real graph
// handles, not display ids). The install EDGE was missing — `fresh_for_inference`
// was declared but never `~>`-installed, so every `mint` in the inference extent
// floored its FreshHandle evidence (the slot-0 fabrication). Drawing the edge
// roots the chain at the handler the graph now connects; the query/teach entry
// installs `fresh_for_query` for ephemeral display ids (the swappable peer).
// The callee-row accumulation seam. Same-named effect-instance FRAGMENTS
// join by position ONLY inside an INSTALL frame (a tee body — one
// install's scope: yield's Iterate(el, r) and result's Iterate(el', r')
// are fragments of ONE instance, and the name-set union would drop one).
// Everywhere else the frame is a plain accumulation: joining a CALLER's
// independent callee instances unified Float with Int across the wheel
// (fold over [Int] then fold over [Float] in one body — the 286-error m3
// census). The name-set keeping one entry per name across genuinely
// distinct instances is the standing representation tension
// (parameterized-negation-instance).
fn inf_add_row_unified(row) = {
  if inf_frame_is_install() {
    match row {
      EfRow(np, _, _) => match inf_current_row() {
        EfRow(cp, _, _) => each(
          (e) => match e {
            EParameterized(n, args_b) => match find(
              (c) => match c {
                EParameterized(cn, _) => cn == n,
                _ => false,
              },
              cp
            ) {
              Some(EParameterized(_, args_a)) => // Row-side args are EffArg (EAType-wrapped) — unwrap to the Ty
              // lists unify_instance_args joins; feeding the wrappers minted
              // garbage nodes and joined those instead of the elements.
              unify_instance_args(eparam_arg_tys(args_a), eparam_arg_tys(args_b), 0, span_zero()),
              _ => (),
            },
            _ => (),
          },
          np
        ),
      },
    }
  } else {
    ()
  }
  inf_add_row(row)
}

// ─── comment references — the backtick contract ─────────────────────
//
// A comment is a Reason edge (SYNTAX §Comments); a `backticked`
// identifier inside one is a REFERENCE into the one namespace, authored
// as such — bare prose is prose and never resolved against code. After
// the walk the env is whole, so every reference either RESOLVES — and a
// reference to a declared node DRAWS the comment-reference edge
// (graph_attach_comment_ref), so the identity is carried and the name
// is a projection (comments heal under rename; the audit's
// referenced-by line is the reverse read) — or narrates
// W_CommentRefUnresolved through the ordinary diagnostics chain at the
// comment's own span. The resolution surfaces, in order: the owner's
// own names (a fn's params, a handler's config / state / ops / arm
// args — they live ON the commented node); the surface's vocabulary
// (keywords via the lexer's keyword_kind — its one home — and the repr
// words); the declared program (the decl index — these draw the edge);
// the env's primitive schemes. A `$`-opening span is the program's
// EMITTED vocabulary: judged against what the program's own string
// literals write, built lazily on first use — and a BARE ident that
// misses every Mentl surface takes the same lazy judgment before
// narrating (a name the program's own literals write is the program's
// word); a program whose comments all resolve in Mentl terms never
// pays the walk. Spans with
// non-ident bytes are quoted CODE (illustrative; compiling them is the
// doc-test frontier) and `<...>` marks a schematic template — neither
// is a reference.
fn comment_refs_check(ref stmts, parse_start, parse_end) = {
  let cdix = comment_decl_index(stmts, 0, smap_new())
  // Flat ONCE before the per-comment scans: crc_scope_at indexes this list
  // per scope per commented handle, and a snoc spine pays its depth on
  // every read — measured 2026-07-24 at 83% of the ENTIRE self-compile
  // (the prose gate cost five compilers; perf found it, no code-reading
  // estimate ever named it).
  let scopes = list_to_flat(crc_fn_scopes(stmts, 0, []))
  // The walk's bounds are THIS pass's own parse range: comments attach
  // only at parse (graph_attach_comment, like graph_index_span), so
  // handles above the frontend's frontier are comment-free by
  // construction, and handles BELOW its start belong to prior
  // generations whose comment cells still hold text — the old 0-to-
  // graph_next walk judged every stale generation's copy and probed
  // the judgment's millions of mints for prose (the crc share of the
  // healed profile, 19%, 2026-07-26).
  let dollars = crc_walk(parse_start, parse_end, cdix, scopes, [])
  if len(dollars) > 0 {
    let lvix = lit_vocab_build(0, graph_next(), smap_new())
    crc_judge_dollars(dollars, 0, lvix, cdix)
  } else {
    ()
  }
}

// The SCOPE face of the referent set: an interior comment's backticks name
// the enclosing fn's params and binders — real names at that position —
// so each top-level decl contributes (its span, its comment_locals) once,
// and a comment inside that span resolves against them exactly as the
// decl's own comment does.
// A decl node's recorded span is its HEAD; the scope's EXTENT runs from
// this decl's start to the next decl's start (the last runs open) — the
// stmt list is consecutive, so the pair of starts IS the extent, no
// re-measure of the body.
fn crc_fn_scopes(ref stmts, i, acc) = if i >= len(stmts) {
  acc
} else {
  let node = list_index(stmts, i)
  match node {
    N(_, sp, h) => match sp {
      Span(sl, sc, _, _) => {
        let ext = if i + 1 < len(stmts) {
          match list_index(stmts, i + 1) {
            N(_, nsp, _) => match nsp {
              Span(nl, nc, _, _) => Span(sl, sc, nl, nc),
            },
          }
        } else {
          Span(sl, sc, 1000000000, 1)
        }
        crc_fn_scopes(stmts, i + 1, push(acc, (ext, comment_locals(h))))
      },
    },
  }
}

fn crc_scope_at(ref scopes, csp, i) = if i >= len(scopes) {
  []
} else {
  match list_index(scopes, i) {
    (sp, names) => if span_contains(sp, csp) { names } else { crc_scope_at(scopes, csp, i + 1) },
  }
}

// name -> decl stmt handle, one walk over the program's own statements.
fn comment_decl_index(ref stmts, i, idx) = if i >= len(stmts) {
  idx
} else {
  match list_index(stmts, i) {
    N(body, _, h) => {
      let idx2 = match body {
        NStmt(FnStmt(name, _, _, _, _)) => smap_add(idx, name, h),
        NStmt(TypeDefStmt(name, ctors)) => ctor_index_add(ctors, 0, smap_add(idx, name, h), h),
        NStmt(EffectDeclStmt(name, _, ops)) => op_index_add(ops, 0, smap_add(idx, name, h), h),
        NStmt(HandlerDeclStmt(name, _, _, _, _)) => smap_add(idx, name, h),
        _ => idx,
      }
      comment_decl_index(stmts, i + 1, idx2)
    },
  }
}

fn ctor_index_add(ref ctors, i, idx, h) = if i >= len(ctors) {
  idx
} else {
  match list_index(ctors, i) {
    (cname, _, _) => ctor_index_add(ctors, i + 1, smap_add(idx, cname, h), h),
  }
}

fn op_index_add(ref ops, i, idx, h) = if i >= len(ops) {
  idx
} else {
  match list_index(ops, i) {
    (opname, _, _, _) => op_index_add(ops, i + 1, smap_add(idx, opname, h), h),
  }
}

fn crc_walk(h, n, ref cdix, ref scopes, dollars) = if h >= n {
  dollars
} else {
  let t = graph_comment_at(h)
  let d2 = if byte_len(t) > 0 {
    let locals = comment_locals(h) ++ crc_scope_at(scopes, graph_comment_span_at(h), 0)
    crc_scan(t, 0, byte_len(t), h, cdix, locals, dollars)
  } else {
    dollars
  }
  crc_walk(h + 1, n, cdix, scopes, d2)
}

fn crc_scan(ref t, i, n, h, ref cdix, ref locals, dollars) = if i >= n {
  dollars
} else {
  if byte_at(t, i) == 96 {
    let j = ctick_close(t, i + 1, n)
    if j < n {
      crc_scan(t, j + 1, n, h, cdix, locals, crc_judge(t, i + 1, j, h, cdix, locals, dollars))
    } else {
      dollars
    }
  } else {
    crc_scan(t, i + 1, n, h, cdix, locals, dollars)
  }
}

fn ctick_close(ref t, i, n) =
  if i < n && byte_at(t, i) != 96 { ctick_close(t, i + 1, n) } else { i }

// One span, one verdict. A `$`-opening ident span queues for the lazy
// emitted-vocabulary judgment; a pure ident span resolves now; anything
// else in backticks is quoted code or schema, not a reference.
fn crc_judge(ref t, a, b, h, ref cdix, ref locals, dollars) = if b <= a {
  dollars
} else {
  if byte_at(t, a) == 36 {
    if span_is_ident(t, a + 1, b) { dollars ++ [(h, str_slice(t, a + 1, b))] } else { dollars }
  } else {
    if byte_at(t, a) == 95 {
      if span_is_ident(t, a, b) { dollars ++ [(h, str_slice(t, a, b))] } else { dollars }
    } else {
      if span_is_ident(t, a, b) {
        let name = str_slice(t, a, b)
        if crc_resolve(name, h, cdix, locals) { dollars } else { dollars ++ [(h, name)] }
      } else {
        dollars
      }
    }
  }
}

// A reference starts [A-Za-z_]; a digit-start span (`0x`, `125`) is a
// quoted LEXEME, not a name.
fn span_is_ident(ref t, a, b) = if a >= b {
  false
} else {
  let c0 = byte_at(t, a)
  if c0 >= 97 && c0 <= 122 || c0 >= 65 && c0 <= 90 || c0 == 95 {
    span_ident_walk(t, a + 1, b)
  } else {
    false
  }
}

fn span_ident_walk(ref t, a, b) = if a >= b {
  true
} else {
  let c = byte_at(t, a)
  if c >= 97 && c <= 122 || c >= 65 && c <= 90 || c >= 48 && c <= 57 || c == 95 {
    span_ident_walk(t, a + 1, b)
  } else {
    false
  }
}

fn crc_resolve(ref name, h, ref cdix, ref locals) = if in_owner_names(locals, name, 0) {
  true
} else {
  match keyword_kind(name) {
    Some(_) => true,
    None => if is_surface_word(name) {
      true
    } else {
      match smap_get(cdix, name) {
        Some(referent) => {
          graph_attach_comment_ref(h, referent)
          true
        },
        None => match env_lookup(name) {
          Some(_) => true,
          None => match env_lookup_type(name) {
            Some(_) => true,
            None => false,
          },
        },
      }
    },
  }
}

// The `$`-vocabulary judgment: what the program's own literals write IS
// part of the program. `$`-names normalize by shedding the sigil and
// leading underscores on BOTH sides of the comparison.
fn crc_judge_dollars(ref dollars, i, ref lvix, ref cdix) = if i >= len(dollars) {
  ()
} else {
  match list_index(dollars, i) {
    (h, raw) => {
      let name = shed_underscores(raw, 0)
      let hit = if byte_len(name) == 0 {
        true
      } else {
        match smap_get(lvix, name) {
          Some(_) => true,
          None => match smap_get(cdix, name) {
            Some(_) => true,
            None => false,
          },
        }
      }
      if hit {
        ()
      } else {
        report(WCommentRefUnresolved(comment_owner(h), raw, graph_comment_span_at(h)))
      }
      crc_judge_dollars(dollars, i + 1, lvix, cdix)
    },
  }
}

fn shed_underscores(ref s, i) = if i < byte_len(s) && byte_at(s, i) == 95 {
  shed_underscores(s, i + 1)
} else {
  str_slice(s, i, byte_len(s))
}

// Every identifier run a literal writes joins the emitted vocabulary,
// normalized the same way (sigils split runs; leading underscores shed).
fn lit_vocab_build(h, n, idx) = if h >= n {
  idx
} else {
  let idx2 = match graph_node_body(h) {
    NExpr(LitString(s)) => lit_runs_add(s, 0, byte_len(s), idx),
    _ => idx,
  }
  lit_vocab_build(h + 1, n, idx2)
}

fn lit_runs_add(ref s, i, n, idx) = if i >= n {
  idx
} else {
  if ident_byte(byte_at(s, i)) {
    let j = lit_run_end(s, i + 1, n)
    let tok = shed_underscores(str_slice(s, i, j), 0)
    lit_runs_add(s, j, n, if byte_len(tok) > 0 { smap_add(idx, tok, 1) } else { idx })
  } else {
    lit_runs_add(s, i + 1, n, idx)
  }
}

fn lit_run_end(ref s, i, n) =
  if i < n && ident_byte(byte_at(s, i)) { lit_run_end(s, i + 1, n) } else { i }

fn ident_byte(b) with Pure =
  b >= 97 && b <= 122 || b >= 65 && b <= 90 || b >= 48 && b <= 57 || b == 95

// SURFACE vocabulary that is not an env name: the repr words (SYNTAX
// §repr pins) and `self`, the refinement's own binder (SYNTAX §Refinement).
fn is_surface_word(ref name) =
  name == "self" || name == "_" || name == "i32" || name == "i64" || name == "f32" || name == "f64" || name == "v128"

fn in_owner_names(ref xs, ref name, i) = if i >= len(xs) {
  false
} else {
  if list_index(xs, i) == name { true } else { in_owner_names(xs, name, i + 1) }
}

fn comment_owner(h) = match graph_node_body(h) {
  NStmt(FnStmt(name, _, _, _, _)) => name,
  NStmt(TypeDefStmt(name, _)) => name,
  NStmt(EffectDeclStmt(name, _, _)) => name,
  NStmt(HandlerDeclStmt(name, _, _, _, _)) => name,
  _ => "node {int_to_str(h)}",
}

// The owner's own names — a comment on a fn legitimately references its
// parameters; a comment on a handler its config, state fields, ops and
// arm args; a comment on an effect its ops. They live ON the owning node.
fn comment_locals(h) = match graph_node_body(h) {
  NStmt(FnStmt(_, params, _, _, fbody)) => body_binders(fbody, cl_param_names(params, 0, [])),
  NStmt(HandlerDeclStmt(_, _, config, states, arms)) => cl_arm_names(arms, 0, cl_state_names(states, 0, cl_param_names(config, 0, []))),
  NStmt(EffectDeclStmt(_, _, ops)) => cl_op_names(ops, 0, []),
  NStmt(LetStmt(pat, val, _)) => body_binders(val, pat_binders(pat)),
  NStmt(TypeDefStmt(_, ctors)) => cl_ctor_names(ctors, 0, []),
  NStmt(ExprStmt(e)) => body_binders(e, []),
  _ => [],
}

// A type's comment references its ctors and its record fields — both
// live in the declaration itself.
fn cl_ctor_names(ref ctors, i, acc) = if i >= len(ctors) {
  acc
} else {
  match list_index(ctors, i) {
    (cname, tys, _) => cl_ctor_names(ctors, i + 1, cl_ctor_field_names(tys, 0, acc ++ [cname])),
  }
}

fn cl_ctor_field_names(ref tys, i, acc) = if i >= len(tys) {
  acc
} else {
  let acc2 = match list_index(tys, i) {
    TRecord(fs) => cl_record_field_names(fs, 0, acc),
    _ => acc,
  }
  cl_ctor_field_names(tys, i + 1, acc2)
}

fn cl_record_field_names(ref fs, i, acc) = if i >= len(fs) {
  acc
} else {
  match list_index(fs, i) {
    (fname, _) => cl_record_field_names(fs, i + 1, acc ++ [fname]),
  }
}

// The binder-side dual of own.mn's count_uses: every name a decl's
// subtree BINDS — let patterns, match-arm patterns, nested fn names
// and params, lambda params. The comment resolver reads it as the
// owner's own namespace. (uses / binders / reach / spec-scan are one
// AST fold in larval form — the forked-cursor rewrite unifies them,
// the PLAN §7 ruling.)
fn body_binders(ref node, acc) = match node {
  N(nbody, _, _) => match nbody {
    NExpr(LambdaExpr(params, lb)) => body_binders(lb, cl_param_names(params, 0, acc)),
    NExpr(BlockExpr(stmts, fe)) => body_binders(fe, bb_list(stmts, 0, acc)),
    NExpr(IfExpr(c, t, e)) => body_binders(e, body_binders(t, body_binders(c, acc))),
    NExpr(MatchExpr(sc, arms)) => bb_arms(arms, 0, body_binders(sc, acc)),
    NExpr(CallExpr(f, args)) => bb_list(args, 0, body_binders(f, acc)),
    NExpr(BinOpExpr(_, l, r)) => body_binders(r, body_binders(l, acc)),
    NExpr(UnaryOpExpr(_, inner)) => body_binders(inner, acc),
    NExpr(PipeExpr(_, l, r)) => body_binders(r, body_binders(l, acc)),
    NExpr(MakeListExpr(es)) => bb_list(es, 0, acc),
    NExpr(MakeTupleExpr(es)) => bb_list(es, 0, acc),
    NExpr(MakeStringExpr(fs)) => bb_list(fs, 0, acc),
    NExpr(ShowExpr(inner)) => body_binders(inner, acc),
    NExpr(IndexExpr(rc, ix)) => body_binders(ix, body_binders(rc, acc)),
    NExpr(FieldExpr(rc, _)) => body_binders(rc, acc),
    NExpr(ResumeExpr(v, _)) => body_binders(v, acc),
    NExpr(LabeledArg(_, v)) => body_binders(v, acc),
    NExpr(MakeRecordExpr(flds)) => bb_fields(flds, 0, acc),
    NExpr(RecordUpdateExpr(b, flds)) => bb_fields(flds, 0, body_binders(b, acc)),
    NExpr(NamedRecordExpr(_, flds)) => bb_fields(flds, 0, acc),
    NStmt(LetStmt(pat, val, _)) => body_binders(val, acc ++ pat_binders(pat)),
    NStmt(FnStmt(nm, ps, _, _, fb)) => body_binders(fb, cl_param_names(ps, 0, acc ++ [nm])),
    NStmt(ExprStmt(e)) => body_binders(e, acc),
    _ => acc,
  },
}

fn bb_list(ref nodes, i, acc) =
  if i >= len(nodes) { acc } else { bb_list(nodes, i + 1, body_binders(list_index(nodes, i), acc)) }

fn bb_arms(ref arms, i, acc) = if i >= len(arms) {
  acc
} else {
  match list_index(arms, i) {
    (pat, abody) => bb_arms(arms, i + 1, body_binders(abody, acc ++ pat_binders(pat))),
  }
}

fn bb_fields(ref flds, i, acc) = if i >= len(flds) {
  acc
} else {
  match list_index(flds, i) {
    (_, v) => bb_fields(flds, i + 1, body_binders(v, acc)),
  }
}

fn cl_param_names(ref params, i, acc) = if i >= len(params) {
  acc
} else {
  cl_param_names(params, i + 1, acc ++ [param_name(list_index(params, i))])
}

// The two record annotations below are the LAST pins of this family — the
// String pin on in_owner_names is GONE (its site twins under the structured
// enc and the twin's emit reads str_eq). A field read on a CONSTRAINED-open
// record (TRecordOpen) does not yet heal: the witness matches TVar receivers
// only, and open-record offsets over a partial field set are the wrong-field
// bug — the row must resolve under the bracket. That dig deletes these two.
fn cl_state_names(ref states: [{init: Node, name: String}], i, acc) = if i >= len(states) {
  acc
} else {
  let st = list_index(states, i)
  cl_state_names(states, i + 1, acc ++ [st.name])
}

fn cl_arm_names(ref arms: [{args: [String], body: Node, op_name: String}], i, acc) = if i >= len(arms) {
  acc
} else {
  let arm = list_index(arms, i)
  cl_arm_names(arms, i + 1, body_binders(arm.body, acc ++ [arm.op_name] ++ arm.args))
}

fn cl_op_names(ref ops, i, acc) = if i >= len(ops) {
  acc
} else {
  match list_index(ops, i) {
    (opname, _, _, _) => cl_op_names(ops, i + 1, acc ++ [opname]),
  }
}

// float_of_int / float_to_int are PRIMITIVES — the Int↔Float conversions lower
// recognizes (→ f64.convert_i32_s / i32.trunc_f64_s) that no .mn body can
// express. Their TYPES belong in the env like any scheme, read live by a call
// site, instead of flooring to E_MissingVariable (175 in the wheel) — the free
// var an untyped float_of_int leaves cannot force `float_of_int(n) * x` to
// Float, so the product's other operand floors to i32. Registered before
// pre_register so every module sees them; pure, monomorphic.
fn register_primitives() = {
  env_extend(
    "float_of_int",
    Frozen([], TFun([mk_param("_", TInt)], TFloat, mk_ef_pure())),
    Declared("float_of_int"),
    FnScheme
  )
  env_extend(
    "float_to_int",
    Frozen([], TFun([mk_param("_", TFloat)], TInt, mk_ef_pure())),
    Declared("float_to_int"),
    FnScheme
  )
}

// Two phases, and the order is load-bearing. Aliases are pure env writes
// with no body dependence — pre-pass citizens — so they register FIRST,
// before any fn signature quantifies its params. A fn used before its
// alias is declared (`fn f(span: ValidSpan)` in parser.mn precedes
// `type ValidSpan` in types.mn — src/ sorts before types.mn, which sorts
// last in the concatenated wheel) then reads the LIVE alias edge instead
// of baking a bare nominal TName that the main walk can never refine
// (build_param_types re-resolves an alias name like Vs to TAlias(Vs, TRefined(Int, _)) and
// unify(bare-TName Vs, Int) floors at the leaf — the `Span vs ValidSpan`
// / `Int vs ValidOffset` class, 362 census errors, Carried-Truth: the
// graph drew the alias edge; quantify_ctor_ty re-derived a nominal name).
fn pre_register_decls(stmts) = {
  refuse_duplicate_type_decls(stmts, 0, len(stmts), smap_new())
  each(pre_register_alias, stmts)
  each(pre_register_effect, stmts)
  // The duplicate-fn refusal is keyed by THIS WALK's own seen-set, never
  // by the env: an existing FnScheme entry may be a PRIOR JUDGMENT of the
  // same tree (the incremental cursor re-registers a changed module into
  // the restored world; re-registration shadows, which IS the re-judgment
  // semantics) — only a second decl within one statement list is the
  // violation.
  fold(smap_new(), pre_register_stmt, stmts)
  ()
}

// One `type` namespace, one walk: every type head — transparent alias,
// refined alias, ADT/nominal record — claims its name once per registration
// walk; a second claim reports EDuplicateTypeName at ITS decl span. Without
// the refusal the decls silently MERGE: each decl's ctors tag from 0, so a
// cross-tag match returns the wrong arm with zero diagnostics (measured:
// exit 13 where 99 was meant — Halt, tag 0 of a second Signal decl, matched
// the first decl's Go arm). Membership is a WALK-LOCAL seen-set, never an
// env probe: a multi-variant decl registers only its CTOR names, so the env
// holds nothing under the type name to probe, and the same name legitimately
// re-registers across walks (the two-pass judge's trial and final; the main
// walk overwriting pre-registered entries). Registration proceeds past the
// report — productive under error; the armed class refuses the executable
// at the gate. Both registration walks run it: the trial's copy is absorbed
// by diag_quiet, the final's reports for real.
fn refuse_duplicate_type_decls(stmts, i, n, seen) = if i >= n {
  ()
} else {
  match list_index(stmts, i) {
    N(body, span, _) => {
      let claimed = match body {
        NStmt(AliasStmt(name, _)) => type_decl_claim(seen, name, span),
        NStmt(RefineStmt(name, _, _)) => type_decl_claim(seen, name, span),
        NStmt(TypeDefStmt(name, _)) => type_decl_claim(seen, name, span),
        NStmt(RowAliasStmt(name, _)) => type_decl_claim(seen, name, span),
        _ => seen,
      }
      refuse_duplicate_type_decls(stmts, i + 1, n, claimed)
    },
  }
}

fn type_decl_claim(seen, name, span) = match smap_get(seen, name) {
  Some(_) => {
    report(EDuplicateTypeName(name, span))
    seen
  },
  None => smap_add(seen, name, 1),
}

// The alias edges — registration's ONE home. The main walk keeps only
// RefineStmt's predicate Verify obligation.
fn pre_register_alias(ref node) = match node {
  N(body, _, _) => match body {
    NStmt(RefineStmt(name, base_ty, pred)) => env_extend(name, Frozen([], TAlias(name, TRefined(base_ty, pred))), Declared(name), FnScheme),
    NStmt(AliasStmt(name, ty)) => env_extend(name, Frozen([], TAlias(name, ty)), Declared(name), FnScheme),
    NStmt(RowAliasStmt(name, effs)) => // A named effect row is an ENV fact: the triples stored verbatim,
    // expansion at build_declared_row (Hβ.types.named-effect-rows).
    // The scheme's Ty is nominal only so the entry has a shape; the
    // row alias never participates in type unification.
    env_extend(name, Frozen([], TName(name, [])), Declared(name), RowAliasKind(effs)),
    _ => (),
  },
}

// The effect decls — registration's OWN phase, before any handler sig
// (pre_register_alias's precedent one namespace over): a handler's
// identity derives its effect from the arms' op names THROUGH the effect
// env, so a HandlerDeclStmt that precedes its EffectDeclStmt in source
// order read an incomplete env and registered with a broken effect
// binding — the install then absorbed NOTHING and the executable gate
// refused a fully-handled program (measured 2026-07-29: intern_table
// moved to lexer.mn, which sorts before types.mn's `effect Intern`, and
// the whole wheel refused with "no install anywhere").
fn pre_register_effect(ref node) = match node {
  N(body, _, _) => match body {
    NStmt(EffectDeclStmt(name, params, ops)) => register_effect_ops(name, params, ops),
    _ => (),
  },
}

fn pre_register_stmt(seen, ref node) = match node {
  N(body, span, handle) => match body {
    NStmt(FnStmt(name, params, ret_ann, _effs, _body_node)) => match smap_get(seen, name) {
      Some(_) => {
        report(EDuplicateFnName(name, span))
        seen
      },
      None => {
        pre_register_fn_sig(name, params, ret_ann, handle, span)
        smap_add(seen, name, 1)
      },
    },
    NStmt(TypeDefStmt(name, variants)) => {
      register_type_constructors(name, variants)
      seen
    },
    NStmt(HandlerDeclStmt(hname, _ename, config, state, arms)) => {
      pre_register_handler_sig(hname, config, state, arms)
      seen
    },
    _ => // EffectDeclStmt registered in the pre_register_effect phase above —
    // every handler sig in THIS fold reads a complete effect env.
    seen,
  },
}

// The handler's identity IS a parsed fact: its effect (derivable from the
// arms' op names + the effect env entry), its instance type, its config shape,
// its residual row handle, and its HandlerKind. All of these read only parsed
// structure and the effect env (already registered by EffectDeclStmt above).
// Registering the identity here makes handler names resolve at forward-reference
// sites (`~> handler_name` before the handler's declaration in source order),
// and lets handler_e_r extract the HandlerKind for the ~> row algebra.
// The main walk's register_handler overwrites with the fully-inferred scheme
// after arm-body inference, reading the pre-registered r_handle so forward
// references share the same residual row handle.
fn pre_register_handler_sig(hname, config, state, arms) = {
  let ename = derive_handler_ename(arms, hname)
  // A state field naming an op of the HANDLED effect is refused at the decl:
  // inside the arm bodies a bare `name` then means both the state read and
  // the op call — measured, the collision compiles clean and returns the
  // WRONG value (scratchpad collide: 5 where 42 was meant), and in a second
  // shape silently unbinds the arm's own parameter. The effect env is already
  // populated (EffectDeclStmt pre-registers above), so the op-ness read is
  // live; an effect declared after its handler in source order under-detects,
  // never falsely fires.
  each(
    (sf) => {
      let fname = state_field_name(sf)
      match env_lookup(fname) {
        Some(entry) => match entry {
          (_, _, kind) => match kind {
            EffectOpScheme(op_effect, _, _, _) => if op_effect == ename {
              match state_field_init(sf) {
                N(_, fspan, _) => report(EHandlerStateShadowsOp(hname, fname, fspan)),
              }
            } else {
              ()
            },
            _ => (),
          },
        },
        None => (),
      }
    },
    state
  )
  let inst_vars = mint_instance_vars(ename, effect_instance_arity(ename), 0)
  let inst_ty = TName(ename, map((v) => TVar(v), inst_vars))
  let inst_h = mint(Inferred("effect '{ename}' instance"))
  graph_bind(inst_h, inst_ty, Inferred("effect '{ename}' instance"))
  let handler_ty = TName("Handler", [inst_ty])
  let config_tparams = mint_handler_config_tparams(config, hname, 0)
  let scheme_body =
    if len(config) == 0 { handler_ty } else { TFun(config_tparams, handler_ty, mk_ef_closed([])) }
  let scheme_body_h = mint(Inferred("handler scheme of '{hname}'"))
  graph_bind(scheme_body_h, scheme_body, Inferred("handler scheme of '{hname}'"))
  let r_handle = graph_fresh_row(Inferred("residual of handler '{hname}'"))
  // The KIND carries the MINTED tparams, never the parse placeholders:
  // the residual's install read (residual_with_config_args) chases these
  // cells to the config fns' row roots, and a placeholder chases nowhere.
  env_extend(
    hname,
    Frozen(inst_vars, scheme_body),
    Declared(hname),
    HandlerKind(r_handle, config_tparams, state, arms)
  )
}

fn pre_register_fn_sig(name, params, ret_ann, handle, span: ValidSpan) = {
  // The duplicate-fn refusal lives in pre_register_stmt's walk-local
  // seen-set (an env-based check misread a prior judgment's entry as a
  // duplicate the moment the incremental cursor re-registered a module
  // into the restored world).
  let param_handles = mint_param_placeholders(params, name)
  // An authored `-> RetTy` is a CONSTRAINT the pre-scheme must CARRY, not
  // discard (the parse_let-annotation twin at the return position). Binding
  // it here grounds every FORWARD callsite: an unannotated forward ref
  // instantiates a quantified fresh return that its later real inference
  // never reaches, so a use with no local grounding floors to word width —
  // caret_proximity_weight's f64 result met an i32 definition, the indirect
  // call type mismatch the felt loop was the first to execute. Absent
  // annotation ⇒ the fresh var, inferred as before.
  let ret_handle = mint(FnReturn(name, Inferred("return of '{name}'")))
  match ret_ann {
    N(ret_ann_body, _, _) => {
      // An AUTHORED return rides the TFun as the resolved Ty VALUE, not the
      // cell: a value inside the record cannot be class-contaminated, so the
      // interval fragment's callee read (callee_ret_lo) sees the authored
      // refinement verbatim at every call — the assume-the-signature
      // induction with nothing to launder (a chased ret VAR reaches the
      // obligation's own class through tail-call merging; the value never
      // does). The cell still binds (forward-ref grounding + quantification).
      let ret_component = match ret_ann_body {
        NTypeAnn(ann_ty) => // Resolve through the alias edge FIRST (quantify_ctor_ty — the same
        // resolution build_param_types and apply_let_annotation use): binding
        // the raw syntactic TName made a refined alias look NOMINAL, so the
        // proposer enumerated constructors of Positive (zero) instead of
        // integer seeds under its refinement.
        match quantify_ctor_ty(ann_ty, []) {
          (resolved_ret, _q) => {
            graph_bind(ret_handle, resolved_ret, Located(span, Declared(name)))
            resolved_ret
          },
        },
        _ => // The absent-annotation marker (the parser mints LitUnit when no
        // `->` is authored): the return stays the fn's own minted cell —
        // the inferred form, not a fabricated absorber.
        //
        // drift-audit: ignore
        TVar(ret_handle),
      }
      let row_handle = graph_fresh_row(Inferred("effects of '{name}'"))
      // THE PREREG ROW IS BARE (the movers' root, deleted 2026-08-07): it
      // carried the declared names as presents ("the inline-known half of
      // a forward-ref's row"), which was a DECLARATION entering the supply
      // side — the trial's self and intra-group charges folded the
      // declared flavor into published rows while the final (which skips
      // fn prereg) published the proof, and every over-declared fn became
      // a mover (fill_row's Memory+Alloc vs Memory, cornered by body
      // ablation). The forward-ref channel the carry served is the LIVE
      // EDGE now: a charge chains this prereg cell, the completion prune
      // keeps prereg cells as the cycle channel, and the callee's own
      // judgment fills it with PROVEN content the caller reads live. The
      // declaration lives in the GATE alone (ruling (1)).
      let fn_ty =
        TFun(build_param_types(params, param_handles), ret_component, mk_ef_open([], row_handle))
      graph_bind(handle, fn_ty, Located(span, Declared(name)))
      // Quantify the fresh param/return/row vars so a FORWARD reference — a fn used
      // before its own body is inferred (e.g. src/ inferred before lib/prelude, so
      // lower.mn's map/fold calls precede the prelude bodies that generalize them) —
      // is POLYMORPHIC, not a shared monotype. Frozen([]) here made every forward
      // call site reuse ONE set of param vars, so their argument record types all
      // unified into one (the handler-arm type {args,body,op_name} absorbing the
      // placement {ename,name,slot} + group {ename,arms} fields → the 7-field bloat
      // → arm.body@8). This IS HM generalization of forward refs: instantiate
      // freshens per call site. Recursion stays monomorphic — infer_fn binds the
      // handle (graph_bind above + the unify branch) so the vars are bound by the
      // time the body's self-calls instantiate this scheme.
      // The quantifier is generalize's own floor, ONE home: a hand-rolled
      // Frozen(free_in_ty(fn_ty), ...) here quantified the TOP-row cell —
      // free_in_ty(TFun) collects the row's free tail — so every forward
      // call site freshened its row copy above the mint ceiling, the
      // charge chained the copy, the completion prune dropped it as pure,
      // and the caller's trial row closed WITHOUT the callee's effects
      // (join_loop missing str_concat's Alloc — the movers' row channel).
      // generalize keeps row-sort cells unquantified-and-shared, so a
      // forward charge chains THIS prereg cell — the live link the prune
      // is designed to keep — and the callee's own judgment fills it.
      // Located so every reader of this entry's reason (the Why chain, the
      // executable gate's unhandled-effect diagnostic) projects the DECL's span.
      // The publish carries the CELL, not a snapshot of it: the quantifier is
      // a projection every reader runs at ITS moment of consumption
      // (judgment_ty / judgment_pair / instantiate, or the shallow chase below
      // the infer layer), so a decl the rest of the walk refines is read
      // refined instead of frozen at whatever it was when it finished.
      env_extend(name, Live(handle), Located(span, Declared(name)), FnScheme)
    },
  }
}

// ─── Order-independent verdicts (Hβ.infer.order-independent-verdicts) ───
// A forward reference reads whatever the env holds at the call site: under
// one pass that is the LOOSE pre-registered scheme, so a caller's verdict
// depends on source ORDER. The pair closes the class: the TRIAL pass runs
// the whole walk with diagnostics absorbed — its one product is the env
// holding every fn's FINAL scheme — and the FINAL pass re-judges fresh
// nodes with every reference, forward included, resolving those finals.
// (The pair is the condemned CADENCE, not the closure: order-independence
// closes structurally at rung 3 — live cells + decl→site propagation —
// and the second pass DELETES; PLAN's resolved design D5/D8.)
// Two passes of one walk, sharing one graph and one env (pass-2 entries
// shadow; pass-1 handles stay live under them). The trial skips the prose
// gate (comment_refs_check judges once, in the reporting pass); the final
// skips fn PRE-registration — the env already holds the truth, and
// infer_fn's unbound-handle arm self-registers monomorphic recursion. The
// duplicate-fn refusal already lives in the registration walk's own
// seen-set (the incremental cursor's landing), so re-registration is
// clean by construction.
fn infer_program_trial(stmts) = {
  register_primitives()
  pre_register_decls(stmts)
  // The completion prune's boundary: everything below this frontier is a
  // prereg cell (a decl's live accumulator — kept as a shared link);
  // everything minted above it during the walk is judgment scratch (a
  // still-free one drops as pure at its decl's finalize).
  set_mint_ceiling(graph_next())
  // The summaries classify ONCE, here — the grades read arm STRUCTURE,
  // which no pass changes, and the value is name-keyed (parse-
  // independent), so the final REUSES this value instead of re-walking
  // the whole tree (Carried-Truth at the pass boundary).
  let summ = classify_fixpoint(stmts)
  set_summaries(summ)
  // The DAG is PARSE truth, read before any judgment: free names +
  // decl names give the Tarjan BINDING GROUPS, so the trial itself
  // walks callee-first with each cycle judged as one unit under the
  // cycle discipline. Its finals are MEANT to be the fixpoint on
  // arrival; the movers count is the measured distance from that claim.
  // This comment used to name the distance's cause as snapshot publishes
  // under-resolving, and to promise that live join-cells would drive it
  // to zero. MEASURED FALSE, 2026-09-01: both publishes became Live(handle)
  // and every reader was made total over the posture, and the count did not
  // move — 470 before, 470 after, the same four flips. The snapshot was
  // never stale WITHIN a pass, because this walk is callee-first and a decl
  // is finished when it publishes. The divergence is BETWEEN GENERATIONS: a
  // trial cell and a final cell are different nodes in different parses, and
  // no amount of liveness inside one pass can make two of them agree. So the
  // count cannot reach zero while both passes exist, and the retirement
  // condition below is not a gate the walk can pass — the pass is what has
  // to go. The layers ride out to order the final's planned sweep (one
  // collection, two readers).
  let frees_all = stmt_frees(stmts)
  let name_idx = layer_name_index(map(stmt_decl_name, stmts), 0, smap_new())
  let layers = stmt_layers_ast(frees_all, name_idx)
  let groups = scc_groups(frees_all, name_idx)
  let rows = trial_group_walk(stmts, groups, make_list(len(stmts)), 0)
  finalize_continuation_boundaries(0, graph_next())
  assert_row_gates_drained()
  (rows, layers, summ)
} ~> infer_ctx ~> fresh_for_inference ~> resume_summaries_ctx ~>
// The trial is a WORLD of its own: fresh analysis ledgers absorb its
// verify obligations and ownership/region facts, dying with the
// bracket — without them the trial's undischarged debt accrued into
// the SHARED verify ledger and the final judgment reported doubled
// V_Pending (the capability-hole leg caught the leak as one
// unexpected obligation).
affine_ledger ~> region_tracker ~> verify_ledger

// round_prints — each named stmt's published scheme, fingerprinted.
// Rendered after the trial and after the final; a disagreement names a
// mover — an OVERRIDE (the final's answer ships regardless), never a
// verification verdict. The whole channel retires with the second pass
// at rung 3.
fn round_prints(ref rows) = round_prints_walk(rows, 0, make_list(len(rows)))

// The print computation sits one fn over as the CROSSING form: the
// branch-stack wrong-end fix rides this same landing, but the m2 leg
// judges under the PINNED boot's old judge, which still mis-brackets a
// nested alternative in a consuming arm — the fix cannot accept its own
// natural shape until a fixed judge is pinned (the world_top crossing
// law at the ownership layer). The generation after this pin inlines
// the if/match here and this fn dissolves.
fn row_print(name) = if name == "" {
  ""
} else {
  match env_lookup(name) {
    Some((sch, _, _)) => sch |> judgment_ty |> ty_fingerprint,
    None => "",
  }
}

fn round_prints_walk(ref rows, i, own out) = if i >= len(rows) {
  out
} else {
  match rows[i] {
    (name, _) => round_prints_walk(rows, i + 1, list_set(out, i, row_print(name))),
  }
}

fn prints_equal(ref a, ref b) = if len(a) != len(b) { false } else { prints_equal_walk(a, b, 0) }

fn prints_equal_walk(ref a, ref b, i) =
  if i >= len(a) { true } else if a[i] == b[i] { prints_equal_walk(a, b, i + 1) } else { false }

// frontend — lex |> parse, the judgment's input boundary
fn frontend(source) = source |> lex |> parse_program

// The quiet trial's diagnostics policy: the trial pass exists only to
// finalize schemes; reports drop because the reporting pass re-renders
// them (that second derivation is the condemned cadence — the resolved
// design D8; this handler's OTHER consumers — branch brackets, the
// discovery parse — outlive it). All three Diagnostic
// ops carry arms (a partial-effect handler leaves zero fn slots; a perform
// through one is a garbage dispatch — the tighten_collector constraint).
handler diag_quiet {
  diag_report(d, _line) => resume(),
  diag_errors() => resume(0),
  diag_refusals() => resume(0),
}

// diag_branch — the branch cursor's per-stmt collector (Phase C, C1c-2).
// Same projections as the root arm, rendered AT THE PERFORM (live
// values), banked as lines instead of printed; the local tally answers
// any in-branch diag_errors/diag_refusals read with branch-local truth.
// diag_lines_taken hands the whole fact set to the join.
handler diag_branch with lines = make_list(16), count = 0, errors = 0, refusals = 0 {
  diag_report(diag, line) => // The banked fact carries the DIAG STRUCTURALLY beside the rendered
  // line — the join re-performs diag_report(diag, line) into the root
  // chain, so every Diagnostic forwarder (tighten_collector, the mcp
  // bank) sees a branch report exactly as a live one, and the root's
  // scope register / tally read the diag itself. The old bank kept only
  // (line, span-line, is-error): a branch-fired T_OverDeclared reached
  // the collectors structure-less and the tighten bank read empty —
  // measured the day the daily verbs went converged (every check now
  // judges through the branch bracket).
  {
    let iserr = diag_severity(diag) == SError
    let grown = list_set(list_extend_to(lines, count + 1), count, (diag, line))
    if iserr {
      if diag_refuses(diag) {
        resume() with lines = grown, count = count + 1, errors = errors + 1, refusals = refusals + 1
      } else {
        resume() with lines = grown, count = count + 1, errors = errors + 1
      }
    } else {
      resume() with lines = grown, count = count + 1
    }
  },
  diag_errors() => resume(errors),
  diag_refusals() => resume(refusals),
  diag_lines_taken() => resume(list_to_flat(slice(lines, 0, count))),
}

// The Mycroft speculation's release read (§11 5.3, the fragment) — the
// capture handler hands the driver its held list through this op, the
// diag_lines_taken precedent one bracket over.
effect PolyCapture {
  poly_captured() -> [(DiagKind, String)]
}

// The speculative judgment's diag CAPTURE: an attempt runs under it so
// a retried-and-succeeded judgment leaves no stain — reports HOLD in
// state, structurally beside their rendered lines (the diag_branch
// precedent); the ledger reads forward live (a mid-attempt reader sees
// the enclosing counts — the v1 boundary, noted at the stamp); the
// driver replays the held list outward on accept or drops it for the
// honest re-run.
handler poly_capture with held = [] {
  diag_report(diag, line) => resume() with held = push(held, (diag, line)),
  diag_errors() => resume(diag_errors()),
  diag_refusals() => resume(diag_refusals()),
  poly_captured() => resume(held),
}

// THE ONE JUDGE (Hβ.infer.order-independent-verdicts): every judgment
// site runs this — the stdin compile, the driver DAG (check/audit/
// teach/at/field/session), the warm path, the battery, the repl line.
// The single-pass walk it replaced read loose pre-registrations at
// every intra-module forward reference, so a forward-referenced fn's
// callers bound silently against a free scheme (measured: a
// [tuple]-returning fn declared after its caller flowed into a
// [String] consumer with no refusal — the b1 probe).
//
// ─── The judgment: trial, then a SECOND JUDGE the trial still needs ────
//
// The ROUNDS ARE DELETED (schemes-are-edges' first big rung — the tower
// comes down by deletion, never by better iteration). The trial walks
// callee-first over parse-truth layers with every Tarjan cycle judged
// as one unit under the cycle discipline; the twelve quiet rounds spent
// eleven re-derivations on what one walk should prove, and their own
// per-round re-parse REGENERATED the one oscillator they existed to
// settle (the bound-hit mover was rounds-resident, measured — no
// trial-side fix could clear a rounds-side artifact). The final
// re-judges EVERYTHING against the trial's finals — planned, bracketed,
// reporting. Call that what it is (Morgan's cut, 2026-07-31): NOT
// verification — on a mover it narrates the divergence and proceeds
// with ITS OWN answer, override wearing verification's name; a verifier
// refuses, or the divergence is impossible by construction. The second
// pass is the TWO-GENERATION tower at cadence two, and it takes NO
// improvements (Anchor 2's condemned-forms clause). Its retirement
// condition was written as "movers 0 makes this pass VACUOUS and it
// DELETES" — a gate the walk cannot pass, measured 2026-09-01: schemes
// ARE live join-cells now and the count did not move, because the
// divergence is between the two PARSES, not between a snapshot and a
// cell (the trial-walk comment carries the measurement). The honest
// condition is order-independence closing structurally — decl→site
// propagation, so ONE generation suffices — and then the pass deletes
// and the count goes with it, rather than the count falling first and
// licensing the deletion.
// Per-compile correctness is structural; whole-program verification
// lives at the march, once per landing, never as a standing cadence.
// The tax is measured — PLAN §5.O's cost law carries the curve.
// Broken judgment → diagnostic, never a crawl; the fixpoint oracle
// arbitrates behind it.
// ONE LEX PER COMPILE. The two PARSES are load-bearing and stay: the final
// walks a FRESH generation of nodes, which is exactly what `pstart` below
// reads as its lower bound, so parsing once and judging the same tree twice
// would collapse the boundary the tower is built on. The two LEXES were never
// load-bearing — a token is a value, it mints nothing, and lexing the same
// bytes twice is the Carried-Truth violation with no compensating structure.
// This is not an improvement to the condemned tower (Anchor 2): its judgment,
// its cadence and its two generations are untouched, and when rung 3 deletes
// the second pass this seam simply loses a caller.
fn infer_program_converged(src) = {
  let toks = lex(src)
  match {
    toks |> parse_program |> infer_program_trial
  } ~> diag_quiet {
    (rows, layers, summ) => {
      let flat_rows = list_to_flat(rows)
      let prints = round_prints(flat_rows)
      // The final's parse START, captured before its own parse: the
      // crc walk's lower bound, so the backtick judge reads only THIS
      // pass's comment cells.
      let pstart = graph_next()
      let out = toks |> parse_program |> infer_program_final(flat_rows, layers, pstart, summ)
      // The divergence read: the final's publishes are the env's latest
      // entries, so re-rendering the same names compares the two passes.
      // Nothing refuses on a mismatch — the final's answer already
      // shipped — which is why this is a count driven to zero, not a
      // gate.
      let prints2 = round_prints(flat_rows)
      // The arena census (Hβ.perf.per-decl-arena 2a-ii, the corrected DEP
      // chain's named next landing): the accumulated image-classified byte
      // count, read from the extent-delta account the image_enter/exit
      // brackets feed. Same maintainer channel and scope law as the movers
      // line — unscoped compiles (march / census / battery) keep it, a
      // user-target verb's ScopeAt quiets it. 2b's image/scratch boundary
      // fixes itself from this measured number, never from a claim.
      match diag_scope_of() {
        ScopeAll => eprint_string("image: {int_to_str(image_bytes())} image-classified byte(s)\n"),
        _ => (),
      }
      if prints_equal(prints, prints2) {
        ()
      } else {
        // The movers report is the MAINTAINER'S instrument — it rides the
        // register's scope read, so the march / census / battery (never
        // scoped) keep every line, and a user-target verb's ScopeAt
        // quiets the ~21-line block that opened every hello-world's
        // stderr (six audit reports converged on the channel). The block
        // is never about the user's file, so it has no per-span case; a
        // divergence a user must see surfaces as a diagnostic through
        // diag_report, never through this channel.
        match diag_scope_of() {
          ScopeAll => {
            eprint_string("judgment: {int_to_str(movers_count(flat_rows, prints, prints2, 0))} scheme(s) moved between the trial and the final — movers:{movers_line(flat_rows, prints, prints2, 0, 0)}\n")
            movers_diff(flat_rows, prints, prints2, 0, 0)
          },
          _ => (),
        }
      }
      out
    },
  }
}

// The TOTAL, beside the capped display: the sixteen-slot line names the
// CLASS, and its cap hid the magnitude — a family that saturates the
// slots reads the same as one that fills them exactly (measured: the
// solo self-recursive family filled all sixteen on every weave, so a
// new mover in user code was invisible behind known lib movers). The
// count is what the ratchet reads when this channel goes zero-tolerance
// — and zero RETIRES the second pass outright: a vacuous final that
// survives is the rounds regrown at cadence two.
fn movers_count(ref rows, ref prev_prints, ref cur_prints, i) = if i >= len(rows) {
  0
} else {
  match rows[i] {
    (name, _) => if name != "" && cur_prints[i] != prev_prints[i] {
      1 + movers_count(rows, prev_prints, cur_prints, i + 1)
    } else {
      movers_count(rows, prev_prints, cur_prints, i + 1)
    },
  }
}

// The movers report names its residue: which schemes the final OVERRODE
// against the trial's publish (first sixteen — the class is what
// matters, not the tail). Retires with the channel at rung 3 (D8).
fn movers_line(ref rows, ref prev_prints, ref cur_prints, i, shown) = if i >= len(rows) || shown >= 16 {
  ""
} else {
  match rows[i] {
    (name, _) => if name != "" && cur_prints[i] != prev_prints[i] {
      " {name}{movers_line(rows, prev_prints, cur_prints, i + 1, shown + 1)}"
    } else {
      movers_line(rows, prev_prints, cur_prints, i + 1, shown)
    },
  }
}

// The divergence render — the first movers' trial and final fingerprints verbatim.
// The fingerprints are alpha-normalized total renders (ty_fingerprint),
// so the A/B byte-diff IS the flipping component; four movers bound the
// stderr budget (one flipping component repeats across the family).
fn movers_diff(ref rows, ref prev_prints, ref cur_prints, i, shown) = if i >= len(rows) || shown >= 4 {
  ()
} else {
  match rows[i] {
    (name, _) => if name != "" && cur_prints[i] != prev_prints[i] {
      {
        eprint_string("convergence: flip {name}\n  A: {prev_prints[i]}\n  B: {cur_prints[i]}\n")
        eprint_string(probe_tail_why(name))
        probe_entry_hist(name)
        eprint_string("  re-read: {row_print(name)}\n")
        movers_diff(rows, prev_prints, cur_prints, i + 1, shown + 1)
      }
    } else {
      movers_diff(rows, prev_prints, cur_prints, i + 1, shown)
    },
  }
}

// Graduated probe (⟳(3) — the movers channel's diagnosis probe): the
// mover's published row-tail cell and the REASON on it — the Why
// engine naming whoever bound a published cell between the trial and
// final fingerprints. Retires with its channel at rung 3 (D8). Its
// first firing killed the attractor theory (the
// flips were a monotone front) and named the SCC-chain remainder.
fn probe_tail_why(ref name) = match env_lookup(name) {
  None => "  why: no env entry\n",
  Some((sch, _, _)) => match judgment_ty(sch) {
    TFun(_, _, row) => match row {
      EfRow(_, _, tail) => match tail {
        EtOpen(vs) => "  tail v{int_to_str(last(vs))} ({int_to_str(len(vs))} edge(s)): {show_reason(graph_reason_at(last(vs)))}\n",
        EtClosed => "  tail closed on the scheme face\n",
        EtAll => "  tail all on the scheme face\n",
      },
    },
    _ => "  scheme not TFun-rooted\n",
  },
}

// The flip's entry HISTORY — every env generation of the mover, index
// + row-tail letter (o = open var, c = closed, a = all, ? = not
// TFun-rooted): the A-vs-B histories discriminate a STALE entry
// surfacing (an old index answering) from an OPEN publish appending
// (a channel still unpinned). Movers only; the walk is one env
// snapshot, and it dies with the channel at rung 3.
fn probe_entry_hist(ref name) = match env_snapshot() {
  Env(entries) => eprint_string("  env-hist{entry_hist_line(entries, name, 0, 0, "")}\n"),
}

fn entry_hist_line(ref entries, ref name, i, count, acc) = if i >= len(entries) {
  " n={int_to_str(count)}{acc}"
} else {
  match entries[i] {
    (en, sch, _, _) => if en == name {
      entry_hist_line(entries, name, i + 1, count + 1, "{acc} @{int_to_str(i)}:{tail_letter(sch)}")
    } else {
      entry_hist_line(entries, name, i + 1, count, acc)
    },
  }
}

fn tail_letter(ref sch) = match judgment_ty(sch) {
  TFun(_, _, row) => match row {
    EfRow(_, _, tail) => match tail {
      EtOpen(_) => "o",
      EtClosed => "c",
      EtAll => "a",
    },
  },
  _ => "?",
}

// Every stmt's free-name list, collected once from the parse tree.
fn stmt_frees(ref stmts) = stmt_frees_walk(stmts, make_list(len(stmts)), 0)

fn stmt_frees_walk(ref stmts, own out, i) = if i >= len(stmts) {
  out
} else {
  stmt_frees_walk(stmts, list_set(out, i, list_to_flat(collect_free_vars(stmts[i], []))), i + 1)
}

// The stmt-layer projection over PARSE truth. Free names that key no
// decl (lib vocabulary, locals) answer depth 0 through the index miss.
// This is the DAG the fan's frozen bases require complete: every
// reference IS an edge here, because collect_free_vars walks the
// source itself. The frees ARE the call DAG, WHOLE — depth = 1 + max
// over every referenced decl's depth, both directions, by memoized
// descent (a backward-only pass dropped forward edges, and closure
// then climbed one caller layer per pass — the rounds-era resolution
// front, measured 2026-07-30). A cycle contributes no edge from an
// on-stack callee: the SCC's members take depths from their acyclic
// callees and judge together as one binding group (the cycle
// discipline — where the rounds once iterated the cycle's rows).
fn stmt_layers_ast(ref frees_all, ref name_idx) = {
  let n = len(frees_all)
  match layers_dfs_all(frees_all, name_idx, make_list(n), make_list(n), 0) {
    (depths, _) => depths,
  }
}

// state[i]: 0 unvisited · 1 on the walk stack · 2 done (depths[i] final).
fn layers_dfs_all(ref frees_all, ref name_idx, own depths, own state, i) = if i >= len(frees_all) {
  (depths, state)
} else {
  match layers_dfs(frees_all, name_idx, depths, state, i) {
    (d2, s2) => layers_dfs_all(frees_all, name_idx, d2, s2, i + 1),
  }
}

fn layers_dfs(ref frees_all, ref name_idx, own depths, own state, i) = if state[i] != 0 {
  (depths, state)
} else {
  match layers_frees_max(frees_all, name_idx, depths, list_set(state, i, 1), frees_all[i], 0, 0) {
    (d2, s2, best) => (list_set(d2, i, best), list_set(s2, i, 2)),
  }
}

fn layers_frees_max(ref frees_all, ref name_idx, own depths, own state, ref frees, j, best) = if j >= len(frees) {
  (depths, state, best)
} else {
  match smap_get(name_idx, frees[j]) {
    None => layers_frees_max(frees_all, name_idx, depths, state, frees, j + 1, best),
    Some(k) => if state[k] == 1 {
      layers_frees_max(frees_all, name_idx, depths, state, frees, j + 1, best)
    } else {
      match layers_dfs(frees_all, name_idx, depths, state, k) {
        (d2, s2) => {
          let cand = d2[k] + 1
          layers_frees_max(frees_all, name_idx, d2, s2, frees, j + 1, if cand > best { cand } else { best })
        },
      }
    },
  }
}

// ─── Binding groups — Tarjan SCCs over the same frees DAG ───────────────
// The classic form the SOTA still runs on (GHC's binding groups; Salsa's
// cycle recovery is the discover-at-runtime cousin — Mentl's DAG is parse
// truth known up front, so it gets the stronger static form): groups pop
// in callee-first topological order BY CONSTRUCTION (a sink SCC completes
// first), each group judged ONCE with members sharing LIVE monomorphic
// entries, generalized together at group exit — mutual recursion
// constrains itself through shared cells within one judgment instead of
// through published finals across rounds.
// The walk state is one 7-tuple — (ctr, groups, idx, low, onstk, sp,
// stk): next visit number · popped SCCs (callee-first) · visit number
// per stmt (0 = unvisited) · Tarjan lowlink · stack-membership bit ·
// stack cursor · stack buffer. Destructured whole at each step.
fn scc_groups(ref frees_all, ref name_idx) = {
  let n = len(frees_all)
  match scc_sweep(
    frees_all,
    name_idx,
    (1, [], make_list(n), make_list(n), make_list(n), 0, make_list(n)),
    0
  ) {
    (_, groups, _, _, _, _, _) => groups,
  }
}

fn scc_sweep(ref frees_all, ref name_idx, st, v) = if v >= len(frees_all) {
  st
} else {
  let st2 = match st {
    (ctr, groups, idx, low, onstk, sp, stk) => if idx[v] == 0 {
      scc_visit(frees_all, name_idx, (ctr, groups, idx, low, onstk, sp, stk), v)
    } else {
      (ctr, groups, idx, low, onstk, sp, stk)
    },
  }
  scc_sweep(frees_all, name_idx, st2, v + 1)
}

fn scc_visit(ref frees_all, ref name_idx, st, v) = match st {
  (ctr, groups, idx, low, onstk, sp, stk) => {
    let st1 =
      (ctr + 1, groups, list_set(idx, v, ctr), list_set(low, v, ctr), list_set(onstk, v, 1), sp + 1, list_set(stk, sp, v))
    match scc_edges(frees_all, name_idx, st1, v, frees_all[v], 0) {
      (c2, g2, i2, l2, o2, s2, k2) => if l2[v] == i2[v] {
        scc_pop((c2, g2, i2, l2, o2, s2, k2), v, [])
      } else {
        (c2, g2, i2, l2, o2, s2, k2)
      },
    }
  },
}

fn scc_edges(ref frees_all, ref name_idx, st, v, ref frees, j) = if j >= len(frees) {
  st
} else {
  let st2 = scc_edge_one(frees_all, name_idx, st, v, frees[j])
  scc_edges(frees_all, name_idx, st2, v, frees, j + 1)
}

fn scc_edge_one(ref frees_all, ref name_idx, st, v, free) = match smap_get(name_idx, free) {
  None => st,
  Some(k) => match st {
    (ctr, groups, idx, low, onstk, sp, stk) => if idx[k] == 0 {
      match scc_visit(frees_all, name_idx, (ctr, groups, idx, low, onstk, sp, stk), k) {
        (c2, g2, i2, l2, o2, s2, k2) => {
          let lv = imin(l2[v], l2[k])
          (c2, g2, i2, list_set(l2, v, lv), o2, s2, k2)
        },
      }
    } else if onstk[k] == 1 {
      let lv = imin(low[v], idx[k])
      (ctr, groups, idx, list_set(low, v, lv), onstk, sp, stk)
    } else {
      (ctr, groups, idx, low, onstk, sp, stk)
    },
  },
}

fn scc_pop(st, v, own members) = match st {
  (ctr, groups, idx, low, onstk, sp, stk) => {
    let w = stk[sp - 1]
    let members2 = push(members, w)
    let onstk2 = list_set(onstk, w, 0)
    if w == v {
      (ctr, push(groups, members2), idx, low, onstk2, sp - 1, stk)
    } else {
      scc_pop((ctr, groups, idx, low, onstk2, sp - 1, stk), v, members2)
    }
  },
}

fn imin(a, b) = if a < b { a } else { b }

// ─── ty_fingerprint — the alpha-normalized deterministic scheme render ──
//
// Two passes' judgments of one fn agree exactly when their schemes are
// alpha-equal — but the var HANDLES are fresh per pass, so structural ==
// can never say so. The fingerprint renders a type with vars numbered by
// first occurrence (the alpha normal form), chasing bound vars live, so
// equal judgments print equal strings across passes (the trial-vs-final
// divergence read). Scope, stated honestly: rows render by interned
// name handle (stable per process), EANode effect args and refinement
// predicates render opaque (their nodes re-mint per pass; a false AGREE
// there is backstopped by the march's m3 == m4 oracle, never a false
// mover). Emission dispatches on reprs, structure, and rows — all
// inside the fingerprint. The channel DELETES at the resolved design's
// D8 (residue index): with the second pass gone there are no two
// judgments left to compare.
fn ty_fingerprint(ty) with GraphRead + Memory + Alloc = match fp_ty(ty, smap_new(), 0) {
  (s, _, _) => s,
}

fn fp_ty(ty, map, n) with GraphRead + Memory + Alloc = match ty {
  TInt => ("i", map, n),
  TFloat => ("f", map, n),
  TUnit => ("u", map, n),
  TByte => ("b", map, n),
  TList(el) => match fp_ty(el, map, n) {
    (s, m2, n2) => ("l{s}", m2, n2),
  },
  TTuple(els) => match fp_ty_list(els, map, n) {
    (s, m2, n2) => ("t({s})", m2, n2),
  },
  TFun(params, ret, row) => match fp_params(params, map, n) {
    (ps, m2, n2) => match fp_ty(ret, m2, n2) {
      (rs, m3, n3) => match fp_row(row, m3, n3) {
        (es, m4, n4) => ("fn({ps})->{rs}!{es}", m4, n4),
      },
    },
  },
  TVar(h) => match graph_chase(h) {
    GNode(NBound(inner), _) => fp_ty(inner, map, n),
    _ => fp_var(h, map, n),
  },
  TName(name, args) => match fp_ty_list(args, map, n) {
    (s, m2, n2) => ("N{name}({s})", m2, n2),
  },
  TRecord(fields) => match fp_fields(fields, map, n) {
    (s, m2, n2) => ("r\{{s}\}", m2, n2),
  },
  TRecordOpen(fields, rv) => match fp_fields(fields, map, n) {
    (s, m2, n2) => match fp_var(rv, m2, n2) {
      (vs, m3, n3) => ("ro\{{s}|{vs}\}", m3, n3),
    },
  },
  TRefined(base, _) => // The predicate's nodes re-mint per round — render the base plus an
  // opaque refinement marker (Verify-side, emission-blind).
  match fp_ty(base, map, n) {
    (s, m2, n2) => ("&{s}", m2, n2),
  },
  TCont(r, ans, disc, row) => match fp_ty(r, map, n) {
    (rs, m2, n2) => match fp_ty(ans, m2, n2) {
      (as_, m3, n3) => {
        let ds = match disc {
          OneShot => "1",
          MultiShot => "*",
          Either => "e",
          Abandon => "a",
        }
        match fp_row(row, m3, n3) {
          (es, m4, n4) => ("k({rs}->{ds}{as_}!{es})", m4, n4),
        }
      },
    },
  },
  TAlias(name, inner) => match fp_ty(inner, map, n) {
    (s, m2, n2) => ("A{name}={s}", m2, n2),
  },
  TReprPin(r, base) => // The pin is emission-load-bearing (repr dispatch) — render it.
  match fp_ty(base, map, n) {
    (s, m2, n2) => ("p{repr_wat(r)}={s}", m2, n2),
  },
}

fn fp_var(h, map, n) with Memory + Alloc = {
  let key = int_to_str(h)
  match smap_get(map, key) {
    Some(ord) => ("%{int_to_str(ord)}", map, n),
    None => ("%{int_to_str(n)}", smap_add(map, key, n), n + 1),
  }
}

fn fp_ty_list(ref tys, map, n) with GraphRead + Memory + Alloc = fp_ty_list_walk(tys, 0, "", map, n)

fn fp_ty_list_walk(ref tys, i, acc, map, n) with GraphRead + Memory + Alloc = if i >= len(tys) {
  (acc, map, n)
} else {
  match fp_ty(tys[i], map, n) {
    (s, m2, n2) => fp_ty_list_walk(tys, i + 1, "{acc}{s},", m2, n2),
  }
}

fn fp_params(ref params, map, n) with GraphRead + Memory + Alloc =
  fp_params_walk(params, 0, "", map, n)

fn fp_params_walk(ref params, i, acc, map, n) with GraphRead + Memory + Alloc = if i >= len(params) {
  (acc, map, n)
} else {
  match params[i] {
    TParam(pname, pty, _, resolved, _) => {
      let os = match resolved {
        Own => "o",
        Ref => "r",
        Unmarked => "",
      }
      match fp_ty(pty, map, n) {
        (s, m2, n2) => fp_params_walk(params, i + 1, "{acc}{pname}:{os}{s},", m2, n2),
      }
    },
  }
}

fn fp_fields(ref fields, map, n) with GraphRead + Memory + Alloc =
  fp_fields_walk(fields, 0, "", map, n)

fn fp_fields_walk(ref fields: [(String, Ty)], i, acc: String, map, n) with GraphRead + Memory + Alloc = if i >= len(fields) {
  (acc, map, n)
} else {
  match fields[i] {
    (fname, fty) => match fp_ty(fty, map, n) {
      (s, m2, n2) => fp_fields_walk(fields, i + 1, "{acc}{fname}:{s},", m2, n2),
    },
  }
}

// Rows render by interned name handle — stable within one process, which
// is the loop's whole lifetime. A row's name sets are DEDUPED at birth
// and deliberately ORDERLESS (effects.mn's own law: no algebra consumer
// reads an order, so ef_make imposes none) — but a fingerprint is an
// EQUALITY WITNESS, so this render is the one consumer that needs
// determinism, and it pays for it here, per render, exactly as fp_var
// alpha-numbers vars: names render in ascending handle order (measured
// 2026-07-30: walk_lemit/walk_lemit_top fingerprinted one SET in two
// storage orders and oscillated the cone to the round bound forever).
// The row fingerprints its RESOLUTION, never its raw face: a var tail's
// BINDING is row content (the reading law folds it in), so a raw-face
// walk was bound-content-blind — a stmt whose row tail got taught
// between rounds fingerprinted stable, the final skipped its
// re-judgment, and the stale publish carried the taught mess as its
// face (measured: infer_context's maskless GraphRead/Intern face with a
// prior round's tail). resolve_row applies the masks as it folds, so
// the fingerprint moves exactly when the row's MEANING moves.
fn fp_row(row, map, n) with GraphRead + Memory + Alloc = match resolve_row(row) {
  EfRow(present, absent, tail) => {
    let ps = fp_names(present)
    let as_ = fp_names(absent)
    match tail {
      EtClosed => ("{ps}-{as_}.", map, n),
      EtAll => ("{ps}-{as_}!", map, n),
      EtOpen(vs) => match fp_edges(vs, "", map, n) {
        (es, m2, n2) => ("{ps}-{as_}{es}", m2, n2),
      },
    }
  },
}

// The tail edges into the fingerprint — alpha-numbered through the same
// map every var rides, so edge identity renders stably per render.
// Structural walk (the row walks stay off the Iterate vocabulary).
fn fp_edges(ref vs: [Int], s, map, n) = match vs {
  [] => (s, map, n),
  [v, ...rest] => match fp_var(v, map, n) {
    (vstr, m2, n2) => fp_edges(rest, "{s}{vstr}", m2, n2),
  },
}

// Selection by ascending handle — handles are unique after the dedup
// (one entry per handle; bare/instance collisions upgraded in place),
// sets are ≤16 names, zero allocation.
fn fp_names(ref names) with Memory + Alloc = fp_names_from(names, 0 - 1)

fn fp_names_from(ref names, last) with Memory + Alloc = {
  let idx = fp_names_next_idx(names, last, 0, 0 - 1)
  if idx < 0 {
    ""
  } else {
    let s = match names[idx] {
      ENamed(h) => int_to_str(h),
      EParameterized(h, _) => "{int_to_str(h)}(_)",
      EPure => "",
    }
    "{s}+{fp_names_from(names, eff_name_handle(names[idx]))}"
  }
}

fn fp_names_next_idx(ref names, last, i, best) with Memory = if i >= len(names) {
  best
} else {
  let h = eff_name_handle(names[i])
  let better = h > last && (best < 0 || h < eff_name_handle(names[best]))
  fp_names_next_idx(names, last, i + 1, if better { i } else { best })
}

// The trial IS the sizing oracle: each stmt's row is its declared name and
// its mint count — the graph_next delta around its inference, a fact the
// graph already carries, read at the stmt boundary. The rows feed the
// final pass's planned ranges (the deterministic handle partition,
// types.mn's graph_mint_plan contract) and the stmt-layer projection.
// The trial's walk — binding groups in topological order, rows written
// positionally. A singleton judges as today; a CYCLE judges as ONE unit.
fn trial_group_walk(ref stmts, ref groups, own rows, g) = if g >= len(groups) {
  rows
} else {
  trial_group_walk(stmts, groups, trial_judge_group(stmts, sort(groups[g]), rows), g + 1)
}

// A singleton judges once; a CYCLE iterates locally to its own fixpoint.
// The MEASURED negative that shaped this (2026-07-30): the classic
// binding-group MONO form — members sharing unquantified live cells,
// generalized at group exit — was built here whole and REFUTED by the
// wheel's own judgment: 29 E_TypeMismatch convictions (Int vs Float,
// List(Byte) vs Int) where a cycle member is used at TWO instantiations
// by its co-members. The rounds are a MYCROFT iteration (polymorphic
// recursion by fixpoint) and the wheel genuinely uses that power inside
// its cycles, so the weaker classic form cannot serve. The per-SCC LOCAL
// iteration built next was ALSO killed (the second record below); what
// landed is the cycle DISCIPLINE alone, and the terminal form needs no
// iteration at all — the row equation closes by idempotence at the read
// (the resolved design D3/D4).
// A cycle's members judge once, adjacent, in source order — and the
// SECOND counted kill of the rung stands recorded here (2026-07-30,
// same day as the mono-group kill): per-SCC LOCAL MYCROFT ITERATION —
// probe passes over rollback-refreshed parse nodes (rollback as the
// fresh-node supply), finals frozen to fully-quantified values
// (Frozen(free_in_ty(chase_deep(t)), ·) — the rollback-safe form,
// itself paid for: a carried quantifier set left probe-minted leaves
// unquantified, and the restored mint counter made the next probe
// REUSE their handle numbers) — was built whole and REFUTED by its own
// instrument: simple pairs converge in 2 probes (scan_string_loop /
// handle_escape, spec_resolve, module_imports all measured stable),
// but every generic/concrete-tension family ALTERNATES with period 2
// forever (chase_*_changes, the serialize family, emit_pat_*: params
// flip rl%0 ↔ rlNTy() probe over probe) — re-derivation-from-scratch
// is NOT MONOTONE, concreteness learned in probe k evaporates in k+1,
// and Salsa's own cycle-recovery contract names the cure: a JOIN
// against the last provisional value. Rows have their join
// (graph_bind_row's lattice); TYPE-scheme generality does not — and
// the widening join was then BUILT WHOLE and REVERTED by the vet
// (2026-07-30: tower regrowth, cost without cure). The remainder is
// rung 3's schemes-are-edges dissolution, never a better iteration;
// iterating without a join taxed a 45-member group forty-seven
// probes to no fixpoint, and that measurement stands as the kill's
// record.
// A SINGLETON SCC WITH A SELF-EDGE IS A CYCLE, and `len(members) > 1`
// said it was not — the discipline's own entry test was a wrong proxy
// for cyclicity (the audit's measurement: every self-recursive fn on
// every weave flips trial-open → final-closed, and that family
// SATURATES the movers display's sixteen slots, so a NEW mover in user
// code hid behind known lib movers — a gate that always fires). The
// two pieces that fix it apply to every group; only the exit sweep is
// genuinely multi-member work.
fn trial_judge_group(ref stmts, members, own rows) = {
  // THE CYCLE DISCIPLINE (the schemes-are-edges arc's first rung, replacing
  // the refuted iteration direction whole — the vet's redirect executed):
  // monomorphic recursion by default, the signature price for polymorphic
  // recursion. At group entry an UNSIG'D member's env view goes MONO —
  // Frozen([], fn_ty) over the SAME pre-registered skeleton — so an
  // intra-cycle forward use TEACHES the callee's actual param/ret cells
  // (instantiate of an empty-q scheme returns the live record) instead of
  // discarding its demand into a fresh copy (the disconnected-vars class:
  // the crawl's root, one stale link per round). A FULLY-ANNOTATED member
  // keeps its quantified pre-registration: its sig IS its declared
  // polymorphism, instantiated per use — polymorphic recursion by intent,
  // the price every HM judge charges (inference there is undecidable).
  // After the walk, EVERY member re-generalizes: the group-exit sweep
  // publishes finals over the group's fully-resolved cells, so an early
  // member's scheme carries a late member's resolution instead of
  // quantifying a then-free var the frozen-read law would forever freshen.
  group_mono_views(stmts, members, 0)
  // The group's member names ride the judgment as PARSE truth. ONE
  // consumer since the verbatim-edge charge landed (the B1+B3 arc —
  // the re-aim it once served is deleted): the declared-row deferral,
  // which parks a cycle member's gate until its co-member chains close.
  set_group_members(map((j) => stmt_decl_name(stmts[j]), members))
  let rows2 = group_judge_members(stmts, members, rows, 0)
  set_group_members([])
  // The exit sweep is the one genuinely multi-member piece: it exists so
  // an EARLY member's scheme carries a LATE member's resolution. A
  // singleton has no late member — its own infer_fn publish IS the
  // final state, and re-publishing it would only append an identical
  // env entry per decl. THE COMPLETION FOLD runs first (D4's essential
  // half at the trial): every member's row cell re-finalizes with the
  // whole group judged, so the resolve folds co-member content through
  // the live edges and the re-published schemes carry the cycle's whole
  // truth instead of each decl-exit snapshot.
  if len(members) > 1 {
    group_completion_fold(stmts, members, 0)
    group_final_publish(stmts, members, 0)
  } else {
    ()
  }
  // B4 (rung 3): the deferred gates fire HERE — the group's own
  // completion event, with every member's chains closed by the fold
  // above (a solo's park drains at its own exit the same way; groups
  // run sequentially, so the parked set at exit IS this group's). The
  // pass tail demotes to the assert-empty belt.
  drain_deferred_row_gates()
  rows2
}

fn group_mono_views(ref stmts, ref members, j) = if j >= len(members) {
  ()
} else {
  match stmts[members[j]] {
    N(sbody, _, _) => match sbody {
      NStmt(FnStmt(name, params, ret_ann, _, _)) => if fn_fully_sigd(params, ret_ann) {
        ()
      } else {
        match env_lookup(name) {
          Some((sch, reason, FnScheme)) => match judgment_pair(sch) {
            (q, fn_ty) => // TYPE cells share (mono — the intra-cycle demand teaches the
            // callee's actual param/ret cells); ROW handles stay QUANTIFIED,
            // freshening per use — a shared row cell would let every
            // application site's symmetric row unify contaminate the callee's
            // own row (measured: five declared-row mismatches the moment the
            // full-mono view landed — the directional-edge law's class, the
            // row channel is a FLOW, never a shared cap).
            env_extend(name, Frozen(row_handles_only(q, 0), fn_ty), reason, FnScheme),
          },
          _ => (),
        }
      },
      _ => (),
    },
  }
  group_mono_views(stmts, members, j + 1)
}

// A member is SIG'D when every param carries an authored type (the parser
// mints TVar placeholders for unannotated params — the discriminator
// build_param_types dispatches on) and the return is authored. Lowercase
// type params in the annotations are the DECLARED polymorphism (the case
// rule), quantified by the pre-registration — exactly the generality the
// sig prices.
fn fn_fully_sigd(ref params, ref ret_ann) = match ret_ann {
  N(rbody, _, _) => match rbody {
    NTypeAnn(_) => params_all_annotated(params, 0),
    _ => false,
  },
}

fn params_all_annotated(ref params, i) = if i >= len(params) {
  true
} else {
  match param_ty(params[i]) {
    TVar(_) => false,
    _ => params_all_annotated(params, i + 1),
  }
}

fn row_handles_only(ref q, i) = if i >= len(q) {
  []
} else if is_row_handle(graph_chase_handle(q[i])) {
  [q[i]] ++ row_handles_only(q, i + 1)
} else {
  row_handles_only(q, i + 1)
}

// THE COMPLETION FOLD (D4's essential half, trial side): with every
// member judged, each member's row cell re-finalizes to its RESOLVED
// row — co-member content folds through the live edges the charges
// drew, so a cycle's whole truth lands in every member's published row
// instead of each decl-exit snapshot missing its later co-members (the
// movers' mutual-recursion families). The read is the decl exits' own
// resolve-on-stored shape — no new read form; termination at cycles is
// artifact-proven (both cycle fixtures + the march run these reads
// green). Identity-until-progress makes the no-op case free; the
// finalize is the exit's own REPLACE op, second use at the sweep.
fn group_completion_fold(ref stmts, ref members, j) = if j >= len(members) {
  ()
} else {
  match stmts[members[j]] {
    N(sbody, span, handle) => match sbody {
      NStmt(FnStmt(_, _, _, _, _)) => match graph_chase(handle) {
        GNode(NBound(TFun(_, _, frow)), _) => match frow {
          EfRow(_, _, EtOpen(vs)) => fold_member_cells(vs, span),
          _ => (),
        },
        _ => (),
      },
      _ => (),
    },
  }
  group_completion_fold(stmts, members, j + 1)
}

fn fold_member_cells(ref vs: [Int], ref span) = match vs {
  [] => (),
  [v, ...rest] => {
    match graph_chase(v) {
      GNode(NRowBound(stored), _) => {
        // A residual edge chasing back to v contributes nothing
        // (R ∪ R = R) and, stored, would be a self-loop the unguarded
        // resolve recursion could ride — cut it before the store.
        let folded = match resolve_row(stored) {
          EfRow(fp, fa, EtOpen(ws)) => {
            let others = edges_without_self(ws, graph_chase_handle(v))
            if len(others) == 0 { ef_make(fp, fa, EtClosed) } else { ef_make(fp, fa, EtOpen(others)) }
          },
          r => r,
        }
        graph_finalize_row(v, folded, Located(span, Inferred("group completion fold")))
      },
      _ => (),
    }
    fold_member_cells(rest, span)
  },
}

fn group_final_publish(ref stmts, ref members, j) = if j >= len(members) {
  ()
} else {
  match stmts[members[j]] {
    N(sbody, span, handle) => match sbody {
      NStmt(FnStmt(name, _, _, _, _)) => env_extend(name, Live(handle), Located(span, Declared(name)), FnScheme),
      _ => (),
    },
  }
  group_final_publish(stmts, members, j + 1)
}

fn group_judge_members(ref stmts, ref members, own rows, j) = if j >= len(members) {
  rows
} else {
  let i = members[j]
  group_judge_members(stmts, members, list_set(rows, i, stmt_measure_one(stmts[i])), j + 1)
}

// The ONE measure home: judge the stmt, return its sizing row — the
// trial's sweep writes it at the stmt's position; the final's plan
// prefix-sums it into the deterministic handle bases.
fn stmt_measure_one(ref node) = {
  let before = graph_next()
  infer_stmt(node)
  (stmt_decl_name(node), graph_next() - before)
}

// The stmt's declared name — the layer projection's index key. A stmt with
// no single name (a destructured let, an expression statement) contributes
// no key; missing edges DEGRADE TO SOURCE ORDER (equal depths walk in
// source order), never reorder a dependent before its dependency.
fn stmt_decl_name(ref node) = match node {
  N(body, _, _) => match body {
    NStmt(FnStmt(name, _, _, _, _)) => name,
    NStmt(TypeDefStmt(name, _)) => name,
    NStmt(EffectDeclStmt(name, _, _)) => name,
    NStmt(HandlerDeclStmt(name, _, _, _, _)) => name,
    NStmt(LetStmt(pat, _, _)) => match pat {
      PVar(name) => name,
      _ => // drift-audit: ignore — the documented no-key contract (a destructured let contributes no index entry; equal depths keep source order)
      "",
    },
    _ => // drift-audit: ignore — the documented no-key contract (an unnamed stmt contributes no index entry; equal depths keep source order)
    "",
  },
}

// ─── The stmt-layer index — decl name → stmt position ───────────────────
// The layer descent's edge resolver (stmt_layers_ast): a free name that
// names a top-level decl is a call-DAG edge; anything else (a local, a
// prelude primitive with no stmt) resolves to no edge. A stmt with no
// key (destructured let, expression stmt) contributes no entry; missing
// edges leave equal depths, and within-layer source order preserves the
// dependency-safe walk.
fn layer_name_index(ref names, i, idx) = if i >= len(names) {
  idx
} else {
  layer_name_index(
    names,
    i + 1,
    if byte_len(names[i]) > 0 { smap_add(idx, names[i], i) } else { idx }
  )
}

// The second judgment (retirement condition at the header above
// infer_program_converged): everything here re-derives what the trial
// already judged. Its non-redundant duties today are REPORTING (the
// trial runs absorbed under diag_quiet) and the PLANNED mint (the
// deterministic bands the fan rides); both move into the one remaining
// pass when this one deletes at rung 3.
fn infer_program_final(rows, layers, pstart, summ, stmts) = {
  {
    let parse_end = graph_next()
    register_primitives()
    refuse_duplicate_type_decls(stmts, 0, len(stmts), smap_new())
    each(pre_register_alias, stmts)
    each(pre_register_effect, stmts)
    fold(smap_new(), pre_register_stmt_final, stmts)
    // The final's own prereg ceiling (its prereg re-mints the skeletons).
    set_mint_ceiling(graph_next())
    // The summaries value arrives from the TRIAL's one classify (grades
    // read arm structure — no pass changes them) and threads to every
    // branch bracket — each branch installs its own resume_summaries_ctx
    // over the same value (a fresh ctx would answer UZero for every
    // grade and mis-tier dispatch), so a spawned cursor reads grades
    // without reaching this ambient instance.
    set_summaries(summ)
    infer_stmt_list_planned(rows, layers, stmts, summ)
    finalize_continuation_boundaries(0, graph_next())
    assert_row_gates_drained()
    comment_refs_check(stmts, pstart, parse_end)
  } ~> infer_ctx ~> fresh_for_inference ~> resume_summaries_ctx
  stmts
}

// The deterministic handle partition: each stmt's mints land in a
// pre-assigned dense range [base, base + count) — bases are prefix sums of
// the trial's measured counts from the final's own post-prepass frontier,
// so the numbering is a pure function of the source through the trial's
// determinism (the parallel fan must reproduce it exactly, which is its
// byte-equality gate). The walk proceeds LAYER BY LAYER — the execution
// shape the fan parallelizes, with within-layer source order — and because
// bases are pre-assigned by SOURCE order, the numbering is invariant to
// the walk order: the fixpoint holding across this reordering IS the
// order-independence proof. A stmt minting fewer than its measure leaves
// virgin gap cells (absent by the column contract); one minting more
// overflows to the open space above the plan (graph_fresh's overflow arm)
// — both deterministic.
// Each branch's private overflow band, above the plan. The measured
// distribution (2026-07-26, the whole self-compile): 324 over-measure
// stmts, every delta 1 or 2 — the fingerprint-blindness residue on the
// convergence's carried counts — so 64 is a 32× margin, and a stmt
// crossing its band hits the unseeded guard loudly instead of invading
// its neighbor's. Banded overflow makes the WHOLE numbering — jumps
// included — a pure function of the source and the plan: the keystone
// property (deterministic handle partition) with no execution-order
// input, which is exactly what lets the fan reproduce the sequential
// bytes at any K.
let mint_overflow_quota = 64

fn infer_stmt_list_planned(rows, layers, stmts, summ) = {
  let flat = list_to_flat(rows)
  // The plan covers the ranges AND the overflow bands — one region,
  // pre-opened whole, so no branch ever opens a page.
  let start = graph_next()
  let top0 = start + rows_total(flat, 0, 0)
  let region_end = top0 + len(flat) * mint_overflow_quota
  graph_mint_plan(region_end)
  // The branch cursors' shared graph seed, read ONCE after the plan:
  // the spine table is stable for the whole walk, and the span index
  // is complete (graph_index_span is parse-only).
  //
  let gseed = graph_branch_seed()
  let iseed = intern_seed()
  let bases = rows_bases(flat, start)
  planned_layer_sweep(
    flat,
    layers,
    bases,
    stmts,
    summ,
    start,
    gseed,
    iseed,
    top0,
    0,
    flat_max(layers, 0, 0)
  )
  graph_mint_seal(region_end)
}

fn rows_total(ref rows, i, acc) = if i >= len(rows) {
  acc
} else {
  match rows[i] {
    (_, c) => rows_total(rows, i + 1, acc + c),
  }
}

fn rows_bases(ref rows, start) = rows_bases_walk(rows, make_list(len(rows)), start, 0)

fn rows_bases_walk(ref rows, own bases, base, i) = if i >= len(rows) {
  bases
} else {
  match rows[i] {
    (_, c) => rows_bases_walk(rows, list_set(bases, i, base), base + c, i + 1),
  }
}

fn flat_max(ref xs, i, best) =
  if i >= len(xs) { best } else { flat_max(xs, i + 1, if xs[i] > best { xs[i] } else { best }) }

fn planned_layer_sweep(ref rows, ref layers, ref bases, ref stmts, summ, ceil, gseed, iseed, top0, l, maxl) = if l > maxl {
  ()
} else {
  // The layer-start base capture: performed OUTSIDE any branch bracket,
  // so the root env instance answers — every branch of this layer reads
  // the same frozen extent (append-only buffer + frozen count = a true
  // snapshot), which is exactly the visibility the fan's concurrent
  // branches will have. Per-stmt replay keeps the sequential stderr and
  // env byte-identical; the fan defers the same replay to this barrier.
  //
  let base = env_base_view()
  let seed = consume_base()
  planned_layer_stmts(rows, layers, bases, stmts, summ, ceil, gseed, iseed, l, 0, base, seed, top0)
  planned_layer_sweep(rows, layers, bases, stmts, summ, ceil, gseed, iseed, top0, l + 1, maxl)
}

// THE FAN'S EXECUTION SHAPE, sequential form: judge every branch of the
// layer first (each banks its facts under its own bracket), then join
// them all IN STMT ORDER at the layer barrier. Same-layer visibility is
// invariant between the interleaved and barrier forms — a branch reads
// the FROZEN base, never a sibling's replay, and op-edge evolution
// lands in the root for LATER layers only — so this restructure is
// byte-identical by construction, and the fan's concurrent form changes
// only WHO runs layer_judge_walk's iterations, never what the joins
// replay.
fn planned_layer_stmts(ref rows, ref layers, ref bases, ref stmts, summ, ceil, gseed, iseed, l, i, base, seed, top0) = {
  let facts =
    layer_judge_walk(rows, layers, bases, stmts, summ, ceil, gseed, iseed, l, 0, base, seed, top0, [])
  layer_join_walk(facts, 0)
}

// The in-flight window — a scheduling constant, never a semantics
// input BY DESIGN: the banded partition makes the emitted bytes a
// pure function of source and plan, so any window size must produce
// identical output, and the six-run-variance diff is the standing
// instrument. THE K>1 DIG'S KILL LEDGER (2026-07-27, six probe
// batteries — the bind census with per-branch band bounds, the
// can_yield tail census, the reason census): SIX labels died to the
// artifact. The prepass registrations were INNOCENT (op schemes are
// fully quantified — register_one_op's qvars span params + ret +
// row; the 101 prepass-band binds are each handler decl's OWN branch
// binding its residual, layer-protected). The NFree/NRowFree publish
// fallbacks were REAL shared cells (generalize now QUANTIFIES its
// unresolved arms — callers freshen instead of teaching the decl
// through the publish; Law-7 byte-identical on the wheel, m2 == m3).
// Row path compression was the LARGEST shared-write class (1,463
// foreign row binds per compile, every reason "row path compression"
// — branches rebinding prior-generation chain cells as an
// optimization) and it now rides its own op, graph_compress_row,
// whose branch arm SKIPS (the root's sequential walks re-compress) —
// measured innocent of the flip but a true determinism hazard closed.
// THE RESIDUE, measured to its mechanism (the born-reason census —
// each foreign row bind printed with the PREVIOUS binding's reason):
// one shared row cell per mutual-recursion family (emit_expr's, the
// walk_locals_pat/list_copy_into families) is SERIALLY REBOUND by
// its same-layer caller branches — a born→why chain five deep, each
// caller's call-edge unify graph_bind_row-ing an ALREADY-BOUND root
// with its own re-teaching, so the surviving binding is whichever
// branch ran last and lower's can_yield reads the schedule's pick
// (the float-format trio's k2 wrap flip, two self-stable attractors,
// census 0 in both). The rebind census RAN (9,676 per compile):
// rebinding is pervasive and partly DELIBERATE — inf_exit_fn's
// finalization overwrites the placeholder (1,982 as the rebinder,
// 4,674 as the prior binding) — so the blanket never-rebind-a-bound-
// root rule was REFUTED as the fix shape, and the lattice landed
// instead: the teaching write on a bound row cell is a JOIN
// (graph_bind_row's bound arm — row_join, fragments coexisting by
// GRAPH identity; joins commute and idempote, so N caller branches
// teaching one cell converge to the same value in ANY order — the
// LVars/CALM law), the decl-exit REPLACE rides its own op
// (graph_finalize_row: two algebras, two ops), and the foreign-share
// ENTRY died at its root — the frozen-read instantiate
// (subst_ty_build/subst_row_build: the mapping decides BEFORE any
// live chase; the freeze exists so readers never read live; the one
// scoped exception is the deliberately-unquantified miss — handler
// config↔payload two-phase, mono self-entries). The join judge's
// census on its own source is 0. The six-run variance diff stays the
// standing instrument; FRAGX the standing collision census.
// SERIALIZED AT 1 (2026-08-07, the row-half's precondition): the
// window's K=8 safety rested on the two laws the schemes-are-edges
// landing dissolves — the value-boundary law (published schemes free
// of live vars) and the frozen-read instantiate (readers never read
// live). With live row cells in published schemes, same-layer sibling
// callers of one shared forward callee JOIN one cell concurrently and
// the un-CAS'd read-modify-write garbles the edge list (measured: the
// free_in_fields k2 staging flipping run-to-run; the trap-on-spawn
// probe convicting the sweep). Window 1 keeps the machinery whole and
// the branches non-overlapping — race-free over live cells. The
// parallel form returns at Phase 9.2, where the deterministic handle
// partition and ATOMIC join writes (the lattice law's implementation
// half) are designed in.
let judge_window = 1

// THE FAN: every layer branch runs as a REAL task — a spawned
// instance of the whole module over the shared image, its world born
// empty and populated by the bracket's eleven-handler cursor, its
// facts crossing back as one shared heap record at join. The window
// spawns ahead up to judge_window tasks and joins IN STMT ORDER —
// completion order never matters (join_task's atomic wait delivers
// each branch's facts whole), so the replay stream is byte-identical
// to the sequential walk by construction. Same-layer branches share
// only frozen or partitioned state (the serialization note above
// carries what happens when they stop being frozen): mint ranges and
// overflow bands are disjoint, ledgers are branch-local, and the
// intern is a read-only view. The task closure's captures reach
// branch_judge as ordinary call arguments (the install-config-capture
// class never fires on params).
fn layer_judge_walk(ref rows, ref layers, ref bases, ref stmts, summ, ceil, gseed, iseed, l, i, base, seed, top0, own acc) = {
  let idxs = layer_indices(layers, l, 0, [])
  judge_blocks(rows, bases, stmts, summ, ceil, gseed, iseed, base, seed, top0, idxs, 0, acc)
}

fn layer_indices(ref layers, l, i, own out) = if i >= len(layers) {
  out
} else {
  layer_indices(layers, l, i + 1, if layers[i] == l { push(out, i) } else { out })
}

// Block-wise concurrency: spawn a block of up to judge_window tasks,
// then join the block in stmt order — at most judge_window instances
// live at once, and the joins' replay stream is byte-identical to the
// sequential walk at any block size (completion order never matters;
// join_task's atomic wait delivers each branch's facts whole).
fn judge_blocks(ref rows, ref bases, ref stmts, summ, ceil, gseed, iseed, base, seed, top0, ref idxs, b, own acc) = if b >= len(idxs) {
  acc
} else {
  let hi = if b + judge_window < len(idxs) { b + judge_window } else { len(idxs) }
  let recs =
    spawn_block(rows, bases, stmts, summ, ceil, gseed, iseed, base, seed, top0, idxs, b, hi, [])
  judge_blocks(
    rows,
    bases,
    stmts,
    summ,
    ceil,
    gseed,
    iseed,
    base,
    seed,
    top0,
    idxs,
    hi,
    join_block(recs, 0, acc)
  )
}

// A block member is either a task to join or a branch already judged.
//
// The SPAWN IS THE CONCURRENCY, NEVER THE SEMANTICS, and the artifact says so
// at three places: branch_bracket (installed inside branch_judge, spawned or
// not) carries the private env overlay and the deferred diagnostics; graph,
// intern, the ledgers and the summaries "stay the root's live instances"; and
// the `~> graph_handler` wrapper below exists ONLY because a spawned
// instance's world is empty where the sequential form's render reads the
// dispatch chain's own instance. So a block of ONE has nothing to gain from a
// thread — it runs alone by definition — and it was paying a full OS thread
// plus its bracket for that nothing, which measured as roughly half the
// compile of `fn main() = 7` (433 threads, wasi_thread_start 48.45%
// inclusive; Hβ.infer.serialized-judge-still-spawns).
// The decision is by BLOCK SIZE, not by reading judge_window: at 1 every
// block is a singleton and goes direct, and when Phase 9.2 restores K=8 the
// full blocks spawn again with no edit here — a trailing singleton block
// still going direct, which is correct and free.
type BranchRec = BrDirect(a) | BrSpawned(b)

fn spawn_block(ref rows, ref bases, ref stmts, summ, ceil, gseed, iseed, base, seed, top0, ref idxs, j, hi, own recs) = if j >= hi {
  recs
} else {
  let i = idxs[j]
  match rows[i] {
    (_, count) => {
      let range = (bases[i], bases[i] + count, top0 + i * mint_overflow_quota)
      let solo = hi - j == 1 && len(recs) == 0
      // The task body mirrors the root's OUTER shape: an arm's performs
      // resolve outer to its install (R2), so diag_branch's renders
      // chase OUTSIDE the bracket — sequentially they land on the
      // dispatch chain's empty graph instance (whose density guard
      // answers virgin t{h}@e0 for unminted-by-it handles); a spawned
      // instance's world would be EMPTY there and the render died
      // garbage (measured: show_handle's exhaustive else, the 6,444-line
      // repro). The wrapper reproduces the root's answers byte-for-byte;
      // the render-reads-the-guard's-fabrication class is named for its
      // own landing (Hβ.diag.render-chases-wrong-instance).
      let rec = if solo {
        BrDirect(branch_judge(stmts[i], base, seed, summ, ceil, gseed, iseed, range))
      } else {
        BrSpawned(spawn_task(() => branch_judge(stmts[i], base, seed, summ, ceil, gseed, iseed, range) ~> graph_handler([], 0, 0, 0, [], 0, 0)))
      }
      spawn_block(
        rows,
        bases,
        stmts,
        summ,
        ceil,
        gseed,
        iseed,
        base,
        seed,
        top0,
        idxs,
        j + 1,
        hi,
        push(recs, rec)
      )
    },
  }
}

fn join_block(ref recs, j, own acc) = if j >= len(recs) {
  acc
} else {
  join_block(
    recs,
    j + 1,
    push(
      acc,
      match recs[j] {
        BrDirect(facts) => facts,
        BrSpawned(t) => join_task(t),
      }
    )
  )
}

fn layer_join_walk(ref facts, j) = if j >= len(facts) {
  ()
} else {
  branch_join(facts[j])
  layer_join_walk(facts, j + 1)
}

// The branch bracket (Phase C, C1c-2): one stmt judged under its own
// cursor pair — env over the frozen layer-start base (private extends
// die at the join; publishes replay through the root) and diagnostics
// rendered at collect. Graph, intern, the ledgers, and the summaries
// stay the root's live instances — the sequential form the fan's
// per-thread tapes extend. Config args are frame locals by construction
// (Hβ.lower.install-config-capture-read: a capture-referencing config
// arg reads 0; params read true).
fn branch_judge(stmt, base, seed, summ, ceil, gseed, iseed, range) = {
  let body = () => {
    set_summaries(summ)
    // The branch's own infer_ctx is fresh — the pass's prereg ceiling
    // re-arms here exactly as the summaries do, so the completion prune
    // fires inside branch-judged finalizes too.
    set_mint_ceiling(ceil)
    consume_seed(seed)
    infer_stmt(stmt)
    let vdebt = verify_debt()
    let clog = consume_log()
    let pubs = env_publishes()
    let dfacts = diag_lines_taken()
    (pubs, dfacts, vdebt, clog)
  }
  branch_bracket(body, base, gseed, iseed, range)
}

// ONE chain, two workloads (Arc 1's factor): the judgment's stmt branches
// and the ??-fan's candidate branches run the SAME eleven-handler bracket —
// only the body differs. The uniform pass beats the per-site family.
// The bracket mirrors the ambient chain's order whole (the final's
// trio innermost, then pipeline.mn's spine law — ledgers inside env
// inside diagnostics): infer_ctx's frames and fresh_for_inference are
// stmt-local, so fresh instances are exact; the summaries instance
// re-arms over the SAME value the root computed (set_summaries at
// entry — a fresh ctx would answer UZero and mis-tier dispatch). The
// affine instance seeds from the root's frozen consumed-set; its log
// replays at the join. verify accrues branch-locally; the debt
// replays by re-perform — EXACT because a predicate's operands live
// in the branch's own planned range, so no sibling bind can move a
// decision between judge and join. region_tracker needs NO replay:
// top-level values tag region 0 (global) by construction, and a
// fresh instance's None answers check_escape exactly as the root's
// Some((_, 0)) would — same verdict, zero cross-branch state. Their
// arms' reports resolve outward to diag_branch (rendered at
// collect), so every refusal a branch raises rides the banked lines.
// The graph instance is the C1c-2a config cashed out: the branch
// installs over the SHARED spine (pre-opened by the plan, stable for
// the walk) with its stmt's planned range as (next0, limit0) — the
// former root-side graph_mint_at dissolved into this config — the
// root's complete span index (parse-only writes), and its PRIVATE
// overflow band [bh, bh + quota) above the plan. An over-measure
// stmt jumps into its own band (the measured residue: deltas of 1–2
// on ~324 stmts); crossing the band trips the unseeded guard loudly.
// Numbering — jumps included — is therefore a pure function of the
// source and the plan, independent of execution order: the fan
// reproduces these bytes at any K. Trail and checkpoints are
// branch-local; binds land in shared cells the plan partitioned.
fn branch_bracket(body, base, gseed, iseed, range) = match base {
  (bb, bc, bi) => match gseed {
    (gspine, gopen, gspan) => match iseed {
      (ib, ie, ic) => match range {
        (mb, mc, bh) => body() ~> infer_ctx ~> fresh_for_inference ~> resume_summaries_ctx ~> affine_ledger ~> region_tracker ~> verify_ledger ~> lookup_ty_graph ~> env_handler(bb, bc, bi) ~> graph_handler(gspine, gopen, mb, mc, gspan, bh, bh + mint_overflow_quota) ~> mutate_sink ~> diag_branch ~> intern_view(ib, ie, ic),
      },
    },
  },
}

// The join: replay the branch's facts into the root in occurrence order —
// publishes re-perform env_extend (the Reason edge rides whole), the
// rendered lines re-print, the tally folds. Runs AFTER the bracket
// closes, so every perform here resolves to the root instances.
fn branch_join(facts) = match facts {
  (pubs, dfacts, vdebt, clog) => {
    branch_replay_pubs(pubs, 0)
    // Both ledgers' logs are PREPEND-ordered; the replay walks from the
    // tail so the root re-performs in occurrence order. Consumes re-check
    // against the root's live set — a same-layer double-consume refuses
    // HERE, deterministically, exactly as the join protocol demands. Only
    // Own consumes ever enter the sites log (the arm's else branch), so
    // the replay's ownership arg is Own by construction.
    branch_replay_consumes(clog, len(clog) - 1)
    branch_replay_verify(vdebt, len(vdebt) - 1)
    // The diag replay is a RE-PERFORM, never a fold: each banked
    // (diag, line) re-enters the root chain as a live report, so the
    // root arm counts and scope-registers it and every forwarder
    // (tighten_collector, the mcp bank) sees the structure — the old
    // diag_absorb fold reached only the one handler that carried its
    // arm, and a branch-fired report bypassed every collector.
    branch_replay_diags(dfacts, 0)
  },
}

fn branch_replay_diags(ref dl, i) = if i >= len(dl) {
  ()
} else {
  match dl[i] {
    (d, l) => {
      diag_report(d, l)
      branch_replay_diags(dl, i + 1)
    },
  }
}

fn branch_replay_consumes(ref clog, i) = if i < 0 {
  ()
} else {
  match clog[i] {
    (name, span) => {
      consume(name, Own, span)
      branch_replay_consumes(clog, i - 1)
    },
  }
}

fn branch_replay_verify(ref vdebt, i) = if i < 0 {
  ()
} else {
  match vdebt[i] {
    (span, pred, reason) => {
      verify(span, pred, reason)
      branch_replay_verify(vdebt, i - 1)
    },
  }
}

fn branch_replay_pubs(ref pubs, i) = if i >= len(pubs) {
  ()
} else {
  match pubs[i] {
    (name, scheme, reason, kind) => {
      branch_replay_one(name, scheme, reason, kind)
      branch_replay_pubs(pubs, i + 1)
    },
  }
}

// An EffectOpScheme publish is a READ-MODIFY-WRITE of the op→handler
// edge — value-replay is the banked ambiguity loss (two same-layer
// handlers each evolve the FROZEN base independently and latest-wins
// erases the second sighting; measured as graph_mutated collapsing to a
// lsp_adapter singleton and the SingletonUninstalled floor firing at
// every compile's first commit-boundary mint). The join RE-RUNS
// draw_op_edges' own default/ambiguous algebra against the root's live
// entry, the branch's verdict as the sighting; disc joins monotone.
//
// THE VALUE BOUNDARY AT EVERY PUBLISH: the scheme crosses the join as
// a chase_deep'd VALUE — quantified vars stay free leaves; everything
// bound inlines its resolution — so no published entry of ANY kind
// carries a live cell a concurrent sibling could bind. FnScheme
// finals got this law first (the subst/quantification landing);
// op-scheme and handler-sig publishes still carried live handles,
// and a same-block race on one such cell was the K>1 flip's target
// set (measured: str_of_single_byte's can_yield chasing a row var
// bound in four of six runs, free in two — the k2 wrap flipping the
// whole float-format family).
fn branch_replay_one(name, scheme, reason, kind) = match scheme {
  Live(h) => // A live cell replays AS a live cell: the branch's judgment wrote the
  // decl's graph cell in place (one graph, one truth), so the root's
  // readers resolve it live. Freezing here would publish a snapshot the
  // cell has already moved past — the two-generations disease this
  // landing deletes.
  env_extend(name, Live(h), reason, kind),
  Frozen(q, sty) => {
    let fty = chase_deep(sty)
    // The quantifier RE-DERIVES from the frozen type: chase_deep folds
    // bound structure to values and canonicalizes free leaves to their
    // union-find ROOTS, so pre-fold qvars name surface aliases the
    // frozen tree no longer holds — any frozen leaf outside the
    // instantiation mapping is SHARED by every caller, and the callers'
    // teachings union into that one live cell (measured: infer_context
    // publishing a maskless GraphRead/Intern face it never performs —
    // the union of all fourteen chains' contexts — with stale-band and
    // duplicated qvars as the two-era tell). An EMPTY q is the
    // deliberate mono/two-phase share and stays empty.
    let frozen = if len(q) == 0 { Frozen([], fty) } else { Frozen(free_in_ty(fty), fty) }
    match kind {
      EffectOpScheme(ename, bd, ba, bdisc) => {
        let joined = match env_lookup(name) {
          Some((_, _, EffectOpScheme(_, rd, ra, rdisc))) => {
            let disc = disc_join(rdisc, bdisc)
            match if ra || field_name_eq(rd, bd) {
              (rd, ra)
            } else if field_name_eq(rd, "") {
              (bd, ba)
            } else {
              (rd, true)
            } {
              (nd, na) => EffectOpScheme(ename, nd, na, disc),
            }
          },
          _ => kind,
        }
        env_extend(name, frozen, reason, joined)
      },
      _ => env_extend(name, frozen, reason, kind),
    }
  },
}

// Types, effects, and handlers re-register per pass (fresh entries shadow
// pass-1's with deterministic identical tags; the handler arm re-runs the
// armed state-shadow check the quiet trial absorbed). Fn signatures do
// NOT: the env's latest entry per fn name IS pass 1's final scheme, which
// every pass-2 reference — forward included — resolves. The seen-set
// still refuses a true within-list duplicate.
fn pre_register_stmt_final(seen, ref node) = match node {
  N(body, span, _) => match body {
    NStmt(FnStmt(name, _, _, _, _)) => match smap_get(seen, name) {
      Some(_) => {
        report(EDuplicateFnName(name, span))
        seen
      },
      None => smap_add(seen, name, 1),
    },
    NStmt(TypeDefStmt(name, variants)) => {
      register_type_constructors(name, variants)
      seen
    },
    NStmt(HandlerDeclStmt(hname, _ename, config, state, arms)) => {
      pre_register_handler_sig(hname, config, state, arms)
      seen
    },
    _ => // EffectDeclStmt registered in the pre_register_effect phase — the
    // final's handler sigs read a complete effect env regardless of
    // source order.
    seen,
  },
}

fn infer_stmt_list(stmts) = each(infer_stmt, stmts)

// Statement inference
fn infer_stmt(ref node) = match node {
  N(body, span, handle) => match body {
    NStmt(LetStmt(pat, expr, ann)) => {
      // The decls column, second writer: a value binding IS a declaration,
      // and a MODULE-level one is an emittable entry (__init_lets runs
      // every module value let), so the relocation's reader resolves its
      // origin here. Nested fns already note through infer_fn, so the
      // column's contract was never top-level-only.
      graph_decl_note(handle)
      infer_expr(expr)
      match expr {
        N(_, val_span, eh) => {
          // The let STATEMENT's value IS its expression: bind the stmt node to
          // the value's var (one union-find edge). Unbound, every block-let's
          // own node sat NFree while lower keys LLet by the STMT handle and two
          // emit width-readers lookup_ty it — two recovered E_UnresolvedType
          // per let, program-wide, and a word-floored LLet width where the
          // value's proof already existed one edge away.
          graph_bind(handle, TVar(eh), Located(span, Inferred("let statement carries its value")))
          infer_pat(pat, eh, span)
          // The `: T` annotation is a CONSTRAINT verified against the value node.
          // Unlike the generic TRefined arm of unify_types (predicate + span only),
          // the value's node HANDLE (eh) is live here, so a refinement's `self`
          // operand binds to the value and Verify decides it on the literal —
          // `let bad: Sample = 1.5` rejects, `0.5` compiles. Absent = LitUnit, skipped.
          match ann {
            N(ann_body, _, _) => match ann_body {
              NTypeAnn(ann_ty) => apply_let_annotation(ann_ty, eh, val_span),
              _ => (),
            },
          }
        },
      }
    },
    NStmt(FnStmt(name, params, ret_ann, effs, body_node)) => if fn_fully_sigd(params, ret_ann) {
      infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
    } else {
      // Every unsig'd decl judges SPECULATIVELY (§11 5.3's fragment):
      // the common mono case pays one checkpoint + one held list and
      // commits round 1; only a poly-fingerprinted refusal retries.
      infer_fn_speculative(name, params, body_node, ret_ann, effs, handle, span)
    },
    NStmt(TypeDefStmt(_, _)) => (),
    NStmt(EffectDeclStmt(_, _, _)) => (),
    NStmt(HandlerDeclStmt(hname, ename, config, state, arms)) => {
      // The decls column, third writer. An ARM is an emittable entry whose
      // name is composed at lower and cannot be parsed back to (handler,
      // op), so the arm's origin is its handler decl's node — noted here,
      // where the decl is judged.
      graph_decl_note(handle)
      register_handler(hname, ename, config, state, arms, span)
    },
    NStmt(ExprStmt(expr)) => infer_expr(expr),
    NStmt(ImportStmt(_)) => (),
    NStmt(RefineStmt(_, _, _)) => // Registered at pre_register_stmt (the one home — TAlias(name,
    // TRefined(base, pred)), so X and its base unify transparently and
    // the authored name travels for Reason chains). The declaration is a
    // SCHEMA — there is no value for `self` to bind, so it accrues NO
    // obligation here (the old decl-site verify pended one undecidable
    // entry per refined type, permanently — self unbound). Discharge
    // lives at CONSTRUCTION sites: apply_refinement_constraint substitutes
    // the live value node for self (value-proof R2) and decides or pends
    // against a value that exists.
    (),
    NStmt(AliasStmt(_, _)) => // Transparent alias `type X = T`: registered at pre_register_stmt.
    // No predicate, no Verify — the difference from RefineStmt is exactly
    // the absent `where` (SYNTAX.md §«Type aliases»).
    (),
    NStmt(RowAliasStmt(_, _)) => // Named effect row: registered at pre_register_alias; expansion
    // at build_declared_row (Hβ.types.named-effect-rows).
    (),
    _ => (),
  },
}

// Classic let-generalization: allocate fresh handles for params,
// bind them in env, enter `InferCtx` for row accumulation, infer body,
// exit (which binds the row), generalize, re-extend env with scheme.
fn held_has_poly(held, name: String) = any(
  (p) => match p {
    (d, _) => match d {
      TPolyRecursionSignature(owner, _) => owner == name,
      _ => false,
    },
  },
  held
)

fn held_has_error(held) = any(
  (p) => match p {
    (d, _) => diag_severity(d) == SError,
  },
  held
)

fn replay_one(p) = match p {
  (d, line) => diag_report(d, line),
}

fn replay_held(held) = each(replay_one, held)

// The Mycroft ASSUMPTION at round 2 — the name pre-bound poly over its
// own FRESH cells (the sig'd path's shape with fresh vars standing for
// the unauthored types): self-calls instantiate per use instead of
// chaining the mono cells. The row is assumed fresh-open; a self-call's
// row ⊆ the body's own row by the fixpoint argument, so dropping the
// self-charge under-attributes nothing the body does not already carry.
fn mycroft_fresh_param(p) = param_with_ty(p, TVar(mint(Inferred("mycroft assumed param"))))

fn mycroft_prebind(name: String, params, span: ValidSpan) = {
  let fresh_params = map(mycroft_fresh_param, params)
  let fn_ty = TFun(
    fresh_params,
    TVar(mint(FnReturn(name, Inferred("mycroft assumed return")))),
    mk_ef_open([], graph_fresh_row(Inferred("mycroft assumed row of '{name}'")))
  )
  env_extend(name, Frozen(free_in_ty(fn_ty), fn_ty), Located(span, Declared(name)), FnScheme)
}

// Alpha-equality over detached Ty values — the Mycroft accept's
// STABILITY BELT: the recheck round's published scheme must equal the
// assumed one up to a bijective renaming of quantified cells, or the
// acceptance is the unsound window (self-calls checked against a
// scheme that is not the one published). Pure structural walk; the
// mapping list carries the bijection. Rows compare by their SETS
// (presents/absents structural ==) with tails equal when both closed,
// both all, or both open — edge-set identity is cell-numbering and
// never survives a re-judgment, so the row half's stability rides the
// row machinery (the v1 boundary, named at the peer).
fn alpha_pairs_ok(m, x, y) = match m {
  [] => (true, [(x, y)]),
  [(a, b), ...rest] => if a == x {
    (b == y, m)
  } else if b == y {
    (false, m)
  } else {
    match alpha_pairs_ok(rest, x, y) {
      (ok, rest2) => (ok, if ok { [(a, b)] ++ rest2 } else { m }),
    }
  },
}

fn ty_alpha_eq(t1, t2, m) = match t1 {
  TVar(x) => match t2 {
    TVar(y) => alpha_pairs_ok(m, x, y),
    _ => (false, m),
  },
  TInt => (match t2 {
    TInt => true,
    _ => false,
  }, m),
  TFloat => (match t2 {
    TFloat => true,
    _ => false,
  }, m),
  TUnit => (match t2 {
    TUnit => true,
    _ => false,
  }, m),
  TByte => (match t2 {
    TByte => true,
    _ => false,
  }, m),
  TList(e1) => match t2 {
    TList(e2) => ty_alpha_eq(e1, e2, m),
    _ => (false, m),
  },
  TTuple(es1) => match t2 {
    TTuple(es2) => ty_list_alpha_eq(es1, es2, m, 0),
    _ => (false, m),
  },
  TFun(ps1, r1, row1) => match t2 {
    TFun(ps2, r2, row2) => if len(ps1) != len(ps2) {
      (false, m)
    } else {
      match param_list_alpha_eq(ps1, ps2, m, 0) {
        (ok1, m1) => if ok1 {
          match ty_alpha_eq(r1, r2, m1) {
            (ok2, m2) => if ok2 { (row_alpha_shallow(row1, row2), m2) } else { (false, m2) },
          }
        } else {
          (false, m1)
        },
      }
    },
    _ => (false, m),
  },
  TName(n1, args1) => match t2 {
    TName(n2, args2) => if n1 == n2 { ty_list_alpha_eq(args1, args2, m, 0) } else { (false, m) },
    _ => (false, m),
  },
  TRecord(fs1) => match t2 {
    TRecord(fs2) => field_list_alpha_eq(fs1, fs2, m, 0),
    _ => (false, m),
  },
  TRecordOpen(fs1, v1) => match t2 {
    TRecordOpen(fs2, v2) => match alpha_pairs_ok(m, v1, v2) {
      (ok, m1) => if ok { field_list_alpha_eq(fs1, fs2, m1, 0) } else { (false, m1) },
    },
    _ => (false, m),
  },
  TRefined(b1, _) => match t2 {
    TRefined(b2, _) => ty_alpha_eq(b1, b2, m),
    _ => (false, m),
  },
  TAlias(n1, i1) => match t2 {
    TAlias(n2, i2) => if n1 == n2 { ty_alpha_eq(i1, i2, m) } else { (false, m) },
    _ => (false, m),
  },
  TReprPin(r1, b1) => match t2 {
    TReprPin(r2, b2) => if r1 == r2 { ty_alpha_eq(b1, b2, m) } else { (false, m) },
    _ => (false, m),
  },
  TCont(i1, a1, d1, w1) => match t2 {
    TCont(i2, a2, d2, w2) => if d1 == d2 {
      match ty_alpha_eq(i1, i2, m) {
        (ok1, m1) => if ok1 {
          match ty_alpha_eq(a1, a2, m1) {
            (ok2, m2) => if ok2 { (row_alpha_shallow(w1, w2), m2) } else { (false, m2) },
          }
        } else {
          (false, m1)
        },
      }
    } else {
      (false, m)
    },
    _ => (false, m),
  },
}

fn ty_list_alpha_eq(xs, ys, m, i) = if len(xs) != len(ys) {
  (false, m)
} else if i >= len(xs) {
  (true, m)
} else {
  match ty_alpha_eq(list_index(xs, i), list_index(ys, i), m) {
    (ok, m2) => if ok { ty_list_alpha_eq(xs, ys, m2, i + 1) } else { (false, m2) },
  }
}

fn param_list_alpha_eq(ps1, ps2, m, i) = if i >= len(ps1) {
  (true, m)
} else {
  match ty_alpha_eq(param_ty(list_index(ps1, i)), param_ty(list_index(ps2, i)), m) {
    (ok, m2) => if ok { param_list_alpha_eq(ps1, ps2, m2, i + 1) } else { (false, m2) },
  }
}

fn field_list_alpha_eq(fs1, fs2, m, i) = if len(fs1) != len(fs2) {
  (false, m)
} else if i >= len(fs1) {
  (true, m)
} else {
  match list_index(fs1, i) {
    (n1, t1) => match list_index(fs2, i) {
      (n2, t2) => if n1 == n2 {
        match ty_alpha_eq(t1, t2, m) {
          (ok, m2) => if ok { field_list_alpha_eq(fs1, fs2, m2, i + 1) } else { (false, m2) },
        }
      } else {
        (false, m)
      },
    },
  }
}

fn row_alpha_shallow(r1, r2) = match r1 {
  EfRow(p1, a1, t1) => match r2 {
    EfRow(p2, a2, t2) => if p1 == p2 {
      if a1 == a2 {
        match t1 {
          EtClosed => match t2 {
            EtClosed => true,
            _ => false,
          },
          EtAll => match t2 {
            EtAll => true,
            _ => false,
          },
          EtOpen(_) => match t2 {
            EtOpen(_) => true,
            _ => false,
          },
        }
      } else {
        false
      }
    } else {
      false
    },
  },
}

// The round-3 RECHECK's assumption — the round-2 RESULT scheme, detached
// from its rolled-back cells: the published Ty chased deep BEFORE the
// rollback (a heap value, rollback-proof), its quantified cells re-minted
// fresh and substituted, its row rebuilt fresh-open (the top row cell is
// unquantified and would dangle).
fn mycroft_recheck_pair(c) = (c, mint(Inferred("mycroft recheck var")))

fn rebind_recheck(name: String, q, ty0, span: ValidSpan) = {
  let mapping = map(mycroft_recheck_pair, q)
  let ty1 = subst_ty(ty0, mapping)
  let ty2 = match ty1 {
    TFun(ps, r, _) => TFun(ps, r, mk_ef_open([], graph_fresh_row(Inferred("mycroft recheck row of '{name}'")))),
    other => other,
  }
  env_extend(
    name,
    Frozen(
      map(
        (pr) => match pr {
          (_, fresh) => fresh,
        },
        mapping
      ),
      ty2
    ),
    Located(span, Declared(name)),
    FnScheme
  )
}

// The speculative decl judgment (§11 5.3's fragment — Mycroft iteration
// on the medium's own checkpoint substrate). Round 1 is the plain
// judgment under diag capture; a refusal carrying the poly teach's own
// fingerprint rolls back and retries under the general assumption
// (round 2); a clean round 2 is RECHECKED under its own result scheme
// (round 3 — the stability round that makes the acceptance sound: the
// self-call is checked against the scheme that will be published, per
// Mycroft; Henglein's single-call fragment is the termination
// argument). Any round's failure falls back to the plain re-run — the
// honest refusal, never worse than today. K = 3 rounds.
fn infer_fn_speculative(name, params, body_node, ret_ann, effs, handle, span: ValidSpan) = {
  let cp = graph_push_checkpoint()
  let held = {
    infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
    poly_captured()
  } ~> poly_capture
  if held_has_poly(held, name) {
    graph_rollback(cp)
    let cp2 = graph_push_checkpoint()
    let held2 = {
      mycroft_prebind(name, params, span)
      infer_fn(name, params, body_node, ret_ann, effs, handle, span, true)
      poly_captured()
    } ~> poly_capture
    if held_has_error(held2) {
      graph_rollback(cp2)
      infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
    } else {
      match env_lookup(name) {
        Some(entry) => match entry {
          (sch, _, _) => match judgment_pair(sch) {
            (q, ty) => {
              let detached = chase_deep(ty)
              graph_rollback(cp2)
              let cp3 = graph_push_checkpoint()
              let held3 = {
                rebind_recheck(name, q, detached, span)
                infer_fn(name, params, body_node, ret_ann, effs, handle, span, true)
                poly_captured()
              } ~> poly_capture
              if held_has_error(held3) {
                graph_rollback(cp3)
                infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
              } else {
                // THE STABILITY BELT: the recheck's PUBLISHED scheme must
                // be alpha-equal to the ASSUMED one, or the self-calls were
                // checked against a scheme that is not the one published —
                // the unsound window Mycroft's fixpoint exists to close.
                // Both sides are detached value trees (round 2's pre-
                // rollback, round 3's live), so the bijective TVar pairing
                // is what makes the comparison rollback-safe.
                let stable = match env_lookup(name) {
                  Some(e3) => match e3 {
                    (sch3, _, _) => match ty_alpha_eq(chase_deep(judgment_ty(sch3)), detached, []) {
                      (ok, _) => ok,
                    },
                  },
                  None => false,
                }
                if stable {
                  graph_commit_checkpoint(cp3)
                  replay_held(held3)
                } else {
                  graph_rollback(cp3)
                  infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
                }
              }
            },
          },
        },
        None => {
          graph_rollback(cp2)
          infer_fn(name, params, body_node, ret_ann, effs, handle, span, false)
        },
      }
    }
  } else {
    graph_commit_checkpoint(cp)
    replay_held(held)
  }
}

fn infer_fn(name, params, body_node, ret_ann, effs, handle, span: ValidSpan, poly_hint) = {
  // The decls column, first writer: the FnStmt node handle, noted per
  // judgment (rounds re-note; readers dedup by handle). The let and
  // handler-decl arms of infer_stmt are the other two — a column of
  // every judged DECLARATION, which is what the relocation's reader
  // needs an origin from.
  graph_decl_note(handle)
  env_scope_enter()
  let param_handles = mint_params(params, name)
  let ret_handle = mint(FnReturn(name, Inferred("return of '{name}'")))
  let row_handle = graph_fresh_row(Inferred("effects of '{name}'"))
  // Resolve params to shared identities ONCE (binds the handles); reused below
  // for the ownership pass — never re-derived per consumer (Carried-Truth).
  let resolved_params = build_param_types(params, param_handles)
  // THE ASSUMED SIGNATURE RIDES THE SLOT AS A VALUE — prereg's own law
  // (pre_register_fn_sig: "a value inside the record cannot be
  // class-contaminated ... a chased ret VAR reaches the obligation's own
  // class through tail-call merging; the value never does"), applied at
  // the decl's live pin. The decl's fn_ty was the ONE construction still
  // carrying the var slot, and the rec-call is the one caller that reads
  // it: probe-measured 2026-08-12 on the interval fixture's seek, whose
  // own decide chased the slot to
  // the body join's first-bound bare Int because the old post-body pin
  // rebound the cell AFTER the body obligation had already decided — the
  // assumed signature arrived one statement late. Resolving BEFORE the
  // body makes the IH visible to the rec-call's callee read on time; the
  // cell still binds (forward-ref grounding + quantification), exactly as
  // at prereg. Absent annotation ⇒ the fresh var, inferred as before.
  let authored_pin = match ret_ann {
    N(pin_body, pin_span, _) => match pin_body {
      NTypeAnn(pin_ty) => match quantify_ctor_ty(pin_ty, []) {
        (resolved_pin, _pq) => {
          graph_bind(ret_handle, resolved_pin, Located(pin_span, Declared(name)))
          Some(resolved_pin)
        },
      },
      _ => // The absent-annotation marker (the parser mints LitUnit when no
      // `->` is authored): no pin.
      None,
    },
  }
  let pinned_ret = match authored_pin {
    Some(resolved_pin) => resolved_pin,
    None => // The return stays the fn's own minted cell — the inferred form.
    TVar(ret_handle),
  }
  let fn_ty = TFun(resolved_params, pinned_ret, mk_ef_open([], row_handle))
  // Bind the name BEFORE body so recursive calls resolve.
  let existing = graph_chase(handle)
  match existing {
    GNode(NBound(existing_ty), _) => unify_types(existing_ty, fn_ty, span, Declared(name)),
    _ => {
      // A FULLY-signature'd decl keeps the prereg's QUANTIFIED scheme in
      // scope — self-calls instantiate it fresh per use, so signature'd
      // polymorphic recursion checks (Hβ.infer.sigd-polymorphic-recursion;
      // group_mono_views already exempts sig'd cycle members — this is
      // the same exemption at the intra-decl shadow, the one remaining
      // mono writer). The body still judges against fn_ty through the
      // graph_bind and the authored param/ret pins, so a body violating
      // its signature refuses at the pins. An unsig'd decl binds the
      // mono view — HM's mono recursion, the inference-soundness floor —
      // and a decl the prereg never registered keeps it too (the belt).
      match env_lookup(name) {
        Some(_) => if poly_hint {
          // The Mycroft rounds pre-bind the assumed poly scheme — the
          // mono shadow would erase the assumption (the driver's whole
          // point). The sig'd exemption below is the same skip for the
          // prereg quantified scheme.
          ()
        } else if fn_fully_sigd(params, ret_ann) {
          ()
        } else {
          env_extend(name, Frozen([], fn_ty), Located(span, Declared(name)), FnScheme)
        },
        None => env_extend(name, Frozen([], fn_ty), Located(span, Declared(name)), FnScheme),
      }
      graph_bind(handle, fn_ty, Located(span, Declared(name)))
    },
  }
  // Enter the row-accumulation scope and infer body. The frame is born with
  // the authored declaration; the exit hands it back for enforcement below.
  // The fn body IS a region (§5.O layer 3 — the per-decl granularity the
  // arena resets at): every value the body walk constructs tags with this
  // region; nested fn decls nest their own; the return check below either
  // TRANSFERS the body value to the parent region or proves the escape.
  inf_enter_fn(row_handle, ret_handle, span, effs)
  let body_region = region_enter(span)
  // The body is a consume scope — its `own` params are its own linear
  // resources. Without this bracket, a name consumed here (affine_ledger
  // is installed once at the pipeline, not per body) stays in `used` and
  // collides in the NEXT function that names the same `own` param — the
  // cross-function buf/acc false positives.
  consume_enter_fn()
  // The linear obligations this body accepts, declared INSIDE the
  // bracket: an authored `own` param is the claim "this is mine to
  // finish", and consume_exit_fn reports whichever the body never
  // consumed — affine's exactly-once half
  // (Hβ.own.linear-tier-and-persist-value-barrier). Inside, not before:
  // consume_enter_fn opens a fresh frame and clears the list, so a
  // declaration made at mint_params is wiped before the walk (measured
  // — the first form reported nothing on a fn that plainly drops its
  // own param). Authored only: infer_ownership runs AFTER the body, so
  // the honest fact here is what the developer wrote.
  declare_authored_owns(params, span)
  infer_expr(body_node)
  consume_exit_fn()
  let declared_effs = inf_exit_fn(signature_free_roots(param_handles ++ [ret_handle]))
  // Unify body's type with the declared return.
  match body_node {
    N(_, _, body_handle) => {
      unify(body_handle, ret_handle, span, FnReturn(name, Inferred("body")))
      // The `-> RetTy` annotation is PINNED BEFORE the body (the assumed-
      // signature slot value above), so the return unify just ran the body
      // against the bound cell — a disagreeing body surfaces E_TypeMismatch
      // through that one edge. What remains here is value-proof R2: the
      // refined annotation discharged against the judged body node (the
      // let-annotation's twin — `fn choose() -> Positive = 1` proves 0 < 1
      // on the literal; a non-constant body stays honest V_Pending), and it
      // runs AFTER the body precisely so the decide reads judged cells —
      // with the IH already visible through the pinned slot (the old
      // post-body rebind landed after this decide and the decl's own
      // obligation read the join's bare base; probe-measured 2026-08-12).
      match ret_ann {
        N(ret_body, ret_span, _) => {
          match ret_body {
            NTypeAnn(ann_ty) => match quantify_ctor_ty(ann_ty, []) {
              (resolved_ann, _q) => match body_node {
                N(_, _, body_h) => apply_refinement_constraint(resolved_ann, body_h, ret_span),
              },
            },
            _ => (),
          }
          // H4: every fn return is an escape boundary — and a TRANSFER. The body
          // value tagged with THIS fn's region re-tags into the parent's (the
          // caller owns it now — Hβ.own.region-return-transfer); an outer-region
          // or global tag already outlives this return; a dead-region tag is the
          // genuine escape, reported with both spans. The check runs INSIDE the
          // body region (the arm reads the stack top to know which region is
          // "mine"); the exit follows.
          check_escape(body_handle, span)
          region_exit(body_region)
          // ─── Ownership inference (§4⑤, arm 5) — the Hylo-quiet bar ──────
          // After the body is inferred, classify each Unmarked param's ownership
          // from its body use-count (0/1/2+ → Unmarked/Own/Ref); an authored own/ref
          // becomes a CONSTRAINT the inferred is checked against. The inferred params
          // are written BACK into the fn's TFun node (over the SAME param handles, so
          // types stay live as TVar(h)) — so lower's Consume-elision and affine_ledger
          // read the inferred ownership LIVE (Carried-Truth: written once at infer, read
          // live everywhere, never re-derived per consumer). The lifetime hazard — a
          // value outliving its region — is proven by check_escape (the region tracker,
          // above at :434).
          // REMOVED here (Stage 1b): a syntactic escape check that fired on
          // use-count-plus-bare-return with no hazard model — 356 false alarms, min and
          // every fold accumulator among them. The region tracker covers the real hazard.
          let inferred_params = infer_ownership(resolved_params, body_node)
          graph_bind(
            handle,
            // The ret slot carries the SAME pinned value the pre-body signature
            // rides — rewriting it as the bare var here would re-open the
            // class-contamination channel the pin closed (this rewrite is the
            // record's last writer; the slot's law is prereg's).
            TFun(inferred_params, pinned_ret, mk_ef_open([], row_handle)),
            Located(span, Inferred("ownership-resolved params of '{name}'"))
          )
          // ─── Refinement narrowing (§4⑥, arm 6) — the verified cursor ────
          // Walk the body's if/match/assert sites; at each index site under a proven
          // path condition, write the narrowing edge into the graph (graph_narrow_set).
          // lower's bounds-check read (graph_narrow_at) elides any check the path already
          // proves (Carried-Truth: the narrowing is written ONCE here, read live at
          // lower — never re-derived; the elision is a PROJECTION, not a recomputation).
          infer_refinement_narrowing(body_node)
          // ─── Declared effects enforcement (gap 1 + 2) ──────────────────
          // If the FnStmt carries a declared effect row, verify the inferred
          // body's row is subsumed by it. If so, rebind row_handle to the
          // declared row so callers see the API contract. If not, emit
          // E_EffectMismatch (body does more than the declaration admits).
          // The declared row IS the gate — row_subsumes is the proof engine.
          // `declared_effs` arrived with inf_exit_fn's return above: the popped
          // frame's own declaration, so a nested fn can never clobber this one's.
          if len(declared_effs) > 0 {
            // D3 — `with Pure` is absolute: body row must be the pure row (not
            // merely ⊆ some sugar row named Pure). When Pure appears
            // anywhere in declared_effs, the declared row collapses to
            // the pure row and any other declared names are a contradiction (a
            // single warning surfaces them precisely in the contradiction
            // diagnostic).
            let has_pure = has_pure_declared(declared_effs)
            // The registration fold runs FIRST, so the instance typing,
            // the signed fold's meet (absent_contradicted_by), and the
            // pin all judge the value-distinct forms — resolution
            // happens once, at the one env-whole point, never inside
            // the row algebra's compares.
            let resolved_effs = resolve_declared_instances(declared_effs)
            check_instance_args(resolved_effs, span)
            let declared_row = build_declared_row(resolved_effs)
            // THE GATE RUNS ON THE RESOLVED ROW — and the deferral is
            // GROUP-GATED, the same parse-truth fact the charge reads. A
            // cycle member's open tail resolves when the cycle's last
            // member cuts, so its gate parks for the pass tail (81 early
            // misfires the moment the live charge landed). A NON-member's
            // free tail is the effect-polymorphism channel and will never
            // ground — parking that gate is never enforcing it (measured:
            // a !WASI declaration over a println-performing body with one
            // row-polymorphic call parked forever, the crown silently off
            // for exactly the shape the conservative reject exists for).
            // Non-members enforce eagerly, free tail and all.
            if row_gate_unresolved(row_handle) && group_member(name) {
              defer_row_gate((name, declared_row, has_pure, row_handle, span))
            } else {
              enforce_row_gate(name, declared_row, has_pure, row_handle, span)
            }
          }
          env_scope_exit()
          // Generalize and re-extend. Located: this is the entry every later
          // reader resolves (the flat env scans newest-first), so the decl span
          // rides the reason for the Why chain and the executable gate's
          // unhandled-effect diagnostic.
          let scheme = generalize(handle)
          env_extend(name, scheme, Located(span, Declared(name)), FnScheme)
        },
      }
    },
  }
}

// Deferral discriminator: the gate parks only when the body row is BOUND
// to a chain whose resolved tail still chases to a free cell — the
// mid-cycle shape. An unbound row keeps the member-exit PIN (the
// declared-row contract stands regardless of resolution lag — the
// parse_effect_list_from flip's law; the pin itself is condemned at
// the gate, its record there), and a resolved row gates now.
fn row_gate_unresolved(row_handle) = match graph_chase(row_handle) {
  GNode(NRowBound(body_row), _) => // The COMPRESSING resolve: the re-park re-checks this predicate at
  // every later group event (the cross-group deferral), so each check
  // folding the same chain raw re-allocated the fold per event —
  // compression rebinds the chain to its terminal and the re-checks
  // ride the one-hop web (the flat-cell law's read half; safe under
  // the serialized sweep, branch-guarded inside graph_compress_row).
  match resolve_row_compress(body_row) {
    EfRow(_, _, EtOpen(vs)) => edges_any_free(vs),
    _ => false,
  },
  _ => false,
}

// Any edge chasing to a free row cell — structural (off the Iterate
// vocabulary, the row walks' discipline).
fn edges_any_free(ref vs: [Int]) = match vs {
  [] => false,
  [v, ...rest] => match graph_chase(v) {
    GNode(NRowFree(_), _) => true,
    _ => edges_any_free(rest),
  },
}

// The declared-row gate, one home for both firing sites (decl exit when
// resolved; the pass-tail drain for parked mid-cycle gates). The row is
// re-read LIVE at fire time — never carried as a value — so the drain
// judges the closed truth the cycle's cut produced.
// ─── The instance-argument REGISTRATION FOLD (RESIDUE effarg-node D1/D2) ──
// A bare ident at an effect-arg position parses as EANode — the parser
// cannot resolve it (the env is infer's). HERE, at registration — the one
// deterministic point where the env is whole — the ident's env kind folds
// the constant cases to their value-distinct forms: an EFFECT name becomes
// EAEffect (its intern handle), a NULLARY ctor becomes EACon (its intern
// handle — a nullary ctor is a constant, its tag). Everything else keeps
// the conservative EANode arm: a let/param-bound name is a genuine runtime
// operand (leak-instance-node's contract), and a fielded ctor used bare is
// a function value, never a constant. The fold lives here and not in
// build_row_seen because the parser also calls that fold (fn-TYPE rows, at
// parse time, env part-built) — an env-dependent leaf there would make the
// row a function of parse ORDER, the decl-order disease 4.2 paid to kill.
fn resolve_declared_instances(effs) = map(resolve_instance_triple, effs)

fn resolve_instance_triple(eff) = match eff {
  (name, negated, conn) => (resolve_instance_name(name), negated, conn),
}

fn resolve_instance_name(name) = match name {
  EParameterized(h, args) => EParameterized(h, map(resolve_one_eff_arg, args)),
  ENamed(_) => name,
  EPure => name,
}

fn resolve_one_eff_arg(arg) = match arg {
  EANode(nh) => match graph_node_body(nh) {
    NExpr(VarRef(nm)) => match env_lookup(nm) {
      Some(entry) => match entry {
        (sch, _, kind) => match kind {
          EffectDeclKind(_) => EAEffect(intern_str(nm)),
          ConstructorScheme(_, _) => match judgment_ty(sch) {
            TName(_, _) => // nullary ctor: the scheme's result IS the TName (fielded
            // ctors carry TFun — scheme_result_is' own reading)
            EACon(intern_str(nm)),
            _ => arg,
          },
          _ => arg,
        },
      },
      None => arg,
    },
    _ => arg,
  },
  EAInt(_) => arg,
  EAFloat(_) => arg,
  EAString(_) => arg,
  EAType(_) => arg,
  EAEffect(_) => arg,
  EACon(_) => arg,
}

// The declared row's INSTANCE PIN — the constraint half the publish law
// keeps: the declaration publishes NOTHING, but it is still a CONSTRAINT
// the inferred is verified against (the Intent-Boundary law), and for a
// value-parameterized effect the authored scalar instance (`with
// S(48000)`) is exactly such a constraint on the charge's unknowable
// value dims (register_effect_ops' EANode positions). Position-wise,
// scalars only, never a name added or a tail touched — the EtAll
// fabrication the publish law deleted cannot ride this write.
fn pin_declared_instances(body_row, declared_row) = match declared_row {
  EfRow(dp, _, _) => match body_row {
    EfRow(bp, ba, bt) => ef_make(map((b) => pin_present_entry(b, dp), bp), ba, bt),
  },
}

fn pin_present_entry(b, dp) = match b {
  EParameterized(bn, bargs) => match find((d) => pin_source_for(bn, bargs, d), dp) {
    Some(d2) => match d2 {
      EParameterized(_, dargs) => EParameterized(bn, pin_arg_positions(bargs, dargs, 0)),
      ENamed(_) => b,
      EPure => b,
    },
    None => b,
  },
  ENamed(_) => b,
  EPure => b,
}

fn pin_source_for(bn, ref bargs, d) = match d {
  EParameterized(dn, dargs) => dn == bn && !eff_args_provably_distinct(dargs, bargs, 0),
  ENamed(_) => false,
  EPure => false,
}

fn pin_arg_positions(ref bargs, ref dargs, i) = if i >= len(bargs) {
  []
} else if i >= len(dargs) {
  [list_index(bargs, i)] ++ pin_arg_positions(bargs, dargs, i + 1)
} else {
  [pin_arg_position(list_index(bargs, i), list_index(dargs, i))] ++ pin_arg_positions(bargs, dargs, i + 1)
}

// A charge-side value dim (EANode) takes the declared scalar; a type dim
// (EAType) is the install flow's, never value-pinned; a concrete scalar
// keeps its own truth (the subsumes read judges it).
fn pin_arg_position(barg, darg) = match barg {
  EANode(_) => pin_scalar_or_keep(barg, darg),
  EAType(_) => barg,
  EAInt(_) => barg,
  EAFloat(_) => barg,
  EAString(_) => barg,
  EAEffect(_) => // registration-fold constants: concrete, they keep their own truth
  // exactly as the scalar literals do (the subsumes read judges them)
  barg,
  EACon(_) => barg,
}

fn pin_scalar_or_keep(barg, darg) = match darg {
  EAInt(_) => darg,
  EAFloat(_) => darg,
  EAString(_) => darg,
  EAType(_) => barg,
  EAEffect(_) => // the registration fold's constants pin the charge's unknowable value
  // dim exactly as the scalar literals do — the declared instance IS the
  // decl's own truth
  darg,
  EACon(_) => darg,
  EANode(_) => // The declared NON-LITERAL instance pins exactly as a scalar does:
  // the charge's value dim is the entry's unknowable placeholder, and
  // the declared operand NODE is the decl's own instance truth — same
  // handle, so same-name instances compare equal and the false
  // declared-vs-charged mismatch dies (measured 2026-08-08:
  // `with Sample(rate)` refused its own body's tick()). The
  // conservative gate against a forbidden literal is untouched — an
  // EANode is still never provably distinct from it.
  darg,
}

fn enforce_row_gate(name: String, declared_row, has_pure, row_handle, span: ValidSpan) = {
  let bound = graph_chase(row_handle)
  match bound {
    GNode(NRowBound(raw_row), _) => {
      let body_row = pin_declared_instances(raw_row, declared_row)
      // The pin is a decl-exit REPLACE (the entry's unknowable value dim
      // becomes the declared scalar), so it takes graph_finalize_row —
      // the teaching write is a JOIN, and a join dedups the pinned entry
      // against the stored one by name, keeping the unpinned form.
      if body_row == raw_row {
        ()
      } else {
        graph_finalize_row(row_handle, body_row, Located(span, Declared(name)))
      }
      if row_subsumes(body_row, declared_row) {
        // D2 — when body_row is STRICTLY narrower than declared_row
        // (body ⊆ declared and declared ⊄ body), the fn is
        // over-declared — it reserves more capabilities than it
        // uses. Emit T_OverDeclared as a teaching warning so the
        // author can tighten the signature and unlock the tighter
        // row's capabilities (memoization for the pure row, real-time
        // for !Alloc, etc.).
        if row_subsumes(declared_row, body_row) {
          ()
        } else {
          report(TOverDeclared(declared_row, body_row, name, span))
        }
        // THE PROOF IS THE INTERFACE (the settled publish law, landed
        // WITH the union and THE FLAT-CELL LAW — the census proved the
        // pairing forced: with complete paths, the declared publish
        // delivered fabricated EtAll everywhere): the cell keeps its
        // PROVEN row; the declaration publishes NOTHING. A closed proven
        // row already entails every declared absence. The ONE
        // declaration-write that survives is the ABSENT refinement,
        // load-bearing exactly on an OPEN tail: the declared absences
        // join the cell's absent field riding the cell's own edge set as
        // carrier (row_join unions absents only across open tails —
        // closed bodies entail their absences and take no write), so !E
        // constrains every instantiation of a polymorphic row —
        // bind_open_to_neg's mechanism as the one authored write.
        match declared_row {
          EfRow(_, da, _) => if len(da) > 0 {
            match resolve_row_compress(body_row) {
              EfRow(_, _, EtOpen(vs)) => graph_bind_row(row_handle, ef_make([], da, EtOpen(vs)), Located(span, Declared(name))),
              _ => (),
            }
          } else {
            ()
          },
        }
      } else {
        if has_pure {
          report(EPurityViolated(body_row, span))
        } else {
          report(EEffectMismatch(declared_row, body_row, span))
        }
      }
    },
    GNode(NRowFree(_), _) => // A FREE cell is UNJUDGED, and unjudged is not proven-empty — the
    // graph draws that distinction and this arm used to erase it. A
    // genuinely chargeless body binds its cell to Pure and takes the
    // NRowBound arm above (measured: `fn chargeless(x) with A = x + 1`
    // projects `chargeless : Pure`), so a cell still FREE here was never
    // determined by its body at all: the shape that reaches it is the
    // effect-polymorphic HOF, whose row is its param's row and grounds
    // only at a call site (`fn run(f) with A = f()` projects
    // `run : r39693@e2`, a bare var, against f's own `r39695@e2`).
    // Teaching over-declaration from that cell fabricated the body row
    // it claimed to have read, and the fabrication reached the author:
    // `mentl tighten` authors the patch T_OverDeclared names, so the
    // medium recommended narrowing a declaration to `Pure` on a body it
    // had never judged. ENFORCEMENT is unchanged — a free tail enforces
    // eagerly and holds, which is this gate's settled policy (parking it
    // was measured to switch the crown silently off) — only the
    // unearned teaching goes. What the cursor SHOULD say here is that
    // the row is polymorphic in a param's row, which is a diagnostic
    // this catalog does not carry yet: `Hβ.diag.row-polymorphic-body`.
    (),
    _ => // THE UNBOUND CELL IS THE PURE BODY — no charge ever landed,
    // so the gate holds trivially (a pure row fits every declaration)
    // and the declaration binds NOTHING. The PIN that stood here died
    // with the publish law: pinning the declaration into an unbound
    // cell made a pure body publish declared effects as its truth,
    // and a !-bearing declaration's universe-minus triple fabricated
    // EtAll into the live graph — THE ETALL LAW's named hazard,
    // delivered everywhere the moment the union completed the paths
    // (and measured a THIRD way at the park: resolve_row's own
    // published row read `!Mutate + Any` through this bind). What
    // survives: the over-declared teaching (a non-pure declaration
    // over a chargeless body); genuine mid-cycle lag parks via the
    // group deferral for the drain's fully-resolved world (the
    // parse_effect_list_from flip class's enforcement rides the
    // deferral, not a fabricating bind — the flip fixtures arbitrate).
    if row_subsumes(declared_row, mk_ef_pure()) {
      ()
    } else {
      report(TOverDeclared(declared_row, mk_ef_pure(), name, span))
    },
  }
}

// The group-event drain (B4, rung 3): every parked gate fires at its
// OWN group's completion — trial_judge_group calls this after the
// completion fold, when the cycle's chains are closed. Groups run
// sequentially, so the parked set at a group's exit is that group's.
// A gate whose row still carries a FREE edge here is a CROSS-GROUP
// forward ref — the caller's group completion is not that edge's
// resolution event (join_loop's edge fills at str_concat's group, a
// file deeper in the weave) — so it RE-PARKS instead of enforcing
// early: the early fire judged a half-row and manufactured false
// T_OverDeclared. Each subsequent group event re-checks it, and it
// enforces the moment its chains close; the pass tail drains whatever
// outlives every group.
// CONDEMNED FORM (the resolved design D4): when completion makes parks
// impossible by construction, the park/drain machinery deletes whole.
fn drain_deferred_row_gates() = each(
  (g) => match g {
    (name, declared_row, has_pure, row_handle, span) => if row_gate_unresolved(row_handle) {
      defer_row_gate(g)
    } else {
      enforce_row_gate(name, declared_row, has_pure, row_handle, span)
    },
  },
  drain_row_gates()
)

// B4's belt at the pass tail, refined by the row-channel stamp: gates
// re-parked for CROSS-GROUP edges legitimately outlive every group
// event and drain HERE, where the whole pass's chains have closed —
// they enforce silently against closed truth. EInternalInvariant is
// reserved for a gate STILL unresolved at the tail: a chain that
// survived the entire pass names a genuinely missed channel (loud,
// census-visible) and still enforces (the belt reports, never drops).
// A named walk, not a fold lambda (the report's row would deny the
// lambda a decl home).
fn assert_row_gates_drained() = assert_gates_walk(drain_row_gates())

fn assert_gates_walk(gs) = if len(gs) == 0 {
  ()
} else {
  match last(gs) {
    (name, declared_row, has_pure, row_handle, span) => {
      if row_gate_unresolved(row_handle) {
        report(EInternalInvariant(
          "a row gate for '{name}' is still unresolved at the pass tail — a chain survived the whole pass",
          span
        ))
      } else {
        ()
      }
      enforce_row_gate(name, declared_row, has_pure, row_handle, span)
    },
  }
  assert_gates_walk(drop_last(gs))
}

// H4 helper — does a CallExpr's callee resolve to an alloc-returning
// scheme? Constructors (ConstructorScheme) emit LMakeVariant which
// heap-allocates; nominal records (RecordSchemeKind, H2.3) reach
// here only via degenerate CallExpr — canonical form is
// NamedRecordExpr. Either way the result handle deserves region
// tracking.
fn call_is_alloc_returning(func) = match func {
  N(body, _, _) => match body {
    NExpr(VarRef(name)) => match env_lookup(name) {
      Some(entry) => match entry {
        (_, _, kind) => match kind {
          ConstructorScheme(_, _) => true,
          RecordSchemeKind(_) => true,
          _ => false,
        },
      },
      None => false,
    },
    _ => false,
  },
}

// H4 alloc-region tracking (region_enter/region_exit) opened a region
// when a `handle` block absorbed Alloc. With `handle` dissolved into
// `~>` (the one install verb), region-opening belongs on the PTee
// install when the installed handler absorbs Alloc — the cursor reads
// the handler's HandlerKind row live and opens a region iff Alloc ∈ E.
// Positive-form peer: Hβ.infer.region-on-tee-alloc-absorb. Until then the
// region effect + own.mn handler stand as dormant capability surface.
//
// Build an `EffRow` from the authored effect terms — each (EffName,
// negated, EConn). The with-clause is a SIGNED SET, not a running union:
// positive terms name what the body may perform (composed by the authored
// connective via the effects.mn algebra); negated terms name what it
// provably must NOT (one forbidden set — complements compose by
// intersection). The row is their meet:
//
//   P only       → Closed[P]
//   !N only      → ¬Closed[N]                       (the universe-minus stance)
//   P + !N mixed → Closed[P] ∩ ¬Closed[N] = Closed[P ∖ N]
//
// A raw union would collapse `Cursor + IC + !Mutate` to ¬Mutate — set-true
// but contract-false: the positives ARE the published API (callers thread
// evidence from them); the negation is the GATE. An authored `Pure` is
// absolute (D3) and dominates the clause at every caller, not only those
// that pre-check has_pure_declared. A name both admitted and forbidden
// drops out of the meet, so the body's own perform fails the subsumption
// gate LOUDLY (E_EffectMismatch) — never a silent contradiction.
// ─── Instance-arg typing (SYNTAX §«Parameterized effect») ────────────
// Each authored instance in a with-clause judges against the effect's
// registered signature — the TTuple scheme register_effect_ops
// publishes (the one home). Arity disagreement reports as the
// constructor-arity class at the declaration; a scalar-literal arg
// whose ground type disagrees with the declared param reports the
// mismatch. Type- and node-shaped args carry the instance-unification
// flow (the modal frontier's admit-through-instantiation face) and
// pass this ground check.
fn check_instance_args(effs, span: ValidSpan) = each(
  (eff) => match eff {
    (ename, _negated, _conn) => match ename {
      EParameterized(h, args) => match env_lookup(intern_name_of(h)) {
        Some(entry) => match entry {
          (sch, _, EffectDeclKind(_)) => match judgment_ty(sch) {
            TTuple(ptys) => if len(args) != len(ptys) {
              report(EConstructorArity(intern_name_of(h), len(ptys), len(args), span))
            } else {
              each(
                (i) => check_one_instance_arg(list_index(args, i), list_index(ptys, i), span),
                range(0, len(args))
              )
            },
            _ => (),
          },
          _ => (),
        },
        None => (),
      },
      _ => (),
    },
  },
  effs
)

fn check_one_instance_arg(arg, pty, span: ValidSpan) = match instance_arg_scalar_ty(arg) {
  Some(aty) => if same_ground(aty, fold_strip(pty)) { () } else { report(ETypeMismatch(aty, pty, span)) },
  None => (),
}

// A scalar literal arg's ground type; type/node args answer None (their
// typing is the instance-unification flow, not a ground compare).
fn instance_arg_scalar_ty(arg) = match arg {
  EAInt(_) => Some(TInt),
  EAFloat(_) => Some(TFloat),
  EAString(_) => Some(ty_string),
  EAType(_) => None,
  EANode(_) => None,
  EAEffect(_) => // interned identities: an effect name has no ground value type, and a
  // ctor's result rides the instance-unification flow — both pass the
  // ground check the way the node arm does
  None,
  EACon(_) => None,
}

// is_pure_eff_name / apply_connective / has_pure_declared /
// build_declared_row live in effects.mn now — pure row algebra over the
// parsed signed triples, ONE home serving this judge and the parser's
// fn-type `with` rows alike.
//
// Expression inference
fn infer_expr(ref node) = match node {
  N(body, span, handle) => match body {
    NExpr(LitInt(_)) => graph_bind(handle, TInt, Located(span, Inferred("int literal"))),
    NExpr(LitFloat(_)) => graph_bind(handle, TFloat, Located(span, Inferred("float literal"))),
    NExpr(LitString(_)) => graph_bind(handle, ty_string, Located(span, Inferred("string literal"))),
    NExpr(LitBool(_)) => graph_bind(handle, TName("Bool", []), Located(span, Inferred("bool literal"))),
    NExpr(LitUnit) => graph_bind(handle, TUnit, Located(span, Inferred("unit"))),
    NExpr(VarRef(name)) => infer_var_ref(name, handle, span),
    NExpr(BinOpExpr(op, left, right)) => {
      infer_expr(left)
      infer_expr(right)
      match left {
        N(_, _, lh) => match right {
          N(_, _, rh) => infer_binop(handle, op, lh, rh, span),
        },
      }
    },
    NExpr(UnaryOpExpr(op, inner)) => {
      infer_expr(inner)
      match inner {
        N(_, _, ih) => infer_unaryop(handle, op, ih, span),
      }
    },
    NExpr(CallExpr(func, args)) => {
      infer_expr(func)
      // The arg list is the callee's positional product: resolve labeled args
      // to positional order and fill absent fields with param defaults (the ONE
      // read both infer + lower call — they see the identical order). The
      // LabeledArg wrappers never reach infer_expr — resolution strips them.
      let cname = callee_name(func)
      let params = callee_params(cname)
      let pos_args = resolve_call_args(cname, args)
      // A named callee that MISSES env already reported (one miss, one
      // diagnostic); its parameter product is unreadable, so the move-vs-
      // borrow read has no ground. Compounding the miss with a move default
      // was the ownership false-positive cascade (`len(buf)` unresolved
      // consuming buf). Borrow the args under the miss; param-position and
      // lambda callees keep normal inference (their schemes resolve).
      if callee_missing_in_env(func, cname) {
        borrow_enter()
        infer_call_arg_list(pos_args, params, 0)
        borrow_exit()
      } else {
        infer_call_arg_list(pos_args, params, 0)
      }
      infer_call(func, pos_args, handle, span)
      // H4: constructor calls allocate a heap record. Tag the
      // resulting handle so check_escape at fn return can verify
      // the value doesn't outlive its region. H4.1: constructor
      // ARGS ARE the fields — the resulting record's region pins
      // to the deepest field region.
      if call_is_alloc_returning(func) { tag_alloc_join(handle, collect_handles(pos_args)) }
    },
    NExpr(IfExpr(cond, then_e, else_e)) => {
      // The condition is READ to decide the branch — a read-SHAPE
      // condition borrows; a call condition infers normally (its args
      // move; ref-param borrows already come from the callee-product
      // read). The shared shape gate, all four surfaces.
      infer_borrowed_read(cond)
      // then / else are ALTERNATIVE arms — exactly one runs — so an `own`
      // value consumed in both is one consume on the taken path, never a
      // double. The affine ledger unions the arms' deltas without a
      // collision check (BAlternative), the same mechanism `><` / `<|`
      // use with BParallel. Without this, every `if c { use(buf) } else {
      // use(buf) }` threading an owned accumulator floored E_OwnershipViolation.
      branch_enter(BAlternative)
      infer_expr(then_e)
      branch_divider(span)
      infer_expr(else_e)
      branch_exit(span)
      match cond {
        N(_, _, ch) => match then_e {
          N(_, _, th) => match else_e {
            N(_, _, eh) => match else_e {
              N(else_body, _, _) => {
                graph_bind(ch, TName("Bool", []), Located(span, IfBranch(Inferred("condition"))))
                // E_IfMissingElse per SYNTAX.md: detect synthesized-LitUnit else
                // (parser produces LitUnit when no else clause — src/parser.mn:1275).
                // If the then-branch produces a non-unit value, the missing else
                // is structurally invalid: the if would have to "produce nothing"
                // on the false path. Emit before unify so user sees the structural
                // cause, not the downstream E_TypeMismatch.
                let else_is_synthesized_unit = match else_body {
                  NExpr(LitUnit) => true,
                  _ => false,
                }
                if else_is_synthesized_unit {
                  let then_ty = lookup_ty(th)
                  match then_ty {
                    TUnit => // Unit's REAL constructor is TUnit — the old TName("Unit") arm
                    // matched a nominal spelling the inferencer never produces, so
                    // every genuinely-unit then (`if c { wat_emit(...) }`, 25 wheel
                    // sites) was judged non-unit. The probe that settled it printed
                    // then_ty=() for all 25.
                    (),
                    TName("Unit", _) => (),
                    TVar(_) => // An UNRESOLVED then is not evidence either — an effect-op
                    // call's result resolves through the unify just below (6 wheel
                    // sites). The unify against the synthesized unit decides: a
                    // genuinely non-unit then mismatches loudly there.
                    (),
                    _ => report(EIfMissingElse(span)),
                  }
                }
                unify(th, eh, span, IfBranch(Inferred("branches must match")))
                graph_bind(handle, TVar(th), Located(span, IfBranch(Inferred("if result"))))
              },
            },
          },
        },
      }
    },
    NExpr(BlockExpr(stmts, final_expr)) => {
      env_scope_enter()
      infer_stmt_list(stmts)
      infer_expr(final_expr)
      match final_expr {
        N(_, _, fh) => {
          graph_bind(handle, TVar(fh), Located(span, Inferred("block result")))
          env_scope_exit()
        },
      }
    },
    NExpr(MatchExpr(scrutinee, arms)) => {
      // The scrutinee is READ to dispatch — a read-shape scrutinee
      // (`match kind { ... }`) borrows and stays available in the arms;
      // a CALL scrutinee (`match lex_from(..., buf, ...)`) infers
      // normally so its own-param moves record (the splice scanners'
      // false unconsumed, healed by the shared shape gate).
      infer_borrowed_read(scrutinee)
      match scrutinee {
        N(_, _, sh) => infer_match_arms(arms, sh, handle, span),
      }
    },
    NExpr(MakeListExpr(elems)) => {
      infer_expr_list(elems)
      // The literal allocates its header even empty — the charge covers
      // both branches (construction_row's law).
      inf_add_row(construction_row())
      if len(elems) == 0 {
        let elem_h = mint(Inferred("empty list element"))
        graph_bind(handle, TList(TVar(elem_h)), Located(span, Inferred("empty list")))
      } else {
        let first = last(elems)
        match first {
          N(_, _, fh) => {
            unify_list_elems(drop_last(elems), fh, span)
            graph_bind(handle, TList(TVar(fh)), Located(span, Inferred("list literal")))
          },
        }
      }
      // H4.1: list elements may carry inner-region pointers; join.
      tag_alloc_join(handle, collect_handles(elems))
    },
    NExpr(MakeTupleExpr(elems)) => {
      infer_expr_list(elems)
      inf_add_row(construction_row())
      graph_bind(handle, TTuple(collect_tvar_types(elems)), Located(span, Inferred("tuple literal")))
      tag_alloc_join(handle, collect_handles(elems))
    },
    NExpr(IndexExpr(receiver, index)) => {
      // Per #139 — semantic subscript. Infer receiver + index; the result
      // chases the receiver's element. Force = UNIFY, never overwrite
      // (seq_force's own law, one table over): the old graph_bind here
      // DISCARDED the receiver's proven TList(elem) and orphaned a fresh
      // element class per subscript — the union-find FRACTURE that forced
      // the monomorphization free-leaf rule (probe-pinned 2026-07-22:
      // merge's condition subscripts rooted apart from its own param
      // element; unifying collapses them to ONE class). A TList force on a
      // proven-String receiver is SATISFIED (§4① — a String IS a
      // sequence); its element is the byte. Tuple-const-index /
      // record-int-key remain the named peer Hβ.infer.index-expr-dispatch.
      // An INDEX READ is a borrow — the read-is-a-borrow law's fourth
      // surface beside the if condition, the match scrutinee, and the
      // field receiver: xs[i] reads an element without moving xs, so an
      // `own` list indexed then passed onward is one consume, not two
      // (measured: the fan's join arm read recs[jn] before threading
      // recs, and the ledger demanded restructuring provably-safe code —
      // the Hylo-quiet bar naming the inference gap).
      infer_borrowed_read(receiver)
      infer_expr(index)
      match receiver {
        N(_, _, rh) => match index {
          N(ibody, _, ih) => {
            let exp_i = mint(Inferred("index value"))
            graph_bind(exp_i, TInt, Located(span, Inferred("index value")))
            unify(ih, exp_i, span, Inferred("index value"))
            // Tuple-const-index — the judge's half of the dispatch lower
            // already performs (its LFieldLoad prefix-sum): a receiver
            // CHASED to a tuple, indexed by a literal, types as that
            // position's element (SYNTAX §Indexing's compile-time
            // extraction, H6 bounds at the judgment). The read is the
            // SHALLOW root binding (graph_chase — one union-find walk,
            // no deep fold: chase_deep_at mid-inference tripped its own
            // depth belt on the wheel's unconverged chains, measured at
            // the m3 leg). A FREE receiver (a generic body's param)
            // still takes the list force — the open POSITIONAL demand
            // (TRecordOpen's tuple sibling) is the named remainder of
            // Hβ.infer.index-expr-dispatch; a literal-indexed tuple in
            // a generic body destructures until it lands.
            match index_receiver_shallow(rh) {
              TTuple(elems) => match ibody {
                NExpr(LitInt(k)) => if k >= 0 && k < len(elems) {
                  graph_bind(handle, list_index(elems, k), Located(span, Inferred("tuple element")))
                } else {
                  // H6 at the judgment: the literal names a position the
                  // product does not have — expected arity vs the index.
                  report(EConstructorArity("tuple index", len(elems), k, span))
                  graph_bind(
                    handle,
                    TVar(mint(Inferred("tuple index out of range"))),
                    Located(span, Inferred("tuple index out of range"))
                  )
                },
                _ => // a runtime-variable index cannot type a heterogeneous
                // product — the list force below reports the honest mismatch
                infer_index_force(rh, handle, span),
              },
              _ => infer_index_force(rh, handle, span),
            }
          },
        },
      }
    },
    NExpr(MakeStringExpr(fragments)) => {
      // A splice fragment keeps ITS OWN inferred type (SYNTAX Strings:
      // "a {expr} splice carries the spliced node's type"); rendering is
      // the structural show at lower/emit. The old unify_string_fragments
      // bound every fragment to String — a fabrication that clobbered an
      // Int splice's truth, split the emit's show dispatch (VarRef dodged
      // through its binding-time handle; a literal read the clobber and
      // emitted BARE — Hβ.emit.int-splice-empty's judge half), and would
      // refuse "{3}" outright if unify were strict. Deleted whole.
      infer_expr_list(fragments)
      check_splice_flow_labels(fragments, span)
      // The interior-concat cells, minted ONCE here (the concat-key
      // dossier's settled design): lower's fold reads them from the
      // boundary column instead of minting per run — every
      // program-derived key collides with a call-keyed handle in its
      // own subtree, and a judge mint is trailed and reproducible.
      // The count mirrors lower's elision (empty literals drop).
      graph_boundary_set(handle, InterpBoundary(interp_concat_cells(fragments, span)))
      graph_bind(handle, ty_string, Located(span, Inferred("string interpolation")))
    },
    NExpr(ShowExpr(inner)) => {
      // The splice's structural show as a judged node (γ's splice
      // half): the inner keeps its own inferred type — the show
      // accepts ANY type by construction (the dispatch is emit's
      // structural read) — and the node itself IS a String, the
      // handle lower's LShow reads instead of minting a cell.
      infer_expr(inner)
      graph_bind(handle, ty_string, Located(span, Inferred("splice show")))
    },
    NExpr(MakeRecordExpr(fields)) => {
      // Each field's value is inferred; the record's type is
      // TRecord((field_name, TVar(value_handle))) sorted by name.
      // Parser already sorted; lower / emit honor the same order.
      infer_record_field_values(fields)
      inf_add_row(construction_row())
      let field_types = build_record_field_types(fields)
      graph_bind(handle, TRecord(field_types), Located(span, Inferred("record literal")))
      // H4.1: record fields may carry inner-region pointers; join.
      tag_alloc_join(handle, record_field_handles(fields))
    },
    NExpr(RecordUpdateExpr(base, overrides)) => {
      // {...base, f: v} — non-destructive update. Infer the base (its
      // record fields are the copy source) and each override value;
      // the result type is the base's record fields with each override
      // overwritten-or-added by name (the field set lower reads live).
      // The base's proven record type IS the source of truth — the
      // result is derived from it, never fabricated.
      infer_expr(base)
      // The spread base MUST be record-shaped — the same open-record
      // constraint field access erects, so `{...5, f: v}` is a type
      // error at the spread, never a zero-field fabrication.
      match base {
        N(_, _, bh) => {
          let base_row_h = graph_fresh_row(Inferred("record update row"))
          let expected_h = mint(Inferred("record update base"))
          graph_bind(expected_h, mk_record_open([], base_row_h), Located(span, Inferred("expected record")))
          unify(bh, expected_h, span, Inferred("record spread base"))
          infer_record_field_values(overrides)
          inf_add_row(construction_row())
          let base_fields = record_fields_of_node(base)
          let override_types = build_record_field_types(overrides)
          let merged = merge_override_fields(base_fields, override_types)
          graph_bind(handle, TRecord(merged), Located(span, Inferred("record update")))
          tag_alloc_join(handle, record_field_handles(overrides))
        },
      }
    },
    NExpr(NamedRecordExpr(type_name, fields)) => {
      // H2.3: nominal record literal. Look up the type name's
      // RecordSchemeKind to validate the field set and unify each
      // value against the declared field type. Bind the handle to
      // TName(type_name, []).
      infer_record_field_values(fields)
      inf_add_row(construction_row())
      match env_lookup(type_name) {
        None => report(EMissingVariable("record type: {type_name}", span)),
        Some(entry) => match entry {
          (_, _, kind) => match kind {
            RecordSchemeKind(declared) => {
              check_nominal_record_fields(declared, fields, type_name, span)
              graph_bind(handle, TName(type_name, []), Located(span, Inferred("nominal record literal")))
            },
            _ => report(ENotARecordType(type_name, span)),
          },
        },
      }
      tag_alloc_join(handle, record_field_handles(fields))
    },
    NExpr(ResumeExpr(val, state_updates)) => {
      // Typed-resume law (SYNTAX §Effect declarations): inside
      // `op(args) => body` for `op : (P...) -> R` under a handler
      // whose handle-result is S, `resume : R -> S`. The value flows
      // to the perform site (v unifies with R); the expression's own
      // value is the continuation's completion (S).
      infer_expr(val)
      match val {
        N(_, _, vh) => {
          match inf_arm_tys() {
            Some(continuation_h) => match graph_chase(continuation_h) {
              GNode(NBound(TCont(resume_input, answer, _, _)), _) => {
                let r_h = mint(Inferred("op result at resume"))
                graph_bind(r_h, resume_input, Located(span, Inferred("resume carries the continuation input")))
                unify(vh, r_h, span, Inferred("resume carries the continuation input"))
                graph_bind(handle, answer, Located(span, Inferred("resume yields the continuation answer")))
              },
              _ => report(EUnresolvedType(continuation_h, graph_epoch(), span)),
            },
            None => // resume outside any arm — parse admitted it; surface the
            // structural fact rather than fabricating a type.
            report(EResumeOutsideArm(span)),
          }
          // State updates: each `with name = expr` EVOLVES the handler state, so the
          // update's type MUST unify with the state field's type (carried in arm
          // scope as TVar(init_handle) by bind_handler_state_names). DROPPING them —
          // as this arm did — leaves the field at ONLY its init type: an empty-list
          // init stays List(?free), and a later `state_field.field` read on that free
          // element is exactly the lower_scope ls_push_scope trap (resolve_field_offset
          // returns -1 → unreachable). Carry the update's type into the field; never
          // discard what the graph could prove (Carried-Truth).
          each(
            (upd) => {
              infer_expr(state_field_init(upd))
              match state_field_init(upd) {
                N(_, _, uh) => match env_lookup(state_field_name(upd)) {
                  Some(entry) => match entry {
                    (scheme, reason, _) => {
                      let fh = mint(Inferred("resume state field type"))
                      graph_bind(fh, instantiate(scheme), Located(span, VarLookup(state_field_name(upd), reason)))
                      unify(uh, fh, span, Inferred("resume state update carries the state field's type"))
                    },
                  },
                  None => (),
                },
              }
            },
            state_updates
          )
        },
      }
    },
    NExpr(FieldExpr(rec, field)) => // `a.b` is structural field access on the record `a`'s type, read
    // live from the graph. A qualified `module.name` reference resolves
    // by following the import edge to the module env node (SYNTAX.md
    // §Imports) — never a flattened `module.name` env key (Carried-Truth:
    // the dotted-string lookup was the canonical re-derivation, now
    // deleted with its write side; edge-following overlay = peer
    // Hβ.driver.per-module-env-overlay).
    infer_field_access_record(rec, field, handle, span),
    NExpr(LambdaExpr(params, body_node)) => {
      env_scope_enter()
      let param_handles = mint_params(params, "lambda")
      let row_handle = graph_fresh_row(Inferred("lambda effects"))
      match body_node {
        N(_, _, bh) => {
          inf_enter_fn(row_handle, bh, span, [])
          infer_expr(body_node)
          inf_exit_fn(signature_free_roots(param_handles ++ [bh]))
          // ABSTRACTION IS PURE — creating a closure performs nothing. The
          // lambda's row rides its TYPE (the TFun below); every APPLIER is
          // charged by the call edge, an escaping closure included (its
          // eventual call site reads the row off the closure's type), and
          // the runtime evidence resolves through the live install chain at
          // the perform site (world-as-value R2 — a thunk performs where
          // CALLED). The former create-flows-row edge here charged the
          // CREATOR with the closure's whole row — a mint-time-evidence
          // relic that made every absorbed-thunk pattern leak: a thunk
          // passed to an absorbing bracket polluted the creator's row with
          // effects the bracket provably absorbs (measured: Ping through
          // bracket(() => ping()), and infer_context's three wheel callers
          // carrying the whole analysis core unsubtracted).
          graph_bind(
            handle,
            TFun(build_param_types(params, param_handles), TVar(bh), mk_ef_open([], row_handle)),
            Located(span, Inferred("lambda"))
          )
          // H4: every lambda allocates a closure record on the heap.
          tag_alloc(handle)
          env_scope_exit()
        },
      }
    },
    NExpr(PipeExpr(kind, left, right)) => // Branching verbs install affine-ledger snapshots around their
    // sub-infers so parallel branches cannot silently consume the
    // same own-name. Non-branching verbs use the straight-through
    // infer-both-sides / then-infer_pipe pattern.
    match kind {
      PFanout(fan_own) => infer_fanout(fan_own, left, right, handle, span),
      PForward => {
        infer_expr(left)
        infer_expr(right)
        infer_pipe(kind, left, right, handle, span)
      },
      PTee => infer_pipe_tee(left, right, handle, span),
      PFeedback => {
        infer_expr(left)
        infer_expr(right)
        infer_pipe(kind, left, right, handle, span)
      },
    },
    NExpr(FanoutExpr(branches)) => infer_fanout_nary(branches, handle, span),
    NExpr(RestExpr(_)) => // the cover-grammar rest outside its one legal home (a
    // destructuring lambda parameter, where expr_to_pat consumed it):
    // loud refusal, handle left free — productive-under-error.
    report(ERestOutsideDestructure(span)),
    NExpr(ExprPlaceholder) => // ? — handle already NFree at parse
    (),
    NExpr(LabeledArg(label, _)) => // A labeled call arg is resolved to positional by resolve_call_args
    // BEFORE infer_expr ever sees it; reaching here means a LabeledArg leaked
    // outside a call's arg list. Locate it (productive-under-error) rather
    // than fabricate a type — the no-silent-fallback law over a load-bearing
    // node-kind.
    report(EUnknownArgLabel("labeled argument `{label} = …` is only valid in a call's argument list", span)),
    NHole(_) => // Hazel marked hole — inference leaves NFree
    (),
    NStmt(_) => // statement at expression position — parser
    // should have wrapped in ExprStmt; no-op
    // is the safe fallback
    (),
    NPat(_) => // pattern at expression position — degenerate;
    // parser emits in match-arm contexts only
    (),
    NModule(_) => // the synthetic per-file module handle at
    // expression position — degenerate; NModule
    // is never itself an expression node
    (),
    NTypeAnn(_) => // an authored type annotation at expression
    // position — degenerate; NTypeAnn is read
    // directly by return-type/let-annotation call
    // sites, never reached through infer_expr
    (),
  },
}

// Factored out of the `FieldExpr` match arm so the qualified-name
// fallback path (modules-as-env-entries) can share this without
// duplication. The record-open unification is unchanged from its
// original arm form.
//
// THE READ-SHAPE PROJECTION — the read-is-a-borrow law's ONE shape test,
// shared by all four borrow surfaces (if condition, match scrutinee,
// index receiver, field receiver). A READ SHAPE is decision arithmetic —
// a VarRef, field/index access rooted in one, a literal, or unary/binop
// composition of those (`buf != 0`, `a.n < b.n`): reading it decides or
// projects without moving anything. A CALL is NOT a read shape — its
// arguments follow the CALLEE'S param product (a declared/inferred ref
// borrows via the call-arg-borrow law; an own param genuinely moves), so
// bracketing a call here suppressed real consumes into own params AND
// would silence a real double-move (`if take(buf) > 0 { take(buf) }` —
// the old blanket condition-borrow was unsound, not merely noisy; the
// relevant tier made the suppressed consume REPORTABLE and two
// splice-scanner owns fired falsely through exactly this hole). The
// field site carried the call narrowing from its birth; the other three
// surfaces now read the same projection — the uniform pass replacing
// the per-site family.
fn is_read_shape(node) with Pure = match node {
  N(body, _, _) => match body {
    NExpr(VarRef(_)) => true,
    NExpr(FieldExpr(recv, _)) => is_read_shape(recv),
    NExpr(IndexExpr(recv, _)) => is_read_shape(recv),
    NExpr(LitInt(_)) => true,
    NExpr(LitFloat(_)) => true,
    NExpr(LitString(_)) => true,
    NExpr(LitBool(_)) => true,
    NExpr(LitUnit) => true,
    NExpr(UnaryOpExpr(_, inner)) => is_read_shape(inner),
    NExpr(BinOpExpr(_, l, r)) => is_read_shape(l) && is_read_shape(r),
    _ => false,
  },
}

// The borrow bracket, shape-gated: a read shape infers borrowed; any
// other expression infers normally (its own moves record).
fn infer_borrowed_read(node) = if is_read_shape(node) {
  borrow_enter()
  infer_expr(node)
  borrow_exit()
} else {
  infer_expr(node)
}

// Reading `.field` borrows the receiver — it never moves the record;
// the shared read-shape projection gates the bracket.
fn infer_field_access_record(rec, field, handle, span: ValidSpan) = match rec {
  N(rec_body, _, _) => {
    infer_borrowed_read(rec)
    match rec {
      N(_, _, rh) => {
        let field_h = mint(Inferred("field type"))
        let row_h = graph_fresh_row(Inferred("record row"))
        let expected = mk_record_open([(field, TVar(field_h))], row_h)
        let expected_h = mint(Inferred("record access"))
        graph_bind(expected_h, expected, Located(span, Inferred("expected record")))
        unify(rh, expected_h, span, Inferred("field access"))
        graph_bind(handle, TVar(field_h), Located(span, Inferred("field type")))
      },
    }
  },
}

// Instantiate the scheme from env, bind the handle, then consume
// if the binding is an `own` parameter. The affine-ledger handler
// in `own.mn` decides which names are own-marked; `check_consume_at_use`
// performs unconditionally and lets the handler decide.
fn infer_var_ref(name, handle, span: ValidSpan) = {
  // The note fires ABOVE the env match: a missing name is still a
  // reference (the whole-weave scan counted it; the column must too).
  graph_ref_note(name, handle)
  match env_lookup(name) {
    None => {
      report(EMissingVariable(name, span))
      // The miss IS the fact — poison, never a normal-looking var. The old
      // TVar(handle) self-bind tripped graph_bind's own occurs check (a
      // spurious 0:0 E_OccursCheck per missing name) and read downstream as
      // an unconstrained var (the ownership move-default false positives).
      // A hole no-ops in unify, preserves the handle through generalize, and
      // keeps every consumer silent: one miss, one diagnostic.
      graph_bind_hole(handle, Located(span, MissingVar(name)))
    },
    Some(entry) => match entry {
      (scheme, reason, kind) => {
        // A seq-op MENTION types as its FACE, never the raw body's scheme
        // (the substrate boundary: list_set's `l + 8` types l Int, and
        // only the op's own body may read that; the saturated and holed
        // CALL paths already force the face — the bare mention was the
        // last raw-scheme leak, measured as `xs |> len` unifying List
        // against Int while emitting correctly, the 3.3 false-diagnostic
        // drift). The row stays the callee's own declared row.
        let ty = if is_seq_op(name) { seq_face_ty(name, scheme) } else { instantiate(scheme) }
        graph_bind(handle, ty, Located(span, VarLookup(name, reason)))
        // Carry parameter ownership from the env edge into Consume. No recovery
        // lookup: SchemeKind names the binding's construction origin.
        check_consume_at_use(name, kind, span)
      },
    },
  }
}

fn seq_face_ty(name: String, scheme) = {
  let elem = TVar(mint(Inferred("sequence element")))
  match seq_op_sig(name, elem) {
    Some(sig) => match sig {
      (ptys, ret) => match instantiate(scheme) {
        TFun(_, _, crow) => TFun(build_ctor_params(ptys, 0), ret, crow),
        other => // a seq-op whose scheme is not fn-shaped keeps its own read
        other,
      },
    },
    None => // the two tables enumerate the same names; productive if they diverge
    instantiate(scheme),
  }
}

// A NAMED callee that misses env — the shape whose parameter product the
// move-vs-borrow read cannot ground. Param-position and lambda callees have
// resolvable schemes and keep normal inference; only the VarRef-with-no-entry
// shape borrows its direct args (the miss already reported once).
fn callee_missing_in_env(ref func, cname: String) = match func {
  N(fbody, _, _) => match fbody {
    NExpr(VarRef(_)) => match env_lookup(cname) {
      None => true,
      Some(_) => false,
    },
    _ => false,
  },
}

// The authored-own declarations of one signature, in the body's own
// consume frame. A `ref` or unmarked param declares nothing: only an
// authored `own` is a promise to finish.
fn declare_authored_owns(ref params, span: ValidSpan) = params |> each((p) => match param_authored(p) {
  Own => consume_declare(param_name(p), span),
  _ => (),
})

fn check_consume_at_use(name, kind, span: ValidSpan) = match kind {
  ParamScheme(authored) => consume(name, authored, span),
  _ => consume(name, Unmarked, span),
}

// RX.4 — extract callee name from func node for Why chain.
fn callee_name(func_node) with Pure = match func_node {
  N(body, _, _) => match body {
    NExpr(VarRef(name)) => name,
    NExpr(FieldExpr(_, field)) => field,
    NExpr(CallExpr(callee, _)) => // A config handler `~> h(args)` is a CallExpr; the handler's name IS
    // the callee. Recurse so handler_e_r resolves its HandlerKind and the
    // residual row applies — without this every config handler
    // (map_collector(f), fold_handler(f,init)) silently loses its arm effects.
    callee_name(callee),
    _ => "<expr>",
  },
}

// is_seq_op — the names of the sequence node-kind's projections. A sequence is
// ONE kernel node-kind (§4①); these are the cursor reading or building it.
// Routed to `infer_seq_op` so each types by the ELEMENT, never by its
// `load_i32`/`alloc` substrate body (whose inferred type erases `[a]` to `Int`
// — the value-ontology violation that poisoned the whole compiler's list
// handling). Strings are `[byte]`: `byte_at` IS `list_index`, `byte_len` IS
// `len`, `str_concat` IS `list_concat` — the same projections over a different
// element, so the string ops route here too (the §IX four-set unification).
// cname pins : String — the Intent Boundary that proves ALL sixteen `==`
// below STRUCTURAL (str_eq), not the pointer-eq i32.eq an unproven operand
// floors to. Unproven, whether `len` was recognized as a sequence op was a
// LAYOUT LOTTERY (interned "len" in the data section vs the heap cname from
// the token): m2's allocation happened to recognize it, m3's did not, so
// m3 routed `len(argv)` through the normal path, mistyped the compare, and
// `len(argv) < 2` emitted `list_compare` — m3 dispatched every stdin
// compile (incl. the wheel → m4) to CLI help. The mint_params handle-bind
// (this session) is what makes this pin propagate. The by-name fork itself
// is drift-8; its ultimate dissolution — the seq ops carry authored
// signatures (`len(xs: [a]) -> Int`) so inference reads the signature not
// the load_i32 word-idiom body, retiring is_seq_op — is the named peer
// Hβ.infer.seq-op-signature-driven (DEP Hβ.infer.authored-typaram-rigid).
//
// The SUBSTRATE primitives only — their bodies do pointer arithmetic
// (load_i32(list + 4)) that erases [a] to Int, so inference reads the element
// type here instead (the value-ontology boundary, §4①, named peer
// Hβ.value.repr-projection-primitives). The FUNCTORS are GONE from here: they
// DERIVE their own types from their bodies now that Iterate.result returns the
// handler-delivered value (result() -> r, prelude.mn) instead of a fabricated
// (). Zero re-derivation — the type is read from the one place it lives.
fn is_seq_op(cname: String) with Pure = cname == "len" || cname == "list_index" || cname == "last" || cname == "drop_last" || cname == "list_set" || cname == "list_concat" || cname == "list_to_flat" || cname == "make_list" || cname == "slice" || cname == "push" ||
// The String-builder half of the same boundary: int_to_str assembles a
// [len][bytes] record by address arithmetic (a word), and the table
// projects the String its consumers read — the §4① seam at the text face.
cname == "int_to_str" ||
// The Option-of-handle niche's READ (types.mn slot_present): typed
// `a -> Bool` here so a presence test never pins its operand's element
// type; the raw body compares the word.
cname == "slot_present" ||
// The show/hash surfaces: lower intercepts both names into structural
// LShow/LHash nodes (emit-dispatched), so the table carries their
// generic faces (a -> String, a -> Int) and the raw bodies never run.
cname == "to_string" || cname == "hash" ||
// The String face of the sequence node-kind (the comment above: byte_at IS
// list_index, byte_len IS len). Typed here so consumers holding a String
// type against the projection, never the load_i32 word-idiom body — the
// exact list_index pattern (self-consistent raw body, typed calls).
cname == "byte_len" || cname == "byte_at" ||
// The String BUILDERS: their bodies alloc a [count][tag][bytes] record and
// return its word (self-consistent Int inside, the int_to_str pattern);
// typed here so the projected RESULT is the String consumers read, never the
// raw buffer word. str_payload is the reader that resolves a String to its
// contiguous stride-1 payload pointer — String in, word out (the WASI
// materialization boundary; the seq-addr down-cast in table form).
cname == "str_slice" || cname == "str_concat" || cname == "str_of_single_byte" || cname == "str_payload" || cname == "str_of_buf" || cname == "float_to_str" || cname == "float_zero_pad" || cname == "float_format_fixed" || cname == "float_format_scientific" || cname == "float_render_positive" || cname == "float_digits_to_str"

// seq_force — bind the i-th argument's type to `ty` (a no-op past the end).
// `graph_bind` on a VarRef handle propagates to the bound variable (the same
// mechanism the `xs[i]` IndexExpr arm uses to force its receiver).
fn seq_force(ah, i, ty, span: ValidSpan) = if len(ah) > i {
  // Force = UNIFY, never overwrite. graph_bind would DISCARD the arg's proven
  // type (a Carried-Truth violation — `fold([], …)` loses that `[]` is a list,
  // so the accumulator var never learns `[a]`); unify unions the arg's root
  // with the expected type, reading BOTH truths and propagating structurally
  // into a lambda's params / an empty literal's element.
  //
  // §4① made total: a String IS its byte-list alias, so a TList-shaped
  // force unifies through the peel and `len(name)` on a String is
  // canonical with no receiver probe — the sentinel special-case this
  // replaces guarded a nullary Ty that no longer exists.
  let expected = mint(Inferred("sequence operand"))
  graph_bind(expected, ty, Located(span, Inferred("sequence operand")))
  unify(list_index(ah, i), expected, span, Inferred("sequence operand"))
} else {
  ()
}

// The sequence node-kind's projections — typed by the element, the cursor
// reading or building a sequence. A sequence is `[a]`; the i32 pointer is
// substrate BELOW the type. These REPLACE the load_i32 library typing: the
// body is what `lower` emits (the rope walk, the offset load), the TYPE is THIS
// projection. One fresh `a` per call binds the receiver(s) to `[a]`, indices to
// `Int`, values to `a`. `lower` still calls the lib fns; only their TYPE moves
// here, to the node-kind that owns it.
// The substrate FACE table — ONE home for every seq-op's typed signature
// (params, result) over a caller-minted element var. Both readers derive
// from it: the saturated fast path forces each argument position against
// its face type (infer_seq_op below), and a HOLED/under-applied call
// builds its product-with-holes from the same face (infer_call) — the env
// scheme is the RAW body's (list_set's `l + 8` types l Int) and must
// never type a caller (the lib-first order made that scheme visible and
// every `|> list_set(??, …)` pipe mismatched — 14 wheel sites). A
// position typed by a fresh var (seq_unconstrained) is deliberately
// unconstrained: the emit-dispatched generics (to_string/hash), the raw
// construction boundaries (str_of_buf — the buffer word IS a String,
// §4①), and the float formatters' digit-buffer heads.
fn seq_op_sig(cname: String, elem) = match cname {
  "last" => Some(([TList(elem)], elem)),
  "list_index" => Some(([TList(elem), TInt], elem)),
  "int_to_str" => Some(([TInt], ty_string)),
  "byte_len" => // The String face: byte_at IS list_index over [byte], byte_len IS len.
  Some(([ty_string], TInt)),
  "byte_at" => Some(([ty_string, TInt], TInt)),
  "str_slice" => Some(([ty_string, TInt, TInt], ty_string)),
  "str_concat" => Some(([ty_string, ty_string], ty_string)),
  "str_of_single_byte" => Some(([TInt], ty_string)),
  "str_payload" => // str_payload resolves a String to its contiguous stride-1 payload pointer.
  Some(([ty_string], TInt)),
  "str_of_buf" => Some(([seq_unconstrained()], ty_string)),
  "float_to_str" => Some(([TFloat], ty_string)),
  "float_render_positive" => Some(([TFloat], ty_string)),
  "float_zero_pad" => Some(([TInt], ty_string)),
  "float_format_fixed" => Some(([seq_unconstrained(), TInt], ty_string)),
  "float_format_scientific" => Some(([seq_unconstrained(), TInt], ty_string)),
  "float_digits_to_str" => Some(([seq_unconstrained(), TInt, TInt], ty_string)),
  "slot_present" => Some(([seq_unconstrained()], TName("Bool", []))),
  "to_string" => Some(([seq_unconstrained()], ty_string)),
  "hash" => Some(([seq_unconstrained()], TInt)),
  "len" => Some(([TList(elem)], TInt)),
  "drop_last" => Some(([TList(elem)], TList(elem))),
  "list_set" => Some(([TList(elem), TInt, elem], TList(elem))),
  "push" => Some(([TList(elem), elem], TList(elem))),
  "slice" => Some(([TList(elem), TInt, TInt], TList(elem))),
  "list_concat" => Some(([TList(elem), TList(elem)], TList(elem))),
  "list_to_flat" => // Flatten is representation-only: type-preserving [a] -> [a] (flat_raw is
  // its raw altitude; a raw-typed list_to_flat poisoned iterate's element).
  Some(([TList(elem)], TList(elem))),
  "make_list" => Some(([TInt], TList(elem))),
  _ => None,
}

fn seq_unconstrained() = TVar(mint(Inferred("unconstrained substrate operand")))

fn seq_force_list(ah, ptys, i, span: ValidSpan) = if i >= len(ptys) {
  ()
} else {
  seq_force(ah, i, list_index(ptys, i), span)
  seq_force_list(ah, ptys, i + 1, span)
}

fn infer_seq_op(cname, fh, args, handle, span: ValidSpan) = {
  let ah = collect_handles(args)
  let elem = TVar(mint(Inferred("sequence element")))
  match seq_op_sig(cname, elem) {
    Some(sig) => match sig {
      (ptys, ret) => {
        seq_force_list(ah, ptys, 0, span)
        graph_bind(handle, ret, Located(span, Inferred("substrate face of '{cname}'")))
      },
    },
    None => // A table member with no face row is unreachable by construction
    // (is_seq_op and seq_op_sig enumerate the same names); the floor keeps
    // productive-under-error alive if they ever diverge.
    graph_bind(handle, TList(elem), Located(span, Inferred("sequence"))),
  }
  // Hβ.infer.seq-op-row-from-callee RESOLVED (2026-07-24): the callee's OWN
  // declared row, read live — the same Carried-Truth read
  // infer_call_saturated makes. The seq-op family's honest rows
  // (push/slice/list_concat/make_list carry Memory + Alloc, lists.mn) now
  // attribute at every call site. The 2026-07-17 revert's OOM was one
  // representation era stale (measured then on the 559k-line wheel against
  // the 4GB ceiling; the current wheel compiles at ~694MB peak — the
  // re-measurement, not the arena, un-gated this). The Memory floor
  // survives only for an unresolved callee (productive-under-error, the
  // seq_op_sig None floor's twin).
  match graph_chase(fh) {
    GNode(NBound(TFun(_, _, crow)), _) => inf_add_row(crow),
    _ => inf_add_row(mk_ef_closed([ENamed(intern_str("Memory"))])),
  }
  // EVERY application result is a possible suspension boundary
  // (stage_continuation_boundary's own law) — the fast path is still an
  // application. Skipping the staging here left lower's k2 crossing
  // machinery with NoBoundary at exactly four wheel sites (a seq-op call on
  // the k2 spine: alt_same_name_set, rows_equal, splice_at, k2_is_park) —
  // the census's last E_UnresolvedType class.
  stage_continuation_boundary(cname, handle)
}

fn infer_call(func, args, handle, span: ValidSpan) = match func {
  N(_, _, fh) => {
    let cname = callee_name(func)
    // The substrate fast-path fires only for a SATURATED, hole-free call —
    // both facts read live (the hole from the arg's own body, the arity from
    // the callee's declared product). It previously fired on shape-of-name
    // alone, so `list_set(??, i, v)` was typed saturated: the `??` never
    // became the partial the pipe completes, and every seq-op pipe stage
    // mismatched (14 census sites). An under-applied or holed seq-op call is
    // the product-with-holes like any other call.
    if is_seq_op(cname) && call_hole_index(args, 0) < 0 && len(args) == len(callee_params(cname)) {
      infer_seq_op(cname, fh, args, handle, span)
    }
    // A HOLED/under-applied substrate call is the product-with-holes built
    // from the FACE (seq_op_sig — the same one home the saturated path
    // forces against), never from the env scheme: the scheme is the raw
    // body's own (list_set's `l + 8` types l Int), and typing a caller's
    // partial from it unified every `|> list_set(??, …)` pipe datum with
    // Int the moment the lib-first order made the scheme visible.
    else if is_seq_op(cname) {
      let elem = TVar(mint(Inferred("sequence element")))
      match seq_op_sig(cname, elem) {
        Some(sig) => match sig {
          (ptys, ret) => infer_call_partial(
            args,
            build_ctor_params(ptys, 0),
            ret,
            mk_ef_closed([ENamed(intern_str("Memory"))]),
            handle,
            span,
            cname
          ),
        },
        None => // A table member with no face row is unreachable by construction
        // (the two enumerate the same names); the floor keeps
        // productive-under-error alive if they ever diverge.
        graph_bind(handle, TList(elem), Located(span, Inferred("sequence"))),
      }
    } else {
      // The single-variant record ctor in the ONE application syntax —
      // `X({...})` (SYNTAX §Constructor calls: same syntax as function calls).
      // The env binds X to its RESULT (TName under RecordSchemeKind), so the
      // plain chase below met a non-arrow and every such call mismatched (29
      // census sites, the tail's biggest root). The ARROW is a VIEW built at
      // the read — the same view the pattern path already builds (infer_pat's
      // RecordSchemeKind arm): one view, two readers; the ordinary saturated
      // machinery does the rest.
      match record_ctor_arrow_view(cname, span) {
        Some(vh) => infer_call_saturated(args, vh, handle, span, cname),
        None => // HOLE-COMPLETION (SYNTAX §«Partial application — the product with a
        // hole»): a call whose args leave declaration-order params unfilled — a
        // positional-prefix k<n, or an authored `??` slot — IS the product with
        // holes: its type is the fn of the UNFILLED params. The callee's TParam
        // nodes are reused whole (the param product's identity carries); the row
        // rides the result fn — a partial performs nothing.
        match graph_chase(fh) {
          GNode(NBound(TFun(ps, pret, prow)), _) => if len(args) < len(ps) || call_hole_index(args, 0) >= 0 {
            infer_call_partial(args, ps, pret, prow, handle, span, cname)
          } else {
            infer_call_saturated(args, fh, handle, span, cname)
          },
          _ => infer_call_saturated(args, fh, handle, span, cname),
        },
      }
    }
  },
}

// The record ctor's arrow VIEW, minted at the read — Some(handle bound to
// TFun([TRecord(declared)], TName(X, ...), Pure)) when cname is a nominal
// record's constructor, None otherwise. The identical instantiation the
// pattern path's RecordSchemeKind arm performs; the env's scheme stays the
// RESULT (one home), the arrow exists only as this projection.
fn record_ctor_arrow_view(cname: String, span: ValidSpan) = match env_lookup(cname) {
  Some(entry) => match entry {
    (scheme, reason, kind) => match kind {
      RecordSchemeKind(declared_fields) => match judgment_pair(scheme) {
        (q, body) => {
          let view =
            instantiate(Frozen(q, TFun(build_ctor_params([TRecord(declared_fields)], 0), body, mk_ef_pure())))
          let vh = mint(Inferred("record-ctor arrow view of '{cname}'"))
          graph_bind(vh, view, Located(span, VarLookup(cname, reason)))
          Some(vh)
        },
      },
      _ => None,
    },
  },
  None => None,
}

fn infer_call_arg_list(args, params, i) = if i >= len(args) {
  ()
} else {
  let arg = list_index(args, i)
  if i < len(params) { infer_call_arg(arg, list_index(params, i)) } else { infer_expr(arg) }
  infer_call_arg_list(args, params, i + 1)
}

fn infer_call_arg(arg, param) = match arg {
  N(body, _, _) => match body {
    NExpr(VarRef(_)) => // param_borrows (types.mn, the classification's one home — the
    // ownership grade's mode walk reads the same test at decl time).
    if param_borrows(param) {
      borrow_enter()
      infer_expr(arg)
      borrow_exit()
    } else {
      infer_expr(arg)
    },
    _ => infer_expr(arg),
  },
}

// The `??` hole's declaration-order index among a call's raw args (-1: none).
fn call_hole_index(args, i) = if i >= len(args) {
  -1
} else {
  match list_index(args, i) {
    N(b, _, _) => match b {
      NHole(_) => i,
      _ => call_hole_index(args, i + 1),
    },
  }
}

// Each arg — the `??` holes included, so a hole learns its expected type
// (the gradient's food at the absence) — unifies with its declaration-
// position param; the call's type is the fn of the params left unfilled.
fn infer_call_partial(args, params, pret, prow, handle, span: ValidSpan, cname) = {
  unify_args_positionally(args, params, 0, span)
  let remaining = unfilled_params(args, params)
  graph_bind(
    handle,
    TFun(remaining, pret, prow),
    Located(
      span,
      InferredCallReturn(cname, Inferred("partial application — the product with a hole"))
    )
  )
}

fn unify_args_positionally(args, params, i, span: ValidSpan) = if i < len(args) && i < len(params) {
  match list_index(args, i) {
    N(b, _, ah) => {
      let pty_h = mint(Inferred("declared param at partial call"))
      graph_bind(
        pty_h,
        param_ty(list_index(params, i)),
        Located(span, Inferred("declaration-order param"))
      )
      unify(ah, pty_h, span, Inferred("argument fills its declaration-order param"))
      // A SUPPLIED slot is a refinement construction site like any call arg
      // (discharge_arg_refinements' partial sibling); a hole has no value
      // yet — its obligation lands when the suspension is filled.
      match b {
        NHole(_) => (),
        _ => apply_refinement_constraint(param_ty(list_index(params, i)), ah, span),
      }
      unify_args_positionally(args, params, i + 1, span)
    },
  }
}

// The unfilled params: the authored `??` slots among the given prefix, then
// every param past the given count — declaration order preserved.
fn unfilled_params(args, params) =
  hole_params(args, params, 0) ++ slice(params, len(args), len(params))

fn hole_params(args, params, i) = if i >= len(args) {
  []
} else {
  match list_index(args, i) {
    N(b, _, _) => match b {
      NHole(_) => [list_index(params, i)] ++ hole_params(args, params, i + 1),
      _ => hole_params(args, params, i + 1),
    },
  }
}

// ─── The directional fn-arg edge (Hβ.effects.directional-fn-row-edge) ──
//
// A position masks when BOTH sides are bound TFuns of equal arity: the
// non-row components meet symmetrically here (nested params, the
// return), the TOP rows meet by row_subsumes(arg, param) — the param's
// declared row is the CAP, and a quieter argument always fits under it.
// An arg not yet TFun-bound keeps the symmetric path whole (a lambda
// learns its shape FROM the param); an arity mismatch keeps it too (the
// wholesale unify owns that refusal). Returns the masked positions.
fn fn_arg_directional_positions(dps, arg_handles, span: ValidSpan, i) = if i >= len(dps) || i >= len(arg_handles) {
  []
} else {
  let rest = fn_arg_directional_positions(dps, arg_handles, span, i + 1)
  match fold_strip(chase_deep(param_ty(list_index(dps, i)))) {
    TFun(pps, pret, prow) => // The directional meet fires only when the param's declared row is a
    // CONCRETE cap (closed or the !-stance EtAll) — a VAR-tailed param
    // row is the effect-polymorphic FLOW channel (map's f: the arg's
    // row must UNIFY into the var so the caller carries it; masking it
    // severed the flow and the wheel's census convicted 297 sites in
    // one march), never a cap to subsume under.
    if row_cap_form(prow) {
      match graph_chase(list_index(arg_handles, i)) {
        GNode(NBound(aty), _) => match fold_strip(chase_deep(aty)) {
          TFun(aps, aret, arow) => if len(aps) == len(pps) {
            fn_arg_component_meet(aps, pps, aret, pret, span)
            if row_subsumes(arow, prow) {
              ()
            } else {
              report_effect_mismatch(
                arow,
                prow,
                span,
                Inferred("a fn argument's row exceeds its param's declared cap")
              )
            }
            [i] ++ rest
          } else {
            rest
          },
          _ => rest,
        },
        _ => rest,
      }
    } else {
      // B2 (rung 3, the arg edge goes TOTAL-directional): the pure-flow
      // shape — the param's row resolving to EfRow([], [], EtOpen(vs)),
      // every surviving edge free by the chase's own construction — masks
      // the position and binds ONE-WAY: the instantiated caller-private
      // param cells learn the arg's row (bind_edges_to), the arg's SHARED
      // cell is never written, so a named fn passed to map's f stops
      // teaching its own decl cell one edge per call site while the
      // 297-site flow survives as a read. A MIXED open shape (presents or
      // absents beside the var tail) keeps the symmetric path with the
      // named census marker — expected zero on the wheel; a nonzero grep
      // is the counter.
      match chase_row_deep(prow, 0) {
        EfRow(pres2, abs2, EtOpen(vs)) => if len(pres2) == 0 && len(abs2) == 0 {
          match graph_chase(list_index(arg_handles, i)) {
            GNode(NBound(aty), _) => match fold_strip(chase_deep(aty)) {
              TFun(aps, aret, arow) => if len(aps) == len(pps) {
                fn_arg_component_meet(aps, pps, aret, pret, span)
                bind_edges_to(vs, arow, span, Inferred("the arg edge teaches the param's flow row"))
                [i] ++ rest
              } else {
                rest
              },
              _ => rest,
            },
            _ => rest,
          }
        } else {
          eprint_string("B2-mixed-open arg-edge\n")
          rest
        },
        _ => rest,
      }
    },
    _ => rest,
  }
}

// A declared param row is a CAP exactly when its tail is concrete —
// EtClosed (`with Tick`) or EtAll (`with !WASI`); an open tail is the
// polymorphic flow channel. Bound edges resolve through the chase.
fn row_cap_form(row) with GraphRead + Memory + Alloc + WASI = match chase_row_deep(row, 0) {
  EfRow(_, _, EtClosed) => true,
  EfRow(_, _, EtAll) => true,
  _ => false,
}

fn fn_arg_component_meet(aps, pps, aret, pret, span: ValidSpan) = {
  each(
    ((ap, pp)) => unify_types(
      param_ty(ap),
      param_ty(pp),
      span,
      Inferred("a fn argument's param meets the declared param")
    ),
    zip(aps, pps)
  )
  unify_types(aret, pret, span, Inferred("a fn argument's return meets the declared return"))
}

// The wholesale-unify slots: a masked position takes a fresh
// unconstrained var (its meet already ran directionally above); every
// other position carries its argument's own handle as before.
fn build_inferred_params_masked(handles, masked) = masked_params_walk(handles, masked, 0)

fn masked_params_walk(ref handles, ref masked, i) = if i >= len(handles) {
  []
} else {
  let slot = if int_in(masked, i, 0) {
    mk_param("_", TVar(mint(Inferred("directionally-met fn-arg slot"))))
  } else {
    mk_param("_", TVar(list_index(handles, i)))
  }
  [slot] ++ masked_params_walk(handles, masked, i + 1)
}

fn int_in(ref xs, target, i) with Memory = if i >= len(xs) {
  false
} else {
  if list_index(xs, i) == target { true } else { int_in(xs, target, i + 1) }
}

// ─── The replay value barrier (Hβ.own.linear-tier-and-persist-value-barrier) ──
//
// The ROW half landed first: a fn-typed param whose declared row severs
// the whole external triple under the !-stance (!WASI + !Filesystem +
// !Network, EtAll tail — persist_branch's own contract) IS a replay
// boundary: the callee re-runs the thunk, and the row severs what a
// replay cannot un-send. This is the VALUE half: a frame-declared
// authored `own` FREE in that thunk crosses the wire as bytes while its
// duty-to-finish stays behind — each resumed run re-consumes it. Replay
// is the parallel fan on the TIME axis, so BParallel's collision law
// applies across runs exactly as across `><` arms: one ledger, both
// axes. Narration tier per the census arming law; the message teaches
// the two honest moves.
fn replay_barrier_gate(dps, args, span: ValidSpan, i) = if i >= len(dps) || i >= len(args) {
  ()
} else {
  match fold_strip(chase_deep(param_ty(list_index(dps, i)))) {
    TFun(_, _, prow) => if row_severs_replay(prow) {
      report_owns_across(consume_declared(), collect_free_vars(list_index(args, i), []), span)
    },
    _ => (),
  }
  replay_barrier_gate(dps, args, span, i + 1)
}

// A row severs replay when its !-stance forbids the whole external
// triple — the exact contract persist_branch's declared row states.
fn row_severs_replay(row) = match chase_row_deep(row, 0) {
  EfRow(_, absent, EtAll) => absent_forbids(absent, "WASI") && absent_forbids(absent, "Filesystem") && absent_forbids(absent, "Network"),
  _ => false,
}

fn absent_forbids(ref absent, target: String) = any((e) => eff_name_str(e) == target, absent)

fn report_owns_across(ref owns, ref frees, span: ValidSpan) = each(
  (name) => if string_in_list(frees, name) { report(TOwnAcrossReplay(across_replay_msg(name), span)) },
  owns
)

// The message's one mint, String-pinned (spec_mangle's law — the each
// lambda judges datum-last while the name is still free; the pin
// anchors at the named call, unconsumed_msg's twin).
fn across_replay_msg(name: String) with Memory + Alloc =
  "'{name}' is an open own captured across a replay boundary — a resumed run consumes it again; finish it before the persist, or move its whole lifetime inside the thunk"

fn infer_call_saturated(args, fh, handle, span: ValidSpan, cname) = {
  let arg_handles = collect_handles(args)
  // drift-audit: ignore — "return" is a Reason string, not an imperative keyword
  let ret_h = mint(InferredCallReturn(cname, Inferred("return")))
  // THE ONE-WAY CALL EDGE (D9 rung 1's B1+B3+charge arc). One pre-unify
  // chase serves all three reads. The directional fn-arg edge: a
  // fn-typed argument's TOP row meets its declared fn-typed param by
  // SUBSUMPTION (arg ⊆ the param's declared cap), never by the
  // wholesale unify's symmetric equality — a Pure fn is admitted
  // wherever a `with Tick` fn is expected (the equality refused it,
  // measured); masked positions get fresh slots so the symmetric meet
  // never re-runs. The TOP-LEVEL row is one-way the same wing: on the
  // bound path the expectation's row IS the callee's own crow, so
  // unify_row meets identical rows and no-ops — a use of a name never
  // teaches the name's row (D5 at the call edge; the hub's per-caller
  // teach-back deleted with zero new unify machinery). On the free path
  // the callee has no row to read — fh := expected wholesale, and the
  // fresh row cell BECOMES the callee's row cell (the forward/param
  // channel, unsevered).
  let chased_f = graph_chase(fh)
  let masked = match chased_f {
    GNode(NBound(TFun(dps0, _, _)), _) => {
      // AN ARITY CHECK CANNOT LIVE HERE, and the attempt is worth recording
      // because the site looks perfect: the callee is BOUND to a TFun and
      // the args are in hand, so both counts are right there. A probe over
      // the whole micro corpus printed 1052 hits across eight distinct
      // shapes and `len(args)` NEVER differed from `len(dps0)` — not even
      // for `add(1, 2, 3)`, which arrived as `cname=add args=2 dps0=2`.
      // The surplus is dropped upstream, in fill_arg_slots, whose slot
      // buffer is sized by the parameter product; by the time any judgment
      // runs the counts are equal by construction and the evidence is gone.
      // The refusal lives at that drop (src/types.mn place_positional).
      replay_barrier_gate(dps0, args, span, 0)
      fn_arg_directional_positions(dps0, arg_handles, span, 0)
    },
    _ => [],
  }
  let erow = match chased_f {
    GNode(NBound(TFun(_, _, crow0)), _) => crow0,
    _ => mk_ef_open([], graph_fresh_row(InferredCallReturn(cname, Inferred("effects")))),
  }
  let expected = TFun(build_inferred_params_masked(arg_handles, masked), TVar(ret_h), erow)
  let expected_h = mint(InferredCallReturn(cname, Inferred("expected function type")))
  graph_bind(expected_h, expected, Located(span, InferredCallReturn(cname, Inferred("expected"))))
  unify(fh, expected_h, span, InferredCallReturn(cname, Inferred("unification")))
  graph_bind(handle, TVar(ret_h), Located(span, InferredCallReturn(cname, Inferred("result"))))
  // THE CHARGE IS THE CALLEE'S ROW VERBATIM — its live tail edges
  // intact, never a resolve's fold (the B1 revert's payment: a resolve
  // at charge time folds a possibly-unjudged callee's row to a bare
  // VALUE the caller banks forever — Carried-Truth inverted, a snapshot
  // where an edge belonged; charging verbatim keeps every read fresh by
  // construction, folding at READ time where reads are pure). For a
  // prereg'd callee crow is the bare edge to its live accumulator cell;
  // for a published scheme it is the instantiated caller-private copy;
  // for a pre-free callee (an effect-polymorphic param, a local
  // closure, a loose forward) fh is bound to expected by the unify
  // above, so crow IS the fresh row cell — the polymorphic share
  // generalize quantifies and call sites instantiate. One arm serves
  // every case; the union beneath (tail_join's set union) is what lets
  // a second callee's edge survive the frame's accumulation. The
  // unify-failure path charges nothing (the mismatch already reported).
  match graph_chase(fh) {
    GNode(NBound(TFun(_, _, crow)), _) => inf_add_row_unified(crow),
    _ => (),
  }
  // The call boundary is a refinement CONSTRUCTION site: each declared
  // refined param discharges against ITS argument's live node (subst_self
  // — value-proof R2's third site, beside the let annotation and the fn
  // return). This is the one value-bearing home for the obligation;
  // unify_types' wrapper arm has no value node in scope and accrues
  // nothing (its old raw-pred verify pended one forever-undecidable entry
  // per refined-param unification — noise the debt surfacing exposed).
  // The partial path's supplied-arg discharge is the same law at
  // unify_args_positionally.
  match graph_chase(fh) {
    GNode(NBound(TFun(dps, _, _)), _) => discharge_arg_refinements(dps, arg_handles, 0, span),
    _ => (),
  }
  stage_continuation_boundary(cname, handle)
}

fn discharge_arg_refinements(dps, arg_handles, i, span: ValidSpan) = if i >= len(dps) || i >= len(arg_handles) {
  ()
} else {
  apply_refinement_constraint(param_ty(list_index(dps, i)), list_index(arg_handles, i), span)
  discharge_arg_refinements(dps, arg_handles, i + 1, span)
}

// EVERY application result is a possible suspension boundary — not only an
// effect op's perform. k1 reifies the remainder AT the perform; k2 composes a
// frame remainder onto the unwinding k at an ordinary CALL or PIPE STAGE the
// yield crosses (lower_body_reified's spine). Both read this one edge. Mint
// the record identity while the enclosing InferCtx frame is live (the world is
// the frame's LIVE row variable; the answer is the frame's answer handle);
// bind its TCont only after all handler arms have joined their usage grades
// onto the op scheme (finalize).
fn stage_continuation_boundary(cname: String, resume_input_h) = {
  let continuation_h = mint(InferredCallReturn(cname, Inferred("continuation boundary")))
  let current_answer_h = inf_current_answer()
  let answer_h = if current_answer_h < 0 { resume_input_h } else { current_answer_h }
  graph_boundary_set(
    resume_input_h,
    PendingContinuationBoundary(resume_input_h, answer_h, continuation_h, inf_current_world())
  )
}

// The heal fixpoint (see the judgment passes' call sites): heal the recorded
// sites until a sweep binds nothing — a LOCAL boundary fixpoint (graph
// teaching via graph_bind; downstream reads see the healed cells), NOT the
// judgment's pass cadence. The trail position is the progress meter (a
// sweep that asserts no new constraint leaves it unmoved).
fn finalize_continuation_boundaries(i, n) = if i >= n {
  ()
} else {
  match graph_boundary_at(i) {
    PendingContinuationBoundary(resume_input_h, answer_h, continuation_h, world) => {
      let disc = continuation_discipline_at(i)
      graph_bind(
        continuation_h,
        TCont(TVar(resume_input_h), TVar(answer_h), disc, world),
        Inferred("inference-owned continuation boundary")
      )
      graph_boundary_set(
        i,
        ContinuationBoundary(ContinuationEdge(resume_input_h, answer_h, continuation_h, disc, world))
      )
    },
    _ => (),
  }
  finalize_continuation_boundaries(i + 1, n)
}

// The discipline at a boundary is read LIVE at finalize, after every handler
// arm has joined its usage grade onto the op scheme. An effect op's perform
// carries the op's own joined discipline (k1 — the yield site). Every OTHER
// application boundary (an ordinary call, a pipe stage, a fanout apply) is a
// k2 CROSSING site: a frame-k there only materializes as a SEGMENT of a
// yield already unwinding, and a composed k is called as many times as the k
// it extends — MultiShot by construction, never the callee's own cardinality.
fn continuation_discipline_at(site_h) = match graph_node_body(site_h) {
  NExpr(CallExpr(func, _)) => {
    let name = callee_name(func)
    match env_lookup(name) {
      Some(entry) => match entry {
        (_, _, kind) => match kind {
          EffectOpScheme(_, _, _, disc) => disc,
          _ => MultiShot,
        },
      },
      None => MultiShot,
    }
  },
  _ => MultiShot,
}

// `~>` handler attachment — the row algebra's handler operator. A handler is
// (a ! E+r) ⟿ (a ! R+r): row(expr ~> h) = (row(expr) − E) ⊕ R. The body is
// inferred in a NESTED row scope so its effects do NOT leak (subtraction would
// be impossible once leaked — the install discipline); the handler value is
// installed (binding its config args, so a config-param handler's R picks up
// the actual arg's effect); then (body_row − E) ⊕ R joins the caller's row.
// Reading the RHS handler's HandlerKind(E, R) is what completes the row algebra
// — without it map/each lose every effect performed in their arms.
fn infer_pipe_tee(left, right, handle, span: ValidSpan) = {
  let body_row_h = graph_fresh_row(Inferred("~> body row"))
  match left {
    N(_, _, body_answer_h) => {
      // drift-audit: ignore — two independent frame inputs (row handle, answer handle) — one frame record's fields, not parallel arrays
      // The tee body is ONE install's scope — its effect-instance fragments
      // join at the accumulation seam (inf_add_row_unified's gate).
      inf_enter_fn(body_row_h, body_answer_h, span, [])
      inf_mark_install_frame()
      infer_expr(left)
      inf_exit_fn([])
      infer_expr(right)
      let body_row = read_bound_row(body_row_h)
      match handler_e_r(right) {
        Some(er) => match er {
          (handled, resid_h, hconfig) => {
            // THE INSTALL CONNECTION: flow the op payload performer→handler.
            // The body performs E(a); the handler is Handler(E(P)); unify a = P,
            // so the handler's arm param (elem : P) becomes the performed value
            // type. This is what makes `field` in `map((field)=>field.name, xs)`
            // resolve to xs's element. The dispatch gradient applied to data.
            unify_install_payload(body_row, handled, right, span)
            // The subtraction takes the FULL handled set — every distinct effect
            // the arms touch — read from the same HandlerKind the identity came
            // from. A single-name subtraction left a multi-effect handler's
            // sibling effect on the caller's row.
            let handled_names = match handler_arms_of(right) {
              Some(arms) => derive_handler_enames(arms, 0, []),
              None => [ENamed(intern_str(handled))],
            }
            inf_add_row(absorb_row(
              body_row,
              mk_ef_closed(handled_names),
              residual_with_config_args(resid_h, hconfig, right)
            ))
          },
        },
        None => // Handler value not resolvable to a HandlerKind decl (e.g. a let-bound
        // handler) — productive-under-error: pass the body's row through. The
        // graph proves the handler identity at a decl; a value forwards.
        inf_add_row(body_row),
      }
      match left {
        N(_, _, lh) => graph_bind(
          handle,
          TVar(lh),
          Located(span, InferredPipeResult("~>", Inferred("handler attachment")))
        ),
      }
    },
  }
}

// The RHS handler's (handled_effect, residual_row) from its HandlerKind env
// entry — read live from the graph, never re-derived. None when the RHS isn't
// a named handler decl.
// The RHS handler's arms, when it is a named handler decl.
fn handler_arms_of(right) = match callee_name(right) {
  "" => None,
  name => match env_lookup(name) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        HandlerKind(_, _, _, arms) => Some(arms),
        _ => None,
      },
    },
    None => None,
  },
}

fn handler_e_r(right) = match callee_name(right) {
  "" => None,
  name => match env_lookup(name) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        HandlerKind(r, config, _, arms) => // The handled effect is a live projection of the arms (§2 follow-the-
        // edge), never a stored field — arms→op→EffectOpScheme carries it.
        // The config TParams ride along for the residual's install read.
        Some((derive_handler_ename(arms, name), r, config)),
        _ => None,
      },
    },
    None => None,
  },
}

// The residual READ at the install — the instantiation the raw handle
// bypasses, done live at the one seam it matters
// (Hβ.infer.handler-residual-outside-the-scheme): an arm's call into a
// config fn charged the DECL param's row cell (a one-way edge), while
// the install's CallExpr unified the actual arg into the SCHEME's
// freshened copy — so the decl cell stays free forever and the residual
// folds nothing for it. The graph holds both ends: the residual's edge
// set names WHICH config params the arms call (their row roots), and
// the install's own arg nodes carry the actual rows. Join each CALLED
// config arg's row into the residual — carry the handles, read live; an
// uncalled config fn's arg contributes nothing (its root is not in the
// edge set), so the charge stays exact. A labeled or arity-short
// install falls back to the raw residual (positions are the pairing;
// resolve_call_args' full label resolution is the refinement).
fn residual_with_config_args(resid_h, config, right) = match right {
  N(rbody, _, _) => match rbody {
    NExpr(CallExpr(_, args)) => {
      // The residual rides the CELL AS AN EDGE — the shape a scheme's row
      // rides (mk_ef_open on the handle), never read_bound_row: a residual
      // that is exactly one config-var edge finalizes as an ALIAS of that
      // free cell (the flat store's canonical form), and a bound-row read
      // of a free root answers pure — the measured root-FREE loss.
      // resolve_row folds bound content and keeps free tails, so both
      // shapes read true.
      let resid = resolve_row(mk_ef_open([], resid_h))
      if len(args) != len(config) || any_arg_labeled(args) {
        resid
      } else {
        fold(
          resid,
          (acc, pair) => match pair {
            (i, p) => if any((r) => residual_has_root(acc, r), config_row_roots(p)) {
              match arg_fn_row(args, i) {
                Some(arow) => union_row(acc, arow),
                None => acc,
              }
            } else {
              acc
            },
          },
          enumerate(config)
        )
      }
    },
    _ => resolve_row(mk_ef_open([], resid_h)),
  },
}

fn any_arg_labeled(ref args) = any(
  (a) => match a {
    N(abody, _, _) => match abody {
      NExpr(LabeledArg(_, _)) => true,
      _ => false,
    },
  },
  args
)

// The config param's row-sort roots, read through its live cell — after
// arm inference the cell is bound to the config fn's type, and its row's
// free roots are exactly what the arms' call edges chase to. The SAME
// collection the keep-set uses (signature_free_roots — one walk, the
// trio discipline), filtered to the row sort the membership compares.
fn config_row_roots(p) = match param_ty(p) {
  TVar(h) => filter((r) => is_row_handle(r), signature_free_roots([h])),
  _ => [],
}

fn tparam_cells(tparams) = flatten(map(
  (p) => match param_ty(p) {
    TVar(h) => [h],
    _ => [],
  },
  tparams
))

fn residual_has_root(resid, root) = match resid {
  EfRow(_, _, EtOpen(vs)) => any((v) => graph_chase_handle(v) == root, vs),
  _ => false,
}

fn arg_fn_row(ref args, i) = match list_index(args, i) {
  N(_, _, ah) => match chase_deep(lookup_ty(ah)) {
    TFun(_, _, arow) => Some(arow),
    _ => None,
  },
}

// Flow the effect INSTANCE performer→handler at the install: the body performs
// `E(a1..an)` (in its row), the handler value is `Handler(E(P1..Pn))`; unify the
// WHOLE instance POSITION-WISE (a1=P1 .. an=Pn) by carrying it as the nominal
// type `TName(E, [a..])` and letting unify_types walk the args. The old flow
// unified EVERY payload to ONE var (unify_payload_in_names) — fine when an effect
// had a single payload, but result()->r gives Iterate two (element, r), and
// collapsing them cross-wires the element to the result var: `a ~ r ~ [b] ~
// [f(a)] ~ …`, the infinite type the occurs-check then rejects. One instance,
// one unify; the positions never cross (register_effect_ops names this: "the
// install unifies the whole instance per-position").
fn unify_install_payload(body_row, handled, right, span: ValidSpan) = match right {
  N(_, _, rh) => match handler_payload_ty(lookup_ty(rh)) {
    None => (),
    Some(pty) => // Unify the handler's ONE instance with EVERY same-named instance the body
    // performed — not just the last. A multi-payload effect fragments across its
    // perform sites (yield's Iterate(el,r), result's Iterate(el',r')); the
    // handler is where the single instance is established (§4③), so every
    // fragment collapses to it HERE. Reading `last(insts)` left the others
    // floating — result()->r's accumulator never threaded, so the `++` operand
    // floored to emit_concat_unresolved (the m3 concat census). This is the
    // Carried-Truth read at the install: the row already knows Iterate's
    // instances; the install unifies them all to the handler, never a side-car
    // reconcile pass re-deriving the fact after the fact.
    unify_instances_to(pty, instances_in_row(body_row, handled), 0, span),
  },
}

// Unify a target instance `pty` with each of `insts`, collapsing every fragment
// of one effect to a single identity. The arg positions are unified by joining
// their HANDLES directly (ty_arg_handle) — a `TVar`'s handle IS its graph node,
// so union-find needs no wrapper. Minting a wrapper node per pair was the
// allocation that wrapped the never-freeing bump image (the old reconcile's
// wild-write); this join is allocation-free on the common var-arg case, so it is
// safe even on the hot per-add seam. Top-level recursion (never `each`): unify
// performs Graph and an effectful lambda under a functor hits the arm-internal-
// perform gap.
fn unify_instances_to(pty, insts, i, span: ValidSpan) = if i >= len(insts) {
  ()
} else {
  unify_instance_args(tname_args(pty), tname_args(list_index(insts, i)), 0, span)
  unify_instances_to(pty, insts, i + 1, span)
}

// Unify two instances' arg Tys position-wise by their handles (union-find join).
fn unify_instance_args(args_a, args_b, i, span: ValidSpan) = if i >= len(args_a) || i >= len(args_b) {
  ()
} else {
  unify(
    ty_arg_handle(list_index(args_a, i)),
    ty_arg_handle(list_index(args_b, i)),
    span,
    Inferred("effect instance position")
  )
  unify_instance_args(args_a, args_b, i + 1, span)
}

// A Ty's graph handle: a TVar IS its handle (join directly, no allocation); a
// concrete arg is minted+bound once (rare — instance args are fresh vars).
fn ty_arg_handle(ty) = match ty {
  TVar(h) => h,
  _ => {
    let h = mint(Inferred("instance arg"))
    graph_bind(h, ty, Inferred("instance arg"))
    h
  },
}

fn tname_args(ty) = match ty {
  TName(_, args) => args,
  _ => [],
}

// The handler's instance type from a `Handler(P)` value type. P is the WHOLE
// effect instance (bound by unify_op_payload to `TName(E, [args])`), so
// unify_types walks it per-position against the body's performed instance.
fn handler_payload_ty(ty) = match ty {
  TName(n, args) => if n == "Handler" {
    match args {
      [inner] => Some(inner),
      _ => None,
    }
  } else {
    None
  },
  _ => None,
}

// The type args of a parameterized effect's payload (EAType only; a scalar
// effect arg like Sample(44100) carries no type).
fn eparam_arg_tys(args) = flatten(map(
  (arg) => match arg {
    EAType(t) => [t],
    _ => [],
  },
  args
))

// EVERY performed instance of effect `ename` in a row, each as the nominal type
// `TName(E, [a1..an])` (so unify walks it position-wise). A multi-payload effect
// yields one entry per perform site; the install (unify_instances_to) collapses
// them to the handler's one instance. list_to_flat so the caller's list_index is
// O(1). Bare ENamed / EPure carry no instance and contribute nothing.
fn instances_in_row(row, ename) = match row {
  EfRow(names, _, _) => instances_in_names(names, ename),
  _ => [],
}

fn instances_in_names(names, ename: String) = {
  let enh = intern_str(ename)
  list_to_flat(flatten(map(
    (n) => match n {
      EParameterized(nm, args) => if nm == enh { [TName(ename, eparam_arg_tys(args))] } else { [] },
      ENamed(_) => [],
      EPure => // EffName is ENamed | EParameterized | EPure — TOTAL. EPure carries no
      // instance (nothing-drops law, peer subst_eff_names).
      [],
    },
    names
  )))
}

// The five verbs, each inferred by its topology.
// `PFanout` (`<|`/`><`) and `PTee` are handled BEFORE `infer_pipe` fires
// (see `PipeExpr` arm in `infer_expr`); their arms here are unreachable stubs.
fn infer_pipe(kind, left, right, handle, span: ValidSpan) = match left {
  N(_, _, lh) => match right {
    N(_, _, rh) => match kind {
      PForward => // |> converge — right applied to left. Transparent wire;
      // unification pairs slots structurally (Parameters ARE tuples).
      // THE ONE-WAY PIPE EDGE (the call edge's twin — D9 rung 1's
      // B1+B3+charge arc): on the bound path the expectation's row IS
      // the stage's own row, so unify_row meets identical rows and
      // no-ops — a pipe never teaches its stage's cell (D5) — and the
      // charge is the stage's row VERBATIM, live edges intact, folding
      // at read time. A pre-free stage (a lambda, a local, a loose
      // forward) binds to the expectation wholesale, so the fresh row
      // cell becomes its own row cell and the same charge arm carries
      // the polymorphic share; the old FnScheme share-guard dissolves —
      // one-way discipline makes the shared cell read-only to callers,
      // and a loose forward's edge now resolves late instead of
      // charging nothing. The unify-failure path charges nothing.
      {
        // drift-audit: ignore — "return" is a Reason string; "|>" is a string literal key, not a pipe verb
        let ret_h = mint(InferredPipeResult("|>", Inferred("return")))
        let erow = match graph_chase(rh) {
          GNode(NBound(TFun(_, _, srow0)), _) => srow0,
          _ => mk_ef_open([], graph_fresh_row(InferredPipeResult("|>", Inferred("effects")))),
        }
        let expected = TFun([mk_param("_", TVar(lh))], TVar(ret_h), erow)
        let expected_h = mint(InferredPipeResult("|>", Inferred("expected fn")))
        graph_bind(expected_h, expected, Located(span, InferredPipeResult("|>", Inferred("expected"))))
        unify(rh, expected_h, span, InferredPipeResult("|>", Inferred("target")))
        graph_bind(handle, TVar(ret_h), Located(span, InferredPipeResult("|>", Inferred("result"))))
        // A pipe stage is an application; its result node is a suspension
        // boundary exactly as a CallExpr's is (lower's k2 spine keys the
        // bare-VarRef stage's completion call by THIS pipe node's handle).
        stage_continuation_boundary("|>", handle)
        match graph_chase(rh) {
          GNode(NBound(TFun(_, _, crow)), _) => inf_add_row_unified(crow),
          _ => (),
        }
      },
      PFanout(_) => // PFanout (<| and ><) is handled BEFORE infer_pipe fires (see the
      // PipeExpr arm in infer_expr → infer_fanout). Its branches run under
      // a branching-ledger scope so parallel consumes collide correctly.
      //
      // unreachable; handled in infer_fanout
      (),
      PTee => // ~> tee — handler attachment. Result type = body type. Row:
      // row(expr ~> h) = (row(expr) - handled(h)) + row(h). Today we
      // don't have handler-value typing so arm_row can't be extracted
      // from RHS; the result-type binding is the same for both block
      // and inline forms (the parser has already built the correct
      // tree shape — block wraps whole chain, inline wraps one stage).
      graph_bind(
        handle,
        TVar(lh),
        Located(span, InferredPipeResult("~>", Inferred("handler attachment")))
      ),
      PFeedback => // <~ feedback — SYNTAX §«<~» requires an iterative context: an
      // Iterate-class effect in the enclosing stack AT THE SITE. The check
      // that stood here read iter_context() — the COMPILER'S OWN runtime
      // handler stack — while inferring the COMPILED PROGRAM's structure: a
      // category error that reported E_FeedbackNoContext on every real `<~`
      // in the wheel (11 sites, including SYNTAX's own canonical lowpass)
      // because the pipeline chains install no_iter_context. The honest
      // compile-time question — does the site's AMBIENT ROW carry an
      // Iterate-CLASS effect? — needs class membership as a DECLARED fact
      // (not a name-allowlist): the named peer
      // Hβ.effects.iterate-class-declaration. Until it lands, the verb
      // types by unification and a genuinely driverless `<~` surfaces at
      // runtime (ev-miss, loud); the E_FeedbackNoContext DiagKind stays
      // for the check's return.
      {
        // SYNTAX §«<~» — the recurrence form: `((prev) => body) <~ delay(1)`
        // binds PREV to the PRIOR ITERATION'S OUTPUT, so the lambda's param
        // unifies with its own result (y[n-1] has y's type — the prior
        // carries the forward path's refinement row for free) and the verb's
        // value IS that result. A bare LHS is the feed-forward form: the verb
        // carries its value through. The RHS names WHAT flows back — a
        // FeedbackSpec value — and is checked as one; it is never unified
        // with the FLOW (the arrow~spec unify that stood here mismatched all
        // 15 recurrence sites, SYNTAX's own canonical lowpass included).
        match graph_chase(lh) {
          GNode(NBound(TFun(params, ret_ty, lam_row)), _) => // THE BODY'S ROW IS THE SITE'S ROW. This destructure sent the
          // recurrence lambda's row to `_row` and dropped it, so a forbidden
          // effect performed inside the cycle never reached the enclosing
          // fn: `fn cycle() with !E` around `((prev) => prev + bump()) <~
          // Delay(1)` CHECKED CLEAN. The verb is pure topology, but what the
          // body performs is still performed — the edge JOINS, it does not
          // substitute (Hβ.effects.feedback-row-substitutes; repros at
          // tests/frontier/mn-feedback-negation.mn and -transport.mn).
          {
            inf_add_row(lam_row)
            if len(params) == 1 {
              unify_types(
                param_ty(list_index(params, 0)),
                ret_ty,
                span,
                InferredPipeResult("<~", Inferred("the prior is the prior output"))
              )
              graph_bind(handle, ret_ty, Located(span, InferredPipeResult("<~", Inferred("recurrence result"))))
            } else {
              graph_bind(handle, TVar(lh), Located(span, InferredPipeResult("<~", Inferred("feedback"))))
            }
          },
          _ => graph_bind(handle, TVar(lh), Located(span, InferredPipeResult("<~", Inferred("feedback")))),
        }
        unify_types(
          TVar(rh),
          TName("FeedbackSpec", [TVar(mint(Inferred("feedback state element")))]),
          span,
          InferredPipeResult("<~", Inferred("the RHS is a state element"))
        )
        // What the site's declared depth has to answer for, both arms of
        // the one read that also SIZES the line at lower.
        //
        // THE CAUSALITY RULE — Faust's, at Mentl's typed altitude: a cycle
        // whose declared delay is ZERO has no computable value, the prior
        // being the very output being computed. (Negative reads the same
        // way, and cannot size a line either.)
        //
        // THE SAYABILITY RULE: a line is a fixed set of declared slots, so
        // a depth known only at runtime is a depth the medium cannot hold
        // — and handing that site one slot is the silent wrong this whole
        // read exists to end.
        //
        // Both productive (report, keep typing) and both ARMED, so neither
        // reaches an executable.
        match feedback_depth(right) {
          DepthLiteral(n) => if n <= 0 { report(EZeroDelayFeedback(span)) } else { () },
          DepthComputed => report(EComputedDelayDepth(span)),
          DepthUnstated => (),
        }
      },
    },
  },
}

// What depth does this `<~` RHS DECLARE? One read, and every judgment
// about a feedback site's delay line is an arm of it: the causality
// refusal above, and lower's slot count for the line itself.
//
// The depth is decidable exactly when it is written as a literal —
// `delay(3)` through the prelude fn or `Delay(3)` through the
// constructor, the two spellings of one FeedbackSpec variant. The callee
// name IS the authored intent, and reading it is reading the graph
// (predicate_flow_label's PBoolNode arm, the same read at the same
// altitude).
type FeedbackDepth
  // an authored literal — the line is exactly this many priors deep
  = DepthLiteral(Int)
  // `delay(n - 1)` — the depth is a runtime value, so no static line
  // can hold it; refused at the arm rather than silently given one slot
  | DepthComputed
  // a state element that names no depth (accumulate / filter_spec): its
  // prior is the previous tick's value, one slot, nothing to read
  | DepthUnstated

fn feedback_depth(spec) = match spec {
  N(body, _, _) => match body {
    NExpr(CallExpr(callee, args)) => match callee {
      N(cbody, _, _) => match cbody {
        NExpr(VarRef(fname)) => if is_delay_spec_name(fname) { delay_arg_depth(args) } else { DepthUnstated },
        _ => DepthUnstated,
      },
    },
    _ => DepthUnstated,
  },
}

// The two spellings of the FeedbackSpec depth variant — prelude's `delay`
// wrapper and the `Delay` constructor it builds.
fn is_delay_spec_name(fname: String) = fname == "delay" || fname == "Delay"

fn delay_arg_depth(args) = if len(args) == 0 {
  DepthUnstated
} else {
  match list_index(args, 0) {
    N(body, _, _) => match body {
      NExpr(LitInt(n)) => DepthLiteral(n),
      _ => DepthComputed,
    },
  }
}

// Fanout-verb inference (W2 · W3) — ONE path for `<|` and `>< `, the
// two surfaces of the one parallel-fanout topology discriminated by
// input ownership (the `FanOwnership` aspect the glyph authors). Both
// run their sub-branches inside an `affine_ledger` branching frame
// (`branch_enter` / `branch_divider` / `branch_exit`); the handler
// pairwise-checks cross-branch consumes at `branch_exit`, reporting
// `E_OwnershipViolation` for any name consumed in two or more parallel
// branches.
//
// A VERB DRAWS AN EDGE; IT DOES NOT SCHEDULE. The fanout contributes
// ZERO effects of its own — `effects_of(fanout) = ⋃ branch rows` — so
// there is NO injected `Thread` row (the deleted category error: a verb
// writing an EXECUTION fact into the topology layer). WHO runs the
// branches is a `~>` handler choice (Seq/Thread/Simd/Gpu), read LIVE at
// lower from the installed chain — never re-derived here. Closes peer
// Hβ.infer.pcompose-independence-not-thread (named at the old
// infer.mn:1131 Thread inject).
//
// The two AST shapes are reconciled by the ownership aspect:
//   `FanDistribute` (`><`) — the N-ary FanoutExpr carrier (the N-ary
//       law, Hβ.parser.pcompose-nary): branches are PEERS in a list,
//       each its own value boundary. Result `TTuple` of N branch types.
//       The PipeExpr(PFanout(FanDistribute)) arm delegates — the kind
//       survives as the census/glyph key, not a constructed shape.
//   `FanShare` (`<|`) — INPUT-vs-N-tuple: one input ref-borrowed into a
//       `MakeTupleExpr` of N branches (degenerate single-branch + empty
//       `<| ()` forms). Result `TTuple` of branch return types, or the
//       single branch's type.
// Net-new follow-up (positive-form, NOT folded into this collapse):
// Hβ.infer.fanout-ownership-from-use-count — derive the share-vs-own
// reading from branch-input use-count (the 0/1/2+ inference that drives
// own/ref, §4⑤) and project the glyph at fmt, so an `own` value through
// `<|` surfaces E_OwnershipViolation and a shared input under `><`
// fmt-canonicalizes to `<|`. Today the aspect is authored by the glyph;
// ownership CHECKS coherence in that follow-up.
fn infer_fanout(fan_own, left, right, handle, span: ValidSpan) = match fan_own {
  FanDistribute => infer_fanout_nary([left, right], handle, span),
  FanShare => infer_fanout_share(left, right, handle, span),
}

fn infer_fanout_nary(branches, handle, span: ValidSpan) = {
  branch_enter(BParallel)
  let edges = infer_fanout_nary_branches(branches, span, 0, len(branches))
  branch_exit(span)
  graph_boundary_set(handle, FanoutBoundary(edges))
  graph_bind(
    handle,
    TTuple(map(boundary_result_ty, edges)),
    Located(span, Inferred(">< parallel fanout — branches affinity-checked"))
  )
}

// Each branch its own value boundary, a divider between consecutive
// pairs (infer_fanout_share_branches' exact shape, one label per
// position so the boundary Reasons stay distinguishable).
fn infer_fanout_nary_branches(branches, span: ValidSpan, i, n) = if i >= n {
  []
} else {
  let edge = infer_fanout_value_boundary(list_index(branches, i), span, int_to_str(i))
  if i + 1 < n { branch_divider(span) }
  let rest = infer_fanout_nary_branches(branches, span, i + 1, n)
  [edge] ++ rest
}

// A `><` branch is evaluated behind a compiler-created zero-argument boundary.
// Give every layer of that boundary its own graph identity: `result_h` is the
// branch evaluation, `carrier_h` is the one-field product transported through a
// word-uniform scheduler, and `thunk_h` is the executable
// `() -> carrier_h`. The nested InferCtx frame owns the thunk's exact row; once
// closed, that row flows into the enclosing fanout just as a lambda row does.
fn infer_fanout_value_boundary(branch, span: ValidSpan, label: String) = match branch {
  N(_, _, branch_h) => {
    let result_h = mint(InferredPipeResult("><", Inferred("{label} branch result")))
    let carrier_h = mint(InferredPipeResult("><", Inferred("{label} branch carrier")))
    let thunk_h = mint(InferredPipeResult("><", Inferred("{label} executable boundary")))
    let thread_ticket_h = mint(InferredPipeResult("><", Inferred("{label} thread schedule ticket")))
    let persist_ticket_h = mint(InferredPipeResult("><", Inferred("{label} persist schedule ticket")))
    let thunk_row_h = graph_fresh_row(InferredPipeResult("><", Inferred("{label} boundary effects")))
    // drift-audit: ignore — two independent frame inputs (row handle, answer handle) — one frame record's fields, not parallel arrays
    inf_enter_fn(thunk_row_h, carrier_h, span, [])
    infer_expr(branch)
    graph_bind(
      result_h,
      TVar(branch_h),
      Located(span, InferredPipeResult("><", Inferred("{label} branch evaluation")))
    )
    // The branch evaluation is an application inside the thunk frame; its
    // suspension boundary carries THIS frame's world (staged before exit).
    stage_continuation_boundary("><", result_h)
    inf_exit_fn([])
    let thunk_row = mk_ef_open([], thunk_row_h)
    graph_bind(
      carrier_h,
      TTuple([TVar(result_h)]),
      Located(span, InferredPipeResult("><", Inferred("{label} boundary carrier")))
    )
    graph_bind(
      thunk_h,
      TFun([], TVar(carrier_h), thunk_row),
      Located(span, InferredPipeResult("><", Inferred("{label} zero-argument boundary")))
    )
    graph_bind(
      thread_ticket_h,
      TName("ThreadHandle", []),
      Located(span, InferredPipeResult("><", Inferred("{label} thread schedule ticket")))
    )
    graph_bind(
      persist_ticket_h,
      TName("PersistHandle", []),
      Located(span, InferredPipeResult("><", Inferred("{label} persist schedule ticket")))
    )
    inf_add_row(thunk_row)
    BoundaryEdge(result_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h)
  },
}

fn boundary_result_ty(edge) = match edge {
  BoundaryEdge(result_h, _, _, _, _) => TVar(result_h),
}

// The `FanShare` (`<|`) shape of fanout inference — one input
// ref-borrowed into N branches. Input is inferred once; each branch
// receives a BORROW of the input's value. Branches run under the
// branching ledger so any two branches that consume the same
// outer-scope own collide.
fn infer_fanout_share(left, right, handle, span: ValidSpan) = {
  infer_expr(left)
  match left {
    N(_, _, input_h) => match right {
      N(rbody, _, _) => {
        // Lower normalizes a non-tuple RHS to one branch, so infer must draw the
        // same application edge and the same one-element output product. Empty,
        // singleton, and N-way forms now share one topology.
        let branches = match rbody {
          NExpr(MakeTupleExpr(elems)) => elems,
          _ => [right],
        }
        let n = len(branches)
        let edges = if n == 0 {
          []
        } else {
          branch_enter(BParallel)
          let inferred_edges = infer_fanout_share_branches(branches, input_h, span, 0, n)
          branch_exit(span)
          inferred_edges
        }
        match right {
          N(_, _, rh) => {
            // Preserve the RHS as the tuple of STAGES it denotes. In the singleton
            // form `rh` is the branch handle itself and infer_fanout_apply_one already
            // proved it TFun, so rebinding it to the output tuple would erase the
            // branch's row. The fanout node alone owns the tuple of application results.
            match rbody {
              NExpr(MakeTupleExpr(_)) => graph_bind(
                rh,
                TTuple(collect_tvar_types(branches)),
                Located(span, Inferred("<| fanout — tuple of branch stages"))
              ),
              _ => (),
            }
            graph_boundary_set(handle, FanoutBoundary(edges))
            graph_bind(
              handle,
              TTuple(map(boundary_result_ty, edges)),
              Located(span, Inferred("<| fanout — result type is branch-output tuple"))
            )
          },
        }
      },
    },
  }
}

// Each `<|` branch is APPLIED to the borrowed input — lower emits
// `LCall(branch, input)`, so infer must model the SAME application or the two
// disagree: a stateful branch's effect row (`verify_pending_at → Verify`) never
// reaches the enclosing scope, so its evidence goes uncaptured (the felt-read
// ev-seam), and the result is mistyped as the branch FUNCTION rather than its
// OUTPUT. This mirrors `infer_call_saturated`, with one borrowed input arg.
fn infer_fanout_share_branches(branches, input_h, span: ValidSpan, i, n) = if i >= n {
  []
} else {
  let edge = infer_fanout_apply_one(list_index(branches, i), input_h, span)
  if i + 1 < n { branch_divider(span) }
  // Keep the recursive tail named. A bare `[edge]` immediately after the
  // `if` is postfix indexing in Mentl's grammar, so it indexes the divider's
  // Unit result instead of constructing the branch-edge prefix.
  let rest = infer_fanout_share_branches(branches, input_h, span, i + 1, n)
  [edge] ++ rest
}

fn infer_fanout_apply_one(branch, input_h, span: ValidSpan) = match branch {
  N(_, _, bh) => {
    let ret_h = mint(InferredPipeResult("<|", Inferred("branch result")))
    let carrier_h = mint(InferredPipeResult("<|", Inferred("branch carrier")))
    let thunk_h = mint(InferredPipeResult("<|", Inferred("executable boundary")))
    let thread_ticket_h = mint(InferredPipeResult("<|", Inferred("thread schedule ticket")))
    let persist_ticket_h = mint(InferredPipeResult("<|", Inferred("persist schedule ticket")))
    let thunk_row_h = graph_fresh_row(InferredPipeResult("<|", Inferred("boundary effects")))
    let call_row_h = graph_fresh_row(InferredPipeResult("<|", Inferred("implicit application effects")))
    let expected = TFun(build_inferred_params([input_h]), TVar(ret_h), mk_ef_open([], call_row_h))
    let expected_h = mint(Inferred("<| branch expected fn"))
    // Infer the authored stage and its implicit application inside the boundary's
    // row frame. The frame closes onto thunk_row_h; only that exact row is then
    // projected into the enclosing function.
    //
    // drift-audit: ignore — two independent frame inputs (row handle, answer handle) — one frame record's fields, not parallel arrays
    inf_enter_fn(thunk_row_h, carrier_h, span, [])
    infer_expr(branch)
    graph_bind(expected_h, expected, Located(span, Inferred("<| branch applied to the borrowed input")))
    unify(bh, expected_h, span, Inferred("<| branch borrows the shared input"))
    // The branch call's row flows into the boundary frame — the same
    // read-the-callee's-own-row discipline infer_call_saturated uses.
    match graph_chase(bh) {
      GNode(NBound(TFun(_, _, brow)), _) => inf_add_row_unified(brow),
      _ => match graph_chase(call_row_h) {
        GNode(NRowBound(row), _) => inf_add_row_unified(row),
        GNode(NRowFree(_), _) => inf_add_row(mk_ef_open([], call_row_h)),
        _ => (),
      },
    }
    // The implicit application is a suspension boundary inside the thunk frame.
    stage_continuation_boundary("<|", ret_h)
    inf_exit_fn([])
    let thunk_row = mk_ef_open([], thunk_row_h)
    graph_bind(
      carrier_h,
      TTuple([TVar(ret_h)]),
      Located(span, InferredPipeResult("<|", Inferred("boundary carrier")))
    )
    graph_bind(
      thunk_h,
      TFun([], TVar(carrier_h), thunk_row),
      Located(span, InferredPipeResult("<|", Inferred("zero-argument boundary")))
    )
    graph_bind(
      thread_ticket_h,
      TName("ThreadHandle", []),
      Located(span, InferredPipeResult("<|", Inferred("thread schedule ticket")))
    )
    graph_bind(
      persist_ticket_h,
      TName("PersistHandle", []),
      Located(span, InferredPipeResult("<|", Inferred("persist schedule ticket")))
    )
    inf_add_row(thunk_row)
    BoundaryEdge(ret_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h)
  },
}

// Unification — graph-direct, Hazel-productive.
// Every unification carries the span of the AST site that triggered
// it. `span` threads through the recursive walk; `graph_bind` writes
// store `Located(span, reason)`, which is what `graph_reason_at` reads
// back at any handle the walk touched.
fn unify(h_a, h_b, span: ValidSpan, reason) = {
  // Union-find: find both ROOTS (graph_chase_handle follows the TVar
  // chain to the canonical handle), then union the ROOTS — never the
  // surface aliases. Binding the surface re-points an aliased use-site
  // (NBound(TVar(root))) and strands `root` free, so lower reads the
  // param local type-blind and `word == "fn"` emits pointer i32.eq. The
  // root-equality guard stops a root being bound to a handle that chases
  // back to it (the self-cycle a record unification would loop on).
  let ra = graph_chase_handle(h_a)
  let rb = graph_chase_handle(h_b)
  if ra == rb {
    ()
  } else {
    let na = graph_chase(ra)
    let nb = graph_chase(rb)
    match na {
      GNode(ka, _) => match nb {
        GNode(kb, _) => match ka {
          NFree(_) => graph_bind(ra, TVar(rb), Located(span, reason)),
          NBound(ta) => match kb {
            NFree(_) => graph_bind(rb, TVar(ra), Located(span, reason)),
            NBound(tb) => unify_types(ta, tb, span, reason),
            NErrorHole(_) => (),
            _ => (),
          },
          NErrorHole(_) => (),
          _ => (),
        },
      },
    }
  }
}

// Type-name equality with the String proof pinned at the boundary (the sibling
// of effects.mn's field_name_eq). A bare `==` on two nominal type names emits
// pointer-eq under the seed, so names interned in different passes never match;
// pinning `: String` makes it the structural str_eq. One home for the compare.
fn type_name_eq(a: String, b: String) with Pure = a == b

fn unify_types(ref a, ref b, span: ValidSpan, reason) = {
  let right_is_wrapper = match b {
    TAlias(_, _) => true,
    TRefined(_, _) => true,
    TReprPin(_, _) => true,
    _ => false,
  }
  let left_is_wrapper_or_var = match a {
    TVar(_) => true,
    TAlias(_, _) => true,
    TRefined(_, _) => true,
    TReprPin(_, _) => true,
    _ => false,
  }
  if right_is_wrapper && !left_is_wrapper_or_var {
    match b {
      TAlias(_, inner_b) => unify_types(a, inner_b, span, reason),
      TReprPin(_, base_b) => // The pin is a gradient INPUT (§4① — an annotation, not a type):
      // identity unifies at the base; only emission reads the width.
      unify_types(a, base_b, span, reason),
      TRefined(base_b, _) => // A concrete type meets the refined wrapper: unify against the BASE
      // only. The refinement OBLIGATION is never accrued here — this arm
      // has no value node, so its old verify pended the raw predicate with
      // `self` unsubstituted, forever undecidable, one noise entry per
      // refined-param unification. The value-bearing homes own the
      // discharge: the let annotation and the fn return
      // (apply_refinement_constraint via subst_self) and the call boundary
      // (discharge_arg_refinements — R2's third site).
      unify_types(a, base_b, span, reason),
      _ => (),
    }
  } else {
    match a {
      TInt => expect_same(a, b, span, reason),
      TFloat => expect_same(a, b, span, reason),
      TUnit => // String IS [byte] (§4①): a String unifies with a byte list, and with any
      expect_same(a, b, span, reason),
      TByte => // The byte scalar routes through the ground check like every word
      // (expect_same reads same_ground's Byte~Byte and the Byte~Int
      // value-equality); without this arm TByte fell to the catch-all's
      // type_mismatch and refused Byte vs Byte itself.
      expect_same(a, b, span, reason),
      TVar(ha) => match b {
        TVar(hb) => unify(ha, hb, span, reason),
        _ => // CARRIED-TRUTH: the left handle may ALREADY be bound (a use-site handle the graph
        // proved — e.g. a lambda arg's `(r) -> ret`). Read it live: if NBound,
        // unify `b` AGAINST that existing type, never `graph_bind` over it. The
        // raw bind discards the proof and orphans its inner vars — the config-fn
        // /HOF field-access disconnect (a callee's resolved param type bound
        // onto the lambda handle erased the lambda's own arrow, so the param
        // never met the binder and its field read floored on an open row). A
        // genuinely-free var still binds.
        {
          let root = graph_chase_handle(ha)
          match graph_chase(root) {
            GNode(NBound(inner), _) => unify_types(inner, b, span, reason),
            GNode(_, mint_reason) => if occurs_in_live(root, b) {
              report(EOccursCheck(root, b, span))
              // The poly-recursion teach rides the refusal: an infinite
              // type running through a fn's OWN param/return mint is the
              // self-call-at-a-different-type shape's fingerprint — name
              // the fn and the signature route (the refusal stands; the
              // narration is the question that beats the guess).
              match mint_reason {
                FnParam(owner, _, _) => report(TPolyRecursionSignature(owner, span)),
                FnReturn(owner, _) => report(TPolyRecursionSignature(owner, span)),
                _ => (),
              }
            } else {
              graph_bind(root, b, Located(span, reason))
            },
          }
        },
      },
      TList(ea) => match b {
        TList(eb) => unify_types(ea, eb, span, ListElement(reason)),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TTuple(ea) => match b {
        TTuple(eb) => unify_type_lists(ea, eb, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TFun(pa, ra, ea) => match b {
        TFun(pb, rb, eb) => {
          // DESIGN Ch 2 Insight 7: parameters ARE tuples. When arities
          // match, pair positionally. When one side has a single-param
          // TTuple(N) and the other has N params, decompose and pair
          // element-wise. When one side has a single TVar param, bind
          // it to a TTuple of the other side's param types. The same
          // rule handles `fn f(a, b) = ...` called via `|>` with a
          // 2-tuple — no splat operator, no adapter, just structural
          // pairing that the graph already knows how to do.
          pair_fn_params(pa, pb, span, reason)
          unify_types(ra, rb, span, FnReturn("fn", reason))
          unify_row(ea, eb, span, reason)
        },
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TName(na, aa) => match b {
        TName(nb, ab) => // type_name_eq pins the String proof: a bare `na == nb` on two type
        // names carries no proof through the seed's weak inference and emits
        // POINTER-eq, so a name interned in one pass ("Iterate" at
        // register_effect_ops) never matches the byte-identical name interned
        // in another (the handler's instance at register_handler) — the args
        // then skip unify_type_lists and every effect-instance position stays
        // free (fold's accumulator floored at `acc ++ xs`). The §9 name-compare
        // class; the field_name_eq precedent, one home for the type-name compare.
        if type_name_eq(na, nb) {
          unify_type_lists(aa, ab, span, reason)
        } else {
          type_mismatch(a, b, span, reason)
        },
        TRecordOpen(fb, vb) => // A nominal RECORD satisfies a structural field demand by its own
        // declaration, read through the live env edge (RecordSchemeKind —
        // the same channel the literal check and the ctor arrow view
        // read). The brand never erases: this side stays TName; only the
        // demand's field vars and row residual bind. This is what makes
        // `p.age` on a nominal receiver and a row-polymorphic parameter
        // (`{name: String, ...}`) accept a nominal record — the canonical
        // SYNTAX forms; before this arm both falsely mismatched. A CLOSED
        // structural demand still refuses (exact-shape identity is the
        // brand's point).
        match nominal_record_fields(na) {
          Some(declared) => unify_record_open_against_closed(declared, fb, vb, span, reason),
          None => type_mismatch(a, b, span, reason),
        },
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TRecord(fa) => match b {
        TRecord(fb) => unify_record_fields_closed(fa, fb, span, reason),
        TRecordOpen(fb, vb) => unify_record_open_against_closed(fa, fb, vb, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TRecordOpen(fa, va) => match b {
        TRecord(fb) => unify_record_open_against_closed(fb, fa, va, span, reason),
        TRecordOpen(fb, vb) => unify_two_open_records(fa, va, fb, vb, span, reason),
        TName(_, _) => unify_types(b, a, span, reason),
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TRefined(base_a, _) => // Refined types unify by their BASES; no arm here accrues an
      // obligation — unification has no value node, so a raw-pred verify
      // pends `self` unsubstituted forever (the noise class the debt
      // surfacing exposed). The value-bearing homes own the discharge:
      // the let annotation, the fn return, and the call boundary
      // (apply_refinement_constraint / discharge_arg_refinements —
      // subst_self against the live node). Refined-vs-refined predicate
      // IMPLICATION is the SMT band's question (Hβ.verify.smt-handler-swap),
      // never a conjunction pended at the unify.
      match b {
        TRefined(base_b, _) => unify_types(base_a, base_b, span, reason),
        _ => unify_types(base_a, b, span, reason),
      },
      TCont(ria, saa, da, wa) => match b {
        TCont(rib, sab, db, wb) => {
          // The continuation's TYPE carries four facts; unify ALL four. (1)
          // resume input R. (2) answer S. (3) resume cardinality:
          // OneShot/MultiShot are distinct
          // representations (stack frame vs heap record), so a mismatch is a
          // hard E_ResumeWorldMismatch; Either is gradient-undecided and
          // unifies with either. (4) the effect-WORLD: a row unification at the
          // resume edge — resuming a continuation under a changed handler-set
          // is unify(captured_world, resume_site_world). !E lifted to the TIME
          // axis (§4③ modal frontier); a now-unhandled resume is a compile/load
          // error, never a silent memcpy'd miscompile (Law 7).
          unify_types(ria, rib, span, reason)
          unify_types(saa, sab, span, reason)
          if disciplines_compatible(da, db) { () } else { report(EResumeWorldMismatch(da, db, span)) }
          unify_row(wa, wb, span, reason)
        },
        TVar(_) => unify_types(b, a, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
      TAlias(name, inner_a) => // RN.2 — Unification alias preservation
      match b {
        TVar(_) => unify_types(b, a, span, reason),
        TAlias(_, inner_b) => unify_types(inner_a, inner_b, span, reason),
        _ => unify_types(inner_a, b, span, reason),
      },
      TReprPin(_, base_a) => // The pin peels like the alias (RN.2's shape): a var binds the
      // PINNED type (repr_of chases to the pin); anything else meets the base.
      match b {
        TVar(_) => unify_types(b, a, span, reason),
        _ => unify_types(base_a, b, span, reason),
      },
      _ => match b {
        TVar(_) => unify_types(b, a, span, reason),
        TAlias(_, inner_b) => unify_types(a, inner_b, span, reason),
        TRefined(base_b, _) => unify_types(a, base_b, span, reason),
        TReprPin(_, base_b) => unify_types(a, base_b, span, reason),
        _ => type_mismatch(a, b, span, reason),
      },
    }
  }
}

fn expect_same(ref a, ref b, span: ValidSpan, reason) = match b {
  TVar(_) => // The var may ALREADY be bound — a constructor-argument reference is
  // NBound(TVar(binder)), the graph's live proof that the arg IS the
  // param. A raw graph_bind(hb, a) CLOBBERS that binding, orphaning the
  // binder: the arg reference learns the scalar, the parameter never does
  // (a Float ctor field left the param an unresolved var → i32 floor →
  // f64-through-i32 trap). Flip to the one canonical var path (every other
  // unify arm does) — it chases hb live, unifies the scalar against the
  // bound inner (binding the binder for a free chain, reporting a genuine
  // mismatch for a bound-to-conflicting-scalar chain the raw bind masked).
  unify_types(b, a, span, reason),
  _ => if same_ground(a, b) { () } else { type_mismatch(a, b, span, reason) },
}

// H6: exhaustive Ty enumeration. Ground scalars match their same-
// variant; compound types are structurally equal only if their
// sub-parts are unified separately (that's unify_types' job, not
// same_ground's). A new scalar Ty must be added here explicitly.
fn same_ground(ref a, ref b) with Pure = match a {
  TInt => // §4①/STEP 0: a byte VALUE and an Int are ground-EQUAL — both are the one
  // word (repr RI32) — and this acceptance is CHECK-level only: same_ground
  // never binds, so a [byte] node never REWRITES to [Int] (no re-stride by
  // unification, ever; fold_sig keeps "b" != "i"). The check-level form is
  // forced by inference order: under the Stage Law the datum infers LAST, so
  // `map((b) => b - 32, s)` types the lambda while `b` is still free — b binds
  // Int, and only the CALL's param unify meets TByte; a strict split would
  // refuse the canonical case. The SLOT stays protected where slots actually
  // live: reads follow the runtime stride carrier (any stride, always honest),
  // construction follows the RESULT type, the one typed stride-1 store traps
  // out-of-range (store_strided, the bounds-trap precedent), and str_payload
  // normalizes stride at the materialization boundary. The compile-time
  // narrowing gate (ground Int proven 0..255 via R3) is the named refinement
  // tier on top — Hβ.infer.byte-narrowing-ground-discharge.
  match b {
    TInt => true,
    TByte => true,
    _ => false,
  },
  TFloat => match b {
    TFloat => true,
    _ => false,
  },
  TUnit => match b {
    TUnit => true,
    _ => false,
  },
  TByte => match b {
    TByte => true,
    TInt => true,
    _ => false,
  },
  TVar(_) => // Compound types: same_ground rejects; unify_types handles structurally
  false,
  TList(_) => false,
  TTuple(_) => false,
  TFun(_, _, _) => false,
  TName(_, _) => false,
  TRecord(_) => false,
  TRecordOpen(_, _) => false,
  TRefined(_, _) => false,
  TCont(_, _, _, _) => false,
  TAlias(_, inner) => same_ground(inner, b),
  TReprPin(_, base) => // The pin is a gradient INPUT (an annotation, not a type — §4①):
  // identity is the base's; only emission reads the width.
  same_ground(base, b),
}

// Two resume cardinalities unify iff they pick the SAME representation, OR
// one side is Either (gradient-undecided — it instantiates to the other).
// OneShot (stack frame) vs MultiShot (heap continuation record) is the
// representation conflict E_ResumeWorldMismatch names. H6-exhaustive over the
// ResumeDiscipline ADT (drift 8: no count-as-int — the ADT IS the comparison).
fn disciplines_compatible(a, b) with Pure = match a {
  Either => true,
  OneShot => match b {
    OneShot => true,
    Either => true,
    MultiShot => false,
    Abandon => false,
  },
  MultiShot => match b {
    MultiShot => true,
    Either => true,
    OneShot => false,
    Abandon => false,
  },
  Abandon => // M4 — Abandon (dead continuation) reconciles with itself or the
  // gradient-undecided Either; it is a distinct representation from the
  // stack-frame OneShot and the heap-k MultiShot (E_ResumeWorldMismatch).
  match b {
    Abandon => true,
    Either => true,
    OneShot => false,
    MultiShot => false,
  },
}

fn unify_type_lists(as_list, bs_list, span: ValidSpan, reason) = if len(as_list) == 0 && len(bs_list) == 0 {
  ()
} else if len(as_list) == 0 || len(bs_list) == 0 {
  // Arity mismatch: tuple/list lengths differ.
  report(ETypeArityMismatch(len(as_list), len(bs_list), span))
} else {
  unify_types(last(as_list), last(bs_list), span, reason)
  unify_type_lists(drop_last(as_list), drop_last(bs_list), span, reason)
}

// Both field lists arrive sorted by name (parser invariant + smart
// constructor `mk_record_open`). Closed×closed: pointwise field
// equality (length match + name match + type unify). Closed×open:
// the closed record must include every open-side field; remaining
// fields bind the open's row variable. Open×open: intersect known
// fields; bind one variable to the residual relative to the other.
fn unify_record_fields_closed(fa, fb, span: ValidSpan, reason) = if len(fa) != len(fb) {
  type_mismatch(TRecord(fa), TRecord(fb), span, reason)
} else {
  unify_record_fields_loop(fa, fb, 0, len(fa), span, reason)
}

fn unify_record_fields_loop(fa, fb, i, n, span: ValidSpan, reason) = if i >= n {
  ()
} else {
  match list_index(fa, i) {
    (na, ta) => match list_index(fb, i) {
      (nb, tb) => if field_name_eq(na, nb) {
        unify_types(ta, tb, span, reason)
        unify_record_fields_loop(fa, fb, i + 1, n, span, reason)
      } else {
        type_mismatch(TRecord(fa), TRecord(fb), span, reason)
      },
    },
  }
}

// The nominal record's declared fields, read through the live env edge —
// the third reader of RecordSchemeKind (the literal check and the ctor
// arrow view are the other two; one channel, three readers). None for a
// name that is not a nominal record.
fn nominal_record_fields(name) = match env_lookup(name) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      RecordSchemeKind(declared) => Some(declared),
      _ => None,
    },
  },
  None => None,
}

fn unify_record_open_against_closed(closed_fields, open_fields, open_var, span: ValidSpan, reason) = {
  // Every open-side field must appear in the closed side. Unify
  // matched fields' types; bind the row variable to the remainder.
  unify_record_open_subset(open_fields, closed_fields, span, reason)
  let residual = record_fields_diff(closed_fields, open_fields)
  // PROVEN. The other side is CLOSED, so its fields are the whole set and
  // the residual is exactly what remains — nothing further can arrive.
  graph_bind_record_row(open_var, residual, RowClosed, Located(span, reason))
}

fn unify_record_open_subset(needed, available, span: ValidSpan, reason) = if len(needed) == 0 {
  ()
} else {
  match last(needed) {
    (n, t) => {
      let pos = find_record_field_pos(available, n)
      if pos < 0 {
        type_mismatch(TRecord(needed), TRecord(available), span, reason)
      } else {
        match list_index(available, pos) {
          (_, t2) => {
            unify_types(t, t2, span, reason)
            unify_record_open_subset(drop_last(needed), available, span, reason)
          },
        }
      }
    },
  }
}

fn unify_two_open_records(fa, va, fb, vb, span: ValidSpan, reason) = {
  // Intersect known fields (unify shared types); bind va to a
  // record-residual carrying fb's exclusive fields, mirror for vb.
  // Two row variables collapse to one when they're already linked;
  // otherwise both narrow to the union of known fields.
  let shared = intersect_record_fields(fa, fb)
  unify_record_fields_loop_shared(fa, fb, shared, span, reason)
  let extra_a = record_fields_diff(fa, fb)
  let extra_b = record_fields_diff(fb, fa)
  if va == vb {
    if len(extra_a) == 0 && len(extra_b) == 0 {
      ()
    } else {
      type_mismatch(TRecordOpen(fa, va), TRecordOpen(fb, vb), span, reason)
    }
  } else if len(extra_a) == 0 && len(extra_b) == 0 && row_var_is_free(vb) {
    // THE UNION. Identical known sets and nothing yet written on vb: these
    // are not two rows that happen to agree, they ARE one row, and the graph
    // says so by making vb an alias of va — the same NBound(TVar) edge
    // chase_handle already follows for a type var, whose own comment states
    // the law this arm was missing: unify unions the ROOTS.
    //
    // Left unlinked, the two stayed separate nodes forever, so nothing that
    // keys on a row var could see them as one: an open-row callee reached
    // from inside another twin's body projected its key against a handle the
    // twin's pairs had never heard of, no interior twin was demanded, and the
    // body read the decl's own unlearned row (7 where 9 was asked for —
    // tests/repro-wf/open-row-interior-site.mn).
    //
    // Only the unwritten side aliases, and only when the known sets agree. A
    // row carrying its own residual is a DIFFERENT remainder of the same
    // record — `{zeta | Ra}` beside `{alpha | Rb}` have Ra ≠ Rb by
    // construction — so those cross-absorb below, which was right all along.
    graph_bind(vb, TVar(va), Located(span, reason))
  } else {
    // ASSUMED. Each var takes the fields the other side knows and it does
    // not — a real carrying, measured: the second-field micro's offsets are
    // right because this bind moves the far side's field across. What it
    // does NOT know is whether anything lies past the union, and the old
    // shape said
    // "nothing" in the same breath it said the fields. The mark separates
    // the two halves so a reader can tell a carried fact from a guess.
    absorb_into_residual(va, extra_b, span, reason)
    absorb_into_residual(vb, extra_a, span, reason)
  }
}

// A DEMAND IS CHECKED AGAINST THE GRAPH, NEVER INSTALLED OVER IT. A field
// access builds an EXPECTED receiver `{field: <fresh> | <fresh row>}` and
// unifies the real one against it, so the incoming fields here are often a
// question, not an answer. When the var already carries a residual, the
// fields it shares with the question get UNIFIED — the graph's proof
// constrains the fresh variable, which is the direction that keeps a fact
// — and only genuinely new fields widen it. Writing the incoming set over
// the residual turned `run : () -> Int with E` into a free variable and
// took its row with it, so a closure called under `!E` through a record
// rest checked clean (`Hβ.infer.field-access-overwrites-a-proven-residual`).
// The unbound case is unchanged: nothing is known, so the union IS the
// reading, and it is marked assumed.
fn absorb_into_residual(v, incoming, span: ValidSpan, reason) = match graph_chase(v) {
  GNode(NRecordRowBound(known, tail), _) => {
    unify_record_fields_loop_shared(
      known,
      incoming,
      intersect_record_fields(known, incoming),
      span,
      reason
    )
    let added = record_fields_diff(incoming, known)
    if len(added) == 0 {
      ()
    } else {
      match tail {
        RowClosed => // PROVEN WHOLE: the writer saw a closed partner, so this residual
        // IS the remainder and a name outside it is provably absent. That
        // is the same verdict a closed record already gives for an unknown
        // field, and it has to be given here too: widening put the missing
        // name at its sorted offset and the read came back with a
        // NEIGHBOUR's value (`{a: 1, b: 2}` destructured, `rest.aa`
        // answered 2 — b's).
        type_mismatch(TRecord(known), TRecord(known ++ added), span, reason),
        RowAssumed => // The remainder is a union of partial sets or continues at another
        // var: more may genuinely exist, so a new name widens. The residual
        // KEEPS its own tail — what the writer knew about the rest did not
        // change because a demand named one more field.
        graph_bind_record_row(v, known ++ added, tail, Located(span, reason)),
        RowContinues(_) => graph_bind_record_row(v, known ++ added, tail, Located(span, reason)),
      }
    }
  },
  _ => // An EMPTY incoming set carries nothing, so it writes nothing. The bound
  // arm above already says this — `if len(added) == 0 { () }` — and the
  // unbound arm said the opposite, stamping `[] assumed` onto a cell that
  // knew nothing at all. That write is a fabrication in the Law's exact
  // sense: "the remainder is empty, and I am guessing" is a claim the graph
  // never made, and every reader downstream believed it. It is what made an
  // open row's offset come back provable-and-wrong, and what kept two
  // identical rows from ever unioning, since the cell was no longer free.
  // A cell that knows nothing stays free, and a free cell floors honestly.
  if len(incoming) == 0 {
    ()
  } else {
    graph_bind_record_row(v, incoming, RowAssumed, Located(span, reason))
  },
}

fn unify_record_fields_loop_shared(fa, fb, names, span: ValidSpan, reason) = if len(names) == 0 {
  ()
} else {
  let n = last(names)
  let pa = find_record_field_pos(fa, n)
  let pb = find_record_field_pos(fb, n)
  if pa >= 0 && pb >= 0 {
    match list_index(fa, pa) {
      (_, ta) => match list_index(fb, pb) {
        (_, tb) => unify_types(ta, tb, span, reason),
      },
    }
  }
  unify_record_fields_loop_shared(fa, fb, drop_last(names), span, reason)
}

fn intersect_record_fields(fa, fb) = {
  let n = len(fa)
  match intersect_record_fields_loop(fa, fb, 0, n, make_list(n), 0) {
    (buf, count) => slice(buf, 0, count),
  }
}

fn intersect_record_fields_loop(fa, fb, i, n, own buf, count) = if i >= n {
  (buf, count)
} else {
  match list_index(fa, i) {
    (name, _) => match if find_record_field_pos(fb, name) >= 0 {
      let extended = list_extend_to(buf, count + 1)
      let written = list_set(extended, count, name)
      (written, count + 1)
    } else {
      (buf, count)
    } {
      (next_buf, next_count) => intersect_record_fields_loop(fa, fb, i + 1, n, next_buf, next_count),
    },
  }
}

fn record_fields_diff(left, right) = {
  let n = len(left)
  match record_fields_diff_loop(left, right, 0, n, make_list(n), 0) {
    (buf, count) => slice(buf, 0, count),
  }
}

fn record_fields_diff_loop(left, right, i, n, own buf, count) = if i >= n {
  (buf, count)
} else {
  let entry = list_index(left, i)
  match entry {
    (name, _) => match if find_record_field_pos(right, name) < 0 {
      let extended = list_extend_to(buf, count + 1)
      let written = list_set(extended, count, entry)
      (written, count + 1)
    } else {
      (buf, count)
    } {
      (next_buf, next_count) => record_fields_diff_loop(left, right, i + 1, n, next_buf, next_count),
    },
  }
}

fn find_record_field_pos(fields, name) = find_record_field_pos_loop(fields, name, 0, len(fields))

fn find_record_field_pos_loop(fields, name: String, i, n) = if i >= n {
  -1
} else {
  match list_index(fields, i) {
    (existing, _) => if field_name_eq(existing, name) { i } else { find_record_field_pos_loop(fields, name, i + 1, n) },
  }
}

// Infer each field's value expression; result handles are used by
// callers to build `TRecord` field-type lists and region-join sets.
fn infer_record_field_values(fields) = if len(fields) == 0 {
  ()
} else {
  match last(fields) {
    (_, value) => {
      infer_expr(value)
      infer_record_field_values(drop_last(fields))
    },
  }
}

fn build_record_field_types(fields) = map(
  (fld) => match fld {
    (name, value) => match value {
      N(_, _, vh) => (name, TVar(vh)),
    },
  },
  fields
)

// The record field list inferred at a node — chase its handle to the
// bound type and read its fields LIVE (TRecord / TRecordOpen carry them;
// any other resolved type yields []). The record-update result derives
// from this, so it reads the base's proven shape, never a copy.
fn record_fields_of_node(node) = match node {
  N(_, _, h) => match graph_chase(h) {
    GNode(NBound(ty), _) => match ty {
      TRecord(fields) => fields,
      TRecordOpen(fields, _) => fields,
      _ => [],
    },
    _ => [],
  },
}

// Merge override field-types into a base field list: each override
// overwrites the same-named base field or is added, and the result is
// kept in the one canonical name-sorted layout via the parser's
// record_field_insert (the same sort lower's offset arithmetic assumes
// — the sort has ONE home, not re-derived here). The override wins by
// name (last-writer over the base copy) — the spread semantics.
fn merge_override_fields(base_fields, overrides) = fold(
  base_fields,
  (acc, ov) => match ov {
    (oname, _) => record_field_insert(reject_field(acc, oname), ov),
  },
  overrides
)

fn reject_field(fields, target) = filter(
  (f) => match f {
    (n, _) => n != target,
  },
  fields
)

// H4.1 projection — pull the value handles out of a record-field list
// for region-join lookup. Field names aren't needed for region
// tracking; only the per-value handles matter.
fn record_field_handles(fields) = map(
  (fld) => match fld {
    (_, value) => match value {
      N(_, _, vh) => vh,
    },
  },
  fields
)

// H2.3: validate a nominal record literal's fields against the
// declared schema. Both lists arrive sorted by field name (parser
// sort + RecordSchemeKind sort invariant). Pointwise check:
//   - missing declared field    → E_RecordFieldMissing
//   - extra unknown field       → E_RecordFieldExtra
//   - matched name              → unify value's handle with declared ty
fn check_nominal_record_fields(declared, provided, type_name, span: ValidSpan) =
  check_nominal_record_loop(declared, provided, type_name, span, 0, 0, len(declared), len(provided))

fn check_nominal_record_loop(declared, provided, type_name, span: ValidSpan, i, j, ni, nj) = if i >= ni && j >= nj {
  ()
} else if i >= ni {
  // Provided has extras
  match list_index(provided, j) {
    (extra, _) => {
      report(ERecordFieldExtra(extra, type_name, span))
      check_nominal_record_loop(declared, provided, type_name, span, i, j + 1, ni, nj)
    },
  }
} else if j >= nj {
  match list_index(declared, i) {
    (missing, _) => {
      report(ERecordFieldMissing(missing, type_name, span))
      check_nominal_record_loop(declared, provided, type_name, span, i + 1, j, ni, nj)
    },
  }
} else {
  match list_index(declared, i) {
    (dn, dt) => match list_index(provided, j) {
      (pn, pv) => if field_name_eq(dn, pn) {
        match pv {
          N(_, _, vh) => {
            let expect_h = mint(Inferred("record field type"))
            graph_bind(expect_h, dt, Located(span, Inferred("declared field type")))
            unify(vh, expect_h, span, OpConstraint("record field", Inferred("declared"), Inferred("provided")))
            check_nominal_record_loop(declared, provided, type_name, span, i + 1, j + 1, ni, nj)
          },
        }
      } else if str_lt(dn, pn) {
        report(ERecordFieldMissing(dn, type_name, span))
        check_nominal_record_loop(declared, provided, type_name, span, i + 1, j, ni, nj)
      } else {
        report(ERecordFieldExtra(pn, type_name, span))
        check_nominal_record_loop(declared, provided, type_name, span, i, j + 1, ni, nj)
      },
    },
  }
}

fn unify_param_lists(ref a, ref b, span: ValidSpan, reason) = if len(a) == 0 || len(b) == 0 {
  ()
} else {
  let ta = param_ty(last(a))
  let tb = param_ty(last(b))
  unify_types(ta, tb, span, reason)
  unify_param_lists(drop_last(a), drop_last(b), span, reason)
}

// Parameters ARE tuples (DESIGN Ch 2 Insight 7). The one unification
// rule that lets `|>` deliver a tuple to an N-ary function without a
// splat operator. Three cases:
//
//   `len(pa) == len(pb)`          — pair positionally (the ordinary path)
//   `len(pa) == 1`, head is tuple — decompose, pair element-wise
//   `len(pa) == 1`, head is TVar  — bind TVar to TTuple(pb param types)
//   symmetric for pb; otherwise   — arity mismatch
//
// Inference reads the shape and pairs structurally — the same discipline
// that pairs TInt with TInt or TList(a) with TList(b).
fn pair_fn_params(pa, pb, span: ValidSpan, reason) = {
  let la = len(pa)
  let lb = len(pb)
  if la == lb {
    unify_param_lists(pa, pb, span, reason)
  } else if la == 1 {
    try_tuple_decompose(last(pa), pb, span, reason)
  } else if lb == 1 {
    try_tuple_decompose(last(pb), pa, span, reason)
  } else {
    arity_mismatch(la, lb, span)
  }
}

// Given a single param whose type is either a `TTuple` or a `TVar`,
// reconcile it against a multi-param list.
//   `TTuple(elems)` of matching arity — pair element-wise with params
//   `TVar(_)`                         — unify TVar with TTuple of param types
//   otherwise                         — arity mismatch
fn try_tuple_decompose(single_param, many_params, span: ValidSpan, reason) = {
  let pty = param_ty(single_param)
  let lm = len(many_params)
  match pty {
    TTuple(elems) => if len(elems) == lm {
      unify_tuple_elems_with_params(elems, many_params, span, reason, 0, lm)
    } else {
      arity_mismatch(len(elems), lm, span)
    },
    TVar(_) => {
      let tup_ty = TTuple(param_types_flat(many_params))
      unify_types(pty, tup_ty, span, reason)
    },
    _ => arity_mismatch(1, lm, span),
  }
}

// Pair tuple element i with param i, flat-indexed to avoid snoc-walk
// allocation on either input.
fn unify_tuple_elems_with_params(elems, params, span: ValidSpan, reason, i, n) = if i >= n {
  ()
} else {
  let e = list_index(elems, i)
  let pt = param_ty(list_index(params, i))
  unify_types(e, pt, span, reason)
  unify_tuple_elems_with_params(elems, params, span, reason, i + 1, n)
}

// Extract param types into a fresh flat list — O(1) amortized per
// element via `list_set` into a pre-sized buffer. The resulting list
// is tag=0 (flat); any subsequent `list_index` on it is O(1).
fn param_types_flat(params) = {
  let n = len(params)
  param_types_loop(params, 0, n, make_list(n))
}

fn param_types_loop(params, i, n, own acc) = if i >= n {
  acc
} else {
  let t = param_ty(list_index(params, i))
  param_types_loop(params, i + 1, n, list_set(acc, i, t))
}

fn arity_mismatch(la, lb, span: ValidSpan) = report(EFnArityMismatch(la, lb, span))

// The subscript's generic path — total over sequences: the receiver
// forces to a list of the fresh element (a String receiver peels
// through its alias to the byte list, so the element binds TByte).
// The tuple-const route in the IndexExpr arm runs FIRST; this force is
// what a free or sequence receiver takes, and what reports the honest
// mismatch when a runtime-variable index meets a heterogeneous product.
// The subscript receiver's SHALLOW read: the root's own binding,
// alias-peeled — never the deep fold (chase_deep_at's depth belt is
// for value-boundary folds, not a mid-judgment probe). An unbound or
// non-tuple root answers TUnit here, which no tuple arm matches — the
// caller falls to the generic force.
fn index_receiver_shallow(rh) with GraphRead = match graph_chase(rh) {
  GNode(NBound(rty), _) => fold_strip(rty),
  _ => TUnit,
}

fn infer_index_force(rh, handle, span: ValidSpan) with FreshHandle + GraphWrite + GraphRead + Memory + Alloc + Cast + Diagnostic + Intern + EnvRead + WASI + InferCtx = {
  let elem_h = mint(Inferred("subscript element"))
  let exp_r = mint(Inferred("subscript receiver"))
  graph_bind(exp_r, TList(TVar(elem_h)), Located(span, Inferred("subscript receiver")))
  unify(rh, exp_r, span, Inferred("subscript receiver"))
  graph_bind(handle, TVar(elem_h), Located(span, Inferred("subscript result")))
  // The sugar charges what its lowering performs: `xs[i]` emits the
  // list_index call, so the judgment charges list_index's own declared
  // row — read live from the env, never a literal (the seq-op charge's
  // law at the sugar). Measured before the charge existed: sugar_once
  // published Pure while call_once published Memory on one file — the
  // teaching surface lying about a memory-touching fn (the four-face
  // probe, 2026-08-01). The tuple-const route stays chargeless: its
  // extraction is compile-time.
  match env_lookup("list_index") {
    Some((sch, _, _)) => match judgment_ty(sch) {
      TFun(_, _, lrow) => inf_add_row(lrow),
      _ => (),
    },
    None => (),
  }
}

fn type_mismatch(ref a, ref b, span: ValidSpan, reason) = report(ETypeMismatch(a, b, span))

// `BinOp` / `UnaryOp` inference — dispatched on `BinOpKind`.
// `binop_kind` (declared in `types.mn`) maps each `BinOp` to one of four
// `BinOpKind` variants — the behavior class used for inference rules.
// Two orthogonal axes: `BinOp` carries specific operator identity
// (14 variants, surfaced at Reason/emit boundaries); `BinOpKind`
// carries semantic behavior class (arith, cmp, bool, concat). No
// `String` intermediary at any dispatch site.
fn infer_binop(handle, op, lh, rh, span: ValidSpan) = {
  let lbl = binop_to_str(op)
  match binop_kind(op) {
    BKArith => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      graph_bind(
        handle,
        TVar(lh),
        Located(span, OpConstraint(lbl, Inferred("result"), Inferred("operand")))
      )
    },
    BKCmp => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      graph_bind(
        handle,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("comparison"), Declared("bool")))
      )
    },
    BKBool => {
      graph_bind(
        lh,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("left"), Declared("bool")))
      )
      graph_bind(
        rh,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("right"), Declared("bool")))
      )
      graph_bind(
        handle,
        TName("Bool", []),
        Located(span, OpConstraint(lbl, Inferred("result"), Declared("bool")))
      )
    },
    BKConcat => {
      unify(lh, rh, span, OpConstraint(lbl, Inferred("left"), Inferred("right")))
      graph_bind(
        handle,
        TVar(lh),
        Located(span, OpConstraint(lbl, Inferred("concat"), Inferred("operand")))
      )
      // `++` IS a call to the concat primitive, so it contributes that
      // callee's row — exactly what infer_call does at :1176
      // (inf_add_row(crow), "the callee's effect row flows into the
      // caller's row"). This arm did not, so `++` was attributed Pure while
      // both primitives it lowers to declare `with Memory + Alloc`. The
      // measured consequence was the crown's own arm failing open:
      //   fn f(ref n) with !Alloc = "a" ++ n     -> row projects Pure,
      //     T_OverDeclared advises TIGHTENING to the false claim, and it
      //     compiles and runs
      //   fn f(ref n) with !Alloc = str_concat("a", n)   -> E_EffectMismatch
      // Byte-identical work, opposite verdicts, because one path read the
      // row the graph proved and the other re-derived it as nothing.
      inf_add_row(concat_callee_row())
    },
  }
}

// The concat primitive's row, read LIVE from its own scheme. Never a
// fabricated `Memory + Alloc` here: the vocabulary declares that row at
// str_concat (lib/strings.mn:183) and list_concat
// (lib/lists.mn:234), and a second home for it in infer is the
// re-derivation this fix exists to delete.
//
// No element-type dispatch: the row is INVARIANT under the representation
// emit chooses (both primitives carry the same row), which is why infer can
// know it while the element type is still open. The union of the two is that
// one row today and stays sound if they ever diverge. When the seq_concat
// unification lands (PLAN §4①, "the str_concat-vs-list_concat split does not
// exist at the bottom") this reads ONE name and the union dissolves.
fn concat_callee_row() = union_row(named_fn_row("str_concat"), named_fn_row("list_concat"))

// A named fn's declared row, live from the env edge. A name that is absent
// or not a function contributes the pure row — the union's identity — which is the
// true statement "this primitive is not in scope here, so `++` cannot be
// calling it"; a `++` with NEITHER primitive in scope has no concat to emit
// and fails at the callee, where that absence actually lives.
fn named_fn_row(name: String) = match env_lookup(name) {
  Some(entry) => match entry {
    (scheme, _, _) => match instantiate(scheme) {
      TFun(_, _, row) => row,
      _ => mk_ef_pure(),
    },
  },
  None => mk_ef_pure(),
}

// The op is the parser's UnaryOp ADT (UNeg | UNot — types.mn), matched
// exhaustively. The old string arms compared "Neg"/"Not" against ADT
// values, never matched, and every unary op fell to a fabricating
// catch-all — `!x` typed as its operand instead of Bool (caught by the
// order-independent judge, 2026-07-25).
fn infer_unaryop(handle, op, ih, span: ValidSpan) = match op {
  UNeg => graph_bind(
    handle,
    TVar(ih),
    Located(span, OpConstraint("Neg", Inferred("negate"), Inferred("operand")))
  ),
  UNot => {
    graph_bind(
      ih,
      TName("Bool", []),
      Located(span, OpConstraint("Not", Inferred("not"), Declared("bool")))
    )
    graph_bind(
      handle,
      TName("Bool", []),
      Located(span, OpConstraint("Not", Inferred("result"), Declared("bool")))
    )
  },
}

// Pattern inference
//
// A pattern's shape CONSTRAINS the scrutinee — it never overwrites it.
// graph_bind on the scrutinee's own handle clobbered its proven type
// (the fanout tuple's f64 elements re-bound to fresh free vars: the
// writer stored at the proven widths, the pattern's reader floored to
// words — the split-truth miscompile). Bind the pattern's shape onto a
// fresh node and UNIFY, so proven element/payload types flow into the
// binders and a shape mismatch is a diagnostic, never a silent retype.
fn constrain_scrutinee(scrutinee_h, ty, span: ValidSpan, reason) = {
  let pat_h = mint(reason)
  graph_bind(pat_h, ty, Located(span, reason))
  // drift-audit: ignore — the two sides of ONE unification edge (scrutinee node, pattern-shape node), not parallel arrays
  unify(scrutinee_h, pat_h, span, reason)
}

fn infer_pat(ref pat, handle, span: ValidSpan) = match pat {
  PVar(name) => env_extend(
    name,
    Frozen([], TVar(handle)),
    Located(span, LetBinding(name, Inferred("pattern"))),
    FnScheme
  ),
  PWild => (),
  PLit(v) => {
    let ty = match v {
      LVInt(_) => TInt,
      LVFloat(_) => TFloat,
      LVString(_) => ty_string,
      LVBool(_) => TName("Bool", []),
    }
    constrain_scrutinee(handle, ty, span, Inferred("literal pattern"))
  },
  PCon(name, sub_pats) => {
    // A pattern IS a reference. This resolution has to happen — arity and
    // exhaustiveness are checked against the very scheme it finds — so the
    // edge is proven here and was being dropped on the floor, which made
    // every match-only constructor read as declared-and-never-reached.
    // Noted above the match for infer_var_ref's reason: a missing
    // constructor is still a reference to the name that is missing.
    graph_ref_note(name, handle)
    match env_lookup(name) {
      None => report(EMissingVariable("constructor: {name}", span)),
      Some(entry) => // ConstructorScheme bindings carry one of two ty shapes:
      //   nullary  → TName(type_name, args)         — bind scrutinee to it
      //   fielded  → TFun(params, TName(...), Pure) — bind scrutinee to RETURN,
      //                                                 sub_pats to PARAMS.
      // A nominal record's entry (RecordSchemeKind) binds the bare TName —
      // the construction view for `Pri{...}` literals, no arrow. Its
      // ctor-PATTERN view is the single-field arrow
      // `Pri : TRecord(declared) → TName`: rebuild the arrow AROUND the
      // scheme's body so ONE instantiate substitutes both halves, and the
      // shared TFun path below binds scrutinee + the sub-pattern. (The
      // seed's kind-132 arm has read this view since the m2 march; the
      // wheel lagged its own seed — every `let Pri(pa) = a` lost pa.)
      // FnScheme bindings reaching here are user-level matches on a
      // plain function value — degenerate but harmless; bind the
      // scrutinee to the looked-up type and skip sub-pat plumbing.
      match entry {
        (scheme, reason, kind) => {
          let ty = match kind {
            RecordSchemeKind(declared_fields) => match judgment_pair(scheme) {
              (q, body) => instantiate(Frozen(q, TFun(build_ctor_params([TRecord(declared_fields)], 0), body, mk_ef_pure()))),
            },
            _ => instantiate(scheme),
          }
          match ty {
            TFun(params, ret_ty, _row) => {
              constrain_scrutinee(handle, ret_ty, span, VarLookup(name, reason))
              bind_pcon_subpats(params, sub_pats, span, reason, name)
            },
            _ => constrain_scrutinee(handle, ty, span, VarLookup(name, reason)),
          }
        },
      },
    }
  },
  PTuple(pats) => infer_pat_tuple(pats, handle, span),
  PList(pats, rest) => infer_pat_list(pats, rest, handle, span),
  PRecord(flds, rest) => {
    // Bind scrutinee to TRecordOpen of the named fields with a
    // fresh row variable — the pattern accepts any record with AT
    // LEAST these fields. Each sub-pattern infers against a fresh
    // handle of the field's type; field-puning patterns are PVar
    // and bind into env via infer_pat's recursion.
    let row_h = graph_fresh_row(Inferred("record pattern row"))
    let field_specs = build_pat_record_field_specs(flds, span)
    let pat_ty = mk_record_open(field_specs, row_h)
    constrain_scrutinee(handle, pat_ty, span, Inferred("record pattern"))
    infer_pat_record_subs(flds, field_specs, span)
    match rest {
      Some(rn) => if rn == "_" {
        ()
      } else {
        // The rest binds the record of the REMAINING fields — the
        // SAME residual row the open pattern carries, as a record
        // with no named fields of its own: when the scrutinee
        // resolves, the row does, and the rest's type IS that
        // record (SYNTAX §"Pattern syntax for records").
        let rest_h = mint(Located(span, LetBinding(rn, Inferred("record pattern rest"))))
        graph_bind(rest_h, mk_record_open([], row_h), Located(span, Inferred("record pattern rest")))
        env_extend(
          rn,
          Frozen([], TVar(rest_h)),
          Located(span, LetBinding(rn, Inferred("record pattern rest"))),
          FnScheme
        )
      },
      None => (),
    }
  },
  PAlt(branches) => {
    // Every branch constrains the SAME scrutinee handle — branch
    // pattern types unify through it by construction. The binding
    // law (the pattern-alternation walkthrough §3): branches bind the
    // same names with unifiable types; the body sees the unified
    // type. Each branch's binder types are read back IMMEDIATELY
    // after its walk (env entries shadow across branches; the law
    // check needs per-branch snapshots).
    let branch_binds = map((b) => infer_pat_alt_branch(b, handle, span), branches)
    enforce_alt_binding_law(branch_binds, span)
  },
  PAs(name, inner) => {
    // The as-pattern binds the WHOLE value: the name's cell IS the
    // scrutinee's (one unify edge — the binder sees exactly the
    // matched value's type), then the inner pattern destructures the
    // same handle.
    let as_h = mint(Located(span, LetBinding(name, Inferred("as-pattern binds the whole value"))))
    graph_bind(as_h, TVar(handle), Located(span, LetBinding(name, Inferred("as-pattern"))))
    env_extend(
      name,
      Frozen([], TVar(as_h)),
      Located(span, LetBinding(name, Inferred("as-pattern"))),
      FnScheme
    )
    infer_pat(inner, handle, span)
  },
}

// Walk one alternation branch, then snapshot its (name, type) binds
// while they are still the latest env entries.
fn infer_pat_alt_branch(ref b, handle, span: ValidSpan) = {
  infer_pat(b, handle, span)
  map((n) => (n, alt_binder_ty(n, span)), pat_binders(b))
}

fn alt_binder_ty(ref n, span: ValidSpan) = match env_lookup(n) {
  Some(entry) => match entry {
    (scheme, _, _) => instantiate(scheme),
  },
  None => {
    // pat_binders said n binds, the walk did not extend it — the
    // branch's binding genuinely failed; surface as the law's
    // diagnostic rather than fabricating a type.
    report(EPatternAlternationBindingMismatch("alternation binder never bound: {n}", span))
    TVar(mint(Located(span, Inferred("alternation binder lost"))))
  },
}

// SYNTAX.md §"Pattern alternation — rule": all branches bind the
// same name set; per-name types unify across branches (the body
// sees the unified type). Branch 0 is the reference set.
fn enforce_alt_binding_law(branch_binds, span: ValidSpan) = match branch_binds {
  [] => (),
  [first, ...rest] => each(
    (bi) => if alt_same_name_set(first, bi) {
      each(
        (p) => match p {
          (n, ty_i) => match find(
            (q) => match q {
              (m, _) => m == n,
            },
            first
          ) {
            Some(q0) => match q0 {
              (_, ty_0) => unify_types(ty_0, ty_i, span, Located(span, Inferred("alternation common type"))),
            },
            None => (),
          },
        },
        bi
      )
    } else {
      report(EPatternAlternationBindingMismatch("alternation branches bind different names", span))
    },
    rest
  ),
}

fn alt_same_name_set(a, b) = len(a) == len(b) && all(
  (p) => match p {
    (n, _) => any(
      (q) => match q {
        (m, _) => m == n,
      },
      b
    ),
  },
  a
)

// pat_binders — the names a pattern binds (pure structural walk).
// Wildcards and literals bind nothing; a PList rest name binds
// unless `_`; a nested alternation's binders are branch 0's (its
// own law check fires on its own walk).
fn pat_binders(ref pat) = match pat {
  PVar(name) => [name],
  PWild => [],
  PLit(_) => [],
  PCon(_, subs) => flat_map(pat_binders, subs),
  PTuple(subs) => flat_map(pat_binders, subs),
  PList(subs, rest) => flatten([flat_map(pat_binders, subs), plist_rest_binders(rest)]),
  PRecord(flds, rest) => flatten([flat_map(
    (fld) => match fld {
      (_, sub) => pat_binders(sub),
    },
    flds
  ), plist_rest_binders(rest)]),
  PAlt(branches) => // Branch 0 carries the whole alternation's binder set (infer's law).
  // Read through len/list_index — total over every representation — so
  // this walk runs identically under a boot whose list-pattern emit
  // predates the PIdx step (the ladder's one exposed rung).
  if len(branches) == 0 { [] } else { pat_binders(list_index(branches, 0)) },
  PAs(name, inner) => [name] ++ pat_binders(inner),
}

fn plist_rest_binders(rest) = match rest {
  None => [],
  Some(n) => if field_name_eq(n, "_") { [] } else { [n] },
}

fn build_pat_record_field_specs(flds, span: ValidSpan) = map(
  (fld) => match fld {
    (name, _) => {
      let h = mint(Inferred("record pattern field"))
      (name, TVar(h))
    },
  },
  flds
)

fn infer_pat_record_subs(flds, specs, span: ValidSpan) = each(
  (pair) => match pair {
    ((_, sub_pat), (_, ty)) => match ty {
      TVar(h) => infer_pat(sub_pat, h, span),
      _ => (),
    },
  },
  zip(flds, specs)
)

fn infer_pat_tuple(pats, parent_handle, span: ValidSpan) = {
  let elem_tys = map(
    (p) => {
      let sub_h = mint(Inferred("tuple pattern element"))
      infer_pat(p, sub_h, span)
      TVar(sub_h)
    },
    pats
  )
  // The scrutinee's proven element types flow into the bound vars, and
  // an arity mismatch is a unification failure at this edge — the exact
  // constraint the sibling infer_pat_list draws for lists.
  constrain_scrutinee(parent_handle, TTuple(elem_tys), span, Inferred("tuple pattern"))
}

fn infer_pat_list(pats, rest, parent_handle, span: ValidSpan) = {
  let elem_h = mint(Inferred("list pattern element"))
  each((p) => infer_pat(p, elem_h, span), pats)
  let list_ty = TList(TVar(elem_h))
  constrain_scrutinee(parent_handle, list_ty, span, Inferred("list pattern"))
  match rest {
    None => (),
    Some(name) => if field_name_eq(name, "_") {
      ()
    } else {
      env_extend(
        name,
        Frozen([], list_ty),
        Located(span, LetBinding(name, Inferred("list rest pattern"))),
        FnScheme
      )
    },
  }
}

// Bind each PCon sub-pattern to its corresponding constructor param
// type. Mints a fresh handle per sub-pat so PVar bindings carry a
// distinct entry into env. An arity mismatch reports EConstructorArity
// FIRST; the aligned prefix still binds (productive-under-error).
fn bind_pcon_subpats(params, sub_pats, span: ValidSpan, reason, ctor_name) = {
  if len(params) != len(sub_pats) {
    report(EConstructorArity(ctor_name, len(params), len(sub_pats), span))
  }
  each(
    (pair) => match pair {
      (param, sub_pat) => {
        let sub_h = mint(VarLookup(ctor_name, reason))
        graph_bind(sub_h, param_ty(param), Located(span, VarLookup(ctor_name, reason)))
        infer_pat(sub_pat, sub_h, span)
      },
    },
    zip(params, sub_pats)
  )
}

fn infer_match_arms(arms, scrut, result_h, span: ValidSpan) = {
  // Match arms are ALTERNATIVE — exactly one runs — so an `own` value
  // consumed in several arms is one consume on the taken path, unioned
  // by the affine ledger without a collision (BAlternative), the same
  // bracket `><` / `<|` use with BParallel. Empty match has no arms to
  // bracket.
  let n = len(arms)
  if n > 0 { branch_enter(BAlternative) }
  infer_match_arm_iter(arms, scrut, result_h, span, 0, n)
  if n > 0 { branch_exit(span) }
  // Exhaustiveness check (H3): if no wildcard arm covers the
  // remainder, every constructor of the scrutinee's declaring type
  // must appear among the arms. ConstructorScheme(_, total_variants)
  // makes this a graph read — no per-type registry needed.
  let covered = collect_arm_tags(arms, [])
  let total = arms_total_variants(arms)
  let has_wild = arms_have_wildcard(arms)
  if total > 0 && len(covered) < total && !has_wild {
    report(EPatternInexhaustive(total - len(covered), total, span))
  }
}

fn infer_match_arm_iter(arms, scrut, result_h, span: ValidSpan, i, n) = if i >= n {
  ()
} else {
  match list_index(arms, i) {
    (pat, body) => {
      env_scope_enter()
      infer_pat(pat, scrut, span)
      infer_expr(body)
      match body {
        N(_, _, bh) => {
          unify(bh, result_h, span, MatchBranch(Inferred("arm body"), Inferred("result")))
          env_scope_exit()
          // Divide BETWEEN arms only — the affine ledger resets `used` to the
          // frame base so the next arm sees the pre-match scope, never the
          // prior arm's consumes.
          if i + 1 < n { branch_divider(span) }
          infer_match_arm_iter(arms, scrut, result_h, span, i + 1, n)
        },
      }
    },
  }
}

// Walk arms, gathering each PCon's tag_id (deduped via set_insert).
// Non-PCon arms (wildcards, vars, lits) contribute no tag. The seed's
// transfer is structural (the fold chain absorbs it) — an authored `own`
// here claimed a consume the callee's param product cannot see (fold's
// `f` is a param callee, product unreadable → the seed reads), and the
// grade now says so (§11 4.2's one wheel narration; band H's bar is
// fewer authored markers, not more).
fn collect_arm_tags(arms, init) = fold(
  init,
  (acc, arm) => match arm {
    (pat, _body) => collect_pat_tags(pat, acc),
  },
  arms
)

// An alternation covers the UNION of its branches — flatten. The counter
// was blind to PAlt: two H6-exhaustive alternation matches in voice read
// "misses 11 of 13" while covering every variant (the census's own find).
fn collect_pat_tags(pat, own acc) = match pat {
  PCon(name, _) => match env_lookup(name) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        ConstructorScheme(tag, _) => set_insert(acc, int_to_str(tag)),
        _ => acc,
      },
    },
    None => acc,
  },
  PAlt(branches) => fold(acc, (a, b) => collect_pat_tags(b, a), branches),
  _ => acc,
}

// Read total_variants from any one PCon arm's ConstructorScheme.
// All variants of a single declaring type carry the same total; the
// FIRST hit is sufficient. Returns 0 when no PCon arm is present
// (e.g., literal-only match) — the exhaustiveness check skips.
fn arms_total_variants(arms) = if len(arms) == 0 {
  0
} else {
  match last(arms) {
    (pat, _body) => match pat {
      PCon(name, _) => match env_lookup(name) {
        Some(entry) => match entry {
          (_, _, kind) => match kind {
            ConstructorScheme(_, total) => total,
            _ => arms_total_variants(drop_last(arms)),
          },
        },
        None => arms_total_variants(drop_last(arms)),
      },
      _ => arms_total_variants(drop_last(arms)),
    },
  }
}

// Wildcard detection: PWild or PVar at the top level catches
// everything the prior arms don't.
fn arms_have_wildcard(arms) = any(
  (arm) => match arm {
    (pat, _body) => pat_has_wildcard(pat),
  },
  arms
)

fn pat_has_wildcard(pat) = match pat {
  PWild => true,
  PVar(_) => true,
  PAlt(branches) => // A wildcard inside an alternation covers the remainder the same way.
  any(pat_has_wildcard, branches),
  _ => false,
}

// One arm under the typed-resume law (SYNTAX §Effect declarations).
// `op(args) => body` for `op : (P...) -> R` under handle-result S:
// args bind to the op's DECLARED params (the graph already knows
// them — fresh vars would discard that); resume reads (R, S) from
// arm context; the body's own value unifies with S — the arm's
// value IS the handle result, whether it resumes or aborts.
//
// drift-audit: ignore — result_h (arm result) and inst_h (effect instance) are distinct handles
fn infer_one_handler_arm(arm: {args: [String], body: Node, op_name: String}, result_h, inst_h) = {
  let arm_span = span_of_node(arm.body)
  let op_ret_ty = match env_lookup(arm.op_name) {
    Some(entry) => match entry {
      (scheme, _, _) => match instantiate(scheme) {
        TFun(params, ret_ty, op_row) => {
          // The op's instantiated payload (Iterate(a) ⇒ a) IS this handler's
          // P, so the arm param binds the var `~>` unifies with the body's
          // performed E. Payload flows performer→handler through P.
          unify_op_payload(op_row, inst_h, arm_span)
          bind_arm_args(arm.args, params, arm.op_name, arm_span)
          ret_ty
        },
        other => // An op registered without param structure IS its result type.
        other,
      },
    },
    None => {
      report(EMissingVariable("handler arm op: {arm.op_name}", arm_span))
      TVar(mint(Inferred("undeclared op result")))
    },
  }
  let continuation_h = mint(Inferred("handler arm continuation"))
  let continuation_disc = arm_disc_of(resume_grade(arm.body), op_ret_ty)
  graph_bind(
    continuation_h,
    TCont(op_ret_ty, TVar(result_h), continuation_disc, inf_current_world()),
    Located(arm_span, Inferred("handler arm continuation R -> S"))
  )
  inf_enter_arm(continuation_h)
  infer_expr(arm.body)
  inf_exit_arm()
  match arm.body {
    N(_, _, abh) => unify(abh, result_h, arm_span, Inferred("handler arm result")),
  }
}

// Arm params take the op's declared param types, positionally. An
// arity mismatch reports EHandlerArmArity FIRST; the aligned prefix
// still binds (productive-under-error).
fn bind_arm_args(args, params, op_name, span: ValidSpan) = {
  if len(args) != len(params) { report(EHandlerArmArity(op_name, len(params), len(args), span)) }
  each(
    (pair) => match pair {
      (name, param) => {
        let h = mint(Located(span, LetBinding(name, Declared(op_name))))
        graph_bind(h, param_ty(param), Located(span, Declared(op_name)))
        env_extend(name, Frozen([], TVar(h)), Located(span, LetBinding(name, Declared(op_name))), FnScheme)
      },
    },
    zip(args, params)
  )
}

// Unify a handler's payload var with the op's payload type carried in its
// (instantiated) row — Iterate(a) ⇒ unify a with P. This is the handler
// half of the payload flow; `~>` then unifies P with the body's E(performed).
// Bind the handler's instance var to the op's instance `TName(E, [args])`, read
// from the (instantiated) op row — so every arm of the handler shares ONE instance
// (yield/result share `element`; get()/set(v:s) share `s`) and `~>` unifies it
// per-position with the body's performed instance. Was: unify EACH arg to one
// payload_h, which crossed positions on a multi-payload effect (the result()->r
// element~result cycle). One instance, one unify; positions never cross.
fn unify_op_payload(op_row, inst_h, span: ValidSpan) = match op_instance_ty(op_row) {
  None => (),
  Some(inst) => {
    let ih = mint(Located(span, Inferred("op instance")))
    graph_bind(ih, inst, Located(span, Inferred("op instance")))
    unify(ih, inst_h, span, Inferred("effect instance to handler"))
  },
}

// The op's OWN instance `TName(E, [args])` from its single-effect row — the
// effect name is read LIVE from the row's EParameterized (Carried-Truth: the
// name is already there, never passed in), so `~>` unifies it per-position with
// the body's performed instance and every arm of the handler shares one instance.
fn op_instance_ty(row) = match row {
  EfRow(names, _, _) => op_instance_in_names(names),
  _ => None,
}

fn op_instance_in_names(names) = {
  let insts = flatten(map(
    (n) => match n {
      EParameterized(nm, args) => [TName(intern_name_of(nm), eparam_arg_tys(args))],
      ENamed(_) => [],
      EPure => [],
    },
    names
  ))
  if len(insts) == 0 { None } else { Some(last(insts)) }
}

// The effect's payload arity — the number of type positions in its instance
// (register_effect_ops' eff_vars). Read LIVE from its first op's row; 0 for a
// bare (unparameterized) effect. The handler exposes one fresh var per position
// so generalize quantifies each and every install freshens the whole instance.
fn effect_instance_arity(ename) = {
  let ops = match env_lookup(ename) {
    Some(entry) => match entry {
      (_, _, EffectDeclKind(o)) => o,
      _ => [],
    },
    None => [],
  }
  match ops {
    [] => 0,
    [op0, ..._] => match env_lookup(op0) {
      Some(oe) => match oe {
        (sch, _, _) => op_scheme_arity(sch),
      },
      None => 0,
    },
  }
}

fn op_scheme_arity(sch) = match judgment_ty(sch) {
  TFun(_, _, row) => match op_instance_ty(row) {
    Some(TName(_, args)) => len(args),
    _ => // drift-audit: ignore — a bare/non-instance row HAS arity 0; the read's honest answer, not a fabricated default
    0,
  },
  _ => // drift-audit: ignore — a non-fn scheme has no op instance; arity 0 is the honest answer
  0,
}

// n fresh instance vars for a handler's `Handler(E(v1..vn))` — one per the
// effect's payload position, exposed so generalize quantifies each.
fn mint_instance_vars(ename: String, n, i) = if i >= n {
  []
} else {
  [mint(Inferred("effect '{ename}' instance {i}"))] ++ mint_instance_vars(ename, n, i + 1)
}

// Generalization — Damas-Milner let-gen.
// Quantify handles that are free in the body but NOT free in env.
// CONDEMNED FORM (the resolved design D1/D2): in the terminal judgment
// generalize writes NOTHING — a parameter is the completion-bit read
// over the decl's planned band, and the stored Forall snapshot this fn
// mints is the disease the whole tower compensates for. Deletes at
// rung 3; takes no improvements until then (Anchor 2's condemned
// clause).
//
// H6: exhaustive NodeKind enumeration. Fabricated-value danger:
// a wildcard arm returning Frozen([], TVar(handle)) silently
// fabricates a monotype for every non-NBound kind — CLAUDE.md
// Session Zero names this as a dangerous wildcard. Each non-bound
// kind gets its own arm with the same fallback spelled out; if a
// new NodeKind is added, this function fails to compile until its
// generalization semantic is decided.
fn generalize_pair(handle) = {
  let node = graph_chase(handle)
  match node {
    GNode(kind, _) => match kind {
      NBound(ty) => {
        let body_ty = chase_deep(ty)
        // A fn quantifies its SIGNATURE's frees only — params and return
        // (D1's own sentence: instantiate mints fresh cells for exactly
        // the decl's parameter cells). A free cell reachable only through
        // the TOP row is never the decl's polymorphism: it is a LIVE LINK
        // (a co-member's cell, a forward decl's accumulator, an unbound
        // charge) that instantiation must SHARE, not freshen — freshening
        // severs it (the B1-revert's mechanism), and quantifying it
        // multiplies: each reference re-mints every quantified charge
        // copy, the copies stay free, the caller's exit re-quantifies
        // them — qvars(f) = Σ refs × qvars(callee), measured to the 4GB
        // guard inside instantiate on a 6,458-line lib blob (the
        // one-way-edge arc's prefix bisection). Effect polymorphism
        // survives whole: map's e occurs in its PARAM type, so the
        // signature collection carries every genuine poly var.
        // The row's own frees SPLIT by sort: an EAType payload var inside
        // an instance (Iterate's element) is TYPE-sort substitutable
        // polymorphism and must freshen per use — dropping it shared one
        // element cell across every caller (Float vs Int at the dsp
        // weave, the 286-class, measured the hour the bare-sig form
        // ran). Only ROW-sort cells reachable solely through the top row
        // stay unquantified-and-shared.
        match body_ty {
          TFun(dps, ret, frow) => (unique(free_in_params(dps) ++ free_in_ty(ret) ++ filter((h) => if is_row_handle(h) { false } else { true }, free_in_row(frow))), body_ty),
          TCont(input, answer, _, world) => // The continuation's world is a row POSITION exactly as a fn's
          // top row is (TCont carries an EffRow): its row-sort roots are
          // live links instantiation must SHARE, its EAType payload vars
          // are TYPE-sort polymorphism that freshens — the TFun arm's
          // split at the TIME altitude. H6: exhaustive Ty arms below —
          // the former wildcard quantified a continuation's world rows
          // and silently absorbed every future variant.
          (unique(free_in_ty(input) ++ free_in_ty(answer) ++ filter((h) => if is_row_handle(h) { false } else { true }, free_in_row(world))), body_ty),
          TInt => ([], body_ty),
          TFloat => ([], body_ty),
          TUnit => ([], body_ty),
          TByte => ([], body_ty),
          TVar(v) => ([v], body_ty),
          TList(_) => (free_in_ty(body_ty), body_ty),
          TTuple(_) => (free_in_ty(body_ty), body_ty),
          TName(_, _) => (free_in_ty(body_ty), body_ty),
          TRecord(_) => (free_in_ty(body_ty), body_ty),
          TRecordOpen(_, _) => (free_in_ty(body_ty), body_ty),
          TRefined(_, _) => (free_in_ty(body_ty), body_ty),
          TAlias(_, _) => (free_in_ty(body_ty), body_ty),
          TReprPin(_, _) => (free_in_ty(body_ty), body_ty),
        }
      },
      NFree(_) => // An unresolved publish QUANTIFIES its own cell: sharing the live cell
      // let every caller bind it (callers teaching the decl through the
      // publish — the order-conditional disease at the value boundary; under
      // the converged judge the decl learns only through its own re-judgment,
      // and the parallel fan's branches must never bind a shared cell). Each
      // instantiation freshens into its own band; the decl's cell stays the
      // decl's own verdict.
      ([handle], TVar(handle)),
      NRowBound(_) => // row handle — BOUND content; shared reads only
      ([], TVar(handle)),
      NRecordRowBound(_, _) => // record-row residual — bound; row sort
      ([], TVar(handle)),
      NRowFree(_) => // unresolved row — quantified like NFree; instantiate's row-sort mint freshens
      ([handle], TVar(handle)),
      NErrorHole(_) => // error — preserve handle for diagnostics
      ([], TVar(handle)),
    },
  }
}

// The cell→scheme projection: generalize_pair's verdict wrapped as the env's
// currency. Publishers freeze through it; instantiate clones through it.
fn generalize(handle) = match generalize_pair(handle) {
  (qs, ty) => Frozen(qs, ty),
}

// The one reader-side read of an env judgment: a frozen decl reads straight
// through; a live one rides the decl's own split rule at THIS read — the
// projection is never stored. A new posture arms here, not at every reader.
fn judgment_ty(b) = match b {
  Frozen(_, ty) => ty,
  Live(h) => match generalize_pair(h) {
    (_, ty) => ty,
  },
}

// The pair form, for readers that re-quantify or alpha-compare the set.
fn judgment_pair(b) = match b {
  Frozen(qs, ty) => (qs, ty),
  Live(h) => generalize_pair(h),
}

// H6: exhaustive Ty enumeration. Scalars terminate; aggregates
// recurse. Identity for unresolved TVars (when graph_chase lands
// on a non-NBound kind). A new Ty with embedded sub-types that
// could contain TVars would need its own recursive arm — fails
// to compile here until the decision is made.
// PRODUCTIVE-UNDER-ERROR at the read (the HANG law, CLAUDE.md ⟲): a graph
// CYCLE — however it got past the write guards — must project as a
// diagnostic, never a stack exhaustion. The depth bound is structural
// paranoia, not a semantics: no real resolved type nests 200 deep, so
// crossing it IS the cycle, reported once with the shape in hand.
fn chase_deep(ty) = chase_deep_at(ty, 0)

fn chase_probe_tag(ty) with Memory + Alloc = match ty {
  TVar(h) => "TVar({int_to_str(h)})",
  TFun(ps, _, _) => "TFun/{int_to_str(len(ps))}",
  TList(_) => "TList",
  TTuple(_) => "TTuple",
  TName(n, _) => "TName({n})",
  TRecord(_) => "TRecord",
  TRecordOpen(_, _) => "TRecordOpen",
  TRefined(_, _) => "TRefined",
  TCont(_, _, _, _) => "TCont",
  TAlias(n, _) => "TAlias({n})",
  TInt => "TInt",
  TFloat => "TFloat",
  TUnit => "TUnit",
  TByte => "TByte",
  TReprPin(_, _) => "TReprPin",
}

// The canonical snapshot SHARES every unchanged subtree (A.3 — the second
// unconditional reconstructor beside subst_ty, per the adversarial panel).
// CHECK-THEN-BUILD: a Bool change-walk (word returns — zero allocation)
// gates the eager build, and the build recurses through the sharing face,
// so every unchanged sub-subtree inside a changed parent re-shares. The
// first sharing form flag-threaded a tuple per arm return, and the
// artifact refuted it: tuples are heap records here, so the scalar arms
// minted garbage that canceled the sharing — a measured +6% on the
// self-compile. Unchanged subtrees now pay ONE pure walk and zero
// records; only the changed spine walks twice. Output SHAPE is exactly
// the eager walk's; sharing changes where records come from, never what
// they hold (Ty records are immutable values — the graph is the mutable
// layer).
fn chase_deep_at(ty, d) = if chase_changes(ty, d) { chase_deep_build(ty, d) } else { ty }

// Would the canonical snapshot differ from this record? An NBound var
// inlines its binding (always differs); a free var differs only when it
// canonicalizes off-root; aggregates OR their children (short-circuit —
// the first change decides). The depth tripwire answers TRUE so the build
// path runs and reports the cycle.
fn chase_changes(ty, d) = if d > 200 {
  true
} else {
  match ty {
    TInt => false,
    TFloat => false,
    TUnit => false,
    TByte => false,
    TVar(h) => match graph_chase(h) {
      GNode(kind, _) => match kind {
        NBound(_) => true,
        NFree(_) => graph_chase_handle(h) != h,
        NRowBound(_) => false,
        NRecordRowBound(_, _) => false,
        NRowFree(_) => false,
        NErrorHole(_) => false,
      },
    },
    TList(elem) => chase_changes(elem, d + 1),
    TTuple(elems) => chase_list_changes(elems, d + 1, 0, len(elems)),
    TFun(params, ret, eff) => chase_params_changes(params, d + 1, 0, len(params)) || chase_changes(ret, d + 1) || chase_row_changes(eff, d + 1),
    TName(_, args) => chase_list_changes(args, d + 1, 0, len(args)),
    TRecord(fields) => chase_fields_changes(fields, d + 1, 0, len(fields)),
    TRecordOpen(fields, _) => chase_fields_changes(fields, d + 1, 0, len(fields)),
    TRefined(base, _) => chase_changes(base, d + 1),
    TCont(input, answer, _, world) => chase_changes(input, d + 1) || chase_changes(answer, d + 1) || chase_row_changes(world, d + 1),
    TAlias(_, inner) => chase_changes(inner, d + 1),
    TReprPin(_, base) => chase_changes(base, d + 1),
  }
}

fn chase_list_changes(tys, d, i, n) = if i >= n {
  false
} else if chase_changes(list_index(tys, i), d) {
  true
} else {
  chase_list_changes(tys, d, i + 1, n)
}

fn chase_params_changes(params, d, i, n) = if i >= n {
  false
} else if chase_changes(param_ty(list_index(params, i)), d) {
  true
} else {
  chase_params_changes(params, d, i + 1, n)
}

fn chase_fields_changes(fields, d, i, n) = if i >= n {
  false
} else {
  match list_index(fields, i) {
    (_, ty) => if chase_changes(ty, d) { true } else { chase_fields_changes(fields, d, i + 1, n) },
  }
}

fn chase_row_changes(eff, d) = match eff {
  EfRow(p, a, t) => {
    // A BOUND edge is ALWAYS a change: the build folds the binding to its
    // VALUE (subst_row_changes' law at the chase face). Free edges stay —
    // generalize's NRowFree arm quantifies them.
    let tail_hit = match t {
      EtOpen(vs) => edges_any_bound(vs),
      _ => false,
    }
    tail_hit || chase_names_changes(p, d, 0, len(p)) || chase_names_changes(a, d, 0, len(a))
  },
}

// A BOUND edge is ALWAYS a change (folding IS the change — the build
// arm folds bindings by recursion, freshening nested frees at any
// depth; answering false shared whole chains, the window-8 race).
// Structural walk, the row walks' discipline.
fn edges_any_bound(ref vs: [Int]) = match vs {
  [] => false,
  [v, ...rest] => match graph_chase(v) {
    GNode(NRowBound(_), _) => true,
    _ => edges_any_bound(rest),
  },
}

fn chase_names_changes(names, d, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(names, i) {
    EParameterized(_, args) => chase_args_changes(args, d, 0, len(args)),
    ENamed(_) => false,
    EPure => false,
  }
  if hit { true } else { chase_names_changes(names, d, i + 1, n) }
}

fn chase_args_changes(args, d, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(args, i) {
    EAType(t2) => chase_changes(t2, d),
    _ => false,
  }
  if hit { true } else { chase_args_changes(args, d, i + 1, n) }
}

// The eager build — runs only under a proven change; children recurse
// through chase_deep_at, so unchanged subtrees re-share at every level.
fn chase_deep_build(ty, d) = if d > 200 {
  // Unreachable once the occurs guard recurses bindings (no cycle can enter
  // the graph); a firing here means a write path slipped the guard — the
  // tripwire names the shape without recursing it (show_type would spin).
  eprint_string("mentl: chase_deep depth tripwire — cyclic graph at {chase_probe_tag(ty)}\n")
  ty
} else {
  match ty {
    TInt => ty,
    TFloat => ty,
    TUnit => ty,
    TByte => ty,
    TVar(h) => match graph_chase(h) {
      GNode(kind, _) => match kind {
        NBound(inner) => chase_deep_at(inner, d + 1),
        NFree(_) => // A free var canonicalizes to its union-find ROOT, never the surface
        // alias: a scheme snapshot holding two aliases of ONE class quantifies
        // both, and instantiate then freshens them separately — the class
        // SPLITS at every use (fold_handler's acc/init/instance-r measured as
        // one live root 12914 yet stored as t12917 vs t12914 vs t12913, so
        // every fold/map/filter caller rode an element-orphaned scheme — the
        // subscript-fracture law at the generalize/instantiate layer).
        TVar(graph_chase_handle(h)),
        NRowBound(_) => // row handle used as Ty — stays
        ty,
        NRecordRowBound(_, _) => // record-row residual — row sort; stays
        ty,
        NRowFree(_) => // unresolved row handle — stays
        ty,
        NErrorHole(_) => // error node — preserve TVar for diagnostics
        ty,
      },
    },
    TList(elem) => TList(chase_deep_at(elem, d + 1)),
    TTuple(elems) => TTuple(map_chase_ty(elems, d + 1)),
    TFun(params, ret, eff) => // The ROW canonicalizes with the type: an EParameterized instance's
    // EAType vars are the row's substitutable payload (free_in_row and
    // subst_row both descend them), so a snapshot that skipped the row kept
    // SURFACE aliases there while the type side stored roots — the same
    // class-split at the row layer (fold's xs-element never reached f's elem
    // through iterate's published instance). The three vars-of-a-type walks
    // must agree over rows (the occurs-law trio); the snapshot now feeds all
    // three the same canonical form.
    TFun(chase_params(params, d + 1), chase_deep_at(ret, d + 1), chase_row_deep(eff, d + 1)),
    TName(name, args) => TName(name, map_chase_ty(args, d + 1)),
    TRecord(fields) => TRecord(chase_fields(fields, d + 1)),
    TRecordOpen(fields, v) => mk_record_open(chase_fields(fields, d + 1), v),
    TRefined(base, pred) => TRefined(chase_deep_at(base, d + 1), pred),
    TCont(input, answer, disc, world) => TCont(chase_deep_at(input, d + 1), chase_deep_at(answer, d + 1), disc, chase_row_deep(world, d + 1)),
    TAlias(name, inner) => TAlias(name, chase_deep_at(inner, d + 1)),
    TReprPin(r, base) => TReprPin(r, chase_deep_at(base, d + 1)),
  }
}

// An unchanged row IS its own canonical form (rows are canonical at
// birth), so the sharing face returns it whole.
fn chase_row_deep(eff, d) = if chase_row_changes(eff, d) {
  match eff {
    EfRow(p, a, t) => {
      let p2 = chase_eff_names(p, d)
      let a2 = chase_eff_names(a, d)
      // THE VALUE BOUNDARY AT THE CHASE FACE (the bind census's verdict:
      // a declared fn's BOUND row cell rode EtVar through generalize's
      // chase into its published scheme — a live pointer into the decl's
      // band that concurrent callers folded mid-flight, the six-battery's
      // 5-1 split on driver_extract_imports' cell). A bound tail folds to
      // its VALUE by recursion, exactly as subst_row_build's arm, under
      // resolve_row's read law: the inner present joins MINUS this
      // face's absent — the pending `~>` subtraction filters what the
      // tail delivers (an unfiltered union hands ef_make a present∩absent
      // collision and canonicalization deletes the ABSENT: the mask
      // INVERTS — measured as GraphRead/Intern surviving infer_context's
      // bracket into every verb run's published row). A published scheme
      // is then a value or a quantified var, never a live pointer.
      match t {
        EtOpen(vs) => match chase_edges_deep(vs, (p2, a2, [], false), d) {
          (rp, ra, res, saw_all) => if saw_all { ef_make(rp, ra, EtAll) } else { ef_make(rp, ra, EtOpen(res)) },
        },
        _ => ef_make(p2, a2, t),
      }
    },
  }
} else {
  eff
}

// The chase-face edge walk, structural (the row walks stay off the
// Iterate vocabulary): a bound edge folds its DEEP value through the
// shared assembly (edge_content_into — the same reading-law joins
// resolve rides); a free edge survives into the residual set.
fn chase_edges_deep(ref vs: [Int], acc, d) = match vs {
  [] => acc,
  [v, ...rest] => match acc {
    (p, a, res, saw_all) => {
      let next = match graph_chase(v) {
        GNode(kind, _) => match edge_row_of(kind) {
          Some(inner) => match edge_content_into(p, a, res, saw_all, chase_row_deep(inner, d + 1)) {
            (p2, a2, r2, s2, _) => (p2, a2, r2, s2),
          },
          None => (p, a, tail_set_insert(res, v), saw_all),
        },
      }
      chase_edges_deep(rest, next, d)
    },
  },
}

fn chase_eff_names(names, d) = map(
  (e) => match e {
    EParameterized(n, args) => EParameterized(
      n,
      map(
        (ea) => match ea {
          EAType(t2) => EAType(chase_deep_at(t2, d)),
          other => other,
        },
        args
      )
    ),
    other => other,
  },
  names
)

fn map_chase_ty(tys, d) = map((t) => chase_deep_at(t, d), tys)

fn chase_params(params, d) = map((p) => param_with_ty(p, chase_deep_at(param_ty(p), d)), params)

fn chase_fields(fields, d) = map(
  (fld) => match fld {
    (name, ty) => (name, chase_deep_at(ty, d)),
  },
  fields
)

// H6: exhaustive Ty enumeration. Scalars have no free handles;
// aggregates recurse; TVar IS a free handle; TRecordOpen's row
// var is free. A new Ty containing TVars would need its own arm —
// `_ => []` would silently miss them.
fn free_in_ty(ty) = match ty {
  TInt => [],
  TFloat => [],
  TUnit => [],
  TByte => [],
  TVar(id) => [id],
  TList(elem) => free_in_ty(elem),
  TTuple(elems) => free_in_list(elems),
  TFun(params, ret, eff) => free_in_params(params) ++ free_in_ty(ret) ++ free_in_row(eff),
  TName(_, args) => free_in_list(args),
  TRecord(fields) => free_in_fields(fields),
  TRecordOpen(fields, v) => free_in_record_row(v) ++ free_in_fields(fields),
  TRefined(base, _) => free_in_ty(base),
  TCont(input, answer, _, world) => free_in_ty(input) ++ free_in_ty(answer) ++ free_in_row(world),
  TAlias(_, inner) => free_in_ty(inner),
  TReprPin(_, base) => free_in_ty(base),
}

// A record row's free variable is what its residual still leaves unknown —
// the identical rule free_in_row states for an effect row six lines below,
// which this sort never applied. Collecting the cell unconditionally called
// a BOUND row free, so generalize quantified a proven residual and
// instantiate minted a fresh empty one in its place: measured on
// mn-findtag, the annotation closed row 24730 and the field access read
// 24736, six cells later, with the offset unprovable in between. The proof
// was severed by the collector, not lost by the unifier.
//
// A cell that is neither free nor a record row contributes no record-row
// frees. That is a true reading, not a floor.
fn free_in_record_row(v) = {
  let r = graph_chase_handle(v)
  if row_var_is_free(r) {
    [r]
  } else {
    match graph_chase(r) {
      GNode(NRecordRowBound(residual, tail), _) => free_in_fields(residual) ++ free_in_record_tail(tail),
      GNode(NBound(TRecordOpen(more, v2)), _) => free_in_fields(more) ++ free_in_record_row(v2),
      GNode(NBound(TRecord(more)), _) => free_in_fields(more),
      _ => [],
    }
  }
}

fn free_in_record_tail(tail) = match tail {
  RowClosed => [],
  RowAssumed => [],
  RowContinues(next) => free_in_record_row(next),
}

fn free_in_list(tys) = tys |> map(free_in_ty) |> flatten

fn free_in_params(params) = params |> map((p) => free_in_ty(param_ty(p))) |> flatten

fn free_in_fields(fields) = fields |> map((fld) => match fld {
  (_, ty) => free_in_ty(ty),
}) |> flatten

// A row's free variable is its open tail — the same first-class graph
// node a type variable is. Effect-polymorphism IS value-polymorphism over
// the row domain; the row var is quantified exactly like a TVar. Collect
// the tail ONLY when it is genuinely free (NRowFree): a tail already bound
// to a concrete row is not a free var, and quantifying it would re-freshen
// a monomorphic fn's row at every call site. chase_deep leaves the row
// verbatim, so the freeness check happens here (the row mirror of how
// chase_deep resolves bound TVars before free_in_ty collects the free ones).
fn free_in_row(eff) = match eff {
  EfRow(p, a, t) => // ONE triple walk: a parameterized effect carries its op-payload TYPE
  // (Iterate(a)) on either field; the payload's free vars are the row's
  // free vars, and a free TAIL root joins them — generalize quantifies,
  // instantiate freshens (effect-polymorphism as HM over the row sort).
  {
    let tail = match t {
      EtOpen(vs) => free_in_edges(vs),
      _ => [],
    }
    free_in_eff_names(p) ++ free_in_eff_names(a) ++ tail
  },
}

// The edge collection, structural: a free edge contributes its chased
// root; a BOUND edge is not itself a var — but subst_row's merge arm
// traverses INTO its binding (the closed-tail instance merge), so
// collection must reach the same leaves: the inner row's payload vars
// are this row's free vars (the trio law — free/occurs/subst agree
// over rows, here through every edge's binding).
fn free_in_edges(ref vs: [Int]) = match vs {
  [] => [],
  [v, ...rest] => {
    let r = graph_chase_handle(v)
    let here = if row_var_is_free(r) {
      [r]
    } else {
      match graph_chase(r) {
        GNode(kind, _) => match edge_row_of(kind) {
          Some(inner) => free_in_row(inner),
          None => [],
        },
      }
    }
    here ++ free_in_edges(rest)
  },
}

// The free type vars inside an effect-row's parameterized payloads
// (Iterate(a) ⇒ a's free vars). Bare ENamed effects carry none.
fn free_in_eff_names(names) = names |> map((n) => match n {
  ENamed(_) => [],
  EPure => // the identity carries no free vars
  [],
  EParameterized(_, args) => args |> map(free_in_eff_arg) |> flatten,
}) |> flatten

fn free_in_eff_arg(arg) = match arg {
  EAInt(_) => [],
  EAFloat(_) => [],
  EAString(_) => [],
  EAType(ty) => free_in_ty(ty),
  EANode(_) => // an opaque operand-node handle, not an
  // embedded Ty — carries no free type vars
  [],
  EAEffect(_) => // interned identities — no embedded Ty, no free vars
  [],
  EACon(_) => [],
}

// The decl's signature frees, read at exit time THROUGH the live cells —
// params + return deep-chased, so a HOF parameter's row var (minted by the
// body's own call site, above the prereg ceiling) is collected from the
// cell the body actually bound, never from a declared-slot snapshot. The
// completion prune keeps these roots: a free edge the signature reaches
// escapes through instantiate at every call site (generalize's signature
// collection quantifies exactly these), so the prune's "no constraint can
// arrive" reading is false for them.
fn signature_free_roots(cells) =
  cells |> map((c) => free_in_ty(chase_deep(TVar(c)))) |> flatten |> unique

fn row_var_is_free(v) = match graph_chase(v) {
  GNode(NRowFree(_), _) => true,
  GNode(NFree(_), _) => // A free node in ROW POSITION is a free row var regardless of its
  // mint sort: the loose pre-registration and parse_type_ty mint
  // function-type row vars as TYPE handles (NFree, reason e0 — the
  // named parser residue), and a sort-blind freeness check made those
  // tails INVISIBLE to collection while subst_row's catch-all SHARED
  // them — every caller of an effect-polymorphic scheme then chained
  // one live row (measured: infer_context's stored scheme mutating
  // between its callers' reads; the E_EffectMismatch quartet). The
  // three walks agree by tolerating the sort at the same leaf.
  true,
  _ => false,
}

// Instantiation — one function, two handlers.
// inference handler: `mint(r) => resume(perform graph_fresh_ty(r))`
// query handler:     `mint(r) => resume(next_display_id(r))`
// Same function; different semantics via handler swap.
// CONDEMNED FORM (the resolved design D1/D5): terminal instantiation
// mints fresh cells for the decl's parameter cells and draws one
// one-way CORRESPONDENCE EDGE per pair — teaching then propagates
// decl→site as joins, and the clone-the-type walk deletes.
fn instantiate(scheme) = match scheme {
  Frozen(qs, ty) => if len(qs) == 0 {
    ty
  } else {
    let mapping = build_inst_mapping(qs)
    subst_ty(ty, mapping)
  },
  Live(h) => // A judgment-published decl: the quantifier is a projection the caller
  // runs — generalize's split rule reads the LIVE cell at this moment of
  // consumption (never a stored materialization), and the clone rides the
  // mapped spine as before.
  instantiate(generalize(h)),
}

// A quantified var's domain is carried in the graph — NRowFree means a row
// variable, minted fresh as a row (graph_fresh_row); NFree means a type
// variable (graph_fresh_ty). The mint/mint_row op split mirrors
// graph_fresh_ty/graph_fresh_row and keeps the handler swap total (query
// renders both as display ids). Read the domain live; never re-derive it.
fn build_inst_mapping(qs) = map(
  (old) => {
    // Key by the union-find ROOT, matching subst_ty's root-keyed lookup: a
    // quantified var aliased after generalize still freshens (read the root,
    // carry the whole instance).
    let root = graph_chase_handle(old)
    let fresh = if is_row_handle(root) {
      mint_row(Instantiation("inst", Fresh(root)))
    } else {
      mint(Instantiation("inst", Fresh(root)))
    }
    (root, fresh)
  },
  qs
)

fn is_row_handle(h) = match graph_chase(h) {
  GNode(NRowFree(_), _) => true,
  GNode(NRowBound(_), _) => true,
  GNode(NRecordRowBound(_, _), _) => true,
  _ => false,
}

// H6: exhaustive Ty enumeration. Scalars pass through; aggregates recurse.
// Substitution is identity for unresolved sites where mapping doesn't have
// the handle — and identity SHARES (A.3: instantiate shares, never clones).
// CHECK-THEN-BUILD, the chase_deep_at shape: subst_changes is the Bool
// change-walk (word returns — zero allocation), and the eager build
// recurses through this sharing face so unchanged sub-subtrees re-share.
// A polymorphic reference's clone volume collapses to the mapped spine.
fn subst_ty(ty, mapping) = if subst_changes(ty, mapping) { subst_ty_build(ty, mapping) } else { ty }

// Would substitution differ from this record? An NBound var inlines its
// binding (always differs); a free var differs only when the mapping
// carries its root; aggregates OR their children (short-circuit).
fn subst_changes(ty, mapping) = match ty {
  TInt => false,
  TFloat => false,
  TUnit => false,
  TByte => false,
  // THE CHECK CHASES, SO THE BUILD CAN SHARE. This answered TRUE for every
  // bound var — "an NBound var inlines its binding (always differs)" — and
  // in a JUDGED decl most vars are bound, so check-then-build was here but
  // never got to answer no: every polymorphic reference rebuilt the callee's
  // whole type tree. That is Hβ.infer.instantiate-shares-never-clones, whose
  // cost the docs place on the ALLOCATION channel rather than time.
  // Following the edge and asking whether the CONTENT changes is the same
  // question asked where the answer lives: a bound cell holding no mapped
  // var answers false and its entire subtree SHARES; only a path that
  // actually reaches a quantified var rebuilds, and it rebuilds exactly as
  // before. Privacy is untouched — the mapping still decides first, so a
  // quantified var freshens per use.
  // Answering by the mapping ALONE is the opposite error and was measured on
  // the way here: a quantified var sitting BEHIND a binding goes unseen,
  // never freshens, and polymorphism severs silently.
  // Termination is the occurs invariant's — graph_bind refuses a type cell
  // containing itself; the row sort's benign self-loops go through
  // subst_row_changes, not this walk.
  TVar(id) => if find_mapping(mapping, graph_chase_handle(id)) >= 0 {
    true
  } else {
    match graph_chase(id) {
      GNode(NBound(inner), _) => subst_changes(inner, mapping),
      _ => false,
    }
  },
  TList(elem) => subst_changes(elem, mapping),
  TTuple(elems) => subst_list_changes(elems, mapping, 0, len(elems)),
  TFun(params, ret, eff) => subst_params_changes(params, mapping, 0, len(params)) || subst_changes(ret, mapping) || subst_row_changes(eff, mapping),
  TName(_, args) => subst_list_changes(args, mapping, 0, len(args)),
  TRecord(fields) => subst_fields_changes(fields, mapping, 0, len(fields)),
  TRecordOpen(fields, v) => // Mapping-first, matching the build: a quantified rest freshens even
  // when since-bound, so any hit IS a change.
  find_mapping(mapping, graph_chase_handle(v)) >= 0 || subst_fields_changes(fields, mapping, 0, len(fields)),
  TRefined(base, _) => subst_changes(base, mapping),
  TCont(input, answer, _, world) => subst_changes(input, mapping) || subst_changes(answer, mapping) || subst_row_changes(world, mapping),
  TAlias(_, inner) => subst_changes(inner, mapping),
  TReprPin(_, base) => subst_changes(base, mapping),
}

fn subst_list_changes(tys, mapping, i, n) = if i >= n {
  false
} else if subst_changes(list_index(tys, i), mapping) {
  true
} else {
  subst_list_changes(tys, mapping, i + 1, n)
}

fn subst_params_changes(params, mapping, i, n) = if i >= n {
  false
} else if subst_changes(param_ty(list_index(params, i)), mapping) {
  true
} else {
  subst_params_changes(params, mapping, i + 1, n)
}

fn subst_fields_changes(fields, mapping, i, n) = if i >= n {
  false
} else {
  match list_index(fields, i) {
    (_, ty) => if subst_changes(ty, mapping) { true } else { subst_fields_changes(fields, mapping, i + 1, n) },
  }
}

// The row's change test mirrors subst_row's arms exactly: a merge with a
// solved bound row always rebuilds; a mapped tail always rebuilds; else
// only a changed EParameterized payload does.
fn subst_row_changes(eff, mapping) = match eff {
  EfRow(ns, ab, t) => {
    let tail_hit = match t {
      EtOpen(vs) => subst_edges_changed(vs, mapping),
      _ => false,
    }
    tail_hit || subst_names_changes(ns, mapping, 0, len(ns)) || subst_names_changes(ab, mapping, 0, len(ab))
  },
}

// The subst change test per edge, structural: a bound edge ALWAYS
// rebuilds (folding IS the change — the one-level t2 check let a
// two-deep chain's free terminal ride into every caller, the window-8
// first-binder race); a free edge of either sort (row_var_is_free's
// T-handle tolerance) changes exactly on a mapping hit.
fn subst_edges_changed(ref vs: [Int], mapping) = match vs {
  [] => false,
  [v, ...rest] => {
    let hit = match graph_chase(v) {
      GNode(NRowBound(_), _) => true,
      GNode(NRowFree(_), _) => find_mapping(mapping, graph_chase_handle(v)) >= 0,
      GNode(NFree(_), _) => find_mapping(mapping, graph_chase_handle(v)) >= 0,
      _ => false,
    }
    if hit { true } else { subst_edges_changed(rest, mapping) }
  },
}

fn subst_names_changes(names, mapping, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(names, i) {
    EParameterized(_, args) => subst_args_changes(args, mapping, 0, len(args)),
    ENamed(_) => false,
    EPure => false,
  }
  if hit { true } else { subst_names_changes(names, mapping, i + 1, n) }
}

fn subst_args_changes(args, mapping, i, n) = if i >= n {
  false
} else {
  let hit = match list_index(args, i) {
    EAType(ty) => subst_changes(ty, mapping),
    _ => false,
  }
  if hit { true } else { subst_args_changes(args, mapping, i + 1, n) }
}

// The eager build — runs only under a proven change; children recurse
// through subst_ty, so unchanged subtrees re-share at every level.
// CONDEMNED FORM (the resolved design D1): substitution IS the
// union-find chase; both subst builds delete with the scheme snapshot
// they serve.
fn subst_ty_build(ty, mapping) = match ty {
  TInt => ty,
  TFloat => ty,
  TUnit => ty,
  TByte => ty,
  TVar(id) => {
    // THE FROZEN READ — the mapping decides BEFORE any live chase. A var in
    // the mapping was free at the freeze, so whatever bound it since is
    // post-freeze teaching (another caller's private constraint under the
    // parallel fan) — it freshens, never reads through (Carried-Truth at the
    // scheme boundary: the freeze exists so readers never read live). Only a
    // MISS chases: a var deliberately unquantified — the handler
    // config↔payload two-phase case (config vars are not in the handler
    // scheme's q, so the arm-walk's later binding legitimately resolves
    // here), monomorphic self-entries, and pre-freeze-bound structure. The
    // root-keyed lookup keeps aliased qvars freshening.
    let replacement = find_mapping(mapping, graph_chase_handle(id))
    if replacement >= 0 {
      TVar(replacement)
    } else {
      match graph_chase(id) {
        GNode(NBound(inner), _) => subst_ty(inner, mapping),
        _ => ty,
      }
    }
  },
  TList(elem) => TList(subst_ty(elem, mapping)),
  TTuple(elems) => TTuple(subst_list(elems, mapping)),
  TFun(params, ret, eff) => TFun(subst_params(params, mapping), subst_ty(ret, mapping), subst_row(eff, mapping)),
  TName(name, args) => TName(name, subst_list(args, mapping)),
  TRecord(fields) => TRecord(subst_fields(fields, mapping)),
  TRecordOpen(fields, v) => {
    // Freshen the open tail, mirroring subst_row's edge walk: free_in_ty COLLECTS
    // v (TRecordOpen ⇒ [v] ++ fields), so generalize quantifies it and
    // instantiate MUST freshen it. Dropping v here shared the SAME row tail
    // across every instantiation of an open-record scheme — a proven let-poly
    // asymmetry (generalize quantifies v; instantiate must not strand it).
    // Carried-Truth: the free_in_ty ↔ subst_ty symmetry was broken at this arm.
    let fields2 = subst_fields(fields, mapping)
    // The frozen read at the record-row sort: mapping first (a quantified
    // rest freshens regardless of later binding), the miss shares (bound
    // residuals are pre-freeze truth; unquantified frees are deliberate).
    let r = find_mapping(mapping, graph_chase_handle(v))
    if r >= 0 { mk_record_open(fields2, r) } else { mk_record_open(fields2, v) }
  },
  TRefined(base, pred) => TRefined(subst_ty(base, mapping), pred),
  TCont(input, answer, disc, world) => TCont(
    subst_ty(input, mapping),
    subst_ty(answer, mapping),
    disc,
    // world is a row: freshen its row-var like TFun's eff (free_in/subst symmetry)
    subst_row(world, mapping)
  ),
  TAlias(name, inner) => TAlias(name, subst_ty(inner, mapping)),
  TReprPin(r, base) => TReprPin(r, subst_ty(base, mapping)),
}

fn subst_list(tys, mapping) = map((t) => subst_ty(t, mapping), tys)

fn subst_params(params, mapping) =
  map((p) => param_with_ty(p, subst_ty(param_ty(p), mapping)), params)

fn subst_fields(fields, mapping) = map(
  (fld) => match fld {
    (name, ty) => (name, subst_ty(ty, mapping)),
  },
  fields
)

// Substitution over the row domain — the open tail var is replaced by its
// fresh instance from the same mapping subst_ty reads. Row handles and type
// handles are disjoint graph nodes, so the shared mapping never collides:
// an open tail only ever matches a row entry, a TVar only a type entry.
// An unchanged row IS its own canonical form (canonical at birth), so the
// sharing face returns it whole.
fn subst_row(eff, mapping) =
  if subst_row_changes(eff, mapping) { subst_row_build(eff, mapping) } else { eff }

// The triple, freshened: parameterized payload TYPES substitute on both
// fields (each op USE a fresh effect instance); each open EDGE resolves
// live and substitutes its quantified ROOT, carrying the concrete
// effects the edge performs (dropping them loses the evidence a caller
// must thread — Carried-Truth). CONDEMNED FORM (the resolved design
// D1): deletes with subst_ty_build when schemes are live cells.
fn subst_row_build(eff, mapping) = match eff {
  EfRow(ns, ab, t) => {
    let ns2 = subst_eff_names(ns, mapping)
    let ab2 = subst_eff_names(ab, mapping)
    match t {
      EtOpen(vs) => match subst_edges_build(vs, (ns2, ab2, [], false), mapping) {
        (rp, ra, res, saw_all) => if saw_all { ef_make(rp, ra, EtAll) } else { ef_make(rp, ra, EtOpen(res)) },
      },
      _ => ef_make(ns2, ab2, t),
    }
  },
}

// The subst edge walk, structural (off the Iterate vocabulary).
fn subst_edges_build(ref vs: [Int], acc, mapping) = match vs {
  [] => acc,
  [v, ...rest] => subst_edges_build(rest, subst_edge_build_into(acc, v, mapping), mapping),
}

// THE FROZEN READ at the row sort, per EDGE — the mapping decides BEFORE
// any live chase (the TVar arm's law, one sort over): a quantified edge
// was free at the freeze, so a later binding is another caller's
// post-freeze teaching and must freshen — the fresh edge joins the
// residual. Only a MISS chases: pre-freeze-bound chains fold by
// RECURSION through the shared assembly (descending exactly as deep as
// free_in_row's collection — the trio law; the one-level form shared
// two-deep chains, the measured window-8 first-binder race on
// handle_to_smt's cell), and a genuinely unquantified free edge (either
// sort — row_var_is_free's tolerance; the mono self-entry and two-phase
// registration shapes) SHARES into the residual.
fn subst_edge_build_into(acc, v, mapping) = match acc {
  (p, a, res, saw_all) => {
    let r0 = find_mapping(mapping, graph_chase_handle(v))
    if r0 >= 0 {
      (p, a, push(res, r0), saw_all)
    } else {
      match graph_chase(v) {
        GNode(kind, _) => match edge_row_of(kind) {
          Some(inner) => match edge_content_into(p, a, res, saw_all, subst_row_build(inner, mapping)) {
            (p2, a2, r2, s2, _) => (p2, a2, r2, s2),
          },
          None => (p, a, tail_set_insert(res, v), saw_all),
        },
      }
    }
  },
}

// Substitute parameterized payload types through an effect-name list
// (the row mirror of subst_ty over the row's carried types).
fn subst_eff_names(names, mapping) = map(
  (n) => match n {
    EParameterized(s, args) => // ONLY EParameterized carries substitutable payload TYPES (Iterate(a) ⇒
    // Iterate(fresh)) — reconstruct it with the fresh args.
    EParameterized(
      s,
      map(
        (arg) => match arg {
          EAType(ty) => EAType(subst_ty(ty, mapping)),
          _ => arg,
        },
        args
      )
    ),
    ENamed(_) => // ENamed and EPure carry NOTHING to substitute — carry the live value,
    // never re-derive it (nothing-drops; carrying the value sidesteps the copy).
    n,
    EPure => n,
  },
  names
)

// The mapping probe — a direct walk, no per-leaf filter materialization
// (the filter allocated a hits list at every TVar leaf of every
// instantiation; the walk allocates nothing).
fn find_mapping(mapping, id) = find_mapping_from(mapping, id, 0, len(mapping))

fn find_mapping_from(mapping, id, i, n) = if i >= n {
  -1
} else {
  match list_index(mapping, i) {
    (old, fresh) => if old == id { fresh } else { find_mapping_from(mapping, id, i + 1, n) },
  }
}

// Registration — ADT constructors, effect ops, handlers
fn mint_param_placeholders(params, owner_name) = map(
  (indexed) => match indexed {
    (idx, _) => mint(FnParam(owner_name, idx, Inferred("param of '{owner_name}'"))),
  },
  enumerate(params)
)

fn mint_params(params, owner_name) = map(
  (indexed) => match indexed {
    (idx, p) => {
      let name = param_name(p)
      let h = mint(FnParam(owner_name, idx, Inferred("param of '{owner_name}'")))
      // Mint the handle and bind the NAME to it in the body env; the handle's TYPE
      // (the shared identity for a type-param, the pinned Intent Boundary for a
      // concrete annotation) is bound ONCE by build_param_types, read live here —
      // never re-derived per consumer. A body read through the env's TVar(h) then
      // chases to the resolved param type (the eq/binop/++ dispatch, the emit width).
      env_extend(name, Frozen([], TVar(h)), Declared(name), ParamScheme(param_authored(p)))
      h
    },
  },
  enumerate(params)
)

// build_param_types — resolve a signature's params to ONE shared identity each,
// binding the param HANDLE to that identity so the body read (the handle's
// bound TVar) and the generalized scheme share one node (Carried-Truth).
// Threads ONE qmap across the whole signature, so the case rule (lowercase TName
// leaf → a shared quantified TVar, via quantify_ctor_ty's TFun/TList recursion)
// makes `init: b` and the `b` inside `f: (b,a) -> b` the SAME var — `fold`'s
// accumulator propagates. A concrete annotation (`name: String`, a refinement,
// a repr pin) binds the handle too (the Intent Boundary read live). An
// unannotated param is a bare TVar; its handle IS its fresh var (quantified).
// Without the shared conversion a lowercase TName is a RIGID nominal that
// mismatches every concrete arg (recovered, word-floored) — the pureElem class.
fn build_param_types(params, handles) = match build_param_types_loop(params, handles, [], 0) {
  (tys, _qmap) => tys,
}

fn build_param_types_loop(params, handles, qmap, i) = if i >= len(params) {
  ([], qmap)
} else {
  match list_index(params, i) {
    TParam(name, declared, auth, res, default) => {
      let h = list_index(handles, i)
      match match declared {
        TVar(_) => (TVar(h), qmap),
        _ => match quantify_ctor_ty(declared, qmap) {
          (conv, q) => {
            graph_bind(h, conv, Located(span_zero(), Declared(name)))
            (conv, q)
          },
        },
      } {
        (chosen, qmap1) => match build_param_types_loop(params, handles, qmap1, i + 1) {
          (rest, qmap2) => ([TParam(name, chosen, auth, res, default)] ++ rest, qmap2),
        },
      }
    },
  }
}

// Apply a let-binding's `: T` annotation as a refinement constraint on the
// value node. The value's node HANDLE is live here (unlike the generic TRefined
// arm of unify_types, which carries only the predicate + span), so subst_self
// binds `self` to the value and Verify decides the predicate on the literal —
// `let bad: Sample = 1.5` rejects, `let ok: Sample = 0.5` compiles; a
// non-constant value stays V_Pending (node_const → None). Resolve the annotation
// through its alias edge (quantify_ctor_ty — the same resolution build_param_types
// uses), then discharge the refinement.
fn apply_let_annotation(ann_ty, value_handle, span: ValidSpan) = match quantify_ctor_ty(ann_ty, []) {
  (resolved, _q) => {
    // Constraint FIRST — the refinement reads the value's class before the
    // adopting unify below enters the annotation into it (the flow licence's
    // uncontaminated-read order, the return site's landed twin).
    apply_refinement_constraint(resolved, value_handle, span)
    // THEN the base unify: the annotation is a real CONSTRAINT, not
    // decoration — `let x: Int = "hi"` refused here (measured passing clean
    // before this edge existed).
    unify_types(TVar(value_handle), resolved, span, Inferred("let annotation pins the value"))
    // THE CLASS EXPOSES ITS MOST-REFINED MEMBER (the decl pin's rebind, at
    // the let): a CONCRETE-bound value cell cannot adopt through the unify
    // (concrete-meets-refined checks the base and binds nothing), so an
    // annotated alias never reached any consumer edge — the lexer's
    // ValidOffset arg starved on exactly this absence. Rebind the refined
    // form as the representative; plain annotations skip (nothing refined
    // to expose).
    match resolved {
      TAlias(_, _) => graph_bind(value_handle, resolved, Located(span, Inferred("let annotation pins the value"))),
      TRefined(_, _) => graph_bind(value_handle, resolved, Located(span, Inferred("let annotation pins the value"))),
      _ => (),
    }
  },
}

// Peel the resolved annotation to its refinement. A transparent alias recurses
// to its inner type; a TRefined discharges its (self-substituted) predicate
// against the value node; any other resolved type carries no refinement
// obligation here (base-type unification lives at the CALLERS — the let's
// adopting unify in apply_let_annotation, the return's ann pin — so this
// projection stays purely the refinement's discharge).
fn apply_refinement_constraint(ty, value_handle, span: ValidSpan) = match ty {
  TAlias(aname, inner) => // TYPED IDENTITY (refinement_admits' layering, at the accrual): a value
  // whose inferred type IS the same refined alias carries that alias's
  // obligation at its OWN first-claim site (the let / ret / arg that
  // minted it) — discharged, pending, or refuted THERE. Accruing again
  // per consumer echoes one claim N times up the chain (a fixture with
  // one honest claim surfaced five pendings); the ledger owns each proof
  // question at one home, so the echo accrues nothing. The licence is
  // value_flows_class: a COMPUTATION node's class membership is a
  // theorem, never a flow — it raises (the laundered `v - 1` runtime -1).
  if value_flows_class(value_handle) && inferred_alias_name(value_handle) == aname {
    ()
  } else {
    apply_refinement_constraint(inner, value_handle, span)
  },
  TRefined(_, pred) => verify(span, subst_self(pred, value_handle), Refinement(pred, PTrue)),
  _ => (),
}

fn build_inferred_params(handles) = map((h) => mk_param("_", TVar(h)), handles)

fn register_type_constructors(type_name, variants) = {
  let total = len(variants)
  // ONE quantification map per DECL (HM: every ctor of a type
  // quantifies the type's full parameter set — None : Option(a)
  // too). Lowercase TName leaves ARE the parameters: the case rule
  // IS the declaration; no angle-bracket list exists to keep in sync.
  match quantify_variants(variants, make_list(total), 0, total, []) {
    (converted, qmap) => {
      // result_ty's argument list is the TYPE parameters only (the type is applied
      // as `TName(type_name, [params])`); a function-field's quantified ROW var is
      // in qmap for the Forall but is NOT a type parameter, so filter it out by
      // node-kind (is_row_handle). qhandles keeps ALL — params AND row vars — so
      // every ctor scheme quantifies (and instantiate freshens) the stored-function
      // rows.
      let all_handles = map(
        (pair) => match pair {
          (_, h) => h,
        },
        qmap
      )
      let param_handles = filter((h) => !is_row_handle(h), all_handles)
      let result_ty = TName(type_name, map((h) => TVar(h), param_handles))
      let qhandles = all_handles
      // THE GROUPING IS CARRIED, NEVER RE-DERIVED: the type's own env entry
      // holds its variant specs — minted here where the list is already in
      // hand. Every reader (the eq/show sum leaves, the worthiness witness's
      // structure test) was re-deriving this grouping by scanning the WHOLE
      // env snapshot backward per read — 46% of the two-pass self-compile
      // once the env doubled. The nominal-record shape registers none
      // (RecordSchemeKind is its channel), mirroring exactly the set the
      // deleted scans produced.
      let single_record = if total == 1 {
        match list_index(variants, 0) {
          (cn0, _, _) => {
            let f0 = list_index(converted, 0)
            if len(f0) == 1 && cn0 == type_name { is_record_ty(list_index(f0, 0)) } else { false }
          },
        }
      } else {
        false
      }
      if single_record {
        ()
      } else {
        // Registered BEFORE the ctors so a same-named single-variant ctor
        // (type Instant = Instant(Int)) SHADOWS this entry for value-position
        // resolution — the kind-filtered env_lookup_variants walk is the one
        // reader that reaches past the shadow (the KIND IS THE NAMESPACE).
        env_extend(
          type_name,
          Frozen(qhandles, result_ty),
          Declared(type_name),
          TypeVariants(map(
            (ix) => match ix {
              (tag_id, v) => match v {
                (cn, _, _) => (tag_id, cn, list_index(converted, tag_id)),
              },
            },
            enumerate(variants)
          ))
        )
      }
      each(
        (indexed) => match indexed {
          (tag_id, variant) => register_one_variant(
            type_name,
            result_ty,
            qhandles,
            list_index(converted, tag_id),
            variant,
            tag_id,
            total
          ),
        },
        enumerate(variants)
      )
    },
  }
}

// Pass 1 — convert + quantify each variant's field types, threading
// the decl-wide (name, handle) parameter map.
fn quantify_variants(variants, buf, i, n, qmap) = if i >= n {
  (slice(buf, 0, n), qmap)
} else {
  match list_index(variants, i) {
    (_, field_types, _) => match quantify_ty_list(field_types, qmap) {
      (fields2, q2) => quantify_variants(variants, list_set(buf, i, fields2), i + 1, n, q2),
    },
  }
}

fn quantify_ty_list(tys, qmap) = if len(tys) == 0 {
  ([], qmap)
} else {
  match quantify_ctor_ty(list_index(tys, 0), qmap) {
    (head2, q1) => match quantify_ty_list(slice(tys, 1, len(tys)), q1) {
      (rest2, q2) => ([head2] ++ rest2, q2),
    },
  }
}

// quantify_ctor_row — re-mint a function field's OPEN row tail as a genuine row
// variable and quantify it (push onto qmap; result_ty filters row handles out).
// A CLOSED row (`-> B with IO`) is monomorphic — no polymorphic tail — so it
// passes through unchanged; only the open tail (the default `-> B`, a triple
// with a fresh open edge) becomes a quantified row var; the absent set
// rides the same triple through unchanged.
fn quantify_ctor_row(row, qmap) = match row {
  EfRow(names, ab, t) => match t {
    EtOpen(_) => {
      let rv = graph_fresh_row(Inferred("polymorphic effect row of a stored function"))
      (ef_make(names, ab, EtOpen([rv])), push(qmap, ("", rv)))
    },
    _ => (row, qmap),
  },
}

// Lowercase TName leaves become quantified TVars; capitalized names
// keep nominal identity (args recurse); compound forms recurse.
fn quantify_ctor_ty(ty, qmap) = match ty {
  TName(name, args) => // `!` — the never-returns bottom (parse_type_atom's TBang). Each
  // occurrence mints its OWN fresh var, never a shared qmap entry: bottom
  // is per-site, so `abort() -> !` instantiates to a type every consumer
  // unifies with, at every call independently.
  if len(args) == 0 && type_name_eq(name, "!") {
    (TVar(graph_fresh_ty(Inferred("bottom: never returns"))), qmap)
  } else if len(args) == 0 && first_char_code(name) >= 97 && first_char_code(name) <= 122 {
    match qmap_find(qmap, name) {
      Some(h) => (TVar(h), qmap),
      None => {
        let h = graph_fresh_ty(Declared(name))
        (TVar(h), push(qmap, (name, h)))
      },
    }
  } else if len(args) == 0 {
    // A capitalized nullary name resolves through the env edge its type
    // declaration drew (§2 follow-the-edge): a transparent / refined
    // alias binds as its LIVE TAlias, so unification sees through it and
    // fold_strip / repr_of reach the base scalar. Binding the raw
    // syntactic TName instead minted a nominal sum-compare for a refined
    // Int — $compare_nValidOffset tag-compared byte POSITIONS ≥ heap_base,
    // so m3's lexer cut every input at 4096 bytes (2026-07-09). A nominal
    // record / ADT / not-yet-declared name stays TName: its identity IS
    // nominal; only a TAlias-bodied entry is transparent. The read is the
    // TYPE-position lookup: an effect decl may share the name (`effect
    // Sample` + `type Sample`), and the plain newest-entry read would let
    // the effect shadow the alias — the kind is the namespace.
    match env_lookup_type(name) {
      Some(entry) => match entry {
        (scheme, _, _) => match judgment_ty(scheme) {
          TAlias(an, inner) => (TAlias(an, inner), qmap),
          _ => (TName(name, []), qmap),
        },
      },
      None => (TName(name, []), qmap),
    }
  } else {
    match quantify_ty_list(args, qmap) {
      (args2, q2) => (TName(name, args2), q2),
    }
  },
  TList(elem) => match quantify_ctor_ty(elem, qmap) {
    (e2, q2) => (TList(e2), q2),
  },
  TTuple(elems) => match quantify_ty_list(elems, qmap) {
    (es2, q2) => (TTuple(es2), q2),
  },
  TFun(params, ret, row) => match quantify_tparam_list(params, qmap) {
    (ps2, q1) => match quantify_ctor_ty(ret, q1) {
      (r2, q2) => // A function-typed FIELD is effect-POLYMORPHIC: its open row tail must be a
      // genuine ROW variable, quantified into the ctor scheme so each USE of the
      // ctor instantiates a FRESH row (a stored function carries its own effects;
      // a table of them unifies their rows by the row algebra). parse_type_ty
      // mints the tail as a TYPE handle (fresh_handle → graph_fresh_ty), which
      // free_in_row never collects and instantiate can't freshen, so the tail
      // stayed a single free var that finalize closed to Pure — every effectful
      // stored closure then "violated Pure" (the CLI verb table). Re-mint the tail
      // as a row var here and quantify it; result_ty filters row handles out by
      // node-kind, so the type stays non-parametric.
      match quantify_ctor_row(row, q2) {
        (row2, q3) => (TFun(ps2, r2, row2), q3),
      },
    },
  },
  TRecord(fields) => match quantify_field_list(fields, qmap) {
    (fs2, q2) => (TRecord(fs2), q2),
  },
  _ => (ty, qmap),
}

fn quantify_tparam_list(params, qmap) = if len(params) == 0 {
  ([], qmap)
} else {
  let p0 = list_index(params, 0)
  match quantify_ctor_ty(param_ty(p0), qmap) {
    (pty2, q1) => match quantify_tparam_list(slice(params, 1, len(params)), q1) {
      (rest2, q2) => // default→None is a DELIBERATE quantification reset (NOT a Carried-Truth
      // drop): a generalized ctor scheme carries no call-site default. The other
      // three aspects are projected live; only the default slot is cleared.
      ([TParam(param_name(p0), pty2, param_authored(p0), param_resolved(p0), None)] ++ rest2, q2),
    },
  }
}

fn quantify_field_list(fields, qmap) = if len(fields) == 0 {
  ([], qmap)
} else {
  match list_index(fields, 0) {
    (fname, fty) => match quantify_ctor_ty(fty, qmap) {
      (fty2, q1) => match quantify_field_list(slice(fields, 1, len(fields)), q1) {
        (rest2, q2) => ([(fname, fty2)] ++ rest2, q2),
      },
    },
  }
}

fn qmap_find(qmap, name: String) = if len(qmap) == 0 {
  None
} else {
  match list_index(qmap, 0) {
    (n, h) => if n == name { Some(h) } else { qmap_find(slice(qmap, 1, len(qmap)), name) },
  }
}

// Every value CONSTRUCTION lowers to alloc + stores, so the judgment
// charges what the lowering performs (the sugar-charge law at the value
// layer). Measured before the charge existed (2026-08-01, the four-face
// and ctor probes): tuple/list/record literals AND payload ctors all
// published Pure while allocating — a false `with Pure` proof at every
// literal, and the real-time `!Alloc` teaching unsound against them.
// Presents, no edges (values — freshness moot); nullary tags and the
// tuple-const READ charge nothing (immediate words, no allocation).
fn construction_row() with Memory + Alloc + Intern =
  mk_ef_closed([ENamed(intern_str("Memory")), ENamed(intern_str("Alloc"))])

fn register_one_variant(type_name: String, result_ty, qhandles, field_types, variant, tag_id, total) = match variant {
  (ctor_name, _, _) => {
    // H2.3 nominal record: a single-variant type whose body is a
    // TRecord registers as RecordSchemeKind, not ConstructorScheme.
    // The env entry binds the type's name to TName directly (no
    // function arrow); NamedRecordExpr inference reads the
    // RecordSchemeKind to validate and lower constructions.
    // The record-payload probe under an explicit guard: list_index(_, 0) on a
    // ZERO-field variant is out of bounds, and the eager `&&` ran it for every
    // nullary ctor (None, Leaf, EtClosed…) — silent garbage into is_record_ty,
    // surfaced by the bounds trap. The control-flow guard is valid under BOTH
    // lowerings, which the bootstrap requires: an m2 body compiled by the
    // still-eager boot carries the checked list_index in the same binary.
    let single_record_payload = if total == 1 && len(field_types) == 1 && ctor_name == type_name {
      is_record_ty(list_index(field_types, 0))
    } else {
      false
    }
    if single_record_payload {
      match list_index(field_types, 0) {
        TRecord(declared_fields) => env_extend(
          ctor_name,
          Frozen(qhandles, result_ty),
          Declared(ctor_name),
          RecordSchemeKind(declared_fields)
        ),
        _ => // is_record_ty above proves TRecord — the impossible branch (SYNTAX
        // §exhaustiveness); the refutable let-destructure that stood here was
        // the census's own "misses 13 of 14" finding, true by the law.
        (),
      }
    } else {
      let kind = ConstructorScheme(tag_id, total)
      if len(field_types) == 0 {
        env_extend(ctor_name, Frozen(qhandles, result_ty), Declared(ctor_name), kind)
      } else {
        let params = build_ctor_params(field_types, 0)
        // A payload ctor's arrow carries the construction row — the
        // variant record allocates, and the call path then charges it
        // through the one-way crow read like any callee (the ctor-probe
        // face: payload_ctor published Pure under the mk_ef_pure arrow).
        env_extend(
          ctor_name,
          Frozen(qhandles, TFun(params, result_ty, construction_row())),
          Declared(ctor_name),
          kind
        )
      }
    }
  },
}

fn is_record_ty(ty) with Pure = match ty {
  TRecord(_) => true,
  _ => false,
}

fn build_ctor_params(field_types, base_idx) = map(
  (indexed) => match indexed {
    (i, ty) => mk_param("_{int_to_str(base_idx + i)}", ty),
  },
  enumerate(field_types)
)

fn register_effect_ops(effect_name, params, ops) = {
  // Register the effect name itself with its op names.
  // EffectDeclKind is the graph's vocabulary for "this is an effect
  // declaration carrying these ops." The world-chain dispatch reads it;
  // the Cursor can project it at any position mentioning the effect.
  // The SCHEME is the effect's INSTANCE SIGNATURE — the declared
  // params' types as a tuple (`effect Sample(rate: Int)` publishes
  // TTuple([Int])), the one home every authored `Sample(44100)`
  // instance judges its args against; a bare effect publishes the
  // empty tuple. The formerly-empty tuple here was a placeholder.
  let op_names = map(((n, _, _, _)) => n, ops)
  env_extend(
    effect_name,
    Frozen([], TTuple(map(param_ty, params))),
    Declared(effect_name),
    EffectDeclKind(op_names)
  )
  // THE EFFECT'S COMPLETE TYPE-VAR STRUCTURE: the free type vars across ALL
  // its ops' signatures (params + returns), deduped — the effect's type
  // params. An effect whose ops are all CONCRETE has zero vars → bare
  // ENamed (no payload, no spurious unification). Every op shares ONE row —
  // EParameterized(E, the vars) — so yield(a)/result() both carry Iterate(a)
  // (the SAME a); the install unifies the whole instance per-position. This
  // is per-EFFECT-instance carrying ALL its vars — NOT one-payload-per-effect.
  // Quantify the ops' lowercase type-var leaves (the case rule) BEFORE reading
  // their free vars. Raw, `yield(element)`'s `element` is a TName leaf;
  // effect_type_vars finds no var; Iterate stays a bare ENamed; the payload
  // type never flows performer→handler, so every collector handler (map/fold/
  // iterate's buffer) goes `[free]` and the iteration machinery ERASES the
  // element — the §4① value-ontology violation at the effect boundary, and the
  // root of both the list-as-Int erasure and the emitter's heap-dump.
  let qops = quantify_effect_ops(ops)
  let eff_vars = unique(effect_type_vars(qops))
  let enh = intern_str(effect_name)
  // The instance's VALUE dimensions — one opaque node per declared effect
  // param (`effect Sample(rate: Int)` carries one), FIRST so an authored
  // instance's args (`Sample(48000)` — declared-param positions) align
  // position-wise with the charge's. EANode by design: eparam_arg_tys
  // skips it, so the type-space install flow (handler payload arity,
  // unify_op_payload, instances_in_row) never meets a value dim;
  // free_in_eff_arg answers [], so it never quantifies and rides
  // instantiation verbatim; the declared gate's pin
  // (pin_declared_instances) is its one writer. Deriving the instance
  // from op type vars ALONE minted a bare ENamed for a concrete-op
  // value-parameterized effect, so every charge erased the instance
  // identity the row algebra distinguishes (SYNTAX §Parameterized
  // effect) — masked while the gate published the declared row verbatim,
  // exposed by the publish law (the inst-sibling fixture's record).
  let value_dims = map((_) => EANode(mint(Inferred("effect '{effect_name}' value dim"))), params)
  let eff_name = if len(params) == 0 && len(eff_vars) == 0 {
    ENamed(enh)
  } else {
    EParameterized(enh, value_dims ++ map((v) => EAType(TVar(v)), eff_vars))
  }
  each((op) => register_one_op(effect_name, eff_name, op), qops)
}

// The free type vars across all an effect's ops' signatures — the effect's
// type-parameter set (the instance's polymorphic dimensions).
//
// quantify_effect_ops — convert each op's lowercase TName leaves to quantified
// TVars, sharing by NAME across the effect's ops (so `get() -> s` and
// `set(v: s)` share the one `s`) via a threaded qmap. The SAME quantify_ctor_ty
// the type-constructor path uses — one case-rule primitive for ctors AND effect
// ops (Mentl solves Mentl). Uppercase leaves (`Int`) stay nominal, so Memory's
// `load_i32(Int)` correctly does NOT parameterize.
fn quantify_effect_ops(ops) = match quantify_effect_ops_loop(ops, [], 0) {
  (qops, _) => qops,
}

fn quantify_effect_ops_loop(ops, qmap, i) = if i >= len(ops) {
  ([], qmap)
} else {
  match list_index(ops, i) {
    (name, ptys, rty, cn) => match quantify_ty_list(ptys, qmap) {
      (qptys, q1) => match quantify_ctor_ty(rty, q1) {
        (qrty, q2) => match quantify_effect_ops_loop(ops, q2, i + 1) {
          (rest, q3) => ([(name, qptys, qrty, cn)] ++ rest, q3),
        },
      },
    },
  }
}

fn effect_type_vars(ops) = ops |> map((op) => match op {
  (_, ptys, rty, _) => flatten(map(free_in_ty, ptys)) ++ free_in_ty(rty),
}) |> flatten

// VARIANCE at the op's result. A parameter's unannotated fn-type row is a
// VAR on purpose — the effect-polymorphic flow channel `map`'s `f` needs,
// and masking it convicted 297 wheel sites in one march. A RESULT is the
// other direction: nothing flows in, so a var there is not a channel but an
// unstated promise, and the arm that produces the value teaches the
// declaration its row instead of meeting it. Measured 2026-08-18: a closure
// performing E, resumed out and called under `with !E`, checked clean and
// ran; writing `with Pure` on the same return made it refuse. Capping the
// result's own row closes that by construction. No op in src or lib returns
// a fn type, so the crucible pair is this rule's only oracle.
// STRUCTURAL, because the whole result is covariant and a closure hides in
// any of its containers: `give() -> [() -> Int]` and `give() -> (Int, () ->
// Int)` both leaked while the bare `give() -> (() -> Int)` refused
// (measured 2026-08-18 — the first cut matched only a top-level TFun).
// A returned fn's own RESULT is covariant too and recurses; its PARAMS are
// contravariant — a demand on whoever calls it — and keep their vars.
// TOTAL over Ty, with no catch-all, and that totality is the fix rather
// than a style. Three cuts of this walk each shipped a hole a probe then
// found: first only a top-level TFun (a list and a tuple leaked), then the
// three containers (an alias and a variant payload leaked). A `_ => t` arm
// over a load-bearing ADT is exactly the residue the audit names, and here
// it silently answered "nothing to cap" for every shape nobody had thought
// of yet. Enumerated, a new Ty constructor cannot compile until someone
// decides what it means for a result.
//
// TName is a NOMINAL type and its payloads live on the constructors'
// schemes, registered elsewhere — capping its args would cap type
// ARGUMENTS, which is the wrong altitude. The variant-payload leak is real
// and belongs at the type declaration: `Hβ.effects.variant-payload-fn-row`.
fn cap_result_fn_row(t) = match t {
  TFun(ps, r, row) => {
    let capped = if row_cap_form(row) { row } else { mk_ef_pure() }
    TFun(ps, cap_result_fn_row(r), capped)
  },
  TList(e) => TList(cap_result_fn_row(e)),
  TTuple(es) => TTuple(map(cap_result_fn_row, es)),
  TRecord(fs) => TRecord(map(cap_result_field, fs)),
  TRecordOpen(fs, v) => TRecordOpen(map(cap_result_field, fs), v),
  TAlias(n, inner) => TAlias(n, cap_result_fn_row(inner)),
  TRefined(inner, p) => TRefined(cap_result_fn_row(inner), p),
  TReprPin(r, inner) => TReprPin(r, cap_result_fn_row(inner)),
  TCont(a, b, d, w) => // A continuation's own R and S are the resume boundary, typed by the
  // typed-resume law at the arm; the result cap has no business rewriting
  // them.
  TCont(a, b, d, w),
  TName(n, args) => TName(n, args),
  TVar(h) => TVar(h),
  TInt => TInt,
  TFloat => TFloat,
  TUnit => TUnit,
  TByte => TByte,
}

fn cap_result_field(f) = match f {
  (n, ft) => (n, cap_result_fn_row(ft)),
}

fn register_one_op(effect_name, eff_name, op) = match op {
  (op_name, param_types, raw_ret_type, op_node) => // The fourth field is the op's own NTypeAnn node, minted at its span by
  // parse_effect_ops — so the site that must be renamed has a real span here
  // and a diagnostic never has to reach for span_zero.
  {
    let ret_type = cap_result_fn_row(raw_ret_type)
    let params = build_ctor_params(param_types, 0)
    // Every op of the effect carries the SAME instance row (eff_name), so the
    // payload flows performer→handler at the install. Generalize over the
    // op's free vars INCLUDING the instance's (free_in_row) ⇒ each op USE is a
    // fresh effect instance the handle reconciles to the handler's.
    let row = mk_ef_closed([eff_name])
    let qvars = unique(free_in_params(params) ++ free_in_ty(ret_type) ++ free_in_row(row))
    // ONE NAME, TWO KINDS. The env is append-only and read last-write-wins,
    // and the op re-registers after the entry module's own declarations, so
    // a user fn of the same name loses silently. This write is the one place
    // both claims are present; no reading site can see it, because by the
    // time a reader looks one kind has already won.
    // The span is the LOSING declaration's own, read from the Reason the
    // env stored when it was registered — the fn is the thing to rename.
    // EXHAUSTIVE over SchemeKind, because `_ => ()` here is the silent skip
    // that let the op-vs-op collision through: this arm read the FnScheme pair
    // and dropped the other eight, at the one site whose own comment says both
    // claims are present. Every kind is decided below, and the ones that
    // report nothing say why rather than falling into a wildcard.
    match env_lookup(op_name) {
      Some(prior) => match prior {
        (_, prior_reason, prior_kind) => match prior_kind {
          FnScheme => match prior_reason {
            Located(fn_span, _) => report(EFnShadowsOp(op_name, effect_name, fn_span)),
            _ => (),
          },
          EffectOpScheme(prior_effect, _, _, _) => // A DIFFERENT effect already claims this name. The env holds one
          // entry per name, so this write replaces rather than joins, and
          // every prior call retypes. Same effect re-registering (the final
          // pass walks the decls again) is the same op and says nothing.
          if prior_effect == effect_name {
            ()
          } else {
            match op_node {
              N(_, op_span, _) => report(EOpShadowsOp(op_name, prior_effect, effect_name, op_span)),
            }
          },
          HandlerKind(_, _, _, _) => // A handler NAME beside an op name is measured harmless: they
          // resolve in disjoint positions (`~> h` installs, `h()` performs),
          // so both entries are reachable and neither shadows the other.
          (),
          ConstructorScheme(_, _) => // Uppercase by the case rule (SYNTAX §«Generic type parameters» —
          // nominal types and constructors are capitalized, ops are not), so
          // an op name can never collide with one of these.
          (),
          RecordSchemeKind(_) => (),
          EffectDeclKind(_) => (),
          TypeVariants(_) => (),
          RowAliasKind(_) => (),
          ParamScheme(_) => // A parameter binding is scoped to its own fn and cannot stand as
          // the prior claim on a top-level op registration.
          (),
        },
      },
      None => (),
    }
    env_extend(
      op_name,
      Frozen(qvars, TFun(params, ret_type, row)),
      Declared(op_name),
      // OneShot is the join identity (grade UZero → OneShot): an op with no
      // handler stays the fast path; each handler's arm joins its grade in.
      EffectOpScheme(effect_name, "", false, OneShot)
    )
  },
}

// The handler's effect name, read LIVE from the op→effect edge (§2 follow-the-
// edge): each arm handles an op, and that op's EffectOpScheme carries the effect
// that declared it. The parser names no effect (leaves ename ""), so reading the
// real name here is what makes the whole instance flow — unify_op_payload (the
// arm half) and unify_install_payload (the `~>` half) — key on the true effect
// `Iterate` instead of a blank `""` that matches nothing (the m3 concat floors:
// the accumulator's fragments never found each other through a nameless
// instance). Falls back to the handler's own name when it is its own effect's
// sole declaration (Hβ.infer.handler-effect-name-is-live-edge, now live).
// The FULL handled set — every distinct effect the arms touch, as EffNames.
// A handler may absorb several effects (multieffect's buffer handles Emit AND
// Collect); the install's subtraction takes the whole set — subtracting only
// derive_handler_ename's single pick left the sibling effect on the caller's
// row (the false E_EffectUnhandled on an absorbed effect).
fn derive_handler_enames(arms, i, own acc) = if i >= len(arms) {
  acc
} else {
  let acc2 = match env_lookup(handler_arm_op_name(list_index(arms, i))) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        EffectOpScheme(en, _, _, _) => {
          let enn = ENamed(intern_str(en))
          if name_set_contains(acc, enn) { acc } else { push(acc, enn) }
        },
        _ => acc,
      },
    },
    None => acc,
  }
  derive_handler_enames(arms, i + 1, acc2)
}

fn derive_handler_ename(arms, fallback: String) = if len(arms) == 0 {
  fallback
} else {
  match env_lookup(handler_arm_op_name(last(arms))) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        EffectOpScheme(en, _, _, _) => en,
        _ => derive_handler_ename(drop_last(arms), fallback),
      },
    },
    None => derive_handler_ename(drop_last(arms), fallback),
  }
}

fn register_handler(hname, ename_parsed, config, state, arms, span: ValidSpan) = {
  // The handler's identity (effect, instance, config, HandlerKind) was registered
  // at pre_register_handler_sig — a parsed fact, not an inferred one. The main
  // walk reads the pre-registered r_handle from the env so forward references
  // that resolved against the pre-registered HandlerKind share the same residual
  // row handle. Fresh instance vars and config tparams are minted here for the
  // arm inference; the pre-registered scheme is overwritten by env_extend below
  // and again at re-generalization after the arms.
  let ename = derive_handler_ename(arms, hname)
  let inst_vars = mint_instance_vars(ename, effect_instance_arity(ename), 0)
  let inst_ty = TName(ename, map((v) => TVar(v), inst_vars))
  let inst_h = mint(Inferred("effect '{ename}' instance"))
  graph_bind(inst_h, inst_ty, Inferred("effect '{ename}' instance"))
  let handler_ty = TName("Handler", [inst_ty])
  let config_tparams = mint_handler_config_tparams(config, hname, 0)
  let scheme_body =
    if len(config) == 0 { handler_ty } else { TFun(config_tparams, handler_ty, mk_ef_closed([])) }
  // Bind the scheme body to a handle so it can be RE-GENERALIZED after the arms
  // run: the arms unify the instance's result position with the state and the
  // config (fold_handler's `acc = init` and `resume(acc)` join r_h ~ acc ~
  // init). A scheme quantified BEFORE the arms (Frozen(inst_vars, ...)) misses
  // the config tparams and predates those unifications, so `fold`'s init / f-arg
  // / return never share a var — the accumulator floors at `acc ++ xs`. generalize
  // chase_deeps to roots and quantifies EVERY free var, so post-arms it collapses
  // the unified positions to one — the caught-up caller threads.
  let scheme_body_h = mint(Inferred("handler scheme of '{hname}'"))
  graph_bind(scheme_body_h, scheme_body, Inferred("handler scheme of '{hname}'"))
  // The handler's residual row R. READ the pre-registered r_handle from the env
  // so forward references share the same residual row — the row algebra at ~>
  // sites that resolved before this decl in source order uses THIS handle.
  // Carried-Truth: the handle was minted once at pre_register; read it live.
  let r_handle = match env_lookup(hname) {
    Some(entry) => match entry {
      (_, _, kind) => match kind {
        HandlerKind(r, _, _, _) => r,
        _ => graph_fresh_row(Inferred("residual of handler '{hname}'")),
      },
    },
    None => graph_fresh_row(Inferred("residual of handler '{hname}'")),
  }
  env_extend(
    hname,
    Frozen(inst_vars, scheme_body),
    Declared(hname),
    HandlerKind(r_handle, config_tparams, state, arms)
  )
  // Resume cardinality IS written here, on the op's EffectOpScheme (draw_op_edges
  // below joins each arm's resume_grade). The body IS the contract, so the
  // cardinality is inferred from the arm body — but it is a TYPE-LEVEL fact (the
  // op's continuation multiplicity), so its home is the op's scheme in the graph,
  // NOT a hand-walk lower re-does per resume (the deleted infer_resume_cardinality
  // was that re-walk, at the wrong layer, over a broken immutable-buffer collector
  // that never accumulated its pushes — the mn-multishot dormancy). Inference is
  // the one writer; lower PROJECTS disc off the scheme (op_resume_discipline), the
  // way it projects repr off a type and world off a row. Not a side-ledger: the
  // scheme is the op's type home, the one graph. STEP 5's TCont carries the same
  // disc for cross-context unification (E_ResumeWorldMismatch) — peer
  // Hβ.types.tcont-carries-cardinality-and-world.
  // Typed-resume arm typing (SYNTAX §Effect declarations): every arm
  // body walks under the law with one per-decl handle-result S.
  // Config params bind through the SAME TParam handles the scheme
  // carries (install-site args constrain arm-body usage through them);
  // state fields bind to their init expressions' inferred types — the
  // graph already knows them, fresh vars would discard that.
  // Config params bound FIRST — before the state inits are inferred — so a
  // state init that references a config param (`with acc = init`) READS the
  // live config, not an unbound name flooring to a fresh var. That
  // read-before-bind disconnected fold's accumulator `acc` from its `init`
  // config: fold's type became four separate vars (init / f-param / f-result /
  // return), the lambda's `acc` never resolved to a list, and `acc ++ xs`
  // floored (the m3 concat census). One outer env scope holds config + state
  // for every arm; per-arm scopes isolate only the op params.
  env_scope_enter()
  bind_handler_config_params(config_tparams, hname)
  let s_h = mint(Inferred("handler result of '{hname}'"))
  // Accumulate the arms' residual row R into r_handle: inferring each arm
  // body under this row scope routes every effect it performs (incl. a call
  // to a config arg `f`) into r_handle via inf_add_effect/inf_add_row. On
  // exit, r_handle binds to R — the row `~> h` adds to the caller.
  inf_enter_fn(r_handle, s_h, span, [])
  // EVERYTHING THE INSTALL EVALUATES BELONGS INSIDE THIS SCOPE — the config
  // DEFAULTS and the state INITS both, because both run where the arms' own
  // effects run: at the install, in the installer's world. Judged outside it
  // their rows landed on whatever frame was judging the DECL and reached no
  // installer at all. Both were measured leaking the same way, one field
  // apart: `handler hf with s = op()` and `handler hf(k: Int = op())`, each
  // installed by `fn bad() with !E = (g()) ~> hf`, checked clean while the
  // expression genuinely performed E — give `op` a handler returning 7 and
  // the value arrives, exit 7. SYNTAX's tee rule already carries this: they
  // are parts of the handler, so their rows are part of row(h), and r_handle
  // is where row(h) is accumulated
  // (`Hβ.effects.handler-state-init-row-never-installed`).
  //
  // A config DEFAULT is still typed at its one home — the handler's own
  // parameter scope (SYNTAX §«Default parameter values»: one home, the
  // signature node; one evaluation context, the callee). The bare `~> h`
  // install has no call node to splice the default through, so the decl is
  // the scope that grounds it, and an omitting explicit install (`~> h()`)
  // re-infers the spliced node at its site through resolve_call_args.
  each(
    (p) => match param_default(p) {
      Some(d) => {
        infer_expr(d)
        match d {
          N(_, dsp, dh) => unify_types(TVar(dh), param_ty(p), dsp, DefaultReason(param_name(p), dsp)),
        }
      },
      None => (),
    },
    config_tparams
  )
  let state_binds = infer_handler_state_inits(state)
  bind_handler_state_names(state_binds, hname, span)
  each(
    (arm) => {
      env_scope_enter()
      // drift-audit: ignore — s_h (arm result) and inst_h (effect instance) are distinct, not parallel arrays
      infer_one_handler_arm(arm, s_h, inst_h)
      env_scope_exit()
    },
    arms
  )
  // The arm scope's SIGNATURE is the handler's config cells + its result:
  // an arm's call into a config fn charges a judgment-era row edge that
  // escapes through the scheme at every install (the config tparam rides
  // the published TFun), so the completion prune's signature keep applies
  // here exactly as at a named decl's exit — with an empty keep the
  // residual dropped the config-fn edge and folded nothing (measured:
  // zero residual edges on the leak-handler-residual crucible).
  inf_exit_fn(signature_free_roots(tparam_cells(config_tparams) ++ [s_h]))
  env_scope_exit()
  // Re-store the handler's scheme now that the arms have unified the instance's
  // result position with the state and config (r_h ~ acc ~ init). generalize
  // chase_deeps scheme_body to its roots and quantifies every free var, so the
  // config tparams and instance positions the arms joined collapse to shared
  // vars — a caller's `~> h(args)` freshens them consistently and the accumulator
  // threads. The Frozen(inst_vars, ...) bound before the arms is the pre-arms
  // scheme a recursive arm reference resolves against; this re-store carries the
  // arms' unifications the caller reads (Carried-Truth: read the grounded roots).
  env_extend(
    hname,
    generalize(scheme_body_h),
    Declared(hname),
    HandlerKind(r_handle, config_tparams, state, arms)
  )
  // Draw the op→handler edge onto each op's EffectOpScheme HERE — in the body,
  // OUTSIDE the arm `each` and inf_enter_fn's InferCtx install. An env_extend
  // performed inside those (an arm-internal perform) never reaches the outer
  // env_handler and silently vanishes before lower (the not-yet-substrate gap,
  // prelude.mn); the same env_extend at this body level persists, exactly as the
  // HandlerKind bind above does. `arms` are read via handler_arm_op_name, whose
  // annotated param type resolves op_name from any context (no in-scope type
  // closure needed). The op binding IS the dispatch fact — lower reads it to cash
  // a non-lexical perform of a uniquely-handled op to a direct call against the
  // singleton's $<hname>_state_g home (Carried-Truth: read the once-installed
  // record live, never thread a copy through the deep chain that trapped at
  // fresh_handle).
  draw_op_edges(arms, hname)
}

// Recur over a handler's arms, drawing op→handler onto each op's EffectOpScheme.
// A top-level recursive definition, never an each-lambda, so the env_extend
// writes through a fn body and reaches env_handler. The FIRST handler to name an
// op sets default_handler; a SECOND distinct handler marks it ambiguous;
// a SECOND distinct handler marks it ambiguous (no static singleton — lower
// threads evidence); the same handler or an already-ambiguous op is a no-op.
// field_name_eq forces str_eq (a bare `== ""`/`== hname` is pointer-eq under the
// seed — §9 name-compare class).
fn draw_op_edges(arms, hname) = if len(arms) == 0 {
  ()
} else {
  let arm = last(arms)
  let op_name = handler_arm_op_name(arm)
  // The arm's resume cardinality, computed from the body infer just typed
  // (resume_grade — the Usage fold), JOINED onto the op's scheme. This is
  // the write: cardinality is inference's, carried on the op's type, read
  // live by lower — no second hand-walk at lower. The join is monotone
  // toward MultiShot, so a re-drawn arm only ever raises disc.
  let grade = resume_grade(handler_arm_body(arm))
  match env_lookup(op_name) {
    Some(entry) => match entry {
      (scheme, reason, kind) => match kind {
        EffectOpScheme(ename, cur_default, ambiguous, cur_disc) => {
          // M4 — the UZero ABANDON grade. An arm that never resumes must
          // deliver its value as the INSTALL's, abandoning the continuation
          // (under the driver: don't call k, return — the loop exits flag-
          // clear with the arm value). But that only MATTERS when the arm
          // returns a MEANINGFUL value: the op's return type gates it.
          //   `fail(msg) -> a` (bare quantified TVar) and `abort() -> !`
          //   (the never type, parsed TUnit — types.mn:1571 documents abort
          //   as intentionally OneShot) are BOTTOM: no value flows back, so
          //   the direct-dispatch OneShot path is already correct and the
          //   arm terminates (proc_exit) or unifies via the free var. They
          //   stay OneShot — so NO wheel op changes disc (Law 7 wheel-wide:
          //   m2 == m3, the abandon forms are added arms exercised only by
          //   out-of-wheel crucibles).
          //   `abort() -> Option` (a concrete TName) is the value-returning
          //   case the crucibles test: its None must reach the install, not
          //   the perform site — MultiShot, abandon via the driver.
          // A genuinely unit-returning UZero arm wanting abandon is the
          // named follow-up Hβ.lower.uzero-unit-abandon (none in the wheel;
          // () carries no value, so return-vs-abandon is observationally
          // near-equivalent — the concrete-non-unit signal captures every
          // meaningful case).
          let arm_disc = arm_disc_of(grade, scheme_ret_ty(scheme))
          let disc = disc_join(cur_disc, arm_disc)
          // default/ambiguous evolve as before; disc always joins in.
          match if ambiguous || field_name_eq(cur_default, hname) {
            (cur_default, ambiguous)
          } else if field_name_eq(cur_default, "") {
            (hname, false)
          } else {
            (cur_default, true)
          } {
            (nd, na) => env_extend(op_name, scheme, reason, EffectOpScheme(ename, nd, na, disc)),
          }
        },
        _ => (),
      },
    },
    None => (),
  }
  draw_op_edges(drop_last(arms), hname)
}

// Walk each state field's init ONCE per decl; the init's inferred
// type IS the field's type in arm scope.
fn infer_handler_state_inits(state) = map(
  (sf) => {
    infer_expr(state_field_init(sf))
    match state_field_init(sf) {
      N(_, _, ih) => (state_field_name(sf), ih),
    }
  },
  state
)

fn bind_handler_config_params(config_tparams, hname) = each(
  (tp) => {
    let name = param_name(tp)
    let ty = param_ty(tp)
    env_extend(
      name,
      Frozen([], ty),
      Located(span_zero(), LetBinding(name, Declared(hname))),
      ParamScheme(param_authored(tp))
    )
  },
  config_tparams
)

fn bind_handler_state_names(state_binds, hname, span: ValidSpan) = each(
  (p) => match p {
    (name, ih) => env_extend(name, Frozen([], TVar(ih)), Located(span, LetBinding(name, Declared(hname))), FnScheme),
  },
  state_binds
)

// ─── Resume cardinality — the arm's continuation multiplicity (Usage) ─────
//
// resume_grade folds the arm body to its Usage grade (types.mn): each
// `resume` is UOne; sequential composition ⊗-combines (two resumes on ONE
// path → UMany → MultiShot); alternation ⊔-joins (disjoint branches → the
// join, so `if c {resume(a)} else {resume(b)}` stays UOne → OneShot — the
// ~85% direct-return fast path survives a branchy one-shot arm). This IS
// ownership's use-count (own.mn classify_usage) with `resume` as the counted
// use: cardinality and ownership are ONE lattice (types.mn Usage), arm 5 and
// the TIME axis reading the same value-multiplicity. ONE pure compositional
// fold over the arm structure infer just typed — no buffer, no O(N²)
// pairwise-disjoint scan, no second walk. (The deleted 12-fn collector used a
// Buffer whose push returned a NEW record the walk discarded, so pushes
// never accumulated: every arm classified 0-site → OneShot and the multi-shot
// producer stayed dormant — mn-multishot exit 10 not 30.) Drift refused: 1
// (structural fold, no vtable); 8 (Usage / ResumeDiscipline are ADTs, never
// counts-as-int). A continuation re-invoked by a passed lambda or a
// tail-recursive self-call reads as its STRUCTURAL grade — the named edge peer
// Hβ.infer.tail-recursion-resume-cardinality (the old walk was no better: it
// only detected a never-emitted NLoopExpr ancestor).
//
// ─── THE CUT — the resume-summary classifier (bank Ruling 6) ────────────
// Per-fn summaries g(f) = the fn body's resume grade WITH call-substitution,
// run as a monotone fixpoint over the 3-point Usage lattice: recursion
// saturates to UMany by round 2 (try_each's self-call through its catch
// lambda), no cycle detection needed. Runs in every judgment pass between
// registration and the walk; builds its own name→body map from
// the stmts directly (top-level AND nested fn decls — a nested name
// colliding across scopes JOINS, the sound over-approximation direction).
// draw_op_edges reads the summaries through resume_grade's substitution, so
// an arm's grade sees resumes in called fns and choose/enumerate_inhabitants
// flip MultiShot on machinery that can carry them.
effect ResumeSummaries {
  summary_of(String) -> Usage
  set_summaries([(String, Usage)])
}

// The standing ctx — every judgment pass installs it; the fixpoint's result lives
// here for every later resume_grade call (draw_op_edges at each handler).
handler resume_summaries_ctx with entries = [] {
  summary_of(name) => resume(usage_summary_lookup(entries, name, 0)),
  set_summaries(es) => resume() with entries = es,
}

// Linear summary lookup — kept for the COLD readers (resume_summaries_ctx, read
// once per handler arm by draw_op_edges; lower.mn:1012's per-fn grade read). The
// HOT per-round fixpoint path uses the O(1) summary_index below (summaries_frozen).
fn usage_summary_lookup(entries, name: String, i) = if i >= len(entries) {
  UZero
} else {
  match list_index(entries, i) {
    (n, u) => if n == name { u } else { usage_summary_lookup(entries, name, i + 1) },
  }
}

// One frozen round of the fixpoint — resume_grade's summary reads answer from
// the PREVIOUS round's entries, O(1) via a str_hash index. The former linear
// usage_summary_lookup — an O(N) by-name scan per call-node per round — was 98%
// of the ENTIRE self-compile (perf, 2026-07-13): the grade is a per-fn fact keyed
// by name, and re-scanning it linearly per lookup is the Carried-Truth violation
// at the performance scale (§5.O — the same str_hash index the env resolution
// uses). The index is built once per round (O(N)); every summary_of is O(1).
// The name → resume-grade index is the shared smap (lib/imap.mn);
// a miss is UZero (the identity grade), unwrapped from smap's Option. Reverse
// insertion keeps the first-match grade byte-identical to the old linear scan
// when a nested fn shadows a top-level name.
handler summaries_frozen(idx) {
  summary_of(name) => resume(match smap_get(idx, name) {
    Some(g) => g,
    None => UZero,
  }),
}

fn classify_fixpoint(stmts) = {
  // Flatten decls ONCE — collect_fn_decls builds a cons-list, so the classifier's
  // list_index(decls, i) would be O(N²) per round (§5.O: read a flat array O(1),
  // never re-walk a spine). Both decls and the entries are flat hereafter.
  let decls = list_to_flat(collect_fn_decls_list(stmts, []))
  classify_rounds(
    decls,
    list_to_flat(map(
      (nb) => match nb {
        (n, _) => (n, UZero),
      },
      decls
    ))
  )
}

fn classify_rounds(decls, entries) = {
  // A body-level RECURSION under the install, never a map-lambda: a perform
  // inside a lambda under an install resolves Tier-1 to the enclosing
  // frame's __hstate local — out of scope in the lambda's emitted body (the
  // arm-internal-perform gap; the draw_op_edges precedent). The recursion
  // threads evidence through its own calls.
  let idx = smap_build(entries)
  let next = list_to_flat({
    classify_grade_all(decls, 0)
  } ~> summaries_frozen(idx))
  if usage_entries_eq(entries, next, 0) { next } else { classify_rounds(decls, next) }
}

fn classify_grade_all(decls, i) = if i >= len(decls) {
  []
} else {
  match list_index(decls, i) {
    (n, b) => // drift-audit: ignore — prepend-cons recursion, O(N) total
    [(n, resume_grade(b))] ++ classify_grade_all(decls, i + 1),
  }
}

// Monotone lattice ⇒ the fixpoint compares by VALUE; the name lists are
// positionally identical across rounds (same decls order).
fn usage_entries_eq(a, b, i) = if i >= len(a) {
  true
} else {
  match list_index(a, i) {
    (_, ua) => match list_index(b, i) {
      (_, ub) => if usage_eq(ua, ub) { usage_entries_eq(a, b, i + 1) } else { false },
    },
  }
}

fn usage_eq(a, b) = match a {
  UZero => match b {
    UZero => true,
    _ => false,
  },
  UOne => match b {
    UOne => true,
    _ => false,
  },
  UMany => match b {
    UMany => true,
    _ => false,
  },
}

// Every fn decl in the program — top-level and nested — as (name, body).
// The walk mirrors resume_grade's enumeration (the same child-bearing
// forms); a form added to one without the other starves the summary map.
fn collect_fn_decls_list(nodes, acc) = if len(nodes) == 0 {
  acc
} else {
  collect_fn_decls_list(drop_last(nodes), collect_fn_decls(last(nodes), acc))
}

fn collect_fn_decls(node, acc) = match node {
  N(body, _, _) => match body {
    NStmt(FnStmt(name, _, _, _, b)) => // drift-audit: ignore — decl-count-bounded cons, not a hot loop
    collect_fn_decls(b, [(name, b)] ++ acc),
    NStmt(HandlerDeclStmt(_, _, _, _, arms)) => collect_fn_decls_arms(arms, acc),
    NStmt(LetStmt(_, v, _)) => collect_fn_decls(v, acc),
    NStmt(ExprStmt(e)) => collect_fn_decls(e, acc),
    NExpr(BlockExpr(stmts, final)) => collect_fn_decls(final, collect_fn_decls_list(stmts, acc)),
    NExpr(IfExpr(c, t, e)) => collect_fn_decls(e, collect_fn_decls(t, collect_fn_decls(c, acc))),
    NExpr(MatchExpr(scrut, arms)) => collect_fn_decls_match(arms, collect_fn_decls(scrut, acc)),
    NExpr(CallExpr(f, args)) => collect_fn_decls_list(args, collect_fn_decls(f, acc)),
    NExpr(BinOpExpr(_, l, r)) => collect_fn_decls(r, collect_fn_decls(l, acc)),
    NExpr(UnaryOpExpr(_, x)) => collect_fn_decls(x, acc),
    NExpr(LambdaExpr(_, lbody)) => collect_fn_decls(lbody, acc),
    NExpr(MakeListExpr(elems)) => collect_fn_decls_list(elems, acc),
    NExpr(MakeTupleExpr(elems)) => collect_fn_decls_list(elems, acc),
    NExpr(MakeRecordExpr(fields)) => collect_fn_decls_fields(fields, acc),
    NExpr(RecordUpdateExpr(base, fields)) => collect_fn_decls_fields(fields, collect_fn_decls(base, acc)),
    NExpr(NamedRecordExpr(_, fields)) => collect_fn_decls_fields(fields, acc),
    NExpr(FieldExpr(b, _)) => collect_fn_decls(b, acc),
    NExpr(IndexExpr(receiver, index)) => collect_fn_decls(index, collect_fn_decls(receiver, acc)),
    NExpr(PipeExpr(_, l, r)) => collect_fn_decls(r, collect_fn_decls(l, acc)),
    NExpr(FanoutExpr(branches)) => collect_fn_decls_list(branches, acc),
    NExpr(RestExpr(_)) => acc,
    NExpr(MakeStringExpr(frags)) => collect_fn_decls_list(frags, acc),
    NExpr(ShowExpr(inner)) => collect_fn_decls(inner, acc),
    NExpr(LabeledArg(_, v)) => collect_fn_decls(v, acc),
    NExpr(ResumeExpr(v, us)) => collect_fn_decls_updates(us, collect_fn_decls(v, acc)),
    NStmt(TypeDefStmt(_, _)) => acc,
    NStmt(EffectDeclStmt(_, _, _)) => acc,
    NStmt(ImportStmt(_)) => acc,
    NStmt(RefineStmt(_, _, _)) => acc,
    NStmt(AliasStmt(_, _)) => acc,
    NStmt(RowAliasStmt(_, _)) => acc,
    NExpr(LitInt(_)) => acc,
    NExpr(LitFloat(_)) => acc,
    NExpr(LitString(_)) => acc,
    NExpr(LitBool(_)) => acc,
    NExpr(LitUnit) => acc,
    NExpr(VarRef(_)) => acc,
    NExpr(ExprPlaceholder) => acc,
    NHole(_) => acc,
    NPat(_) => acc,
    NModule(_) => acc,
    NTypeAnn(_) => acc,
  },
}

fn collect_fn_decls_arms(arms, acc) = if len(arms) == 0 {
  acc
} else {
  collect_fn_decls_arms(drop_last(arms), collect_fn_decls(handler_arm_body(last(arms)), acc))
}

fn collect_fn_decls_match(arms, acc) = if len(arms) == 0 {
  acc
} else {
  match last(arms) {
    (_, b) => collect_fn_decls_match(drop_last(arms), collect_fn_decls(b, acc)),
  }
}

fn collect_fn_decls_fields(fields, acc) = if len(fields) == 0 {
  acc
} else {
  match last(fields) {
    (_, v) => collect_fn_decls_fields(drop_last(fields), collect_fn_decls(v, acc)),
  }
}

fn collect_fn_decls_updates(updates, acc) = if len(updates) == 0 {
  acc
} else {
  collect_fn_decls_updates(drop_last(updates), collect_fn_decls(state_field_init(last(updates)), acc))
}

// usage_seq (⊗) and usage_join (⊔) live in types.mn beside the Usage ADT
// they fold — one lattice home for this walk and own.mn's mode-paired
// ownership grade (§11 4.2; own cannot import infer).
//
// M4 — the resume grade JOINED with the op's return type. UMany always
// drives a real k (MultiShot); UOne is the tail-resumptive fast path
// (OneShot, byte-identical). UZero — the arm NEVER resumes — is the
// abandon case, but abandon only MATTERS when a value flows back: a
// bottom return (a bare quantified TVar like `fail -> a`, or `!` which
// parses TUnit) has nothing to abandon, so it stays OneShot (the wheel's
// documented-OneShot abort/fail — Law 7 wheel-wide). A concrete return
// (`abort -> Option`) must abandon, delivering the arm value to the
// install through the driver → MultiShot.
fn arm_disc_of(grade, ret) = match grade {
  UMany => MultiShot,
  UOne => OneShot,
  UZero => match ret {
    TVar(_) => // bottom: `fail -> a` — the free var unifies with any consumer; the arm terminates
    OneShot,
    TUnit => // `abort -> !` (parsed TUnit) / unit — no value to abandon; Hβ.lower.uzero-unit-abandon names the rare genuine-unit case
    OneShot,
    _ => // value-returning UZero (`abort -> Option`): the None must reach the install, not the perform site — the dead-continuation yield
    Abandon,
  },
}

// The op's declared return type, read from its EffectOpScheme's TFun —
// the one place the op's signature lives (Carried-Truth: read it live,
// never re-derive). A non-arrow scheme (never a real op) floors to TUnit.
fn scheme_ret_ty(scheme) = match judgment_ty(scheme) {
  TFun(_, ret, _) => ret,
  _ => TUnit,
}

// disc_join — the monotone op-level join: OneShot is the identity, MultiShot
// absorbs. Either is never produced by resume_grade, so it passes b through.
fn disc_join(a, b) = match a {
  MultiShot => MultiShot,
  Abandon => // M4 — the join order is OneShot < Abandon < MultiShot: any resuming arm
  // (MultiShot) dominates (the real-k path serves every catch); else any
  // abandoning arm makes the op Abandon; else OneShot. So an op with one
  // resume-once arm and one abandon arm in different handlers is MultiShot
  // (the perform can't know at lower which catches → the live-k path).
  match b {
    MultiShot => MultiShot,
    _ => Abandon,
  },
  OneShot => b,
  Either => b,
}

fn resume_grade(node) = match node {
  N(body, _, _) => match body {
    NExpr(ResumeExpr(_, _)) => UOne,
    NExpr(BlockExpr(stmts, final)) => usage_seq(grade_nodes(stmts), resume_grade(final)),
    NExpr(IfExpr(c, t, e)) => usage_seq(resume_grade(c), usage_join(resume_grade(t), resume_grade(e))),
    NExpr(MatchExpr(scrut, arms)) => usage_seq(resume_grade(scrut), grade_join_arms(arms)),
    NExpr(CallExpr(f, args)) => // THE CUT (bank Ruling 6): call-substitution — a call to a fn with a
    // resume summary contributes that summary (the classifier fixpoint
    // wrote it; summary_of answers UZero for unknown names, params, and
    // ops). This is what makes backtrack's try_each recursion saturate
    // to UMany by round 2 and lets an arm's grade see resumes in CALLED
    // fns (yield_inhabitants' shape) — the classifier gap closed.
    match f {
      N(fb, _, _) => {
        let callee_g = match fb {
          NExpr(VarRef(cn)) => summary_of(cn),
          _ => UZero,
        }
        usage_seq(callee_g, usage_seq(resume_grade(f), grade_nodes(args)))
      },
    },
    NExpr(BinOpExpr(_, l, r)) => usage_seq(resume_grade(l), resume_grade(r)),
    NExpr(UnaryOpExpr(_, x)) => resume_grade(x),
    NExpr(LambdaExpr(_, lbody)) => resume_grade(lbody),
    NExpr(MakeListExpr(elems)) => grade_nodes(elems),
    NExpr(MakeTupleExpr(elems)) => grade_nodes(elems),
    NExpr(MakeRecordExpr(fields)) => grade_fields(fields),
    NExpr(RecordUpdateExpr(base, fields)) => usage_seq(resume_grade(base), grade_fields(fields)),
    NExpr(NamedRecordExpr(_, fields)) => grade_fields(fields),
    NExpr(FieldExpr(b, _)) => resume_grade(b),
    NExpr(IndexExpr(receiver, index)) => usage_seq(resume_grade(receiver), resume_grade(index)),
    NExpr(PipeExpr(_, l, r)) => usage_seq(resume_grade(l), resume_grade(r)),
    NExpr(FanoutExpr(branches)) => grade_nodes(branches),
    NExpr(RestExpr(_)) => UZero,
    NExpr(MakeStringExpr(frags)) => grade_nodes(frags),
    NExpr(ShowExpr(inner)) => resume_grade(inner),
    NExpr(LabeledArg(_, v)) => resume_grade(v),
    NStmt(LetStmt(_, v, _)) => resume_grade(v),
    NStmt(ExprStmt(e)) => resume_grade(e),
    NStmt(FnStmt(_, _, _, _, _)) => // A nested fn DECLARATION is not an execution — its resumes count at
    // its CALL sites via the summary substitution (the pre-cut descend
    // double-counted a define-once-call-once helper into UMany).
    UZero,
    NStmt(TypeDefStmt(_, _)) => // Decls nested in an arm carry no resume of THIS arm's continuation; leaves
    // carry no children. Both are the grade identity UZero (explicit, never a
    // wildcard fabricating a grade for an un-enumerated child-bearing variant).
    UZero,
    NStmt(EffectDeclStmt(_, _, _)) => UZero,
    NStmt(HandlerDeclStmt(_, _, _, _, _)) => UZero,
    NStmt(ImportStmt(_)) => UZero,
    NStmt(RefineStmt(_, _, _)) => UZero,
    NStmt(AliasStmt(_, _)) => UZero,
    NStmt(RowAliasStmt(_, _)) => UZero,
    NExpr(LitInt(_)) => UZero,
    NExpr(LitFloat(_)) => UZero,
    NExpr(LitString(_)) => UZero,
    NExpr(LitBool(_)) => UZero,
    NExpr(LitUnit) => UZero,
    NExpr(VarRef(_)) => UZero,
    NExpr(ExprPlaceholder) => UZero,
    NHole(_) => UZero,
    NPat(_) => UZero,
    NModule(_) => UZero,
    NTypeAnn(_) => UZero,
  },
}

// Sequential composition over a node list (block stmts, call args, list
// elems, string frags): all execute on one path, so ⊗-combine. last/drop_last
// are the O(1) snoc-end reads, so the fold is O(N); usage_seq is order-
// insensitive (UMany absorbs, UZero is identity), so last-first is fine.
fn grade_nodes(nodes) = if len(nodes) == 0 {
  UZero
} else {
  usage_seq(resume_grade(last(nodes)), grade_nodes(drop_last(nodes)))
}

// Alternation over match arms ((pat, body) tuples): exactly one arm runs, so
// ⊔-join their grades — two resumes in sibling arms is still one per path.
fn grade_join_arms(arms) = if len(arms) == 0 {
  UZero
} else {
  match last(arms) {
    (_, b) => usage_join(resume_grade(b), grade_join_arms(drop_last(arms))),
  }
}

// Record fields ((name, value) tuples) all evaluate on one path — ⊗ the values.
fn grade_fields(fields) = if len(fields) == 0 {
  UZero
} else {
  match last(fields) {
    (_, v) => usage_seq(resume_grade(v), grade_fields(drop_last(fields))),
  }
}

// The inference primitive — every emergent property is cursor-
// projected from body structure, never authored as annotation. Per
// PLAN §2: "annotations declare INPUTS
// to the cursor; never the emergent property itself."
//
// Three companion substrates land alongside Phase B's resume-
// cardinality inference, completing the chain of cursor-projected
// emergent properties:
//
//   • Effect-row inference (Peer 1) — operational at infer_fn:343-420.
//     Body's perform sites accumulate via inf_add_row; declared row
//     compared against inferred via row_subsumes; T_OverDeclared
//     warns when authored row is wider than inferred. Authored row
//     is a CONSTRAINT (must contain inferred), never a contract.
//
//   • Ownership inference (Peer 2) — operational at own.mn's
//     infer_ownership. `Unmarked`-marked params get classify_usage
//     which counts var-uses in the body: 0 → Unmarked; 1 → Own
//     (affine consume); ≥2 → Ref (borrowed). Authored `own`/`ref`
//     is a constraint over the inferred form. THIS IS THE SAME
//     use-count lattice as resume cardinality: ownership reads the
//     grade (types.mn Usage) on a param's VarRefs, cardinality reads
//     it on an arm's ResumeExprs — UZero/UOne/UMany projecting to
//     Unmarked/Own/Ref and OneShot/OneShot/MultiShot respectively.
//     The continuation is just a value; its multiplicity IS its
//     ownership grade. resume_grade folds the grade compositionally
//     (⊗ sequence, ⊔ alternation); classify_usage counts syntactically
//     — collapsing both onto one `count_uses(is_use, body)` is the
//     named peer Hβ.infer.usage-grade-unifies-cardinality-ownership.
//
//   • Refinement narrowing (Peer 3 — this section) — flow-sensitive
//     predicate inference. Each narrowing site (if/match/assert)
//     adds a path-conditional predicate; the medium tracks per-
//     program-point refinement maps so lower's verify obligations
//     elide checks the path already proves.
//
// All four (resume + row + ownership + refinement) follow the same
// substrate pattern: WALK body structure, PREDICATE-FILTER witness
// sites, PROJECT aggregated value. Same shape as
// $collect_used_wasi_ops in the seed. The cursor IS the inference
// primitive.
//
// What this enables: the developer writes WHAT THEY MEAN — body
// structure + ground value types + effect names. Everything else
// (resume cardinality, effect rows, ownership, refinement bounds)
// is cursor-projected. Authored declarations BECOME CONSTRAINTS the
// inference verifies — never contracts the inference must reverse-
// engineer. The user-facing surface shrinks toward the irreducible.
//
// $infer_refinement_narrowing — Phase B.3 substrate. Flow-sensitive
// refinement inference; per-program-point refinement maps. Each
// narrowing site adds a path-conditional predicate to the relevant
// variable's refinement; downstream Verify obligations elide checks
// that the path already proves.
//
// Narrowing sites:
//   • `if pred { branch }`        — pred narrows scope of branch
//   • `if pred { } else { branch }` — !pred narrows else branch
//   • `match x { pat => body }`   — pat narrows x's type in body
//   • `assert(pred); rest`        — pred narrows rest of block
//   • function call with refinement-typed param — param's pred holds
//     in the called body's scope
//
// The narrowing WRITE is graph_narrow_set at the index site — one
// write, consumed live by lower's graph_narrow_at (Carried-Truth: no
// side-map re-deriving what the graph carries).
//
// Drift refused: 1 (no vtable; structural NodeKind walk); 6 (no
// primitive-type-special-case for refinement); 8 (Predicate is the
// ADT — no string-keyed pred-name flag); 9 (every NarrowingSite
// NExpr arm enumerated; no wildcard fabricating ()).
fn infer_refinement_narrowing(body) with GraphRead + GraphWrite + Memory + Alloc =
  walk_refinement(body, PTrue)

fn walk_refinement(node, path_pred) with Memory + Alloc = match node {
  N(body, _, _) => match body {
    NExpr(IfExpr(c, t, e)) => {
      let cond_pred = predicate_of_bool_expr(c)
      walk_refinement(c, path_pred)
      walk_refinement(t, conjunction(path_pred, cond_pred))
      walk_refinement(e, conjunction(path_pred, negation_of(cond_pred)))
    },
    NExpr(MatchExpr(scrut, arms)) => {
      walk_refinement(scrut, path_pred)
      walk_refinement_arms(scrut, arms, path_pred)
    },
    NExpr(BlockExpr(stmts, final)) => walk_refinement_block(stmts, final, path_pred),
    NExpr(CallExpr(f, args)) => {
      walk_refinement(f, path_pred)
      walk_refinement_args_with_param_preds(f, args, path_pred)
    },
    NExpr(BinOpExpr(_, l, r)) => {
      walk_refinement(l, path_pred)
      walk_refinement(r, path_pred)
    },
    NExpr(UnaryOpExpr(_, x)) => walk_refinement(x, path_pred),
    NExpr(LambdaExpr(_, lb)) => walk_refinement(lb, PTrue),
    NExpr(ResumeExpr(v, _)) => walk_refinement(v, path_pred),
    NExpr(MakeListExpr(elems)) => walk_refinement_list(elems, path_pred),
    NExpr(MakeTupleExpr(elems)) => walk_refinement_list(elems, path_pred),
    NExpr(MakeStringExpr(frags)) => walk_refinement_list(frags, path_pred),
    NExpr(ShowExpr(inner)) => walk_refinement(inner, path_pred),
    NExpr(IndexExpr(receiver, index)) => // An index site under a non-trivial path: record the path-predicate proven
    // to hold at the index node (graph_narrow_set), so lower's bounds-check read
    // (graph_narrow_at) elides the check the path already discharged (§4⑥:
    // "When i is refined to a proven-valid index, the compiler elides the bounds
    // check"). Carried-Truth: the narrowing is written ONCE here, read live at
    // lower — never re-derived. A trivial path (PTrue) records nothing (the 0
    // default = no narrowing = byte-identical un-elided load).
    // The narrowing WRITE was here — graph_narrow_set(ih, path-pred) on ANY
    // non-trivial path. It was doubly dead-and-wrong (panel, 2026-07-18):
    // narrowing_pred_handle descends PAnd's LEFT conjunct to the PTrue seed,
    // so the handle was always 0 and the write never fired; and had it fired,
    // it recorded predicates that say NOTHING about the index (`if x > 0 {
    // xs[i] }`) — an unsound elision licence. The real write requires a
    // structural discharge that the path predicate implies BOTH `0 <= index`
    // AND `index < len(receiver)` — the named peer
    // Hβ.infer.narrowing-write-requires-discharge. The weave (graph_narrow_set
    // /at) stays as its substrate; lower reads 0 → the checked entry.
    {
      walk_refinement(receiver, path_pred)
      walk_refinement(index, path_pred)
    },
    NExpr(MakeRecordExpr(fields)) => walk_refinement_fields(fields, path_pred),
    NExpr(RecordUpdateExpr(base, fields)) => {
      walk_refinement(base, path_pred)
      walk_refinement_fields(fields, path_pred)
    },
    NExpr(NamedRecordExpr(_, fields)) => walk_refinement_fields(fields, path_pred),
    NExpr(FieldExpr(b, _)) => walk_refinement(b, path_pred),
    NExpr(PipeExpr(_, l, r)) => {
      walk_refinement(l, path_pred)
      walk_refinement(r, path_pred)
    },
    NExpr(FanoutExpr(branches)) => walk_refinement_branches(branches, path_pred),
    NExpr(RestExpr(_)) => (),
    NStmt(LetStmt(_, v, _)) => walk_refinement(v, path_pred),
    NStmt(ExprStmt(e)) => walk_refinement(e, path_pred),
    NExpr(LitInt(_)) => (),
    NExpr(LitFloat(_)) => (),
    NExpr(LitString(_)) => (),
    NExpr(LitBool(_)) => (),
    NExpr(LitUnit) => (),
    NExpr(VarRef(_)) => (),
    NExpr(ExprPlaceholder) => (),
    NExpr(LabeledArg(_, v)) => walk_refinement(v, path_pred),
    NHole(_) => (),
    NPat(_) => (),
    NModule(_) => (),
    NStmt(FnStmt(_, _, _, _, fbody)) => // TOTAL over NodeBody/Stmt — a missing arm IS a drop to the loud
    // `unreachable` (the walk_refinement floor that blocked m3). A nested fn is
    // walked like a lambda: its body under a FRESH path (the enclosing path
    // predicate does not hold inside the callee). Declaration statements carry
    // no narrowable runtime expression; a type annotation is a Ty, not an expr.
    walk_refinement(fbody, PTrue),
    NStmt(TypeDefStmt(_, _)) => (),
    NStmt(EffectDeclStmt(_, _, _)) => (),
    NStmt(HandlerDeclStmt(_, _, _, _, _)) => (),
    NStmt(ImportStmt(_)) => (),
    NStmt(RefineStmt(_, _, _)) => (),
    NStmt(AliasStmt(_, _)) => (),
    NStmt(RowAliasStmt(_, _)) => (),
    NTypeAnn(_) => (),
  },
}

// Walk a Match — each arm gets its scrut narrowed by the arm's pattern
// before walking the arm body. The narrowing is per-arm-scope; once
// the arm body is walked, its refinement contributions don't leak
// to other arms (they're branch-disjoint; map-per-arm semantics).
fn walk_refinement_arms(scrut, arms, path_pred) with Memory + Alloc = if len(arms) == 0 {
  ()
} else {
  // A match arm is a (pat, body) TUPLE (parser push_node (pat, body); the
  // canonical destructure infer_match_arms uses) — positional, NOT a named
  // record. `arm.pat`/`arm.body` field-access floors resolve_field_offset on a
  // TTuple (→ the loud `unreachable` / a garbage slot). Destructure positionally.
  match last(arms) {
    (pat, body) => {
      let arm_pred = pattern_predicate_for(pat, scrut)
      walk_refinement(body, conjunction(path_pred, arm_pred))
      walk_refinement_arms(scrut, drop_last(arms), path_pred)
    },
  }
}

// Block walking — stmts may include `assert(pred)` which narrows the
// rest of the block. Threads path_pred through; each assert
// A fanout's branches walk under the SAME path predicate — parallel
// peers, no sequential strengthening between them.
fn walk_refinement_branches(branches, path_pred) with Memory + Alloc = if len(branches) == 0 {
  ()
} else {
  walk_refinement(last(branches), path_pred)
  walk_refinement_branches(drop_last(branches), path_pred)
}

// strengthens the predicate for subsequent stmts + final expression.
fn walk_refinement_block(stmts, final, path_pred) with Memory + Alloc = if len(stmts) == 0 {
  walk_refinement(final, path_pred)
} else {
  let stmt = last(stmts)
  let strengthened = strengthen_path_pred(path_pred, stmt)
  walk_refinement(stmt, path_pred)
  walk_refinement_block(drop_last(stmts), final, strengthened)
}

fn strengthen_path_pred(path_pred, stmt) with Memory + Alloc = match stmt {
  N(body, _, _) => match body {
    NStmt(ExprStmt(e)) => match e {
      N(ebody, _, _) => match ebody {
        NExpr(CallExpr(callee, args)) => if is_assert_call(callee) {
          conjunction(path_pred, predicate_of_assert_arg(args))
        } else {
          path_pred
        },
        _ => path_pred,
      },
    },
    _ => path_pred,
  },
}

// Function-arg walking — each arg's refinement type (if any) provides
// a predicate that holds in the called body's scope. The caller-side
// inference doesn't add the predicate to the caller's path_pred (the
// callee's body is independently walked); the relationship surfaces
// via signature unification at call site.
fn walk_refinement_args_with_param_preds(f, args, path_pred) with GraphRead + GraphWrite + Memory + Alloc =
  walk_refinement_list(args, path_pred)

fn walk_refinement_list(nodes, path_pred) with Memory + Alloc = if len(nodes) == 0 {
  ()
} else {
  walk_refinement(last(nodes), path_pred)
  walk_refinement_list(drop_last(nodes), path_pred)
}

fn walk_refinement_fields(fields, path_pred) with Memory + Alloc = if len(fields) == 0 {
  ()
} else {
  // A record-literal field is a (name, value) TUPLE (types.mn
  // MakeRecordExpr — sorted at parse), not a record — destructure it.
  // `.value` here was a field access on a tuple; the seed's weak
  // inference passed it silently and m2 trapped at the first record
  // literal under a refinement walk (the named record-literal face).
  match last(fields) {
    (_, value) => {
      walk_refinement(value, path_pred)
      walk_refinement_fields(drop_last(fields), path_pred)
    },
  }
}

// Helpers — peer-named substrate. Each is a small graph walk; the
// production-quality bodies fold into named peers as the inference
// cascade matures past the basic flow-narrowing form.
//
// $predicate_of_bool_expr — extract Predicate from boolean expression.
// Operates on graph-typed Bool nodes; converts BinOpExpr (==, <, >,
// &&, ||) and CallExpr (refinement predicates returning Bool) into
// Predicate ADT instances. Peer follow-up
// `Hβ.infer.predicate-from-bool-expression` covers the full case
// enumeration.
fn predicate_of_bool_expr(node) = PBoolNode(node_handle(node))

fn negation_of(pred) = PNot(pred)

fn conjunction(p, q) = PAnd(p, q)

fn pattern_predicate_for(pat, scrut) = PPatternMatch(pat, node_handle(scrut))

fn is_assert_call(callee) with Pure = match callee {
  N(body, _, _) => match body {
    NExpr(VarRef(name)) => name == "assert",
    _ => false,
  },
}

fn predicate_of_assert_arg(args) with Memory + Alloc =
  if len(args) == 0 { PTrue } else { predicate_of_bool_expr(last(args)) }

// Config is [TParam] (the fn-param carrier): the graph-registered var is
// minted HERE, superseding the parse-time placeholder, while the param's
// NAME and DEFAULT ride through unchanged — the default's one home is the
// TParam's fifth slot, read by resolve_call_args at every install that
// omits the field (SYNTAX §«Default parameter values»).
fn mint_handler_config_tparams(config, hname, base_idx) = map(
  (indexed) => match indexed {
    (i, p) => {
      let idx = base_idx + i
      let h = mint(FnParam(hname, idx, Inferred("config-param of '{hname}'")))
      TParam(param_name(p), TVar(h), Unmarked, Unmarked, param_default(p))
    },
  },
  enumerate(config)
)

// Utilities
fn infer_expr_list(ref nodes) = each(infer_expr, nodes)

fn collect_handles(ref nodes) = map(
  (node) => match node {
    N(_, _, h) => h,
  },
  nodes
)

fn collect_tvar_types(ref nodes) = map(
  (node) => match node {
    N(_, _, h) => TVar(h),
  },
  nodes
)

fn unify_list_elems(elems, target_h, span: ValidSpan) = each(
  (elem) => match elem {
    N(_, _, eh) => unify(eh, target_h, span, ListElement(Inferred("list element"))),
  },
  elems
)

// Each string-interpolation fragment binds to the canonical String
// alias node directly;
// post-Show-typeclass (peer Hβ.infer.show-typeclass), non-String
// splices register a Show obligation that verify_ledger discharges.
// IFC enforcement at string interpolation sites (§4⑥).
// For each splice (non-literal fragment), read the inferred Ty from the graph,
// classify its FlowLabel via query_flow_label, then emit verify(PFlowLe(label, Public)).
// predicate_decide(PFlowLe(label, Public)) = Some(flow_le(label, Public)) — the
// finite lattice makes this ALWAYS compile-time decidable. A Secret or Tainted
// splice surfaces as ERefinementRejected("Secret ⊑ Public") at compile time.
// Literal parts (LitString nodes) are always Public — no check needed.
// The judge-side mirror of lower's empty-literal elision: a fragment
// elides iff it is the "" literal the parser keeps for the alternation
// invariant. M surviving fragments need M−1 interior concat cells; the
// last concat re-keys to the interp node itself at lower, so the cells
// cover the interior joins only.
fn interp_concat_cells(fragments, span: ValidSpan) = {
  let m = count_nonempty_fragments(fragments, 0, 0)
  mint_concat_cells(if m > 1 { m - 1 } else { 0 }, span, [])
}

fn count_nonempty_fragments(fragments, i, acc) = if i >= len(fragments) {
  acc
} else {
  match graph_node_body(node_handle(list_index(fragments, i))) {
    NExpr(LitString(s)) => count_nonempty_fragments(fragments, i + 1, if byte_len(s) == 0 { acc } else { acc + 1 }),
    _ => count_nonempty_fragments(fragments, i + 1, acc + 1),
  }
}

fn mint_concat_cells(n, span: ValidSpan, acc) = if n <= 0 {
  acc
} else {
  // drift-audit: ignore — bounded by a string's fragment count, not a hot loop
  mint_concat_cells(
    n - 1,
    span,
    acc ++ [graph_fresh_ty(Located(span, Inferred("interp segment concat")))]
  )
}

fn check_splice_flow_labels(fragments, span: ValidSpan) = each(
  (frag) => match frag {
    N(body, fspan, fh) => match body {
      NExpr(LitString(_)) => // literal part: always Public, no IFC check
      (),
      NExpr(ShowExpr(inner)) => // the parser wraps every splice in ShowExpr, and the WRAPPER
      // binds to String — reading the wrapper's type classified every
      // splice Public and silently discharged the flow obligation (the
      // regression the DCC gate's first probe caught, 2026-08-08). The
      // label lives on the INNER node; read through the wrap.
      splice_flow_check(node_handle(inner), fspan),
      _ => // an unwrapped splice (pre-ShowExpr shapes): classify its own node
      splice_flow_check(fh, fspan),
    },
  },
  fragments
)

fn splice_flow_check(h, fspan: ValidSpan) = match graph_chase(h) {
  GNode(NBound(ty), _) => {
    let label = query_flow_label(ty)
    verify(fspan, PFlowLe(label, Public), Located(fspan, Inferred("ifc: string splice flow label")))
  },
  _ => // unresolved: open-world default = Public, no check needed
  (),
}

// Effect-name projection of a row — the handled-name set read live from
// a row's NRowBound. Used by pipeline.mn's reached-effect report.
fn row_names(row) with Pure = match row {
  EfRow(names, _, _) => names,
}

fn read_bound_row(handle) = match graph_chase(handle) {
  GNode(NRowBound(row), _) => row,
  _ => mk_ef_pure(),
}
