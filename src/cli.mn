// cli.mn — the verb grammar: argv → the typed Invocation (spec EH §1.4).
// Relocated from main.mn (PLAN §11 Phase 3.5, the mcp→main seam): one
// grammar serves two transports — the terminal entry parses argv, the
// MCP session parses its wire lines with the SAME parse_cli_args — so
// the grammar lives in a module both import; the entry keeps only the
// dispatch (running the proven verb is the entry's own job).
import strings

// ─── EntryVerb ADT — every variant carries the address it acts on ─────
//
// Each variant IS the entry-handler, structured. A target is a plain module
// name on EVERY variant that has one — never an Option — because the ADDRESS
// DEFAULTS AT THE GRAMMAR, which is the one boundary that can see the whole
// invocation. `mentl doc` means the project's entry exactly as ls means
// here; `target_at` resolves that once and downstream never asks again.
// It used to be an `Option` and five runners each carried the same
// `None => "main"` arm — one default with five homes, the Carried-Truth Law
// at the entry surface, and the illegal state (`""`, a missing target) was
// only ever unrepresentable on the required half. It is unrepresentable on
// both halves now. Dispatch matches the ADT structurally — never a string
// re-compare (drift 8): `parse_cli_args` proved the verb, dispatch reads
// that proof.
type EntryVerb
  = VEdit(String)
  | VDoc(String)
  | VServe
  | VSpace
  | VTighten(String)
  | VFmt(String)
  | VCompile(String)
  // a persisted image path — the file IS the argument
  | VResume(String)
  | VCompileStdin
  // target, then the program's own argv (everything after the target — the
  // executor hands it to the program as its args, NUL-joined at the seam)
  | VRun(String, [String])
  | VCheck(String)
  // the cursor-address form — `mentl lib/tutorial/09-all.mn:40:20`: target, line, col (0 = whole-line). Drift-38's endpoint: the address IS the surface; verbs are transports
  | VAt(String, Int, Int)
  | VTest(String)
  | VAudit(String)
  // the address and the question's WORDS — the shell already split them, so
  // the grammar carries the split. It carried one re-joined String until
  // 2026-09-21 and the question grammar split it again: the shell tokenized,
  // the CLI concatenated, the query grammar re-tokenized, and the quotes a
  // caller had to write (`mentl query f "why unify"`) were the invoice.
  | VQuery(String, [String])
  | VTeach(String)
  | VRepl
  // the medium judges its own generation
  | VMarch
  | VVerify(String)
  // the gate on MCP stdio — agents propose, nothing executes unproven
  | VMcp
  | VSession
  // project name — required
  | VNew(String)
  // handler name, then the address it installs over
  | VWith(String, String)
  // bare tty invocation / `mentl help` —
  // the directory PROJECTION, never a hang
  | VWelcome

type EntryHandlerInvocation = Invocation(EntryVerb) | ParseError(String)

// ─── The two tables — the kernel's two operations, at the shell ───────
//
// The kernel has two operations (`PLAN.md §2` — draw an edge, project), so
// the surface has two shapes and no third:
//
//   mentl <address> [question…]   PROJECT — read the graph at a position
//   mentl <action> [args…]        DRAW AN EDGE — run, compile, fmt, new
//
// An ADDRESS is a directory, a module, a file, a `file:line`, or a
// `file:line:col`; the question is the words after it, and with no question
// the address projects itself. So "query" is not a verb — it is the ABSENCE
// of one, and "why" and "where" were the same read a third and fourth time:
// each took a path and a name, re-serialized its own proof into the string
// "why NAME", and handed it to the question grammar to classify again.
// Three verbs, one read, measured byte-identical before the deletion.
//
// A question NAMES a projection (check, audit, doc, teach, verify) or it is a
// facet of the query grammar (why, where, census, decls, … — the question
// grammar classifies it). Both reach an address; neither is a verb.
// `VerbSpec` carries the action rows, `QuestionSpec` the named projections,
// and the catalog projects both — so the help a developer reads shows the
// kernel's own two operations instead of hiding them behind twenty-four
// words.
//
// A VerbSpec carries the verb's name, its argument hint (for the help line),
// the BUILDER that projects argv → the typed Invocation (or a ParseError that
// names the missing argument), and its one-line description. The builder is a
// first-class effectful CLOSURE stored in the field — the medium carries
// functions-with-their-rows through data (the same capability handlers rest
// on), so the verb→construction edge is the graph's own edge, never a tag a
// second pass re-derives. parse_cli_args finds by name and RUNS the closure;
// verb_catalog projects each row into the help surface. The verb set has ONE
// home; the help text and the parser were two hand-maintained copies that
// could drift, and now both read this table (Carried-Truth Law: one home, and
// every reader is a projection of it). Adding a verb is ONE row here plus its
// runner arm in dispatch_invocation.
type VerbSpec = VerbSpec(name: String, hint: String, build: ([String]) -> EntryHandlerInvocation, help: String)

// req_target — the shape of an action whose address is REQUIRED (`compile`):
// argv[2] resolved to a module, or a ParseError that names the verb and shows
// its usage. `mk` builds the variant from the resolved module. An edge needs
// something to be drawn on; a READ does not, because its address defaults.
fn req_target(argv, mk, msg) with Memory + Alloc =
  if len(argv) >= 3 { Invocation(mk(path_to_module(argv[2]))) } else { ParseError(msg) }

// The run verb keeps everything after its target: those words are the
// PROGRAM's argv, not the wheel's, and the executor passes them through.
fn run_verb_args(a) with Memory + Alloc = if len(a) >= 3 {
  Invocation(VRun(path_to_module(a[2]), drop(3, a)))
} else {
  ParseError("run needs a target: mentl run <path> [args…]")
}

// A named projection: the word, the builder that takes the resolved ADDRESS
// and returns the verb, and the help line. It needs no argument hint and can
// raise no ParseError, because its one argument is the address the grammar
// already resolved — `target_at` defaults it to the project, so a question
// always has something to be about.
type QuestionSpec = QuestionSpec(name: String, verb: (String) -> EntryVerb, help: String)

fn question_specs() with Memory + Alloc = [QuestionSpec("check", VCheck, "diagnostics only, no emit"), QuestionSpec("audit", VAudit, "the capability set + severance unlocks"), QuestionSpec("doc", VDoc, "documentation projection"), QuestionSpec("teach", VTeach, "the gradient narrated"), QuestionSpec(
  "verify",
  VVerify,
  "the standing bounds the medium keeps on its own source — a rise REFUSES"
)]

// ask_at — the ONE read: an address, and the words asked of it. No words is
// the address projecting itself (the whole-module read `mentl <file>:0`
// already served, now reachable by naming the file). A named projection
// builds its own verb; anything else is the query grammar's, carried as the
// WORDS the shell split rather than a string it would have to split again.
fn ask_at(target, words) with Memory + Alloc = if len(words) == 0 {
  Invocation(VAt(target, 0, 0))
} else {
  match find({ QuestionSpec{name: n} => n == words[0] }, question_specs()) {
    Some(QuestionSpec{verb: build}) => Invocation(build(target)),
    None => Invocation(VQuery(target, words)),
  }
}

// The verbs, in help-presentation order (the parser matches by name, so order
// here is the human's reading order, never the dispatch order). A `""` hint is
// a no-argument verb.
fn verb_specs() with Memory + Alloc = [VerbSpec(
  "run",
  "<path> [args…]",
  run_verb_args,
  "compile, prove, execute (a hole or refuted claim REFUSES)"
), VerbSpec(
  "compile",
  "<path>",
  (a) => req_target(a, VCompile, "compile needs a target: mentl compile <path>"),
  "emit WAT to stdout"
), VerbSpec(
  "resume",
  "<image>",
  (a) => if len(a) >= 3 {
    Invocation(VResume(a[2]))
  } else {
    ParseError("resume needs an image: mentl resume <image>")
  },
  "re-enter a persisted image; the source need not exist"
), VerbSpec(
  "edit",
  "[path]",
  (a) => Invocation(VEdit(target_at(a, 2, "main"))),
  "the cursor session (eight aspects + proven proposals)"
), VerbSpec("test", "[path]", (a) => Invocation(VTest(target_at(a, 2, "test"))), "the test chain"), VerbSpec(
  "new",
  "<name>",
  (a) => if len(a) >= 3 { Invocation(VNew(a[2])) } else { ParseError("new needs a name: mentl new <name>") },
  "write <name>.mn here (one file; the imports are the manifest)"
), VerbSpec(
  "session",
  "",
  (a) => Invocation(VSession),
  "the resident graph — read verbs answer live; run it in a project"
), VerbSpec("serve", "", (a) => Invocation(VServe), "the transport server"), VerbSpec(
  "space",
  "",
  (a) => Invocation(VSpace),
  "the ide, served — open http://localhost:7378/ide/"
), VerbSpec(
  "tighten",
  "[path]",
  (a) => Invocation(VTighten(target_at(a, 2, "main"))),
  "apply the first proven row tightening — the medium authors, you accept"
), VerbSpec(
  "fmt",
  "<path>",
  (a) => if len(a) >= 3 {
    Invocation(VFmt(a[2]))
  } else {
    ParseError("fmt needs a target: mentl fmt <path>")
  },
  "render the file canonical — layout is projection, never contract"
), VerbSpec("repl", "", (a) => Invocation(VRepl), "line REPL"), VerbSpec(
  "march",
  "",
  (a) => Invocation(VMarch),
  "judge the wheel: emit, compare against the last generation, verdict"
), VerbSpec(
  "mcp",
  "",
  (a) => Invocation(VMcp),
  "the gate on MCP stdio — agents propose, nothing executes unproven"
), VerbSpec(
  "--with",
  "<handler> [path]",
  (a) => if len(a) >= 3 {
    Invocation(VWith(a[2], target_at(a, 3, "main")))
  } else {
    ParseError("--with needs a handler: mentl --with <handler> [path]")
  },
  "install any handler over any verb"
), VerbSpec("help", "", (a) => Invocation(VWelcome), "this projection")]

// find_verb — the name → spec projection over the action table. The prelude's
// own `find` IS this walk; a hand-rolled `last`/`drop_last` recursion stood
// here and was one more index-threaded self-call in a module whose whole
// subject is not re-deriving what already exists.
fn find_verb(name, specs) with Memory + Alloc = find({ VerbSpec{name: n} => n == name }, specs)

// ─── argv parsing ─────────────────────────────────────────────────
//
// Projects argv to the EntryVerb ADT at the ONE boundary. Bare `mentl` →
// VCompileStdin (Unix `cmd <input`). `--with <name>` is the universal
// escape hatch. A target-requiring verb given no target is a ParseError
// here (the one boundary), never a fabricated "" downstream.
fn parse_cli_args(argv) with Memory + Alloc = if len(argv) < 2 {
  Invocation(VCompileStdin)
} else {
  let mode = argv[1]
  // The cursor-address probe FIRST — `mentl <target>:<line>[:<col>]` is
  // the medium's primary surface (drift-38: projections fire AT-CURSOR;
  // the named verbs are transports). The parse is shape-only; the runner
  // resolves the target exactly like every verb and refuses honestly.
  match parse_address(mode) {
    Some(addr) => match addr {
      (target, line, col) => Invocation(VAt(path_to_module(target), line, col)),
    },
    None => // Then the ACTIONS — the edges the shell can draw. Normalize the help
    // aliases to the canonical name, find the spec, run its builder.
    {
      let name = if mode == "-h" || mode == "--help" { "help" } else { mode }
      match find_verb(name, verb_specs()) {
        Some(VerbSpec{build}) => build(argv),
        None => // Not an action, so it is a READ, and the only question is whose
        // address. A named projection standing alone asks about the project
        // (`mentl verify`, `mentl check` — the address defaults exactly as
        // ls defaults to here); anything else IS the address, and the words
        // after it are the question. There is no unrecognized-command arm
        // left to write: an address that resolves to nothing refuses by
        // NAMING what it could not read, which teaches where a roster of
        // twenty-four words could only list itself.
        match find({ QuestionSpec{name: n} => n == mode }, question_specs()) {
          Some(QuestionSpec{verb: build}) => if len(argv) > 2 {
            // The address comes FIRST, with no exception, because the
            // alternative is two spellings of one read — and the one that
            // keeps the address in front is the one a developer can live in:
            // the address stays put while the question changes, so the loop is
            // an edit of the last word rather than a retype of the middle.
            // The retired spelling teaches through the general diagnostic
            // exactly as the perform keyword, the handle keyword and the
            // turbofish do (SYNTAX §«Invoking effect operations»): no bespoke
            // recognizer that half-works, one refusal that says the form.
            ParseError("the address comes first — try `mentl " ++ argv[2] ++ " " ++ mode ++ "`")
          } else {
            Invocation(build("main"))
          },
          None => ask_at(path_to_module(mode), drop(2, argv)),
        },
      }
    },
  }
}

// The address shape — `<target>:<line>` or `<target>:<line>:<col>`, both
// numeric segments all-digits. Shape parse only (a byte walk over the flat
// string); existence/resolution is the runner's question. Returns None for
// anything else, falling through to the verb ladder.
fn parse_address(ref s) with Memory + Alloc = {
  let n = byte_len(s)
  let c1 = addr_colon_from(s, 0, n)
  if c1 <= 0 {
    None
  } else {
    let c2 = addr_colon_from(s, c1 + 1, n)
    if c2 < 0 {
      match addr_int(s, c1 + 1, n) {
        Some(line) => Some((str_slice(s, 0, c1), line, 0)),
        None => None,
      }
    } else {
      match addr_int(s, c1 + 1, c2) {
        Some(line) => match addr_int(s, c2 + 1, n) {
          Some(col) => Some((str_slice(s, 0, c1), line, col)),
          None => None,
        },
        None => None,
      }
    }
  }
}

// The first ':' at or after i; -1 when none.
fn addr_colon_from(ref s, i, n) with Memory =
  if i >= n { 0 - 1 } else if byte_at(s, i) == 58 { i } else { addr_colon_from(s, i + 1, n) }

// The all-digits segment [i, end) as Some(value); None when empty or any
// non-digit byte (so `web:site.mn` never parses as an address).
fn addr_int(ref s, i, end) with Memory + Alloc =
  if i >= end { None } else { addr_int_loop(s, i, end, 0) }

fn addr_int_loop(ref s, i, end, acc) with Memory + Alloc = if i >= end {
  Some(acc)
} else {
  let ch = byte_at(s, i)
  if ch >= 48 && ch <= 57 { addr_int_loop(s, i + 1, end, acc * 10 + (ch - 48)) } else { None }
}

// target_at — the address at `idx`, or the default when the invocation named
// none. THE DEFAULT RESOLVES HERE, once: five runners each carried their own
// `None => "main"` arm behind an `Option`, which is one fact with five homes
// and a nullable target flowing through every one of them. The grammar is the
// only boundary that sees the whole invocation, so it is the only place the
// default belongs.
fn target_at(argv, idx, fallback) with Memory + Alloc =
  if len(argv) > idx { path_to_module(argv[idx]) } else { fallback }

// path_to_module — accept either a module name ("main") or a file
// path ("src/main.mn"). Strip "src/" or "lib/" prefix and ".mn"
// suffix when present. Idempotent on bare module names.
fn path_to_module(arg) with Alloc + Memory = {
  let stripped_prefix = if starts_with(arg, "src/") {
    str_slice(arg, 4, byte_len(arg))
  } else if starts_with(arg, "lib/") {
    str_slice(arg, 4, byte_len(arg))
  } else {
    arg
  }
  if ends_with(stripped_prefix, ".mn") {
    str_slice(stripped_prefix, 0, byte_len(stripped_prefix) - 3)
  } else {
    stripped_prefix
  }
}
