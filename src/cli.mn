// cli.mn — the verb grammar: argv → the typed Invocation (spec EH §1.4).
// Relocated from main.mn (PLAN §11 Phase 3.5, the mcp→main seam): one
// grammar serves two transports — the terminal entry parses argv, the
// MCP session parses its wire lines with the SAME parse_cli_args — so
// the grammar lives in a module both import; the entry keeps only the
// dispatch (running the proven verb is the entry's own job).
import strings

// ─── EntryVerb ADT — the verb carries its target where required ───────
//
// Each variant IS the entry-handler, structured. A target-requiring verb
// (Compile/Run/Check/Audit/Query) carries its module name as a NON-OPTION
// field — so "compile with no target" is unrepresentable; no `""` sentinel
// can flow downstream (Anchor 2: the illegal state is deleted at the type
// level, not fabricated and re-checked). Verbs with an optional target
// (Edit/Doc/Teach/Test) carry an Option; verbs with none (Serve/Repl) carry
// nothing. Dispatch matches the ADT structurally — never a string re-compare
// (drift 8): parse_cli_args proved the verb, and dispatch reads that proof.
type EntryVerb
  // target optional → default "main"
  = VEdit(Option(String))
  | VDoc(Option(String))
  | VServe
  // the View at an address — `mentl space <path>:<line>[:<col>] [<needle>]`
  // writes it as JSON (space.mn); bare `mentl space` is the page, the mentl
  // command's
  | VSpace(Option(SpaceAt))
  | VTighten(Option(String))
  // the paths to render canonical — none is the project, the working
  // directory's tree; `--check` writes nothing and lists what is not
  | VFmt(FmtMode, [String])
  // target REQUIRED — carried non-optionally
  | VCompile(String)
  // the WAT file to assemble; absent means stdin
  | VAsm(Option(String))
  // a persisted image path — the file IS the argument
  | VResume(String)
  | VCompileStdin
  // target, then the program's own argv (everything after the target — the
  // executor hands it to the program as its args, NUL-joined at the seam)
  | VRun(String, [String])
  // no target judges the PROJECT (its `main`, wherever the resolver finds it);
  // a target judges that entry's link — every module of it reports either way
  | VCheck(Option(String))
  // the cursor-address form — `mentl lib/tutorial/09-all.mn:40:20`: target, line, col (0 = whole-line). Drift-38's endpoint: the address IS the surface; verbs are transports
  | VAt(String, Int, Int)
  // the accept form — `mentl accept <path>:<line>:<col>`: the second graph
  // operation surfaced beside the first. `mentl <address>` PROJECTS the
  // position; `mentl accept <address>` DRAWS the accept edge there (C4)
  | VAccept(String, Int, Int)
  | VTest(Option(String))
  | VAudit(String)
  // target, question — both required
  | VQuery(String, String)
  | VTeach(Option(String))
  | VRepl
  // the medium judges its own generation
  | VMarch
  | VVerify(Option(String))
  // the gate on MCP stdio — agents propose, nothing executes unproven
  | VMcp
  | VSession
  // project name — required
  | VNew(String)
  // handler name, optional target
  | VWith(String, Option(String))
  // bare tty invocation / `mentl help` —
  // the directory PROJECTION, never a hang
  | VWelcome

type EntryHandlerInvocation = Invocation(EntryVerb) | ParseError(String)

// ─── The verb table — ONE home the parser AND the help project ────────
//
// A VerbSpec carries the verb's name, its argument hint (for the help line),
// the BUILDER that projects the words after the verb's name → the typed
// Invocation (or a ParseError that names the missing argument), and its
// one-line description. Each builder takes its words apart by pattern, so a
// word it reads is one the list proved it holds. The builder is a
// first-class effectful CLOSURE stored in the field — the medium carries
// functions-with-their-rows through data (the same capability handlers rest
// on), so the verb→construction edge is the graph's own edge, never a tag a
// second pass re-derives. parse_cli_args finds by name and RUNS the closure;
// verb_catalog projects each row into the help surface. The verb set has ONE
// home; the help text and the parser were two hand-maintained copies that
// could drift, and now both read this table (Carried-Truth Law: one home, and
// every reader is a projection of it). Adding a verb is ONE row here plus its
// runner arm in dispatch_invocation.
type VerbSpec = VerbSpec(String, String, ([String]) -> EntryHandlerInvocation, String)

// The target-REQUIRED verbs (compile / audit): the first word resolved to a
// module, or a ParseError that names the verb and shows its usage. `mk`
// builds the variant from the resolved module.
fn req_target(words, mk, msg) = match words {
  [target, ..._] => Invocation(mk(path_to_module(target))),
  [] => ParseError(msg),
}

// The target-OPTIONAL verbs (check / edit / teach / doc / test / tighten /
// verify): the first word as a module when there is one.
fn opt_target(mk, words) = Invocation(mk(optional_target(words)))

// The verbs that take no words.
fn bare_verb(verb, words) = Invocation(verb)

// The run verb keeps everything after its target: those words are the
// PROGRAM's argv, not the wheel's, and the executor passes them through.
fn run_verb_args(words) = match words {
  [target, ...args] => Invocation(VRun(path_to_module(target), args)),
  [] => ParseError("run needs a target: mentl run <path> [args…]"),
}

// Assembly takes a WAT file path as-is, or stdin when no file is named.
fn asm_verb_args(words) = Invocation(VAsm(first_of(words)))

fn where_verb_args(words) = match words {
  [target, name, ..._] => Invocation(VQuery(path_to_module(target), "where {name}")),
  short => ParseError("where needs a target and a name: mentl where <path> <name>"),
}

// The bare why verb (SYNTAX's lag list, first name retired): the same
// Reason-chain walk the query facet serves, surfaced as its own verb.
fn why_verb_args(words) = match words {
  [target, name, ..._] => Invocation(VQuery(path_to_module(target), "why {name}")),
  short => ParseError("why needs a target and a name: mentl why <path> <name>"),
}

// The accept verb's subject is an ADDRESS, parsed by the same shape read the
// bare address form uses; a bare path with no line names no position to
// accept at, and says so.
fn accept_verb_args(words) = match words {
  [at, ..._] => match parse_address(at) {
    Some((target, line, col)) => Invocation(VAccept(path_to_module(target), line, col)),
    None => ParseError("accept needs an address: mentl accept <path>:<line>:<col>"),
  },
  [] => ParseError("accept needs an address: mentl accept <path>:<line>:<col>"),
}

// Where a View is asked for: the module, the line and column, and the needle
// a find typed — the name whose references the View carries, beside the
// string literals holding it — when one was.
type SpaceAt = SpaceAt(String, Int, Int, Option(String))

// The space verb's subject is an ADDRESS when one is given — the same shape
// the bare address form reads — and nothing otherwise (the page). A word
// that is not an address names no position and says so. A word after the
// address is a needle to find.
fn space_verb_args(words) = match words {
  [at, ...more] => match parse_address(at) {
    Some((target, line, col)) => Invocation(VSpace(Some(SpaceAt(path_to_module(target), line, col, first_of(more))))),
    None => ParseError("space takes an address: mentl space <path>:<line>[:<col>] — the page itself is `mentl space` with no argument"),
  },
  [] => Invocation(VSpace(None)),
}

fn first_of(words) = match words {
  [w, ..._] => Some(w),
  [] => None,
}

// The verbs, in help-presentation order (the parser matches by name, so order
// here is the human's reading order, never the dispatch order). A `""` hint is
// a no-argument verb.
fn verb_specs() = [
  VerbSpec(
    "run",
    "<path> [args…]",
    run_verb_args,
    "compile, prove, execute — the mentl command runs the module (a hole or refuted claim REFUSES)"
  ),
  VerbSpec(
    "check",
    "[path]",
    opt_target(VCheck, ??),
    "diagnostics over every module of the link, no emit — no path: the project"
  ),
  VerbSpec(
    "compile",
    "<path>",
    req_target(??, VCompile, "compile needs a target: mentl compile <path>"),
    "emit WAT to stdout"
  ),
  VerbSpec("asm", "[file.wat]", asm_verb_args, "assemble WAT to wasm bytes on stdout"),
  VerbSpec(
    "resume",
    "<image>",
    {
      [image, ..._] => Invocation(VResume(image)),
      [] => ParseError("resume needs an image: mentl resume <image>"),
    },
    "re-enter a persisted image; the source need not exist"
  ),
  VerbSpec(
    "edit",
    "[path]",
    opt_target(VEdit, ??),
    "the cursor session (eight aspects + proven proposals)"
  ),
  VerbSpec(
    "accept",
    "<path>:<line>:<col>",
    accept_verb_args,
    "accept the one proven proposal at the address — a graph edge first, the text its projection"
  ),
  VerbSpec(
    "audit",
    "<path>",
    req_target(??, VAudit, "audit needs a target: mentl audit <path>"),
    "the capability set + severance unlocks"
  ),
  VerbSpec(
    "query",
    "<path> <question>",
    {
      [target, question, ..._] => Invocation(VQuery(path_to_module(target), question)),
      short => ParseError("query needs a target and a question: mentl query <path> <question>"),
    },
    "why / type / effects / ownership, walked to your words; `… in <module>` keeps one module's sites; a directory: a site facet across its programs"
  ),
  VerbSpec(
    "where",
    "<path> <name>",
    where_verb_args,
    "derived badges — repr width, resume cardinality, fanout schedules"
  ),
  VerbSpec("why", "<path> <name>", why_verb_args, "the Reason chain walked to root"),
  VerbSpec("teach", "[path]", opt_target(VTeach, ??), "the gradient narrated"),
  VerbSpec("doc", "[path]", opt_target(VDoc, ??), "documentation projection"),
  VerbSpec("test", "[path]", opt_target(VTest, ??), "the test chain"),
  VerbSpec(
    "new",
    "<name>",
    { [name, ..._] => Invocation(VNew(name)), [] => ParseError("new needs a name: mentl new <name>") },
    "write <name>.mn here (one file; the imports are the manifest)"
  ),
  VerbSpec(
    "session",
    "",
    bare_verb(VSession, ??),
    "the resident graph — read verbs answer live; run it in a project"
  ),
  VerbSpec("serve", "", bare_verb(VServe, ??), "the transport server"),
  VerbSpec(
    "space",
    "[<path>:<line>[:<col>] [needle]]",
    space_verb_args,
    "the ide — bare, the mentl command stages the page (ide/space.manifest) and serves it; at an address, the View the page paints, as JSON (line 0 carries the canvas; a needle, its references)"
  ),
  VerbSpec(
    "tighten",
    "[path]",
    opt_target(VTighten, ??),
    "author each declared row's residue — its negations and pins; the positive row is projected"
  ),
  VerbSpec(
    "fmt",
    "[--check] [path…]",
    fmt_verb_args,
    "render the project canonical (no path: this directory's tree) — layout is projection, never contract; --check writes nothing and lists what is not"
  ),
  VerbSpec("repl", "", bare_verb(VRepl, ??), "line REPL"),
  VerbSpec(
    "march",
    "",
    bare_verb(VMarch, ??),
    "judge the wheel: emit, compare against the last generation, verdict"
  ),
  VerbSpec(
    "verify",
    "[path]",
    opt_target(VVerify, ??),
    "the standing bounds the medium keeps on its own source — a rise REFUSES"
  ),
  VerbSpec(
    "mcp",
    "",
    bare_verb(VMcp, ??),
    "the gate on MCP stdio — agents propose, nothing executes unproven"
  ),
  VerbSpec(
    "--with",
    "<handler> [path]",
    {
      [handler_name, ...more] => Invocation(VWith(handler_name, optional_target(more))),
      [] => ParseError("--with needs a handler: mentl --with <handler> [path]"),
    },
    "install any handler over any verb"
  ),
  VerbSpec("help", "", bare_verb(VWelcome, ??), "this projection")
]

// The spec a verb's name names; names are unique, so the first is the one.
fn find_verb(name, specs) = find(verb_named(name, ??), specs)

fn verb_named(name, spec) = match spec {
  VerbSpec(verb, hint, build, about) => verb == name,
}

// ─── argv parsing ─────────────────────────────────────────────────
//
// Projects argv to the EntryVerb ADT at the ONE boundary. Bare `mentl` →
// VCompileStdin (Unix `cmd <input`). `--with <name>` is the universal
// escape hatch. A target-requiring verb given no target is a ParseError
// here (the one boundary), never a fabricated "" downstream.
fn parse_cli_args(argv) = match argv {
  [program, mode, ...words] => // The cursor-address probe FIRST — `mentl <target>:<line>[:<col>]` is
  // the medium's primary surface (drift-38: projections fire AT-CURSOR;
  // the named verbs are transports). The parse is shape-only; the runner
  // resolves the target exactly like every verb and refuses honestly.
  match parse_address(mode) {
    Some((target, line, col)) => Invocation(VAt(path_to_module(target), line, col)),
    None => // The verb ladder is ONE table projection (verb_specs): normalize the
    // help aliases to the canonical name, find the spec, run its builder over
    // the words after the verb. An unknown name is the honest ParseError —
    // never a fabricated fallback.
    {
      let name = if mode == "-h" || mode == "--help" { "help" } else { mode }
      match find_verb(name, verb_specs()) {
        Some(VerbSpec(verb, hint, build, about)) => build(words),
        None => ParseError("unrecognized or under-specified command: " ++ mode),
      }
    },
  },
  bare => Invocation(VCompileStdin),
}

// The address shape — `<target>:<line>` or `<target>:<line>:<col>`, both
// numeric segments all-digits. Shape parse only; existence and resolution are
// the runner's question. None for anything else, falling through to the verb
// ladder.
fn parse_address(s) = {
  let c1 = index_of(s, ":")
  if c1 <= 0 {
    None
  } else {
    let target = str_slice(s, 0, c1)
    let place = str_slice(s, c1 + 1, byte_len(s))
    let c2 = index_of(place, ":")
    if c2 < 0 {
      match addr_int(place) {
        Some(line) => Some((target, line, 0)),
        None => None,
      }
    } else {
      match addr_int(str_slice(place, 0, c2)) {
        Some(line) => match addr_int(str_slice(place, c2 + 1, byte_len(place))) {
          Some(col) => Some((target, line, col)),
          None => None,
        },
        None => None,
      }
    }
  }
}

// An all-digits segment as Some(value); None when empty or any byte is not a
// digit (so `web:site.mn` never parses as an address).
fn addr_int(segment) =
  if byte_len(segment) == 0 { None } else { fold(Some(0), addr_digit, segment) }

fn addr_digit(acc, ch) = match acc {
  Some(v) => if ch >= 48 && ch <= 57 { Some(v * 10 + (ch - 48)) } else { None },
  None => None,
}

// What `mentl fmt` does with a render that differs from its source: write
// it, or name it and write nothing — the form a commit hook and the board
// read.
type FmtMode = FmtWrite | FmtCheck

// `fmt [--check] [path…]` — the paths are files or directories, kept as
// written, since fmt reads files and judges no module.
fn fmt_verb_args(words) = match words {
  ["--check", ...paths] => Invocation(VFmt(FmtCheck, paths)),
  paths => Invocation(VFmt(FmtWrite, paths)),
}

// The first word as a module name when there is one: src/ or lib/ and .mn
// stripped (path_to_module).
fn optional_target(words) = match words {
  [target, ..._] => Some(path_to_module(target)),
  [] => None,
}

// path_to_module — accept either a module name ("main") or a file
// path ("src/main.mn"). Strip "src/" or "lib/" prefix and ".mn"
// suffix when present. Idempotent on bare module names.
fn path_to_module(arg) = {
  let stripped_prefix = if starts_with(arg, "src/") {
    str_slice(arg, 4, byte_len(arg))
  } else if starts_with(arg, "lib/") {
    str_slice(arg, 4, byte_len(arg))
  } else {
    arg
  }
  if ends_with(stripped_prefix, ".mn") {
    str_slice(stripped_prefix, 0, byte_len(stripped_prefix) - 3)
  } else {
    stripped_prefix
  }
}
