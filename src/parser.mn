// parser.mn — recursive descent, builds types.mn Nodes directly (spec 03)
//
// The parser produces types.mn's Node ADT directly. No intermediate
// "parser AST." Every construction performs graph_fresh_ty(
// Placeholder(span)) to mint a handle at parse time — inference
// binds the handle once the expression's type is known (one-walk
// HM). Every node has a full Span (spec 03 non-negotiable).
//
// Declares: with GraphWrite + Diagnostic.
// Errors follow Hazel: a parse failure emits report(...) and plants
// an NHole; parsing continues. Ten syntax errors → ten holes.
import types

import effects

import graph

import canon

import lexer

// Handle minting and node wrapping
fn fresh_handle(span: ValidSpan) = {
  let h = graph_fresh_ty(Placeholder(span))
  graph_index_span(span, h)
  h
}

// Every node is born here: mint its handle, edge-link its body into the
// one graph (graph_register_node at the handle), and wrap it. The body is
// registered AND carried in N — one heap object, two references (the AST
// projection in N, the graph weave keyed by handle), never a copy — so
// resolving the handle (graph_node_body) reads the same body the tree holds.
fn mint_node(body, span: ValidSpan) = {
  let h = fresh_handle(span)
  graph_register_node(h, body)
  N(body, span, h)
}

fn nexpr(e, span: ValidSpan) = mint_node(NExpr(e), span)

// A statement's birth, and so the one place a DECLARATION comes into being:
// a statement that declares a name is noted in the declarations column here,
// once, since nothing parses a statement twice.
fn nstmt(s, span: ValidSpan) = {
  let node = mint_node(NStmt(s), span)
  match node {
    N{body, handle: h} => if body_decl_name(body) == "" { () } else { graph_decl_note(h) },
  }
  node
}

fn nhole(id, span: ValidSpan) = mint_node(NHole(id), span)

fn npat(p, span: ValidSpan) = mint_node(NPat(p), span)

// Token navigation
// Tokens are typed: `Tok(TokenKind, Span)`. Helpers extract payload
// or compare kinds. Per SYNTAX.md, dispatch uses exhaustive match
// on TokenKind variants — no string equality at parse time.
//
// kind_at returns the TokenKind variant at position pos (or TEof if past end).
fn kind_at(ref tokens, pos) = if pos >= len(tokens) { TEof } else { token_kind(tokens[pos]) }

// span_at returns the span of the token at position pos. The producer
// carries the proof (`-> ValidSpan`): ONE honest obligation here — the
// token-stored span's validity, dischargeable when the lexer's mints
// carry the refinement — replaces the re-demanded copy every consumer
// boundary used to accrue.
fn span_at(ref tokens, pos) -> ValidSpan =
  if pos >= len(tokens) { span_zero() } else { token_span(tokens[pos]) }

// kind_eq compares two TokenKind values for variant identity. Used
// at the few sites where dispatch needs a passed-in kind value;
// most sites just pattern-match directly via `match kind_at(...)`.
// Constructor identity IS the value word. Every nullary TokenKind compiles
// to a distinct sentinel (HB: "the value-level tag is the discriminant"),
// and `==` is structural — type-dispatched at emit to `i32.eq` for an ADT
// operand. The kernel proves variant identity; the comparison reads it.
// `at` only ever compares against nullary kind literals, so value-word
// equality IS constructor equality.
fn kind_eq(a, b) with Pure = a == b

// at: predicate form of kind_eq for a position-and-expected pair.
fn at(ref tokens, pos, kind) = kind_eq(kind_at(tokens, pos), kind)

// A comment is graph content attached at the decl / block-statement boundary
// (parse_stmt / parse_block_body collect-and-attach BEFORE these skips run). At
// every OTHER position — interior of a match / record / handler-arm list — the
// comment's home is the enclosing block (SYNTAX.md Comments: "or, with none, the
// enclosing block"), so the fine-grained list parsers pass over it as layout,
// exactly as they pass over TNewline. Per-interior-position attachment to the
// enclosing block is the positive-form refinement Hβ.parser.interior-comment-
// to-enclosing-block.
fn skip_ws(ref tokens, pos) = match kind_at(tokens, pos) {
  TNewline => skip_ws(tokens, pos + 1),
  TComment(_) => skip_ws(tokens, pos + 1),
  _ => pos,
}

// The same walk backward — the dual skip_ws never had, and the reason a
// statement's extent could not be read off its closing index: that index is one
// PAST what it closes, and what sits there is usually layout, so joining to
// `p - 1` reached the following line and the address rendered a one-character
// slice of it.
fn skip_ws_back(ref tokens, pos) = if pos <= 0 {
  0
} else {
  match kind_at(tokens, pos) {
    TNewline => skip_ws_back(tokens, pos - 1),
    TComment(_) => skip_ws_back(tokens, pos - 1),
    _ => pos,
  }
}

fn skip_sep(ref tokens, pos) = match kind_at(tokens, pos) {
  TSemicolon => skip_sep(tokens, pos + 1),
  TNewline => skip_sep(tokens, pos + 1),
  TComment(_) => skip_sep(tokens, pos + 1),
  _ => pos,
}

// show_token_kind: human-readable name for diagnostics.
fn show_token_kind(k) with Pure = match k {
  TFn => "fn",
  TLet => "let",
  TIf => "if",
  TElse => "else",
  TMatch => "match",
  TType => "type",
  TEffect => "effect",
  THandler => "handler",
  TWith => "with",
  TResume => "resume",
  TImport => "import",
  TWhere => "where",
  TOwn => // drift-audit: ignore — human-facing token-display rendering, not effect keying; tracked by Hβ.perf.name-is-handle; token-rendering normalization
  "own",
  TRef => "ref",
  TPure => "Pure",
  TTrue => "true",
  TFalse => "false",
  TIdent(s) => s,
  TIntLit(_) => "<int>",
  TFloatLit(_) => "<float>",
  TStringLit(_) => "<string>",
  TComment(_) => "<comment>",
  TStringPart(_) => "<string-part>",
  TStringSplice => "<string-splice>",
  TEqEq => // drift-audit: ignore — TokenKind→display-text rendering for diagnostics; not runtime comparison; tracked by Hβ.perf.name-is-handle; token-rendering normalization
  "==",
  TBangEq => "!=",
  TLtEq => "<=",
  TGtEq => ">=",
  TArrow => "->",
  TFatArrow => "=>",
  TPlusPlus => "++",
  TPipeGt => "|>",
  TLtPipe => "<|",
  TGtLt => "><",
  TTildeGt => "~>",
  TLtTilde => "<~",
  TAndAnd => "&&",
  TOrOr => "||",
  TLParen => "(",
  TRParen => ")",
  TLBrace => "\{",
  TRBrace => "\}",
  TLBracket => "[",
  TRBracket => "]",
  TComma => ",",
  TDot => ".",
  TColon => ":",
  TSemicolon => ";",
  TPlus => "+",
  TMinus => "-",
  TStar => "*",
  TSlash => "/",
  TPercent => "%",
  TEq => "=",
  TLt => "<",
  TGt => ">",
  TBang => "!",
  TAmp => "&",
  TPipe => "|",
  TAt => "@",
  THole => "??",
  TNewline => "<newline>",
  TEof => "<eof>",
}

// expect: consume `kind`, or emit a Located P_ExpectedToken and recover.
// Productive-under-error (SYNTAX.md: diagnostics are teaching surfaces with
// coordinates + a Quick Fix) — on a mismatch the parser NARRATES the missing
// token (expected vs found, at the found token's span, MachineApplicable
// insert) and returns pos UNCHANGED so the surrounding production re-syncs
// from where it stood (no token swallowed). The .mn LEADS the seed: a silent
// expect was the no-diagnostic surrender shaped to the disposable hand-WAT
// arbiter (the named anti-pattern "never shape the .mn to the seed"); the
// ultimate form is MORE truth — the Why projection walks the P_ExpectedToken
// Reason back to this site. The recover-position is identical to the old
// behavior, so the parse TREE is byte-identical; only the diagnostic edge is
// added (the seed, downstream, simply does not emit it).
fn expect(ref tokens, pos, kind) = if at(tokens, pos, kind) {
  pos + 1
} else {
  report(PExpectedToken(
    "expected `{show_token_kind(kind)}`, found `{show_token_kind(kind_at(tokens, pos))}`",
    span_at(tokens, pos)
  ))
  pos
}

// Payload extractors — return defaults if the kind doesn't match.
// Most call sites should pattern-match directly via `match
// kind_at(tokens, pos) { TIdent(s) => …, TIntLit(n) => …, … }`;
// these helpers are for the few sites (e.g., parse_fn extracting
// the function name after dispatching past TFn) where the parent
// has already verified the variant and just needs the payload.
fn ident_at(ref tokens, pos) = match kind_at(tokens, pos) {
  TIdent(s) => s,
  _ => // drift-audit: ignore — "" = non-ident payload null (parent already verified the variant; surfaces downstream, SYNTAX §414)
  "",
}

// Operator precedence — THE canonical table, per SYNTAX.md §Precedence.
// Higher number = tighter binding. The same literal integers appear in
// SYNTAX.md — one table, two projections (the spec and this fn),
// zero translation; the seed's third projection retired with the seed.
//
// The one law of `~>`: precedence 1, the loosest binary operator
// (sharing the floor with nothing — verbs tier above it). The handler
// at the foot of a chain governs everything to its left; parenthesize
// `(stage ~> h)` to narrow. Layout is NEVER semantics — block vs
// inline on the page is the formatter's projection.
fn op_prec(k) with Pure = match k {
  TTildeGt => 1,
  TLtPipe => 2,
  TGtLt => 2,
  TLtTilde => 2,
  TPipeGt => 3,
  TOrOr => 4,
  TAndAnd => 5,
  TEqEq => 6,
  TBangEq => 6,
  TLt => 7,
  TGt => 7,
  TLtEq => 7,
  TGtEq => 7,
  TPlusPlus => 8,
  TPlus => 9,
  TMinus => 9,
  TStar => 10,
  TSlash => 10,
  TPercent => 10,
  _ => // drift-audit: ignore — prec 0 IS "not a binary operator"; the ladder's terminator, not a fabricated default
  0,
}

// Pipe-verb token → PipeKind. One token, one kind — `~>` is PTee
// always; scope is precedence's job, layout is the formatter's.
fn op_to_pipe_kind(k) with Memory + Alloc = match k {
  TTildeGt => Some(PTee),
  TPipeGt => Some(PForward),
  TLtPipe => // `<|` and `><` are ONE PFanout topology; the glyph authors the
  // ownership aspect (FanShare = one ref-borrowed input; FanDistribute
  // = N owned inputs). The surface keeps both glyphs; ownership CHECKS
  // coherence (own through `<|` → E_OwnershipViolation; the cursor
  // projects the glyph from the inferred ownership at fmt). The verb
  // contributes ZERO execution facts — schedule is a `~>` handler.
  Some(PFanout(FanShare)),
  TGtLt => Some(PFanout(FanDistribute)),
  TLtTilde => Some(PFeedback),
  _ => None,
}

// Map a binop `TokenKind` to `Some(BinOp)`, or `None` if `k` is not
// a binop-producing token. Caller matches `Some`/`None` explicitly;
// `None` at that site is unreachable (caller has already filtered via
// `op_prec(k) > 0` + `op_to_pipe_kind == None`), but the
// unreachability is expressed at the call site — not fabricated here
// via a wildcard arm.
//
// Future form (named peer 11.B.1.R): refinement-typed parameter
//   `fn op_to_binop(k) -> BinOp where binop(k)`
// exercises primitive #6 and eliminates the `Option` entirely.
fn op_to_binop(k) with Memory + Alloc = match k {
  TPlus => Some(BAdd),
  TMinus => Some(BSub),
  TStar => Some(BMul),
  TSlash => Some(BDiv),
  TPercent => Some(BMod),
  TPlusPlus => Some(BConcat),
  TEqEq => Some(BEq),
  TBangEq => Some(BNe),
  TLt => Some(BLt),
  TGt => Some(BGt),
  TLtEq => Some(BLe),
  TGtEq => Some(BGe),
  TAndAnd => Some(BAnd),
  TOrOr => Some(BOr),
  _ => None,
}

// Program — top-level loop
//
// Buffer-pattern helper for recursive parse loops. Each parse loop
// allocates an initial buffer, threads `(buf, count)` through tail-
// recursion, and slices at the end. O(N) total allocation per loop
// regardless of element count.
fn push_node(buf, count, node) = {
  // Not `own`: buf is only ever lent to list_extend_to — the buffer's
  // ownership rides the extend/set RETURNS (the pass-through), so an
  // authored own here is a finalization claim this body never makes
  // (the relevant tier convicted it — push_tok's exact sibling).
  let extended = list_extend_to(buf, count + 1)
  let written = list_set(extended, count, node)
  (written, count + 1)
}

// ─── THE COMMENT WEAVE, ATTACHED IN ONE PASS ─────────────────────────
//
// The lexer already knows where every comment is (one TComment per
// authored line in the ONE stream) and the graph already knows where
// every node is (the span index, written at birth). Per-site collection
// made every parser skip a potential prose-eater — nine families of the
// same bug, each hand-closed — so attachment INVERTED into this single
// post-parse walk: comment runs resolve their home by SPAN.
//
// The rules: a TRAILING run (its first line shares the previous token's
// line) attaches to the widest node STARTING on that line; a LEADING run
// attaches to the widest node at the minimal span start past the run's
// last line. Span ties go to the LATEST mint (the column law's tie rule)
// — which is also why the destructure-let desugar needs no transfer: the
// replacing match mints after the dead let at the same span and wins.
// Runs attach in REVERSE source order so the weave's prepend-merge reads
// source-ordered.
fn attach_comment_weave(ref tokens, h_from) with GraphRead + GraphWrite + Memory + Alloc = {
  // Flatten ONCE before the per-node bsearches (the iterate-flattens-once
  // law): the push-built runs list is snoc-spined, so every bsearch probe's
  // runs[mid] walked the spine — O(R) per probe, O(nodes × R log R) per
  // parse, multiplied by every re-frontend the convergence runs (measured
  // 2026-07-26: 98% of the WHOLE self-compile inside cw_scan_index's
  // list_index_unchecked — the crc_scope disease at the weave layer).
  let runs = list_to_flat(cw_collect_runs(tokens, 0, 0 - 1, make_list(0)))
  if len(runs) == 0 {
    ()
  } else {
    match graph_snapshot() {
      Graph(_, span_index) => {
        let flat_idx = span_index |> filter(carries_prose) |> list_to_flat
        let leads = cw_seed_slots(len(runs), make_list(len(runs)), 0)
        let trails = cw_seed_slots(len(runs), make_list(len(runs)), 0)
        cw_scan_index(flat_idx, 0, h_from, runs, leads, trails)
        cw_attach_all(runs, leads, trails, len(runs) - 1, 0)
      },
    }
  }
}

// A pattern has no place of its own on the page for prose to render: the
// comment above or beside an arm belongs to the arm's body, where the
// formatter writes it, so a pattern node never competes for a run.
fn carries_prose(entry) with GraphRead = match entry {
  (_, h) => match graph_node_body(h) {
    NPat(_) => false,
    NExpr(_) | NStmt(_) | NHole(_) | NModule(_) | NTypeAnn(_) => true,
  },
}

// One run record per maximal comment block: consecutive comment lines
// with only newlines between. prev_line tracks the last non-comment
// token's end line for the trailing test. The run is a NOMINAL record —
// the brand pins the element type at every generic reader (the bsearch
// walkers compile once; an open element row floored their field reads).
type CwRun = {end_line: Int, run_span: Span, start_line: Int, text: String, trailing: Bool}

fn cw_collect_runs(ref tokens, i, prev_line, acc) -> [CwRun] with Memory + Alloc = if i >= len(tokens) {
  acc
} else {
  match token_kind(tokens[i]) {
    TComment(first) => match span_at(tokens, i) {
      Span{start_line: sl} => match cw_join_run(tokens, i + 1, first, sl) {
        (text, endl, j) => {
          let run =
            CwRun{end_line: endl, run_span: span_at(tokens, i), start_line: sl, text: text, trailing: prev_line == sl}
          cw_collect_runs(tokens, j, prev_line, push(acc, run))
        },
      },
    },
    TNewline => cw_collect_runs(tokens, i + 1, prev_line, acc),
    TEof => acc,
    _ => match span_at(tokens, i) {
      Span{end_line: el} => cw_collect_runs(tokens, i + 1, el, acc),
    },
  }
}

fn cw_join_run(ref tokens, i, own acc, last_line) with Memory + Alloc = match token_kind(tokens[i]) {
  TComment(next) => match span_at(tokens, i) {
    Span{start_line: sl} => if sl <= last_line + 1 {
      cw_join_run(tokens, i + 1, "{acc}\n{next}", sl)
    } else {
      (acc, last_line, i)
    },
  },
  TNewline => match token_kind(tokens[i + 1]) {
    TComment(next) => match span_at(tokens, i + 1) {
      Span{start_line: sl} => if sl <= last_line + 1 {
        cw_join_run(tokens, i + 2, "{acc}\n{next}", sl)
      } else {
        (acc, last_line, i)
      },
    },
    _ => (acc, last_line, i),
  },
  _ => (acc, last_line, i),
}

// A candidate slot: (start_line, start_col, end_line, end_col, handle).
// handle 0 = empty (the graph's Module root is never a comment target).
fn cw_seed_slots(n, buf, i) with Memory + Alloc =
  if i >= n { buf } else { cw_seed_slots(n, list_set(buf, i, (0, 0, 0, 0, 0)), i + 1) }

// The one walk over the span index: each entry competes for the run it
// could serve — trailing runs keyed by their start line, leading runs by
// nearest-preceding-run bsearch. O(N log C).
fn cw_scan_index(ref idx, i, h_from, ref runs: [CwRun], leads, trails) with Memory + Alloc = if i >= len(idx) {
  ()
} else {
  match idx[i] {
    (span, h) => if h < h_from {
      cw_scan_index(idx, i + 1, h_from, runs, leads, trails)
    } else {
      match span {
        Span{start_line: sl, start_col: sc, end_line: el, end_col: ec} => {
          let tk = cw_find_run_on_line(runs, 0, len(runs) - 1, sl)
          if tk >= 0 { cw_compete_trail(trails, tk, sl, sc, el, ec, h) } else { () }
          let lk = cw_find_run_before(runs, 0, len(runs) - 1, sl, 0 - 1)
          if lk >= 0 { cw_compete_lead(leads, lk, sl, sc, el, ec, h) } else { () }
          cw_scan_index(idx, i + 1, h_from, runs, leads, trails)
        },
      }
    },
  }
}

// bsearch: the run whose start_line == line (runs are token-ordered, so
// start lines are strictly increasing).
fn cw_find_run_on_line(ref runs: [CwRun], lo, hi, line) with Memory = if lo > hi {
  0 - 1
} else {
  let mid = (lo + hi) / 2
  let r = runs[mid]
  if r.start_line == line {
    mid
  } else if r.start_line < line {
    cw_find_run_on_line(runs, mid + 1, hi, line)
  } else {
    cw_find_run_on_line(runs, lo, mid - 1, line)
  }
}

// bsearch: the run with the largest end_line strictly below the node's
// start line — the nearest preceding run this node could be the leading
// target of.
fn cw_find_run_before(ref runs: [CwRun], lo, hi, line, best) with Memory = if lo > hi {
  best
} else {
  let mid = (lo + hi) / 2
  let r = runs[mid]
  if r.end_line < line {
    cw_find_run_before(runs, mid + 1, hi, line, mid)
  } else {
    cw_find_run_before(runs, lo, mid - 1, line, best)
  }
}

// Trailing competition: widest span starting on the line (earliest col,
// then largest end); a full tie goes to the later mint (larger handle).
fn cw_compete_trail(trails, k, sl, sc, el, ec, h) with Memory + Alloc = match trails[k] {
  (bsl, bsc, bel, bec, bh) => {
    let better = if bh == 0 {
      true
    } else if sc != bsc {
      sc < bsc
    } else if el != bel {
      el > bel
    } else if ec != bec {
      ec > bec
    } else {
      h > bh
    }
    if better {
      list_set(trails, k, (sl, sc, el, ec, h))
      ()
    } else {
      ()
    }
  },
}

// Leading competition: minimal start past the run (earliest line then
// col), widest at that start, later mint on a full tie.
fn cw_compete_lead(leads, k, sl, sc, el, ec, h) with Memory + Alloc = match leads[k] {
  (bsl, bsc, bel, bec, bh) => {
    let better = if bh == 0 {
      true
    } else if sl != bsl {
      sl < bsl
    } else if sc != bsc {
      sc < bsc
    } else if el != bel {
      el > bel
    } else if ec != bec {
      ec > bec
    } else {
      h > bh
    }
    if better {
      list_set(leads, k, (sl, sc, el, ec, h))
      ()
    } else {
      ()
    }
  },
}

fn cw_attach_all(ref runs: [CwRun], ref leads, ref trails, k, next_target) with Memory + GraphWrite = if k < 0 {
  ()
} else {
  let r = runs[k]
  match trails[k] {
    (_, _, _, _, th) => match leads[k] {
      (_, _, _, _, lh) => {
        // A trailing run whose line holds no node (the arm's body sits on
        // another line; a type-field line mints nothing) falls back to its
        // LEAD candidate before inheriting.
        let own_target = if r.trailing && th != 0 { th } else { lh }
        // Blank-separated blocks share one following declaration: each NODE
        // competes only for its nearest preceding run, so an earlier run has
        // no candidate of its own — it INHERITS the next run's target. The
        // reverse walk attaches later runs first, and the weave's
        // prepend-merge reads the stacked blocks back in source order.
        let target = if own_target != 0 { own_target } else { next_target }
        if target != 0 { graph_attach_comment(target, r.text, r.run_span) } else { () }
        cw_attach_all(runs, leads, trails, k - 1, target)
      },
    },
  }
}

fn parse_program(ref tokens) = {
  let h0 = graph_next()
  let buf = make_list(16)
  match parse_stmt_list(tokens, 0, buf, 0) {
    (final_buf, final_count, _) => {
      attach_comment_weave(tokens, h0)
      slice(final_buf, 0, final_count)
    },
  }
}

fn parse_stmt_list(ref tokens, pos, own buf, count) = {
  // skip_seps_only (not skip_ws/skip_sep) so a leading comment reaches
  // parse_stmt's TComment arm to be collected-and-attached — never skipped as
  // layout at the decl boundary.
  let p = skip_seps_only(tokens, pos)
  if at(tokens, p, TEof) {
    (buf, count, p)
  } else {
    match parse_stmt(tokens, p) {
      (stmt, next) => match push_node(buf, count, stmt) {
        (b1, c1) => parse_stmt_list(tokens, skip_seps_only(tokens, next), b1, c1),
      },
    }
  }
}

// Statements
//
// DISPATCH and MINT are separate, because only the dispatcher knows a
// statement's EXTENT: it holds the opening token and receives the closing
// index. Every form parser returns its Stmt and never a span, so the argument
// nineteen mint sites each had to remember has no call site left to get wrong.
// The whole `type` family got it wrong — all eight passed the `type` keyword's
// own token, so a declaration could never be the widest node on its own line
// and lost its address to its own predicate — and FnStmt was right only
// because someone remembered span_join. Remembering is what this deletes.
fn parse_stmt(ref tokens, pos) = match kind_at(tokens, pos) {
  TComment(first_line) => // A comment is graph content (SYNTAX.md Comments): collect the contiguous
  // // run, parse the following declaration, and attach the joined prose to
  // that decl's handle in the comment weave (graph_attach_comment) — the Why
  // engine / formatter / cursor project it live. No wrapper node: the comment
  // edge holds the prose, the decl node is returned directly. With no following
  // decl (EOF), the orphan surfaces P_OrphanDocstring — never discarded.
  {
    let comment_span = span_at(tokens, pos)
    match collect_comment(tokens, pos + 1, first_line) {
      (full_text, p) => {
        // skip_seps_only, never skip_sep: a blank-separated FOLLOWING comment
        // block must reach the nested TComment arm and attach on its own —
        // the weave merges blocks sharing one declaration.
        let p2 = skip_seps_only(tokens, p)
        if at(tokens, p2, TEof) {
          // The file-tail block attaches to a synthetic unit carrier — never
          // dropped (SYNTAX Comments: an orphan run binds to its enclosing
          // node); the render emits the prose and no tokens for the carrier,
          // so the tail round-trips.
          let carrier = nstmt(ExprStmt(nexpr(LitUnit, comment_span)), comment_span)
          graph_attach_comment(node_handle(carrier), full_text, comment_span)
          (carrier, p2)
        } else {
          // The decl parses; the weave pass attaches the run by span.
          parse_stmt(tokens, p2)
        }
      },
    }
  },
  _ => match parse_stmt_form(tokens, pos) {
    (stmt, p) => (nstmt(stmt, span_join(span_at(tokens, pos), span_at(tokens, skip_ws_back(tokens, p - 1)))), p),
  },
}

// The forms themselves: each returns its Stmt and the index one past it. A
// comment is not among them — it is graph content the dispatcher attaches to
// the declaration that follows, never a statement form of its own.
fn parse_stmt_form(ref tokens, pos) = match kind_at(tokens, pos) {
  TFn => parse_fn(tokens, pos + 1),
  TLet => parse_let(tokens, pos + 1),
  TType => parse_type_decl(tokens, pos + 1),
  TEffect => parse_effect_decl(tokens, pos + 1),
  THandler => parse_handler_decl(tokens, pos + 1),
  TImport => parse_import(tokens, pos + 1),
  _ => match parse_expr(tokens, pos) {
    (expr, next) => (ExprStmt(expr), next),
  },
}

// Skip only line separators (newline / semicolon) — NOT comments. collect_comment
// needs this so the contiguous // run is gathered line-by-line; skip_sep (which
// passes over comments as layout) would swallow the next comment before the run
// could fold it in.
fn skip_seps_only(ref tokens, pos) = match kind_at(tokens, pos) {
  TSemicolon => skip_seps_only(tokens, pos + 1),
  TNewline => skip_seps_only(tokens, pos + 1),
  _ => pos,
}

// Concatenate the contiguous // run into one comment String. Exactly ONE
// intervening newline keeps the run; a blank line (two newlines) ends the
// block — the next block reaches the TComment arm on its own and the weave
// merges blocks that share a following declaration.
fn collect_comment(ref tokens, pos, own acc) = match kind_at(tokens, pos) {
  TComment(next_line) => collect_comment(tokens, pos + 1, "{acc}\n{next_line}"),
  TNewline => match kind_at(tokens, pos + 1) {
    TComment(next_line) => collect_comment(tokens, pos + 2, "{acc}\n{next_line}"),
    _ => (acc, pos),
  },
  _ => (acc, pos),
}

// Parse `fn name(params) [-> retty] [with effects] = body`.
fn parse_fn(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p = expect(tokens, pos + 1, TLParen)
  match parse_fn_params(tokens, p) {
    (params, dlets, p2) => {
      let p3 = skip_ws(tokens, p2)
      match if at(tokens, p3, TArrow) {
        parse_type_expr(tokens, skip_ws(tokens, p3 + 1))
      } else {
        (nexpr(LitUnit, start), p3)
      } {
        (ret_node, p4) => {
          let p5 = skip_ws(tokens, p4)
          match if at(tokens, p5, TWith) { parse_effect_list(tokens, skip_ws(tokens, p5 + 1)) } else { ([], p5) } {
            (effs, p6) => {
              let p7 = skip_ws(tokens, p6)
              let p8 = if at(tokens, p7, TEq) { p7 + 1 } else { p7 }
              match parse_body(tokens, skip_ws(tokens, p8)) {
                (raw_body, p9) => {
                  // Fold any destructure-param bindings into the body — a destructure param
                  // IS the same match projection a destructuring `let` is.
                  let body = bind_param_destructures(dlets, raw_body, start)
                  // The authored intent row IS the FnStmt's effs field on the node —
                  // read live by QIntentOf / oracle intent_weight via graph_node_body.
                  // No parallel intent ledger to write (Carried-Truth).
                  //
                  // The decl's span is the JOINED range through its body (SYNTAX §Parser
                  // obligations: every node carries the joined span of its constituent
                  // tokens) — a start-point span made the decl invisible to span
                  // containment, so enclosing_fn_decl_at found no enclosing declaration
                  // and the synth gate read the wrong allowed row.
                  (FnStmt(name, params, ret_node, effs, body), p9)
                },
              }
            },
          }
        },
      }
    },
  }
}

// A param-name token: TIdent or the contextual keywords
// own/ref/handle (SYNTAX.md — contextual keywords are idents outside
// keyword-role position; #117 class). Pure structural match — no
// string, no .len-on-call (the canonical projection — one predicate,
// both call sites).
fn is_param_name_tok(ref tokens, p) = match kind_at(tokens, p) {
  TIdent(_) => true,
  TOwn => true,
  TRef => true,
  _ => false,
}

// Lexeme of an ident-shaped token: TIdent payload, or the contextual
// keyword's spelling (own/ref). The canonical contextual-ident
// LEXEME projection (paired with is_param_name_tok, the Bool gate) —
// TIdent payload; TOwn→"own", TRef→"ref".
// "" = not an ident-shaped token (the canonical null; surfaces
// downstream, not a masked ADT). Used for record-field names:
// SYNTAX.md admits keyword-named fields (e.with, r.ref) — record
// construction is symmetric. (`handle` is NOT a keyword — it is the
// medium's own domain noun; the legacy `handle {…} with h` spelling
// retired with THandle, the turbofish precedent: no bespoke
// recognizer, the general diagnostic teaches.)
fn ident_or_kw_at(ref tokens, p) = match kind_at(tokens, p) {
  TIdent(s) => s,
  TOwn => "own",
  TRef => "ref",
  _ => // drift-audit: ignore — "" = not an ident-shaped token (seed-canonical null; surfaces downstream, not a masked ADT)
  "",
}

// Does a real param start at p? TIdent → yes. A pattern opener
// `{` / `[` / `(` → yes — parse_one_param's destructure arm parses the
// full Pat there (SYNTAX.md §Pattern syntax: patterns appear in
// function parameters as in lambda parameters; the gate agrees with
// the parser it gates). `own`/`ref` → yes ONLY when a param name
// follows (`own x`); a bare `own`/`ref` (next is `)`/`,`/`:`/`with`)
// is NOT a param start — seed parity: seed parse_one_param returned
// null there → the param-list terminates (verified empirically:
// `fn f(own)` → 0 params; `fn f(own,b)` → 0 params; `fn f(a,own)` →
// [a]; an own/ref before a pattern opener terminates the same way and
// the malformed tail refuses loudly — the recovery holes refuse the
// executable, measured exit nonzero with zero WAT).
fn param_starts_here(ref tokens, p) = match kind_at(tokens, p) {
  TIdent(_) => true,
  TOwn => is_param_name_tok(tokens, skip_ws(tokens, p + 1)),
  TRef => is_param_name_tok(tokens, skip_ws(tokens, p + 1)),
  TLBrace => true,
  TLBracket => true,
  TLParen => true,
  _ => false,
}

// Advance to the token after the next TRParen. Param lists are flat
// (no nested parens), so a linear scan is exact. TEof-bounded
// (substrate-honest, TEof the one hard bound).
fn skip_to_rparen(ref tokens, p) = if at(tokens, p, TRParen) {
  p + 1
} else if at(tokens, p, TEof) {
  p
} else {
  skip_to_rparen(tokens, p + 1)
}

// Advance to (not past) the next TLBrace. For handler `with !E` /
// `with E [+ E]` effect-row guards, which the seed skips to the arms
// block. Structural effect-row extraction is the seed's own named
// post-L1 peer Hβ.parser-handler-effect-row-record; effects are
// WAT-invisible so skip-vs-parse is byte-equivalent at L1. TEof-
// bounded, mirrors skip_to_rparen.
fn skip_to_lbrace(ref tokens, p) = if at(tokens, p, TLBrace) {
  p
} else if at(tokens, p, TEof) {
  p
} else {
  skip_to_lbrace(tokens, p + 1)
}

// Returns (params, bindings, pos). The bindings are the destructuring params'
// patterns (empty when all params are bare names); parse_fn / the lambda paths
// fold them into the body via bind_param_destructures, each an arm on its
// parameter.
fn parse_fn_params(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], [], p + 1)
  } else if !param_starts_here(tokens, p) {
    // Bare own/ref (no name follows) — seed parse_one_param returns
    // null → param-list terminates here; tokens to `)` discarded
    // 0 params; pos past `)`.
    ([], [], skip_to_rparen(tokens, p))
  } else {
    match parse_one_param(tokens, p) {
      (first, fl, p2) => match push_node(make_list(4), 0, first) {
        (b1, c1) => match push_opt_let(make_list(4), 0, fl) {
          (lb1, lc1) => match parse_params_tail(tokens, p2, b1, c1, lb1, lc1) {
            (final_buf, final_count, lbuf, lcount, final_pos) => (slice(final_buf, 0, final_count), slice(lbuf, 0, lcount), final_pos),
          },
        },
      },
    }
  }
}

// Push an Option(binding) into the bindings buffer-counter: Some appends, None
// is a no-op (the buffer is unchanged).
fn push_opt_let(own buf, count, opt) = match opt {
  Some(letstmt) => push_node(buf, count, letstmt),
  None => (buf, count),
}

fn parse_params_tail(ref tokens, pos, own buf, count, own lbuf, lcount) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TComma) {
    let pn = skip_ws(tokens, p + 1)
    if !param_starts_here(tokens, pn) {
      // Bare own/ref after `,` — list terminates (seed parity:
      // `fn f(a, own)` → [a], rest discarded to `)`).
      (buf, count, lbuf, lcount, skip_to_rparen(tokens, pn))
    } else {
      match parse_one_param(tokens, pn) {
        (next, nl, p2) => match push_node(buf, count, next) {
          (b1, c1) => match push_opt_let(lbuf, lcount, nl) {
            (lb1, lc1) => parse_params_tail(tokens, p2, b1, c1, lb1, lc1),
          },
        },
      }
    }
  } else {
    (buf, count, lbuf, lcount, expect(tokens, p, TRParen))
  }
}

// One parameter: a bare name (degenerate) or a destructure pattern
// (`{name, age}` / `[h, ...t]` / `(a, b)` — SYNTAX.md §«Function declarations»,
// §«Anonymous functions»). A destructure param desugars to a fresh-named
// param plus its binding, which bind_param_destructures makes the arm the body
// sits under. Returns (TParam, Option(binding), pos): None for a bare name.
fn parse_one_param(ref tokens, pos) = match match kind_at(tokens, pos) {
  TOwn => (Own, skip_ws(tokens, pos + 1)),
  TRef => (Ref, skip_ws(tokens, pos + 1)),
  _ => (Unmarked, pos),
} {
  (own_marker, p) => {
    // A pattern-shaped param starts with `{` / `[` / `(` — parse the full Pat
    // and desugar it to (fresh param, prepend-let). The own/ref marker rides on
    // the fresh param (the whole destructured value carries the ownership).
    let psp = span_at(tokens, p)
    if at(tokens, p, TLBrace) || at(tokens, p, TLBracket) || at(tokens, p, TLParen) {
      match parse_pat(tokens, p) {
        (pat, p_pat) => {
          let fresh = fresh_param_name(psp)
          let param = TParam(fresh, TVar(fresh_handle(psp)), own_marker, own_marker, None)
          (param, Some((pat, nexpr(VarRef(fresh), psp), psp)), p_pat)
        },
      }
    } else {
      let name = ident_or_kw_at(tokens, p)
      let p2 = skip_ws(tokens, p + 1)
      // Optional `: Ty` annotation (the Intent Boundary), then optional
      // `= default` (SYNTAX.md §«Default parameter values»). The default
      // expr is parser-minted graph content; it rides in the TParam's
      // default slot to its one home, evaluated in the callee's scope when
      // a call omits the arg edge.
      match if at(tokens, p2, TColon) {
        parse_type_ty(tokens, skip_ws(tokens, p2 + 1))
      } else {
        (TVar(fresh_handle(span_at(tokens, p))), p2)
      } {
        (ty, p_ty) => {
          let p_after_ty = skip_ws(tokens, p_ty)
          if at(tokens, p_after_ty, TEq) {
            match parse_expr(tokens, skip_ws(tokens, p_after_ty + 1)) {
              (default_expr, p_def) => (TParam(name, ty, own_marker, own_marker, Some(default_expr)), None, p_def),
            }
          } else {
            (TParam(name, ty, own_marker, own_marker, None), None, p_ty)
          }
        },
      }
    }
  },
}

// Effect rows use the full Boolean algebra `+ - & ! Pure` per SYNTAX.md
// §«Named effect rows» (`with E1 + !E2 & E3 - E4`). `!` is the per-term
// negation flag; `+ - &` are the connectives joining each term to the
// row accumulated to its left. The first term carries EcUnion (joining
// onto the pure-row base = itself). Each entry is (EffName, negated,
// EConn); infer folds the list applying each connective via the
// existing union_row / diff_row / inter_row algebra (build_declared_row)
// — the parser names the topology, infer reads the algebra live.
fn parse_effect_list(ref tokens, pos) = parse_effect_list_from(tokens, pos, EcUnion)

// The AUTHORED row on this mutually-recursive pair is load-bearing
// (the signature price at a cycle, the same one every HM judge
// charges at polymorphic-recursion points): with no declaration the
// pair's row tails oscillated open ↔ closed between judgment rounds —
// the last surviving bound-hit mover — and WHICH attractor the bound
// cut decided whether downstream install subtractions held or dropped
// (the Intern this pair honestly performs then reached main's row as
// the "phantom" that struck three times on 2026-07-30). The declared
// row closes the tail deterministically; the attractors cease to
// exist.
fn parse_effect_list_from(ref tokens, pos, conn) with Memory + Alloc + GraphRead + GraphWrite + Diagnostic + Intern = match parse_one_effect(tokens, pos) {
  (name, negated, p) => {
    let entry = (name, negated, conn)
    let p2 = skip_ws(tokens, p)
    let next_conn = if at(tokens, p2, TPlus) {
      Some(EcUnion)
    } else if at(tokens, p2, TMinus) {
      Some(EcDiff)
    } else if at(tokens, p2, TAmp) {
      Some(EcInter)
    } else {
      None
    }
    match next_conn {
      Some(c) => match parse_effect_list_from(tokens, skip_ws(tokens, p2 + 1), c) {
        (rest, p3) => ([entry] ++ rest, p3),
      },
      None => ([entry], p2),
    }
  },
}

// Parse a single effect entry — bare `IO`, negated `!IO`,
// parameterized `Sample(44100)`, or negated parameterized
// `!Sample(44100)`. Args are scalar literals (int/float/string);
// identifier / expression args land in a v2 walkthrough.
fn parse_one_effect(ref tokens, pos) with Memory + Alloc + GraphRead + GraphWrite + Diagnostic + Intern = match if at(tokens, pos, TBang) { (true, pos + 1) } else { (false, pos) } {
  (negated, p) => // `Pure` lexes to TPure (a reserved word) — it IS the union identity, so the
  // parser emits the EPure EffName directly. build_declared_row maps it to
  // the pure row; the EPure variant replaces the old string-keyed Pure term (drift-3).   // drift-audit: ignore — describes the dissolution
  if at(tokens, p, TPure) {
    (EPure, negated, p + 1)
  } else {
    let name = ident_at(tokens, p)
    // The effect name's identity is its intern handle (the token's word is
    // already canonical, so this probe is a hash + one pointer-fast compare;
    // the token carrying its handle outright is the named next cut).
    let nh = intern_str(name)
    let p1 = p + 1
    let p2 = skip_ws(tokens, p1)
    if at(tokens, p2, TLParen) {
      match parse_eff_args(tokens, skip_ws(tokens, p2 + 1)) {
        (args, p3) => (EParameterized(nh, args), negated, p3),
      }
    } else {
      (ENamed(nh), negated, p1)
    }
  },
}

fn parse_eff_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], p + 1)
  } else {
    let buf = make_list(2)
    match parse_one_eff_arg(tokens, p) {
      (first, p2) => match push_node(buf, 0, first) {
        (b1, c1) => match parse_eff_args_tail(tokens, p2, b1, c1) {
          (final_buf, final_count, final_pos) => (slice(final_buf, 0, final_count), final_pos),
        },
      },
    }
  }
}

fn parse_eff_args_tail(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TComma) {
    match parse_one_eff_arg(tokens, skip_ws(tokens, p + 1)) {
      (next, p2) => match push_node(buf, count, next) {
        (b1, c1) => parse_eff_args_tail(tokens, p2, b1, c1),
      },
    }
  } else {
    (buf, count, expect(tokens, p, TRParen))
  }
}

fn parse_one_eff_arg(ref tokens, pos) = match kind_at(tokens, pos) {
  TIntLit(n) => // Scalar literals are the CONSTANT-FOLDED PROJECTION of the operand node —
  // the literal the AST already holds, folded for value-distinct row equality.
  (EAInt(n), pos + 1),
  TFloatLit(f) => (EAFloat(f), pos + 1),
  TStringPart(s) => (EAString(s), pos + 1),
  TIdent(name) => // A non-literal argument (`Clock(monotonic)`, `Sample(rate)`) is an operand
  // Node — minted into the one graph as a VarRef and carried by HANDLE
  // (EANode), resolved live via graph_node_body (the PExpr-dissolution
  // precedent). The old EEffArgNotLiteral surrender is DELETED: a parameterized
  // effect over a bound name is first-class, not an error.
  {
    let sp = span_at(tokens, pos)
    match nexpr(VarRef(name), sp) {
      N{handle: h} => (EANode(h), pos + 1),
    }
  },
  _ => {
    report(EEffArgNotLiteral(span_at(tokens, pos)))
    (EAInt(0), pos + 1)
  },
}

// Parse `let pat [: ty] = expr`.
fn parse_let(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  match parse_pat(tokens, pos) {
    (pat, p) => {
      let p2 = skip_ws(tokens, p)
      // Capture the `: T` annotation LIVE (mirrors FnStmt's ret_ann, parse_type_expr):
      // present = NTypeAnn(ty) minted into the graph, so infer reads the declared
      // type back and discharges its refinement against the value node; absent = a
      // LitUnit dummy the infer arm skips. The old form parsed the type and DISCARDED
      // it (`let (_, p_ty) = ...`), so every `let x: T = e` lost its constraint.
      match if at(tokens, p2, TColon) {
        match parse_type_expr(tokens, skip_ws(tokens, p2 + 1)) {
          (a, pt) => (Some(a), pt),
        }
      } else {
        (None, p2)
      } {
        (ann_opt, p3) => {
          let p4 = expect(tokens, skip_ws(tokens, p3), TEq)
          match parse_expr(tokens, skip_ws(tokens, p4)) {
            (val, p5) => {
              // Absent annotation REUSES the value node as the sentinel — no fresh mint,
              // so the handle counter is unshifted and the emit stays byte-identical for
              // every unannotated let (infer's NTypeAnn arm skips a non-annotation node).
              // Only a PRESENT annotation adds its NTypeAnn node.
              let ann_node = match ann_opt {
                Some(a) => a,
                None => val,
              }
              (LetStmt(pat, val, ann_node), p5)
            },
          }
        },
      }
    },
  }
}

// Parse `type X = V1 | V2(fields) | ...` or `type X = T where P`.
fn parse_type_decl(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p = skip_ws(tokens, pos + 1)
  let p2 = if at(tokens, p, TEq) { skip_ws(tokens, p + 1) } else { p }
  if at(tokens, p2, TLBrace) {
    // H2.3 nominal record: `type Person = {name: String, age: Int}`.
    // Single-variant type whose body is the record. Reuse
    // parse_record_type_fields so the field-sort invariant matches
    // structural records exactly.
    match parse_record_type_fields(tokens, skip_ws(tokens, p2 + 1)) {
      (flds, _rest_var, p3) => {
        let sorted = sort_record_type_fields(flds)
        // A nominal record is closed by definition — its name IS the brand,
        // so an open rest is meaningless here; the closed TRecord is the body.
        let body = TRecord(sorted)
        let variant = (name, [mk_param("_0", body)], mint_node(NTypeAnn(body), start))
        (TypeDefStmt(name, [variant]), p3)
      },
    }
  } else {
    // The RHS is a type expression. Parse it WHOLE, then branch on what
    // FOLLOWS. The base of a refined alias may be ANY type expr — `[a]`,
    // `Option(k)`, `Int` — not just a single-token name; the old `p2 + 1`
    // probe saw only a one-token base and so rejected SYNTAX §«Type aliases»'
    // own `type NonEmpty = [a] where len(self) > 0` (P_UnexpectedToken on
    // `where` at the `]`). Reading the whole base first is the fix:
    //   `where` (TWhere)        → refined alias, base = alias_ty
    //   `|`/`+`/`-`/`&`         → multi-variant ADT / named effect row
    //   a constructor payload    → single-variant ADT (`type Token = Tok(...)`)
    //   nothing                  → transparent alias (`type Port = Int`)
    if at(tokens, p2, TBang) {
      // A leading `!` never starts a type — `type NoIO = !IO` is the
      // named-row grammar from its first token.
      match parse_effect_list(tokens, p2) {
        (effs, p3) => (RowAliasStmt(name, effs), p3),
      }
    } else if at_named_variant(tokens, p2) {
      match parse_variants(tokens, p2) {
        (variants, p3) => (TypeDefStmt(name, variants), p3),
      }
    } else {
      match parse_type_ty(tokens, p2) {
        (alias_ty0, p_alias0) => match parse_repr_pin(tokens, alias_ty0, p_alias0) {
          (alias_ty, p_alias) => {
            let term = skip_ws(tokens, p_alias)
            if at(tokens, term, TWhere) {
              match parse_predicate(tokens, skip_ws(tokens, term + 1)) {
                (pred, p4) => (RefineStmt(name, alias_ty, pred), p4),
              }
            } else if at(tokens, term, TPipe) {
              match parse_variants(tokens, p2) {
                (variants, p3) => (TypeDefStmt(name, variants), p3),
              }
            } else if at(tokens, term, TPlus) || at(tokens, term, TMinus) || at(tokens, term, TAmp) {
              // Named effect row (SYNTAX §«Named effect rows»): the RHS is
              // the with-clause's OWN signed-triple grammar — re-parse from
              // the RHS start through parse_effect_list, one grammar and one
              // representation (Hβ.types.named-effect-rows).
              match parse_effect_list(tokens, p2) {
                (effs, p3) => (RowAliasStmt(name, effs), p3),
              }
            } else {
              match alias_ty {
                TName{name: vname, args: fields} => if len(fields) > 0 {
                  (TypeDefStmt(name, [(vname, positional_fields(fields), mint_node(NTypeAnn(TTuple(fields)), start))]), p_alias)
                } else {
                  (AliasStmt(name, alias_ty), p_alias)
                },
                _ => (AliasStmt(name, alias_ty), p_alias),
              }
            }
          },
        },
      }
    }
  }
}

// The repr pin's parse (SYNTAX §"Representation-pinned alias"): after the
// whole base type, `repr <width>` wraps it in TReprPin — before any
// `where` (the pin then rides the refined alias's base). `repr` is the
// medium's own noun, never a keyword (the `handle` precedent): the peek
// is an ident match. An unknown width reports and keeps the base.
fn parse_repr_pin(ref tokens, base_ty, pos) = {
  let term = skip_ws(tokens, pos)
  if at_ident_word(tokens, term, "repr") {
    let wpos = skip_ws(tokens, term + 1)
    match repr_of_width_name(ident_at(tokens, wpos)) {
      Some(r) => (TReprPin(r, base_ty), wpos + 1),
      None => {
        report(PUnexpectedToken("unknown repr width — one of i32, i64, f64, f32, v128", span_at(tokens, wpos)))
        (base_ty, wpos + 1)
      },
    }
  } else {
    (base_ty, pos)
  }
}

fn at_ident_word(ref tokens, pos, w: String) = match kind_at(tokens, pos) {
  TIdent(v) => v == w,
  _ => false,
}

fn repr_of_width_name(w: String) with Memory + Alloc = if w == "i32" {
  Some(RI32)
} else if w == "i64" {
  Some(RI64)
} else if w == "f64" {
  Some(RF64)
} else if w == "f32" {
  Some(RF32)
} else if w == "v128" {
  Some(RV128)
} else {
  None
}

fn parse_variants(ref tokens, pos) = {
  // Each variant row carries its own minted NTypeAnn node — its handle
  // in the comment weave (the weave pass attaches by span).
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TEof) {
    // EOF inside variant declarations — halt with the empty list
    // and emit ONE diagnostic per the unclosed-construct discipline.
    // Without this, ident_at returns "" + recursion fabricates an
    // empty-named variant list that lower/infer would walk into
    // garbage paths. Drift mode 9 refused: empty-name variant IS
    // structurally NOT what the source said.
    report(PUnclosedConstruct(
      "unexpected end of input inside type-decl variants; expected a variant name or `|`",
      span_at(tokens, p)
    ))
    ([], p)
  } else {
    let vspan = span_at(tokens, p)
    let vname = ident_at(tokens, p)
    let p2 = p + 1
    match if at(tokens, p2, TLParen) {
      parse_variant_fields(tokens, skip_ws(tokens, p2 + 1), 0)
    } else {
      ([], p2)
    } {
      (fields, p3) => {
        variant_fields_one_form(fields, vspan)
        let cnode = mint_node(NTypeAnn(TTuple(map(param_ty, fields))), vspan)
        let variant = (vname, fields, cnode)
        let p4 = skip_ws(tokens, p3)
        if at(tokens, p4, TPipe) {
          match parse_variants(tokens, skip_ws(tokens, p4 + 1)) {
            (rest, p5) => ([variant] ++ rest, p5),
          }
        } else {
          ([variant], skip_seps_only(tokens, p3))
        }
      },
    }
  }
}

// A variant's fields are its constructor's parameter list (SYNTAX §«Named
// fields»): `level: Level` is a named field, a bare type is a positional one
// named by its position, exactly the names the constructor's scheme carries.
fn parse_variant_fields(ref tokens, pos, i) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], p + 1)
  } else {
    match parse_variant_field(tokens, p, i) {
      (field, p2) => {
        let p3 = skip_ws(tokens, p2)
        if at(tokens, p3, TComma) {
          match parse_variant_fields(tokens, skip_ws(tokens, p3 + 1), i + 1) {
            (rest, p4) => ([field] ++ rest, p4),
          }
        } else {
          ([field], expect(tokens, p3, TRParen))
        }
      },
    }
  }
}

fn parse_variant_field(tokens, p, i) = if at_named_field(tokens, p) {
  match parse_type_ty(tokens, skip_ws(tokens, skip_ws(tokens, p + 1) + 1)) {
    (ty, p2) => (mk_param(field_name_at(tokens, p), ty), p2),
  }
} else {
  match parse_type_ty(tokens, p) {
    (ty, p2) => (mk_param("_{int_to_str(i)}", ty), p2),
  }
}

// `name :` opens a named field; a type never has a colon after its head, so
// ANY token before a colon is a field name, even one that cannot be.
fn at_named_field(tokens, p) = at(tokens, skip_ws(tokens, p + 1), TColon)

// A keyword cannot name a field: a pattern or construction naming it would
// lex as the keyword. Said once, at the word, and the field keeps the
// spelling so the rest of the declaration still parses (`effect: String`
// cascaded into two hundred unrelated errors before this).
fn field_name_at(tokens, p) = match kind_at(tokens, p) {
  TIdent(s) => s,
  k => {
    report(PUnexpectedToken("`{show_token_kind(k)}` is a keyword and cannot name a field", span_at(tokens, p)))
    show_token_kind(k)
  },
}

// A positional field's name is its position, so a variant mixing the two
// forms names some fields by what they mean and the rest by where they sit.
fn variant_fields_one_form(fields, span: ValidSpan) = {
  let named = fields |> filter({ f => !is_position_name(param_name(f)) }) |> len
  if named == 0 || named == len(fields) {
    ()
  } else {
    report(PUnexpectedToken("a variant's fields are all named or all positional", span))
  }
}

fn is_position_name(name: String) = starts_with(name, "_")

// A named-field pattern reads only the fields it names, so every other field
// is already the rest; `...` says that again and binds nothing, and a named
// rest would bind a value no constructor field holds.
fn con_fields_rest(rest, span: ValidSpan) = match rest {
  None => (),
  Some(name) => if name == "_" {
    ()
  } else {
    report(PUnexpectedToken(
      "a constructor's fields have no rest to bind — name the fields the arm reads",
      span
    ))
  },
}

// A type application read as a constructor's fields: each named by position.
fn positional_fields(tys) = map({ (i, ty) => mk_param("_{int_to_str(i)}", ty) }, enumerate(tys))

// `Name(field: …` — a single variant whose fields are named, which the type
// grammar cannot read (a type's head is never followed by a colon).
fn at_named_variant(tokens, p) = match kind_at(tokens, p) {
  TIdent(_) => at(tokens, p + 1, TLParen) && at_named_field(tokens, skip_ws(tokens, p + 2)),
  _ => false,
}

// Parse `effect X { op(args) -> ret }`. Resume discipline is
// INFERRED from each handler arm body (no annotation in the
// effect declaration); see types.mn:ResumeDiscipline.
fn parse_effect_decl(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p_after_name = skip_ws(tokens, pos + 1)
  // Optional `(params)` — the parameterized effect's instance signature
  // (SYNTAX §«Parameterized effect»: `effect Sample(rate: Int)`), the
  // same [TParam] carrier fn params and handler config ride.
  match if at(tokens, p_after_name, TLParen) {
    parse_config_params(tokens, skip_ws(tokens, p_after_name + 1))
  } else {
    ([], p_after_name)
  } {
    (params, p_after_params) => {
      let p = expect(tokens, skip_ws(tokens, p_after_params), TLBrace)
      match parse_effect_ops(tokens, skip_ws(tokens, p)) {
        (ops, p2) => (EffectDeclStmt(name, params, ops), p2),
      }
    },
  }
}

fn parse_effect_ops(ref tokens, pos) = {
  // Each op row carries its own minted NTypeAnn node — the op's handle in
  // the comment weave (the weave pass attaches by span) and the felt
  // surface's address into the row.
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) || at(tokens, p, TEof) {
    ([], p + 1)
  } else if !is_param_name_tok(tokens, p) {
    // Not an op-name here — stray tokens. Seed parity: $parse_effect_ops
    // null-recovery (protocol_parser_fabrication_substrate) — advance
    // past the token, skip separators, retry. TEof above bounds the
    // recursion.
    parse_effect_ops(tokens, skip_sep(tokens, p + 1))
  } else {
    let op_span = span_at(tokens, p)
    let op_name = ident_at(tokens, p)
    let p2 = expect(tokens, skip_ws(tokens, p + 1), TLParen)
    match parse_op_params(tokens, skip_ws(tokens, p2)) {
      (param_tys, p3) => {
        // The arrow PROBE must not consume: a miss returns the pre-probe
        // position, or the skip eats the NEXT op's leading comment run (the
        // alternating-drop the memory.mn idempotence diff measured — every
        // arrowless op swallowed its successor's prose).
        let p4 = skip_ws(tokens, p3)
        match if at(tokens, p4, TArrow) { parse_type_ty(tokens, skip_ws(tokens, p4 + 1)) } else { (TUnit, p3) } {
          (ret_ty, p5) => {
            let cnode = mint_node(NTypeAnn(ret_ty), op_span)
            match parse_effect_ops(tokens, skip_sep(tokens, p5)) {
              (rest, p7) => ([(op_name, param_tys, ret_ty, cnode)] ++ rest, p7),
            }
          },
        }
      },
    }
  }
}

// Parse a single op-param: either bare `Type` (positional) or
// `name: Type` (named — SYNTAX.md §678 `print(msg: String)`). Skips
// the optional `<ident> :` prefix; returns the parsed Ty + new pos.
// Per Hβ.parser.effect-op-typed-arg-substrate (2026-05-10): the wheel
// parser accepts both forms; the seed-side substrate already does the
// same via the `if at p2 TColon` check at parse_one_param shape, so
// this stays SYNTAX.md-aligned.
fn parse_op_param_one(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  // peek `<ident> :` — if present, skip the name + colon and parse the
  // type. is_param_name_tok is the canonical pure-structural projection
  // (TIdent + contextual kw); it replaces `ident_at(tokens, p).len > 0`
  // — `.len`-on-a-call-result mis-evaluates in compiled mentl2 (the
  // same construct behind the #154 O2 regression; broader audit is the
  // named peer Hβ.parser.len-on-call-result-miscompile-audit).
  let after_ws = skip_ws(tokens, p + 1)
  let is_ident_here = is_param_name_tok(tokens, p)
  let typed_form = is_ident_here && at(tokens, after_ws, TColon)
  if typed_form {
    parse_type_ty(tokens, skip_ws(tokens, after_ws + 1))
  } else {
    parse_type_ty(tokens, p)
  }
}

fn parse_op_params(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], p + 1)
  } else {
    match parse_op_param_one(tokens, p) {
      (ty, p2) => {
        let p3 = skip_ws(tokens, p2)
        if at(tokens, p3, TComma) {
          match parse_op_params(tokens, skip_ws(tokens, p3 + 1)) {
            (rest, p4) => ([ty] ++ rest, p4),
          }
        } else {
          ([ty], expect(tokens, p3, TRParen))
        }
      },
    }
  }
}

// Parse `handler X[(config_params)] [with field = init [, ...]] { arms }`
// per SYNTAX.md §"Handler declarations" — three optional sections before arms:
//   - config-params `(p1, p2, ...)` closure-captured at install site
//   - state `with field = init [, ...]` per-arm-scope mutable bindings
//   - arms `{ op_name(args) => body, ... }` op handler bodies
//
// Per Hβ.first-light.handler-config-state-substrate (2026-05-06):
// config + state extracted at parse time so infer/lower can bind them
// in arm scope. Config parses via parse_config_params (the fn-param
// product's `name [= default]` face — SYNTAX §«Default parameter
// values»: the config list IS a parameter product, so a field carries
// a default) and parse_handler_state_fields (below) for the state
// clause.
// Eight: Graph (HandlerDeclStmt carries config+state lists). Handler
// (Pure parse). Verb (|> through ident → optional config → optional
// state → arms). Row (Memory + Alloc for AST). Ownership (ref tokens;
// own per fresh nstmt). Refinement (Stmt where stmt_well_formed(self)).
// Gradient (bottom: name only; top: full surface). Reason (span +
// Declared(name)). Drift refused: 7 (no parallel arrays — config and
// state are separate concerns with distinct shapes); 9 (config + state
// land whole, not deferred).
fn parse_handler_decl(ref tokens, pos) = {
  let start = span_at(tokens, pos)
  let name = ident_at(tokens, pos)
  let p_after_name = skip_ws(tokens, pos + 1)
  // Optional `(config_params)` — closure-captured at install site.
  match if at(tokens, p_after_name, TLParen) {
    parse_config_params(tokens, skip_ws(tokens, p_after_name + 1))
  } else {
    ([], p_after_name)
  } {
    (config, p_after_config) => // Optional `with` clause. Seed parser_handler.wat $parse_handler_state
    // disambiguation:
    //   with !E              — effect-row guard (SYNTAX.md §904-912)
    //   with E [+ E]         — effect-row (IDENT not followed by `=`)
    //   with f = init [, ..] — state-init
    // Effect-row → skip to the arms `{`, empty state. Structural row
    // extraction is the seed's OWN named post-L1 peer
    // Hβ.parser-handler-effect-row-record (effects are WAT-invisible;
    // skip == parse at L1 byte-faithfulness — not drift 9).
    match if at(tokens, skip_ws(tokens, p_after_config), TWith) {
      let p_w = skip_ws(tokens, p_after_config)
      let p_with = skip_ws(tokens, p_w + 1)
      if at(tokens, p_with, TBang) {
        ([], skip_to_lbrace(tokens, p_with))
      } else if is_param_name_tok(tokens, p_with) && !at(tokens, skip_ws(tokens, p_with + 1), TEq) {
        ([], skip_to_lbrace(tokens, p_with))
      } else {
        parse_handler_state_fields(tokens, p_with)
      }
    } else {
      ([], p_after_config)
    } {
      (state, p_after_state) => {
        let p_open = expect(tokens, skip_ws(tokens, p_after_state), TLBrace)
        match parse_handler_arms(tokens, skip_ws(tokens, p_open)) {
          (arms, p_close) => (HandlerDeclStmt(name, "", config, state, arms), p_close),
        }
      },
    },
  }
}

// Parse `field = init [, field = init]*` until TLBrace. Each state
// entry is a record `{name, init}` per Ω.5 record-shape discipline
// (drift mode 7 refusal — no (names_list, inits_list) parallel arrays).
// Reuses parse_expr for inits.
// Typed projections for the {init, name} record this file mints (state
// fields + resume updates share the shape). A map/fold lambda's param is
// a bare generic under the seed, and an unproven receiver's field access
// hits the loud emit floor; the call-site unification with the declared
// param IS the pin. One home — the mint — every consumer reads through.
fn state_field_name(f: {init: Node, name: String}) -> String = f.name

fn state_field_init(f: {init: Node, name: String}) -> Node = f.init

// The handler-arm record's typed projection ({args, body, op_name},
// minted in parse_handler_arm) — same pin, same discipline.
fn handler_arm_op_name(a: {args: [String], body: Node, op_name: String}) -> String = a.op_name

fn handler_arm_arity(a: {args: [String], body: Node, op_name: String}) -> Int = len(a.args)

// The arm's body node — the typed projection draw_op_edges folds the resume
// Usage grade over (the arm-record type only resolves in a scope that closed
// {args, body, op_name}, so this annotated accessor reads it from any context,
// exactly as handler_arm_op_name reads the op name).
fn handler_arm_body(a: {args: [String], body: Node, op_name: String}) -> Node = a.body

fn handler_arm_args(a: {args: [String], body: Node, op_name: String}) -> [String] = a.args

fn parse_handler_state_fields(ref tokens, pos) = {
  let name = ident_at(tokens, pos)
  let p_eq = expect(tokens, skip_ws(tokens, pos + 1), TEq)
  match parse_header_expr(tokens, skip_ws(tokens, p_eq)) {
    (init, p_after_init) => {
      let field = {init: init, name: name}
      let p_next = skip_ws(tokens, p_after_init)
      if at(tokens, p_next, TComma) {
        match parse_handler_state_fields(tokens, skip_ws(tokens, p_next + 1)) {
          (rest, p_end) => ([field] ++ rest, p_end),
        }
      } else {
        ([field], p_next)
      }
    },
  }
}

// Parse `field = init [, field = init]*` for a `resume(v) with ...`
// clause. Distinct terminator from parse_handler_state_fields: a comma
// is a field separator ONLY when followed by `IDENT =`. A comma
// followed by anything else is the match-arm separator (consumed by
// parse_handler_arms via skip_sep), so the list ends BEFORE it.
// The canonical resume-state-update predicate — pass-2 proves it.
// Same {name, init} record shape as parse_handler_state_fields (drift
// 7 refused); a separate fn, not a context flag (drift 8 refused —
// mirrors the seed's $parse_handler_state / $parse_resume_state_updates
// two-function split).
fn parse_resume_state_updates(ref tokens, pos) = {
  let name = ident_at(tokens, pos)
  let p_eq = expect(tokens, skip_ws(tokens, pos + 1), TEq)
  match parse_expr(tokens, skip_ws(tokens, p_eq)) {
    (init, p_after_init) => {
      let field = {init: init, name: name}
      // The comma PROBE returns the pre-probe position on a miss (the
      // non-consuming probe law): the trailing marker on an update line —
      // the drift-audit suppressions live exactly there — stays for the
      // block layer's backward attach.
      let p_next = skip_ws(tokens, p_after_init)
      if at(tokens, p_next, TComma) {
        let p_la = skip_ws(tokens, p_next + 1)
        match kind_at(tokens, p_la) {
          TIdent(_) => if at(tokens, skip_ws(tokens, p_la + 1), TEq) {
            match parse_resume_state_updates(tokens, p_la) {
              (rest, p_end) => ([field] ++ rest, p_end),
            }
          } else {
            ([field], p_next)
          },
          _ => ([field], p_next),
        }
      } else {
        ([field], p_after_init)
      }
    },
  }
}

fn parse_handler_arms(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) {
    ([], p + 1)
  } else if at(tokens, p, TEof) {
    ([], p)
  } else if !is_param_name_tok(tokens, p) {
    // Non-ident at arm start (stray tokens). Seed parity:
    // $parse_handler_arm returns null when $ident_at_p returns null →
    // arm loop terminates; skip the token and retry — same discipline as
    // parse_effect_ops.
    parse_handler_arms(tokens, skip_sep(tokens, p + 1))
  } else {
    let op_name = ident_at(tokens, p)
    let p2 = expect(tokens, skip_ws(tokens, p + 1), TLParen)
    match parse_arg_names(tokens, skip_ws(tokens, p2)) {
      (args, p3) => {
        let p4 = expect(tokens, skip_ws(tokens, p3), TFatArrow)
        match parse_expr(tokens, skip_ws(tokens, p4)) {
          (body, p5) => {
            // Arm separator IS the match-arm separator — handler arms mirror
            // parse_match_arms (seed parser_handler.wat $parse_handler_arms
            // asserts this mirror). Optional `,` between arms (SYNTAX.md:862
            // shows trailing-comma form); skip_ws absorbs newline-separated
            // arms. Converges the prior skip_sep divergence to the canonical
            // sibling idiom.
            let p5b = skip_ws(tokens, p5)
            let p6 = if at(tokens, p5b, TComma) { p5b + 1 } else { p5b }
            match parse_handler_arms(tokens, skip_ws(tokens, p6)) {
              (rest, p7) => {
                // Per Ω.5 frame-record discipline + H1.4 future wiring,
                // arms are records keyed by field name. New fields (e.g.,
                // arm_fn_idx for handler arm fn indexing) land additively.
                let arm = {args: args, body: body, op_name: op_name}
                // (handler_arm_op_name below is this record's typed projection)
                ([arm] ++ rest, p7)
              },
            }
          },
        }
      },
    }
  }
}

fn parse_arg_names(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], p + 1)
  } else {
    let name = ident_at(tokens, p)
    let p2 = skip_ws(tokens, p + 1)
    if at(tokens, p2, TComma) {
      match parse_arg_names(tokens, skip_ws(tokens, p2 + 1)) {
        (rest, p3) => ([name] ++ rest, p3),
      }
    } else {
      ([name], expect(tokens, p2, TRParen))
    }
  }
}

// A handler's config list — the fn-param product's scalar face at the
// handler decl (SYNTAX §«Handler declarations» + §«Default parameter
// values»: "Defaults and labeled args are not two features — they are
// the parameter list AS a product node-kind"). `name [= default]` mints
// the SAME TParam parse_one_param mints for a bare fn param, so the
// default has ONE representation (the TParam's fifth slot) and one fill
// (resolve_call_args) for fns and handlers alike. The parse-time TVar is
// the placeholder mint_handler_config_tparams supersedes with the
// graph-registered var — parse_one_param's own unannotated shape.
// Destructure patterns and `: Ty` annotations stay fn-only (a config
// param is a captured value; the annotated-config form is the named
// lathe-lag measured 2026-07-24 — `scaler(f: Int)` — and lands with its
// own resolution, never as a silently-discarded parse).
fn parse_config_params(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], p + 1)
  } else {
    let name = ident_at(tokens, p)
    let p2 = skip_ws(tokens, p + 1)
    // Optional `: Ty` annotation — the same Intent-Boundary arm
    // parse_one_param carries. The annotated config param
    // (`scaler(f: Int)`, the 2026-07-24 measured lathe-lag) and the
    // parameterized effect head (`effect Sample(rate: Int)`) both
    // land here; absent, the fresh var as before.
    match if at(tokens, p2, TColon) {
      parse_type_ty(tokens, skip_ws(tokens, p2 + 1))
    } else {
      (TVar(fresh_handle(span_at(tokens, p))), p2)
    } {
      (pty, p_ty) => {
        let p_after_ty = skip_ws(tokens, p_ty)
        match if at(tokens, p_after_ty, TEq) {
          match parse_expr(tokens, skip_ws(tokens, p_after_ty + 1)) {
            (default_expr, p_def) => (TParam(name, pty, Unmarked, Unmarked, Some(default_expr)), p_def),
          }
        } else {
          (TParam(name, pty, Unmarked, Unmarked, None), p_after_ty)
        } {
          (param, p_done) => {
            let p_next = skip_ws(tokens, p_done)
            if at(tokens, p_next, TComma) {
              match parse_config_params(tokens, skip_ws(tokens, p_next + 1)) {
                (rest, p_end) => ([param] ++ rest, p_end),
              }
            } else {
              ([param], expect(tokens, p_next, TRParen))
            }
          },
        }
      },
    }
  }
}

// Parse `import path/to/module`.
// An import segment is a TRANSPORT name (a file on disk), not an expression
// identifier — so a keyword-spelled word is a legal segment. `import own`
// lexes TImport TOwn, and ident_at's fabrication floor turned the module
// name into "" — every module importing src/own.mn walked an empty path
// (the DAG's phantom E_MissingModule at lib/.mn). The keyword set that
// collides with a real module name is exactly {own, ref}; other keywords
// name no file and fall to the same ident_at floor they always did.
fn import_segment_at(ref tokens, pos) = if at(tokens, pos, TOwn) {
  "own"
} else if at(tokens, pos, TRef) {
  "ref"
} else {
  ident_at(tokens, pos)
}

fn parse_import(ref tokens, pos) = match parse_import_path(tokens, pos, "") {
  (path, p) => (ImportStmt(path), p),
}

fn parse_import_path(ref tokens, pos, own acc) = {
  let name = import_segment_at(tokens, pos)
  let joined = acc ++ name
  let p = pos + 1
  if at(tokens, p, TSlash) { parse_import_path(tokens, p + 1, "{joined}/") } else { (joined, p) }
}

// A module's import edges, read from the token stream alone.
//
// An import is a LEXICAL fact: `import a/b` is TImport followed by the path's
// segments, and TImport appears nowhere else — the word inside a string lexes
// as that string, inside a comment as that comment. So the driver's dep walk
// never needed an AST. It built a full second tree per module, read the four
// strings it wanted off the top, and dropped the rest; the module was then
// parsed AGAIN by the pass that actually judges it. That is the carried truth
// discarded and re-derived, and the throwaway graph instance the discovery
// parse required existed only to contain mints this read never makes.
// THE WALK ITSELF IS THE COST, and it is not this fold's shape. A probe that
// replaced this body with a literal list took `fn main() = 7` from 0.78s to
// 0.50s — the entire 0.28s discovery floor is traversing the module's tokens
// once. Rewriting it as a position recursion, which allocates on the four hits
// instead of a product per token, measured IDENTICAL, so the per-token cost is
// the traversal and not the carrier. The fold stays because the law prefers it
// (iteration is topology) and no measurement bought the index-threaded form.
// What that 0.28s over ~25k tokens actually prices is named in RESIDUE: at
// ~11µs a token it is a substrate signal about traversal, not about imports.
fn import_edges(tokens) = match fold(
  (0, []),
  (acc, t) => match acc {
    (i, out) => (i + 1, if kind_eq(token_kind(t), TImport) {
      match parse_import_path(tokens, i + 1, "") {
        (path, _) => out ++ [path],
      }
    } else {
      out
    }),
  },
  tokens
) {
  (_, paths) => paths,
}

// Expressions — precedence-climbing
//
// The two expression slots the grammar distinguishes (SYNTAX §Nominal
// record types, the brace-header rule). FreeExpr admits every postfix
// continuation. BraceHeader is a slot whose OWN terminator is `{` — an
// `if` condition, a `match` scrutinee, a handler decl's state inits —
// where a capitalized name followed by `{` is the name alone (the brace
// opens the form's block; `None { x }` is otherwise unresolvable against
// the punned single-field record). Threaded through the binop spine;
// every bracketed recursion re-enters through parse_expr = FreeExpr, so
// `match (Person{name: n}) { ... }` stays available by parenthesizing.
type ExprSlot = FreeExpr | BraceHeader

// The brace-header entry — the operand ladder in the BraceHeader slot.
// `let` / `handle` top-forms are not header material (a header is a
// plain operand chain ending at the form's `{`).
fn parse_header_expr(ref tokens, pos) = parse_binop(tokens, skip_ws(tokens, pos), 1, BraceHeader)

fn parse_expr(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  let span = span_at(tokens, p)
  // Let-expression at expression-top. Seed parity: the seed's parse_expr
  // handles `let` as an expression form (let X = Y; Z or let X = Y\n Z).
  // This enables braceless fn bodies with let-chains:
  //   fn f(x) -> Int with Pure = let y = x; y
  // The let-expression parses binding + continuation (after ; or newline).
  if at(tokens, p, TLet) {
    parse_let_expr(tokens, p + 1, span)
  } else {
    parse_binop(tokens, p, 1, FreeExpr)
  }
}

// Let-expression in expression position. Desugars to BlockExpr:
//   let PAT = VAL; BODY  →  BlockExpr([LetStmt(PAT, VAL), ExprStmt(BODY)])
// This reuses the existing BlockExpr infrastructure (lowerer, inferrer,
// emitter all handle it). Chained lets nest naturally:
//   let a = 1; let b = 2; a + b
//   → BlockExpr([LetStmt(a, 1), ExprStmt(BlockExpr([LetStmt(b, 2), ExprStmt(a+b)]))])
// Seed parity: parser_expr.wat $parse_let_expr.
fn parse_let_expr(ref tokens, pos, start_span) = match parse_pat(tokens, pos) {
  (pat, p) => {
    let p2 = skip_ws(tokens, p)
    let p3 = if at(tokens, p2, TColon) {
      match parse_type_ty(tokens, skip_ws(tokens, p2 + 1)) {
        (_, p_ty) => skip_ws(tokens, p_ty),
      }
    } else {
      p2
    }
    let p4 = expect(tokens, p3, TEq)
    match parse_expr(tokens, skip_ws(tokens, p4)) {
      (val, p5) => {
        // The desugar reuses the value node as the absent-annotation sentinel
        // (Hβ.parser.let-expr-annotation); the let node mints before the
        // continuation parse (handle order is a per-compile fact, not a
        // meaning) and the weave pass attaches any interior prose by span.
        let let_stmt = nstmt(LetStmt(pat, val, val), start_span)
        let p6 = skip_sep(tokens, p5)
        match parse_expr(tokens, p6) {
          (body, p7) => // THE CHAIN FLATTENS AT PARSE: a continuation that is itself a block
          // merges into ONE statement sequence, so the braceless let-chain and the
          // braced block parse to the SAME graph (principle 2 — one meaning, one
          // graph; the per-let nested BlockExpr was a second shape for the same
          // program, and the formatter faithfully rendered the redundancy as a
          // brace pyramid). Scoping is identical: a statement-list let scopes over
          // the rest of its block exactly as the nesting did, and a merged
          // explicit block was the final expression — nothing followed it.
          match body {
            N{body: NExpr(BlockExpr(stmts2, final2))} => (desugar_block([let_stmt] ++ stmts2, final2, start_span), p7),
            _ => (desugar_block([let_stmt], body, start_span), p7),
          },
        }
      },
    }
  },
}

fn parse_binop(ref tokens, pos, min_prec, slot) = match parse_postfix(tokens, pos, slot) {
  (left, p) => binop_loop(tokens, left, p, min_prec, slot),
}

fn binop_loop(ref tokens, left, pos, min_prec, slot) = {
  let p = skip_ws(tokens, pos)
  let k = kind_at(tokens, p)
  let prec = op_prec(k)
  if prec >= min_prec && prec > 0 {
    let op_span = span_at(tokens, p)
    // Per Hβ.parser.binop-skip-ws-after-op (seed parser_expr.wat:41-45):
    // skip TNewlines AFTER the operator before the right operand.
    // `a == b() &&\n  c` had the right-recursion start at p+1 (the
    // trailing newline) → parse_primary truncates the chain. Newlines
    // around a binop are transparent in BOTH directions (SYNTAX.md —
    // layout is never semantics; the table is the only scope law).
    match parse_binop(tokens, skip_ws(tokens, p + 1), prec + 1, slot) {
      (right, p2) => match left {
        N{span: left_span} => {
          // The operation's span is its whole extent, left operand through
          // right — it used to stop at the operator (`x * ` for `x * 2`), a
          // span that named no expression in the source.
          let combined_span = match right {
            N{span: right_span} => span_join(left_span, right_span),
          }
          let node = match op_to_pipe_kind(k) {
            Some(pk) => match pk {
              PFanout(FanDistribute) => // The N-ary law (SYNTAX §><): a `><` chain's branches are
              // peers in ONE FanoutExpr, accreted by the left-assoc loop —
              // never nested pairs (the fold was the binary shape's
              // artifact, not the verb's semantics). An authored
              // tuple-valued branch stays a branch: only the chain
              // accretes, so `(1, 2) >< (3, 4)` is two branches of two.
              match left {
                N{body: NExpr(FanoutExpr(branches))} => nexpr(FanoutExpr(branches ++ [right]), combined_span),
                _ => nexpr(FanoutExpr([left, right]), combined_span),
              },
              _ => nexpr(PipeExpr(pk, left, right), combined_span),
            },
            None => match op_to_binop(k) {
              Some(bo) => nexpr(BinOpExpr(bo, left, right), combined_span),
              None => {
                // Unreachable per caller invariant: op_prec(k) > 0 and
                // op_to_pipe_kind returned None together imply k
                // IS a binop token. ICE rather than fabricate a BinOp —
                // if this ever fires, op_prec and op_to_binop have
                // drifted out of sync.
                //
                // drift-audit: ignore
                report(EInternalInvariant("op_to_binop returned None for token with op_prec > 0", op_span))
                nexpr(BinOpExpr(BAdd, left, right), combined_span)
              },
            },
          }
          binop_loop(tokens, node, p2, min_prec, slot)
        },
      },
    }
  } else {
    // Comments are graph content, never layout: with no continuation the
    // caller resumes AT the comment run so it reaches the statement layer
    // and attaches (SYNTAX §Comments — never dropped). Newlines/semis
    // stay consumed exactly as before.
    (left, skip_seps_only(tokens, pos))
  }
}

// Postfix: call, field access, indexing.
fn parse_postfix(ref tokens, pos, slot) = match parse_primary(tokens, pos, slot) {
  (e, p) => postfix_loop(tokens, e, p, slot),
}

fn postfix_loop(ref tokens, e, pos, slot) = match kind_at(tokens, pos) {
  TLParen => match parse_call_args(tokens, skip_ws(tokens, pos + 1)) {
    (args, p2) => match e {
      N{span: start_span} => {
        let end_span = span_at(tokens, p2 - 1)
        postfix_loop(tokens, nexpr(CallExpr(e, args), span_join(start_span, end_span)), p2, slot)
      },
    },
  },
  TLBracket => // Subscript `xs[i]` per SYNTAX.md:611-632 + #139. The parser
  // produces IndexExpr(receiver, index) as a semantic AST node;
  // infer dispatches on the receiver's chase-deep Ty:
  //   T[A] → list_index runtime call
  //   TTuple → compile-time slot from constant index
  //   TRecord-by-int-key → record_get
  // The prior eager fold to CallExpr(VarRef("list_index")) at parse
  // time committed the dispatch before infer knew the receiver's
  // shape — drift mode 9. Refinements on the index elide the
  // runtime bounds check via gradient ascent (peer Hβ.emit.refinement-
  // elide-bounds).
  match parse_expr(tokens, skip_ws(tokens, pos + 1)) {
    (idx_expr, p2) => {
      let p3 = expect(tokens, skip_ws(tokens, p2), TRBracket)
      match e {
        N{span: start_span} => {
          let end_span = span_at(tokens, p3 - 1)
          postfix_loop(tokens, nexpr(IndexExpr(e, idx_expr), span_join(start_span, end_span)), p3, slot)
        },
      }
    },
  },
  TDot => {
    let field = ident_at(tokens, pos + 1)
    match e {
      N{span: start_span} => {
        let field_span = span_at(tokens, pos + 1)
        postfix_loop(tokens, nexpr(FieldExpr(e, field), span_join(start_span, field_span)), pos + 2, slot)
      },
    }
  },
  TLBrace => // H2.3 nominal record literal: `Person{name: "Morgan", ...}`.
  // Type names are capitalized; lowercase identifiers fall through
  // and the brace stays a separate construct. In a BraceHeader slot
  // the `{` is the FORM's own opener (SYNTAX §Nominal record types,
  // brace-header rule): `with found = None {`, `match acquired {`,
  // `if x == None {` — the continuation never fires there; a record
  // literal in a header parenthesizes.
  match e {
    N{body, span: start_span} => {
      let is_named_record = match slot {
        BraceHeader => false,
        FreeExpr => match body {
          NExpr(VarRef(name)) => byte_len(name) > 0 && first_char_code(name) >= 65 && first_char_code(name) <= 90,
          _ => false,
        },
      }
      if is_named_record {
        let type_name = match body {
          NExpr(VarRef(n)) => n,
          _ => // drift-audit: ignore — unreachable: is_named_record proved body is VarRef; "" defensive
          "",
        }
        match parse_named_record_body(tokens, pos + 1) {
          (sorted, p2) => {
            let end_span = span_at(tokens, p2 - 1)
            postfix_loop(
              tokens,
              nexpr(NamedRecordExpr(type_name, sorted), span_join(start_span, end_span)),
              p2,
              slot
            )
          },
        }
      } else {
        (e, pos)
      }
    },
  },
  _ => // No postfix suffix here. `<` is ALWAYS comparison (TLt) — angle-bracket
  // generics are retired everywhere (the case rule IS the declaration; types
  // apply with parens). The parser has ONE precedence table + productive-
  // under-error, so a stale `f<T>(args)` keystroke parses as the comparison
  // chain the precedence table draws, and the general unexpected-token /
  // type-mismatch diagnostic teaches in context — NOT a Rust-specific
  // balanced-`<...>` lookahead. A bespoke recognizer per foreign syntax does
  // not scale (the owner's point); the general diagnostic path is the one home.
  (e, pos),
}

// Parse the body of a nominal record literal — same shape as
// `parse_record_fields` but invoked from a different surface
// (postfix-suffix vs primary). Sorts fields by name at parse time
// to maintain the substrate-wide invariant.
fn parse_named_record_body(ref tokens, pos) = {
  let buf = make_list(4)
  match parse_record_fields(tokens, pos, buf, 0) {
    (final_buf, final_count, p) => {
      let sorted = sort_record_fields(slice(final_buf, 0, final_count))
      (sorted, p)
    },
  }
}

// Labeled call arguments (`f(x = a, y = b)` — SYNTAX.md §«Labeled call
// arguments») are the parameter-list-AS-product surface: a call may
// construct its arg product positionally, by field, or mixed — the SAME
// machinery as a record literal. A `name =` at a call site parses as a
// LabeledArg(name, value) carrying the product-field name; resolve_call_args
// (types.mn, the one read both infer + lower call) reorders these to
// positional against the callee's declared param names (E_UnknownArgLabel on
// a miss) and fills absent fields with their param defaults. The label rides
// ON the arg node, so the 23 CallExpr consumers that just walk a Node list are
// untouched — the wrapper is resolved away before infer_expr / lower_expr.
fn parse_call_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], p + 1)
  } else {
    match parse_one_call_arg(tokens, p) {
      (arg, p2) => {
        let p3 = skip_ws(tokens, p2)
        if at(tokens, p3, TComma) {
          match parse_call_args(tokens, skip_ws(tokens, p3 + 1)) {
            (rest, p4) => ([arg] ++ rest, p4),
          }
        } else {
          ([arg], expect(tokens, p3, TRParen))
        }
      },
    }
  }
}

// One call argument: a labeled `name = value` (LabeledArg) when an ident is
// immediately followed by `=` (not `==`), else a positional expression. The
// `name =` lookahead is the product-field-naming surface; the value parses as
// an ordinary expression. (`==` is comparison — a positional arg `a == b`.)
fn parse_one_call_arg(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  match kind_at(tokens, p) {
    TIdent(name) => {
      let p_eq = skip_ws(tokens, p + 1)
      if at(tokens, p_eq, TEq) {
        let span = span_at(tokens, p)
        match parse_expr(tokens, skip_ws(tokens, p_eq + 1)) {
          (val, p2) => (nexpr(LabeledArg(name, val), span), p2),
        }
      } else {
        parse_expr(tokens, p)
      }
    },
    _ => parse_expr(tokens, p),
  }
}

// Primary expressions
fn parse_primary(ref tokens, pos, slot) = {
  let span = span_at(tokens, pos)
  match kind_at(tokens, pos) {
    TIntLit(n) => (nexpr(LitInt(n), span), pos + 1),
    TFloatLit(f) => (nexpr(LitFloat(f), span), pos + 1),
    TStringLit(s) => (nexpr(LitString(s), span), pos + 1),
    TStringPart(s) => parse_string_interpolation(tokens, pos + 1, s, span),
    TTrue => (nexpr(LitBool(true), span), pos + 1),
    TFalse => (nexpr(LitBool(false), span), pos + 1),
    TIdent(name) => {
      // SYNTAX.md:1417, 1599 — E_NotAKeyword: user typed a non-Mentl
      // keyword from another language. Mentl uses verb forms (iterate,
      // perform, resume) per substrate. Parse continues with VarRef
      // (the name binds normally; infer surfaces missing-variable at
      // infer time). Diagnostic gives the user the gradient toward
      // Mentl idiom.
      if is_foreign_keyword(name) { report(ENotAKeyword(name, span)) } else { () }
      (nexpr(VarRef(name), span), pos + 1)
    },
    THole => {
      let id = fresh_handle(span)
      (nhole(id, span), pos + 1)
    },
    TLParen => parse_paren_or_tuple(tokens, pos + 1, span),
    TLBracket => parse_list_literal(tokens, pos + 1, span),
    TLBrace => parse_brace_expr(tokens, pos + 1, span),
    TIf => parse_if(tokens, pos + 1, span),
    TMatch => parse_match(tokens, pos + 1, span),
    TOwn => // `own`/`ref` are contextual keywords (ownership prefixes in
    // param position only); in expression position they are idents
    // (`match own { }`, `= ref`). Seed
    // parity ($ident_at_p maps TOwn→"own"/TRef→"ref" — the seed parses
    // `match own {}` as a VarRef scrutinee, verified empirically).
    (nexpr(VarRef("own"), span), pos + 1),
    TRef => (nexpr(VarRef("ref"), span), pos + 1),
    THandler => // `handler` is a contextual keyword (handler declarations in
    // parse_stmt); in expression position it is an ident
    // (`return handler`, `handler` as param name). Same treatment as
    // TOwn/TRef — seed $ident_at_p maps THandler→"handler".
    (nexpr(VarRef("handler"), span), pos + 1),
    TResume => parse_resume(tokens, pos + 1, span),
    TPipe => {
      // SYNTAX.md:307-315 — E_LambdaFence: pipe-fenced params syntax is // drift-audit: ignore
      // REJECTED. Canonical is parenthesized-params + fat-arrow body. // drift-audit: ignore
      // Parse continues via parse_lambda; the diagnostic surfaces the
      // Quick-Fix rewrite.
      report(ELambdaFence(span))
      parse_lambda(tokens, pos + 1, span)
    },
    TFn => // SYNTAX.md §148-190 + §317-322: anonymous lambda via the fn-keyword // drift-audit: ignore
    // is REJECTED (E_RedundantFnOnLambda). The fn-keyword is reserved
    // on named declarations; anonymous lambdas use parenthesized params
    // + fat-arrow body. Parse continues; diagnostic surfaces Quick-Fix.
    {
      report(ERedundantFnOnLambda(span))
      let p = skip_ws(tokens, pos + 1)
      let p2 = expect(tokens, p, TLParen)
      match parse_fn_params(tokens, p2) {
        (params, dlets, p3) => {
          let p4 = expect(tokens, skip_ws(tokens, p3), TFatArrow)
          match parse_body(tokens, skip_ws(tokens, p4)) {
            (raw_body, p5) => {
              let body = bind_param_destructures(dlets, raw_body, span)
              (nexpr(LambdaExpr(params, body), lambda_span(span, body)), p5)
            },
          }
        },
      }
    },
    TMinus => match parse_postfix(tokens, pos + 1, slot) {
      (inner, p) => (nexpr(UnaryOpExpr(UNeg, inner), span), p),
    },
    TBang => match parse_postfix(tokens, pos + 1, slot) {
      (inner, p) => (nexpr(UnaryOpExpr(UNot, inner), span), p),
    },
    TOrOr => // SYNTAX.md:324-329 — E_LambdaAsOrOr: the double-pipe at expression
    // start position is the logical-OR token (TOrOr), not a zero-arg
    // lambda. Canonical zero-arg lambda is `() => body`. Parse continues
    // as `() => <next-expr>` per the Quick-Fix.
    {
      report(ELambdaAsOrOr(span))
      match parse_expr(tokens, pos + 1) {
        (body, p) => (nexpr(LambdaExpr([], body), lambda_span(span, body)), p),
      }
    },
    TTildeGt => // SYNTAX.md:1593 — E_OrphanHandlerAttach: the tee-arrow at expression
    // start position has no preceding chain. Quick-Fix shape per spec:
    // delete the tee-arrow OR supply a body. Parser recovery: emit
    // diagnostic, return hole, advance past the tee-arrow token.
    {
      report(EOrphanHandlerAttach(span))
      let id = fresh_handle(span)
      (nhole(id, span), pos + 1)
    },
    _ => {
      report(PUnexpectedToken("unexpected token: {show_token_kind(kind_at(tokens, pos))}", span))
      let id = fresh_handle(span)
      (nhole(id, span), pos + 1)
    },
  }
}

// ─── Destructuring parameters = param-as-pattern (SYNTAX.md §«Anonymous
// functions», §«Function declarations») ──────────────────────────────────
//
// A param IS a Pat; `({name, age})` / `((a, b))` / `([h, ...t])` bind a
// PRecord/PTuple/PList at the parameter. The ultimate form is byte-identical to
// a destructuring `let`: the param desugars at fn ENTRY to a fresh-named param
// plus a `let <pat> = <fresh>` prepended to the body — the SAME projection
// desugar_block turns a destructuring let into a `match`. ONE pattern machinery
// at let-bind AND param-bind; no new infer/lower path, no TParam shape change.
//
// A unique parameter name for a desugared destructure slot — keyed on the
// pattern's fresh handle so it never collides with a source name. The two
// prefixes are the one home of their spelling; the formatter reads
// `dp_prefix` back when it decides whether a param may render in param
// position. That reader lives in format.mn, which imports THIS module and
// is not importable from here — so it is named in prose rather than
// backticked, because a reference that resolves only through the link's
// flattened env is the rot the backtick gate exists to catch.
let dp_prefix = "__dp"

let al_prefix = "__al"

fn fresh_param_name(span: ValidSpan) = "{dp_prefix}{int_to_str(fresh_handle(span))}"

// A fresh param under a caller-chosen PREFIX. The two surfaces that mint
// one differ in what the name PROMISES, and conflating them is a silent
// wrong rather than a naming preference. `dp_prefix` says "this param
// came from a PATTERN IN PARAM POSITION", which licenses the formatter's
// one-arm destructure render (format.mn) — sound only because
// `expr_to_pat` produced the pattern, and `expr_to_pat` answers PWild for
// a literal and for a constructor call. `al_prefix` carries ARBITRARY arm
// patterns, so the same render would turn `{ 0 => 1 }` into `(0) => 1` —
// a WILDCARD — with nothing anywhere to say it had. Distinct prefixes
// make that unsayable; fmt's own second render is what would otherwise
// have found it in production.
fn fresh_param_under(prefix: String, span: ValidSpan) = {
  let nm = "{prefix}{int_to_str(fresh_handle(span))}"
  (nm, TParam(nm, TVar(fresh_handle(span)), Unmarked, Unmarked, None))
}

// Convert a parsed expr (a lambda param, already parsed as an expression) to a
// pattern: a record/tuple/list literal IS the corresponding destructure
// pattern; a bare var is PVar; anything else is PWild (productive-under-error).
fn expr_to_pat(e) = match e {
  N{body: eb, span: sp} => npat(expr_body_to_pat(eb), sp),
}

fn expr_body_to_pat(eb) = match eb {
  NExpr(VarRef(nm)) => if nm == "_" { PWild } else { PVar(nm) },
  NExpr(MakeRecordExpr(flds)) => PRecord(sort_pat_fields(record_fields_to_pat(flds)), None),
  NExpr(NamedRecordExpr(name, flds)) => PConFields(name, record_fields_to_pat(flds)),
  NExpr(MakeTupleExpr(elems)) => PTuple(map(expr_to_pat, elems)),
  NExpr(MakeListExpr(elems)) => // a trailing RestExpr (the cover-grammar rest the list parser
  // minted for `([h, ...t]) =>`) becomes PList's rest — consumed
  // HERE, so it never reaches infer on the lambda path.
  if len(elems) > 0 {
    match last(elems) {
      N{body: lb} => match lb {
        NExpr(RestExpr(rest_nm)) => PList(map(expr_to_pat, drop_last(elems)), Some(rest_nm)),
        _ => PList(map(expr_to_pat, elems), None),
      },
    }
  } else {
    PList([], None)
  },
  _ => PWild,
}

// Record literal fields `[(name, value_node)]` → pattern fields
// `[(name, sub_pat)]` — the value node's pattern (field punning `{x}` parses
// as `x: x`, so the sub-pat is the value's pattern).
fn record_fields_to_pat(flds) = map({ (nm, v) => (nm, expr_to_pat(v)) }, flds)

// A param drawn from a Pat: PVar is the bare-name degenerate (no desugar);
// any destructure pattern yields a fresh-named param plus its binding — the
// pattern, the fresh name's reference, and the span — which
// bind_param_destructures turns into the arm on that parameter.
// Returns (TParam, Option(binding)).
fn pat_param_and_let(pat, span: ValidSpan) = match pat_of(pat) {
  PVar(nm) => (TParam(nm, TVar(fresh_handle(span)), Unmarked, Unmarked, None), None),
  PWild => (TParam("_", TVar(fresh_handle(span)), Unmarked, Unmarked, None), None),
  _ => match fresh_param_under(dp_prefix, span) {
    (fresh, param) => (param, Some((pat, nexpr(VarRef(fresh), span), span))),
  },
}

// A pattern in parameter position is an ARM on the argument, not a `let`:
// `((a, b)) => e` is the arm list `{ (a, b) => e }`, so it must take every
// value the parameter can hold (coverage says so when it does not) and it
// never aborts. The refusal arm belongs to an authored `let` alone. Each
// binding wraps the body in its one-arm match, the first parameter's
// outermost; no bindings leave the body untouched.
fn bind_param_destructures(binds, body, span: ValidSpan) = binds |> reverse |> fold(body, param_arm)

fn param_arm(inner, bind) = match bind {
  (pat, v, sp) => nexpr(MatchExpr(v, [(pat, inner)]), sp),
}

// Convert a list of parsed expr nodes (paren-lambda params) into a TParam list
// PLUS the destructure-let bindings — each elem's pattern (expr_to_pat) drives
// pat_param_and_let, so `((x, y)) => …` / `({a, b}) => …` bind their pattern at
// fn entry. Parallel buffer-counter build (params + lets); returns
// (params, lets).
fn exprs_to_params(elems, i, n, own buf, count, own lbuf, lcount) = if i >= n {
  (slice(buf, 0, count), slice(lbuf, 0, lcount))
} else {
  let e = list_index(elems, i)
  match e {
    N{span: esp} => match pat_param_and_let(expr_to_pat(e), esp) {
      (param, opt_let) => match push_node(buf, count, param) {
        (b1, c1) => match push_opt_let(lbuf, lcount, opt_let) {
          (lb1, lc1) => exprs_to_params(elems, i + 1, n, b1, c1, lb1, lc1),
        },
      },
    },
  }
}

fn parse_paren_or_tuple(ref tokens, pos, start_span) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    // `()` — zero-arg lambda `() => body` (SYNTAX.md canonical) when
    // `=>` follows, else unit. One `=>`-peek mechanism across arities
    // 0/1/N (seed parser_compound drift-6 closure).
    let p_after = skip_ws(tokens, p + 1)
    if at(tokens, p_after, TFatArrow) {
      match parse_expr(tokens, skip_ws(tokens, p_after + 1)) {
        (body, pb) => (nexpr(LambdaExpr([], body), lambda_span(start_span, body)), pb),
      }
    } else {
      (nexpr(LitUnit, start_span), p + 1)
    }
  } else {
    match parse_expr(tokens, p) {
      (first, p2) => {
        let p3 = skip_ws(tokens, p2)
        if at(tokens, p3, TComma) {
          let buf = make_list(4)
          match push_node(buf, 0, first) {
            (b1, c1) => match parse_tuple_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1) {
              (final_buf, final_count, final_pos) => {
                let p_after = skip_ws(tokens, final_pos)
                if at(tokens, p_after, TFatArrow) {
                  // `(e1, e2, ...) => body` — multi-param lambda; the parsed
                  // tuple-elems reinterpret as params (seed parity:
                  // parser_compound $parse_lambda_from_paren_multi).
                  let elems = slice(final_buf, 0, final_count)
                  match exprs_to_params(elems, 0, final_count, make_list(4), 0, make_list(4), 0) {
                    (params, dlets) => match parse_expr(tokens, skip_ws(tokens, p_after + 1)) {
                      (raw_body, pb) => {
                        let body = bind_param_destructures(dlets, raw_body, start_span)
                        (nexpr(LambdaExpr(params, body), lambda_span(start_span, body)), pb)
                      },
                    },
                  }
                } else {
                  (nexpr(MakeTupleExpr(slice(final_buf, 0, final_count)), start_span), final_pos)
                }
              },
            },
          }
        } else {
          let p4 = expect(tokens, p3, TRParen)
          let p_after = skip_ws(tokens, p4)
          if at(tokens, p_after, TFatArrow) {
            // `(e) => body` — single-param lambda; `first` reinterprets
            // as the param. A destructure (`({x,y}) => …`) binds its pattern at
            // entry via the same prepend-let machinery.
            match first {
              N{span: fsp} => match pat_param_and_let(expr_to_pat(first), fsp) {
                (param, opt_let) => match parse_expr(tokens, skip_ws(tokens, p_after + 1)) {
                  (raw_body, pb) => {
                    let body = bind_param_destructures(
                      match opt_let {
                        Some(l) => [l],
                        None => [],
                      },
                      raw_body,
                      start_span
                    )
                    (nexpr(LambdaExpr([param], body), lambda_span(start_span, body)), pb)
                  },
                },
              },
            }
          } else {
            (first, p4)
          }
        }
      },
    }
  }
}

fn parse_tuple_tail(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    (buf, count, p + 1)
  } else {
    match parse_expr(tokens, p) {
      (elem, p2) => match push_node(buf, count, elem) {
        (b1, c1) => {
          let p3 = skip_ws(tokens, p2)
          if at(tokens, p3, TComma) {
            parse_tuple_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1)
          } else {
            (b1, c1, expect(tokens, p3, TRParen))
          }
        },
      },
    }
  }
}

// String interpolation per SYNTAX.md:1137-1187. Lexer (src/lexer.mn:262-309)
// tokenizes `"prefix{expr}suffix"` as:
//   TStringPart("prefix"), TStringSplice, <expr tokens>, TStringPart("suffix")
// where the closing `}` is consumed by lex_from (no terminator token). Multi-
// splice strings cascade the same alternation. Plain `"foo"` emits just
// TStringPart("foo") with no following splice.
//
// parse_string_interpolation enters with pos AFTER the first TStringPart and
// first_chunk holding its content. Loop: if next is TStringSplice, parse the
// inner expression via parse_expr (terminates naturally at TStringPart, the
// next non-operator-continuation), consume the next TStringPart for the
// trailing literal chunk, fold into a str_concat chain.
//
// Substrate: desugars to nested CallExpr(VarRef("str_concat"), [a, b]) — no
// new AST variant. Plain non-interpolated strings stay as bare LitString
// (single fragment, no splice → loop terminates immediately, returns
// nexpr(LitString(first_chunk), span)).
//
// Per #138 — interpolation is a SEMANTIC AST node (MakeStringExpr)
// carrying alternating literal-fragments + splice-exprs. The prior
// eager-str_concat-fold drift committed result shape at parse time;
// the new form lets infer narrow (Show-able splice check) and the
// gradient teach constant-foldable splices at the cursor's read.
//
// If the lexer emitted no TStringSplice after the literal prefix, the
// interpolation degenerates to a bare LitString. Adjacent TStringPart tokens
// are normal for a multi-line `"""..."""` body (the lexer flushes one part
// per line as it strips the common indent), so coalesce them before
// deciding whether the string is interpolating.
fn parse_string_interpolation(ref tokens, pos, first_chunk, start_span) = match consume_string_parts(tokens, pos, first_chunk) {
  (prefix, p0) => if at(tokens, p0, TStringSplice) {
    let first_node = nexpr(LitString(prefix), start_span)
    let buf = make_list(4)
    match push_node(buf, 0, first_node) {
      (b1, c1) => match parse_string_interpolation_loop(tokens, p0, b1, c1, start_span) {
        (final_buf, final_count, final_pos) => (nexpr(MakeStringExpr(slice(final_buf, 0, final_count)), start_span), final_pos),
      },
    }
  } else {
    (nexpr(LitString(prefix), start_span), p0)
  },
}

fn parse_string_interpolation_loop(ref tokens, pos, own buf, count, start_span) = if at(tokens, pos, TStringSplice) {
  match parse_expr(tokens, pos + 1) {
    (splice_expr, p2) => {
      // After the splice expression, the lexer emits TRBrace as the
      // splice terminator (lexer.mn:230-235). Consume it before looking
      // for the next TStringPart chunk. Seed parity: $parse_string_expr
      // expects and skips the terminating `}` at offset+1 past the inner
      // expression.
      let p2b = if at(tokens, p2, TRBrace) { p2 + 1 } else { p2 }
      match consume_string_parts(tokens, p2b, "") {
        (next_chunk, p3) => {
          let next_chunk_node = nexpr(LitString(next_chunk), start_span)
          // γ's splice half: the structural show minted HERE as a
          // program node, so lower reads a judged handle instead of
          // minting a placeholder cell per run.
          match push_node(buf, count, nexpr(ShowExpr(splice_expr), start_span)) {
            (b1, c1) => match push_node(b1, c1, next_chunk_node) {
              (b2, c2) => parse_string_interpolation_loop(tokens, p3, b2, c2, start_span),
            },
          }
        },
      }
    },
  }
} else {
  (buf, count, pos)
}

// After a TStringSplice's inner expression, the next token must be one or more
// TStringPart chunks. More than one chunk is normal in a multi-line
// `"""..."""` body, where the lexer flushes one part per line. Returns
// (coalesced_chunk, advanced_pos).
fn consume_string_parts(ref tokens, pos, acc) = match kind_at(tokens, pos) {
  TStringPart(s) => consume_string_parts(tokens, pos + 1, acc ++ s),
  _ => (acc, pos),
}

fn parse_list_literal(ref tokens, pos, start_span) = {
  let buf = make_list(4)
  match parse_list_elems(tokens, pos, buf, 0) {
    (final_buf, final_count, p) => (nexpr(MakeListExpr(slice(final_buf, 0, final_count)), start_span), p),
  }
}

fn parse_list_elems(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBracket) {
    (buf, count, p + 1)
  } else if at_ellipsis(tokens, p) {
    // `...name` — the cover-grammar rest (the paren-lambda parameter
    // path parses its content as an expression before `=>` is seen;
    // expr_to_pat consumes this into PList's rest, and infer refuses
    // it loudly anywhere else). Rest closes the list — it is the tail.
    let rest_name = ident_at(tokens, p + 3)
    let elem = nexpr(RestExpr(rest_name), span_at(tokens, p))
    match push_node(buf, count, elem) {
      (b1, c1) => (b1, c1, expect(tokens, skip_ws(tokens, p + 4), TRBracket)),
    }
  } else {
    match parse_expr(tokens, p) {
      (elem, p2) => match push_node(buf, count, elem) {
        (b1, c1) => {
          let p3 = skip_ws(tokens, p2)
          if at(tokens, p3, TComma) {
            parse_list_elems(tokens, skip_ws(tokens, p3 + 1), b1, c1)
          } else {
            (b1, c1, expect(tokens, p3, TRBracket))
          }
        },
      },
    }
  }
}

// ─── The arm-list discrimination ────────────────────────────────────
//
// `{ p => b, … }` is the FUNCTION LITERAL (SYNTAX §«Function literals»):
// a function is MINTED with an arm list, and the graph it builds is the
// one the destructuring desugar already builds — a one-param lambda whose
// body matches that param. So the literal adds a spelling and no node,
// and `parse_arm_list` reuses `parse_match_arms` verbatim.
//
// The question the brace has to answer is "could a PATTERN end here,
// followed by `=>`?", and it has to answer it WITHOUT parsing one:
// `parse_pat`'s miss arm reports `PUnexpectedToken`, so a speculative
// parse would narrate a diagnostic for every block that merely opens with
// an ident. `pat_prefix_end` is that question as a token scan.
//
// It is STRUCTURED, not greedy, and that is what makes it sound: a
// pattern is ONE atom — an ident (optionally applied), a literal, or a
// balanced group — joined to further atoms only by `@` (as-pattern) or
// `|` (alternation). Two ADJACENT atoms are never a pattern, so a block
// whose statement chain happens to reach a lambda (`{ setup()` newline
// `(x) => run(x) }`) stops at the second atom and reads as the block it
// is. Measured before it was written: zero sites in src/ or lib/ open a
// brace on a paren-lambda, and every `{`-then-`(tuple) =>` in the tree is
// a match arm list, which is the same shape by construction.
fn pat_prefix_end(tokens, pos) = {
  let one = pat_atom_end(tokens, pos)
  if one == pos {
    pos
  } else {
    let q = skip_ws(tokens, one)
    if at(tokens, q, TPipe) || at(tokens, q, TAt) {
      pat_prefix_end(tokens, skip_ws(tokens, q + 1))
    } else {
      one
    }
  }
}

// One pattern atom, or `pos` unmoved when the token cannot open one.
fn pat_atom_end(tokens, pos) = match kind_at(tokens, pos) {
  TIdent(_) => {
    let p1 = skip_ws(tokens, pos + 1)
    // an applied ident, positionally `Some(v)` or by field `Holds{level}`
    if at(tokens, p1, TLParen) || at(tokens, p1, TLBrace) { skip_group(tokens, p1, 0) } else { pos + 1 }
  },
  TIntLit(_) => pos + 1,
  TFloatLit(_) => pos + 1,
  TStringPart(_) => pos + 1,
  TTrue => pos + 1,
  TFalse => pos + 1,
  TLParen => skip_group(tokens, pos, 0),
  TLBracket => skip_group(tokens, pos, 0),
  TLBrace => skip_group(tokens, pos, 0),
  _ => pos,
}

// Past a balanced group opening AT `pos`. `TStringSplice` opens a brace
// level of its own (a `{expr}` splice closes on TRBrace, SYNTAX §Token
// enumeration), so an interpolating string inside the group cannot hand
// the scan an unmatched closer. TEof ends the walk rather than looping —
// a broken input diagnoses at the parse, never here.
fn skip_group(tokens, pos, depth) = match kind_at(tokens, pos) {
  TEof => pos,
  TLParen => skip_group(tokens, pos + 1, depth + 1),
  TLBracket => skip_group(tokens, pos + 1, depth + 1),
  TLBrace => skip_group(tokens, pos + 1, depth + 1),
  TStringSplice => skip_group(tokens, pos + 1, depth + 1),
  TRParen => if depth <= 1 { pos + 1 } else { skip_group(tokens, pos + 1, depth - 1) },
  TRBracket => if depth <= 1 { pos + 1 } else { skip_group(tokens, pos + 1, depth - 1) },
  TRBrace => if depth <= 1 { pos + 1 } else { skip_group(tokens, pos + 1, depth - 1) },
  _ => skip_group(tokens, pos + 1, depth),
}

// The literal, built as the shape it already is: a fresh `al_prefix` param
// and a match on it. `parse_match_arms` consumes the closing brace, so the
// form and `match`'s own arms have one parser between them.
fn parse_arm_list(tokens, pos, start_span: ValidSpan) = {
  let buf = make_list(4)
  match parse_match_arms(tokens, pos, buf, 0) {
    (final_buf, final_count, p) => match fresh_param_under(al_prefix, start_span) {
      (fresh, param) => {
        let arms = slice(final_buf, 0, final_count)
        let body = nexpr(MatchExpr(nexpr(VarRef(fresh), start_span), arms), start_span)
        (nexpr(LambdaExpr([param], body), lambda_span(start_span, body)), p)
      },
    },
  }
}

// The desugar READ BACK — a match that IS an authored `let`: its first arm
// the let's pattern over the rest of the block, its second the refusal
// `desugar_block` appends. The formatter renders it as the let it was, which
// is the only way a let survives a save; written as its match it would be a
// second spelling of one graph. A pattern that binds a plain name was never
// desugared, so only a destructuring pattern is a let here.
fn let_arm(node) = match node {
  N{body: NExpr(MatchExpr(v, [(pat, rest), (refused, refusal)]))} => if is_destructure_pat(pat) && is_let_refusal(refused, refusal) {
    Some((pat, v, rest))
  } else {
    None
  },
  _ => None,
}

fn is_let_refusal(refused, refusal) = match (pat_of(refused), refusal) {
  (PWild, N{body: NExpr(CallExpr(N{body: NExpr(VarRef(callee))}, []))}) => callee == "abort",
  _ => false,
}

// The literal READ BACK — the arms of a lambda that IS one, or None.
// Its home is here rather than at either reader because two of them ask
// the same question of one shape: `format.mn` renders the literal back
// (Governing Principle 1 — which spelling reaches the page is the
// formatter's decision, so fmt does not merely permit the form, it
// PRODUCES it and converting a corpus is one `mentl fmt`), and
// `query.mn`'s anonymity census must NOT convict it, because a literal
// is a genuine MINT — pattern dispatch no reference-with-a-hole can
// express — where the conviction that can reach zero is a reference
// WRITTEN as a mint.
//
// Recognition is the shape itself: a sole param, a body that matches
// exactly that param, and the param NOT free in any arm. The last
// condition is load-bearing rather than defensive — a param an arm body
// reads is still bound by the head, and dropping the binder would unbind
// it. `free_vars_match_arms` already binds each arm's own pattern, so
// the question is asked of the one walk that answers it.
//
// There is NO carve-out for the param-position destructure, and that is
// a decision rather than an omission: `((a, b)) => e` is a CASE of the
// arm list, and this arc deletes `(params) => body` at its end, so fmt
// manufacturing more of the doomed spelling would be the sweep running
// backwards. The formatter's param-position render keeps every
// MULTI-param lambda (`(a, (b, c)) => e` has two params, so `len(params)
// != 1` refuses it here) and every `fn` decl, whose pattern param is a
// different surface.
fn arm_list_of(params, body) = if len(params) != 1 {
  None
} else {
  let nm = param_name(params[0])
  match body {
    N{body: b} => match b {
      NExpr(MatchExpr(scrut, arms)) => match scrut {
        N{body: sb} => match sb {
          NExpr(VarRef(snm)) => if snm == nm && !free_vars_contains(free_vars_match_arms(arms, []), nm) { Some(arms) } else { None },
          _ => None,
        },
      },
      _ => None,
    },
  }
}

// Disambiguate `{`: arm list vs record literal vs block. Per SYNTAX.md,
// after the opening brace + whitespace, a pattern-shaped prefix followed
// by `=>` signals the function literal; an identifier token followed by
// `:` (typed field) or `,`/`}` (puned field) signals a record literal.
// Anything else is a block. The lookahead never backtracks and never
// reports — no ambiguity escapes the parser.
fn parse_brace_expr(ref tokens, pos, start_span) = {
  let p = skip_ws(tokens, pos)
  // A record literal opens with an ident-shaped field name (incl. the
  // contextual keywords own/ref/handle — SYNTAX.md §572, #117 class)
  // followed by `:` / `,` / `}`. Canonical projection is_param_name_tok
  // (the Bool gate) extends the discrimination uniformly; otherwise a
  // block. `{ handle: handle, ... }` was mis-read as a block → `:`
  // unexpected.
  if at_ellipsis(tokens, p) {
    // `{...base, f: v}` — non-destructive record update (SYNTAX.md
    // §«Record update»). The leading spread is unambiguous: a block
    // never opens with `...`.
    parse_record_update(tokens, p, start_span)
  } else if at(tokens, pat_prefix_end(tokens, p), TFatArrow) {
    parse_arm_list(tokens, p, start_span)
  } else if is_param_name_tok(tokens, p) {
    let p2 = skip_ws(tokens, p + 1)
    match kind_at(tokens, p2) {
      TColon => parse_record_literal(tokens, pos, start_span),
      TComma => parse_record_literal(tokens, pos, start_span),
      TRBrace => parse_record_literal(tokens, pos, start_span),
      _ => parse_block_expr(tokens, pos, start_span),
    }
  } else {
    parse_block_expr(tokens, pos, start_span)
  }
}

// `{...base, f: v, ...}` → RecordUpdateExpr(base, sorted_override_fields).
// The spread base is parsed as an expression; the remaining fields parse
// through the same parse_record_fields machinery as a plain record
// literal and sort identically. Non-destructive: lower copies base's
// fields then overwrites/adds the listed ones (the base is read, never
// mutated). One spread per literal — the canonical form leads with it.
fn parse_record_update(ref tokens, pos, start_span) = {
  let after_dots = skip_ws(tokens, pos + 3)
  match parse_expr(tokens, after_dots) {
    (base, p_base) => {
      let p_after = skip_ws(tokens, p_base)
      // Override fields follow a comma; a bare `{...base}` is a pure copy
      // (no overrides) closing at `}`.
      if at(tokens, p_after, TComma) {
        let buf = make_list(4)
        match parse_record_fields(tokens, skip_ws(tokens, p_after + 1), buf, 0) {
          (final_buf, final_count, p) => {
            let sorted = sort_record_fields(slice(final_buf, 0, final_count))
            (nexpr(RecordUpdateExpr(base, sorted), start_span), p)
          },
        }
      } else {
        (nexpr(RecordUpdateExpr(base, []), start_span), expect(tokens, p_after, TRBrace))
      }
    },
  }
}

// Record literal: `{name: expr, age: expr, ...}` or with field
// puning `{name, age}` ≡ `{name: name, age: age}`. Fields sort by
// name at parse time so downstream sees one canonical layout.
fn parse_record_literal(ref tokens, pos, start_span) = {
  let buf = make_list(4)
  match parse_record_fields(tokens, pos, buf, 0) {
    (final_buf, final_count, p) => {
      let sorted = sort_record_fields(slice(final_buf, 0, final_count))
      (nexpr(MakeRecordExpr(sorted), start_span), p)
    },
  }
}

fn parse_record_fields(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) {
    (buf, count, p + 1)
  } else {
    // Contextual-keyword field names (handle/own/ref) resolve to their
    // spelling — SYNTAX.md §572; canonical ident_or_kw_at projection.
    let name = ident_or_kw_at(tokens, p)
    let name_span = span_at(tokens, p)
    let p1 = p + 1
    let p2 = skip_ws(tokens, p1)
    match if at(tokens, p2, TColon) {
      parse_expr(tokens, skip_ws(tokens, p2 + 1))
    } else {
      // Field puning: {name} desugars to {name: name}.
      (nexpr(VarRef(name), name_span), p1)
    } {
      (value, p3) => match push_node(buf, count, (name, value)) {
        (b1, c1) => {
          let p4 = skip_ws(tokens, p3)
          if at(tokens, p4, TComma) {
            parse_record_fields(tokens, skip_ws(tokens, p4 + 1), b1, c1)
          } else {
            (b1, c1, expect(tokens, p4, TRBrace))
          }
        },
      },
    }
  }
}

// Insertion sort by field name. N≤~16 in practice; insertion is the
// natural shape and keeps the parser dependency-free.
fn sort_record_fields(fields) = sort_record_fields_loop(fields, 0, len(fields), [])

fn sort_record_fields_loop(fields, i, n, own acc) = if i >= n {
  acc
} else {
  sort_record_fields_loop(fields, i + 1, n, record_field_insert(acc, list_index(fields, i)))
}

fn record_field_insert(sorted, entry) = match entry {
  (name, _) => {
    let n = len(sorted)
    let pos = record_field_find_pos(sorted, name, 0, n)
    if pos < n {
      let buf = make_list(n + 1)
      let prefix = list_copy_into(sorted, buf, 0, pos)
      let with_ins = list_set(prefix, pos, entry)
      record_field_copy_suffix(sorted, with_ins, pos, pos, n)
    } else {
      let buf = make_list(n + 1)
      let copied = list_copy_into(sorted, buf, 0, n)
      list_set(copied, n, entry)
    }
  },
}

fn record_field_find_pos(sorted, name, i, n) = if i >= n {
  n
} else {
  match list_index(sorted, i) {
    (existing, _) => if str_lt(existing, name) { record_field_find_pos(sorted, name, i + 1, n) } else { i },
  }
}

fn record_field_copy_suffix(src, dst, src_idx, dst_idx, n) = if src_idx >= n {
  dst
} else {
  record_field_copy_suffix(
    src,
    list_set(dst, dst_idx + 1, list_index(src, src_idx)),
    src_idx + 1,
    dst_idx + 1,
    n
  )
}

// A block's span is its whole extent, `{` through `}` — the lambda's law
// (SYNTAX §Comments: an anonymous node is a home like any other, found by
// its span). Minted at the `{` alone, every arm body read as one character:
// `provider mint` answered `infer:218:19-218:20` for a three-line arm
// (measured 2026-09-23).
fn parse_block_expr(ref tokens, pos, start_span) = {
  let buf = make_list(8)
  match parse_block_body(tokens, pos, buf, 0) {
    (final_buf, final_count, final_e, p) => (desugar_block(
      slice(final_buf, 0, final_count),
      final_e,
      span_join(start_span, span_at(tokens, p - 1))
    ), p),
  }
}

// The position past any separator/comment mix — a plain-Int lookahead for
// the block's is-this-the-final-expr test (the collect happens only in the
// terminal leg, where the prose provably attaches to the final expr).
fn peek_past_comments(ref tokens, pos) = {
  let p = skip_seps_only(tokens, pos)
  match kind_at(tokens, p) {
    TComment(first) => match collect_comment(tokens, p + 1, first) {
      (_text, p2) => peek_past_comments(tokens, p2),
    },
    _ => p,
  }
}

fn parse_block_body(ref tokens, pos, own buf, count) = {
  // An interior comment is graph content exactly as a top-level one is
  // (SYNTAX Comments — "never dropped"): the run before an item attaches to
  // the finest FOLLOWING node — the next statement, the final expr, or the
  // block's own unit node when nothing follows — and a trailing same-line
  // comment attaches BACKWARD to the item it shares a line with. Attaching
  // by HANDLE is what makes the comment-before-final-expr case safe: the
  // final expr's node gains the edge without ever being wrapped as an
  // ExprStmt. The lookahead is a plain position (peek_past_comments); the
  // prose collects inside attach_leading_prose at each leg.
  let p = peek_past_comments(tokens, pos)
  if at(tokens, p, TRBrace) {
    let start = span_at(tokens, p)
    let fin = nexpr(LitUnit, start)
    (buf, count, fin, p + 1)
  } else if at(tokens, p, TEof) {
    // Unclosed block at EOF — emit ONE diagnostic + halt with
    // synthetic LitUnit final-expr at EOF span. Mirrors
    // parse_match_arms's TEof arm per Hβ.parser.unclosed-construct-
    // eof-recovery. Without this branch the loop would re-enter
    // parse_expr at EOF, get an NError at the same position, and
    // recurse forever (each iteration emitting one P_ExpectedToken
    // diagnostic, exhausting heap).
    let start = span_at(tokens, p)
    report(PUnclosedConstruct("unexpected end of input inside block; expected `\}` to close", start))
    (buf, count, nexpr(LitUnit, start), p)
  } else {
    let is_decl = match kind_at(tokens, p) {
      TLet => true,
      TFn => true,
      _ => false,
    }
    if is_decl {
      match parse_stmt(tokens, p) {
        (stmt, p2) => match push_node(buf, count, stmt) {
          (b1, c1) => parse_block_body(tokens, p2, b1, c1),
        },
      }
    } else {
      match parse_expr(tokens, p) {
        (expr, p2) => {
          let p3 = peek_past_comments(tokens, p2)
          if at(tokens, p3, TRBrace) {
            (buf, count, expr, p3 + 1)
          } else {
            let start = span_at(tokens, p)
            match push_node(buf, count, nstmt(ExprStmt(expr), start)) {
              (b1, c1) => parse_block_body(tokens, p2, b1, c1),
            }
          }
        },
      }
    }
  }
}

// `let pat = v; rest` IS `match v { pat => rest }`. A destructuring let in a
// block is the match projection wearing let's syntax — split the block at the
// first one, wrapping the remainder (and final) as its single match arm, so the
// node is born a `match` and INFERENCE types it (lowering merely projects it).
// PVar/PWild/PLit lets stay direct, so `LetStmt` carries only PVar by
// construction. The audit: a let-destructure RE-DERIVES match; unify it INTO
// match at the node's birth, never re-derive it downstream.
// (protocol_one_graph_two_operations.)
// desugar_block returns the minted NODE (not a bare body): the
// head-destructure match mints AT THE LET'S SPAN, so the weave pass's
// span-tie rule (latest mint wins) resolves a body-head comment to the
// LIVE match instead of the dissolved let — the last silent prose-drop
// class the conservation gate named.
//
// The value the pattern refuses is the let's second arm, `_ => abort()` — an
// ordinary arm (SYNTAX §«Refutable let»). Coverage decides everything else:
// when the pattern takes every value the arm can never run, so it charges
// nothing, and when it cannot, `Abort` is in the row and a caller answers it
// (`~> otherwise(default)`). Both nodes are born at the let's span BEFORE the
// match, so the match stays the latest mint there and keeps the let's prose.
fn desugar_block(stmts, final_e, span: ValidSpan) = match find_destructure_let(stmts, 0) {
  None => nexpr(BlockExpr(stmts, final_e), span),
  Some((i, pat, v, lsp)) => {
    let rest_stmts = slice(stmts, i + 1, len(stmts))
    // The arm body is exactly what follows the destructure — a bare final when
    // nothing intervenes, else the desugared remainder. No redundant block.
    let arm_body = if len(rest_stmts) == 0 { final_e } else { desugar_block(rest_stmts, final_e, lsp) }
    let refused = (npat(PWild, lsp), nexpr(CallExpr(nexpr(VarRef("abort"), lsp), []), lsp))
    let m = MatchExpr(v, [(pat, arm_body), refused])
    // A destructure at the head IS the match (no empty-prefix block); otherwise
    // the prefix stmts carry the match as their final.
    if i == 0 { nexpr(m, lsp) } else { nexpr(BlockExpr(slice(stmts, 0, i), nexpr(m, lsp)), span) }
  },
}

// The first destructuring let, with the pieces the desugar needs — so the
// desugar never has to re-match a statement this walk already read.
fn find_destructure_let(stmts, i) = if i >= len(stmts) {
  None
} else {
  match list_index(stmts, i) {
    N{body: NStmt(LetStmt{pat, value: v}), span: lsp} => if is_destructure_pat(pat) { Some((i, pat, v, lsp)) } else { find_destructure_let(stmts, i + 1) },
    _ => find_destructure_let(stmts, i + 1),
  }
}

fn is_destructure_pat(pat) = match pat_of(pat) {
  PVar(_) => false,
  PWild => false,
  PLit(_) => false,
  PTuple(_) => true,
  PCon(_, _) => true,
  PConFields(_, _) => true,
  PList(_, _) => true,
  PRecord(_, _) => true,
  PAs(_, inner) => is_destructure_pat(inner),
  PAlt(branches) => // An alternation can refuse a value whenever any branch can.
  any(is_destructure_pat, branches),
}

fn parse_if(ref tokens, pos, span: ValidSpan) = match parse_header_expr(tokens, pos) {
  (cond, p) => {
    let p2 = skip_ws(tokens, p)
    match if at(tokens, p2, TLBrace) {
      parse_block_expr(tokens, p2 + 1, span_at(tokens, p2))
    } else {
      parse_expr(tokens, p2)
    } {
      (then_e, p3) => {
        let p4 = skip_ws(tokens, p3)
        if at(tokens, p4, TElse) {
          let p5 = skip_ws(tokens, p4 + 1)
          match if at(tokens, p5, TIf) {
            parse_if(tokens, p5 + 1, span_at(tokens, p5))
          } else if at(tokens, p5, TLBrace) {
            parse_block_expr(tokens, p5 + 1, span_at(tokens, p5))
          } else {
            parse_expr(tokens, p5)
          } {
            (else_e, p6) => (nexpr(IfExpr(cond, then_e, else_e), span), p6),
          }
        } else {
          // No else: resume at any following comment run, not past it.
          (nexpr(IfExpr(cond, then_e, nexpr(LitUnit, span)), span), skip_seps_only(tokens, p3))
        }
      },
    }
  },
}

fn parse_match(ref tokens, pos, span: ValidSpan) = match parse_header_expr(tokens, pos) {
  (scrutinee, p) => {
    let p2 = expect(tokens, skip_ws(tokens, p), TLBrace)
    let buf = make_list(4)
    match parse_match_arms(tokens, skip_ws(tokens, p2), buf, 0) {
      (final_buf, final_count, p3) => (nexpr(MatchExpr(scrutinee, slice(final_buf, 0, final_count)), span), p3),
    }
  },
}

fn parse_match_arms(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  match kind_at(tokens, p) {
    TRBrace => (buf, count, p + 1),
    TEof => unclosed_eof(tokens, p, "match arms", buf, count),
    _ => match parse_pat_alt(tokens, p) {
      (pat, p2) => {
        let p3 = expect(tokens, skip_ws(tokens, p2), TFatArrow)
        match parse_expr(tokens, skip_ws(tokens, p3)) {
          (body, p4) => {
            let p5 = skip_ws(tokens, p4)
            let p6 = if at(tokens, p5, TComma) { p5 + 1 } else { p5 }
            match push_node(buf, count, (pat, body)) {
              (b1, c1) => parse_match_arms(tokens, skip_ws(tokens, p6), b1, c1),
            }
          },
        }
      },
    },
  }
}

// Pattern alternation at the match-arm grammar (SYNTAX.md §1605:
// `|` is TPipe — variant separator in `type` body + pattern
// alternation in match arm body). One pat, then a TPipe loop;
// single-branch stays the bare pat (no degenerate PAlt — walkthrough
// §7 "Single-branch alternation").
fn parse_pat_alt(ref tokens, pos) = match parse_pat(tokens, pos) {
  (first, p) => if at(tokens, skip_ws(tokens, p), TPipe) {
    match parse_pat_alt_branches(tokens, p, [first], 1) {
      (branches, p2) => (npat(PAlt(branches), span_join(span_of_node(first), span_of_node(last(branches)))), p2),
    }
  } else {
    (first, p)
  },
}

fn parse_pat_alt_branches(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TPipe) {
    match parse_pat(tokens, skip_ws(tokens, p + 1)) {
      (next, p2) => match push_node(buf, count, next) {
        (b1, c1) => parse_pat_alt_branches(tokens, p2, b1, c1),
      },
    }
  } else {
    (slice(buf, 0, count), p)
  }
}

// Substrate-honest EOF terminator for nested parser loops. Emits
// ONE diagnostic (not the infinite per-iteration emit-and-retry
// drift pattern), returns the accumulated buf+count at the EOF
// position so the caller's chain unwinds cleanly. Every nested
// loop (parse_call_args, parse_match_arms, parse_record_fields,
// parse_variants, etc.) uses this at its TEof arm. Top-level
// parse_stmt_list's TEof is NOT routed here — top-level EOF is
// the natural terminator, not an unclosed construct.
//
// Per CLAUDE.md Anchor 2: the diagnostic IS the
// substrate-honest projection of "unexpected EOF inside <construct>",
// with span at EOF and applicability MaybeIncorrect (the developer's
// intent is unrecoverable without more input).
fn unclosed_eof(ref tokens, p, construct: String, own buf, count) = {
  report(PUnclosedConstruct(
    "unexpected end of input inside {construct}; the construct was never closed",
    span_at(tokens, p)
  ))
  (buf, count, p)
}

fn parse_resume(ref tokens, pos, span: ValidSpan) = {
  let p = expect(tokens, skip_ws(tokens, pos), TLParen)
  // SYNTAX.md:766-777 — for ops returning `()`, `resume()` is the
  // canonical form (No-Redundant-Form + Parameters-ARE-Tuples). When
  // `(` is immediately followed by `)`, the resumed value is unit.
  // Synthetic LitUnit at the resume span mirrors the implicit-else
  // LitUnit synthesis (parser.mn IfExpr arm). Two-arm structural
  // disambiguation (TRParen-immediate vs expr) — not multi-arm
  // form-classification, so not parser-eager-form drift.
  let p_arg = skip_ws(tokens, p)
  match if at(tokens, p_arg, TRParen) { (nexpr(LitUnit, span), p_arg) } else { parse_expr(tokens, p_arg) } {
    (val, p2) => {
      let p3 = expect(tokens, skip_ws(tokens, p2), TRParen)
      // Hβ.first-light.resume-with-state-mutation: `resume(val) with field =
      // expr [, field = expr]*` captures state_updates as list of
      // {name, init} records — same shape as handler state-fields. Lower's
      // ResumeExpr arm threads these as state-record store-backs preceding
      // the LReturn, so handler state actually mutates across resume calls.
      let p_with = skip_ws(tokens, p3)
      match if at(tokens, p_with, TWith) {
        parse_resume_state_updates(tokens, skip_ws(tokens, p_with + 1))
      } else {
        ([], p3)
      } {
        (state_updates, p4) => (nexpr(ResumeExpr(val, state_updates), span), p4),
      }
    },
  }
}

// A lambda's span is its WHOLE extent — head through body. It used to be
// the head alone (`(x`), so the line address's widest-node rule reached a
// body sub-node instead and the prose the weave had attached to the lambda
// never spoke at its own line (measured 2026-09-17: `Lede:` at `:4:5`,
// none at `:4`). The node's span is the node's extent; a head-only span is
// a copy of the wrong fact.
fn lambda_span(head, body) with Memory + Alloc = match body {
  N{span: bsp} => span_join(head, bsp),
}

fn parse_lambda(ref tokens, pos, span: ValidSpan) = {
  let buf = make_list(4)
  match parse_lambda_params(tokens, pos, buf, 0) {
    (final_buf, final_count, p) => match parse_expr(tokens, skip_ws(tokens, p)) {
      (body, p2) => (nexpr(LambdaExpr(slice(final_buf, 0, final_count), body), lambda_span(span, body)), p2),
    },
  }
}

fn parse_lambda_params(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TPipe) {
    (buf, count, p + 1)
  } else {
    let name = ident_at(tokens, p)
    let h = fresh_handle(span_at(tokens, p))
    let param = TParam(name, TVar(h), Unmarked, Unmarked, None)
    match push_node(buf, count, param) {
      (b1, c1) => {
        let p2 = skip_ws(tokens, p + 1)
        if at(tokens, p2, TComma) {
          parse_lambda_params(tokens, skip_ws(tokens, p2 + 1), b1, c1)
        } else {
          (b1, c1, expect(tokens, p2, TPipe))
        }
      },
    }
  }
}

fn parse_body(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TLBrace) {
    // Per Hβ.parser.fn-body-pipe-continuation (#125; seed
    // parser_fn.wat:319-341 canonical): a brace body is the LEFT
    // operand of any trailing pipe chain — `{ ... } ~> h1 ~> h2` is
    // ONE PipeExpr, not a block with a dangling `~>`.
    // parse_block_expr_checked alone returns the BlockExpr and loses
    // every trailing `~>` (perform sites then fall to LConst(0); the
    // orphaned `~>` surfaces as E_OrphanHandlerAttach). Feed the block
    // into binop_loop to absorb the chain while keeping the brace-
    // context diagnostics parse_block_expr_checked emits. Converges
    // the brace path to the seed's "route through parse_expr ALWAYS".
    //
    // The brace goes through `parse_brace_expr`, the ONE discrimination of
    // what a `{` opens — arm list, record literal, record update, block. The
    // body slot carried a second copy that knew only arm lists and blocks,
    // so `fn bump(c) = {...c, n: 1}` parsed its spread as a block's
    // statements and refused a form SYNTAX declares (§«Record update»).
    // The result still feeds binop_loop, so `{ arms } ~> h` absorbs its
    // chain exactly as a block body does.
    //
    // And the result goes through `postfix_loop` before `binop_loop`,
    // which closes a SILENT WRONG this arc's probe found rather than
    // introduced: `fn main() = { let g = inc; g }(1)` ran to exit 0 with
    // zero diagnostics, because the brace path reached only the BINARY
    // loop and a call suffix is postfix — so the application was parsed
    // and discarded. Measured on a block body, which is how far it
    // predates the literal; the literal is what made anyone look.
    match parse_brace_expr(tokens, p + 1, span_at(tokens, p)) {
      (braced, p_braced) => {
        // Braces around a body with no statements are the redundant form
        // (SYNTAX §«Redundant braces») — keyed on the block's shape, never
        // on its line count.
        if is_empty_block(braced) { report(ERedundantBraces(span_of_node(braced))) } else { () }
        match postfix_loop(tokens, braced, p_braced, FreeExpr) {
          (applied, p_applied) => binop_loop(tokens, applied, p_applied, 1, FreeExpr),
        }
      },
    }
  } else {
    // SYNTAX.md «Function declarations»: braces are required EXACTLY when the
    // body is a BlockExpr (it introduces let-bindings/statements) — NEVER keyed
    // on line count. A single expression, even a multi-line if/match/pipe chain,
    // needs no braces. So a braceless body IS one expression: parse_expr is the
    // whole story, nothing is emitted. (A braceless body that introduces
    // statements is a parse error at the statement keyword; E_BlockNeedsBraces
    // is the recovery diagnostic there — peer Hβ.parser.block-needs-braces.)
    parse_expr(tokens, p)
  }
}

// "Is this Node an empty BlockExpr (a `{ final_expr }` with no statements)?"
// Returns Bool — false is the identity-preserve value for non-BlockExpr
// shapes (a non-block is correctly "not an empty block"). Avoids the
// drift class of `_ => <fabricated int sentinel>` per CLAUDE.md red-flag
// "no `_ => <fabricated value>` over a load-bearing ADT".
fn is_empty_block(node) = match node {
  N{body} => match body {
    NExpr(e) => is_empty_block_expr(e),
    _ => false,
  },
}

// SYNTAX.md:1599 — names that look like keywords from other languages
// (Python / JS / C / Rust) but aren't Mentl keywords. Mentl's
// substrate uses verbs (iterate / perform / resume / pipe operators),
// not statement keywords. Emit E_NotAKeyword on these as a teaching
// surface toward Mentl idiom. The string literals below ARE the
// detection target — drift-audit suppress is the residue form.
//
// drift-audit: ignore
fn is_foreign_keyword(name) = name == "for" ||
// drift-audit: ignore
name == "while" ||
// drift-audit: ignore
name == "loop" ||
// drift-audit: ignore
name == "break" ||
// drift-audit: ignore
name == "continue" ||
// drift-audit: ignore
name == "return"

fn is_empty_block_expr(e) = match e {
  BlockExpr(stmts, _) => len(stmts) == 0,
  _ => false,
}

// A pattern is born a node spanning its own tokens, and so is every pattern
// inside it (see `Pat`).
fn parse_pat(ref tokens, pos) = match parse_pat_body(tokens, pos) {
  (p, end) => (npat(p, span_join(span_at(tokens, pos), span_at(tokens, end - 1))), end),
}

fn parse_pat_body(ref tokens, pos) = match kind_at(tokens, pos) {
  TIdent(v) => if v == "_" {
    (PWild, pos + 1)
  } else {
    let first_code = first_char_code(v)
    if first_code >= 65 && first_code <= 90 {
      // Capitalized identifier — constructor pattern
      let p2 = pos + 1
      if at(tokens, p2, TLParen) {
        match parse_pat_args(tokens, skip_ws(tokens, p2 + 1)) {
          (sub, p3) => (PCon(v, sub), p3),
        }
      } else if at(tokens, p2, TLBrace) {
        // The fields read by name (SYNTAX §«Named fields») — the record
        // pattern's own grammar, since a named product IS what it reads.
        match parse_pat_record_fields(tokens, skip_ws(tokens, p2 + 1)) {
          (flds, rest, p3) => {
            con_fields_rest(rest, span_at(tokens, p2))
            (PConFields(v, flds), p3)
          },
        }
      } else {
        (PCon(v, []), p2)
      }
    } else {
      // The as-pattern (SYNTAX §"As-patterns — rule"): `name @ pat`
      // binds the whole value AND destructures it. The `@` peek is
      // whitespace-tolerant on both sides.
      let pa = skip_ws(tokens, pos + 1)
      if at(tokens, pa, TAt) {
        match parse_pat(tokens, skip_ws(tokens, pa + 1)) {
          (inner, p3) => (PAs(v, inner), p3),
        }
      } else {
        (PVar(v), pos + 1)
      }
    }
  },
  TIntLit(n) => (PLit(LVInt(n)), pos + 1),
  TFloatLit(f) => (PLit(LVFloat(f)), pos + 1),
  TStringPart(s) => (PLit(LVString(s)), pos + 1),
  TTrue => (PLit(LVBool(true)), pos + 1),
  TFalse => (PLit(LVBool(false)), pos + 1),
  TLParen => match parse_pat_args(tokens, skip_ws(tokens, pos + 1)) {
    (sub, p) => (PTuple(sub), p),
  },
  TLBracket => match parse_pat_list_args(tokens, skip_ws(tokens, pos + 1)) {
    (sub, rest, p) => (PList(sub, rest), p),
  },
  TLBrace => match parse_pat_record_fields(tokens, skip_ws(tokens, pos + 1)) {
    (flds, rest, p) => (PRecord(sort_pat_fields(flds), rest), p),
  },
  _ => {
    report(PUnexpectedToken("unexpected token in pattern position", span_at(tokens, pos)))
    (PWild, pos + 1)
  },
}

// Parse `{name, age}`, `{name: sub_pat}`, or the rest form
// `{name, ...rest}` (SYNTAX §"Pattern syntax for records" — the
// list-pattern rest's exact shape: `..._` keeps PRESENCE without a
// bind, per at_ellipsis' sibling at parse_pat_list_args). Field
// puning is the default — `{name}` ≡ `{name: PVar("name")}`.
fn parse_pat_record_fields(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) {
    ([], None, p + 1)
  } else if at_ellipsis(tokens, p) {
    let name_pos = skip_ws(tokens, p + 3)
    // The ANONYMOUS rest — `{name, ...}` — is SYNTAX's own match example
    // (`{name: "Morgan", ...} => …`) and the pun a reader writes when it
    // wants a field and nothing else. It is `..._` with the `_` unwritten:
    // presence without a bind. This arm read a NAME unconditionally, took
    // the `}` as it, and then could not find the `}` — every `{path, ...}`
    // in the wheel narrated `P_ExpectedToken` and parsed by recovery
    // (measured 2026-09-21, thirteen sites, all typed correctly by the
    // recovery, none clean).
    if at(tokens, name_pos, TRBrace) {
      ([], Some("_"), name_pos + 1)
    } else {
      let rest_name = ident_at(tokens, name_pos)
      let p_after_name = skip_ws(tokens, name_pos + 1)
      ([], Some(rest_name), expect(tokens, p_after_name, TRBrace))
    }
  } else {
    let name = ident_at(tokens, p)
    let p1 = p + 1
    let p2 = skip_ws(tokens, p1)
    match if at(tokens, p2, TColon) {
      parse_pat(tokens, skip_ws(tokens, p2 + 1))
    } else {
      (npat(PVar(name), span_at(tokens, p)), p1)
    } {
      (sub_pat, p3) => {
        let p4 = skip_ws(tokens, p3)
        if at(tokens, p4, TComma) {
          match parse_pat_record_fields(tokens, skip_ws(tokens, p4 + 1)) {
            (rest, rest_name, p5) => ([(name, sub_pat)] ++ rest, rest_name, p5),
          }
        } else {
          ([(name, sub_pat)], None, expect(tokens, p4, TRBrace))
        }
      },
    }
  }
}

fn sort_pat_fields(fields) = sort_record_fields_loop(fields, 0, len(fields), [])

fn parse_pat_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    ([], p + 1)
  } else {
    match parse_pat(tokens, p) {
      (pat, p2) => {
        let p3 = skip_ws(tokens, p2)
        if at(tokens, p3, TComma) {
          match parse_pat_args(tokens, skip_ws(tokens, p3 + 1)) {
            (rest, p4) => ([pat] ++ rest, p4),
          }
        } else {
          ([pat], expect(tokens, p3, TRParen))
        }
      },
    }
  }
}

fn parse_pat_list_args(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBracket) {
    ([], None, p + 1)
  } else if at_ellipsis(tokens, p) {
    let name_pos = skip_ws(tokens, p + 3)
    // `..._` accepts any remaining tail WITHOUT binding it — but the rest
    // slot carries TWO facts: PRESENCE (the predicate: length ≥ prefix,
    // never exact) and the BIND name. Mapping "_" to None destroyed
    // presence to answer binding — the exact-length lie that floored
    // walk_locals on every multi-element list (faces 12-14; the seed had
    // the same conflation, independently rationalized). Presence always
    // survives here; the bind side skips "_" (bind_pat_rest's law).
    // The anonymous `[a, ...]` is `..._` with the `_` unwritten — the same
    // surface as the record rest (SYNTAX: "List rest uses the same `...rest`
    // surface as record rest"), read here the same way.
    if at(tokens, name_pos, TRBracket) {
      ([], Some("_"), name_pos + 1)
    } else {
      let rest_name = ident_at(tokens, name_pos)
      let p_after_name = skip_ws(tokens, name_pos + 1)
      ([], Some(rest_name), expect(tokens, p_after_name, TRBracket))
    }
  } else {
    match parse_pat(tokens, p) {
      (pat, p2) => {
        let p3 = skip_ws(tokens, p2)
        if at(tokens, p3, TComma) {
          match parse_pat_list_args(tokens, skip_ws(tokens, p3 + 1)) {
            (rest_pats, rest_name, p4) => ([pat] ++ rest_pats, rest_name, p4),
          }
        } else {
          ([pat], None, expect(tokens, p3, TRBracket))
        }
      },
    }
  }
}

fn at_ellipsis(ref tokens, pos) =
  at(tokens, pos, TDot) && at(tokens, pos + 1, TDot) && at(tokens, pos + 2, TDot)

// Per Hβ.first-light.first-char-code-via-byte-at: chars/char_code aren't
// defined in the wheel runtime; byte_at is the substrate-honest primitive.
// Strings are length-prefixed; byte_at(s, 0) reads s[0] as i32 directly.
fn first_char_code(s) = if byte_len(s) == 0 { 0 } else { byte_at(s, 0) }

// Type expressions
//
// parse_type_ty — an atomic type, then an OPTIONAL `-> ret` making it a
// function type (SYNTAX.md «The Intent Boundary», «Generic type parameters»:
// the `f: a -> b` param annotation). Right-associative: `a -> b -> c` is
// `a -> (b -> c)`. A leading parenthesized tuple is the parameter list
// (`(a, b) -> c`); `()` is the zero-arg list; any other base is one parameter.
// The function's effect row is an OPEN row var — the annotation names the
// shape, and the bound value's effects flow in by a normal-call unify (the
// mechanism that lets declared functor signatures replace infer_seq_op).
fn parse_type_ty(ref tokens, pos) = match parse_type_atom(tokens, pos) {
  (base, p) => {
    let pa = skip_ws(tokens, p)
    if at(tokens, pa, TArrow) {
      match parse_type_ty(tokens, skip_ws(tokens, pa + 1)) {
        (ret, p2) => {
          let param_tys = match base {
            TTuple(elems) => elems,
            TUnit => [],
            _ => [base],
          }
          // Optional `with <row>` — the fn TYPE's authored effect row
          // (TFun's third field, at last parseable: `() -> a with !WASI`
          // is the resume barrier's whole vocabulary — a param demanding
          // an external-free thunk by ordinary subsumption). The row
          // builds through build_declared_row, the ONE signed-clause
          // fold infer's declared rows ride. Greedy: in a return
          // position the `with` binds the INNER fn type; parenthesize
          // for the outer clause. Absent, the open var as before.
          match if at(tokens, skip_ws(tokens, p2), TWith) {
            match parse_effect_list(tokens, skip_ws(tokens, skip_ws(tokens, p2) + 1)) {
              (row_effs, p3) => (build_declared_row(row_effs), p3),
            }
          } else {
            (mk_ef_open([], fresh_handle(span_at(tokens, pos))), p2)
          } {
            (row, p_row) => (TFun(map((t) => mk_param("_", t), param_tys), ret, row), p_row),
          }
        },
      }
    } else {
      (base, p)
    }
  },
}

fn parse_type_atom(ref tokens, pos) = match kind_at(tokens, pos) {
  TIdent(v) => {
    let base_pos = pos + 1
    // Type-name recognition must be byte-structural. The m2 backend can lower
    // bare string `==` as pointer equality here, which turns `Int` into the
    // nominal TName("Int", []) and later reports equal-looking `Int vs Int`.
    let base = if str_eq(v, "Int") {
      TInt
    } else if str_eq(v, "Float") {
      TFloat
    } else if str_eq(v, "f64") {
      // The bare-width pin (SYNTAX §"The Intent Boundary Rule" pt 3):
      // `s: f32` ≡ `s: Float repr f32` — the width names are the
      // pinned spellings of their value types.
      TReprPin(RF64, TFloat)
    } else if str_eq(v, "f32") {
      TReprPin(RF32, TFloat)
    } else if str_eq(v, "i64") {
      TReprPin(RI64, TInt)
    } else if str_eq(v, "v128") {
      TReprPin(RV128, TInt)
    } else if str_eq(v, "String") {
      ty_string
    } else if str_eq(v, "Bool") {
      TName("Bool", [])
    } else if str_eq(v, "Unit") {
      TUnit
    } else {
      TName(v, [])
    }
    // Parens application — the one-application-syntax law: types
    // apply like effects apply (`Sample(44100)`) and values apply
    // (`f(x)`). `Option(Int)` rewraps a TName base with args.
    // Unambiguous: no expression context exists in type position.
    // Primitives (TInt etc.) take no args; per protocol_no_silent_
    // fallback the args are discarded but the parse advances cleanly.
    if at(tokens, base_pos, TLParen) {
      match parse_type_args(tokens, skip_ws(tokens, base_pos + 1)) {
        (args, p_after) => {
          let typed = match base {
            TName{name} => TName(name, args),
            _ => base,
          }
          (typed, p_after)
        },
      }
    } else {
      (base, base_pos)
    }
  },
  TBang => // `-> !` — the never-returns marker (SYNTAX §«Never-returning ops»). The
  // syntactic name "!" resolves at quantify_ctor_ty to a FRESH quantified var
  // per occurrence: bottom unifies with every consumer, exactly the
  // bottom-producing sibling `fail(msg) -> a` spelled as intent.
  (TName("!", []), pos + 1),
  TLParen => {
    let p = skip_ws(tokens, pos + 1)
    if at(tokens, p, TRParen) {
      (TUnit, p + 1)
    } else {
      match parse_type_ty(tokens, p) {
        (first, p2) => {
          let p3 = skip_ws(tokens, p2)
          if at(tokens, p3, TComma) {
            let buf = make_list(4)
            match push_node(buf, 0, first) {
              (b1, c1) => match parse_type_ty_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1) {
                (final_buf, final_count, p4) => (TTuple(slice(final_buf, 0, final_count)), p4),
              },
            }
          } else {
            (first, expect(tokens, p3, TRParen))
          }
        },
      }
    }
  },
  TLBrace => // Structural record type `{name: Ty, age: Ty}` (closed) or open
  // `{name: Ty, ...}` / `{name: Ty, ...R}` (accepts any record with AT
  // LEAST these fields — SYNTAX.md §«Row polymorphism»). Sorted at
  // parse; an open rest mints a fresh row var and the field set becomes
  // a TRecordOpen (mk_record_open canonicalizes the fields with the
  // row var); closed stays TRecord.
  match parse_record_type_fields(tokens, skip_ws(tokens, pos + 1)) {
    (flds, rest_var, p) => {
      let sorted = sort_record_type_fields(flds)
      let ty = match rest_var {
        Some(v) => mk_record_open(sorted, v),
        None => TRecord(sorted),
      }
      (ty, p)
    },
  },
  TLBracket => // List type `[T]` → TList(T) — the canonical list-type notation
  // (SYNTAX.md:691 `type Bytes = [Int]`). The seed parses it; this arm
  // closes the wheel-parser fidelity gap (`[String]` in main.mn's
  // Invocation ctor desynced into the silent `_ => TUnit` fallback →
  // P_UnexpectedToken at pass-2). One element type, then `]`.
  match parse_type_ty(tokens, skip_ws(tokens, pos + 1)) {
    (elem, p) => (TList(elem), expect(tokens, skip_ws(tokens, p), TRBracket)),
  },
  _ => {
    report(PUnexpectedToken("unexpected token in type position — expected a type", span_at(tokens, pos)))
    (TUnit, pos + 1)
  },
}

fn parse_type_ty_tail(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    (buf, count, p + 1)
  } else {
    match parse_type_ty(tokens, p) {
      (ty, p2) => match push_node(buf, count, ty) {
        (b1, c1) => {
          let p3 = skip_ws(tokens, p2)
          if at(tokens, p3, TComma) {
            parse_type_ty_tail(tokens, skip_ws(tokens, p3 + 1), b1, c1)
          } else {
            (b1, c1, expect(tokens, p3, TRParen))
          }
        },
      },
    }
  }
}

// Parse comma-separated type arguments terminated by TRParen. Caller
// has already consumed the opening TLParen. Returns ([Ty], pos-after).
// Used for type application `Name(T1, T2, ...)`.
fn parse_type_args(ref tokens, pos) = {
  let buf = make_list(4)
  match parse_type_args_loop(tokens, pos, buf, 0) {
    (final_buf, final_count, p) => (slice(final_buf, 0, final_count), p),
  }
}

fn parse_type_args_loop(ref tokens, pos, own buf, count) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRParen) {
    (buf, count, p + 1)
  } else {
    match parse_type_ty(tokens, p) {
      (ty, p2) => match push_node(buf, count, ty) {
        (b1, c1) => {
          let p3 = skip_ws(tokens, p2)
          if at(tokens, p3, TComma) {
            parse_type_args_loop(tokens, skip_ws(tokens, p3 + 1), b1, c1)
          } else {
            (b1, c1, expect(tokens, p3, TRParen))
          }
        },
      },
    }
  }
}

// Parse a structural record type's field list, recognizing an optional
// trailing open-row rest `...` / `...R` (SYNTAX.md §«Row polymorphism»).
// Returns (fields, rest_var, pos-after-`}`): rest_var is Some(row-handle)
// for an open record (accepts any record with AT LEAST these fields),
// None for a closed one. `...` mints a fresh anonymous row var; `...R`
// binds the row var name R (the reuse of R across sites within one
// signature is a named-row-var environment threaded through type-parse —
// the structural peer Hβ.parser.named-row-var-reuse; here both mint a
// fresh row var). The downstream substrate (TRecordOpen, unify_types'
// row-poly arms) is already built; this parse closes the surface.
fn parse_record_type_fields(ref tokens, pos) = {
  let p = skip_ws(tokens, pos)
  if at(tokens, p, TRBrace) {
    ([], None, p + 1)
  } else if at_ellipsis(tokens, p) {
    // `...` or `...R` rest — the open-row marker. A name after the three
    // dots binds the row var (R); absent = anonymous. Both mint a fresh
    // row-var handle; consume to the closing `}`.
    let after_dots = p + 3
    let named = match kind_at(tokens, after_dots) {
      TIdent(_) => true,
      _ => false,
    }
    let p_rest = if named { after_dots + 1 } else { after_dots }
    let row_var = fresh_handle(span_at(tokens, p))
    ([], Some(row_var), expect(tokens, skip_ws(tokens, p_rest), TRBrace))
  } else {
    let name = ident_at(tokens, p)
    let p1 = expect(tokens, p + 1, TColon)
    match parse_type_ty(tokens, skip_ws(tokens, p1)) {
      (ty, p2) => {
        let p3 = skip_ws(tokens, p2)
        if at(tokens, p3, TComma) {
          match parse_record_type_fields(tokens, skip_ws(tokens, p3 + 1)) {
            (rest, rest_var, p4) => ([(name, ty)] ++ rest, rest_var, p4),
          }
        } else {
          ([(name, ty)], None, expect(tokens, p3, TRBrace))
        }
      },
    }
  }
}

fn sort_record_type_fields(fields) = sort_record_type_fields_loop(fields, 0, len(fields), [])

fn sort_record_type_fields_loop(fields, i, n, own acc) = if i >= n {
  acc
} else {
  sort_record_type_fields_loop(fields, i + 1, n, record_field_insert(acc, list_index(fields, i)))
}

fn parse_type_expr(ref tokens, pos) = match parse_type_ty(tokens, pos) {
  (ty, p) => {
    let span = span_at(tokens, pos)
    // Mint a node carrying the REAL annotation Ty (NTypeAnn) — the source wrote
    // a return type, so the graph holds that type live (Carried-Truth). infer's
    // FnStmt arm reads it back and unifies the inferred body return against it
    // (present = a CONSTRAINT, E_TypeMismatch on violation; SYNTAX.md «Return
    // type omission»). Never the old dummy LitUnit that discarded the parsed Ty.
    (mint_node(NTypeAnn(ty), span), p)
  },
}

// Predicates — minimal (expressions after `where`)
//
// Per T1.3 refinement-types-with-predicate-capture: parse the
// predicate body as a generic expression via parse_expr, then
// walk the resulting AST and project to the Predicate ADT. The
// expression form admits comparisons (`<`, `<=`, `==`), logical
// composition (`&&`, `||`, `!`), and fn application
// (`even(self)`, `bytes_valid_utf8(self)`). `self` in the body
// refers to the value being refined; node_to_predicate reads each
// operand node LIVE (no PExpr copy).
//
// W_RedundantWhere narration: if the resulting Predicate is the
// literal PTrue (no constraint), emit the gradient hint per
// SYNTAX.md:1604-1611 — the where-clause adds nothing.
fn parse_predicate(ref tokens, pos) = match parse_expr(tokens, pos) {
  (expr_node, p) => match expr_node {
    N{span} => {
      let pred = node_to_predicate(expr_node, span)
      match pred {
        PTrue => report(WRedundantWhere(span)),
        _ => (),
      }
      (pred, p)
    },
  },
}

// Project a predicate-body AST node to the Predicate ADT, carrying each
// operand node's HANDLE — every node is registered in the one graph at
// construction (mint_node), so graph_node_body resolves its Expr live and
// the predicate holds the edge, not a copy. A comparison carries its two
// operand handles; `>`/`>=` normalize to `<`/`<=` with swapped operands;
// `&&`/`||`/`!` compose recursively; ANY other boolean expression (a
// refinement call, a bare bool var) IS its graph node — PBoolNode(handle),
// read live. No lossy fallback.
fn node_to_predicate(node, span: ValidSpan) = match node {
  N{body} => match body {
    NExpr(BinOpExpr{op: BEq, left: l, right: r}) => compare_pred(BEq, l, r),
    NExpr(BinOpExpr{op: BNe, left: l, right: r}) => PNot(compare_pred(BEq, l, r)),
    NExpr(BinOpExpr{op: BLt, left: l, right: r}) => compare_pred(BLt, l, r),
    NExpr(BinOpExpr{op: BLe, left: l, right: r}) => compare_pred(BLe, l, r),
    NExpr(BinOpExpr{op: BGt, left: l, right: r}) => compare_pred(BLt, r, l),
    NExpr(BinOpExpr{op: BGe, left: l, right: r}) => compare_pred(BLe, r, l),
    NExpr(BinOpExpr{op: BAnd, left: l, right: r}) => PAnd(node_to_predicate(l, span), node_to_predicate(r, span)),
    NExpr(BinOpExpr{op: BOr, left: l, right: r}) => POr(node_to_predicate(l, span), node_to_predicate(r, span)),
    NExpr(UnaryOpExpr(UNot, inner)) => PNot(node_to_predicate(inner, span)),
    NExpr(LitBool(true)) => PTrue,
    _ => PBoolNode(node_handle(node)),
  },
}

// A comparison carries its two operand handles (resolved live via graph_node_body).
fn compare_pred(op, l, r) = PCompare(op, node_handle(l), node_handle(r))

// ─── free variables — the parse tree's own reference projection ──────
//
// PARSE TRUTH, homed with the parse: a node's free names are a fact of
// the source alone — no judgment, no lowering — and BOTH downstream
// layers read it (lower's closure captures; the converged judgment's
// stmt layers and incremental cone). Walks a body collecting every
// `VarRef` whose name is not in the local scope. Nested lambdas augment
// `bound` with their own params during the walk, so references resolved
// inside the nested frame are excluded from the OUTER frame's free set.
//
// Returns `List[String]` — names only, deduplicated. At emit time,
// closure record slot N stores the value of `captures[N]` from the
// enclosing scope; the lambda body reads them as `LUpval(h, N)`.
// SAFE-FOR-SPACE is this walk's INVARIANT (Shao–Appel): a closure
// record carries exactly the FREE variables of its body — flat
// copies, never a link to the enclosing frame — so the space a
// closure retains is bounded by what its body can reference, and no
// dead environment survives through a captured frame pointer. Every
// capture channel (this walk, the seeded __k/__hrec words, the
// fanout branch thunks) preserves it; a future channel that captures
// a FRAME instead of a free set violates the invariant, not a style
// preference.
// H6: exhaustive NodeBody enumeration. Patterns and holes
// contribute no free variable references (they're terminal AST
// forms). Named explicitly so new NodeBody variants decide
// whether they can contain VarRefs.
fn collect_free_vars(node, bound) = match node {
  N{body} => match body {
    NExpr(e) => free_vars_expr(e, bound),
    NStmt(s) => free_vars_stmt(s, bound),
    NPat(_) => [],
    NHole(_) => [],
    NModule(_) => // a module entity contains no VarRef of its own
    [],
    NTypeAnn(_) => // an authored type annotation contains no VarRef
    [],
  },
}

fn free_vars_expr(e, bound) = match e {
  LitInt(_) => [],
  LitFloat(_) => [],
  LitString(_) => [],
  LitBool(_) => [],
  LitUnit => [],
  VarRef(name) => if free_vars_contains(bound, name) { [] } else { [name] },
  BinOpExpr{left: l, right: r} => free_vars_merge(collect_free_vars(l, bound), collect_free_vars(r, bound)),
  UnaryOpExpr(_, inner) => collect_free_vars(inner, bound),
  CallExpr(f, args) => free_vars_merge(collect_free_vars(f, bound), free_vars_list(args, bound)),
  IfExpr(c, t, e) => free_vars_merge(
    collect_free_vars(c, bound),
    free_vars_merge(collect_free_vars(t, bound), collect_free_vars(e, bound))
  ),
  BlockExpr(stmts, final_e) => match free_vars_stmts(stmts, bound, []) {
    (frees, bound_after) => free_vars_merge(frees, collect_free_vars(final_e, bound_after)),
  },
  MatchExpr(scrut, arms) => free_vars_merge(collect_free_vars(scrut, bound), free_vars_match_arms(arms, bound)),
  MakeListExpr(elems) => free_vars_list(elems, bound),
  MakeTupleExpr(elems) => free_vars_list(elems, bound),
  MakeStringExpr(fragments) => free_vars_list(fragments, bound),
  ShowExpr(inner) => collect_free_vars(inner, bound),
  IndexExpr(receiver, index) => free_vars_merge(collect_free_vars(receiver, bound), collect_free_vars(index, bound)),
  MakeRecordExpr(flds) => free_vars_record_fields(flds, bound),
  RecordUpdateExpr(base, flds) => free_vars_merge(collect_free_vars(base, bound), free_vars_record_fields(flds, bound)),
  NamedRecordExpr(_, flds) => free_vars_record_fields(flds, bound),
  LambdaExpr(params, body) => {
    let inner_bound = free_vars_merge(bound, free_vars_param_names(params))
    collect_free_vars(body, inner_bound)
  },
  ResumeExpr(val, state_updates) => // band B M1.6 (bank Ruling 2/A3): a resume USES the enclosing arm's k,
  // so "__k" is one of its free names. A lambda inside a MultiShot arm
  // thereby CAPTURES the k record like any local — the capture tier of
  // the resume-resolution ladder (lower_resume_callk walks it). Anywhere
  // __k is NOT an arm-frame local — a OneShot arm's lambda, a k-fn build,
  // an ordinary fn — "__k" resolves RGlobal and the phantom-capture fence
  // DROPS it: zero captures added, bytes identical (Law 7 holds on the
  // wheel's own backtrack, whose resume-in-lambda sits under the
  // OneShot-misclassified choose until the cut).
  free_vars_merge(
    ["__k"],
    free_vars_merge(collect_free_vars(val, bound), free_vars_state_updates(state_updates, bound))
  ),
  FieldExpr(rec, _) => collect_free_vars(rec, bound),
  PipeExpr{left: l, right: r} => free_vars_merge(collect_free_vars(l, bound), collect_free_vars(r, bound)),
  FanoutExpr(branches) => collect_free_vars_branches(branches, bound),
  RestExpr(_) => // the rest NAME binds in the lambda path; it is never a free ref
  [],
  ExprPlaceholder => [],
  LabeledArg{value: v} => // A labeled arg's value can reference free vars (closure capture must see
  // them); the label is a param name, not a value-position var.
  collect_free_vars(v, bound),
  LitInt(_) => // H6: exhaustive Expr enumeration. Literals contribute no
  // free vars. Named explicitly so new Expr variants must decide
  // their free-var contribution (critical for closure capture).
  [],
  LitFloat(_) => [],
  LitString(_) => [],
  LitBool(_) => [],
  LitUnit => [],
}

fn collect_free_vars_branches(branches, bound) = match branches {
  [] => [],
  [h, ...t] => free_vars_merge(collect_free_vars(h, bound), collect_free_vars_branches(t, bound)),
}

// Walk free vars through a `resume() with` updates list. Each update's
// init expression may reference outer-scope names (e.g., a freshly-built
// [frame] ++ frames where frame is a let-bound local in the arm
// body). cfv reports those that aren't in `bound`.
fn free_vars_state_updates(updates, bound) = fold(
  [],
  (acc, upd) => free_vars_merge(acc, collect_free_vars(state_field_init(upd), bound)),
  updates
)

// H6: exhaustive Stmt enumeration. Type/effect declarations and imports
// contribute no value-level free vars. Named explicitly so new Stmt
// variants decide their cfv behavior.
//
// THIS WALK IS THE JUDGMENT'S DAG, not only closure capture. stmt_frees →
// scc_groups orders every decl callee-first from what this returns, so a
// statement kind that answers [] here is a decl with no recorded callees,
// free to judge before the things it calls. The handler arm answered []
// under a comment that was true for capture (a handler decl never sits
// inside a lambda) and false for the DAG — measured 2026-09-17 as the
// single-pass cut's m4 trap: graph_handler judged before
// emitfns_index_build, its arm's reference resolved against the placeholder
// skeleton, the call site's type never mirrored the callee's open-record
// scheme, no twin was minted, and the table dispatched the base body's
// floor. The two-pass final was blind to it because the trial had published
// every scheme first (PLAN §11's "forward-reference table carried by
// shadow" — this is the carrier). The graph's own reverse edge knew the
// reference the whole time; two homes for one fact, disagreeing.
// RefineStmt keeps [] for a different reason: its predicate is not yet an
// expression this walk can descend (Hβ.types.predicate-is-expr).
fn free_vars_stmt(s, bound) = match s {
  LetStmt{value: expr} => collect_free_vars(expr, bound),
  FnStmt{body: body_node} => collect_free_vars(body_node, bound),
  ExprStmt(expr) => collect_free_vars(expr, bound),
  TypeDefStmt{} => [],
  EffectDeclStmt{} => [],
  HandlerDeclStmt{config, state, arms} => {
    // Inits evaluate in the installer's scope with the config in hand; an
    // arm additionally binds the state names and its own args. `resume` is
    // a keyword and never a reference.
    let init_bound = free_vars_merge(bound, free_vars_param_names(config))
    let arm_bound = free_vars_merge(init_bound, map((st) => st.name, state))
    free_vars_merge(
      free_vars_list(map((st) => st.init, state), init_bound),
      free_vars_handler_arms(arms, arm_bound)
    )
  },
  ImportStmt(_) => [],
  RefineStmt{} => [],
  AliasStmt{} => [],
  RowAliasStmt{} => [],
}

fn free_vars_handler_arms(arms, bound) = fold(
  [],
  (acc, arm) => free_vars_merge(acc, collect_free_vars(arm.body, free_vars_merge(bound, arm.args))),
  arms
)

fn free_vars_list(nodes, bound) =
  fold([], (acc, node) => free_vars_merge(acc, collect_free_vars(node, bound)), nodes)

// Free variables in a record-literal expression: union of frees in
// each field's value. Field names are not value-position references
// (the parser already desugared pun-syntax to `VarRef` nodes).
fn free_vars_record_fields(flds, bound) = fold(
  [],
  (acc, fld) => match fld {
    (_, value) => free_vars_merge(acc, collect_free_vars(value, bound)),
  },
  flds
)

// Walk a statement list, threading `bound` through `LetStmt`s so
// subsequent statements see the new bindings. Returns
// `(accumulated_frees, final_bound)`.
fn free_vars_stmts(stmts, bound, acc_frees) = if len(stmts) == 0 {
  (acc_frees, bound)
} else {
  let stmt = last(stmts)
  match stmt {
    N{body: stmt_body} => match stmt_body {
      NStmt(LetStmt{pat, value: expr}) => {
        let frees = collect_free_vars(expr, bound)
        let new_bound = free_vars_merge(bound, pat_binders(pat))
        free_vars_stmts(drop_last(stmts), new_bound, free_vars_merge(acc_frees, frees))
      },
      NStmt(FnStmt{name, body: body_node}) => {
        // Nested named fn — its name is in scope for siblings and the
        // final expression (recursive / mutual references resolve via env).
        let frees = collect_free_vars(body_node, bound)
        let new_bound = free_vars_merge(bound, [name])
        free_vars_stmts(drop_last(stmts), new_bound, free_vars_merge(acc_frees, frees))
      },
      _ => {
        let frees = collect_free_vars(stmt, bound)
        free_vars_stmts(drop_last(stmts), bound, free_vars_merge(acc_frees, frees))
      },
    },
  }
}

fn free_vars_match_arms(arms, bound) =
  arms |> map({ (pat, body) => collect_free_vars(body, free_vars_merge(bound, pat_binders(pat))) }) |> fold([], free_vars_merge)

fn free_vars_param_names(params) = map(param_name, params)

fn free_vars_merge(a, b) = if len(b) == 0 {
  a
} else {
  let x = last(b)
  let rest = drop_last(b)
  if free_vars_contains(a, x) {
    free_vars_merge(a, rest)
  } else // drift-audit: ignore — real drift 11 in free_vars_* set-union family; buffer-counter rewrite adds Memory+Alloc to row rippling through callers; tracked by Hβ.perf.name-is-handle; buffer-counter sweep. Explicit list_concat (was `a ++ [x]`) — BConcat's emit dispatches via lookup_ty which returned NFree at infer-time, falling to str_concat and trapping in mentl2's runtime when list arms walked the bytes as elements. Direct call avoids the dispatch.
  {
    free_vars_merge(list_concat(a, [x]), rest)
  }
}

fn free_vars_contains(lst, s) = any((x) => x == s, lst)
