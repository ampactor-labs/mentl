// backends/wasm.mn — WASM target handler (one peer among native, test, browser)
//
// This is not "the emitter." It is one handler on `WasmOut` reading
// types live from `LookupTy`. A native backend is a different handler
// for the SAME effect — swap, not rewrite. The compiler has no backend;
// it has handlers.
//
// Declares: with GraphRead + LookupTy + WasmOut + Diagnostic.
// No GraphWrite. No cached types in LowExpr — every type read
// routes through perform lookup_ty(h) which chases the graph.
//
// Handler elimination lowers 85% of handlers (TailResumptive) to
// direct `call` instructions at this level; the other 15% (Linear
// and MultiShot) have already been rewritten into state machines
// or heap continuation structs by lower.mn.
import types

import graph

import effects

import lower

import derive

import strings

// WasmOut effect — the output sink. Every character of emitted WAT goes
// through perform wat_emit(s). Default handler writes to stdout; test
// handler collects into a buffer; format handler pretty-prints.
effect WasmOut {
  wat_emit(String)
}

// WatBuffer effect — wat_collect returns the accumulated buffer of a
// scoped emit. Used by row-aware-parallel-emit (per Hβ.emit.row-aware-
// parallel-emit): each fn body emits to a fresh wat_to_string handler,
// then the collected strings get sequential output preserving source
// order. Per-fn handler isolation IS the substrate that makes per-fn
// emit safely parallel (a `><` fanout under `~> Thread` at the site).
effect WatBuffer {
  wat_collect() -> String
}

handler wat_stdout {
  wat_emit(s) => {
    print_string(s)
    resume()
  },
}

// wat_to_file — the write-through sink aimed at an fd (fs_create_impl's
// streaming open). Region-immune by construction: each arm hands the
// segment's bytes to the HOST before resuming, so the emit phase's
// per-fn region resets can never touch the product — the property
// wat_stdout always had, with the destination a config edge instead of
// fd 1. This is the ONLY sound whole-compile sink shape beside stdout:
// the collecting sink below banks heap pointers, and a whole-compile
// install of it reads region-reset records at collect (the in-process
// battery measured exactly that after the emit-arena landed).
handler wat_to_file(fd) {
  wat_emit(s) => {
    fd_write_bytes(fd, str_payload(s), byte_len(s))
    resume()
  },
}

// wat_to_host — the sink the EXECUTOR reads: each segment streams to the
// host's own buffer through the Process seam (lib/io.mn's Host effect —
// mentl_host.wat_write in tools/runner), exactly as wat_to_file hands bytes
// to an fd before resuming, so the emit phase's per-fn region resets can
// never touch the product. The module is then assembled and run by
// host_exec, which reads the whole streamed text — no wat2wasm, no file,
// no in-image copy: `mentl run` and the in-process battery install this
// sink and the program runs in the same process that compiled it.
handler wat_to_host {
  wat_emit(s) => {
    host_wat_write(str_payload(s), byte_len(s))
    resume()
  },
}

// wat_to_string — buffer wat_emit calls into a flat String; wat_collect
// materializes ONCE at the end via str_concat_all. Handles BOTH
// WasmOut.wat_emit AND WatBuffer.wat_collect — one handler, two effects.
//
// SCOPE LAW: per-fn installs ONLY — one record, inside one region
// bracket, collected before that region resets. A whole-compile install
// banks each segment's POINTER while the emit phase's per-fn region
// resets zero the segments beneath it; the collect then walks reset
// records (garbage tags at flat_fill, runaway lengths at the drain).
// Whole-compile products stream through wat_stdout / wat_to_file, whose
// arms hand the bytes to the host before any reset can run.
//
// Per the eight interrogations on the substrate-honest accumulator:
//   Graph:      buf is a List<String-handle>; count tracks position.
//   Handler:    one arm per op; resume OneShot.
//   Verb:       `~>` install (per-fn parallel emit-to-string).
//   Row:        +Memory (per-yield list_set) — NO Alloc per yield; +Alloc
//               fires ONCE at wat_collect via str_concat_all.
//   Ownership:  buf owned by handler state; refs to each emitted string
//               are borrows (immutable). Materialized result is owned.
//   Refinement: count <= len(buf) by buffer-counter discipline (Ω.3).
//   Gradient:   O(1) amortized append per yield (doubling); O(B+N) one-
//               time materialization at collect — locked. No narrower
//               form exists. Drift-11 (acc ++ x in loop) closed.
//   Reason:     each yield's source chains through unchanged; result's
//               Reason = "concatenated emit stream from N wat_emit sites".
//
// Pre-substrate (str_concat-in-resume) was O(B^2): per yield copied the
// growing buf bytes. For 1965-fn wheel emission, aggregate bump-allocator
// pressure exhausted memory mid-pass. Buffer-counter substrate cuts work
// to O(B+N) — millions-times speedup at wheel-scale.
handler wat_to_string with buf = make_list(64), count = 0 {
  wat_emit(s) => {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, s)
    resume() with buf = written, count = count + 1
  },
  wat_collect() => resume(str_concat_all(slice(buf, 0, count))),
}

// heap_base is the threshold separating sentinel ADT values from heap
// pointers. The bump allocator's $heap_ptr starts at 1 MiB (1048576);
// sentinels live in [0, heap_base()). Mixed-variant match dispatch
// (each fielded constructor's predicate) compares scrutinee against this
// value to discriminate. Single source of truth — every other reference
// to "4096" is a comment crosslinked to this constant.
fn heap_base() with Pure = 4096

// EmitMemory effect — alloc strategy as a handler swap.
// `emit_alloc(size, target_local)` emits the WAT sequence that allocates
// `size` bytes and stores the resulting pointer into `$<target_local>`. The
// strategies are `emit_memory_bump`, the monotonic bump from the one heap
// line, and `emit_memory_audited`, the same bump held to what the allocation
// audit measured of the unit; a full collector with header tags is the named
// peer Hβ.emit.memory-gc-handler. Reclaiming an extent is not a strategy of
// the allocator: `(body) ~> arena` (lib/arena.mn) moves what the extent
// published out of its region and resets the line behind it, on the same
// bump every strategy writes.
//
// Anchor 5: the backend's memory model is a one-handler swap — DESIGN 7.3
// "the handler IS the backend" extends to memory strategy without disturbing
// closure layout, list construction, or any other allocation site.
//
// Every allocation a unit's code makes passes through one of these two ops:
// `emit_alloc` for a size known here, into a named local, and
// `emit_alloc_top` for the stack form — a size the code computes, or the
// fixed cell a wide value spills into — leaving the pointer on the stack.
// What still writes `$alloc` as text is the runtime's own family (the
// world push, the continuation composer, the task spawner, the word-face
// wrappers, `_start`), which no unit's row answers for: each is reached
// through a construct that does.
effect EmitMemory {
  emit_alloc(Int, String)
  emit_alloc_top()
}

// The allocation call site is strategy-INVARIANT: (local.set $<target>
// (call $alloc (i32.const size))) against the single aligned allocator $alloc,
// whose body emit_memory_decl emits. No inline bump — the bump pattern's
// 5707-spelling re-derivation is deleted, read live from the one $alloc fn.
// The body is the bump, and it is the only one: an arena reclaims on the
// same line, and a collector's body is the peer named above.
fn alloc_into_text(size, target_local: String) = {
  wat_emit("    (local.set $")
  wat_emit(target_local)
  wat_emit(" (call $alloc (i32.const ")
  wat_emit(int_to_str(size))
  wat_emit(")))\n")
}

fn alloc_top_text() = wat_emit("    (call $alloc)\n")

handler emit_memory_bump {
  emit_alloc(size, target_local) => {
    alloc_into_text(size, target_local)
    resume()
  },
  emit_alloc_top() => {
    alloc_top_text()
    resume()
  },
}

// The strategy a planned unit is emitted under: bump, held to what the
// allocation audit measured of the unit (`alloc_audit`). A unit the audit
// read as building nothing that allocates anyway is a construct the audit's
// reading does not know, said here — after the unit's bytes, because only
// the emission can see it, and at the unit, because no node is in hand.
handler emit_memory_audited(site, verdict) {
  emit_alloc(size, target_local) => {
    alloc_audit_emitted(site, verdict)
    alloc_into_text(size, target_local)
    resume()
  },
  emit_alloc_top() => {
    alloc_audit_emitted(site, verdict)
    alloc_top_text()
    resume()
  },
}

fn alloc_audit_emitted(site: String, verdict) = match verdict {
  AllocFree => diag_report_at(
    EInternalInvariant(
      "emitting `{site}`: it allocates, and the allocation audit read nothing in it that builds",
      span_zero()
    ),
    ""
  ),
  Allocates => (),
  Unaudited => (),
}

// The multi-instance allocation strategy is NOT a third handler here: the
// shared-cell compare-exchange body is emitted by emit_memory_decl when the
// module's own proof says it spawns (spawn_task in the fifth projection),
// and its _start cell-initialization rides the same fact. A hand-installed
// strategy handler would re-derive what the program already proves — the
// gradient cash-out reads the artifact, never an install ceremony.
//
// String-literal interning (W5). Populated once per plan by
// set_string_entries, then read via string_offset at every LString emit
// site. The state is now a str_hash bucket INDEX (the 6th §5.O name-scanner
// dissolved — string_offset_lookup was a linear str_eq scan over ~thousands
// of entries per LString). string_index_get returns the SAME offset the
// linear first-match did (reverse-insertion + prepend puts the smallest
// original index at the bucket front), so the emit is byte-identical. On
// miss: 0 (the string region start — an empty string, idempotent emit).
handler string_table with idx = string_index_new() {
  string_offset(s) => resume(string_index_get(idx, s)),
  set_string_entries(es) => resume() with idx = build_string_index(es),
}

// The specialization-twin registry (SpecTwins, types.mn) — seeded once by
// the plan, read by every reference-emitting arm (LGlobal / LDirectCall)
// before it redirects a keyed site to a twin. Membership is a name map: the
// scan that stood here, beside a comment calling the set tiny, ran at every
// generic reference the module emits, over a set that reached three thousand
// twins on the wheel before twins were keyed by what their bodies read.
handler spec_registry with twins = smap_new(), count = 0, reach = smap_new(), decls = smap_new(), decls_read = false, sites = wmap_new(1024), threaded = false, forms = [] {
  spec_twins_exist() => resume(count > 0),
  spec_twin_known(n) => resume(match smap_get(twins, n) {
    Some(_) => true,
    None => false,
  }),
  set_spec_twins(ns) => resume() with twins = fold(smap_new(), smap_add(??, ??, 1), ns), count = len(ns),
  fanout_reach_known(n) => // Asked only by a call under a spawning demand, and answered by walking
  // that name's own reach and no further (`fanout_reach_ask`, graph.mn —
  // the rule's one home, which `mentl where` asks the same way), the
  // answers settled across asks in `reach`; a schedule-free module never
  // asks and pays nothing for the rule's existence. The decl index is read
  // off the decls column at the first ask.
  {
    let idx = if decls_read { decls } else { fanout_decls_index() }
    match fanout_reach_ask(reach, idx, n) {
      (found, memo) => resume(found) with reach = memo, decls = idx, decls_read = true,
    }
  },
  site_schedule_note(h, s) => resume() with sites = wmap_add(sites, h, s), threaded = threaded || schedule_eq(s, Threaded),
  site_schedule(h) => resume(wmap_get(sites, h)),
  threaded_site_noted() => resume(threaded),
  fanout_form_note(ns) => resume() with forms = forms ++ ns,
  fanout_form_drain() => resume(forms) with forms = [],
}

// The emission in flight, for the diagnostics that stand at a spanless node
// (EmitSite, types.mn). The per-fn install: emit_one_fn_to_string already
// holds the record's name, so the name is a config arg and the arm is a read.
handler emit_site_named(site) {
  emit_site() => resume(site),
}

// The module-scope default, and its answer is information rather than a
// fallback: the fold helpers, the init lets and the table emissions genuinely
// stand outside every fn record, so a diagnostic there IS at module scope and
// says so.
handler emit_site_module {
  emit_site() => resume("module scope"),
}

// ─── The show/hash dispatch — emit-time, the one home ─────────────────────
// to_string / hash arrive as STRUCTURAL nodes (LShow / LHash); the operand's
// type is read HERE, under whatever specialization bracket is active — so a
// twin's to_string on its instantiated var renders the value (the lower-time
// name bake rendered the ADDRESS), and its hash agrees with its eq. The
// builders synthesize the SAME LowIR shapes lower used to bake, so every
// walk (locals, vectors, fold collection) delegates through them and
// concrete scalar sites stay byte-identical. The AGGREGATE leaf is the one
// deliberate change: a DIRECT (__state, arg) call to the generated
// $show_<sig>/$hash_<sig> helper — §5.U's own law ("plain top-level fns,
// called directly like $str_eq") — replacing the closure-convention call
// against a $show_<sig> global that never existed (the minimal-module
// undefined-global assembly break, gate mn-aggregate-show).
// The fold boundary for show/hash (the eq entry's law): chase_deep
// resolves every interior bound var once, so the family's sigs, dedup,
// and dispatch agree on one resolution.
fn show_hash_ty(x) = fold_strip(chase_deep(lookup_ty(lexpr_handle(x))))

fn spec_is_agg(ty) with Pure = match ty {
  TList(TByte) => false,
  TList(_) => true,
  TTuple(_) => true,
  TName(_, _) => true,
  TRecord(_) => true,
  TRecordOpen(_, _) => true,
  _ => false,
}

// The scalar/word face of show — the synthesized call (aggregates never
// reach this; emit_show dispatches them to the direct leaf call).
fn show_node_of(h, x) = {
  let ty = show_hash_ty(x)
  match ty {
    TList(TByte) => x,
    TFloat => LCall(h, LGlobal(h, "float_to_str"), [x]),
    TList(_) => x,
    TTuple(_) => x,
    TName(_, _) => x,
    TRecord(_) => x,
    TRecordOpen(_, _) => x,
    _ => LCall(h, LGlobal(h, "int_to_str"), [x]),
  }
}

fn hash_node_of(h, x) = {
  let ty = show_hash_ty(x)
  match ty {
    TList(e) => // The byte face hashes as TEXT (str_hash) — the same projection a
    // String FIELD takes (emit_field_hash's byte face), closing the hash
    // route split the A.4 recon surfaced: top-level hash(s) ran the
    // length-seeded list mix while a field ran the text mix — one type,
    // two hash fns, the divergence the fold family exists to forbid.
    match seq_elem_face(e) {
      TByte => LCall(h, LGlobal(h, "str_hash"), [x]),
      TFloat => // the field twin's route (emit_field_hash) — one type, one
      // hash fn; the word list_hash here hashed the f64 REFERENCES
      LCall(h, LGlobal(h, "list_hash_f64"), [x]),
      _ => LCall(h, LGlobal(h, "list_hash"), [x]),
    },
    TFloat => LCall(h, LGlobal(h, "str_hash"), [LCall(h, LGlobal(h, "float_to_str"), [x])]),
    TTuple(_) => x,
    TName(_, _) => x,
    TRecord(_) => x,
    TRecordOpen(_, _) => x,
    _ => x,
  }
}

fn emit_agg_leaf_call(prefix, ty, x) = {
  wat_emit("    (local.get $__state)\n")
  emit_expr(x)
  wat_emit("    (call $")
  wat_emit(prefix)
  wat_emit(fold_sig(ty))
  wat_emit(")\n")
}

// A free operand renders as the word it is: the settle point refused every
// executable site where it would be anything else (`settle_node`).
fn emit_show(h, x) = {
  let ty = show_hash_ty(x)
  if spec_is_agg(ty) { emit_agg_leaf_call("show_", ty, x) } else { emit_expr(show_node_of(h, x)) }
}

fn emit_hash(h, x) = {
  let ty = show_hash_ty(x)
  if hash_is_agg(ty) { emit_agg_leaf_call("hash_", ty, x) } else { emit_expr(hash_node_of(h, x)) }
}

// A list is the AGG route only when its element face is structural
// (the generated $hash_<sig> walker); byte / float / word faces go
// through hash_node_of's runtime routing. The unconditional
// spec_is_agg read demanded $hash_li for EVERY list while the
// collector contributed none — top-level hash of any word list was
// an undefined-symbol assembly break (measured: hash([1, 2])).
fn hash_is_agg(ty) = match ty {
  TList(e) => seq_face_structural(seq_elem_face(e)),
  _ => spec_is_agg(ty),
}

// The closure-mint face of `spec_target_name`'s redirect (lower.mn, where
// the reference face lives beside the key projection it reads): inside a
// twin's emission the bracket carries the active enc, and a nested record
// whose twin exists gets its table index redirected — captures,
// self-binding, and local naming keep the ORIGINAL name (the record local is
// the closure value; only the offset-0 index points at the twin body).
// Outside a bracket enc is "" — floor.
fn spec_closure_name(name: String) = if !spec_twins_exist() {
  name
} else {
  // The symbol the nested record was registered under — a schedule twin's
  // lambda keeps the instantiation alone, the base name at the floor
  // (`nested_twin`).
  let t = nested_twin(name, spec_enc_active())
  if byte_len(t.enc) == 0 { name } else if spec_twin_known(t.sym) { t.sym } else { name }
}

// The str_hash bucket index — the shared name-is-handle waypoint shape
// (mirrors env/esc/summary/base/reach; region_index is the handle-keyed
// template). str_eq inside the small bucket carries the same content
// equality the old `target: String` pin did: a content-equal COPY of a
// registered string keys the same offset.
fn string_index_new() = list_filled(4096, [])

fn build_string_index(entries) =
  build_string_index_from(entries, len(entries) - 1, string_index_new())

fn build_string_index_from(entries, i, idx) = if i < 0 {
  idx
} else {
  match list_index(entries, i) {
    (s, offset) => build_string_index_from(entries, i - 1, string_index_add(idx, s, offset)),
  }
}

fn string_index_add(idx, s: String, offset) = {
  let b = i32_and(str_hash(s), 4095)
  list_set(idx, b, [(s, offset)] ++ list_index(idx, b))
}

fn string_index_get(ref idx, s: String) = {
  let b = i32_and(str_hash(s), 4095)
  string_bucket_scan(list_index(idx, b), s, 0)
}

fn string_bucket_scan(ref bucket, s: String, i) = if i >= len(bucket) {
  0
} else {
  match list_index(bucket, i) {
    (bs, offset) => if bs == s { offset } else { string_bucket_scan(bucket, s, i + 1) },
  }
}

// Reads through LookupTy; refinements transparent (erased at runtime).
//
//
// ─── THE EMITTED REACH — the module is what live code names ───────────
//
// Lower's reach constructs by NAME, and it must: a twin is a copy of its
// base's lowered body, so a base is constructed whatever key its sites
// project. What it cannot know is which bases anything CALLS, because the
// keys do not exist until the instantiations are read. This reach reads
// the same references (`low_refs`, the one walk both reaches share) at the
// altitude where they do: from main and the roots lower seeds, a base
// body's references resolve unbracketed and a twin's under its own pairs,
// so a site whose key projects wide demands the twin and a floor site the
// base. A top-level decl no live reference reaches is not emitted, and a
// base whose every call was keyed to a twin carries no floor into the
// module (`Hβ.emit.dead-base-emitted-beside-its-twins`). The twins are the
// same fixpoint's other half — every candidate twins (5.1a's total
// monomorphization; mixed instantiations such as a := Float, b := Int twin
// through each var's own pair), and each demand is one body scanned once,
// under its own instantiation.
type Demand
  // a symbol by its own name: a decl's base body, an arm, a runtime fn
  = DemandBase(String)
  // a twin: its mangled name, its base, the instantiation pairs and their
  // encoding, and its LINEAGE — the twin bases whose body scans produced it,
  // the recursion meter the cap reads
  | DemandTwin(String, String, [(Int, Ty)], String, [String])

// The reach's verdict on one top-level decl, by source index.
type DeclReach = Unreached | Reached

fn spec_find_rec(recs, target: String) = find({ (n, _p, _b, _f) => n == target }, recs)

fn demand_base(n) = DemandBase(n)

// One reference, read under the bracket in force: the key its site
// projects decides twin or base, the same read `spec_target_name` makes
// for the emitted call. A twin demand carries the LINEAGE it was reached
// by.
fn ref_demand(lineage, r) = match r {
  RefName(n) => DemandBase(n),
  RefSite(h, n) => key_demand(n, twin_site_key(h, n), lineage),
  RefCall(h, n) => // A direct call's key carries the bracket's schedule into a callee that
  // reaches a fanout (`twin_call_key`): the demand is the schedule twin.
  key_demand(n, twin_call_key(h, n), lineage),
  RefArm(ih, n) => key_demand(n, arm_twin_key(ih), lineage),
}

// A key's demand: the base at the floor, else the twin it names, emitted under
// the key's own substitution.
fn key_demand(n: String, key: {enc: String, pairs: [(Int, Ty)]}, lineage) = if spec_enc_is_floor(key.enc) {
  DemandBase(n)
} else {
  DemandTwin(spec_mangle(n, key.enc), n, key.pairs, key.enc, lineage)
}

// A capped twin's body, read at the floor: its interior sites mangle past
// the cap, find no registered twin, and emit the base names.
fn ref_floor_demand(r) = DemandBase(ref_name(r))

// A top-level decl's keys — its own name, or for a name-less container the
// arm names it holds (`reach_collect`'s keep rule, read at the emit): a
// container lives when any of them is demanded, and one with none lives
// always.
fn emit_keys(program, i, n, keys) = if i >= n {
  keys
} else {
  let stmt = list_index(program, i)
  let nm = reach_decl_name(stmt)
  let names = if nm == "" { reach_nested_names(stmt, []) } else { [nm] }
  emit_keys(program, i + 1, n, fold(keys, smap_add(??, ??, i), names))
}

// The roots: in a library every decl (it emits whole); in an executable
// each module value let's init (it runs in __init_lets before main), with
// main, the runtime contract and argv demanded by `emit_reach`. A decl
// with no keys lives either way; a bare expression or a trivial decl roots
// nothing, as in lower's phase A.
fn emit_reach_roots(program, library, i, n, live, roots) = if i >= n {
  (live, roots)
} else {
  let stmt = list_index(program, i)
  let keyless = reach_decl_name(stmt) == "" && len(reach_nested_names(stmt, [])) == 0
  if library {
    emit_reach_roots(program, library, i + 1, n, list_set(live, i, Reached), low_refs(roots, stmt))
  } else if keyless {
    // An executable's value let runs in `$__init_lets` at module scope, so
    // its init is settled there, unbracketed, under the let's own name.
    let roots2 = match stmt {
      LLet(_, name, init) => {
        settle_floors(name, init)
        low_refs(roots, init)
      },
      _ => roots,
    }
    emit_reach_roots(program, library, i + 1, n, list_set(live, i, Reached), roots2)
  } else {
    emit_reach_roots(program, library, i + 1, n, live, roots)
  }
}

// The fixpoint. The accepted twin set is a FLAT BUFFER with its count, read
// in order when the fix ends, and a name map beside it answers membership by
// mangled name — the linear scan it replaces grew with the twin set, and the
// twin set is every instantiation a program makes. `live` flags the decls
// emitted, by source index; `wide` records that the runtime family a twin
// can mint is already demanded.
fn emit_reach_fix(work, st, program, keys, recs, settles) = if len(work) == 0 {
  st
} else {
  let d = work[0]
  let w2 = rest(work)
  match st {
    (dbuf, dn, seen, live, wide) => match d {
      DemandBase(nm) => match smap_get(keys, nm) {
        None => emit_reach_fix(w2, st, program, keys, recs, settles),
        Some(i) => match list_index(live, i) {
          Reached => emit_reach_fix(w2, st, program, keys, recs, settles),
          Unreached => {
            // A base body's keys are fixed by its own source types, so the
            // lineage starts again here, and the body is settled at the
            // floor it emits at.
            let stmt = list_index(program, i)
            if settles { settle_decl(nm, stmt) }
            let ds = map(ref_demand([], ??), low_refs([], stmt))
            emit_reach_fix(
              ds ++ w2,
              (dbuf, dn, seen, list_set(live, i, Reached), wide),
              program,
              keys,
              recs,
              settles
            )
          },
        },
      },
      DemandTwin(m, base, pairs, enc, lineage) => match smap_get(seen, m) {
        Some(_) => emit_reach_fix(w2, st, program, keys, recs, settles),
        None => {
          // THE POLYMORPHIC-RECURSION CAP (the 5.1c guard) meters DEPTH along
          // the lineage, never breadth across the program. A base sits twice
          // on one lineage only when its body reaches itself at a NEW key —
          // the mangle dedup above swallows every same-key recursion — so its
          // count there is how deep a self-instantiating chain has gone
          // (depth@[w], depth@[[w]], …). Past it the twin registers and its
          // body's sites emit the base names: the word-protocol floor, where
          // the deep tail pays indirection and never divergence. Counting the
          // base program-wide floored a generic fn's ninth instantiation — a
          // record-polymorphic chain past eight shapes read a row that never
          // closed and trapped.
          let capped = lineage_depth(lineage, base) >= 8
          let ds = match spec_find_rec(recs, base) {
            None => [DemandBase(base)],
            Some(rec) => match rec {
              (_n, _ps, body, _f) => {
                // ONE bracket for the body's settle and its scan, taken UNDER
                // the instantiation its emission reads it at: the references
                // it makes key against the specialized truth, and a capped
                // twin is emitted under its own pairs like any other.
                spec_ctx_set(pairs, enc)
                if settles { each(settle_floors(m, ??), body) }
                let refs = low_refs_list([], body)
                let inner = if capped {
                  if settles { each(settle_depth(m, base, ??), refs) }
                  map(ref_floor_demand, refs)
                } else {
                  map(ref_demand([base] ++ lineage, ??), refs)
                }
                spec_ctx_clear()
                inner
              },
            },
          }
          // the runtime family a twin's emission can mint that its floor did
          // not (lower seeds the same names per entry, wide_seed)
          let family = if wide { [] } else { map(demand_base, spec_wide_family()) }
          match spec_demand_accept((dbuf, dn), (m, base, pairs, enc)) {
            (dbuf2, dn2) => emit_reach_fix(
              ds ++ family ++ w2,
              (dbuf2, dn2, smap_add(seen, m, 1), live, true),
              program,
              keys,
              recs,
              settles
            ),
          }
        },
      },
    },
  }
}

// How many times BASE sits on a demand's lineage — the recursion depth the
// cap reads.
fn lineage_depth(lineage, base: String) =
  fold(0, (n, b) => if b == base { n + 1 } else { n }, lineage)

// ─── THE SETTLE POINT — every floor the module would carry, said first ───
//
// A floor is what the emit writes where it cannot prove the read a site
// needs: an offset for a field load or a record pattern, a shape for a
// comparison, a show, a hash or a `++`, a specialization past the twin cap,
// or a boundary lowering could not build. Each is decided under the bracket
// the body is emitted in, and the reach above is the walk that holds that
// bracket for every emitted body — a base unbracketed, a twin under its own
// pairs, a value let's init at module scope — so it asks, once per body,
// before the gate reads the ledger and before a byte is written. Emission
// writes the same floors without a word, and only where nothing runs them:
// an executable's gate has refused every one it would reach, and a
// library's whole-emit has no caller to settle for.
//
// A decl at the root of the program: a top-level fn is a closure whose record
// is the module's static data (`extract_top_fn_name`), so its own lines are
// static and only what it holds is settled as minted.
fn settle_decl(site: String, stmt) = match stmt {
  LLet(_, _, LMakeClosure(_, LFn(_, _, _, body, _, _), caps)) => each(settle_floors(site, ??), caps ++ body),
  LLet(_, _, LMakeContinuation(_, LFn(_, _, _, body, _, _), caps, _, _)) => each(settle_floors(site, ??), caps ++ body),
  _ => settle_floors(site, stmt),
}

fn settle_floors(site: String, expr) = {
  settle_node(site, expr)
  each(settle_floors(site, ??), low_children(expr))
}

// The questions one node asks. Each reads the fact its emission reads, under
// the same bracket, so the settle and the floor cannot disagree.
fn settle_node(site: String, expr) = match expr {
  LBinOp(h, op, l, _) => settle_binop(site, h, op, l),
  LFieldLoad(h, rec, sel) => // said at the access, which names the receiver and the selector together
  // (a parameter receiver's own handle carries no span)
  if field_sel_offset(rec, sel) < 0 {
    report_at(h, EFieldOffsetUnprovable(field_offset_unprovable_why(rec, sel), parse_span_of(h)))
  },
  LShow(h, x) => settle_shape(site, h, "a show", x),
  LHash(h, x) => settle_shape(site, h, "a hash", x),
  LArena(h, _) => // the exit moves the value by its whole structure, which a variable
  // does not have
  settle_shape(site, h, "an arena's exit", expr),
  LMatch(_, _, arms) => each({ (p, _) => settle_pattern(p) }, arms),
  LMakeClosure(_, LFn(_, _, _, _, _, lines), _) => settle_minted_lines(site, lines),
  LMakeContinuation(_, LFn(_, _, _, _, _, lines), _, _, _) => settle_minted_lines(site, lines),
  LDeclareFn(LFn(name, _, _, _, _, lines)) => // below the root a declared fn is a handler's arm or init fn, whose lines
  // live in the install's record (`lower_handler_arms_as_decls`)
  settle_minted_lines(name, lines),
  LInvariantFailure(h, inv) => report_at(
    h,
    EInternalInvariant("{show_boundary_invariant(inv)}, emitting {site}", parse_span_of(h))
  ),
  LConst(_, _) => (),
  LLocal(_, _) => (),
  LGlobal(_, _) => (),
  LLet(_, _, _) => (),
  LUpval(_, _) => (),
  LUnaryOp(_, _, _) => (),
  LCall(_, _, _) => (),
  LTailCall(_, _, _) => (),
  LDirectCall(_, _, _, _, _) => (),
  LReturn(_, _) => (),
  LYield(_, _, _, _) => (),
  LKExtend(_, _) => (),
  LIf(_, _, _, _) => (),
  LBlock(_, _) => (),
  LMakeList(_, _) => (),
  LMakeTuple(_, _) => (),
  LSimdLanes(_, _) => (),
  LFanout(_, _, _, _) => (),
  LMakeRecord(_, _) => (),
  LMakeVariant(_, _, _) => (),
  LResumeK(_, _, _) => (),
  LHandleWith(_, _, _, _, _, _) => (),
  LDerive(_, _, _) => // The reading's forward body settles through the walk; the program derive
  // adds beside it is f64 arithmetic over names its own reads bind.
  (),
  LFeedback(_, _, _, _, _) => (),
  LFeedbackPrior(_) => (),
  LPerform(_, _, _) => (),
  LConvert(_, _, _) => (),
  LStateSlotStore(_, _, _, _) => (),
  LStateInit(_, _, _, _) => (),
  LWasiCall(_, _, _) => (),
}

// A binary operator's operand, read where its emission reads it
// (`emit_binop_for`): a `++` needs a sequence, a comparison a structure, and
// arithmetic the number the judgment gated its operand to be. Each is said at
// the operator's own node, whose span covers the operands (a parameter
// operand's handle carries none).
fn settle_binop(site: String, h, op, l) = {
  let lh = lexpr_handle(l)
  match op {
    BConcat => match fold_strip(lookup_ty(lh)) {
      TList(_) => (),
      other => settle_unprovable(h, "`++` on {show_type(other)}, emitting {site}"),
    },
    BEq => settle_compare(site, h, op, lh),
    BNe => settle_compare(site, h, op, lh),
    BLt => settle_compare(site, h, op, lh),
    BGt => settle_compare(site, h, op, lh),
    BLe => settle_compare(site, h, op, lh),
    BGe => settle_compare(site, h, op, lh),
    BAdd => settle_arith(site, h, op, lh),
    BSub => settle_arith(site, h, op, lh),
    BMul => settle_arith(site, h, op, lh),
    BDiv => settle_arith(site, h, op, lh),
    BMod => settle_arith(site, h, op, lh),
    BAnd => settle_arith(site, h, op, lh),
    BOr => settle_arith(site, h, op, lh),
  }
}

// A comparison whose operand is still a VARIABLE has no structure to read:
// the word compare it would fall to answers an address for anything but a
// word (measured 2026-09-18: a handler arm over quantified op parameters
// answered "ab" != "ab").
fn settle_compare(site: String, h, op, lh) = if lh != 0 {
  match fold_strip(chase_deep(lookup_ty(lh))) {
    TVar(_) => settle_unprovable(h, "`{binop_to_str(op)}` on {show_type(lookup_ty(lh))}, emitting {site}"),
    _ => (),
  }
}

// A show or a hash of a VARIABLE renders or mixes the word it is — a
// pointer printed as a number for anything but an Int (measured 2026-09-28:
// a handler head rendered its config list as `(66036)`). Said at the show.
fn settle_shape(site: String, h, what: String, x) = match show_hash_ty(x) {
  TVar(_) => settle_unprovable(h, "{what} of {show_type(show_hash_ty(x))}, emitting {site}"),
  _ => (),
}

fn settle_unprovable(h, why: String) = report_at(h, EShapeUnprovable(why, parse_span_of(h)))

// Arithmetic's operand is a word by the judgment's numeric gate, so what
// the emit would meet otherwise is an invariant broken upstream: a variable
// the gate never reached, or an aggregate past it.
fn settle_arith(site: String, h, op, lh) = if lh != 0 {
  match arith_operand_class(chase_deep(lookup_ty(lh))) {
    AoWord => (),
    AoUnproven(v) => if len(numeric_gates_of(graph_chase_handle(v))) == 0 {
      report_at(
        h,
        EInternalInvariant(
          "arithmetic `{binop_to_str(op)}` on an ungated variable ({show_type(lookup_ty(lh))}), emitting {site}",
          parse_span_of(h)
        )
      )
    },
    AoAggregate => report_at(
      h,
      EInternalInvariant(
        "arithmetic `{binop_to_str(op)}` on {show_type(lookup_ty(lh))} reached emit past the judgment's gate, emitting {site}",
        parse_span_of(h)
      )
    ),
  }
}

// A record pattern whose receiver's field set never closed has no slot for
// what it tests or binds, said at the scrutinee (the two emission floors,
// `emit_pat_predicate_at` and `emit_pat_binds_at`, read the same set). Its
// sub-patterns ride inside it; every other pattern holds its sub-patterns.
fn settle_pattern(pat) = match pat {
  LPVar(_) => (),
  LPWild => (),
  LPCon(_, _, subs) => each({ (_, p) => settle_pattern(p) }, subs),
  LPUnresolvedCon(_, subs) => each(settle_pattern, subs),
  LPTuple(subs) => each({ (_, p) => settle_pattern(p) }, subs),
  LPLit(_) => (),
  LPList(_, subs, _, _) => each(settle_pattern, subs),
  LPRecord(rh, rty, fbs, rest) => match record_full_fields(rty) {
    Some(_) => each({ (_, p) => settle_pattern(p) }, fbs),
    None => if !record_pats_always_match(fbs) || record_pat_has_binds(fbs, rest) {
      report_at(rh, EFieldOffsetUnprovable(record_pattern_unprovable_why(rty), parse_span_of(rh)))
    },
  },
  LPAs(_, p) => settle_pattern(p),
  LPAlt(ps) => each(settle_pattern, ps),
}

// A record minted at run time holds its body's `<~` lines in slots; a
// static home inside one is the lowering's line rule broken
// (`ls_line_slot`), and the ring would have nowhere to live. Said at the
// `<~` itself.
fn settle_minted_lines(site: String, lines) = each(
  {
    (h, _depth, home) => match home {
      LhStatic => report_at(
        h,
        EInternalInvariant(
          "this `<~` has a static home inside a record minted at run time, emitting {site}",
          parse_span_of(h)
        )
      ),
      LhSlot(_) => (),
      LhStaticJvp => report_at(
        h,
        EInternalInvariant(
          "this `<~` has a static derivative home inside a record minted at run time, emitting {site}",
          parse_span_of(h)
        )
      ),
    },
  },
  lines
)

// Past the twin cap a site reaches its callee's BASE, which reads every
// variable free. A site whose key keeps a variable the callee reads — a
// structure, or a number — would be read there as a word, which is exactly
// what the twin existed to prevent. A wide value nothing reads crosses the
// word protocol boxed and back, and is sound.
fn settle_depth(site: String, base: String, r) = match r {
  RefSite(h, n) => settle_depth_at(site, base, h, n, twin_site_key(h, n).pairs),
  RefCall(h, n) => settle_depth_at(site, base, h, n, twin_site_key(h, n).pairs),
  RefArm(ih, n) => settle_depth_at(site, base, ih, n, arm_twin_key(ih).pairs),
  RefName(_) => (),
}

fn settle_depth_at(site: String, base: String, h, n: String, pairs) = if any(pair_read_past_floor, pairs) {
  report_at(
    h,
    EInstantiationDepth(
      "`{n}`, reached from `{site}` eight instantiations deep in `{base}`'s recursion",
      parse_span_of(h)
    )
  )
}

fn pair_read_past_floor(p) = match p {
  (w, _t) => any(read_past_a_move, graph_demands_of(w)) && !spec_enc_is_floor(twin_pair_code(p)),
}

// A move read past the cap is sound at the base: the barrier there cannot see
// the type, and its entry keeps the region rather than moving a value wrong.
// Every other demand reads the variable, and the base would read it as a word.
fn read_past_a_move(d) = !is_move_demand(d)

// ─── THE ALLOCATION AUDIT — what a unit's code builds, read against the row
// the judgment gave it ────────────────────────────────────────────────────
//
// The judgment charges `Memory + Alloc` where a construct builds a record;
// the emission decides where a record is built. Those are two readings of
// one fact, and six constructs once allocated with no row saying so because
// the two disagreed (`Hβ.effects.install-allocates-unrowed`), each found by
// hand. The audit makes the agreement a measurement. Once the ABI is settled
// — a direct call spills a wide argument into a cell exactly when the
// callee's settled slot is a word — every unit the module emits is walked
// under the bracket it is emitted at: a fn, a lambda, a partial, an arm, a
// state init, and the thunks and remainders cut from them, which answer to
// the row of the unit they were cut from. A construct whose emission builds
// something, in a unit whose row does not say `Alloc`, is a claim the medium
// made and its own code breaks, refused before a byte is written. Each
// construct asks what its emission asks: a call reads its callee's row, a
// spill reads the slot the call fills, a list reads the constructor it calls.
// The other direction is held where emission allocates
// (`emit_memory_audited`): a unit this walk read as building nothing that
// allocates anyway names a construct the walk does not know.
//
// What a unit's allocations answer to: a function's own row, at the node
// its enumeration entry names; a handler's row, for its arms; the install,
// for a state init, whose cells are the install record's and built at the
// install's own cost; module scope, where the init lets run and no row is
// claimed; or nothing the enumeration lists. A thunk or a remainder answers
// to the owner of the unit it was cut from.
type AllocOwner = OwnedByFn(Int) | OwnedByHandler(String) | OwnedByInstall(String) | OwnedByModule | OwnedByNothing

// The owner's row, read once and resolved: the row itself with what it says
// of `Alloc` (the ask every construct makes) beside it; a grant where no row
// is claimed (module scope; an install's inits, whose cells are the install
// record's and built at the install's own cost); or no row to read, and why.
type RowRead = RowOf(EffRow, Bool) | RowGranted(String) | RowAbsent(String)

// One unit in the walk: the row its code answers to, read once where the
// walk enters it; the encoding its nested units' symbols are mangled with (a
// twin's bracket); how a report names it; and the symbol it is emitted as.
type AllocUnit = AllocUnit({enc: String, names: String, row: RowRead, sym: String})

// What a construct's emission builds, named only when a refusal says it. The
// continuation machinery — a remainder record, its extension, a multi-shot
// perform's argument record, a resumed value's cell, a driver's word-faced
// argument — has no site here: it is the op's remainder cost, priced in the
// op's own row at the perform (`scheme_with_disc_cost`), and the unit it
// lands in is whichever frame the spine extends. That frame's row is where
// the judgment priced it: a yield crosses a frame only when what the frame
// called performs a multi-shot op (the op's row says so) or runs a held
// remainder (the resume performs its world, judged at each install), so the
// walk records it as built and never refuses it against the frame's row a
// second time. A wide argument boxed into a callee's word slot has no site
// either: it is narrated, never refused (`alloc_boxed`).
type AllocSite
  = AsClosure
  | AsShow
  | AsConcat
  | AsCall(String)
  | AsList
  | AsTuple
  | AsRecord
  | AsVariant
  | AsListRest
  | AsRecordRest
  | AsInstall
  | AsArena
  | AsAllocation
  | AsSpawn
  | AsStateCell

// The plan's word on one emitted unit, which its emission is held to.
type AllocVerdict = Allocates | AllocFree | Unaudited

// The walk's state: each unit's verdict by symbol, and each callee's answer,
// read once — kept as two membership sets so a read allocates nothing.
effect AllocAudit {
  alloc_unit_done(String, Bool)
  alloc_callee_builds(String) -> Bool
  alloc_concat_builds() -> Bool
  alloc_units() -> [[(String, Bool)]]
}

handler alloc_audit_state with units = smap_new(), building = smap_new(), quiet = smap_new(), concat = None {
  alloc_unit_done(sym, builds) => resume() with units = smap_add(units, sym, builds),
  alloc_concat_builds() => // `++` builds when a callee its sugar names does: their own rows, read
  // once through their one home
  match concat {
    Some(b) => resume(b),
    None => {
      let b = any(alloc_named_answer, concat_callees())
      resume(b) with concat = Some(b)
    },
  },
  alloc_callee_builds(name) => if smap_has(building, name) {
    resume(true)
  } else if smap_has(quiet, name) {
    resume(false)
  } else if alloc_named_answer(name) {
    resume(true) with building = smap_add(building, name, true)
  } else {
    resume(false) with quiet = smap_add(quiet, name, false)
  },
  alloc_units() => resume(units),
}

// The audit over the planned module: the reached tree at the floor, then
// each twin at its own bracket. The answer is each emitted unit's verdict,
// by symbol.
fn alloc_audit(lowered, spec_demands, all_records) = {
  alloc_walk_list(alloc_module_unit(), lowered, 0)
  let bodies = fold(smap_new(), alloc_body_add, all_records)
  each(alloc_audit_twin(bodies, ??), spec_demands)
  alloc_units()
} ~> alloc_audit_state

// Each record's body by its name, read once per twin rather than scanned for.
fn alloc_body_add(m, rec) = match rec {
  (n, _ps, body, _f) => smap_add(m, n, body),
}

// What emission holds a unit to: the audit's measurement of it, nothing
// where no audit ran (a library's whole-emit, which no caller settles), and
// a unit the audit never walked is the walk missing something the module
// emits.
fn alloc_verdict(units, name: String) = match units {
  None => Unaudited,
  Some(m) => match smap_get(m, name) {
    Some(true) => Allocates,
    Some(false) => AllocFree,
    None => {
      diag_report_at(
        EInternalInvariant("emitting `{name}`: the allocation audit never walked it", span_zero()),
        ""
      )
      Unaudited
    },
  },
}

fn alloc_module_unit() =
  AllocUnit({enc: "", names: "module scope", row: RowGranted("module scope claims no row"), sym: ""})

fn alloc_audit_twin(bodies, d) = match d {
  (m, base, pairs, enc) => match smap_get(bodies, base) {
    Some(body) => {
      spec_ctx_set(pairs, enc)
      alloc_walk_unit(alloc_unit_named(base, m, enc, alloc_module_unit()), body)
      spec_ctx_clear()
    },
    None => (),
  },
}

// A nested unit's symbol and enc: the one spelling the twin's nested records
// are named by (`nested_twin`, read by `plan_reached` too).
fn alloc_nested(unit, name: String) = match unit {
  AllocUnit(u) => {
    let t = nested_twin(name, u.enc)
    alloc_unit_named(name, t.sym, t.enc, unit)
  },
}

// A nested unit walks under ITS bracket: the parent's where it keeps the
// parent's enc, and its own where a schedule twin's lambda drops the letter
// (the floor, or the instantiation alone) — the parent's bracket restored
// after, since the walk continues in the parent.
fn alloc_walk_nested(unit, name: String, body) = match unit {
  AllocUnit(u) => {
    let t = nested_twin(name, u.enc)
    if str_eq(t.enc, u.enc) {
      alloc_walk_unit(alloc_nested(unit, name), body)
    } else {
      let pairs = spec_pairs_active()
      spec_ctx_set(if byte_len(t.enc) == 0 { [] } else { pairs }, t.enc)
      let r = alloc_walk_unit(alloc_nested(unit, name), body)
      spec_ctx_set(pairs, u.enc)
      r
    }
  },
}

// A unit, read off its own fn's enumeration entry: the row it answers to is
// read here, once, and a thunk or remainder takes its parent's.
fn alloc_unit_named(name: String, sym: String, enc: String, parent) = match parent {
  AllocUnit(p) => match graph_emitfn_at(name) {
    [] => AllocUnit({enc: enc, names: name, row: alloc_owner_row(OwnedByNothing), sym: sym}),
    entries => match last(entries) {
      EmitFnEntry(e) => match e.kind {
        EfkNested => AllocUnit({enc: enc, names: name, row: alloc_owner_row(OwnedByFn(e.origin)), sym: sym}),
        EfkLambda => AllocUnit({enc: enc, names: p.names, row: alloc_owner_row(OwnedByFn(e.origin)), sym: sym}),
        EfkPartial => AllocUnit({enc: enc, names: p.names, row: alloc_owner_row(OwnedByFn(e.origin)), sym: sym}),
        EfkArm(op, hname) => AllocUnit({enc: enc, names: "{hname}.{op}", row: alloc_owner_row(OwnedByHandler(hname)), sym: sym}),
        EfkInit(hname) => AllocUnit({enc: enc, names: hname, row: alloc_owner_row(OwnedByInstall(hname)), sym: sym}),
        EfkThunk => AllocUnit({enc: enc, names: p.names, row: p.row, sym: sym}),
        EfkK => AllocUnit({enc: enc, names: p.names, row: p.row, sym: sym}),
      },
    },
  },
}

fn alloc_owner_row(owner) = match owner {
  OwnedByFn(origin) => match lookup_ty(origin) {
    TFun(_, _, row) => alloc_row_read(row),
    other => RowAbsent("its origin is not a function: {show_type(other)}"),
  },
  OwnedByHandler(hname) => alloc_handler_row(hname),
  OwnedByInstall(hname) => match projection_of(hname) {
    PDerivative => alloc_handler_row(hname),
    PSchedule(_) => RowGranted("an install's cells are built at the install's own cost"),
    PDispatch => RowGranted("an install's cells are built at the install's own cost"),
    PArena => RowGranted("an arena's exit moves what survives at the arena's own cost"),
  },
  OwnedByModule => RowGranted("module scope claims no row"),
  OwnedByNothing => RowAbsent("it has no enumeration entry, so no row"),
}

fn alloc_handler_row(hname: String) = match env_lookup(hname) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      HandlerKind(r, _, _, _, _) => alloc_row_read(read_bound_row(r)),
      _ => RowAbsent("`{hname}` is not a handler"),
    },
  },
  None => RowAbsent("no handler is named `{hname}`"),
}

// The row resolved once, with its answer to the ask every construct makes.
fn alloc_row_read(row) = match resolve_row(row) {
  EfRow(p, a, t) => RowOf(EfRow(p, a, t), row_names_say(p, "Alloc")),
}

fn row_names_say(p, ename: String) = name_set_contains(p, ENamed(intern_str(ename)))

// Whether a row read says `Alloc` — the ask every construct makes, answered
// from the read.
fn row_read_allows(r) = match r {
  RowOf(_, alloc) => alloc,
  RowGranted(_) => true,
  RowAbsent(_) => false,
}

// Whether a called function's own row says `Alloc`: its enumeration entry
// when lowering built it, else its scheme — a primitive's declared row.
fn alloc_named_answer(name: String) = match graph_emitfn_at(name) {
  [] => match env_lookup(name) {
    Some(entry) => match entry {
      (scheme, _, _) => match judgment_ty(scheme) {
        TFun(_, _, row) => row_read_allows(alloc_row_read(row)),
        _ => false,
      },
    },
    None => false,
  },
  entries => match last(entries) {
    EmitFnEntry(e) => match e.kind {
      EfkNested => row_read_allows(alloc_owner_row(OwnedByFn(e.origin))),
      EfkLambda => row_read_allows(alloc_owner_row(OwnedByFn(e.origin))),
      EfkPartial => row_read_allows(alloc_owner_row(OwnedByFn(e.origin))),
      EfkArm(_, hname) => row_read_allows(alloc_handler_row(hname)),
      EfkInit(_) => true,
      EfkThunk => false,
      EfkK => false,
    },
  },
}

// Whether a unit's allocations need no report: its row says `Alloc`, or a
// grant stands where a row would.
fn alloc_unit_allows(unit) = match unit {
  AllocUnit(u) => row_read_allows(u.row),
}

// A construct in UNIT builds: true, and refused at the construct when the
// unit's row does not say `Alloc`. The site is named only for the refusal.
fn alloc_at(unit, h, site) = alloc_unit_allows(unit) || alloc_refuse(unit, h, site)

fn alloc_refuse(unit, h, site) = {
  match unit {
    AllocUnit(u) => report_at(
      h,
      EInternalInvariant(
        "{alloc_site_text(site)} allocates in `{u.names}`, {alloc_row_text(u.row)} — a construct the judgment never charged",
        parse_span_of(h)
      )
    ),
  }
  true
}

// A wide argument boxed into a callee's word slot builds a cell, and the
// cost is the slot's, not the program's: the callee's slot is sized for a
// word (a list primitive's element, `list_set`), so the box is the
// representation's until the slot takes the value's own width
// (Hβ.value.seq-element-stride-carrier). Narrated where the unit's row is
// silent, never refused; recorded as built either way.
fn alloc_boxed(unit, h, cname: String) = {
  if alloc_unit_allows(unit) {
    ()
  } else {
    match unit {
      AllocUnit(u) => report_at(h, TWordSlotBox("a wide argument to `{cname}`", u.names, parse_span_of(h))),
    }
  }
  true
}

fn alloc_row_text(r) = match r {
  RowOf(row, _) => "whose row `{show_effrow(row)}` does not say `Alloc`",
  RowAbsent(why) => "where {why}",
  RowGranted(why) => "where {why}",
}

fn alloc_site_text(s) = match s {
  AsClosure => "a closure record",
  AsShow => "a show",
  AsConcat => "a concatenation",
  AsCall(callee) => "a call to `{callee}`, whose row says `Alloc`,",
  AsList => "a list",
  AsTuple => "a tuple",
  AsRecord => "a record",
  AsVariant => "a variant",
  AsListRest => "a list pattern's rest",
  AsRecordRest => "a record pattern's rest",
  AsInstall => "an install's record",
  AsArena => "an arena's exit, which moves what survives,",
  AsAllocation => "an allocation",
  AsSpawn => "a spawned task's record",
  AsStateCell => "a handler state's cell",
}

// A unit's body walked, and its verdict recorded once, when the walk leaves.
fn alloc_walk_unit(unit, body) = match unit {
  AllocUnit(u) => alloc_unit_done(u.sym, alloc_walk_list(unit, body, 0)),
}

// Every node is walked, whatever an earlier one answered: each unrowed
// construct is its own report, and every nested unit its own verdict.
fn alloc_walk_list(unit, xs, i) = if i >= len(xs) {
  false
} else {
  let here = alloc_walk(unit, list_index(xs, i))
  let later = alloc_walk_list(unit, xs, i + 1)
  here || later
}

// One node: whether what its own emission builds, or anything below it in the
// same unit, allocates — each construct refused where its unit's row is
// silent. EXHAUSTIVE over LowExpr, so a new construct is a decision here
// before it is a byte. A nested unit's body answers for itself; the parent
// pays only for the record that mints it.
fn alloc_walk(unit, e) = match e {
  LMakeClosure(h, LFn(name, _, _, body, _, _), caps) => {
    let built = alloc_at(unit, h, AsClosure)
    let below = alloc_walk_list(unit, caps, 0)
    alloc_walk_nested(unit, name, body)
    built || below
  },
  LMakeContinuation(_, LFn(name, _, _, body, _, _), caps, _, _) => {
    // the remainder record: the op's cost, recorded and never refused here
    let built = true
    let below = alloc_walk_list(unit, caps, 0)
    alloc_walk_nested(unit, name, body)
    built || below
  },
  LDeclareFn(LFn(name, _, _, body, _, _)) => {
    alloc_walk_nested(unit, name, body)
    false
  },
  LShow(h, x) => // an aggregate's show is the generated leaf, which builds its string
  if spec_is_agg(show_hash_ty(x)) {
    let built = alloc_at(unit, h, AsShow)
    let below = alloc_walk(unit, x)
    built || below
  } else {
    alloc_walk(unit, show_node_of(h, x))
  },
  LHash(h, x) => if hash_is_agg(show_hash_ty(x)) {
    alloc_walk(unit, x)
  } else {
    alloc_walk(unit, hash_node_of(h, x))
  },
  LBinOp(h, op, l, r) => {
    let built = match op {
      BConcat => alloc_concat_builds() && alloc_at(unit, h, AsConcat),
      _ => false,
    }
    let left = alloc_walk(unit, l)
    let right = alloc_walk(unit, r)
    built || left || right
  },
  LDirectCall(h, fh, cname, _, args) => {
    let spill =
      alloc_args_may_spill(args, 0) && alloc_direct_spills(fh, cname, args) && alloc_boxed(unit, h, cname)
    let call =
      alloc_callee_builds(cname) && (alloc_unit_allows(unit) || alloc_refuse(unit, h, AsCall(cname)))
    let below = alloc_walk_list(unit, args, 0)
    spill || call || below
  },
  LCall(_, f, args) => {
    let callee = alloc_walk(unit, f)
    let below = alloc_walk_list(unit, args, 0)
    callee || below
  },
  LTailCall(_, f, args) => {
    let callee = alloc_walk(unit, f)
    let below = alloc_walk_list(unit, args, 0)
    callee || below
  },
  LYield(_, op, args, k) => {
    // the argument record of a multi-shot perform: the op's cost, recorded
    let built = byte_len(op) > 0 && len(args) > 0
    let below = alloc_walk_list(unit, args, 0)
    let rest = alloc_walk(unit, k)
    built || below || rest
  },
  LKExtend(_, k) => {
    // the continuation's extension: the op's cost, recorded
    let built = true
    let below = alloc_walk(unit, k)
    built || below
  },
  LMakeList(h, es) => {
    let built =
      alloc_callee_builds(list_literal_callee(literal_stride_class(h))) && alloc_at(unit, h, AsList)
    let below = alloc_walk_list(unit, es, 0)
    built || below
  },
  LMakeTuple(h, es) => {
    let built = alloc_at(unit, h, AsTuple)
    let below = alloc_walk_list(unit, es, 0)
    built || below
  },
  LMakeRecord(h, fs) => {
    let built = alloc_at(unit, h, AsRecord)
    let below = alloc_walk_list(unit, fs, 0)
    built || below
  },
  LMakeVariant(h, _, fs) => {
    let built = len(fs) > 0 && alloc_at(unit, h, AsVariant)
    let below = alloc_walk_list(unit, fs, 0)
    built || below
  },
  LMatch(h, s, arms) => {
    let scrut = alloc_walk(unit, s)
    let below = alloc_walk_arms(unit, h, arms, 0)
    scrut || below
  },
  LResumeK(_, k, v) => {
    // a resumed value's cell at the word face: the op's cost, recorded
    let built = wide_ref_allocates(tail_expr_repr(v))
    let cont = alloc_walk(unit, k)
    let value = alloc_walk(unit, v)
    built || cont || value
  },
  LHandleWith(h, b, hn, _, inits, _) => {
    let built = alloc_at(unit, h, AsInstall)
    let config = alloc_walk_list(unit, inits, 0)
    let installed = alloc_walk(unit, hn)
    let body = alloc_walk(unit, b)
    built || config || installed || body
  },
  LPerform(_, disp, args) => {
    // an op's perform speaks its site's face and builds nothing; a driver
    // word-faces its arguments — the op's remainder cost, recorded
    let built = match disp {
      PdDriver(_, _) => alloc_args_may_spill(args, 0),
      PdFrame(_, _, _) => false,
      PdWalk(_, _, _, _) => false,
    }
    let below = alloc_walk_list(unit, args, 0)
    built || below
  },
  LWasiCall(h, op, args) => {
    let built = if op == "alloc" {
      alloc_at(unit, h, AsAllocation)
    } else if op == "spawn_task" {
      alloc_at(unit, h, AsSpawn)
    } else {
      false
    }
    let below = alloc_walk_list(unit, args, 0)
    built || below
  },
  LStateInit(h, _, _, v) => {
    let built = wide_ref_allocates(tail_expr_repr(v)) && alloc_at(unit, h, AsStateCell)
    let below = alloc_walk(unit, v)
    built || below
  },
  LFeedback(_, _, _, b, _) => // the recurrence's spec is a type the site reads, never constructed
  alloc_walk(unit, b),
  LDerive(_, seed, b) => {
    let s = alloc_walk(unit, seed)
    let body = alloc_walk(unit, b)
    s || body
  },
  LArena(h, b) => {
    let built = alloc_at(unit, h, AsArena)
    let body = alloc_walk(unit, b)
    built || body
  },
  LLet(_, _, inner) => alloc_walk(unit, inner),
  LUnaryOp(_, _, inner) => alloc_walk(unit, inner),
  LReturn(_, inner) => alloc_walk(unit, inner),
  LIf(_, c, t, f) => {
    let cond = alloc_walk(unit, c)
    let yes = alloc_walk_list(unit, t, 0)
    let no = alloc_walk_list(unit, f, 0)
    cond || yes || no
  },
  LBlock(_, stmts) => alloc_walk_list(unit, stmts, 0),
  LSimdLanes(_, lanes) => alloc_walk_list(unit, lanes, 0),
  LFanout(_, lex, _, forms) => alloc_walk(unit, fanout_form(lex, forms)),
  LFieldLoad(_, rec, _) => alloc_walk(unit, rec),
  LConvert(_, _, operand) => alloc_walk(unit, operand),
  LStateSlotStore(_, _, v, record) => {
    let r = alloc_walk(unit, record)
    let value = alloc_walk(unit, v)
    r || value
  },
  LConst(_, _) => false,
  LLocal(_, _) => false,
  LGlobal(_, _) => false,
  LUpval(_, _) => false,
  LFeedbackPrior(_) => false,
  LInvariantFailure(_, _) => false,
}

fn alloc_walk_arms(unit, h, arms, i) = if i >= len(arms) {
  false
} else {
  match list_index(arms, i) {
    (p, body) => {
      let pat = alloc_pat(unit, h, p)
      let arm = alloc_walk(unit, body)
      let later = alloc_walk_arms(unit, h, arms, i + 1)
      pat || arm || later
    },
  }
}

// A pattern builds where it binds a rest: a list's rest is a slice the
// runtime cuts (`$slice`), a record's rest a record of the fields left.
fn alloc_pat(unit, h, p) = match p {
  LPList(_, subs, rest, _) => {
    let built =
      rest_binds(rest) && alloc_callee_builds(list_rest_callee()) && alloc_at(unit, h, AsListRest)
    alloc_pats(unit, h, subs, 0) || built
  },
  LPRecord(rh, _, fbs, rest) => {
    let built = rest_binds(rest) && alloc_at(unit, rh, AsRecordRest)
    alloc_pat_fields(unit, h, fbs, 0) || built
  },
  LPCon(_, _, pairs) => alloc_pat_pairs(unit, h, pairs, 0),
  LPTuple(elems) => alloc_pat_pairs(unit, h, elems, 0),
  LPAs(_, inner) => alloc_pat(unit, h, inner),
  LPAlt(branches) => alloc_pats(unit, h, branches, 0),
  LPUnresolvedCon(_, subs) => alloc_pats(unit, h, subs, 0),
  LPVar(_) => false,
  LPWild => false,
  LPLit(_) => false,
}

fn alloc_pats(unit, h, ps, i) = if i >= len(ps) {
  false
} else {
  let here = alloc_pat(unit, h, list_index(ps, i))
  let later = alloc_pats(unit, h, ps, i + 1)
  here || later
}

// The sub-patterns of a positional product — a constructor's payload or a
// tuple's elements, each beside the type it was proved at — read in place.
fn alloc_pat_pairs(unit, h, pairs, i) = if i >= len(pairs) {
  false
} else {
  let here = alloc_pat(unit, h, pair_pat(list_index(pairs, i)))
  let later = alloc_pat_pairs(unit, h, pairs, i + 1)
  here || later
}

// A record pattern's fields, each beside its name, read in place.
fn alloc_pat_fields(unit, h, fbs, i) = if i >= len(fbs) {
  false
} else {
  let here = alloc_pat(unit, h, pair_pat(list_index(fbs, i)))
  let later = alloc_pat_fields(unit, h, fbs, i + 1)
  here || later
}

// Whether any argument's word face would be a fresh cell — the cheap read a
// call makes before it asks what its callee's face declares.
fn alloc_args_may_spill(args, i) =
  i < len(args) && (wide_ref_allocates(tail_expr_repr(list_index(args, i))) || alloc_args_may_spill(args, i + 1))

// Whether a direct call spills: the face the emission reads for it
// (`direct_callee_widths`, at the twin the site names).
fn alloc_direct_spills(fh, cname: String, args) = match direct_callee_widths(spec_call_name(fh, cname), len(args)) {
  (declared, _) => args_spill_at(declared, args, 0),
}

// Whether a call spills a wide argument: a slot the callee's face declares a
// word, filled by a value whose word face is a fresh cell (`emit_wide_ref`).
fn args_spill_at(declared, args, i) = if i >= len(args) {
  false
} else {
  let want = if i < len(declared) { list_index(declared, i) } else { RI32 }
  !repr_is_wide(want) && wide_ref_allocates(tail_expr_repr(list_index(args, i))) || args_spill_at(declared, args, i + 1)
}

// The reach whole: the accepted twin demands, each decl's liveness by
// source index, and whether the module is settled — an executable is, a
// library's whole-emit is not (no caller reaches its floors).
fn emit_reach(program, recs) = {
  let n = len(program)
  let keys = emit_keys(program, 0, n, smap_new())
  let library = match smap_get(keys, "main") {
    Some(_) => false,
    None => true,
  }
  match emit_reach_roots(program, library, 0, n, list_filled(n, Unreached), []) {
    (live0, root_refs) => {
      let argv = if main_param_count() > 0 { ["wasi_args"] } else { [] }
      let entry = if library { [] } else { map(demand_base, ["main"] ++ emit_runtime_contract() ++ argv) }
      match emit_reach_fix(
        entry ++ map(ref_demand([], ??), root_refs),
        (make_list(64), 0, smap_new(), live0, false),
        program,
        keys,
        recs,
        !library
      ) {
        (dbuf, dn, _seen, live, _wide) => (slice(dbuf, 0, dn), live, !library),
      }
    },
  }
}

// The entries of XS whose decl a live reference reaches, in source order —
// XS is the program or anything indexed by it (each decl's records).
fn decls_reached(xs, live, i, n, out, k) = if i >= n {
  slice(out, 0, k)
} else {
  match list_index(live, i) {
    Reached => decls_reached(xs, live, i + 1, n, list_set(list_extend_to(out, k + 1), k, list_index(xs, i)), k + 1),
    Unreached => decls_reached(xs, live, i + 1, n, out, k),
  }
}

// The unreached decls a live twin copies: a twin is emitted from its base's
// body, so a base the module does not emit still owes its twins the facts
// that body carries (`project_emit_state`).
fn twin_bases_where(program, decl_records, live, bases, i, n, out, k) = if i >= n {
  slice(out, 0, k)
} else {
  let copied = match list_index(live, i) {
    Unreached => any(record_named_in(bases, ??), list_index(decl_records, i)),
    Reached => false,
  }
  if copied {
    twin_bases_where(
      program,
      decl_records,
      live,
      bases,
      i + 1,
      n,
      list_set(list_extend_to(out, k + 1), k, list_index(program, i)),
      k + 1
    )
  } else {
    twin_bases_where(program, decl_records, live, bases, i + 1, n, out, k)
  }
}

fn demand_base_note(acc, d) = match d {
  (_m, base, _p, _e) => smap_add(acc, base, 1),
}

fn record_named_in(bases, rec) = match rec {
  (n, _ps, _b, _f) => match smap_get(bases, n) {
    Some(_) => true,
    None => false,
  },
}

// The accepted set grows at its count.
fn spec_demand_accept(acc, d) = match acc {
  (dbuf, dn) => (list_set(list_extend_to(dbuf, dn + 1), dn, d), dn + 1),
}

// The ONE selector→offset projection for the field-load emitter: a name
// resolves through the receiver's record type (resolve_field_offset —
// TRecord / TRecordOpen / the env's RecordSchemeKind); an index through the
// positional product's width-summed fold. Both read lookup_ty LIVE under the
// active bracket, so a twin's instantiation closes a generic receiver.
fn field_sel_offset(ref rec, sel) = match sel {
  FByName(fname) => resolve_field_offset(lexpr_handle(rec), fname),
  FByIndex(i) => match lookup_ty(lexpr_handle(rec)) {
    TTuple(elems) => tuple_elem_offset(elems, i, 0, 0),
    _ => -1,
  },
}

// A field load's WIDTH: its slot's in the receiver's layout, from the same
// fold as its offset — never the width of the node that asks. A record
// update's copy is a field load under the update's own handle, a whole
// record, so reading the asker made every copied field a word: `{...r, b: 9}`
// over `{a: 1.5, b: 7}` copied half of `a` and the construction placed `b`
// where the load of `s.b` did not look (2026-09-28). Where the receiver's
// layout is not whole the offset floors, and the width falls to the asker's
// type, which the floor's locals still declare at.
fn field_load_repr(h, rec, sel) = match field_sel_slot_ty(rec, sel) {
  Some(t) => slot_repr(t),
  None => repr_of(lookup_ty(h)),
}

fn field_sel_slot_ty(rec, sel) = match sel {
  FByName(fname) => match record_full_fields(lookup_ty(lexpr_handle(rec))) {
    Some(full) => match find(field_named(fname, ??), full) {
      Some(f) => match f {
        (_, t) => Some(t),
      },
      None => None,
    },
    None => None,
  },
  FByIndex(i) => match lookup_ty(lexpr_handle(rec)) {
    TTuple(elems) => if i < len(elems) { Some(list_index(elems, i)) } else { None },
    _ => None,
  },
}

// WHAT THE OFFSET READ COULD NOT PROVE, said at the site — the sibling of
// field_sel_offset over the same two operands: one answers the offset, this
// one answers why there was none. The floor used to write a bare marker, so
// every occurrence was countable and anonymous, and the row that blocked it
// had to be re-derived by hand at each dig (this arc did it four times). The
// selector and the receiver's own live type ARE the reason; reading them
// here is the projection the marker stood in for. An open row renders with
// its residual — `{ zeta: Int | { } }` is an empty remainder assumed rather
// than proven, which is the wrong-slot class stated in one line.
fn field_offset_unprovable_why(rec, sel) = match sel {
  FByName(fname) => "field '{fname}' on {show_type(lookup_ty(lexpr_handle(rec)))}",
  FByIndex(i) => "element {int_to_str(i)} on {show_type(lookup_ty(lexpr_handle(rec)))}",
}

// The two name projections the driver concats into the module's name surfaces.
// The declared [String] is the Intent Boundary the ++ sites read — without it
// the filter-with-handler-block chain left the element open and the concat
// emitted its unresolved-element floor (the 00c0b6 trap that caught this).
// A twin carries four facts — `{base, enc, pairs, rec}` — and the base is
// the one easy to lose: the BASE symbol it is a copy of, which is the name
// lower's enumeration entry was written under and therefore where its
// signature edges live. It was a positional quadruple while a record read
// through an unannotated parameter floored at the field offset; the record
// came back with the landing that armed that class, whose settle point would
// refuse the repin at any site that still floored.
fn spec_fold_collect(spec_recs, acc0) =
  fold(acc0, spec_bracketed(collect_fold_tys_list, ??, ??), spec_recs)

// The call vectors the same way: each twin's body walked under its own
// bracket, so a Float twin's closure call declares the f64 vector its site
// names — a vector the floor's walk never sees.
fn spec_vector_collect(spec_recs, acc0) =
  fold(acc0, spec_bracketed(collect_call_vectors_list, ??, ??), spec_recs)

// The derivative reading's programs walked for their call vectors — each
// extent's expansion and each twin under the bracket it emits under. A call
// through a function value under the reading names the derivative face's
// vector, a tangent slot after every Float, which the primal tree never
// wrote; the type section declares what these walks find.
fn derived_vector_collect(derived, acc0) = fold(
  fold(acc0, expansion_vectors, derived.expansions),
  spec_bracketed(collect_call_vectors_list, ??, ??),
  derived.twins
)

fn expansion_vectors(acc, x) = match x {
  Expansion(r) => {
    spec_ctx_set(r.pairs, r.enc)
    let acc2 = collect_call_vectors_expr(r.body, acc)
    spec_ctx_clear()
    acc2
  },
}

// One twin's body walked under its own specialization bracket — the one
// shape both collections above share.
fn spec_bracketed(walk, acc, tw) = match tw.rec {
  (_m, _ps, body, _f) => {
    spec_ctx_set(tw.pairs, tw.enc)
    let acc2 = walk(body, acc)
    spec_ctx_clear()
    acc2
  },
}

// Two demands can nest the SAME lambda under the SAME enc (two parents,
// one inner record, one instantiation) — the twin emits once; keep-first
// by mangled name, the emission seam's own dedup discipline, in ONE pass
// over a name map (the fn-record dedup's form; this one grew its keep-set
// by `acc ++ [rp]` and re-scanned it per record).
fn spec_recs_dedup(recs) = {
  let n = len(recs)
  spec_recs_dedup_flat(list_to_flat(recs), 0, n, make_list(n), 0, smap_new())
}

fn spec_recs_dedup_flat(recs, i, n, out, count, seen) = if i >= n {
  slice(out, 0, count)
} else {
  let rp = list_index(recs, i)
  let m = spec_rec_name(rp)
  match smap_get(seen, m) {
    Some(_) => spec_recs_dedup_flat(recs, i + 1, n, out, count, seen),
    None => spec_recs_dedup_flat(recs, i + 1, n, list_set(out, count, rp), count + 1, smap_add(seen, m, 1)),
  }
}

fn spec_rec_name(tw) -> String = match tw.rec {
  (m, _ps, _b, _f) => m,
}

fn spec_rec_names(spec_recs) -> [String] = map(spec_rec_name, spec_recs)

// A twin's nested record that landed on the floor is the base record; when
// the base is among the live records the module emits it already, so the
// entry drops rather than emitting the symbol twice.
fn spec_rec_wanted(fn_records, r) = if byte_len(r.enc) > 0 {
  true
} else {
  match spec_find_rec(fn_records, r.base) {
    None => true,
    Some(_) => false,
  }
}

// ─── THE SIGNATURE COLUMN's one write (lowering-is-a-column (ii)) ─────
//
// THE ONE DERIVATION of an emitted symbol's ABI. Every width in the module
// is decided HERE, once per symbol, and nowhere else: the header, the call
// sites, the word-face wrapper, and the local decls all READ the answer
// through graph_sig_at. Six derivations retired onto this one — and their
// six comments each already claimed the readers agreed ("one truth, two
// readers", "the one decider, two readers", "THE ONE SIGNATURE BOTH SIDES
// AGREE ON"). They were CONFESSIONS: the readers ran the same code, which
// is not the same as reading the same fact, and the difference is a real
// bug the march billed four times (three assembly REDs, then an f64.load
// on a caller that unboxed a result its callee returned wide). A fact
// derived twice is two facts that happen to match; a fact derived once is
// an ABI.
//
// The derivation itself reads the graph LIVE — a param's width is the repr
// of its proven type, the result's is the repr of the body's tail — and it
// runs at the SETTLING POINT, after inference is complete and inside each
// record's own twin bracket. That ordering is the whole content of the fix:
// the same live read at an unsettled moment (rung 3's live cells) or under
// the wrong bracket (module scope, for a body emitted under a twin's pairs)
// answers differently, and a contract may not be time-varying.
// The width of ONE signature slot: the enumeration's edge, projected. An
// ABSENT edge is the slot the graph never judged and takes the word floor
// honestly — a fabricated width here is the whole bug class. A present slot
// is a slot like any other (`slot_repr`): a var resolves through the
// bracket-aware chase, so a twin's body reads its OWN instantiation where the
// raw graph chase would floor it, and a ground type answers directly, which
// is the case a handle could never carry.
fn sig_repr_of_ty(slot) = match slot {
  None => RI32,
  Some(ty) => slot_repr(ty),
}

fn sig_slot_repr(slot) = match slot {
  (_n, t) => sig_repr_of_ty(t),
}

// The symbol's signature from the enumeration entry lower wrote — the fn's
// own inferred TFun, component by component. What this replaced was a body
// walk per parameter looking for a use-site, a name-search of the declared
// scheme when the walk missed, and a structural re-walk of the lowered tail
// for the result: three reconstructions of a vector the graph had stated and
// lower had already read.
fn emitted_sig_of_entry(e) = ESig(map(sig_slot_repr, e.params), sig_repr_of_ty(e.ret))

// An emitted symbol with no enumeration entry has no judged face — the
// all-word floor, at the arity the record itself declares. The column is a
// multi-map (a name re-noted across judgment rounds keeps every entry), and
// `last` is the FIRST-noted of them: smap_add prepends, so the bucket runs
// newest-first and the oldest entry is the construction the emission walks.
fn emitted_sig_of_symbol(name: String, arity) = match graph_emitfn_at(name) {
  [] => ESig(map((_) => RI32, range(0, arity)), RI32),
  entries => emitted_sig_of_entry(last(entries)),
}

fn emitted_sig_of_record(record) = match record {
  (name, param_names, _b, _f) => emitted_sig_of_symbol(name, len(param_names)),
}

// A symbol whose native face carries any wide slot reaches the fn table
// through its $wf$ word wrapper. Wideness is a PROJECTION of the signature,
// never a second walk of the body.
fn sig_is_wide(s) = match s {
  ESig(ps, r) => repr_is_wide(r) || any(repr_is_wide, ps),
}

// The emitted symbol's settled face, read at any of the four reader sites.
// A miss is the word floor — the pre-direct protocol, sound by the word
// contract and now taken at ONE key, so caller and callee floor together
// or not at all.
fn sig_of_symbol(name: String, arity) = match graph_sig_at(name) {
  Some(s) => match s {
    ESig(ps, r) => if len(ps) == arity { (ps, r) } else { sig_floor(arity) },
  },
  None => sig_floor(arity),
}

fn sig_floor(arity) = (map((_) => RI32, range(0, arity)), RI32)

// The base records' pairs — derived at the floor bracket, which is the
// bracket their bodies emit under.
fn emit_sig_pairs_base(fn_records) = map(emit_sig_pair_of_record, fn_records)

fn emit_sig_pair_of_record(r) = match r {
  (name, _ps, _b, _f) => (name, emitted_sig_of_record(r)),
}

// A twin's pairs — derived INSIDE the instantiation bracket its body will
// be emitted under, so the stored face is the one the body actually signs.
// The caller's `spec_subst_pairs(declared, spec_site_pairs(fh, cname))`
// re-derivation of this exact substitution is what the column deletes.
fn emit_sig_pairs_spec(spec_recs) = map(emit_sig_pair_of_twin, spec_recs)

// A twin is the BASE's body renamed, so its edges are the BASE's enumeration
// entry — read under the twin's own bracket, which is what makes its
// `a := Float` a native f64 slot where the floor copy signs a word. Keyed
// under the MANGLED name, because that is the symbol the header writes and
// the call sites name.
fn emit_sig_pair_of_twin(tw) = match tw.rec {
  (m, ps, _b, _f) => {
    spec_ctx_set(tw.pairs, tw.enc)
    let s = emitted_sig_of_symbol(tw.base, len(ps))
    spec_ctx_clear()
    (m, s)
  },
}

// A derivative twin's face: its body's face read under the body's bracket,
// with a tangent slot — always f64 — after every parameter the key marks
// active. The body's enumeration entry is keyed by its FACE symbol (the base
// name for a monomorphic twin), which is why the record carries it.
fn jvp_rec_name(jr) = match jr.rec {
  (m, _ps, _b, _f) => m,
}

fn emit_sig_pair_of_jvp(jr) = match jr.rec {
  (m, _ps, _b, _f) => {
    spec_ctx_set(jr.pairs, jr.enc)
    let s = emitted_sig_of_symbol(jr.face, byte_len(jr.key))
    spec_ctx_clear()
    (m, if jr.vjp { vjp_sig(s) } else { jvp_sig(s, jr.key) })
  },
}

fn jvp_sig(s, key: String) = match s {
  ESig(ps, r) => ESig(enumerate(ps) |> flat_map(jvp_slot(key, ??)), r),
}

// An adjoint twin's face: the callee's parameters and the adjoint of its
// result, an f64; its own result is a word, since the adjoints it answers
// leave through the registers.
fn vjp_sig(s) = match s {
  ESig(ps, _r) => ESig(ps ++ [RF64], RI32),
}

// A twin's parameter slot: an active parameter (an `a` in the key) carries its
// tangent beside it, as an f64.
fn jvp_slot(key: String, slot) = match slot {
  (i, p) => if field_name_eq(str_slice(key, i, i + 1), "a") { [p, RF64] } else { [p] },
}

// A derivative twin emits as its body would, standing at the body's symbol:
// its static `<~` lines are that symbol's lines, and the tangent rings
// beside them are named by it too.
fn emit_jvp_twin(jr) = {
  spec_ctx_set(jr.pairs, jr.enc)
  let m = heap_mark()
  wat_emit(emit_twin_to_string(jr.rec, jr.sym))
  wat_emit(if fn_record_is_wide(jr.rec) { emit_one_wrapper_to_string(jr.rec) } else { "" })
  heap_reset(m)
  spec_ctx_clear()
}

fn emit_twin_to_string(record, site: String) = match record {
  (name, param_names, body, captures_count) => {
    emit_fn_body(name, param_names, body, captures_count)
    wat_collect()
  } ~> emit_site_named(site) ~> emit_memory_bump ~> wat_to_string,
}

// A `<~` line's TANGENT ring under the derivative reading: the same geometry
// as the line at f64 slots, indexed by the line's own head, one per (site,
// owner) — allocated at instance start beside the line, zeroed where a
// reading opens.
fn tline_global_name(h: Int, owner: String) = "__tline_{int_to_str(h)}_{owner}"

fn tangent_ring_slots(rings) = map(tangent_ring_slot, rings)

fn tangent_ring_slot(ring) = match ring {
  TangentRing(r) => (tline_global_name(r.site, r.owner), "i32"),
}

fn emit_tangent_ring_globals(rings) = each(
  {
    (name, rw) => {
      wat_emit("  (global $")
      wat_emit(name)
      wat_emit(" (mut ")
      wat_emit(rw)
      wat_emit(") (")
      wat_emit(rw)
      wat_emit(".const 0))\n")
    },
  },
  tangent_ring_slots(rings)
)

// The wideness predicate's ONE spelling — the column read, projected. An
// unpublished or hand-written symbol is not wide: the word floor has no
// wide slot to wrap.
fn symbol_is_wide(name: String) = match graph_sig_at(name) {
  Some(s) => sig_is_wide(s),
  None => false,
}

fn sig_wide_names(names) = filter(symbol_is_wide, names)

// ─── THE PLAN — every decision the module's bytes read, made before one ───
//
// The module is decided whole before a byte of it is written: the emitted
// reach and the settle point it carries, the twins and their brackets, the
// settled signatures, the fold closures, the emit-state projections, the
// line owners, the drivers and the call vectors. So what the gate reads is
// everything the emit could say, and a refusal leaves stdout empty (the
// pipeline's gate, downstream of this file); `emit_planned` then only
// writes. The name collisions the record dedup finds and the inits the
// preinstall scope judges are said here too, where a refusal can still mean
// zero bytes.
// ─── THE RACE RULE THROUGH A CALLEE (B4, 2026-09-30) ─────────────────
//
// B1's rule reads a fanout at ITS OWN frame (`threaded_branch_check`,
// lower.mn): every effect a branch's row carries must reach, before the
// frame fence, a handler that writes no state. A schedule that reaches a
// callee's fanout by DEMAND (`spec_call_name`) crosses that fence through a
// direct call, so the rule is read the same way along the demand: from
// each direct call standing under a spawning install in a base unit, into
// the callee, through its own frame's installs, into every fanning callee
// it calls directly — each fanout's branch rows checked against the
// installs between it and the demanding site, innermost last. A branch
// whose row is a PARAMETER's is read at the instantiating site: the site's
// argument rows pair the callee's row cells (`row_pairs_at`), composed
// along the chain, so `fn tally(f) = (f()) >< (f())` called with a callback
// that bumps a stateful counter refuses where the lexical rule read a free
// row. Reported at the settle point, before the gate reads the ledger; a
// fanout whose own frame installs its schedule was judged at lower and is
// not read again here. A demanded twin's body is scanned ONCE per mangled
// name by the reach, which is why this walk runs from the demanding SITE
// and carries the site's own installs: two sites demanding one twin under
// different installs are two verdicts.
//
// A demand chain starts at a site the lowering noted under a spawning
// schedule; a module with none has no chain to walk and pays nothing for
// the rule's existence — the absence is read, never searched for.
fn race_check_demands(fn_records, all_records) =
  if threaded_site_noted() { each(race_check_record(all_records), fn_records) } else { () }

fn race_check_record(recs, rec) = match rec {
  (_name, _params, body, _f) => race_scan_list(body, [], recs),
}

// A base unit's body, with the installs enclosing each node (the stack's
// own order, innermost last). A closure's body is another frame; its
// captures are this one's.
fn race_scan_list(stmts, path, recs) = each(race_scan(path, recs), stmts)

fn race_scan(path, recs, e) = match e {
  LHandleWith(ih, b, hn, hname, inits, _arms) => {
    race_scan(path, recs, hn)
    race_scan_list(inits, path, recs)
    race_scan(path ++ [{handle: ih, name: hname, proj: projection_of(hname)}], recs, b)
  },
  LDirectCall(_h, fh, n, _t, args) => {
    if schedule_demands(path) && fanout_reach_known(n) {
      race_check_reach(n, path, row_pairs_at(fh, n), [n], recs)
    } else {
      ()
    }
    race_scan_list(args, path, recs)
  },
  LDeclareFn(_) => (),
  other => race_scan_list(frame_children(other), path, recs),
}

// A path demands a callee's schedule twin when its innermost schedule
// spawns: a Thread-class install whose arms perform the substrate's spawn.
// The persisting schedule runs its branches inline and races nothing.
fn schedule_demands(path) = match schedule_in_stack(path) {
  Threaded => schedule_spawns(path),
  _ => false,
}

// The demand walk into one callee under the demanding site's path.
fn race_check_reach(name: String, ctx, rowpairs, visited, recs) = match spec_find_rec(recs, name) {
  None => (),
  Some(rec) => match rec {
    (_n, _ps, body, _f) => race_body_list(body, [], ctx, rowpairs, visited, recs),
  },
}

fn race_body_list(stmts, local, ctx, rowpairs, visited, recs) =
  each(race_body(local, ctx, rowpairs, visited, recs), stmts)

fn race_body(local, ctx, rowpairs, visited, recs, e) = match e {
  LHandleWith(ih, b, hn, hname, inits, _arms) => {
    race_body(local, ctx, rowpairs, visited, recs, hn)
    race_body_list(inits, local, ctx, rowpairs, visited, recs)
    race_body(
      local ++ [{handle: ih, name: hname, proj: projection_of(hname)}],
      ctx,
      rowpairs,
      visited,
      recs,
      b
    )
  },
  LFanout(h, lex, br, _forms) => match lex {
    None => // the demanded form runs here: the site's own frame installs nothing,
    // and the chain a spawned branch walks is the callee's local installs
    // (innermost) on top of the demanding site's
    race_fanout(h, br, ctx ++ local, rowpairs),
    Some(_) => (),
  },
  LDirectCall(_h, fh, n, _t, args) => {
    if fanout_reach_known(n) && !string_in_list(visited, n) {
      race_check_reach(n, ctx ++ local, row_pairs_at(fh, n) ++ rowpairs, visited ++ [n], recs)
    } else {
      ()
    }
    race_body_list(args, local, ctx, rowpairs, visited, recs)
  },
  LDeclareFn(_) => (),
  other => race_body_list(frame_children(other), local, ctx, rowpairs, visited, recs),
}

// One demanded fanout's branches against the chain: each branch's row,
// read under the site's row pairs, one effect at a time through the same
// walk the lexical rule takes.
fn race_fanout(h, br, stack, rowpairs) = match br {
  FanBranches(bs) => each(race_branch(stack, rowpairs), bs),
  FanSeq(f_h) => match lookup_ty(f_h) {
    TFun(_, _, row) => each(threaded_effect_check(h, stack, ""), row_effects_under(row, rowpairs)),
    _ => (),
  },
}

fn race_branch(stack, rowpairs, b) = match b {
  ScheduledBoundary(thunk, _, _, _, _, branch_h) => match executable_boundary_row(lexpr_handle(thunk)) {
    Ok(row) => each(threaded_effect_check(branch_h, stack, ""), row_effects_under(row, rowpairs)),
    Err(_) => (),
  },
  InvalidScheduledBoundary(_, _) => (),
}

// THE ROW PAIRS OF A SITE: each row cell the callee's scheme quantifies at
// a function-typed position, paired with the row the site instantiated it
// at — the argument's own row, resolved. The scheme's row cells are the
// callee's parameters' cells, which is what a branch's row inside the
// callee chases to.
fn row_pairs_at(fh, name: String) = match fn_judgment(name) {
  None => [],
  Some(j) => match j {
    (_qs, sty) => row_pairs_walk(sty, spec_resolve(lookup_ty(fh)), []),
  },
}

fn row_pairs_walk(st0, it0, acc) = match fold_strip(st0) {
  TVar(v) => match graph_chase(v) {
    GNode(NBound(inner), _) => row_pairs_walk(inner, it0, acc),
    _ => acc,
  },
  TFun(ps, r, srow) => match fold_strip(it0) {
    TFun(ips, ir, irow) => row_pairs_params(ps, ips, row_pairs_walk(r, ir, row_pair_add(acc, srow, irow))),
    _ => acc,
  },
  TList(e) => match fold_strip(it0) {
    TList(ie) => row_pairs_walk(e, ie, acc),
    _ => acc,
  },
  TTuple(es) => match fold_strip(it0) {
    TTuple(ies) => row_pairs_list(es, ies, acc),
    _ => acc,
  },
  TName(_, args) => match fold_strip(it0) {
    TName(_, iargs) => row_pairs_list(args, iargs, acc),
    _ => acc,
  },
  _ => acc,
}

fn row_pairs_list(xs, ys, acc) = match xs {
  [] => acc,
  [x, ...rest] => match ys {
    [] => acc,
    [y, ...yrest] => row_pairs_list(rest, yrest, row_pairs_walk(x, y, acc)),
  },
}

fn row_pairs_params(ps, ips, acc) = match ps {
  [] => acc,
  [p, ...rest] => match ips {
    [] => acc,
    [ip, ...irest] => row_pairs_params(rest, irest, row_pairs_walk(param_ty(p), param_ty(ip), acc)),
  },
}

// Each free cell of the scheme's row pairs with the whole site row.
fn row_pair_add(acc, srow, irow) = match resolve_row(srow) {
  EfRow(_, _, EtOpen(edges)) => fold(acc, row_pair_edge(resolve_row(irow)), edges),
  _ => acc,
}

fn row_pair_edge(site_row, acc, e) = push(acc, (graph_chase_handle(edge_cell(e)), site_row))

// The effects a row carries, its free cells read through the pairs: the
// row's own names, then for each unbound edge the paired row's names
// (themselves read through the pairs, an outer site's for an inner cell)
// minus the edge's mask.
fn row_effects_under(row, rowpairs) = match resolve_row(row) {
  EfRow(_, _, t) => match t {
    EtOpen(edges) => fold(effects_of_row(row), row_edge_under(rowpairs), edges),
    _ => effects_of_row(row),
  },
}

fn row_edge_under(rowpairs, acc, e) = match row_pair_find(rowpairs, graph_chase_handle(edge_cell(e))) {
  None => acc,
  Some(paired) => fold(acc, names_add, name_strs_minus(row_effects_under(paired, rowpairs), edge_mask(e))),
}

fn row_pair_find(rowpairs, cell) = match rowpairs {
  [] => None,
  [(c, r), ...rest] => if c == cell { Some(r) } else { row_pair_find(rest, cell) },
}

fn names_add(acc, n: String) = if string_in_list(acc, n) { acc } else { push(acc, n) }

fn name_strs_minus(names, mask) = filter({ n => !any(eff_name_is(n), mask) }, names)

// The plan's own mark beside the compile's phase lines (`heap_line`,
// pipeline.mn): the emitted reach is the plan's largest step — 73 of its
// 111 MB on the wheel, 2026-09-30 — and the step whose growth a per-step
// walk of the plan found when the cost ratchet refused a landing 22 MB
// heavier at every other step's size, so it stands as a line of its own.
fn reach_heap_line() = match diag_scope_of() {
  ScopeAll => eprint_string("heap: {int_to_str(heap_mark())} byte(s) when the emitted reach settles\n"),
  ScopeNone => (),
  ScopeModule(_) => (),
}

fn emit_plan(program) = {
  // Every record lower constructed, per decl, collected ONCE: a twin is a
  // copy of one of these, so a base the module does not emit is still where
  // its twins' bodies live, and the records the module emits are the live
  // decls' own (emit_functions and the wrapper/table wideness read that one
  // set — never two walks of one tree). A fn whose native signature carries
  // a wide slot reaches the table through its $wf$ word wrapper; the elem
  // substitution below is that law's one write.
  let decl_records = map(collect_fn_emit_records_expr, program)
  // FLAT, because every twin demand scans it (`spec_find_rec`), and a scan
  // materializes a concat tree into a fresh buffer each time (`iterate`'s
  // list_to_flat) — measured 2026-09-28: a flatten-only form cost the m3
  // leg +70MB.
  let all_records = flatten(decl_records) |> dedup_fn_records
  let n = len(program)
  // The emitted reach (above): the twin demands, and which decls a live
  // reference reaches — the only ones emitted below.
  match emit_reach(program, all_records) {
    (spec_demands, live, settles) => {
      reach_heap_line()
      // Every name a twin was demanded of — the unreached decls whose bodies
      // still feed their twins, and the arms a keyed install runs twinned.
      let twin_base_set = fold(smap_new(), demand_base_note, spec_demands)
      plan_reached(
        decls_reached(program, live, 0, n, make_list(n), 0),
        decls_reached(decl_records, live, 0, n, make_list(n), 0) |> flatten |> dedup_fn_records,
        twin_bases_where(program, decl_records, live, twin_base_set, 0, n, make_list(8), 0),
        all_records,
        spec_demands,
        twin_base_set,
        settles
      )
    },
  }
}

fn plan_reached(lowered, fn_records, twin_bases, all_records, spec_demands, twin_base_set, settles) = {
  // Named-generic twins (the emitted reach above): each demand's record is
  // the BASE record renamed — the same body, emitted under the spec_pairs
  // state so every repr read resolves through the site's instantiation.
  // Registered before any reference emits (spec_target_name reads the
  // registry live); a program with no wide instantiation computes [] and
  // every list below is untouched (Law 7 byte-identical). Each demand
  // contributes its OWN record plus every record NESTED in its body (a
  // lambda born inside a generic inherits the parent's vars, so it twins
  // under the same instantiation — the closure-mint arm redirects to the
  // nested twin via the active enc, no body rewriting). Names derive from
  // the FULL rec set so nested twins ride the table/idx/closure surfaces.
  let spec_recs = flatten(map(
    {
      (m, base, pairs, enc) => match spec_find_rec(all_records, base) {
        Some(rec) => match rec {
          (_n, ps, body, f) => [{base: base, enc: enc, pairs: pairs, rec: (m, ps, body, f)}] ++ map(
            {
              (nn, nps, nbody, nf) => // A nested record takes the schedule only where it cannot
              // outlive the install (`nested_twin`): a branch thunk does, a
              // lambda keeps the instantiation alone — and at the floor it
              // is the base lambda itself, under the floor bracket.
              {
                let t = nested_twin(nn, enc)
                {
                  base: nn,
                  enc: t.enc,
                  pairs: if byte_len(t.enc) == 0 { [] } else { pairs },
                  rec: (t.sym, nps, nbody, nf),
                }
              },
            },
            collect_fn_emit_records(body)
          ),
        },
        None => // record-less names are never worthy; unreachable by construction
        [],
      },
    },
    spec_demands
  )) |> spec_recs_dedup |> filter(spec_rec_wanted(fn_records, ??))
  let spec_names = spec_rec_names(spec_recs)
  set_spec_twins(spec_names)
  // THE DERIVATIVE READING settles here too (src/derive.mn): its programs
  // read each body under the bracket the demand analysis just fixed, its
  // twins' faces join the column below, and a derivative it cannot carry
  // refuses before a byte of the module is written. A program with no
  // reading derives nothing and every list below is untouched (Law 7) —
  // and it never looks for one: lower recorded the demand where it built
  // an LDerive, so the absence is read, not searched for.
  let derived = if derivative_demanded() {
    derive_program(fn_records, spec_recs, collect_top_value_lets(lowered))
  } else {
    derived_none()
  }
  set_derived(derived.expansions)
  set_arm_faces(derived.arm_faces)
  let jvp_recs = derived.twins
  let jvp_names = map(jvp_rec_name, jvp_recs)
  // THE SETTLING POINT. Every symbol the module will emit is known here —
  // the base records and every twin with the bracket it emits under — and
  // inference is complete, so a width read now cannot move again. One
  // derivation per symbol, one write of the whole table; from this line on
  // the ABI is a fact to READ, and the emitter has no second opinion to
  // offer. This is the infer->lower/emit boundary graph_bind_row's own
  // comment names as "the freeze that makes lattice reads sound", reached
  // at the emit altitude: reading a settled fact after inference completes
  // is a read, not a snapshot.
  // THE COLUMN IS COMPLETE — every emitted symbol gets a stated face, not
  // only the ones departing from the word floor. A sparse form was BUILT on
  // the reasoning that a miss and an all-word entry answer identically, so
  // storing the second stores the default; its measured cost came back
  // INSIDE THE NOISE (three m3 legs on one fixed binary and one fixed input
  // span 2321788..2324148 KB, and the sparse/complete gap was smaller than
  // that), so the bytes decide nothing here and the first reading of them
  // that said otherwise is retracted. The contract decides: ONE rule, "read
  // the symbol's face", with no second rule about what absence means for
  // every reader to learn.
  graph_sigs_publish(emit_sig_pairs_base(fn_records) ++ emit_sig_pairs_spec(spec_recs) ++ map(emit_sig_pair_of_jvp, jvp_recs))
  // THE ALLOCATION AUDIT reads here, where a spill is a fact (`alloc_audit`):
  // what every emitted unit's code builds, against the row its code answers
  // to, said before the gate reads the ledger.
  // THE RACE RULE THROUGH A CALLEE reads here too (`race_check_demands`):
  // every direct call a spawning install reaches, walked into its callee's
  // fanouts with the site's installs and row pairs, said before the gate.
  if settles { race_check_demands(fn_records, all_records) } else { () }
  let alloc_units = if settles { Some(alloc_audit(lowered, spec_demands, all_records)) } else { None }
  let wide_fn_names = sig_wide_names(map({ (nm, _, _, _) => nm }, fn_records))
  let spec_wide = sig_wide_names(spec_names)
  let jvp_wide = sig_wide_names(jvp_names)
  // The fold-leaf collection — the base tree once, then each twin's body
  // under its own bracket, so a twin's show/hash on substituted types
  // collects the sigs its emission will name (the float-element leaf beside
  // the floor's word-element leaf — both generated, each named where used).
  let fold_closures =
    spec_fold_collect(spec_recs, collect_fold_tys_list(lowered, fold_closures_empty()))
  // Single-walk multi-projection pre-pass. project_emit_state walks the
  // LowExpr tree ONCE; four visitor-handlers chained via `~>` accumulate
  // their projections in encounter order; the wrapper drains all four at
  // the end and returns a 4-tuple. Per Hβ.emit.consolidate-pre-pass-walks
  // (2026-05-11): replaces the prior `<|` fan-out (four parallel walks
  // of the same tree, 16+ helper fns, 4x the structural drift surface).
  // Adding a fifth projection = one new handler + one new visit-site in
  // walk_lemit_expr. The graph IS the index; the chain IS the projector.
  // The fold's type-closure record — computed ONCE (the unified each);
  // register_show_literals (inside project_emit_state) reads .show for the
  // data section, the leaf emission below reads all four.
  // (fold collection moved below the spec demand analysis — a twin's body is
  // re-collected under its bracket so its substituted aggregate sigs exist)
  match project_emit_state(lowered, twin_bases, fold_closures) {
    (all_fn_names, top_fn_names, string_entries, fn_lines, wasi_ops, yield_seen) => {
      // band B M1.2 (the k2/k3 bank, Ruling 1) — the composer is CALLED INDIRECT
      // (it is the fn_ptr@0 of every composed k record), so unlike every other
      // synthesized helper it is TABLE-RESIDENT: appended to the fn-name set
      // (existing indices stable) and given $__k_compose_idx by the same
      // index-global projection every closure mint reads. Yield-gated — a
      // OneShot-only module's table is byte-identical (Law 7).
      //
      // drift-audit: ignore — one-time module-scope append, not a loop accumulator
      // W5 string interning — seed the string_table handler so downstream
      // LString emits can look up the offset via perform string_offset.
      let table_fn_names = if yield_seen > 0 { all_fn_names ++ ["__k_compose"] } else { all_fn_names }
      set_string_entries(string_entries)
      // The per-fn `<~` line lists, seeded for the install emit (a handler
      // record is sized by the sum over its arm fns) and read here for the
      // static owners: top-level fns and their twins, whose lines ride
      // instance globals rather than a record slot.
      set_fn_lines(fn_lines)
      // The MultiShot handlers the module runs, each with its one driver.
      let redrives = if yield_seen > 0 { redrive_handlers(table_fn_names, twin_base_set) } else { [] }
      // The call vectors, collected ONCE — the floor tree and every twin under
      // its own bracket — and read twice: the type section declares the face
      // each site names, the table grows its native half iff a site reaches it.
      // A driver's arm call is a site too, at the word face.
      let vectors = derived_vector_collect(
        derived,
        spec_vector_collect(spec_recs, collect_call_vectors_list(lowered, []))
      ) ++ redrive_vectors(redrives)
      {
        adjoint_registers: derived.adjoint_registers,
        alloc_units: alloc_units,
        fn_records: fn_records,
        fold_closures: fold_closures,
        jvp_faces: jvp_face_map(derived.faces),
        jvp_names: jvp_names,
        jvp_recs: jvp_recs,
        jvp_wide: jvp_wide,
        line_owners: static_line_owners(
          top_fn_names,
          fn_lines,
          spec_recs,
          init_lets_lines(collect_top_value_lets(lowered))
        ),
        lowered: lowered,
        redrives: redrives,
        spec_names: spec_names,
        spec_recs: spec_recs,
        spec_wide: spec_wide,
        string_entries: string_entries,
        table_fn_names: table_fn_names,
        tangent_rings: derived.rings,
        top_fn_names: top_fn_names,
        vectors: vectors,
        wasi_ops: wasi_ops,
        wide_fn_names: wide_fn_names,
        yield_seen: yield_seen,
      }
    },
  }
}

// The module, written from its plan. Nothing here decides: every fact it
// reads was settled before the gate, and the registries the writes consult
// (the twins, the string offsets, the per-fn lines) were seeded by the plan.
fn emit_planned(plan) = match plan {
  {adjoint_registers, alloc_units, fn_records, fold_closures, jvp_faces, jvp_names, jvp_recs, jvp_wide, line_owners, lowered, redrives, spec_names, spec_recs, spec_wide, string_entries, table_fn_names, tangent_rings, top_fn_names, vectors, wasi_ops, wide_fn_names, yield_seen} => {
    let line_globals = line_global_slots(line_owners)
    emit_header()
    emit_type_section(vectors, yield_seen)
    emit_runtime_imports(wasi_ops)
    // The module's memory OWNERSHIP is read from its own proof (the fifth
    // projection): a module that spawns IMPORTS the shared image (every
    // instance reads one memory — the wasi-threads convention) and
    // allocates through the shared cell; a thread-free module owns a
    // self-contained defined memory, plain bump, no thread-spawn import.
    // The `<|`/`><` ownership discrimination at the module-image altitude.
    let spawns = ls_find_str_local(wasi_ops, "spawn_task", 0) >= 0
    // The socket seam's own proof, read from the module's ops beside the
    // spawn proof rather than inferred from it (see emit_memory_decl).
    let socketed = ls_find_str_local(wasi_ops, "sock_accept", 0) >= 0
    emit_memory_decl(spawns, spawns || socketed, ls_find_str_local(wasi_ops, "atomic_rmw", 0) >= 0)
    // An arena lives where one instance owns the line (a spawning module's
    // arena is its body, `Hβ.arena.per-instance-regions`); its leaves are
    // settled here, before any function is written, because every barrier
    // and every claim writes a leaf's index.
    let arena_on = arena_demanded() && !spawns
    set_arena_leaves(if arena_on { evac_leaf_list(fold_closures.evac) } else { [] }, arena_on)
    if arena_on { emit_arena_runtime() } else { () }
    emit_line_globals(line_owners)
    emit_tangent_ring_globals(tangent_rings)
    // The register a twin hands its result's tangent back through: one f64
    // per instance, written by a twin's exit and read by its caller the
    // instant the call returns; and the epoch every record's lanes are read
    // against, advanced where each reading opens.
    if lanes_on() {
      wat_emit("  (global $__dt (mut f64) (f64.const 0))\n  (global $__dt_epoch (mut i32) (i32.const 0))\n")
      emit_adjoint_registers(adjoint_registers)
    }
    // band B k1: the yield triple exists only in a module that yields —
    // $yield_flag (the out-of-band Koka-lineage yielding bit), $yield_op (the
    // interned op key the drivers compare), $yield_k (the reified k record).
    if yield_seen > 0 { emit_yield_globals() }
    emit_string_data(string_entries)
    // Twins ride every fn-name surface APPENDED (existing indices stable): the
    // table (a wide twin's slot holds its $wf$ word face), the per-name idx
    // globals, and the static closure records (global.get $<twin> at redirect
    // sites reads a record whose offset-0 slot is the twin's table index). The
    // derivative reading's twins append after the spec twins, so a module with
    // no reading is byte-identical.
    let table_all = table_fn_names ++ spec_names ++ jvp_names
    let wide_all = wide_fn_names ++ spec_wide ++ jvp_wide
    emit_fn_table(
      table_all,
      wide_all,
      any(vector_is_wide, vectors),
      if lanes_on() { Some(jvp_face_names(jvp_faces, table_all)) } else { None },
      arena_leaves()
    )
    emit_fn_index_globals(table_all, fn_table_base())
    emit_static_top_closures(top_fn_names ++ spec_names ++ jvp_names, table_all, 0)
    // Module VALUE bindings: ONE projection feeds the declaration half and
    // the init half (never two walks of one tree).
    let value_lets = collect_top_value_lets(lowered)
    emit_top_let_globals(value_lets)
    emit_image_substrate(
      wasi_ops,
      line_globals ++ tangent_ring_slots(tangent_rings),
      value_lets,
      yield_seen,
      table_all,
      string_entries
    )
    emit_functions(fn_records, alloc_units)
    emit_wide_wrappers(fn_records)
    // The twins: the SAME per-fn emission, each under its instantiation
    // handler — monomorphization as a handler swap. A wide twin also gets its
    // $wf$ word-face wrapper under the same install (its table slot speaks the
    // word-arity face like every other wide fn).
    each(
      {
        tw => {
          // The twin's emission is a region too: pairs/enc live OUTSIDE the
          // mark (allocated with spec_recs above), the registry commit stores
          // pre-mark pointers, and both strings stream before the reset.
          spec_ctx_set(tw.pairs, tw.enc)
          let m = heap_mark()
          wat_emit(emit_one_fn_to_string(tw.rec, alloc_units))
          wat_emit(if fn_record_is_wide(tw.rec) { emit_one_wrapper_to_string(tw.rec) } else { "" })
          heap_reset(m)
          spec_ctx_clear()
        },
      },
      spec_recs
    )
    // The derivative reading's twins: each under the bracket of the body it
    // reads, and standing at that body's symbol, whose `<~` lines are the
    // lines it ticks.
    each(emit_jvp_twin, jvp_recs)
    // The four fold leaves — eq / compare / hash / show — one recursive
    // $<leaf>_<sig> helper per distinct signature in each closure, all read
    // from the ONE collection walk above (the unified each). Plain top-level
    // fns, called directly like $str_eq; a program with no aggregate sites
    // collects none (byte-identical, Law 7). The leaves allocate (a show
    // leaf's concat tree, an aggregate leaf's call record), so the
    // allocation strategy installs HERE, inside the live sink: the
    // strategy's arm performs `wat_emit`, an arm's performs resolve outer
    // of its own install, and this is the one whole-compile emission with
    // no per-fn bracket of its own (the init lets carry theirs). The
    // whole-compile install that used to stand in emit_context wrote past
    // every sink installed inside a compile — the row carried WasmOut to the
    // executable root and the root gate refused the wheel (2026-09-27).
    emit_fold_leaf_helpers(fold_closures) ~> emit_memory_bump
    // band B M1.2 — the composer pair + world reader: $__k_compose (the
    // self-re-composing junction k, table-resident above), $__k_extend (the one
    // bubble op), $__k_world (the frozen-world read). Dormant until a k2
    // boundary calls extend; emitted only when the module yields (Law 7).
    if yield_seen > 0 { emit_k_compose_pair() }
    // band B M2b — one redrive fn per LIVE MultiShot-armed handler: the
    // dispatch loop's one home (the install bracket and every resume
    // flag-arm call the same fn).
    each(emit_one_redrive, redrives)
    emit_init_lines(line_owners, tangent_rings)
    emit_init_lets(value_lets)
    emit_start(
      top_fn_names,
      value_lets,
      len(line_owners) > 0,
      main_param_count(),
      yield_seen,
      spawns,
      arena_on
    )
    emit_footer()
  },
}

// ─── Single-walk multi-projection emit pre-pass ─────────────────────
// Per PLAN §2 + Hβ.emit.consolidate-pre-pass-walks
// (2026-05-11): the four DELETED collect passes (fn_names, top_fn_names,
// string_literals, state_slots) over the SAME LowExpr tree were the
// canonical "imperative subsystem" drift (#102) at the emit layer — each
// pass an independent deep tree walk with duplicated 30+ variant match,
// parallel buffer-counter accumulation, 16 helper fns total.
//
// Substrate-honest form: ONE walk (walk_lemit / walk_lemit_expr) firing
// per-node `perform visit_X` ops; FOUR visitor handlers chained via `~>`
// each maintaining their own buffer-counter accumulator. Adding a fifth
// projection = adding ONE handler + ONE visit-site in walk_lemit_expr.
// The graph IS the index; the handler-chain IS the projector.
//
// Per the eight interrogations on this consolidation:
//   Graph:      tree walked ONCE; every node visited exactly once.
//   Handler:    four visitor handlers; each with visit op + drain op;
//               resume OneShot throughout.
//   Verb:       `~>` install — four handlers chained over walk_lemit.
//   Row:        each visitor adds its visit op to body's row; drain ops
//               execute after walk completes.
//   Ownership:  each visitor owns its accumulator (buffer-counter);
//               no shared mutable state across visitors.
//   Refinement: count <= len(buf) per buffer-counter (Ω.3) invariant.
//   Gradient:   adding a 5th projection = adding a `~>`-link; one new
//               handler decl + one new visit-site in walk_lemit_expr.
//   Reason:     each accumulated element retains its source-handle
//               Reason via the LowExpr's handle (offset 0 of every variant).
effect EmitFnNamesOp {
  visit_fn(String)
  drain_fn_names() -> [String]
}

effect EmitTopFnNamesOp {
  visit_top_fn(String)
  drain_top_fn_names() -> [String]
}

effect EmitStringLiteralOp {
  visit_string(String)
  drain_string_literals() -> [(String, Int)]
}

// Each emitted fn's `<~` lines — (site handle, depth) in record-slot order,
// read off the LowFn at every fn-bearing node of the one emit-state walk.
// The projection every module-scope line reader shares: the install emit
// sizes a handler record by the sum over its arm fns, the static line
// globals and their init enumerate the top-level fns' sites, and a twin
// of a top-level fn reads its base's.
effect EmitFnLines {
  visit_fn_lines(String, [(Int, Int, LineHome)])
  drain_fn_lines() -> [(String, [(Int, Int, LineHome)])]
}

// The per-fn line lists, seeded once from the emit-state walk and read by
// name at the install emit (a handler's arms share one record, so the
// record is sized by the sum of its arm fns' lines) — the string_table
// precedent: one projection, one registry, read live at every site.
effect LineRegistry {
  set_fn_lines([(String, [(Int, Int, LineHome)])])
  fn_lines_of(String) -> [(Int, Int, LineHome)]
}

effect EmitWasiOp {
  visit_wasi_op(String)
  drain_wasi_ops() -> [String]
}

// The sixth projection (band B k1): does the module YIELD anywhere? A
// MultiShot yield site (LYield / a gated install's driver) fires visit_yield;
// the yield globals ($yield_flag/$yield_op/$yield_k) and the _start
// unhandled-yield backstop emit ONLY when seen — a OneShot-only module (the
// wheel) fires zero visits, so its emitted bytes are unchanged (Law 7).
effect EmitYield {
  visit_yield()
  drain_yield_seen() -> Int
}

handler yield_seen_collector with n = 0 {
  visit_yield() => resume() with n = n + 1,
  drain_yield_seen() => resume(n),
}

// The seventh projection — the executable gate's EVIDENCE CENSUS: every
// walking perform's demand (the dispatch's own effect key, carried on the
// node; LYield's non-empty op) and every install's
// absorbed enames (LHandleWith's arm groups). The gate walks the SAME
// post-reach tree emit walks and reads THIS drain — the artifact is the
// truth source; a lower-side ledger caching the same facts was the
// Carried-Truth violation this projection deleted.
effect EmitEffectCensus {
  // an ekey (ename) or a yield's op name — the gate resolves ops to enames
  visit_effect_demand(String)
  // a singleton direct perform, with the handler name its dispatch will
  // look up. Ignored everywhere except inside an install's own inits,
  // where preinstall_init_scope compares it to that install's handler.
  visit_direct_perform(String, String)
  // the demands. The census used to carry a second list — every ename an
  // install's arm groups absorb, anywhere in the tree — whose one reader
  // was the executable root gate's "installed somewhere" credit, deleted
  // 2026-09-27: the row already carries every install's subtraction at
  // its own extent, so a name-keyed list of installs re-derived a fact the
  // row holds exactly, and cleared performs no install enclosed.
  drain_effect_census() -> [String]
}

handler effect_census_collector with demands = [] {
  visit_effect_demand(n) => if string_in_list(demands, n) { resume() } else { resume() with demands = push(demands, n) },
  visit_direct_perform(_, _) => // Outside an inits walk a direct perform says nothing about extent —
  // the world lookup is a live runtime read and the belt beneath it is
  // the honest answer (1016 such guards in the wheel's own emit, every
  // one under a live install at runtime).
  resume(),
  drain_effect_census() => resume(demands),
}

// THE INITS' OWN SCOPE, drawn as an install rather than threaded as a flag.
// Walking an install's inits is the one place the lowered tree already
// proves a perform precedes its handler's existence, so a `~>` over that
// sub-walk is the whole mechanism. A direct perform naming THIS handler
// walks a chain the install's `world_push` has not yet extended, so the
// walk provably reaches the end — it refuses here instead of trapping
// there (`Hβ.emit.self-init-singleton-call-is-statically-uninstalled`).
handler preinstall_init_scope(own_handler, init_span) {
  visit_direct_perform(hn, op) => {
    // `hn` is the handler's NAME, not its node — the walk identifies handlers
    // by String here — so this site has nothing to report AT and falls back
    // to the module in force. Shape 4 of the identity arc, seen from the
    // diagnostic boundary: a name cannot be attributed, a handle can.
    if hn == own_handler { report(EInitPerformsOwnOp(hn, op, init_span)) } else { () }
    resume()
  },
  visit_effect_demand(n) => // The inits' demands are the module's demands: both flow on to the
  // collector outside (an arm's own perform resolves OUTER of its install).
  // The scope is exhaustive over `EmitEffectCensus` by these two arms
  // (`E_HandlerInexhaustive`, 2026-09-30).
  {
    visit_effect_demand(n)
    resume()
  },
  drain_effect_census() => resume(drain_effect_census()),
}

handler fn_names_collector with buf = make_list(64), count = 0 {
  visit_fn(name) => {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, name)
    resume() with buf = written, count = count + 1
  },
  drain_fn_names() => resume(slice(buf, 0, count)),
}

handler top_fn_names_collector with buf = make_list(16), count = 0 {
  visit_top_fn(name) => {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, name)
    resume() with buf = written, count = count + 1
  },
  drain_top_fn_names() => resume(slice(buf, 0, count)),
}

handler string_literal_collector with buf = make_list(16), count = 0, next_offset = 65536 {
  visit_string(s) => if string_entry_exists(buf, s, 0, count) {
    resume()
  } else {
    // 8-byte header [count@0][tag_word@+4] + the bytes @ +8 (§4①: a string
    // literal is the unified flat-sequence record, a stride-1 byte list).
    let size = 8 + byte_len(s)
    let aligned_size = (size + 3) / 4 * 4
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, (s, next_offset))
    resume() with buf = written, count = count + 1, next_offset = next_offset + aligned_size
  },
  drain_string_literals() => resume(slice(buf, 0, count)),
}

// The fn NAME is the identity — one fn, one line list — so a fn walked
// twice registers once, with the lines its own LowFn carries. Only fns
// with lines register: the common module carries none and the list is
// empty (Law 7).
handler fn_lines_collector with buf = make_list(8), count = 0 {
  visit_fn_lines(name, lines) => if len(lines) == 0 || any({ (n, _) => field_name_eq(n, name) }, slice(buf, 0, count)) {
    resume()
  } else {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, (name, lines))
    resume() with buf = written, count = count + 1
  },
  drain_fn_lines() => resume(slice(buf, 0, count)),
}

// The registry the install emit reads by arm name. The fn set with lines
// is tiny, so the bucket index (lib/imap.mn's smap — the one String-keyed
// primitive) answers a miss as the empty list: a fn with no lines is not
// an entry.
handler line_registry with idx = smap_new() {
  set_fn_lines(xs) => resume() with idx = smap_build(xs),
  fn_lines_of(name) => resume(match smap_get(idx, name) {
    Some(lines) => lines,
    None => [],
  }),
}

// The WASI import set IS the fifth projection of the one emit-state walk: every
// op a program's LWasiCall nodes invoke, collected unique, read live. The import
// section projects from this — no hardcoded list to drift from actual usage.
// (slot_already_recorded is the generic scalar-membership check; `==` is
// structural, so it dedups op-name strings as readily as slot ints.)
handler wasi_ops_collector with buf = make_list(8), count = 0 {
  visit_wasi_op(op) => if slot_already_recorded(buf, op, 0, count) {
    resume()
  } else {
    let extended = list_extend_to(buf, count + 1)
    let written = list_set(extended, count, op)
    resume() with buf = written, count = count + 1
  },
  drain_wasi_ops() => resume(slice(buf, 0, count)),
}

fn string_entry_exists(entries, target: String, i, n) = if i >= n {
  false
} else {
  match list_index(entries, i) {
    (s, _) => if s == target { true } else { string_entry_exists(entries, target, i + 1, n) },
  }
}

// the String proof: bare == was pointer-eq through m2 — dedup dead, triple fd_write imports in m3
fn slot_already_recorded(entries, target: String, i, n) = if i >= n {
  false
} else if list_index(entries, i) == target {
  true
} else {
  slot_already_recorded(entries, target, i + 1, n)
}

// project_emit_state — single-tree-walk; six projections drained at end.
// Returns (all_fn_names, top_fn_names, string_entries, state_slots, wasi,
// yield_seen). Replaces the prior `<|` fan-out (parallel walks of the same
// tree) with ONE walk and visitor-handler accumulators. Order-preserving:
// per-projection encounter order matches the prior per-walk order. The
// chained `~>` install establishes the handler stack at the body's op-call
// sites; each visit-op routes to its handler unambiguously. The bracket
// installs EVERY visitor family the shared walk fires — effect_census
// included, though only the gate's invocation drains it: an op the walk
// fires MUST land in a live record in THIS extent, or the singleton tier
// routes it to a zero state global and the accumulator lives at the null
// page (address 12 — below every region mark, never reset, holding a stale
// pointer into the region; the cross-compile trap of 2026-07-22). The walk's
// row names the ops; the bracket is the row's dynamic-extent obligation.
fn project_emit_state(lowered, twin_bases, closures: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}) = {
  walk_lemit(lowered)
  // A twin whose base the module does not emit is still that base's body,
  // so the base owes it every fact the body carries — its strings, its
  // `<~` lines, its host ops, its yields and its performs — while none of
  // the base's own names is emitted.
  walk_lemit(twin_bases) ~> names_not_emitted
  // The SHOW leaf's helpers ($show_<sig>) assemble String literals not present
  // in the user IR (delimiters "{" "}" "(" ")" "[" "]" ", ", each field name
  // "name: ", each ctor "Ctor("). Register them through the SAME visit_string
  // channel the user literals flow through — so emit_string_data lays them in
  // the (data ...) section and string_offset resolves the helper's references.
  // The set of literals is a projection of the collected show types (the graph
  // IS the index — the same type closure the unified fold walk collects).
  register_show_literals(closures.show)
  let names = drain_fn_names() |> dedup_names
  let tops = drain_top_fn_names()
  let strs = drain_string_literals()
  let lines = drain_fn_lines()
  let wasi = drain_wasi_ops()
  let yseen = drain_yield_seen()
  (names, tops, strs, lines, wasi, yseen)
} ~> fn_names_collector ~> top_fn_names_collector ~> string_literal_collector ~> fn_lines_collector ~> wasi_ops_collector ~> yield_seen_collector ~> effect_census_collector

// The names of a decl the module does not emit, dropped where they are
// visited; every other fact of its body flows on to the collectors outside —
// the drains included, forwarded to the collectors that hold the names
// (exhaustive over both effects it answers: `E_HandlerInexhaustive`,
// 2026-09-30).
handler names_not_emitted {
  visit_fn(_name) => resume(),
  visit_top_fn(_name) => resume(),
  drain_fn_names() => resume(drain_fn_names()),
  drain_top_fn_names() => resume(drain_top_fn_names()),
}

// register_show_literals — fire visit_string for every String literal the
// generated $show_<sig> helpers will emit. The literal set is a PROJECTION of
// the collected show types (the SAME .show closure the unified fold walk carries):
// a record contributes its delimiters + each "name: "; a tuple its parens; a
// list its brackets + ", "; a sum each "Ctor("/")"/nullary name. Runs inside
// project_emit_state where string_literal_collector catches visit_string.
fn register_show_literals(show_tys) = register_show_literals_list(show_tys, [])

fn register_show_literals_list(tys, seen) = if len(tys) == 0 {
  ()
} else {
  let ty = last(tys)
  let sig = fold_sig(ty)
  if ls_find_str_local(seen, sig, 0) >= 0 {
    register_show_literals_list(drop_last(tys), seen)
  } else {
    register_one_show_literals(ty)
    register_show_literals_list(drop_last(tys), [sig] ++ seen)
  }
}

// The literal set of one type's $show_<sig> helper. The "" separator is always
// registered (the join + the list-body's empty terminal). visit_string dedups
// (string_entry_exists), so registering a literal twice is harmless.
fn register_one_show_literals(ty) = match fold_strip(ty) {
  TName(_, _) => register_show_sum_literals(variant_named_specs_at(fold_strip(ty)), 0),
  TList(_) => {
    visit_string("[")
    visit_string("]")
    visit_string(", ")
    visit_string("")
  },
  TTuple(_) => {
    visit_string("(")
    visit_string(")")
    visit_string(", ")
    register_show_field_name_literals(show_named_fields(fold_strip(ty)), 0, false)
  },
  _ => {
    visit_string("\{")
    visit_string("\}")
    visit_string(", ")
    register_show_field_name_literals(show_named_fields(fold_strip(ty)), 0, true)
  },
}

fn register_show_field_name_literals(fields: [(String, Ty)], i, is_record) = if i >= len(fields) {
  ()
} else {
  match list_index(fields, i) {
    (fname, _fty) => {
      if is_record { visit_string("{fname}: ") } else { () }
      register_show_field_name_literals(fields, i + 1, is_record)
    },
  }
}

fn register_show_sum_literals(specs, i) = if i >= len(specs) {
  visit_string(", ")
} else {
  match list_index(specs, i) {
    (_tag, cname, payloads) => {
      if len(payloads) == 0 {
        visit_string(cname)
      } else {
        visit_string("{cname}(")
        visit_string(")")
      }
      register_show_sum_literals(specs, i + 1)
    },
  }
}

// walk_lemit — top-level entry. Iterates the lowered program's direct children;
// fires `visit_top_fn(name)` for each LLet-bound closure/continuation
// (the original top-level fn-name collection semantic). Then recursive
// descent via walk_lemit_expr collects the per-node projections.
fn walk_lemit(exprs) = walk_lemit_top(exprs, 0)

// The receiver is ANNOTATED so the destructure below is provable: field
// offsets resolve from the receiver's full sorted field set, and an open
// row leaves lowering guessing from the pattern's own index
// (`Hβ.lower.record-pattern-param-receiver`).
fn walk_install_groups(ref groups: [{arms: [String], ename: String}], i) = if i >= len(groups) {
  ()
} else {
  match list_index(groups, i) {
    {arms: _, ename: en} => {
      // The install ename is a WORLD-chain key at emit ($world_push's
      // (i32.const string_offset)) — intern it through the one channel every
      // dispatch key flows through, else an ename no perform references
      // resolves to offset 0 and every such key collides.
      visit_string(en)
      walk_install_groups(groups, i + 1)
    },
  }
}

fn walk_lemit_top(exprs, i) = if i >= len(exprs) {
  ()
} else {
  walk_lemit_top_one(list_index(exprs, i))
  walk_lemit_top(exprs, i + 1)
}

fn walk_lemit_top_one(expr) = {
  let top_name = extract_top_fn_name(expr)
  if top_name == "" {
    walk_lemit_expr(expr)
  } else {
    visit_top_fn(top_name)
    walk_lemit_expr(expr)
  }
}

// walk_lemit_expr — recursive descent. EXHAUSTIVE over LowExpr variants.
// Fires visit_fn at fn-bearing variants (anywhere), visit_string at
// LConst(LString), visit_state_slot at LFeedback.
// Drift 9 closed: every arm explicit; no `_ =>` catch-all would silently
// miss projections for a new variant.
fn walk_lemit_expr(expr) = match expr {
  LShow(h, x) => // Delegate through the builders so the pre-pass sees the SAME synthesized
  // shapes emit will drive (the scalar renderer LGlobal names join
  // all_fn_names exactly as the lower-baked calls did — byte parity).
  walk_lemit_expr(show_node_of(h, x)),
  LHash(h, x) => walk_lemit_expr(hash_node_of(h, x)),
  LMakeClosure(_, LFn(name, _, _, body, _, lines), captures) => {
    visit_fn(name)
    visit_fn_lines(name, lines)
    walk_lemit_list(body)
    walk_lemit_list(captures)
  },
  LMakeContinuation(_, LFn(name, _, _, body, _, lines), captures, _, _) => {
    visit_fn(name)
    visit_fn_lines(name, lines)
    walk_lemit_list(body)
    walk_lemit_list(captures)
  },
  LResumeK(_, k, v) => {
    walk_lemit_expr(k)
    walk_lemit_expr(v)
  },
  LYield(_, op_name, args, k) => // band B k1: a yield reads the yield globals and interns its op key (the
  // driver's compare reads the SAME offset); descend the k record. The floor
  // form ("" op) interns the empty string — harmless, gated modules only.
  {
    visit_yield()
    visit_string(op_name)
    if field_name_eq(op_name, "") { () } else { visit_effect_demand(op_name) }
    walk_lemit_list(args)
    walk_lemit_expr(k)
  },
  LKExtend(_, k) => // band B M1.3: a k2 boundary needs the yield machinery (globals + the
  // composer pair) exactly as a yield does; its frame_k record descends
  // like LYield's k.
  {
    visit_yield()
    walk_lemit_expr(k)
  },
  LDeclareFn(LFn(name, _, _, body, _, lines)) => {
    visit_fn(name)
    visit_fn_lines(name, lines)
    walk_lemit_list(body)
  },
  LConst(_, LString(s)) => visit_string(s),
  LConst(_, _) => (),
  LLocal(_, _) => (),
  LFeedbackPrior(_) => (),
  LGlobal(_, _) => (),
  LUpval(_, _) => (),
  LLet(_, _, inner) => walk_lemit_expr(inner),
  LBinOp(_, _, l, r) => {
    walk_lemit_expr(l)
    walk_lemit_expr(r)
  },
  LUnaryOp(_, _, inner) => walk_lemit_expr(inner),
  LCall(_, f, args) => {
    walk_lemit_expr(f)
    walk_lemit_list(args)
  },
  LTailCall(_, f, args) => {
    walk_lemit_expr(f)
    walk_lemit_list(args)
  },
  LDirectCall(_h, _fh, _n, _t, args) => walk_lemit_list(args),
  LReturn(_, inner) => walk_lemit_expr(inner),
  LIf(_, c, t, e) => {
    walk_lemit_expr(c)
    walk_lemit_list(t)
    walk_lemit_list(e)
  },
  LBlock(_, stmts) => walk_lemit_list(stmts),
  LMakeList(_, elems) => walk_lemit_list(elems),
  LMakeTuple(_, elems) => walk_lemit_list(elems),
  LSimdLanes(_, lanes) => walk_lemit_list(lanes),
  LFanout(_, lex, _, forms) => walk_lemit_expr(fanout_form(lex, forms)),
  LMakeRecord(_, fs) => walk_lemit_list(fs),
  LMakeVariant(_, _, fs) => walk_lemit_list(fs),
  LMatch(_, s, arms) => {
    walk_lemit_expr(s)
    walk_lemit_arms(arms)
  },
  LHandleWith(ih, b, hn, hname, inits, arm_names) => {
    walk_install_groups(arm_names, 0)
    walk_lemit_expr(b)
    walk_lemit_expr(hn)
    // The config arguments (a default among them) walk under this install's
    // own name. A direct perform of an op THIS handler answers cannot reach
    // it: the world_push is below. The span comes off the install's own node
    // — the reason the graph already carries, never a coordinate re-derived
    // here. The state inits walk under the same scope inside the init fn
    // (the LStateInit arm).
    {
      walk_lemit_list(inits)
    } ~> preinstall_init_scope(hname, reason_span_or_zero(graph_reason_at(ih)))
    // band B k1: a MultiShot-armed install carries the driver loop, which
    // reads the yield globals and compares the interned op keys — register
    // both through the same channels (the one decider multishot_ops_of;
    // its emit twin reads it identically).
    each(
      {
        (op, _) => {
          visit_yield()
          visit_string(op)
        },
      },
      multishot_ops_of(hname)
    )
  },
  LDerive(_h, seed, b) => // The derivative reading's forward body is what its expansion keeps, in
  // order — every string, name, line and perform the projections collect
  // is the body's own.
  {
    walk_lemit_expr(seed)
    walk_lemit_expr(b)
  },
  LArena(_h, b) => walk_lemit_expr(b),
  LFeedback(_h, _d, _home, b, s) => {
    walk_lemit_expr(b)
    walk_lemit_expr(s)
  },
  LPerform(_, disp, args) => // ONE arm, because there is one perform. Every dispatch that WALKS
  // interns its effect key through the SAME visit_string channel user
  // literals flow through, so string_offset resolves it to a stable nonzero
  // data offset (else every key collides at 0), and registers the effect as
  // a demand. The lexical dispatch walks nothing, so it registers nothing.
  // A dispatch that names its handler announces it for the preinstall-init
  // scope, which is listening only inside an install's own inits walk.
  {
    match disp {
      PdFrame(_, hname, op_name) => visit_direct_perform(hname, op_name),
      PdWalk(ekey, _, op_name, target) => {
        visit_string(ekey)
        visit_effect_demand(op_name)
        match target {
          ArmNamed(hname) => visit_direct_perform(hname, op_name),
          ArmSlot => (),
        }
      },
      PdDriver(_, _) => (),
    }
    walk_lemit_list(args)
  },
  LWasiCall(_, op_name, args) => {
    visit_wasi_op(op_name)
    walk_lemit_list(args)
  },
  LInvariantFailure(_, _) => (),
  LFieldLoad(_, rec, _) => walk_lemit_expr(rec),
  LConvert(_, _, operand) => walk_lemit_expr(operand),
  LStateSlotStore(_, _, v, _) => walk_lemit_expr(v),
  LStateInit(h, hname, _, v) => // A state init walks under its own handler's name: the init fn runs before
  // the install's world_push, so a direct perform of an op THIS handler
  // answers cannot reach it. The span is the init's own.
  {
    walk_lemit_expr(v)
  } ~> preinstall_init_scope(hname, reason_span_or_zero(graph_reason_at(h))),
}

fn walk_lemit_list(exprs) = walk_lemit_list_loop(exprs, 0)

fn walk_lemit_list_loop(exprs, i) = if i >= len(exprs) {
  ()
} else {
  walk_lemit_expr(list_index(exprs, i))
  walk_lemit_list_loop(exprs, i + 1)
}

// Each lowered match arm is `(LowPat, LowExpr-body)`; the body carries the
// projections (fn defs, strings, state slots, WASI ops). The pattern is
// structural — nothing to collect. The let-IS-match dissolution routes
// destructure-let bodies through arms, so this descent is load-bearing.
fn walk_lemit_arms(arms) = each(
  {
    (pat, body) => {
      walk_lemit_pat(pat)
      walk_lemit_expr(body)
    },
  },
  arms
)

// Pattern literals are emit-read graph content too: a string literal in
// pattern position interns through the SAME visit_string the expression
// position fires — emit_low_value_const reads it back via string_offset.
// walk_lemit_arms dropped the pat, so pattern strings never interned and
// the LPLit emit floored to address 0: every string-literal match in m3
// missed every arm — infer_seq_op's dispatch fell to its wildcard, typing
// every len/slice/... call TList, the 284-fn eq-dispatch flip census that
// stood between m3 and m4 (2026-07-10).
fn walk_lemit_pat(pat) = match pat {
  LPLit(LString(s)) => visit_string(s),
  LPLit(_) => (),
  LPCon(_, _, pairs) => each(walk_lemit_pat, pat_of_pairs(pairs)),
  LPTuple(elems) => each({ (_, sp) => walk_lemit_pat(sp) }, elems),
  LPList(_, prefix, _, _) => each(walk_lemit_pat, prefix),
  LPRecord(_, _, fs, _) => each({ (_, sp) => walk_lemit_pat(sp) }, fs),
  LPAlt(branches) => each(walk_lemit_pat, branches),
  LPAs(_, inner) => walk_lemit_pat(inner),
  _ => (),
}

// ─── The `<~` line: a ring in the image, owned by the record that holds
// the cycle ───────────────────────────────────────────────────────────
//
// A site's line is `[head@0][pad@4][slot × depth @8..]`, the slots at the
// site's own repr stride. `head` indexes the OLDEST slot — the prior the
// cycle reads, y[n-depth] — and advances one per tick, so the tick is a
// load, a store and a bounded increment at any depth; a depth-1 ring is the
// single register and carries no head at all. The ring is allocated once
// where its owner is built — a closure mint, an install, a k reification,
// or the static line init — never per tick, so a `!Alloc` recurrence stays
// allocation-free where it runs. It is a heap record like every other, so
// persist = memcpy carries it, and its owner's record slot (or the static
// site's instance global) carries its address.
//
// Bytes, read at the site's handle under whatever twin bracket is active —
// a Float twin's ring holds f64 slots where the floor's holds words. The
// zero-init contract is the allocator's ($heap_reset_impl's virginity law):
// a fresh ring reads head 0 and depth zeros, the "no prior iteration"
// convention every line has always had.
fn line_ring_bytes(h: Int, depth: Int) = 8 + depth * repr_width(repr_of(lookup_ty(h)))

// The instance global a STATIC site reads its ring's address from — one per
// (site, emitted symbol): a top-level fn's floor emission and each of its
// twins own separate lines, since a twin's ring is sized at the twin's
// width and a spawned instance allocates its own set (globals are
// per-instance; the semantics the module-global line had).
fn line_global_name(h: Int, site: String) = "__line_{int_to_str(h)}_{site}"

// The static line owners — (symbol, lines, pairs, enc): every emitted
// top-level fn with lines at the floor bracket, then every twin whose base's
// lines are static, the twin under its own instantiation pairs (the bracket
// its ring bytes and its body's slot width both read), then `$__init_lets`
// for the module inits' own sites. A twin's static-ness is read off its
// base's lines, where each site's home is recorded — so a base the module
// does not emit still gives its twins their lines.
fn static_line_owners(top_fn_names, fn_lines, spec_recs, init_lines) = filter(
  { (name, _lines, _p, _e) => ls_find_str_local(top_fn_names, name, 0) >= 0 },
  map({ (name, lines) => (name, lines, [], "") }, fn_lines)
) ++ flat_map(
  {
    tw => match tw.rec {
      (m, _ps, _b, _f) => match filter(line_is_static, fn_lines_of(tw.base)) {
        [] => [],
        lines => [(m, lines, tw.pairs, tw.enc)],
      },
    },
  },
  spec_recs
) ++ match init_lines {
  [] => [],
  lines => [("__init_lets", lines, [], "")],
}

// The static sites of the module inits — the lines of the frame they are
// lowered in (lower.mn `lower_module_init`), read off the nodes that carry
// them. The walk stops at a minted fn, whose lines are slots in its own
// record.
fn init_lets_lines(value_lets) = flat_map({ (_, init) => init_static_lines(init) }, value_lets)

fn init_static_lines(expr) = match expr {
  LFeedback(h, d, LhStatic, b, s) => [(h, d, LhStatic)] ++ init_static_lines(b) ++ init_static_lines(s),
  LMakeClosure(_, _, caps) => flat_map(init_static_lines, caps),
  LMakeContinuation(_, _, caps, _, _) => flat_map(init_static_lines, caps),
  LDeclareFn(_) => [],
  _ => flat_map(init_static_lines, low_children(expr)),
}

fn line_is_static(line) = match line {
  (_h, _d, home) => match home {
    LhStatic => true,
    LhSlot(_) => false,
    LhStaticJvp => true,
  },
}

// Every static line global, as (name, "i32") — the ONE projection the
// declaration, the image census and the init read, so none can disagree
// about which globals exist.
fn line_global_slots(owners) = flat_map(
  { (sym, lines, _p, _e) => map({ (h, _d, _home) => (line_global_name(h, sym), "i32") }, lines) },
  owners
)

// `(global $__line_<site>_<symbol> (mut i32) (i32.const 0))` per static
// site; $__init_lines fills it before main runs.
fn emit_line_globals(owners) = each(
  {
    (name, rw) => {
      wat_emit("  (global $")
      wat_emit(name)
      wat_emit(" (mut ")
      wat_emit(rw)
      wat_emit(") (")
      wat_emit(rw)
      wat_emit(".const 0))\n")
    },
  },
  line_global_slots(owners)
)

// The yield triple (band B k1) — the out-of-band MultiShot unwind protocol,
// the Koka-lineage yielding bit as three per-instance globals (wasi-threads
// share only MEMORY, so the flag is thread-local by construction): $yield_flag
// (1 = a MultiShot perform is unwinding), $yield_op (the interned op-name key
// the install drivers compare), $yield_k (the reified continuation record).
// Emitted only when the module yields (the sixth projection).
fn emit_yield_globals() = {
  wat_emit("  (global $yield_flag (mut i32) (i32.const 0))\n")
  wat_emit("  (global $yield_op (mut i32) (i32.const 0))\n")
  wat_emit("  (global $yield_k (mut i32) (i32.const 0))\n")
  wat_emit("  (global $yield_args (mut i32) (i32.const 0))\n")
}

// band B M1.4 — one arg of the yield's transient record: evaluate (the
// emission may clobber every shared scratch), park the VALUE in $state_tmp
// (nothing runs between the set and the store), write through the per-site
// record ptr.
fn emit_yield_arg_stores(args, h, i) = if i >= len(args) {
  ()
} else {
  emit_expr(list_index(args, i))
  wat_emit("    (local.set $state_tmp)\n")
  wat_emit("    (local.get $yargs_")
  wat_emit(int_to_str(h))
  wat_emit(")(local.get $state_tmp)(i32.store offset=")
  wat_emit(int_to_str(4 * i))
  wat_emit(")\n")
  emit_yield_arg_stores(args, h, i + 1)
}

// band B M1.4 — the driver's args push: one load per declared arm arg, read
// once from the transient $yield_args record at fixed word offsets.
fn emit_driver_arg_loads(n, i) = if i >= n {
  ()
} else {
  wat_emit("        (global.get $yield_args)(i32.load offset=")
  wat_emit(int_to_str(4 * i))
  wat_emit(")\n")
  emit_driver_arg_loads(n, i + 1)
}

// band B M2b — the per-handler REDRIVE: the install driver's dispatch loop
// factored to ONE home, called by the install bracket AND every MultiShot
// arm's resume flag-arm (the owned-op re-dispatch — the twice-refuted
// correction of the bank's "driver re-entry" sketch, which abandoned the
// outer arm). (state, acc) → the last dispatched arm's value; a FOREIGN op
// exits the loop with acc and $yield_flag INTACT — the flag global is the
// second return channel, so the two callers differ with no mode flag: the
// install bracket falls out with the flag up (the bubble, k1's law), the
// resume flag-arm meets the still-raised flag and floors LOUDLY
// (arm-remainder composition is A4/M3 territory). The driver reaches each
// arm through the record it is handed, at the arm's slot, never by the arm's
// name: an install whose key twinned its arms stored the twins in that
// record, so one driver per handler serves every key an install runs.
//
// Emission == reachability (the dcac3b8 law, at the redrive seam): the env
// holds every DECLARED MultiShot handler, dead ones included (the wheel's own
// backtrack/pick_first are uninstalled dead code), and a dead handler has no
// install bracket and no resume flag-arm, so no caller either: a handler
// runs a driver iff each of its MultiShot arms is in the module, declared or
// twinned.
fn redrive_handlers(table_names, twin_base_set) = {
  let hnames = match env_snapshot() {
    Env(entries) => ms_handler_names(entries, []),
  }
  filter(
    (hname) => all(
      { (op, _arity) => arm_in_module(table_names, twin_base_set, arm_fn_name(hname, op)) },
      multishot_ops_of(hname)
    ),
    hnames
  )
}

fn arm_in_module(table_names, twin_base_set, arm: String) = if name_seen_at(table_names, arm, 0, len(table_names)) {
  true
} else {
  match smap_get(twin_base_set, arm) {
    Some(_) => true,
    None => false,
  }
}

// Each driver's arm call is a word-face indirect: the record, the k, and
// the op's arguments.
fn redrive_vectors(hnames) = flat_map(
  (hname) => map({ (_op, arity) => (list_filled(2 + arity, RI32), RI32) }, multishot_ops_of(hname)),
  hnames
)

// Where an install's record holds an op's arm: past the header, the state
// (config first) and the arms before it in group order — the layout
// `emit_handler_effect_entries` writes.
fn arm_slot_offset(hname, op) = {
  let nstate = match handler_decl_of(hname) {
    Some((config, state, _)) => len(config) + len(state),
    None => 0,
  }
  let arms = flatten(map(group_arms, lookup_handler_arm_names_of(hname)))
  8 + 4 * (nstate + ls_find_str_local(arms, arm_fn_name(hname, op), 0))
}

// Every declared handler with a MultiShot-graded arm — the same env-live
// read the singleton globals walk uses (one criterion, N readers, never a
// registry).
fn ms_handler_names(entries, acc) = ms_handler_names_at(entries, len(entries), acc)

fn ms_handler_names_at(entries, i, acc) = if i == 0 {
  acc
} else {
  match list_index(entries, i - 1) {
    (name, _scheme, _reason, kind) => {
      let acc2 = match kind {
        HandlerKind(_row, _world, _config, _state, _arms) => if len(multishot_ops_of(name)) > 0 && ls_find_str_local(acc, name, 0) < 0 {
          [name] ++ acc
        } else {
          acc
        },
        _ => acc,
      }
      ms_handler_names_at(entries, i - 1, acc2)
    },
  }
}

fn emit_one_redrive(hname) = {
  wat_emit("  (func $op___redrive_")
  wat_emit(hname)
  wat_emit(" (param $__state i32) (param $acc i32) (result i32) (local $k i32)\n")
  wat_emit("    (block $rdone (loop $rdrive\n")
  wat_emit("      (global.get $yield_flag)(i32.eqz)(br_if $rdone)\n")
  each(
    {
      (op, arity) => {
        wat_emit("      (global.get $yield_op)(i32.const ")
        wat_emit(int_to_str(string_offset(op)))
        wat_emit(")(i32.eq)\n")
        wat_emit("      (if (then\n")
        wat_emit("        (i32.const 0)(global.set $yield_flag)\n")
        wat_emit("        (global.get $yield_k)(local.set $k)\n")
        // The arm's record is the driver's OWN $__state — both callers pass the
        // install record (the install boundary its bracket's record; a held
        // resume's flag-check the record its frame reads through the record
        // ladder, `PdDriver`'s second field). The old global re-read was the
        // Carried-Truth re-derivation of a value in hand.
        wat_emit("        (local.get $__state)(local.get $k)\n")
        emit_driver_arg_loads(arity, 0)
        wat_emit("        (local.get $__state)(i32.load offset={int_to_str(arm_slot_offset(hname, op))})")
        wat_emit("(call_indirect (type $ft{int_to_str(2 + arity)}))\n")
        wat_emit("        (local.set $acc)\n")
        wat_emit("        (br $rdrive)\n")
        wat_emit("      ))\n")
      },
    },
    multishot_ops_of(hname)
  )
  wat_emit("      (br $rdone)))\n")
  wat_emit("    (local.get $acc)\n")
  wat_emit("  )\n")
}

// The composer pair + the world reader (band B M1.2, the k2/k3 bank Ruling 1) —
// the one generic self-re-composing junction. compose(inner, frame_k) is
// ITSELF a k with the closure-identical head [fn_ptr=$__k_compose_idx][nc=2]
// [inner@8][frame_k@12][state_idx=0@16][ret_slot=0@20][world@24]
// — resume calls it through the SAME W7 convention as every k
// (no second calling convention, no chain walker). The body: r = inner(v); a
// still-raised $yield_flag means inner suspended DEEPER — re-compose the
// fresh $yield_k onto this record's own frame_k and propagate the dummy with
// $yield_flag AND $yield_op untouched (the chain rebuilds itself lazily, one
// fresh record per crossed suspension — never a post-mint mutation; the mint
// in $__k_extend is the ONLY write in the k design); a clear flag feeds r to
// frame_k as return_call_indirect — constant stack at any composition depth.
// The composed record's world = the inner k's frozen world (the segment a
// resume enters FIRST); the fk transition re-sets from fk's own slot — the
// world rides each record, never a join. Width: the composer ft
// is pinned word-uniform $ft2 — a non-i32 frame k meets a LOUD call_indirect
// type trap (Hβ.emit.compose-width-floor; the f64 composer variant is the
// named after), never a silent truncation. Dormant until a k2 boundary or a
// junction calls $__k_extend; emitted only when the module yields (Law 7).
fn emit_k_compose_pair() = {
  // $__k_world(k) — the frozen-world read: the record's LAST word at the
  // FIXED offset 16 + 4*capture_count (head 8 + captures + state_idx +
  // ret_slot precede it; no keyed region, no sentinel walk — the region
  // died with the evidence machinery). LResumeK and the composer both
  // read through this one projection.
  wat_emit("  (func $__k_world (param $k i32) (result i32)\n")
  wat_emit("    (i32.load (i32.add (local.get $k)\n")
  wat_emit("      (i32.add (i32.const 16) (i32.shl (i32.load offset=4 (local.get $k)) (i32.const 2)))))\n")
  wat_emit("  )\n")
  // $__k_extend(frame_k) — the one operation every bubble junction performs:
  // $yield_k := compose($yield_k, frame_k). Reads the unwinding k, mints the
  // 28-byte composer record, republishes. The composed record's world = the
  // INNER k's world (the first-entered segment; each deeper composition
  // preserves the deepest-first world by the same rule), so the LResumeK
  // bracket's set-from-record is right for the first instruction that runs;
  // $__k_compose re-sets at the fk transition.
  wat_emit("  (func $__k_extend (param $fk i32) (local $nk i32)\n")
  wat_emit("    (local.set $nk (call $alloc (i32.const 28)))\n")
  wat_emit("    (i32.store offset=0 (local.get $nk) (global.get $__k_compose_idx))\n")
  wat_emit("    (i32.store offset=4 (local.get $nk) (i32.const 2))\n")
  wat_emit("    (i32.store offset=8 (local.get $nk) (global.get $yield_k))\n")
  wat_emit("    (i32.store offset=12 (local.get $nk) (local.get $fk))\n")
  wat_emit("    (i32.store offset=16 (local.get $nk) (i32.const 0))\n")
  wat_emit("    (i32.store offset=20 (local.get $nk) (i32.const 0))\n")
  wat_emit("    (i32.store offset=24 (local.get $nk) (call $__k_world (global.get $yield_k)))\n")
  wat_emit("    (global.set $yield_k (local.get $nk))\n")
  wat_emit("  )\n")
  // $__k_compose(__state, v) — W7 through and through: inner and frame_k are
  // its own captures; each junction call is the same park-push-load-indirect
  // every closure call emits. Segment transition: before the frame_k's tail
  // call the world SETS from fk's own frozen slot (no save/restore — the
  // outer LResumeK bracket restores at the resume expression's end).
  wat_emit("  (func $__k_compose (param $__state i32) (param $v i32) (result i32) (local $ik i32) (local $r i32)\n")
  wat_emit("    (local.set $ik (i32.load offset=8 (local.get $__state)))\n")
  wat_emit("    (local.get $ik) (local.get $v)\n")
  wat_emit("    (local.get $ik) (i32.load offset=0)\n")
  wat_emit("    (call_indirect (type $ft2))\n")
  wat_emit("    (local.set $r)\n")
  wat_emit("    (if (global.get $yield_flag) (then\n")
  wat_emit("      (call $__k_extend (i32.load offset=12 (local.get $__state)))\n")
  wat_emit("      (i32.const 0) (return)))\n")
  wat_emit("    (local.set $ik (i32.load offset=12 (local.get $__state)))\n")
  wat_emit("    (global.set $world_g (call $__k_world (local.get $ik)))\n")
  wat_emit("    (local.get $ik) (local.get $r)\n")
  wat_emit("    (local.get $ik) (i32.load offset=0)\n")
  wat_emit("    (return_call_indirect (type $ft2))\n")
  wat_emit("  )\n")
}

// Emit `(data (i32.const <offset>) "<escaped-bytes>")` for each string
// entry. A string literal IS a byte-sequence literal (§4①): its data-section
// layout is the unified flat-sequence record [count@0][tag_word@+4][bytes@+8],
// identical to a stride-1 flat list, so list_index reads it generically at
// stride 1 (the carrier). tag_word = pack_tag(0, 1): the flat tag (0) with the
// byte stride-code (1). The bytes now begin at +8, not +4.
fn emit_string_data(entries) = each(
  {
    (s, offset) => {
      wat_emit("  (data (i32.const ")
      wat_emit(int_to_str(offset))
      wat_emit(") \"")
      // count @ +0
      emit_le4_escape(byte_len(s))
      // tag word @ +4: flat, stride-1 (byte)
      emit_le4_escape(pack_tag(0, 1))
      // bytes @ +8
      emit_string_bytes(s, 0, byte_len(s))
      wat_emit("\")\n")
    },
  },
  entries
)

fn emit_string_bytes(s, i, n) = if i >= n {
  ()
} else {
  emit_byte_escape(byte_at(s, i))
  emit_string_bytes(s, i + 1, n)
}

// extract_top_fn_name — read the binding name from a top-level LLet
// that wraps a closure/continuation. Used by walk_lemit_top_one to
// fire visit_top_fn at the correct sites. Returns "" for non-binding
// shapes (caller treats "" as no-op).
fn extract_top_fn_name(stmt) with Pure = match stmt {
  LLet(_, name, LMakeClosure(_, _, _)) => name,
  LLet(_, name, LMakeContinuation(_, _, _, _, _)) => name,
  _ => // drift-audit: ignore — "" = non-binding shape (caller treats "" as no-op)
  "",
}

// The VALUE peer of extract_top_fn_name: a top-level LLet whose init is
// NOT a closure/continuation is a module VALUE binding — it needs a
// (global $<name>) declaration and an init-before-main write ($__init_lets).
// ONE projection over lowered's direct children feeds both consumers
// (declaration + init) — never two walks of one tree.
fn collect_top_value_lets(stmts) = stmts |> map({
  LLet(_, _, LMakeClosure(_, _, _)) => [],
  LLet(_, _, LMakeContinuation(_, _, _, _, _)) => [],
  LLet(_, name, init) => [(name, init)],
  _ => [],
}) |> flatten

// The module's fn set IS a set. The k machinery's dual-residency and
// nested reification legitimately SHARE LFn subtrees — one node, many
// reaching trees (the original decl, the reified k fn, the inline
// residency) — so the tree-order walks meet one fn N times (first
// exercised when THE CUT flipped the wheel's own choose/
// enumerate_inhabitants MultiShot: one lambda collected 4x, its k
// frame 2x — table, _idx globals, and definitions all redefined).
// Emission dedups by NAME at each materialization seam; keep-first
// preserves visit order so all three surfaces agree. A second sighting
// of one name is never a second fn — the name derives from the minting
// handle (lambda_<h> / __k_<h>) or the unique top-level decl.
fn name_seen_at(names, target: String, i, n) = if i >= n {
  false
} else if list_index(names, i) == target {
  true
} else {
  name_seen_at(names, target, i + 1, n)
}

// Flat-buffer keep-first dedup — byte-identical to the old fold, O(U^2)
// not O(U^3). The old fold appended onto a concat SPINE, so name_seen_at's
// list_index was O(depth) per step and the whole dedup O(U^3) (~1.5e9
// node-steps for U~2100 names — a top wheel-compile cost, PLAN §8 the
// loop-accumulator class). The result buffer is flat (list_index O(1));
// slice returns the logical prefix; the membership scan stays linear but
// the concat-spine re-scan was the real cost, not the linearity
// (Hβ.emit.flat-accumulator-dedup — the speed IS the Carried-Truth fix:
// stop re-deriving position by re-walking a spine).   // drift-audit: ignore
fn dedup_names(names) = {
  let n = len(names)
  dedup_names_flat(names, 0, n, make_list(n), 0)
}

fn dedup_names_flat(names, i, n, out, count) = if i >= n {
  slice(out, 0, count)
} else {
  let name = list_index(names, i)
  if name_seen_at(out, name, 0, count) {
    dedup_names_flat(names, i + 1, n, out, count)
  } else {
    dedup_names_flat(names, i + 1, n, list_set(out, count, name), count + 1)
  }
}

// What the record kept under a name says about the one being offered.
// Three outcomes, so an ADT: a Bool here would have to mean "seen" and leave
// the two ways of being seen — the same function twice, and two functions
// under one name — indistinguishable, which is exactly the distinction the
// dedup exists to make and the one it was not making.
type FnRecordVerdict = FrFresh | FrIdentical | FrCollision

// Keep-first dedup of fn records, ONE pass: each record's name is read in
// the keep-set's name map, so a miss keeps it and a hit compares it with
// the record kept. The form it replaces compared every record with every
// one before it and built a tuple per comparison — 60MB per dedup on the
// wheel (the emit's heap marks, 2026-09-28), for what a map answers in O(1).
//
// IT COMPARES THE RECORD, NOT THE NAME. Keep-first on a name alone is only
// sound while no two DIFFERENT functions can share one, and that was true
// here by two unrelated accidents rather than by anything checked: authored
// duplicates are refused upstream (`E_DuplicateFnName`, whose own comment
// says "the emitter would pick one silently"), and synthesized symbols —
// `lambda_<h>`, `partial_<h>`, `__k_<ph>`, the twins' mangles — were unique
// only because a mint counter is unique. The second accident is provenance
// leaking into identity, and it is exactly what content-addressed emitted
// names (Hβ.emit.identity-is-content-not-mint-order) removes. So the check
// comes first: with the record compared, a genuine duplicate still dedups
// (which is the deletion content naming is FOR) and a collision refuses
// instead of dropping a body while its callers keep pointing at another.
fn dedup_fn_records(records) = {
  let n = len(records)
  dedup_fn_records_flat(list_to_flat(records), 0, n, make_list(n), 0, smap_new())
}

fn fn_record_verdict(kept, r) = match kept {
  None => FrFresh,
  Some(existing) => // Names match, so the whole-record compare is the CONTENT compare —
  // structural `==` to the bottom over the five node-kinds, which is the
  // one equality the medium has (PLAN §5.U); no bespoke body walk.
  if existing == r { FrIdentical } else { FrCollision },
}

fn dedup_fn_records_flat(records, i, n, out, count, seen) = if i >= n {
  slice(out, 0, count)
} else {
  let r = list_index(records, i)
  let name = fn_record_name(r)
  match fn_record_verdict(smap_get(seen, name), r) {
    FrFresh => dedup_fn_records_flat(
      records,
      i + 1,
      n,
      list_set(out, count, r),
      count + 1,
      smap_add(seen, name, r)
    ),
    FrIdentical => dedup_fn_records_flat(records, i + 1, n, out, count, seen),
    FrCollision => {
      report(EEmittedNameCollision(name, fn_record_span(r)))
      dedup_fn_records_flat(records, i + 1, n, out, count, seen)
    },
  }
}

fn fn_record_name(r) = match r {
  (name, _, _, _) => name,
}

// The record carries no span of its own, and it does not need one: its body's
// first statement is a graph node, and the graph is where every coordinate
// already lives. An empty body has nothing to point at and says so.
fn fn_record_span(r) with !Mutate = match r {
  (_, _, body, _) => if len(body) == 0 { span_zero() } else { parse_span_of(lexpr_handle(list_index(body, 0))) },
}

// Emit the function table and elem mapping indices to function
// labels. Every closure's fn_ptr slot stores the i32 index into
// this table; `call_indirect (type $ftK)` dispatches by index.
//
// SLOT 0 IS RESERVED AND STAYS NULL, and that is a CONTRACT rather than a
// spare byte. Everything in the image that says "no function here" says it
// with a zero — an arm slot for an op its handler does not implement, a
// closure record the allocator handed back virgin, a cleared fn_ptr — and
// while slot 0 held a real function, every one of those zeros was
// indistinguishable from a legitimate call to whichever fn sorted first.
// It was not hypothetical: op_outer_note drew index 0 in a two-handler
// fixture, so the declaring walk read the one node that DID declare the op
// as a gap and walked past it (measured 2026-09-10, the trap this reserve
// closed). A null funcref traps at call_indirect, so the absence now
// refuses loudly at every one of those sites instead of dispatching into
// an unrelated body — the accident named and made a contract at the one
// writer, which is where table indices are minted.
// TWO FACES, ONE INDEX. A closure's fn_ptr names its WORD face — the slot a
// caller blind to its type reaches (a generic handler arm, the continuation
// composer, any floor body), where a wide fn sits behind its $wf$ wrapper. A
// caller that PROVES a wide vector reaches the NATIVE face one half later
// (`$native_face` past the word face) and passes its values as themselves: no
// cell, no wrapper, nothing allocated. The native half exists only in a module
// with such a site, so a word-only module's table is unchanged.
// THE DERIVATIVE FACE is a third half (`jvp_faces`, one symbol per index —
// the twin the reading demanded at every Float parameter, or
// `$__jvp_absent` where none was): a call through a function value under
// the reading, and a walking perform under it, reach `fn_ptr + $jvp_face`
// and run the derivative program of whatever record they found. The absent
// entry's empty signature matches no site's, so `call_indirect` refuses at
// its type check where a face was reached the reading never demanded.
// THE ARENA'S LEAVES are two more regions past the faces: the evacuation
// leaves and the scan leaves, each at its index and each `$ft1`-typed, so
// the exit dispatches a leaf by index through one `call_indirect` — index
// 0 the opaque answer, a leaf that never scans its none — and the module
// a dispatcher writes is as flat at three hundred leaves as at one.
fn emit_fn_table(fn_names, wide_names, native_half, jvp_faces, leaves) = {
  let n = len(fn_names)
  let live = arena_live()
  if n == 0 && !live {
    ()
  } else {
    let word_faces = if native_half { 2 } else { 1 }
    let faces = match jvp_faces {
      Some(_) => word_faces + 1,
      None => word_faces,
    }
    let leaf_slots = if live { 2 * (len(leaves) + 1) } else { 0 }
    wat_emit("  (table $fns ")
    wat_emit(int_to_str(fn_table_base() + faces * n + leaf_slots))
    wat_emit(" funcref)\n")
    if live { emit_arena_table(fn_table_base() + faces * n, leaves) } else { () }
    if n == 0 { () } else { emit_fn_faces(fn_names, wide_names, native_half, jvp_faces, n, word_faces) }
  }
}

fn emit_arena_table(base, leaves) = {
  let scan_base = base + len(leaves) + 1
  wat_emit("  (global $ar_evac_base i32 (i32.const {int_to_str(base)}))\n  (global $ar_scan_base i32 (i32.const {int_to_str(scan_base)}))\n")
  wat_emit("  (elem $ar_evac_leaves (i32.const {int_to_str(base)}) $ar_evac_none")
  each(emit_evac_ref, leaves)
  wat_emit(")\n  (elem $ar_scan_leaves (i32.const {int_to_str(scan_base)}) $ar_scan_none")
  each(emit_scan_ref, leaves)
  wat_emit(")\n")
}

fn emit_evac_ref(leaf) = wat_emit(" $evac_{evac_leaf_sig(leaf)}")

fn emit_scan_ref(leaf) = if evac_leaf_scans(leaf) {
  wat_emit(" $scan_{evac_leaf_sig(leaf)}")
} else {
  wat_emit(" $ar_scan_none")
}

fn emit_fn_faces(fn_names, wide_names, native_half, jvp_faces, n, word_faces) = {
  wat_emit("  (elem $fns (i32.const ")
  wat_emit(int_to_str(fn_table_base()))
  wat_emit(")")
  emit_fn_refs(fn_names, wide_names)
  wat_emit(")\n")
  if native_half {
    wat_emit("  (global $native_face i32 (i32.const {int_to_str(n)}))\n")
    wat_emit("  (elem $fns_native (i32.const {int_to_str(fn_table_base() + n)})")
    emit_native_refs(fn_names)
    wat_emit(")\n")
  } else {
    ()
  }
  match jvp_faces {
    Some(fs) => {
      wat_emit("  (global $jvp_face i32 (i32.const {int_to_str(word_faces * n)}))\n")
      wat_emit("  (elem $fns_jvp (i32.const {int_to_str(fn_table_base() + word_faces * n)})")
      emit_native_refs(fs)
      wat_emit(")\n")
      wat_emit("  (func $__jvp_absent (unreachable))\n")
    },
    None => (),
  }
}

// Each table symbol's derivative face, by name: the twin the reading
// demanded, or the absent stub.
fn jvp_face_names(faces, names) = map(jvp_face_of(faces, ??), names)

fn jvp_face_of(faces, name: String) = match smap_get(faces, name) {
  Some(twin) => twin,
  None => "__jvp_absent",
}

fn jvp_face_map(pairs) = fold(smap_new(), jvp_face_add, pairs)

fn jvp_face_add(m, p) = match p {
  (sym, twin) => smap_add(m, sym, twin),
}

// The native half: each symbol at its own face — the half a site that proves
// a wide vector reads.
fn emit_native_refs(names) = each(
  (name) => {
    wat_emit(" $")
    wat_emit(name)
  },
  names
)

// A call vector with a wide slot — the sites that reach the native face.
fn vector_is_wide(v) = match v {
  (ps, r) => repr_is_wide(r) || any(repr_is_wide, ps),
}

// The first index an emitted function may occupy. One home, read by both
// index producers — the per-name globals and the static closure records'
// baked words — so the two cannot drift apart.
fn fn_table_base() = 1

// The table index of a named fn, the ONE derivation. The static closure
// data segments bake this word (a data segment cannot read a global, which
// is why the position is searched here rather than carried), and the
// per-name idx globals count from the same base.
fn fn_table_idx(all_names, name) = fn_table_base() + ls_find_str_local(all_names, name, 0)

// A wide-signatured fn's table slot holds its $wf$ word wrapper — the same
// POSITION (every idx global and closure mint unchanged), a word FACE.
fn emit_fn_refs(names, wide_names) = each(
  (name) => {
    let wide = any((w) => field_name_eq(w, name), wide_names)
    wat_emit(if wide { " $wf$" } else { " $" })
    wat_emit(slot_face(name))
  },
  names
)

// A list slot's store reached through the table lands on its journaling face
// where an arena lives (`emit_arena_runtime`), at the same position: a
// direct call carries the stored value's leaf, and a call through a value
// cannot.
fn slot_face(name: String) = if name == "list_set" && arena_live() { "list_set_v" } else { name }

// Per-function table-index globals. At LMakeClosure emit, we push
// `(global.get $<name>_idx)` to get the i32 table index — no list
// lookup needed at emit time. One global per top-level function.
fn emit_fn_index_globals(names, base_idx) = each(
  {
    (i, name) => {
      wat_emit("  (global $")
      wat_emit(name)
      wat_emit("_idx i32 (i32.const ")
      wat_emit(int_to_str(base_idx + i))
      wat_emit("))\n")
    },
  },
  enumerate(names)
)

// Top-level closure records as STATIC DATA. The graph knows every
// top-level fn's closure layout at compile time — fn_idx + 0
// captures = 8 bytes per record. We emit `(data ...)` segments at
// module-load addresses [256, 256+8N) populated with little-endian
// `[fn_idx, 0]`, and `(global $<name> i32 (i32.const <addr>))`
// pointing to each. No runtime closure-init routine; no
// startup walk; the host populates the records during module
// instantiation. DESIGN Ch 4 "the graph IS the program" — emit
// projects state directly, doesn't generate code that builds it.
//
// Layout: the static-closure region is [heap_base, 0x10000) — it starts AT
// heap_base (4096), never below, for two laws: (1) page 0 belongs to the
// SUBSTRATE — the sentinel space plus the thread-record region
// [0x800, 0x1000); the runtime owns no static address there (io.mn's old
// scratch map is DELETED — every syscall record allocs per use — after a
// record seated at 0x108 was clobbered by the first fs path write the
// mentl server ever ran: a runtime fn's fn_ptr became "x.ht", 2026-07-10);
// (2) the eq/compare sentinel guard word-compares anything below
// heap_base, and a closure record is a heap value. Interned data strings
// begin at 0x10000, so the region holds 7680 records; the bump heap
// starts at 1MB. The whole layout as ONE fold — each region's base IS the
// previous region's limit, overlap unconstructible — is the named ultimate
// form (Hβ.emit.image-map-fold, band D).
//
// Each top-level closure occupies 8 bytes:
//   offset 0: fn_idx (i32 LE)
//   offset 4: capture_count = 0 (i32 LE)
//
// Top-level fns can capture nothing because they have no enclosing
// lexical frame at lower time. Inline lambdas still construct
// closure records dynamically at LMakeClosure emit (their captures
// are non-empty in general).
//
// Module VALUE bindings — the declaration half of the edge whose reference
// half (VarRef → LGlobal → `(global.get $<name>)`) always existed. One
// mutable global per top-level value let, zero-initialized; $__init_lets
// writes the real value before main runs.
fn emit_top_let_globals(value_lets) = value_lets |> each({
  (name, _) => {
    wat_emit("  (global $")
    wat_emit(name)
    wat_emit(" (mut i32) (i32.const 0))\n")
  },
})

// ─── The rooted-image persist substrate (§4④: persist = memcpy) ─────
// Emitted only when the reachable tree performs an image op (Law 7: an
// image-free module — the wheel included — stays byte-identical). The
// module projects three facts over ITSELF:
//   $build_key — a hash of the fn table names, the interned data, and the
//     mutable-global census: exactly the same-build-only word classes a
//     restored image's baked words depend on (table indices, interned
//     offsets, the globals record layout). Equal keys ⟺ the image's
//     pointers and indices resolve identically in this module.
//   $globals_save / $globals_restore — the mutable-global record, slot
//     order = image_global_slots below, 8 bytes per slot (a wide feedback
//     slot stores at its own repr). Slot 0 is the heap line; the persist
//     packer patches it to the image extent so a restore rewinds
//     allocation to the persisted moment.
//   $image_restore — read the wire header into locals, restore the
//     globals FROM THE WIRE (before the copy: the wire may lie inside the
//     image range), then ONE memory.copy of the image over [0, size).
//     memory.copy has memmove semantics — the overlapping self-copy is
//     exact by spec — so no staging buffer exists; wasm call frames live
//     engine-side, so the executing stack survives its own image swap.
fn emit_image_substrate(wasi_ops, line_globals, value_lets, yield_seen, table_all, string_entries) = {
  let used =
    ls_find_str_local(wasi_ops, "image_key", 0) >= 0 || ls_find_str_local(wasi_ops, "globals_area", 0) >= 0 || ls_find_str_local(wasi_ops, "globals_save", 0) >= 0 || ls_find_str_local(wasi_ops, "image_restore", 0) >= 0
  if used {
    let slots = image_global_slots(line_globals, value_lets, yield_seen)
    emit_build_key(table_all, string_entries, slots)
    wat_emit("  (func $globals_area_impl (result i32)(i32.const ")
    wat_emit(int_to_str(8 * len(slots)))
    wat_emit("))\n")
    emit_globals_pair(slots)
    // VIRGINITY IS THE RESTORE'S CONTRACT TOO ($heap_reset_impl's law at
    // the image altitude): the restored heap line rewinds to the image
    // extent, so [size, old-bump) — this process's dead pre-swap heap —
    // must read as never-allocated, or post-restore allocations serve
    // stale bytes as unwritten slots (measured: the warm path's saturate
    // walk read a dead spine as a canon table and faulted; the two-process
    // fixture survived only by allocating almost nothing after its swap).
    // Order: capture the old bump first; restore globals from the wire
    // BEFORE the copy (the wire may lie inside the image range); copy the
    // image down; zero everything between the restored line and the old.
    //
    wat_emit("  (func $image_restore (param $p i32) (result i32) (local $k i32) (local $size i32) (local $g i32) (local $old i32)(local.set $old (call $heap_mark_impl))(local.set $k (i32.load offset=4 (local.get $p)))(local.set $size (i32.load offset=8 (local.get $p)))(local.set $g (i32.mul (i32.load offset=12 (local.get $p)) (i32.const 8)))(if (i32.ne (local.get $g) (call $globals_area_impl))(then (unreachable)))(call $globals_restore (i32.add (local.get $p) (i32.const 16)))(call $memory_reach (local.get $size))(memory.copy (i32.const 0)(i32.add (i32.add (local.get $p) (i32.const 16)) (local.get $g))(local.get $size))(if (i32.gt_u (local.get $old) (local.get $size))(then (memory.fill (local.get $size)(i32.const 0)(i32.sub (local.get $old) (local.get $size)))))(local.get $k))\n")
  } else {
    ()
  }
}

// The census: the mutable globals an image carries, in the record's slot
// order — the substrate trio, the yield quartet when the module yields, one
// address word per static `<~` line (the ring itself is an image record the
// copy carries), one word per top-level let (their globals are word-faced by
// construction). An arena's globals are not among them: its depth, mark and
// journal length describe extents open on the writer's stack, which no image
// carries, so a resumed process runs outside every arena its writer had
// open, and what the image holds of an open arena's region is ordinary heap
// there, which no exit reclaims.
fn image_global_slots(line_globals, value_lets, yield_seen) = {
  let yq = if yield_seen > 0 {
    [("yield_flag", "i32"), ("yield_op", "i32"), ("yield_k", "i32"), ("yield_args", "i32")]
  } else {
    []
  }
  [("heap_ptr", "i32"), ("world_g", "i32"), ("tid_g", "i32")] ++ yq ++ line_globals ++ map({ (name, _) => (name, "i32") }, value_lets)
}

fn emit_globals_pair(slots) = {
  wat_emit("  (func $globals_save (param $dst i32)\n")
  each(
    {
      (i, sl) => match sl {
        (name, rw) => {
          wat_emit("    (")
          wat_emit(rw)
          wat_emit(".store offset=")
          wat_emit(int_to_str(8 * i))
          wat_emit(" (local.get $dst) (global.get $")
          wat_emit(name)
          wat_emit("))\n")
        },
      },
    },
    enumerate(slots)
  )
  wat_emit("  )\n")
  wat_emit("  (func $globals_restore (param $src i32)\n")
  each(
    {
      (i, sl) => match sl {
        (name, rw) => {
          wat_emit("    (global.set $")
          wat_emit(name)
          wat_emit(" (")
          wat_emit(rw)
          wat_emit(".load offset=")
          wat_emit(int_to_str(8 * i))
          wat_emit(" (local.get $src)))\n")
        },
      },
    },
    enumerate(slots)
  )
  wat_emit("  )\n")
}

// The key mixes name content order-sensitively (FNV-style, wrapping i32
// arithmetic): a reordered table, a changed literal, or a reshaped
// globals record all move the key, and nothing else the image depends on
// exists outside those three sources.
fn emit_build_key(table_all, string_entries, slots) = {
  let h1 = fold(16777619, image_key_mix, table_all)
  let h2 = fold(
    h1,
    (h, entry) => match entry {
      (s, _) => image_key_mix(h, s),
    },
    string_entries
  )
  let h3 = fold(
    h2,
    (h, sl) => match sl {
      (nm, _) => image_key_mix(h, nm),
    },
    slots
  )
  wat_emit("  (global $build_key i32 (i32.const ")
  wat_emit(int_to_str(h3))
  wat_emit("))\n")
}

fn image_key_mix(h, s) = i32_xor(h * 16777619, str_hash(s))

// The module init fn — every top-level value let's init expression runs in
// SOURCE ORDER, each result stored to its global, before _start invokes
// main (effectful initializers still run for library-shape modules). The
// pairs are iterated directly — the top-level LLet node itself never
// reaches emit_expr (its arm emits local.set, wrong at module level).
//
// The init bodies emit under the SAME local `~> emit_memory_bump` bracket
// every fn body rides (emit_one_fn_to_string's shape): emit_expr performs
// the evidence-dispatched emit_alloc (three memory handlers exist, so the
// op is not singleton-tiered), and the file's convention is that each
// body-emission installs its own bracket so the evidence resolves at the
// install, never through a distant frame. This path sat dead (zero
// value_lets since birth), so its missing bracket was invisible until the
// first top-level let the medium ever compiled key-scanned an unthreaded
// region into the 0x100000000 fault — RED-proven by
// tests/frontier/mn-top-level-let.mn against the pre-fix boot.
fn emit_init_lets(value_lets) = if len(value_lets) > 0 {
  wat_emit("  (func $__init_lets (param $__state i32) (result i32)")
  wat_emit(" (local $state_tmp i32)")
  wat_emit(" (local $f64_tmp f64)")
  wat_emit(" (local $wide_cell i32)")
  wat_emit(" (local $scrut_tmp i32)")
  wat_emit(" (local $callee_closure i32)")
  wat_emit(" (local $alloc_size i32)")
  wat_emit(" (local $loop_i i32)")
  emit_named_locals(walk_locals_list(map({ (_, init) => init }, value_lets), []), [])
  wat_emit("\n")
  wat_emit(emit_init_lets_body(value_lets))
  wat_emit("    (i32.const 0)\n  )\n")
}

// The inits emit as `$__init_lets`' own body, so a static `<~` in one names
// its ring global for that owner (`init_lets_lines`).
fn emit_init_lets_body(ref value_lets) = {
  emit_init_lets_loop(value_lets, 0, len(value_lets))
  wat_collect()
} ~> emit_site_named("__init_lets") ~> emit_memory_bump ~> wat_to_string

fn emit_init_lets_loop(ref value_lets, i, n) = if i >= n {
  ()
} else {
  match list_index(value_lets, i) {
    (name, init) => {
      emit_expr(init)
      wat_emit("(global.set $")
      wat_emit(name)
      wat_emit(")\n")
      emit_init_lets_loop(value_lets, i + 1, n)
    },
  }
}

// $__init_lines — the static sites' rings, allocated once per instance
// before any line ticks ($__init_lets' shape and bracket: a module-scope
// allocating emission installs its own allocation strategy inside the
// sink). Each owner's rings are sized under the owner's own bracket — the
// floor's pairs are empty, a twin's are its instantiation — the same read
// the site's body emission makes of its slot width.
fn emit_init_lines(owners, rings) = if len(owners) > 0 {
  wat_emit("  (func $__init_lines (param $__state i32) (result i32) (local $state_tmp i32)\n")
  wat_emit(emit_init_lines_body(owners, rings))
  wat_emit("    (i32.const 0)\n  )\n")
}

// The lines, then the derivative reading's tangent rings beside them — a
// ring always has its line's owner among the owners, so the one function
// allocates both, once per instance.
fn emit_init_lines_body(owners, rings) = {
  each(emit_owner_lines, owners)
  each(emit_tangent_ring, rings)
  wat_collect()
} ~> emit_memory_bump ~> wat_to_string

fn emit_ring_zero(ring) = match ring {
  TangentRing(r) => wat_emit("    (memory.fill (i32.add (global.get ${tline_global_name(r.site, r.owner)}) (i32.const 8)) (i32.const 0) (i32.const {int_to_str(r.depth * 8)}))\n"),
}

fn emit_tangent_ring(ring) = match ring {
  TangentRing(r) => {
    emit_alloc(8 + r.depth * 8, "state_tmp")
    wat_emit("    (global.set $")
    wat_emit(tline_global_name(r.site, r.owner))
    wat_emit(" (local.get $state_tmp))\n")
  },
}

fn emit_owner_lines(owner) = match owner {
  (sym, lines, pairs, enc) => {
    spec_ctx_set(pairs, enc)
    each(
      {
        (h, depth, _home) => {
          emit_alloc(line_ring_bytes(h, depth), "state_tmp")
          wat_emit("    (global.set $")
          wat_emit(line_global_name(h, sym))
          wat_emit(" (local.get $state_tmp))\n")
        },
      },
      lines
    )
    spec_ctx_clear()
  },
}

fn emit_static_top_closures(top_names, all_names, base_slot) = each(
  {
    (i, name) => {
      let fn_idx = fn_table_idx(all_names, name)
      let addr = heap_base() + (base_slot + i) * 8
      // Static data segment for the 8-byte closure record.
      wat_emit("  (data (i32.const ")
      wat_emit(int_to_str(addr))
      wat_emit(") \"")
      emit_le4_escape(fn_idx)
      emit_le4_escape(0)
      wat_emit("\")\n")
      // Immutable global pointing at the record. VarRef → LGlobal →
      // (global.get $<name>) returns the static closure pointer.
      wat_emit("  (global $")
      wat_emit(name)
      wat_emit(" i32 (i32.const ")
      wat_emit(int_to_str(addr))
      wat_emit("))\n")
    },
  },
  enumerate(top_names)
)

fn emit_le4_escape(n) = {
  emit_byte_escape(n % 256)
  emit_byte_escape(n / 256 % 256)
  emit_byte_escape(n / 65536 % 256)
  emit_byte_escape(n / 16777216 % 256)
}

fn emit_byte_escape(b) = {
  wat_emit("\\")
  wat_emit(hex_digit(b / 16))
  wat_emit(hex_digit(b % 16))
}

// One glyph of the shared hex table (lib/strings.mn hex_glyphs — the same
// bytes the formatter's `\xHH` renders), as the one-byte string wat_emit
// takes.
fn hex_digit(d) = str_slice(hex_glyphs(), d, d + 1)

// The function types every call_indirect names, projected from the module's
// call vectors (collected once in the plan): the arity family $ftN the
// word face speaks, then one typed face per distinct wide vector.
fn emit_type_section(vectors, yield_seen) = {
  // The arity-keyed all-i32 $ftN types ARE the all-RI32 instances of the
  // collected vectors (PLAN §5.U — the arity-$ftN fork dissolves into the
  // repr-vector key), so the max arity is a PROJECTION of them. _start calls
  // main via $ft1 (__state alone); floor 1 keeps that entry for call-free
  // programs. A YIELDING module floors at 2: the composer's own W7 indirects
  // (inner(v), frame_k(r)) are 2-arg all-i32 = $ft2, and a yielding module
  // with only UZero arms may carry no other 2-arg site (the bank's FT SEAM,
  // Ruling 1) — the miss would be a loud assembly error, so the floor
  // interns it.
  let observed = max_vector_arity(vectors, 0)
  let floor = if yield_seen > 0 { 2 } else { 1 }
  let max_arity = if observed < floor { floor } else { observed }
  emit_type_decls(0, max_arity)
  emit_typed_ft_decls(vectors, [])
}

// The typed faces: each DISTINCT vector with a wide slot, declared once under
// the name its call sites spell (`vector_ft_name`). The all-word vectors are
// the arity family `emit_type_decls` declared above; a program with no wide
// call site declares none here (the wheel's own bytes do not move).
fn emit_typed_ft_decls(vectors, seen) = if len(vectors) == 0 {
  ()
} else {
  let v = last(vectors)
  let name = vector_ft_name(v)
  let typed = match v {
    (ps, r) => !(all(repr_is_i32, ps) && repr_is_i32(r)),
  }
  if typed && !string_in_list(seen, name) {
    match v {
      (ps, r) => {
        wat_emit("  (type {name} (func")
        each(emit_param_decl, ps)
        wat_emit(" (result {repr_wat(r)})))\n")
      },
    }
    // drift-audit: ignore — the distinct-name set of one module's vectors, bounded by its call sites
    emit_typed_ft_decls(drop_last(vectors), [name] ++ seen)
  } else {
    emit_typed_ft_decls(drop_last(vectors), seen)
  }
}

fn emit_param_decl(r) = wat_emit(" (param {repr_wat(r)})")

// EVERY vector's max param count — the $ftN ceiling. It reads the wide
// vectors too: a wide callee's $wf$ face is its arity's $ftN, and a floor
// caller may reach it at that arity.
fn max_vector_arity(vectors, acc) = if len(vectors) == 0 {
  acc
} else {
  match last(vectors) {
    (param_reprs, _result_repr) => max_vector_arity(drop_last(vectors), max_int(acc, len(param_reprs))),
  }
}

// Walk the lowered program collecting the repr-vector (param_reprs,
// result_repr) at every indirect-dispatch site — the same vectors the call
// sites reference via call_ft_name. Only call-producing variants contribute.
fn collect_call_vectors_list(stmts, acc) = if len(stmts) == 0 {
  acc
} else {
  collect_call_vectors_list(drop_last(stmts), collect_call_vectors_expr(last(stmts), acc))
}

// Match-arm bodies carry calls too — skipping them starved the $ft table
// of every vector that appears only inside an arm (the face-9 pre-empt:
// seven collectors shared this hole; census 2026-07-06).
fn collect_call_vectors_arms(arms, acc) = collect_call_vectors_arms_from(arms, acc, 0)

fn collect_call_vectors_arms_from(arms, acc, i) = if i >= len(arms) {
  acc
} else {
  match list_index(arms, i) {
    (_, body) => collect_call_vectors_arms_from(arms, collect_call_vectors_expr(body, acc), i + 1),
  }
}

fn collect_call_vectors_expr(expr, acc) = match expr {
  LShow(h, x) => collect_call_vectors_expr(show_node_of(h, x), acc),
  LHash(h, x) => collect_call_vectors_expr(hash_node_of(h, x), acc),
  LDirectCall(_h, _fh, _n, _t, args) => collect_call_vectors_list(args, acc),
  LCall(h, f, args) => collect_call_vectors_expr(f, collect_call_vectors_list(args, [call_site_vector(f, args, h)] ++ acc)),
  LTailCall(h, f, args) => collect_call_vectors_expr(f, collect_call_vectors_list(args, [call_site_vector(f, args, h)] ++ acc)),
  LResumeK(_h, k, v) => // The resume speaks the word face (`emit_word_face_call`) — its arity's
  // all-word vector, exactly what the emit names.
  collect_call_vectors_expr(k, collect_call_vectors_expr(v, [word_vector(1)] ++ acc)),
  LPerform(h, d, args) => // Every perform's vector is registered — the walked forms dispatch through
  // call_indirect and need the type; the direct ones cost nothing to include
  // and the set is deduped. The site's own vector, or a driver's word face —
  // the same choice the emit arm makes.
  collect_call_vectors_list(args, [perform_site_vector(h, d, args)] ++ acc),
  LLet(_h, _n, inner) => collect_call_vectors_expr(inner, acc),
  LBinOp(_h, _op, l, r) => collect_call_vectors_expr(r, collect_call_vectors_expr(l, acc)),
  LUnaryOp(_h, _op, i) => collect_call_vectors_expr(i, acc),
  LReturn(_h, i) => collect_call_vectors_expr(i, acc),
  LMakeClosure(_h, LFn(_n, _a, _p, body, _f, _l), caps) => collect_call_vectors_list(body, collect_call_vectors_list(caps, acc)),
  LMakeContinuation(_h, LFn(_n, _a, _p, body, _f, _l), caps, _, _) => collect_call_vectors_list(body, collect_call_vectors_list(caps, acc)),
  LYield(_h, _op, args, k) => collect_call_vectors_expr(k, collect_call_vectors_list(args, acc)),
  LKExtend(_h, k) => collect_call_vectors_expr(k, acc),
  LDeclareFn(LFn(_n, _a, _p, body, _f, _l)) => collect_call_vectors_list(body, acc),
  LIf(_h, c, t, e) => collect_call_vectors_list(e, collect_call_vectors_list(t, collect_call_vectors_expr(c, acc))),
  LBlock(_h, stmts) => collect_call_vectors_list(stmts, acc),
  LMakeList(_h, es) => collect_call_vectors_list(es, acc),
  LMakeTuple(_h, es) => collect_call_vectors_list(es, acc),
  LSimdLanes(_h, lanes) => collect_call_vectors_list(lanes, acc),
  LFanout(_h, lex, _, forms) => collect_call_vectors_expr(fanout_form(lex, forms), acc),
  LMakeRecord(_h, fs) => collect_call_vectors_list(fs, acc),
  LMakeVariant(_h, _t, fs) => collect_call_vectors_list(fs, acc),
  LMatch(_h, s, arms) => collect_call_vectors_arms(arms, collect_call_vectors_expr(s, acc)),
  LHandleWith(_h, b, hn, _hn2, inits, _arms) => collect_call_vectors_expr(b, collect_call_vectors_expr(hn, collect_call_vectors_list(inits, acc))),
  LDerive(_h, seed, b) => collect_call_vectors_expr(b, collect_call_vectors_expr(seed, acc)),
  LArena(_h, b) => collect_call_vectors_expr(b, acc),
  LFeedback(_h, _d, _home, b, s) => collect_call_vectors_expr(s, collect_call_vectors_expr(b, acc)),
  LWasiCall(_h, _n, args) => collect_call_vectors_list(args, acc),
  LFieldLoad(_h, rec, _o) => collect_call_vectors_expr(rec, acc),
  LConvert(_h, _, operand) => collect_call_vectors_expr(operand, acc),
  LStateSlotStore(_h, _o, v, _) => collect_call_vectors_expr(v, acc),
  LStateInit(_h, _hn, _s, v) => collect_call_vectors_expr(v, acc),
  LConst(_, _) => acc,
  LLocal(_, _) => acc,
  LFeedbackPrior(_) => acc,
  LGlobal(_, _) => acc,
  LUpval(_, _) => acc,
  LInvariantFailure(_, _) => acc,
}

// The all-word vector of an n-argument call — the arity face, state first.
// Vectors are prepended (cons), not appended: the emit order of distinct
// function types is immaterial (call_indirect matches by structural type,
// not declaration order), so the O(1) cons is the residue form of the append.
fn word_vector(n_args) = (map((_) => RI32, range(0, n_args + 1)), RI32)

// A perform's vector — the site's own (`call_site_vector`), or a driver's
// word face.
fn perform_site_vector(h, d, args) = match d {
  PdDriver(_, _) => word_vector(len(args)),
  _ => perform_vector_at(h, args),
}

// Emit each DISTINCT non-i32 repr-vector once. The seen list carries the ft_names
// already emitted; an all-i32 vector is skipped (its $ftN already exists from
// emit_type_decls). Dedup is by name = structural function-type equality.
fn max_int(a, b) with Pure = if a > b { a } else { b }

fn emit_type_decls(i, max) = if i > max {
  ()
} else {
  wat_emit("  (type $ft")
  wat_emit(int_to_str(i))
  wat_emit(" (func")
  emit_param_types(i)
  wat_emit(" (result i32)))\n")
  emit_type_decls(i + 1, max)
}

fn emit_param_types(n) = if n == 0 {
  ()
} else {
  wat_emit(" (param i32)")
  emit_param_types(n - 1)
}

// The word face of the indirect boundary: functions whose native signature
// carries a wide slot reach the table through a $wf$ wrapper; repr_is_i32 is
// the wideness read the wrapper generator and the ceiling share.
fn repr_is_i32(r) with Pure = match r {
  RI32 => true,
  _ => false,
}

// call_ft_name — the WORD face's type: the arity family, spoken only by a
// caller blind to its callee (`emit_word_face_call`, a driver's perform).
// There a wide value crosses as the address of its bytes and the callee sits
// in the table behind its $wf$ wrapper. It was the convention for EVERY
// indirect call from 2026-07-21, chosen because a polymorphic site could not
// know its callee's emission (the float-evidence-ft trap class, four hits);
// total monomorphization gave every ordinary site that knowledge, so a site
// that proves a wide vector reaches the native face (`emit_closure_call`) and
// allocates nothing.
fn call_ft_name(args) = "$ft{int_to_str(len(args) + 1)}"

fn emit_header() = wat_emit("(module\n")

fn emit_footer() = wat_emit(")\n")

// emit_runtime_imports — the WASI import section, projected from the program's
// actual LWasiCall usage (project_emit_state's fifth projection). proc_exit is
// emitted by _start's epilogue (outside the program graph), so it's injected;
// every other import appears iff the program invokes its op. No hardcoded list:
// the graph IS the import set, so it can never drift from what is called.
fn emit_runtime_imports(wasi_ops) = {
  emit_one_wasi_import("proc_exit")
  each((op) => if op != "proc_exit" { emit_one_wasi_import(op) }, wasi_ops)
}

// One `(import "<module>" "<field>" (func $<op> <sig>))`, module and field
// read from the op's host_import entry. The internal name is `$<op>` (no
// prefix) — the import IS the bridge, matching LWasiCall's `(call $<op>)`.
// Ops with no host entry (atomics, thread-spawn — WASM instructions or
// imported elsewhere) carry no import.
fn emit_one_wasi_import(op) = match host_import(op) {
  None => (),
  Some((module, field, _, _)) => {
    wat_emit("  (import \"")
    wat_emit(module)
    wat_emit("\" \"")
    wat_emit(field)
    wat_emit("\"\n    (func $")
    wat_emit(op)
    wat_emit(" ")
    wat_emit(wasi_import_sig(op))
    wat_emit("))\n")
  },
}

// The FFI boundary's one home: every host-served op with its import module,
// field name and ABI widths. The preview1 rows ride wasi_import_reprs (field
// = op name, the p1 convention); the medium's own seam is the `mentl_host`
// module tools/runner serves (lib/io.mn's Host effect).
fn host_import(op) = match wasi_import_reprs(op) {
  Some((preprs, res)) => Some(("wasi_snapshot_preview1", op, preprs, res)),
  None => if op == "host_wat_write" {
    Some(("mentl_host", "wat_write", [RI32, RI32], None))
  } else if op == "host_exec" {
    Some(("mentl_host", "exec", [RI32, RI32], Some(RI32)))
  } else {
    None
  },
}

// The WASI preview1 ABI signatures — the FFI boundary's external facts as
// DATA (Repr vectors), keyed on the op name LWasiCall carries. ONE home,
// two projections: the import-decl string (wasi_import_sig) and the
// call-site arg widths (emit_wasi_args_at_widths — a word arg filling an
// i64 param extends at the boundary). None = not a preview1 import.
fn wasi_import_reprs(op) = if op == "proc_exit" {
  Some(([RI32], None))
} else if op == "fd_write" {
  Some(([RI32, RI32, RI32, RI32], Some(RI32)))
} else if op == "fd_read" {
  Some(([RI32, RI32, RI32, RI32], Some(RI32)))
} else if op == "fd_close" {
  Some(([RI32], Some(RI32)))
} else if op == "fd_prestat_get" {
  Some(([RI32, RI32], Some(RI32)))
} else if op == "fd_prestat_dir_name" {
  Some(([RI32, RI32, RI32], Some(RI32)))
} else if op == "fd_fdstat_get" {
  Some(([RI32, RI32], Some(RI32)))
} else if op == "path_open" {
  Some(([RI32, RI32, RI32, RI32, RI32, RI64, RI64, RI32, RI32], Some(RI32)))
} else if op == "path_create_directory" {
  Some(([RI32, RI32, RI32], Some(RI32)))
} else if op == "path_filestat_get" {
  Some(([RI32, RI32, RI32, RI32, RI32], Some(RI32)))
} else if op == "path_unlink_file" {
  Some(([RI32, RI32, RI32], Some(RI32)))
} else if op == "path_rename" {
  Some(([RI32, RI32, RI32, RI32, RI32, RI32], Some(RI32)))
} else if op == "fd_readdir" {
  Some(([RI32, RI32, RI32, RI64, RI32], Some(RI32)))
}
// The socket pair (2026-07-10, mentl serves natively): sock_accept takes the
// PREOPENED listener (wasmtime -S tcplisten) and yields a connection fd that
// fd_read/fd_write/fd_close already speak; poll_oneoff is the preview1
// blocking wait the nonblocking listener demands (accept without it spins
// on EAGAIN=6). The probe that proved the contract: scratch sockprobe4.wat.
else if op == "sock_accept" {
  Some(([RI32, RI32, RI32], Some(RI32)))
} else if op == "poll_oneoff" {
  Some(([RI32, RI32, RI32, RI32], Some(RI32)))
}
// argv, read live at _start — (argc_ptr, buf_size_ptr) and (argv_ptr, buf_ptr),
// both returning errno. This is what makes `mentl <verb>` reach a verb.
else if op == "args_sizes_get" {
  Some(([RI32, RI32], Some(RI32)))
} else if op == "args_get" {
  Some(([RI32, RI32], Some(RI32)))
} else {
  None
}

fn wat_frag_concat(a: String, b: String) -> String = a ++ b

// The import-decl string — a PROJECTION of host_import's widths.
// "" = not a host import (skip), the emitter's existing contract.
fn wasi_import_sig(op) = match host_import(op) {
  None => "",
  Some((_, _, preprs, res)) => {
    let params = wat_frag_concat(
      preprs |> map(repr_wat) |> fold("(param", (acc, w) => wat_frag_concat(wat_frag_concat(acc, " "), w)),
      ")"
    )
    match res {
      None => params,
      Some(r) => wat_frag_concat(wat_frag_concat(wat_frag_concat(params, " (result "), repr_wat(r)), ")"),
    }
  },
}

// Each preview1 arg at its declared ABI width — the call-site projection of
// wasi_import_reprs. An RI64 param takes the word arg zero-extended (rights
// bitmasks / directory cookies are bit-carries, wait_i32's extend precedent);
// every other param passes at its own width.
fn emit_wasi_args_at_widths(args, preprs, i) = if i >= len(args) {
  ()
} else {
  emit_expr(list_index(args, i))
  if i < len(preprs) {
    match list_index(preprs, i) {
      RI64 => wat_emit("    (i64.extend_i32_u)\n"),
      _ => (),
    }
  } else {
    ()
  }
  emit_wasi_args_at_widths(args, preprs, i + 1)
}

fn emit_memory_decl(spawns, imports_image, wants_rmw) = {
  // The memory's OWNERSHIP follows the module's own proof, and there are
  // TWO proofs, because two different consumers need the host to hold the
  // image. This read used to be ONE — "does it spawn?" — with the import
  // decision proxied through it, and the proxy broke the moment the last
  // spawn left the wheel: `mentl space` emitted a DEFINED memory and the
  // runner refused it ("the socket seam needs a guest that imports its
  // shared memory"), because a trampoline module cannot share a memory the
  // guest defines.
  //
  //   SPAWNS       — the wasi-threads convention: the host creates one
  //                  memory and links it into every instance, root and
  //                  spawned alike (a DEFINED memory is per-instance, so a
  //                  child of a defining module reads a fresh zeroed
  //                  image). This is what needs the thread-spawn import.
  //   SOCKET SEAM  — the runner builds a trampoline module over the SAME
  //                  memory to serve the five socket-facing p1 entries, and
  //                  it can only do that for a memory the host owns.
  //
  // Either proof imports the image and re-exports it for the preview1 ABI
  // (the p1 host locates guest memory through the "memory" export). A
  // module with neither owns a self-contained defined memory and ships no
  // thread-spawn import — nothing to satisfy, any preview1 host runs it.
  //
  // Initial 32 pages (2MB: the string table below 1MB, the heap line at
  // 1MB), max 65536 (4GB, the wasm32 ceiling). THE ALLOCATOR GROWS THE
  // MEMORY ON DEMAND ($memory_reach, beside $alloc): the bump line crossing
  // the current size grows by at least 256 pages, and a grow the host
  // refuses is `unreachable` — a loud OOM, never a silent wrap. This used to
  // read initial = max = 65536, because the allocator never grew: 32768
  // initial silently starved a wheel-scale compile — the first record past
  // 2GB "succeeded" arithmetically and the first READ of it trapped OOB
  // (m3's m4-generation died in reach's str_eq, 2026-07-09). A 4GB minimum
  // is exactly what no browser will allocate, so the page ran a derived
  // copy of the boot with the import's minimum hand-shrunk (2026-07-29 —
  // eight weeks stale by 2026-09-27). The page runs the boot itself now;
  // the runner links the imported memory at this declared type and the
  // guest grows it. Shared requires a max; the line moves under every
  // instance through the ONE grow path, which every instance sees.
  if spawns {
    wat_emit("  (import \"wasi\" \"thread-spawn\" (func $wasi_thread_spawn (param i32) (result i32)))\n")
  } else {
    ()
  }
  if imports_image {
    wat_emit("  (import \"env\" \"memory\" (memory 32 65536 shared))\n")
    wat_emit("  (export \"memory\" (memory 0))\n")
  } else {
    wat_emit("  (memory (export \"memory\") 32 65536 shared)\n")
  }
  if spawns {
    // The task-invocation fn type — the 0-arg closure protocol (record as
    // __state, word result). A dedicated name: the $ftN family is
    // projected from the program's own call vectors, so a hand-emitted
    // reference to $ft1 would couple the thread entry to an incidental
    // collection; wat2wasm dedups structurally at the binary layer.
    wat_emit("  (type $ft_task (func (param i32) (result i32)))\n")
  } else {
    ()
  }
  // Bump heap starts at 1MB. The 64KB..1MB region holds static
  // string data (W5) and can accommodate future static tables. In a
  // thread-free module the heap pointer is this global; in a spawning
  // module it is the shared CELL at address 64 (globals are
  // per-instance — a global bump pointer cannot serve two instances of
  // one image), and this global is inert.
  wat_emit("  (global $heap_ptr (mut i32) (i32.const 1048576))\n")
  // Per-instance identity: 0 on the root instance; the thread entry
  // stamps the host thread id on a spawned one. The thread_id op reads
  // it — a per-instance global IS instance-local storage, which is what
  // makes current_id answerable. Unconditional (a thread-free module's
  // thread_id truthfully answers 0).
  wat_emit("  (global $tid_g (mut i32) (i32.const 0))\n")
  // The live WORLD — the top of the install chain, the runtime half of
  // TCont's world index (the world-as-value substrate; PLAN named-residue
  // Hβ.cli.infer-context-bracket carries the converged design). A node is
  // [key@0][record@4][parent@8] — one per effect group per live install,
  // consed by $world_push, save/restored around every install extent by
  // the LHandleWith emit. 0 = the empty world. R1 is chain-only (writers
  // balanced, no reader); the perform swap reads it next rung.
  wat_emit("  (global $world_g (mut i32) (i32.const 0))\n")
  // THE WORLD OF THE PERFORM AN ARM IS ANSWERING. A dispatch sets $world_g to
  // the arm's world (the chain outside its own install — the deep-handler
  // law) and restores the performer's after, so nothing an arm calls can see
  // the world the perform stood in. A spawn needs exactly that world for the
  // branch it starts: the spawned instance must answer the schedule's own ops
  // (`current_id`, a nested `spawn`) and every install inside the schedule's
  // extent, and the arm's world holds none of them — measured 2026-09-30, a
  // branch asking its thread id faulted at the chain's end on every boot
  // since B1. Every dispatch saves the performer's world here beside its
  // own swap, per instance, and restores the enclosing value after the arm
  // returns; $spawn_task_impl stores it in the task record.
  wat_emit("  (global $perform_world_g (mut i32) (i32.const 0))\n")
  // The ONE allocator, emitted once — every construction, closure record, and
  // handler-state alloc is a `(call $alloc SIZE)` against this fn. Both bodies:
  // return the current pointer, advance it by (size+7)&-8 so every record
  // starts 8-byte aligned and the heap image stays memcpy-serializable (§5.U);
  // wraparound traps. The STRATEGY lives in this body alone — every call site
  // is strategy-invariant. A spawning module bumps the shared CELL at address
  // 64 (page 0, clear of the postmortem words at 0/4) with a compare-exchange
  // retry loop, so every instance — root and spawned — allocates from ONE line
  // over ONE image and a record any task allocates is readable from all; a
  // thread-free module bumps the per-instance global. Emitted directly (not
  // through a `~>` perform) because a body-emitting perform trips the
  // evidence-dispatch seam today.
  // $memory_reach — the memory covers [0, end) on return, or the module
  // refuses. The needed page count is `((end - 1) >> 16) + 1` (exact at the
  // 4GB edge, where `(end + 65535) >> 16` wraps); a shortfall grows by at
  // least 256 pages (16MB — a wheel-scale compile grows ~64 times, a micro
  // never), never past the 4GB max, and a refused grow or an unreachable
  // need is `unreachable`. The loop re-reads memory.size each pass, so two
  // instances growing at once both land: the saturating select makes a
  // sibling's grow read as "nothing left to do", never as a wrapped delta.
  wat_emit("  (func $memory_reach (param $end i32)(local $need i32)(local $delta i32)(local.set $need (i32.add (i32.shr_u (i32.sub (local.get $end)(i32.const 1))(i32.const 16))(i32.const 1)))(block $done (loop $again (br_if $done (i32.le_u (local.get $need)(memory.size)))(local.set $delta (select (i32.sub (local.get $need)(memory.size))(i32.const 0)(i32.gt_u (local.get $need)(memory.size))))(if (i32.eqz (local.get $delta))(then (br $again)))(if (i32.lt_u (local.get $delta)(i32.const 256))(then (local.set $delta (i32.const 256))))(if (i32.gt_u (local.get $delta)(i32.sub (i32.const 65536)(memory.size)))(then (local.set $delta (i32.sub (i32.const 65536)(memory.size)))))(if (i32.eqz (local.get $delta))(then (unreachable)))(if (i32.eq (memory.grow (local.get $delta))(i32.const -1))(then (unreachable)))(br $again))))\n")
  if spawns {
    wat_emit("  (func $alloc (param $size i32) (result i32)(local $ptr i32)(local $new i32)(block $won (loop $retry (local.set $ptr (i32.atomic.load (i32.const 64)))(local.set $new (i32.add (local.get $ptr)(i32.and (i32.add (local.get $size)(i32.const 7))(i32.const -8))))(if (i32.lt_u (local.get $new)(local.get $ptr))(then (unreachable)))(call $memory_reach (local.get $new))(br_if $won (i32.eq (i32.atomic.rmw.cmpxchg (i32.const 64)(local.get $ptr)(local.get $new))(local.get $ptr)))(br $retry)))(local.get $ptr))\n")
  } else {
    wat_emit("  (func $alloc (param $size i32) (result i32)(local $ptr i32)(local $new i32)(local.set $ptr (global.get $heap_ptr))(local.set $new (i32.add (local.get $ptr)(i32.and (i32.add (local.get $size)(i32.const 7))(i32.const -8))))(if (i32.lt_u (local.get $new)(local.get $ptr))(then (unreachable)))(call $memory_reach (local.get $new))(global.set $heap_ptr (local.get $new))(local.get $ptr))\n")
  }
  // heap_mark reads the live heap line. The strategy owns WHERE the line
  // lives (per-instance global vs shared cell), so the read is a fn beside
  // $alloc and every heap_mark call site stays strategy-invariant.
  if spawns {
    wat_emit("  (func $heap_mark_impl (result i32)(i32.atomic.load (i32.const 64)))\n")
  } else {
    wat_emit("  (func $heap_mark_impl (result i32)(global.get $heap_ptr))\n")
  }
  // heap_reset RESTORES VIRGINITY: the region [mark, bump) is zeroed before
  // the rewind, so the post-reset world is bit-identical to the
  // never-allocated world. The whole runtime's zero-reads (slot_present's
  // Option niche, every unwritten make_list slot) held only by the ACCIDENT
  // of monotonicity — wasm's zero-init pages made unwritten slots read 0
  // because memory was never reused; the first reuse without this fill
  // served stale bytes as placed arg slots (the battery's compile-#2 kill).
  // A dedicated fn, never inline: the fill needs a temporary for the mark,
  // and the callers' scratch locals may be live (the wrong-scratch class).
  // The reset writes the line where the strategy keeps it.
  if spawns {
    wat_emit("  (func $heap_reset_impl (param $mark i32)(local.get $mark)(i32.const 0)(i32.atomic.load (i32.const 64))(local.get $mark)(i32.sub)(memory.fill)(i32.atomic.store (i32.const 64)(local.get $mark)))\n")
  } else {
    wat_emit("  (func $heap_reset_impl (param $mark i32)(local.get $mark)(i32.const 0)(global.get $heap_ptr)(local.get $mark)(i32.sub)(memory.fill)(global.set $heap_ptr (local.get $mark)))\n")
  }
  // $world_push — cons one [key@0][entry@4][parent@8][install_world@12]
  // node onto the live world chain (the install's runtime edge; a
  // dedicated fn like $heap_reset_impl, never inline — the callers' scratch
  // may be live at the install site). entry is the install's own
  // [record][base] view (ONE view object, never copied); install_world is
  // the chain as saved BEFORE this install's pushes — the world the arm
  // dispatch sets around the arm call (deep-handler semantics: an arm's
  // performs resolve
  // outer, never self).
  wat_emit("  (func $world_push (param $key i32)(param $entry i32)(param $iw i32)(local $n i32)(local.set $n (call $alloc (i32.const 16)))(local.get $n)(local.get $key)(i32.store offset=0)(local.get $n)(local.get $entry)(i32.store offset=4)(local.get $n)(global.get $world_g)(i32.store offset=8)(local.get $n)(local.get $iw)(i32.store offset=12)(global.set $world_g (local.get $n)))\n")
  // $ev_declaring_node — THE WALK, the exact dual of the push above and
  // therefore its neighbour. Walk the chain from $top: stop at the first node
  // whose key@0 is the sought effect AND whose record has a NONZERO arm in
  // this op's slot, which is the declaring test — emit_arm_writes skips the
  // ops a handler does not implement and pad_group_to_effect_ops makes every
  // slot present, so the zero is readable, and table slot 0 is reserved null
  // so a real arm can never look like one. The arm address is the same one
  // the perform's emit computes inline: record + 8 + 4*nstate + 4*(base+slot),
  // where entry@4 is the install's own [record][base] view.
  //
  // THE KEY IS THE OP, NOT THE EFFECT. Keyed on the effect alone, this
  // stopped at the innermost node for the effect whether or not that handler
  // answers the op — a split-effect pair returned 15 where 33 is correct,
  // with no diagnostic, a clean assemble and no trap. The compile-time walk
  // had the identical error and got caught by the assembler; this one indexed
  // a live arm region and ran.
  //
  // A miss is a BROKEN PROMISE, not a value: the sought key goes to scratch
  // word 0 (the postmortem window) and then a load at 0xFFFFFFFF traps — a
  // 4-byte read crossing 2^32, out of bounds at ANY wasm32 size including the
  // full 65536 pages. `0 - 8` was the prior choice and went SILENT once memory
  // reached 4GB, where 0xFFFFFFF8+4 is in bounds: the miss returned a virgin 0
  // and the broken promise surfaced as a garbage dispatch far from here.
  wat_emit("  (func $ev_declaring_node (param $top i32)(param $target i32)(param $slot i32)(result i32)(local $n i32)(local $entry i32)(local $record i32)(local.set $n (local.get $top))(block $done (loop $walk (br_if $done (i32.eqz (local.get $n)))(if (i32.eq (i32.load offset=0 (local.get $n))(local.get $target))(then (local.set $entry (i32.load offset=4 (local.get $n)))(local.set $record (i32.load offset=0 (local.get $entry)))(if (i32.load (i32.add (local.get $record)(i32.add (i32.const 8)(i32.add (i32.mul (i32.const 4)(i32.load offset=4 (local.get $record)))(i32.mul (i32.const 4)(i32.add (i32.load offset=4 (local.get $entry))(local.get $slot)))))))(then (return (local.get $n))))))(local.set $n (i32.load offset=8 (local.get $n)))(br $walk)))(i32.const 0)(local.get $target)(i32.store)(i32.load (i32.const -1)))\n")
  // The task record — [task closure@0][completion@4][result@8][world@12],
  // allocated per spawn through the ONE allocator (no static slot region,
  // no capacity ceiling, no tid ledger; every record is heap-uniform and
  // 8-aligned, so the completion word at +4 meets the atomics' alignment
  // by construction). The world word is the live install chain AT THE
  // SPAWN: a branch runs in the world it was spawned in — the chain and
  // every handler record live in the shared image, so the fresh instance
  // reads them as its own, where before it started at world 0 and the
  // first perform inside a branch walked nothing and faulted at the
  // 0x100000000 belt (measured 2026-09-27). $spawn_task_impl builds it,
  // hands its address to
  // the host's thread-spawn import as the start argument, refuses loudly
  // on a host spawn failure (a negative id — resource exhaustion is a
  // fact the developer must see, never a silent inline fallback), and
  // returns the record. $join_task_impl atomic-waits on the completion
  // word (the wait returns not-equal immediately when the flag already
  // flipped — the loop re-checks, so there is no lost-wake window), then
  // reads the result. The completion word is stored 0 explicitly: the
  // synchronization protocol owns its own initialization rather than
  // leaning on the allocator's virginity contract. Emitted only for a
  // spawning module (Law 7 — thread-free modules are byte-identical).
  //
  if spawns {
    wat_emit("  (func $spawn_task_impl (param $clo i32) (result i32)(local $t i32)(local.set $t (call $alloc (i32.const 16)))(i32.store offset=0 (local.get $t)(local.get $clo))(i32.store offset=4 (local.get $t)(i32.const 0))(i32.store offset=12 (local.get $t)(global.get $perform_world_g))(if (i32.lt_s (call $wasi_thread_spawn (local.get $t))(i32.const 0))(then (unreachable)))(local.get $t))\n")
    wat_emit("  (func $join_task_impl (param $t i32) (result i32)(block $done (loop $wait (br_if $done (i32.eq (i32.atomic.load (i32.add (local.get $t)(i32.const 4)))(i32.const 1)))(drop (memory.atomic.wait32 (i32.add (local.get $t)(i32.const 4))(i32.const 0)(i64.const -1)))(br $wait)))(i32.load offset=8 (local.get $t)))\n")
  }
  // The single-operand read-modify-write dispatch: a nullary RmwOp ctor
  // IS its tag word (the sentinel representation), and the declaration
  // order in threading.mn IS this table — RmwAdd=0, RmwSub=1, RmwAnd=2,
  // RmwOr=3, RmwXor=4, RmwXchg=5. An out-of-range tag traps (the
  // exhaustive-match floor at the instruction altitude). Emitted only
  // when the program performs atomic_rmw (Law 7).
  if wants_rmw {
    wat_emit("  (func $atomic_rmw_impl (param $addr i32) (param $op i32) (param $val i32) (result i32)(block $bad (block $b5 (block $b4 (block $b3 (block $b2 (block $b1 (block $b0 (br_table $b0 $b1 $b2 $b3 $b4 $b5 $bad (local.get $op)))(return (i32.atomic.rmw.add (local.get $addr)(local.get $val))))(return (i32.atomic.rmw.sub (local.get $addr)(local.get $val))))(return (i32.atomic.rmw.and (local.get $addr)(local.get $val))))(return (i32.atomic.rmw.or (local.get $addr)(local.get $val))))(return (i32.atomic.rmw.xor (local.get $addr)(local.get $val))))(return (i32.atomic.rmw.xchg (local.get $addr)(local.get $val))))(unreachable))\n")
  }
}

// ─── THE ARENA (lib/arena.mn) — the journal and the exit ─────────────────
//
// An arena is an extent of the one heap line: what its body allocated past
// its mark dies at its exit except what its publication reaches. The body's
// value is reached through its type; what the body stored into memory OLDER
// than the arena is reached through the JOURNAL, which every such store
// writes where it happens. The exit moves what is reached and slides it down
// to where the extent began, so the line ends just past the survivors and
// everything above it is zero again.
//
// THE JOURNAL. An entry is two words: the slot a store wrote, and the leaf
// its value moves through. The barrier knows the type wherever the store can
// reach memory older than an arena: the judgment reads each store's target
// along its value's edges — fresh, a parameter its callers answer for, a
// handler's state its installs answer for, or older — and a store that can
// reach older memory reads its value as a move (`MovedShape`), so its body is
// twinned by the class that move needs. A list slot (`list_set`'s direct
// call, through `$list_set_j`), a handler's state commit and a `<~` tick each
// write the leaf where the store happens; a store whose value's type no twin
// bound writes leaf 0, as does `list_set` reached as a value (through its
// table face), and a word stores with no barrier at all. Only stores
// into memory below the innermost open arena's mark are journaled, and only
// while one is open — outside, a barrier costs one compare. The journal's
// block is the instance's first allocation (below).
//
// THE EXIT asks no one. The sweep checks every journaled slot that holds a
// value of the region: an entry whose type its barrier could not see (leaf
// 0 — a function, a continuation, a variable no twin bound) and an
// overflowed journal KEEP the region, nothing moved, which is sound for any
// program. Otherwise every such value moves through its leaf into scratch
// above the region (a copy's address is its TEMP; the original's first word
// holds it, a bitmap says it moved, the copy log remembers the word it
// overwrote), the copies are scanned in order (Cheney's queue, the log), and
// the pass commits: roots are rewritten from TEMP to FINAL, the copies slide
// down in one `memory.copy`, every byte the exit touched above the new line
// is zeroed, and the line moves. A value no leaf can move — a function, a
// continuation, a type the emitter could not see — found while moving makes
// the exit ABORT instead: every moved original gets its first word back,
// every root its value, and the region is kept. A spawning module's arena is
// its body alone (`Hβ.arena.per-instance-regions`).
//
// The census rides five counters `arena_stat` reads: exits, kept exits, the
// KB reclaimed and moved, and the highest line an exit reached.
fn emit_arena_runtime() = {
  wat_emit("  (global $ar_depth (mut i32) (i32.const 0))\n  (global $ar_mark (mut i32) (i32.const 0))\n  (global $ar_jb (mut i32) (i32.const 0))\n  (global $ar_jn (mut i32) (i32.const 0))\n  (global $ar_jover (mut i32) (i32.const 0))\n")
  wat_emit("  (global $ar_m (mut i32) (i32.const 0))\n  (global $ar_t (mut i32) (i32.const 0))\n  (global $ar_bm (mut i32) (i32.const 0))\n  (global $ar_bmsz (mut i32) (i32.const 0))\n  (global $ar_rl (mut i32) (i32.const 0))\n  (global $ar_rn (mut i32) (i32.const 0))\n  (global $ar_ll (mut i32) (i32.const 0))\n  (global $ar_ln (mut i32) (i32.const 0))\n  (global $ar_lscan (mut i32) (i32.const 0))\n  (global $ar_c0 (mut i32) (i32.const 0))\n  (global $ar_cp (mut i32) (i32.const 0))\n  (global $ar_cend (mut i32) (i32.const 0))\n  (global $ar_dst (mut i32) (i32.const 0))\n  (global $ar_delta (mut i32) (i32.const 0))\n  (global $ar_abort (mut i32) (i32.const 0))\n")
  wat_emit("  (global $ar_exits (mut i32) (i32.const 0))\n  (global $ar_kept (mut i32) (i32.const 0))\n  (global $ar_freed (mut i32) (i32.const 0))\n  (global $ar_moved (mut i32) (i32.const 0))\n  (global $ar_high (mut i32) (i32.const 0))\n")
  // The block — 262144 journal entries of 8 bytes — is the instance's FIRST
  // allocation (`emit_start`), below every mark any code can take, so no
  // region, commit, keep or reset ever moves or frees it, and a persisted
  // image holds it at the same address its resuming instance does. (It was
  // allocated per outermost arena and reclaimed by compacting the survivors
  // onto it; an exit that KEPT its region left the block under it and the
  // next arena allocated another, two megabytes per keep, until the line ran
  // out — 2026-10-03, the first run in which the compiler's own judgment
  // kept regions.)
  wat_emit("  (func $arena_enter (if (i32.eqz (global.get $ar_depth)) (then (global.set $ar_jn (i32.const 0)) (global.set $ar_jover (i32.const 0)))) (global.set $ar_depth (i32.add (global.get $ar_depth) (i32.const 1))) (global.set $ar_mark (call $heap_mark_impl)))\n")
  wat_emit("  (func $ar_journal (param $a i32) (param $b i32) (local $e i32) (if (i32.ge_u (global.get $ar_jn) (i32.const 262144)) (then (global.set $ar_jover (i32.const 1)) (return))) (local.set $e (i32.add (global.get $ar_jb) (i32.shl (global.get $ar_jn) (i32.const 3)))) (i32.store (local.get $e) (local.get $a)) (i32.store offset=4 (local.get $e) (local.get $b)) (global.set $ar_jn (i32.add (global.get $ar_jn) (i32.const 1))))\n")
  wat_emit("  (func $arena_slot_note (param $s i32) (param $k i32) (if (i32.eqz (global.get $ar_depth)) (then (return))) (if (i32.ge_u (local.get $s) (global.get $ar_mark)) (then (return))) (call $ar_journal (local.get $s) (local.get $k)))\n")
  // A list slot's barrier, called in place of `list_set` by a direct call
  // (`direct_call_target`) with the leaf of the value the call stores. Only a
  // word list's slot can hold a pointer — a byte list or a packed float list
  // stores none — so the barrier reads the tag word the store itself is about
  // to read.
  wat_emit("  (func $list_set_j (param $st i32) (param $l i32) (param $i i32) (param $v i32) (param $k i32) (result i32) (if (i32.eqz (i32.load offset=4 (local.get $l))) (then (call $arena_slot_note (i32.add (local.get $l) (i32.add (i32.const 8) (i32.shl (local.get $i) (i32.const 2)))) (local.get $k)))) (return_call $list_set (local.get $st) (local.get $l) (local.get $i) (local.get $v)))\n")
  // The same store reached through the table — `list_set` as a value, called
  // where the stored type is not known: its slot holds this face
  // (`slot_face`), which journals with leaf 0, so an exit that finds a value
  // of its region there keeps the region rather than move what it cannot read.
  wat_emit("  (func $list_set_v (param $st i32) (param $l i32) (param $i i32) (param $v i32) (result i32) (return_call $list_set_j (local.get $st) (local.get $l) (local.get $i) (local.get $v) (i32.const 0)))\n")
  // A journal entry read back: the slot it names, and the leaf its value
  // moves through (-3 a boxed float, 0 a type its barrier could not see, a
  // leaf index otherwise).
  wat_emit("  (func $ar_entry_slot (param $e i32) (result i32) (i32.load (local.get $e)))\n")
  wat_emit("  (func $ar_entry_leaf (param $e i32) (result i32) (i32.load offset=4 (local.get $e)))\n")
  // The moving machinery the leaves call.
  wat_emit("  (func $ar_young (param $p i32) (result i32) (i32.and (i32.ge_u (local.get $p) (global.get $ar_m)) (i32.lt_u (local.get $p) (global.get $ar_t))))\n")
  wat_emit("  (func $ar_fwd (param $p i32) (result i32) (local $i i32) (local.set $i (i32.shr_u (i32.sub (local.get $p) (global.get $ar_m)) (i32.const 3))) (i32.and (i32.load8_u (i32.add (global.get $ar_bm) (i32.shr_u (local.get $i) (i32.const 3)))) (i32.shl (i32.const 1) (i32.and (local.get $i) (i32.const 7)))))\n")
  wat_emit("  (func $ar_copy (param $p i32) (param $sz i32) (param $k i32) (result i32) (local $t i32) (local $n i32) (local $e i32) (local $i i32) (if (global.get $ar_abort) (then (return (local.get $p)))) (if (i32.lt_u (local.get $sz) (i32.const 4)) (then (return (local.get $p)))) (if (i32.gt_u (i32.add (local.get $p) (local.get $sz)) (global.get $ar_t)) (then (global.set $ar_abort (i32.const 1)) (return (local.get $p)))) (local.set $n (i32.and (i32.add (local.get $sz) (i32.const 7)) (i32.const -8))) (local.set $t (global.get $ar_cp)) (if (i32.gt_u (i32.add (local.get $t) (local.get $n)) (global.get $ar_cend)) (then (global.set $ar_abort (i32.const 1)) (return (local.get $p)))) (local.set $e (i32.add (global.get $ar_ll) (i32.mul (global.get $ar_ln) (i32.const 12)))) (if (i32.gt_u (i32.add (local.get $e) (i32.const 12)) (global.get $ar_c0)) (then (global.set $ar_abort (i32.const 1)) (return (local.get $p)))) (call $memory_reach (i32.add (local.get $t) (local.get $n))) (memory.copy (local.get $t) (local.get $p) (local.get $sz)) (global.set $ar_cp (i32.add (local.get $t) (local.get $n))) (i32.store (local.get $e) (local.get $p)) (i32.store offset=4 (local.get $e) (local.get $k)) (i32.store offset=8 (local.get $e) (i32.load (local.get $p))) (global.set $ar_ln (i32.add (global.get $ar_ln) (i32.const 1))) (local.set $i (i32.shr_u (i32.sub (local.get $p) (global.get $ar_m)) (i32.const 3))) (local.set $e (i32.add (global.get $ar_bm) (i32.shr_u (local.get $i) (i32.const 3)))) (i32.store8 (local.get $e) (i32.or (i32.load8_u (local.get $e)) (i32.shl (i32.const 1) (i32.and (local.get $i) (i32.const 7))))) (i32.store (local.get $p) (local.get $t)) (local.get $t))\n")
  wat_emit("  (func $ar_box8 (param $p i32) (result i32) (if (i32.eqz (call $ar_young (local.get $p))) (then (return (local.get $p)))) (if (call $ar_fwd (local.get $p)) (then (return (i32.load (local.get $p))))) (call $ar_copy (local.get $p) (i32.const 8) (i32.const 0)))\n")
  wat_emit("  (func $ar_opaque (param $p i32) (if (call $ar_young (local.get $p)) (then (global.set $ar_abort (i32.const 1)))))\n")
  // Index 0 of the two leaf regions (`emit_arena_table`): the value no leaf
  // moves, and the copy with nothing to scan.
  wat_emit("  (func $ar_evac_none (param $p i32) (result i32) (call $ar_opaque (local.get $p)) (local.get $p))\n  (func $ar_scan_none (param $t i32) (result i32) (i32.const 0))\n")
  wat_emit("  (func $ar_stride (param $sc i32) (result i32) (if (result i32) (i32.eq (local.get $sc) (i32.const 1)) (then (i32.const 1)) (else (if (result i32) (i32.eq (local.get $sc) (i32.const 2)) (then (i32.const 8)) (else (if (result i32) (i32.eq (local.get $sc) (i32.const 3)) (then (i32.const 16)) (else (if (result i32) (i32.eq (local.get $sc) (i32.const 4)) (then (i32.const 2)) (else (i32.const 4))))))))))\n")
  wat_emit("  (func $ar_final (param $r i32) (result i32) (if (result i32) (i32.ge_u (local.get $r) (global.get $ar_c0)) (then (i32.sub (local.get $r) (global.get $ar_delta))) (else (local.get $r))))\n")
  wat_emit("  (func $ar_zero (param $a i32) (param $b i32) (param $f i32) (if (i32.lt_u (local.get $a) (local.get $f)) (then (local.set $a (local.get $f)))) (if (i32.gt_u (local.get $b) (local.get $a)) (then (memory.fill (local.get $a) (i32.const 0) (i32.sub (local.get $b) (local.get $a))))))\n")
  // The sweep: the check, the scratch above the region, and the roots.
  wat_emit("  (func $arena_sweep (param $m i32) (param $j0 i32) (result i32) (local $t i32) (local $i i32) (local $e i32) (local $s i32) (local $v i32) (local $k i32) (local $n i32) (local $r i32)\n")
  wat_emit("    (global.set $ar_exits (i32.add (global.get $ar_exits) (i32.const 1))) (local.set $t (call $heap_mark_impl)) (global.set $ar_m (local.get $m)) (global.set $ar_t (local.get $t)) (global.set $ar_abort (i32.const 0)) (global.set $ar_bm (i32.const 0)) (global.set $ar_rn (i32.const 0)) (global.set $ar_ln (i32.const 0)) (global.set $ar_lscan (i32.const 0))\n")
  wat_emit("    (if (global.get $ar_jover) (then (return (i32.const 0))))\n")
  wat_emit("    (local.set $i (local.get $j0)) (block $ok (loop $chk (br_if $ok (i32.ge_u (local.get $i) (global.get $ar_jn))) (local.set $e (i32.add (global.get $ar_jb) (i32.shl (local.get $i) (i32.const 3)))) (if (call $ar_young (i32.load (call $ar_entry_slot (local.get $e)))) (then (if (i32.eqz (call $ar_entry_leaf (local.get $e))) (then (return (i32.const 0)))))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $chk)))\n")
  wat_emit("    (local.set $n (i32.sub (local.get $t) (local.get $m))) (global.set $ar_bm (local.get $t)) (global.set $ar_bmsz (i32.and (i32.add (i32.shr_u (local.get $n) (i32.const 6)) (i32.const 15)) (i32.const -8))) (global.set $ar_rl (i32.add (global.get $ar_bm) (global.get $ar_bmsz))) (global.set $ar_ll (i32.add (global.get $ar_rl) (i32.shl (i32.add (i32.sub (global.get $ar_jn) (local.get $j0)) (i32.const 1)) (i32.const 3)))) (global.set $ar_c0 (i32.and (i32.add (i32.add (global.get $ar_ll) (i32.add (local.get $n) (i32.shr_u (local.get $n) (i32.const 1)))) (i32.const 7)) (i32.const -8))) (global.set $ar_cp (global.get $ar_c0)) (global.set $ar_cend (i32.add (global.get $ar_c0) (local.get $n)))\n")
  wat_emit("    (global.set $ar_dst (local.get $m)) (global.set $ar_delta (i32.sub (global.get $ar_c0) (global.get $ar_dst))) (call $memory_reach (global.get $ar_ll))\n")
  wat_emit("    (local.set $i (local.get $j0)) (block $done (loop $root (br_if $done (i32.ge_u (local.get $i) (global.get $ar_jn))) (br_if $done (global.get $ar_abort)) (local.set $e (i32.add (global.get $ar_jb) (i32.shl (local.get $i) (i32.const 3)))) (local.set $s (call $ar_entry_slot (local.get $e))) (local.set $v (i32.load (local.get $s))) (if (call $ar_young (local.get $v)) (then (local.set $k (call $ar_entry_leaf (local.get $e))) (if (i32.or (i32.gt_s (local.get $k) (i32.const 0)) (i32.eq (local.get $k) (i32.const -3))) (then (local.set $r (i32.add (global.get $ar_rl) (i32.shl (global.get $ar_rn) (i32.const 3)))) (i32.store (local.get $r) (local.get $s)) (i32.store offset=4 (local.get $r) (local.get $v)) (global.set $ar_rn (i32.add (global.get $ar_rn) (i32.const 1))) (i32.store (local.get $s) (if (result i32) (i32.eq (local.get $k) (i32.const -3)) (then (call $ar_box8 (local.get $v))) (else (call $ar_evac_by (local.get $k) (local.get $v))))))))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $root)))\n")
  wat_emit("    (i32.const 1))\n")
  // The close: drain the queue, then commit or restore, then pop.
  wat_emit("  (func $ar_scratch_clear (call $ar_zero (global.get $ar_bm) (i32.add (global.get $ar_bm) (global.get $ar_bmsz)) (i32.const 0)) (call $ar_zero (global.get $ar_rl) (i32.add (global.get $ar_rl) (i32.shl (global.get $ar_rn) (i32.const 3))) (i32.const 0)) (call $ar_zero (global.get $ar_ll) (i32.add (global.get $ar_ll) (i32.mul (global.get $ar_ln) (i32.const 12))) (i32.const 0)) (call $ar_zero (global.get $ar_c0) (global.get $ar_cp) (i32.const 0)))\n")
  wat_emit("  (func $ar_restore (local $i i32) (local $e i32) (local.set $i (i32.const 0)) (block $d1 (loop $l1 (br_if $d1 (i32.ge_u (local.get $i) (global.get $ar_ln))) (local.set $e (i32.add (global.get $ar_ll) (i32.mul (local.get $i) (i32.const 12)))) (i32.store (i32.load (local.get $e)) (i32.load offset=8 (local.get $e))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l1))) (local.set $i (i32.const 0)) (block $d2 (loop $l2 (br_if $d2 (i32.ge_u (local.get $i) (global.get $ar_rn))) (local.set $e (i32.add (global.get $ar_rl) (i32.shl (local.get $i) (i32.const 3)))) (i32.store (i32.load (local.get $e)) (i32.load offset=4 (local.get $e))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l2))))\n")
  wat_emit("  (func $ar_commit (param $m i32) (local $i i32) (local $e i32) (local $s i32) (local $f i32) (local.set $s (i32.sub (global.get $ar_cp) (global.get $ar_c0))) (local.set $i (i32.const 0)) (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (global.get $ar_rn))) (local.set $e (i32.load (i32.add (global.get $ar_rl) (i32.shl (local.get $i) (i32.const 3))))) (i32.store (local.get $e) (i32.sub (i32.load (local.get $e)) (global.get $ar_delta))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))\n")
  wat_emit("    (if (i32.gt_u (i32.shr_u (global.get $ar_cp) (i32.const 10)) (global.get $ar_high)) (then (global.set $ar_high (i32.shr_u (global.get $ar_cp) (i32.const 10))))) (memory.copy (global.get $ar_dst) (global.get $ar_c0) (local.get $s)) (local.set $f (i32.add (global.get $ar_dst) (local.get $s)))\n")
  wat_emit("    (call $ar_zero (local.get $m) (global.get $ar_t) (local.get $f)) (call $ar_scratch_clear)\n")
  wat_emit("    (global.set $ar_freed (i32.add (global.get $ar_freed) (i32.shr_u (i32.sub (global.get $ar_t) (local.get $f)) (i32.const 10)))) (global.set $ar_moved (i32.add (global.get $ar_moved) (i32.shr_u (local.get $s) (i32.const 10)))) (global.set $heap_ptr (local.get $f)))\n")
  wat_emit("  (func $ar_compact (param $j0 i32) (param $o i32) (local $i i32) (local $w i32) (local $e i32) (local $d i32) (local.set $i (local.get $j0)) (local.set $w (local.get $j0)) (block $done (loop $l (br_if $done (i32.ge_u (local.get $i) (global.get $ar_jn))) (local.set $e (i32.add (global.get $ar_jb) (i32.shl (local.get $i) (i32.const 3)))) (if (i32.lt_u (i32.load (local.get $e)) (local.get $o)) (then (local.set $d (i32.add (global.get $ar_jb) (i32.shl (local.get $w) (i32.const 3)))) (i32.store (local.get $d) (i32.load (local.get $e))) (i32.store offset=4 (local.get $d) (i32.load offset=4 (local.get $e))) (local.set $w (i32.add (local.get $w) (i32.const 1))))) (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l))) (call $ar_zero (i32.add (global.get $ar_jb) (i32.shl (local.get $w) (i32.const 3))) (i32.add (global.get $ar_jb) (i32.shl (global.get $ar_jn) (i32.const 3))) (i32.const 0)) (global.set $ar_jn (local.get $w)))\n")
  wat_emit("  (func $arena_close (param $m i32) (param $j0 i32) (param $o i32) (param $go i32) (result i32) (local $e i32) (local $k i32)\n")
  wat_emit("    (if (local.get $go) (then (block $done (loop $drain (br_if $done (global.get $ar_abort)) (br_if $done (i32.ge_u (global.get $ar_lscan) (global.get $ar_ln))) (local.set $e (i32.add (global.get $ar_ll) (i32.mul (global.get $ar_lscan) (i32.const 12)))) (global.set $ar_lscan (i32.add (global.get $ar_lscan) (i32.const 1))) (local.set $k (i32.load offset=4 (local.get $e))) (if (i32.gt_s (local.get $k) (i32.const 0)) (then (call $ar_scan_by (local.get $k) (i32.load (i32.load (local.get $e)))))) (br $drain))) (if (global.get $ar_abort) (then (call $ar_restore) (local.set $go (i32.const 0))))))\n")
  wat_emit("    (if (local.get $go) (then (call $ar_commit (local.get $m))) (else (global.set $ar_kept (i32.add (global.get $ar_kept) (i32.const 1))) (if (global.get $ar_bm) (then (call $ar_scratch_clear)))))\n")
  wat_emit("    (global.set $ar_depth (i32.sub (global.get $ar_depth) (i32.const 1))) (if (i32.eqz (global.get $ar_depth)) (then (global.set $ar_jn (i32.const 0))) (else (call $ar_compact (local.get $j0) (local.get $o)))) (global.set $ar_mark (local.get $o)) (global.set $ar_m (i32.const 0)) (global.set $ar_t (i32.const 0)) (local.get $go))\n")
  // The census read: a nullary ArenaStat IS its tag word, in declaration order.
  wat_emit("  (func $arena_stat_impl (param $s i32) (result i32) (block $b4 (block $b3 (block $b2 (block $b1 (block $b0 (br_table $b0 $b1 $b2 $b3 $b4 (local.get $s))) (return (global.get $ar_exits))) (return (global.get $ar_kept))) (return (global.get $ar_freed))) (return (global.get $ar_moved))) (global.get $ar_high))\n")
}

// What the emission reads of the module's arenas, settled by the plan: the
// evacuation leaves in index order, each leaf's index by its sig, and
// whether the arena is live at all — a module that opens none, and a
// spawning one, emit an arena as its body.
effect ArenaLeaves {
  set_arena_leaves([(String, Shape)], Bool)
  arena_leaves() -> [(String, Shape)]
  arena_leaf_index(String) -> Option(Int)
  arena_live() -> Bool
}

handler arena_registry with demanded = false, leaves = [], index = smap_new(), live = false {
  arena_demand_note() => resume() with demanded = true,
  arena_demanded() => resume(demanded),
  set_arena_leaves(xs, on) => resume() with leaves = xs, index = smap_build(leaf_numbering(xs)), live = on,
  arena_leaves() => resume(leaves),
  arena_leaf_index(sig) => resume(smap_get(index, sig)),
  arena_live() => resume(live),
}

// A leaf's index is its position plus one — the number a journal entry, a
// claim and a copy's scan carry, 0 being the opaque answer.
fn leaf_numbering(leaves) = fold([], number_leaf, leaves)

fn number_leaf(acc, leaf) = match leaf {
  (sig, _) => push(acc, (sig, len(acc) + 1)),
}

// An arena where one is live: its mark and the journal's length are saved
// as it opens; its body runs; the sweep checks and moves the roots its
// barriers journaled; the value moves through its own leaf; the close
// drains, commits or keeps, and pops. A value of a type no leaf moves aborts
// the exit when it is in the region, which keeps the region.
fn emit_arena(h, b) = {
  let hs = int_to_str(h)
  let t = evac_type_at(h)
  let ev = evac_of(t)
  wat_emit("    (local.set $__ar_o_{hs} (global.get $ar_mark))\n    (local.set $__ar_j_{hs} (global.get $ar_jn))\n    (call $arena_enter)\n    (local.set $__ar_m_{hs} (global.get $ar_mark))\n")
  emit_expr(b)
  wat_emit("    (local.set $__ar_v_{hs})\n    (local.set $__ar_g_{hs} (call $arena_sweep (local.get $__ar_m_{hs}) (local.get $__ar_j_{hs})))\n")
  match ev {
    EvShape(_) => wat_emit("    (local.set $__ar_r_{hs} (local.get $__ar_v_{hs}))\n    (if (local.get $__ar_g_{hs}) (then (if (call $ar_young (local.get $__ar_v_{hs})) (then (local.set $__ar_r_{hs} (call $evac_{evac_sig(t)} (local.get $__ar_v_{hs})))))))\n"),
    EvOpaque => wat_emit("    (if (local.get $__ar_g_{hs}) (then (call $ar_opaque (local.get $__ar_v_{hs}))))\n"),
    EvWord => (),
    EvWide => (),
  }
  wat_emit("    (local.set $__ar_g_{hs} (call $arena_close (local.get $__ar_m_{hs}) (local.get $__ar_j_{hs}) (local.get $__ar_o_{hs}) (local.get $__ar_g_{hs})))\n")
  match ev {
    EvShape(_) => wat_emit("    (if (local.get $__ar_g_{hs}) (then (local.set $__ar_v_{hs} (call $ar_final (local.get $__ar_r_{hs})))))\n"),
    EvOpaque => (),
    EvWord => (),
    EvWide => (),
  }
  wat_emit("    (local.get $__ar_v_{hs})\n")
}

// The arena's own registers, mirror-true to `emit_arena`: the outer mark,
// the journal length and the mark at entry, the go flag, the moved value's
// TEMP, and the value at its own width.
fn arena_locals(h) = {
  let hs = int_to_str(h)
  ["__ar_o_{hs} i32", "__ar_j_{hs} i32", "__ar_m_{hs} i32", "__ar_g_{hs} i32", "__ar_r_{hs} i32", "__ar_v_{hs} {repr_wat(repr_of(lookup_ty(h)))}"]
}

// ─── THE FIFTH FOLD LEAF — evacuation ──────────────────────────────────
//
// An arena's exit moves a value by its type, so the fold has a leaf for it:
// `$evac_<sig>` takes a value of the type and answers where its copy is —
// itself when it is not in the region, the copy a first visit made when it
// is — and `$scan_<sig>` moves what a copy points to. A pointer field the
// leaves cannot move (a function, a continuation, a type the emission could
// not see) aborts the exit if its value is in the region; the exit then
// keeps the region whole. What a type's value needs to move — the `Evac`
// class — is the lowering's (lower.mn `evac_of`), because a twin is keyed by
// it before anything is emitted.
fn evac_type_moves(ty) = evac_moves(evac_of(ty))

// The type a site's value moves by: the node's type under the bracket the
// site is emitted in, aliases and refinements stripped.
fn evac_type_at(h) = fold_strip(slot_ty(chase_deep(lookup_ty(h))))

// A site's class. A value with no node — a frame read the lowering minted —
// has a type the emission cannot see.
fn evac_at(h) = if h == 0 { EvOpaque } else { evac_of(evac_type_at(h)) }

// The leaf a value is moved through, as the exit's runtime reads it: a word
// is nothing to move, a float in a word slot is a box, a value no leaf can
// move is opaque, and a shape is the leaf at its index.
type EvacLeaf = LfWord | LfBoxed | LfOpaque | LfAt(Int)

// The runtime's encoding of a leaf — the one projection to the integers the
// journal, the claims and the dispatchers carry. (-2, absent, is the claims
// table's own answer and never a leaf.)
fn leaf_code(lf) = match lf {
  LfWord => -1,
  LfBoxed => -3,
  LfOpaque => 0,
  LfAt(k) => k,
}

fn evac_leaf(ty) = match evac_of(ty) {
  EvShape(_) => evac_leaf_named(evac_sig(ty)),
  EvOpaque => LfOpaque,
  EvWord => LfWord,
  EvWide => LfBoxed,
}

fn evac_sig(ty) = move_sig(fold_strip(slot_ty(ty)))

// A shape's leaf by its sig, settled before any function is written. A
// shape the fold collection never met is a site the plan did not see, and
// it says so: the barrier it would have written moves nothing.
fn evac_leaf_named(sig: String) = match arena_leaf_index(sig) {
  Some(k) => LfAt(k),
  None => {
    diag_report_at(
      EInternalInvariant(
        "an arena barrier asks for the leaf of `{sig}`, which the fold collection never met",
        span_zero()
      ),
      ""
    )
    LfOpaque
  },
}

// Whether a store of this node's value into older memory is journaled.
fn evac_journals(h) = evac_moves(evac_at(h))

fn evac_leaf_at(h) = if h == 0 { LfOpaque } else { evac_leaf(evac_type_at(h)) }

fn evac_leaf_sig(leaf) = match leaf {
  (s, _) => s,
}

fn evac_sig_is(sig: String, leaf) = match leaf {
  (s, _) => s == sig,
}

// A root the fold collection met: the type a site moves, kept once per sig.
fn evac_root_add(roots, ty) = match evac_of(ty) {
  EvShape(_) => {
    let t = fold_strip(slot_ty(ty))
    if any(same_move_sig(move_sig(t), ??), roots) { roots } else { push(roots, t) }
  },
  EvOpaque => roots,
  EvWord => roots,
  EvWide => roots,
}

fn same_move_sig(sig: String, r) = move_sig(r) == sig

// Every leaf the roots reach, each once by sig with the shape it moves by,
// in the order first met — the order the indices are read off.
fn evac_leaf_list(roots) = fold([], evac_add, roots)

fn evac_add(acc, ty) = match evac_of(ty) {
  EvShape(sh) => {
    let sig = evac_sig(ty)
    if any(evac_sig_is(sig, ??), acc) { acc } else { evac_add_shape(push(acc, (sig, sh)), sh) }
  },
  EvOpaque => acc,
  EvWord => acc,
  EvWide => acc,
}

// What a shape's copies point to: a sequence's elements, a product's
// fields, every variant's payloads.
fn evac_add_shape(acc, sh) = match sh {
  ShSeq(e) => evac_add(acc, e),
  ShProduct(ftys) => fold(acc, evac_add, ftys),
  ShSum(specs) => fold(acc, evac_add_variant, specs),
}

fn evac_add_variant(acc, spec) = match spec {
  (_, payloads) => fold(acc, evac_add, payloads),
}

// The bytes a product's fields span, each at its slot width.
fn evac_fields_end(ftys, off) = fold(off, evac_field_end, ftys)

fn evac_field_end(off, fty) = {
  let r = slot_repr(fold_strip(fty))
  align_for(off, r) + repr_width(r)
}

// Every leaf, then the two dispatchers the exit calls by index.
fn emit_evac_leaves(leaves) = {
  each(emit_evac_leaf, leaves)
  emit_evac_dispatch(leaves)
}

fn emit_evac_leaf(leaf) = match leaf {
  (sig, sh) => {
    let k = leaf_code(evac_leaf_named(sig))
    match sh {
      ShSeq(e) => emit_evac_seq(sig, k, e),
      ShProduct(ftys) => emit_evac_product(sig, k, ftys),
      ShSum(specs) => emit_evac_sum(sig, k, specs),
    }
  },
}

fn emit_evac_head(sig: String, locals: String) = {
  wat_emit("  (func $evac_{sig} (param $p i32) (result i32){locals}\n")
  wat_emit("    (if (i32.eqz (call $ar_young (local.get $p))) (then (return (local.get $p))))\n")
  wat_emit("    (if (call $ar_fwd (local.get $p)) (then (return (i32.load (local.get $p)))))\n")
}

// One pointer slot of a copy at `base + off`: its value, when it is in the
// region, moves and the slot takes the FINAL address. An element slot of a
// word list may hold a float only boxed, and the box moves.
fn emit_evac_slot(base: String, off, fty, boxed) = match evac_of(fty) {
  EvShape(_) => wat_emit("    (local.set $v (i32.load offset={int_to_str(off)} (local.get ${base}))) (if (call $ar_young (local.get $v)) (then (i32.store offset={int_to_str(off)} (local.get ${base}) (i32.sub (call $evac_{evac_sig(fty)} (local.get $v)) (global.get $ar_delta)))))\n"),
  EvOpaque => wat_emit("    (call $ar_opaque (i32.load offset={int_to_str(off)} (local.get ${base})))\n"),
  EvWide => if boxed {
    wat_emit("    (local.set $v (i32.load offset={int_to_str(off)} (local.get ${base}))) (if (call $ar_young (local.get $v)) (then (i32.store offset={int_to_str(off)} (local.get ${base}) (i32.sub (call $ar_box8 (local.get $v)) (global.get $ar_delta)))))\n")
  } else {
    ()
  },
  EvWord => (),
}

// A product's fields, each at its width-summed offset — the fold every
// construction and every load of the type runs.
fn emit_evac_fields(base: String, ftys, off) = match ftys {
  [] => (),
  [fty, ...rest] => {
    let r = slot_repr(fold_strip(fty))
    let here = align_for(off, r)
    emit_evac_slot(base, here, fty, false)
    emit_evac_fields(base, rest, here + repr_width(r))
  },
}

fn emit_evac_product(sig: String, k, ftys) = {
  let size = evac_fields_end(ftys, 0)
  let scans = any(evac_type_moves, ftys)
  emit_evac_head(sig, "")
  wat_emit("    (call $ar_copy (local.get $p) (i32.const {int_to_str(size)}) (i32.const {int_to_str(if scans { k } else { 0 })})))\n")
  if scans {
    wat_emit("  (func $scan_{sig} (param $t i32) (result i32) (local $v i32)\n")
    emit_evac_fields("t", ftys, 0)
    wat_emit("    (i32.const 0))\n")
  } else {
    ()
  }
}

// A sum: a fielded variant is [tag@0][payloads], each payload at the offset
// the variant's own layout gives it; a nullary variant is a sentinel below
// the heap and never reaches here.
fn emit_evac_sum(sig: String, k, specs) = {
  let scans = any(variant_moves, specs)
  emit_evac_head(sig, " (local $tg i32)")
  wat_emit("    (local.set $tg (i32.load (local.get $p)))\n")
  each(emit_evac_sum_case(k, ??), specs)
  wat_emit("    (global.set $ar_abort (i32.const 1))\n    (local.get $p))\n")
  if scans {
    wat_emit("  (func $scan_{sig} (param $t i32) (result i32) (local $tg i32) (local $v i32)\n")
    wat_emit("    (local.set $tg (i32.load (local.get $t)))\n")
    each(emit_scan_sum_case, specs)
    wat_emit("    (i32.const 0))\n")
  } else {
    ()
  }
}

fn variant_moves(spec) = match spec {
  (_, payloads) => any(evac_type_moves, payloads),
}

fn emit_evac_sum_case(k, spec) = match spec {
  (tag, payloads) => if len(payloads) == 0 {
    ()
  } else {
    let k2 = if any(evac_type_moves, payloads) { k } else { 0 }
    wat_emit("    (if (i32.eq (local.get $tg) (i32.const {int_to_str(tag)})) (then (return (call $ar_copy (local.get $p) (i32.const {int_to_str(evac_fields_end(payloads, 4))}) (i32.const {int_to_str(k2)})))))\n")
  },
}

fn emit_scan_sum_case(spec) = match spec {
  (tag, payloads) => if any(evac_type_moves, payloads) {
    wat_emit("    (if (i32.eq (local.get $tg) (i32.const {int_to_str(tag)})) (then\n")
    emit_evac_fields("t", payloads, 4)
    wat_emit("    (return (i32.const 0))))\n")
  } else {
    ()
  },
}

// A sequence node, by its tag: flat [count][tag][elements at the stride the
// tag word carries], snoc [count][tag][left][element], concat
// [count][tag][left][right], slice [count][tag][base][start]. The links are
// sequences of the same type; an element moves only from a word slot.
fn emit_evac_seq(sig: String, k, elem) = {
  emit_evac_head(sig, " (local $tw i32) (local $tg i32)")
  wat_emit("    (local.set $tw (i32.load offset=4 (local.get $p))) (local.set $tg (i32.and (local.get $tw) (i32.const 15)))\n")
  wat_emit("    (if (i32.eqz (local.get $tg)) (then (return (call $ar_copy (local.get $p) (i32.add (i32.const 8) (i32.mul (i32.load (local.get $p)) (call $ar_stride (i32.shr_u (local.get $tw) (i32.const 4))))) (i32.const {int_to_str(k)})))))\n")
  wat_emit("    (if (i32.eq (local.get $tg) (i32.const 1)) (then (return (call $ar_copy (local.get $p) (i32.add (i32.const 12) (call $ar_stride (i32.shr_u (local.get $tw) (i32.const 4)))) (i32.const {int_to_str(k)})))))\n")
  wat_emit("    (call $ar_copy (local.get $p) (i32.const 16) (i32.const {int_to_str(k)})))\n")
  let ev = evac_of(elem)
  let elems = evac_moves(ev) || evac_boxes(ev)
  wat_emit("  (func $scan_{sig} (param $t i32) (result i32) (local $tw i32) (local $tg i32) (local $v i32) (local $i i32) (local $n i32) (local $a i32)\n")
  wat_emit("    (local.set $tw (i32.load offset=4 (local.get $t))) (local.set $tg (i32.and (local.get $tw) (i32.const 15)))\n")
  wat_emit("    (if (i32.eqz (local.get $tg)) (then\n")
  if elems {
    wat_emit("      (if (i32.eqz (i32.shr_u (local.get $tw) (i32.const 4))) (then (local.set $n (i32.load (local.get $t))) (local.set $i (i32.const 0)) (block $d (loop $l (br_if $d (i32.ge_u (local.get $i) (local.get $n))) (local.set $a (i32.add (local.get $t) (i32.add (i32.const 8) (i32.shl (local.get $i) (i32.const 2)))))\n")
    emit_evac_slot("a", 0, elem, true)
    wat_emit("      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $l)))))\n")
  } else {
    ()
  }
  wat_emit("      (return (i32.const 0))))\n")
  emit_evac_link(sig, 8)
  wat_emit("    (if (i32.eq (local.get $tg) (i32.const 1)) (then\n")
  if elems {
    wat_emit("      (if (i32.eqz (i32.shr_u (local.get $tw) (i32.const 4))) (then (local.set $a (i32.add (local.get $t) (i32.const 12)))\n")
    emit_evac_slot("a", 0, elem, true)
    wat_emit("      ))\n")
  } else {
    ()
  }
  wat_emit("      (return (i32.const 0))))\n")
  wat_emit("    (if (i32.eq (local.get $tg) (i32.const 3)) (then\n")
  emit_evac_link(sig, 12)
  wat_emit("    ))\n    (i32.const 0))\n")
}

fn emit_evac_link(sig: String, off) =
  wat_emit("    (local.set $v (i32.load offset={int_to_str(off)} (local.get $t))) (if (call $ar_young (local.get $v)) (then (i32.store offset={int_to_str(off)} (local.get $t) (i32.sub (call $evac_{sig} (local.get $v)) (global.get $ar_delta)))))\n")

// The exit's two calls by index, through the leaves' own table regions
// (`emit_arena_table`): an index past the last — a code no leaf carries —
// is the opaque answer, as index 0 is.
fn emit_evac_dispatch(leaves) = {
  let l = int_to_str(len(leaves))
  wat_emit("  (func $ar_evac_by (param $k i32) (param $p i32) (result i32)\n    (if (i32.gt_u (local.get $k) (i32.const {l})) (then (call $ar_opaque (local.get $p)) (return (local.get $p))))\n    (call_indirect (type $ft1) (local.get $p) (i32.add (global.get $ar_evac_base) (local.get $k))))\n")
  wat_emit("  (func $ar_scan_by (param $k i32) (param $t i32)\n    (if (i32.gt_u (local.get $k) (i32.const {l})) (then (return)))\n    (drop (call_indirect (type $ft1) (local.get $t) (i32.add (global.get $ar_scan_base) (local.get $k)))))\n")
}

// Whether a leaf's copies carry anything to move: a sequence always (its
// links), a product or a sum when a field or payload does.
fn evac_leaf_scans(leaf) = match leaf {
  (_, sh) => match sh {
    ShSeq(_) => true,
    ShProduct(ftys) => any(evac_type_moves, ftys),
    ShSum(specs) => any(variant_moves, specs),
  },
}

// emit_functions deep-walks the lowered program and emits a WASM
// function for every LMakeClosure encountered — top-level
// `LLet(_, name, LMakeClosure(...))` fns use their outer LLet name;
// inline lambdas use the handle-based `lambda_<handle>` name assigned
// in lower.mn. Order matches `collect_fn_emit_records` traversal, so
// $<name>_idx globals line up with the function table.
//
// Cargo-class per-fn parallel emit (Hβ.emit.row-aware-parallel-emit):
// each (name, params, body, captures_count) record is INDEPENDENT —
// no shared state across fn bodies once the string-table / fn-index
// pre-passes have run. map walks each to its own wat_to_string handler
// instance; resulting strings emit sequentially to wat_stdout
// preserving source order (Q-B.7.3 determinism guarantee). N-core emit
// is a `><` fanout under `~> Thread` at this site
// (Hβ.lower.schedule-specialized-callee).
// Per-fn EMISSION IS A REGION (§5.O layer 3 at the emit phase — measured
// 2026-07-25: the streamed product leaves the process, so per-fn
// transients die at the fn boundary; post-region emission allocates ~0).
// Build → stream → reset: the string is written before the reset, and
// nothing durable is minted inside one fn's emission — the per-fn
// metadata handlers (body_context and kin) OVERWRITE their state before
// any read, so a dangling region pointer is never read; that
// overwrite-before-read discipline is this bracket's standing contract.
// The old map-then-each held EVERY fn's full text simultaneously — the
// whole module's emission materialized before one byte was written.
fn emit_functions(fn_records, units) = each(emit_function_bracketed(units, ??), fn_records)

fn emit_function_bracketed(units, r) = {
  let m = heap_mark()
  wat_emit(emit_one_fn_to_string(r, units))
  heap_reset(m)
}

// ─── The word-face wrappers (§5.U at the table boundary) ──────────────
// A fn whose NATIVE signature carries a wide slot cannot sit at its word
// index as itself — a caller blind to its type (a generic handler arm, the
// continuation composer, any floor body) speaks the word-arity face. Its $wf$
// twin derefs each wide argument's reference, direct-calls the native body
// (full native speed inside), and spills a wide result back to a cell. It
// READS the wrapped symbol's settled signature — the same column read the
// native header signed with. It used to re-derive both halves at module
// scope, OUTSIDE the twin bracket the body was emitted under, which is the
// divergence shape in miniature: a wrapper deref'ing at a width its callee
// never signed.
fn emit_wide_wrappers(fn_records) = each(
  (r) => {
    let m = heap_mark()
    wat_emit(emit_one_wrapper_to_string(r))
    heap_reset(m)
  },
  fn_records |> filter(fn_record_is_wide)
)

fn fn_record_is_wide(r) = match r {
  (nm, _ps, _b, _f) => symbol_is_wide(nm),
}

fn emit_one_wrapper_to_string(record) = {
  emit_wide_wrapper(record)
  wat_collect()
} ~> emit_memory_bump ~> wat_to_string

fn emit_wide_wrapper(record) = match record {
  (name, param_names, body, _) => match sig_of_symbol(name, len(param_names)) {
    (preprs, sig_ret) => {
      wat_emit("  (func $wf$")
      wat_emit(name)
      wat_emit(" (param $__state i32)")
      each(
        {
          (i, _) => {
            wat_emit(" (param $wp")
            wat_emit(int_to_str(i))
            wat_emit(" i32)")
          },
        },
        enumerate(param_names)
      )
      wat_emit(" (result i32) (local $wf_f64 f64) (local $wf_cell i32)\n")
      wat_emit("    (local.get $__state)\n")
      each(
        {
          (i, _p) => {
            wat_emit("    (local.get $wp")
            wat_emit(int_to_str(i))
            wat_emit(")\n")
            emit_wide_deref(list_index(preprs, i))
          },
        },
        enumerate(param_names)
      )
      match sig_ret {
        RI32 => {
          wat_emit("    (return_call $")
          wat_emit(name)
          wat_emit(")\n")
        },
        RF64 => {
          wat_emit("    (call $")
          wat_emit(name)
          wat_emit(")\n")
          wat_emit("    (local.set $wf_f64)\n")
          wat_emit("    (i32.const 8)\n")
          wat_emit("    (call $alloc)\n")
          wat_emit("    (local.tee $wf_cell)\n")
          wat_emit("    (local.get $wf_f64)\n")
          wat_emit("    (f64.store)\n")
          wat_emit("    (local.get $wf_cell)\n")
        },
        RI64 => {
          wat_emit("    (call $")
          wat_emit(name)
          wat_emit(")\n")
          wat_emit("    (unreachable) ;; wide-result: i64 has no producer yet\n")
        },
        RF32 => {
          wat_emit("    (call $")
          wat_emit(name)
          wat_emit(")\n")
          wat_emit("    (unreachable) ;; wide-result: f32 has no producer yet\n")
        },
        RV128 => {
          wat_emit("    (call $")
          wat_emit(name)
          wat_emit(")\n")
          wat_emit("    (unreachable) ;; wide-result: v128 has no producer yet\n")
        },
      }
      wat_emit("  )\n")
    },
  },
}

// Per-fn emit-to-buffer. Installs wat_to_string locally; emit_fn_body's
// perform wat_emit calls go to that handler's buffer; wat_collect
// returns the buffer when the scoped block completes.
//
// The allocation strategy is installed HERE, INNER to wat_to_string, so a
// fn-body `emit_alloc` (variant/record/closure/state alloc) has its
// re-performed wat_emit resolve to THIS fn's buffer — not the module-scope
// wat_stdout. The module-scope strategy serves only module-scope allocs
// (`$__init_lets`, the fold helpers), whose WAT correctly belongs at module
// scope. Without the inner install, every fn-body allocation's WAT leaked
// between the module globals and the fn bodies (the assemble-breaking
// `(global.get $heap_ptr)…` at top level). The unit is held to what the
// allocation audit measured of it (`emit_memory_audited`).
fn emit_one_fn_to_string(record, units) = match record {
  (name, param_names, body, captures_count) => {
    emit_fn_body(name, param_names, body, captures_count)
    wat_collect()
  } ~> emit_site_named(name) ~> emit_memory_audited(name, alloc_verdict(units, name)) ~> wat_to_string,
}

// Deep-walk the lowered program, projecting every fn-bearing variant
// (LMakeClosure / LMakeContinuation / LDeclareFn) to an emit record
// (name, param_names, body, captures_count). flatten(map) over the
// recursive structure produces the records in tree-traversal order —
// matching the prior emit_fns_expr ordering byte-for-byte so
// $<name>_idx globals line up with the function table.
fn collect_fn_emit_records(exprs) = exprs |> map(collect_fn_emit_records_expr) |> flatten

fn fn_emit_records_arms(arms, i) = if i >= len(arms) {
  []
} else {
  match list_index(arms, i) {
    (_, body) => collect_fn_emit_records_expr(body) ++ fn_emit_records_arms(arms, i + 1),
  }
}

fn collect_fn_emit_records_expr(expr) = match expr {
  LShow(_h, x) => collect_fn_emit_records_expr(x),
  LHash(_h, x) => collect_fn_emit_records_expr(x),
  LMakeClosure(_h, LFn(name, _arity, param_names, body, fence, _lines), captures) => // The LowFn fence IS the body-context every fn shape carries: closures
  // pass their capture count, handler arm fns nstate+total_arms, plain fns
  // 0 — one rule, set at lower time, not re-derived per shape.
  {
    [(name, param_names, body, fence)] ++ collect_fn_emit_records(body) ++ collect_fn_emit_records(captures)
  },
  LMakeContinuation(_h, LFn(name, _arity, param_names, body, fence, _lines), captures, _, _) => [(name, param_names, body, fence)] ++ collect_fn_emit_records(body) ++ collect_fn_emit_records(captures),
  LYield(_h, _op, args, k) => collect_fn_emit_records(args) ++ collect_fn_emit_records_expr(k),
  LKExtend(_h, k) => collect_fn_emit_records_expr(k),
  LDeclareFn(LFn(name, _arity, param_names, body, fence, _lines)) => [(name, param_names, body, fence)] ++ collect_fn_emit_records(body),
  LLet(_h, _n, inner) => collect_fn_emit_records_expr(inner),
  LBinOp(_h, _op, l, r) => collect_fn_emit_records_expr(l) ++ collect_fn_emit_records_expr(r),
  LUnaryOp(_h, _op, inner) => collect_fn_emit_records_expr(inner),
  LDirectCall(_h, _fh, _n, _t, args) => collect_fn_emit_records(args),
  LCall(_h, f, args) => collect_fn_emit_records_expr(f) ++ collect_fn_emit_records(args),
  LTailCall(_h, f, args) => collect_fn_emit_records_expr(f) ++ collect_fn_emit_records(args),
  LReturn(_h, inner) => collect_fn_emit_records_expr(inner),
  LIf(_h, c, t, e) => collect_fn_emit_records_expr(c) ++ collect_fn_emit_records(t) ++ collect_fn_emit_records(e),
  LBlock(_h, stmts) => collect_fn_emit_records(stmts),
  LMakeList(_h, elems) => collect_fn_emit_records(elems),
  LMakeTuple(_h, elems) => collect_fn_emit_records(elems),
  LSimdLanes(_h, lanes) => collect_fn_emit_records(lanes),
  LFanout(_h, lex, _, forms) => collect_fn_emit_records_expr(fanout_form(lex, forms)),
  LMakeRecord(_h, fs) => collect_fn_emit_records(fs),
  LMakeVariant(_h, _t, fs) => collect_fn_emit_records(fs),
  LMatch(_h, s, arms) => collect_fn_emit_records_expr(s) ++ fn_emit_records_arms(arms, 0),
  LResumeK(_h, k, v) => collect_fn_emit_records_expr(k) ++ collect_fn_emit_records_expr(v),
  LHandleWith(_h, b, hn, _hname, inits, _arm_names) => collect_fn_emit_records_expr(b) ++ collect_fn_emit_records_expr(hn) ++ collect_fn_emit_records(inits),
  LDerive(_h, seed, b) => collect_fn_emit_records_expr(seed) ++ collect_fn_emit_records_expr(b),
  LArena(_h, b) => collect_fn_emit_records_expr(b),
  LFeedback(_h, _d, _home, b, s) => collect_fn_emit_records_expr(b) ++ collect_fn_emit_records_expr(s),
  LPerform(_h, _d, args) => collect_fn_emit_records(args),
  LWasiCall(_h, _n, args) => collect_fn_emit_records(args),
  LInvariantFailure(_, _) => [],
  LFieldLoad(_h, rec, _off) => collect_fn_emit_records_expr(rec),
  LConvert(_h, _, operand) => collect_fn_emit_records_expr(operand),
  LStateSlotStore(_h, _o, v, _) => collect_fn_emit_records_expr(v),
  LStateInit(_h, _hn, _s, v) => collect_fn_emit_records_expr(v),
  LConst(_, _) => // H6: exhaustive LowExpr. Leaves with no fn-containing
  // descendants contribute no records.
  [],
  LLocal(_, _) => [],
  LFeedbackPrior(_) => [],
  LGlobal(_, _) => [],
  LUpval(_, _) => [],
}

fn emit_fn_body(name, param_names, body, captures_count) = {
  // W7 calling convention: every function takes `__state` as its
  // implicit first parameter. Top-level functions ignore it; lambda
  // bodies read captures via (local.get $__state) + offset-load.
  // The `$state_tmp` local scratches the closure pointer during
  // LMakeClosure bump-alloc + field stores, and during LCall for
  // saving the callee closure pointer before argument evaluation.
  // Every LLet in the body declares a function-level local so
  // (local.set $<name>) / (local.get $<name>) validate.
  // Hβ.emit.reason-chain-comments: SourceMap-style annotation at fn
  // boundary. Why-engine consumers (`mentl query --why`, browser
  // inspector, terminal trace) read these to walk from WAT back to
  // source. Per PLAN §2: emit's per-
  // handle output IS the graph's Reason projected as bytes; the
  // SourceMap comment makes the projection observable downstream.
  emit_reason_comment_for_fn(name, body)
  // The header STATES the settled signature; it does not decide one. Both
  // halves come from the same column read every call site takes, so the
  // bytes a caller pushes and the bytes this header accepts are literally
  // one fact — i32 byte-identical at the floor (Law 7), f64 where the
  // gradient cashed out.
  let sig = sig_of_symbol(name, len(param_names))
  wat_emit("  (func $")
  wat_emit(name)
  wat_emit(" (param $__state i32)")
  match sig {
    (preprs, ret) => {
      emit_params(param_names, preprs)
      wat_emit(" (result ")
      wat_emit(repr_wat(ret))
      wat_emit(")")
    },
  }
  wat_emit(" (local $state_tmp i32)")
  wat_emit(" (local $f64_tmp f64)")
  wat_emit(" (local $wide_cell i32)")
  wat_emit(" (local $scrut_tmp i32)")
  wat_emit(" (local $callee_closure i32)")
  wat_emit(" (local $alloc_size i32)")
  wat_emit(" (local $loop_i i32)")
  emit_named_locals(
    walk_locals_list(body, []),
    match sig {
      (preprs, _) => param_local_entries(param_names, preprs, []),
    }
  )
  wat_emit("\n")
  emit_body(body)
  wat_emit("  )\n")
}

// Hβ.emit.reason-chain-comments — project the first body expression's
// Reason chain (chased from the graph at the LowExpr's handle) as a
// SourceMap-style WAT comment. The Why-engine reads these to walk
// from WAT back to source. Empty body skipped; chase-failure (handle
// == 0) skipped.
fn emit_reason_comment_for_fn(name, body) = if len(body) == 0 {
  ()
} else {
  let first = last(body)
  let h = lexpr_handle(first)
  if h == 0 {
    ()
  } else {
    wat_emit("  ;; fn ")
    wat_emit(name)
    wat_emit(" reason: ")
    wat_emit(emit_reason_summary(h))
    wat_emit("\n")
  }
}

// The head of the reason a function's first node carries, for the comment
// at its boundary: the one hop phrase the caret's Why prints, so the WAT and
// the voice say the same words.
fn emit_reason_summary(handle) = match graph_chase(handle) {
  GNode(_, reason) => reason_phrase(reason),
}

// Walk the function body once, projecting its locals row. ONE local
// family, ONE discipline: the preamble IS a SET. Every local — a named
// LLet binding AND a handle-suffixed scratch ($call_<h>, $tuple_<h>,
// $__hstate_<h>, …) — collects into `acc` as a "name width" entry, and
// emit_named_locals declares each distinct entry once. The old split
// (handle-suffixed streamed inline as "unique by construction", named
// set-deduped) was a two-disciplines-for-one-thing seam, and the seam
// was the bug: the e-graph shares pure nodes, so one $call_<h> node
// emitted at three DAG positions declared its register three times and
// wat2wasm rejected the redefinition (ft_name, m3 assembly). A handle
// keys ONE register no matter how many positions reach it — the atomic
// set-then-use per occurrence makes sharing safe — so declaring it once
// is the ONLY correct form. (The deeper ultimate: emit a shared pure
// node ONCE and bind it, retiring the re-emission entirely — the named
// peer Hβ.emit.shared-node-cse. Dedup-the-decl is its correct floor:
// pure re-emission is redundant, never wrong; the e-graph gates sharing
// on purity, so no effect is ever duplicated.) A name recurring at a
// DIFFERENT width still emits both declarations — wat2wasm rejects that
// loud (the seed's .f64-mangle cross-width case; never merged). Stops at
// LMakeClosure boundaries (their locals are their own). Must cover every
// LowExpr container that can hold a scratch or LLet descendant.
fn walk_locals_list(stmts, acc) = if len(stmts) == 0 {
  acc
} else {
  walk_locals_list(drop_last(stmts), walk_locals_expr(last(stmts), acc))
}

fn walk_locals_expr(expr, acc) = match expr {
  LLet(h, name, inner) => {
    // The local's WIDTH: llet_repr — the ONE projection this decl and the
    // LLet store both read, so they cannot disagree. The NAME is
    // local_wat_name(name, r) — the repr decides the register name too.
    let r = llet_repr(h, inner)
    walk_locals_expr(inner, [local_wat_name(name, r) ++ " " ++ repr_wat(r)] ++ acc)
  },
  LMakeClosure(h, _, captures) => // The FN body is a boundary (its locals are its own) — but the CAPTURES
  // evaluate in the ENCLOSING frame at the mint (a partial's supplied arg
  // may be a call minting a result local here). Lambda captures are bare
  // LLocal/LUpval reads contributing no locals, so walking them is
  // byte-identical for the existing paths.
  //
  // `mkclo_local(h)` is the record pointer's own slot, declared here and
  // read at the emit. The sentence above says the captures "contribute no
  // locals", and that WAS the whole bug: a capture which is itself a
  // closure contributes the most important one — a place to keep the outer
  // record while the inner is built.
  [mkclo_local(h) ++ " i32"] ++ walk_locals_list(captures, acc),
  LMakeContinuation(h, _, captures, _, _) => // resume_fn boundary — its locals are its own (H7)
  // The resume invocation: its two bracket locals + whatever the delegated
  // LCall shape mints (staging locals) — mirror-true to the emit arm, which
  // means its record slot too: the head IS the closure head.
  [mkclo_local(h) ++ " i32"] ++ walk_locals_list(captures, acc),
  LResumeK(h, k, v) => walk_locals_expr(
    LCall(h, k, [v]),
    ["__rk_wprev_{int_to_str(h)} i32"] ++ (["__rk_val_{int_to_str(h)} i32"] ++ acc)
  ),
  LYield(h, _, args, k) => {
    // k = the record boundary above. An args-bearing yield parks its
    // transient record ptr in a per-site local — the only slot inner arg
    // emissions (which clobber every shared scratch) cannot touch.
    let base = walk_locals_expr(k, walk_locals_list(args, acc))
    if len(args) == 0 { base } else { ["yargs_{int_to_str(h)} i32"] ++ base }
  },
  LKExtend(_, k) => // same boundary rule; the extend's own emit is a call + a const
  walk_locals_expr(k, acc),
  LDeclareFn(_) => // module-level fn declaration — its body has its own locals
  acc,
  LBlock(_h, stmts) => walk_locals_list(stmts, acc),
  LIf(_h, c, t, e) => walk_locals_list(e, walk_locals_list(t, walk_locals_expr(c, acc))),
  LBinOp(_h, _op, l, r) => walk_locals_expr(r, walk_locals_expr(l, acc)),
  LUnaryOp(_h, _op, inner) => walk_locals_expr(inner, acc),
  LDirectCall(_h, _fh, _n, _t, args) => walk_locals_list(args, acc),
  LCall(h, f, args) => // $call_<h> parks the CALLEE RECORD pointer — a handle IS a word,
  // i32 invariantly; the call's RESULT rides the stack at the ft's
  // width, never through this scratch. One entry into the set (deduped).
  walk_locals_list(args, walk_locals_expr(f, ["call_{int_to_str(h)} i32"] ++ acc)),
  LShow(h, x) => walk_locals_expr(show_node_of(h, x), acc),
  LHash(h, x) => walk_locals_expr(hash_node_of(h, x), acc),
  LTailCall(h, f, args) => walk_locals_list(args, walk_locals_expr(f, ["call_{int_to_str(h)} i32"] ++ acc)),
  LReturn(_h, inner) => walk_locals_expr(inner, acc),
  LMakeList(_h, elems) => walk_locals_list(elems, acc),
  LMakeTuple(h, elems) => walk_locals_list(elems, if len(elems) > 0 { ["tuple_{int_to_str(h)} i32"] ++ acc } else { acc }),
  LFanout(_h, lex, _, forms) => walk_locals_expr(fanout_form(lex, forms), acc),
  LSimdLanes(h, lanes) => // SIMD lanes need a v128 accumulator local — replace_lane reads-modifies the
  // running vector. No heap local (the value is pure stack v128, not a pointer).
  walk_locals_list(lanes, if len(lanes) > 0 { ["simd_{int_to_str(h)} v128"] ++ acc } else { acc }),
  LMakeRecord(h, fs) => walk_locals_list(fs, ["record_{int_to_str(h)} i32"] ++ acc),
  LMakeVariant(h, _t, fs) => walk_locals_list(fs, if len(fs) > 0 { ["variant_{int_to_str(h)} i32"] ++ acc } else { acc }),
  LMatch(_h, s, arms) => {
    // The root's scratch at the scrutinee's repr — the word scratch is every
    // prologue's own, so only a wide root declares one here.
    let sr = tail_expr_repr(s)
    let with_scratch = match sr {
      RI32 => walk_locals_expr(s, acc),
      _ => [scrut_local(sr) ++ " " ++ repr_wat(sr)] ++ walk_locals_expr(s, acc),
    }
    walk_locals_arms(arms, sr, with_scratch)
  },
  LHandleWith(h, b, hn, hname, inits, arm_names) => {
    // The install's OWN minted locals — the handler record, the scoped-
    // singleton save (named installs only), and one [record, base] entry
    // per effect group — mirror-true to the LHandleWith emit arm +
    // emit_handler_effect_entries local.set. All collect into the set.
    // Every install brackets the world chain (save/restore is
    // unconditional — the invariant, not an optimization), so the
    // world-save local declares for anonymous installs too.
    let base = ["__hstate_{int_to_str(h)} i32", "__hstate_{int_to_str(h)}_wprev i32"] ++ acc
    let with_groups =
      fold(base, (a, g) => ["__hstate_{int_to_str(h)}_{group_ename(g)} i32"] ++ a, arm_names)
    // band B k1/M2b: a MultiShot-armed install parks the body result
    // ($__hres, the install node's proven width) and hands it to the
    // redrive — the caught k lives in the redrive's own local now. Same
    // multishot_ops_of decider the emit reads — mirror-true by construction.
    let with_ms = if len(multishot_ops_of(hname)) > 0 {
      ["__hres_{int_to_str(h)} {repr_wat(repr_of(lookup_ty(h)))}"] ++ with_groups
    } else {
      with_groups
    }
    walk_locals_list(inits, walk_locals_expr(hn, walk_locals_expr(b, with_ms)))
  },
  LFeedback(h, d, home, b, s) => {
    // The per-site locals of the ring tick, mirror-true to the LFeedback
    // emit arm: $__ring_<h> holds the ring's address for the tick,
    // $__fb_prev_<h> the prior the oldest slot yields, $__fb_<h> the
    // current output, and — only at a depth past one, where the ring has a
    // head — $__fbp_<h> the slot's address, read once and stored through
    // once. The value pair declares at the feedback node's OWN repr
    // (repr_of(lookup_ty(h)), read live under the active bracket), so a
    // float recurrence threads f64 and a Float twin's slot is f64 where
    // the floor's is a word. Carried-Truth: the graph proved the
    // feedback's type; the emit reads it, never fabricates i32.
    let fb_rw = repr_wat(repr_of(lookup_ty(h)))
    let hs = int_to_str(h)
    let head_locals = if d > 1 { ["__fbp_{hs} i32"] } else { [] }
    // Under the derivative reading the tick also reads the prior's tangent
    // off the tangent ring's slot at the same index (the output's tangent is
    // a let of the body's own, declared by the body walk).
    let tangent_locals = match home {
      LhStaticJvp => ["__tslot_{hs} i32", "__fb_dprev_{hs}.f64 f64"],
      LhStatic => [],
      LhSlot(_) => [],
    }
    walk_locals_expr(
      s,
      walk_locals_expr(
        b,
        ["__ring_{hs} i32", "__fb_prev_{hs} {fb_rw}", "__fb_{hs} {fb_rw}"] ++ head_locals ++ tangent_locals ++ acc
      )
    )
  },
  LDerive(h, _seed, _body) => // The derivative reading emits its DERIVED program, so its locals are that
  // program's — every tangent and every residual name derive introduced.
  match derived_at(h, spec_enc_active()) {
    Some(x) => match x {
      Expansion(r) => walk_locals_expr(r.body, acc),
    },
    None => acc,
  },
  LArena(h, b) => if arena_live() { walk_locals_expr(b, arena_locals(h) ++ acc) } else { walk_locals_expr(b, acc) },
  LWasiCall(h, n, args) => // The reading's lane ops park a record's address in a per-site local
  // (`lane_local`), mirror-true to their emission; the calls, performs and
  // installs the reading marks declare their own inside.
  match derive_op_of(n) {
    Some(DoLaneRead) => walk_locals_list(args, ["{lane_local(h)} i32"] ++ acc),
    Some(DoLaneWrite) => walk_locals_list(args, ["{lane_local(h)} i32"] ++ acc),
    Some(DoMintLanes) => walk_locals_list(args, ["{lane_local(h)} i32"] ++ acc),
    Some(DoJvpCall) => walk_locals_list(args, acc),
    Some(DoJvpPerform) => walk_locals_list(args, acc),
    Some(DoJvpInstall) => walk_locals_list(args, acc),
    Some(DoAdjIn) => acc,
    Some(DoAdjOut) => walk_locals_list(args, acc),
    None => walk_locals_list(args, acc),
  },
  LPerform(h, _d, a) => // The perform's per-site pair, mirror-true to the ONE emit arm: evw holds
  // the world saved around the arm call and EVERY dispatch needs it, because
  // the bracket is not a property of any one of them; evn holds the resolved
  // node and only the walking forms fill it. Declaring both for all is the
  // honest read of "one arm, one shape" — a local nobody sets costs a word of
  // frame and cannot be the thing that makes two forms differ.
  walk_locals_list(
    a,
    ["evn_{int_to_str(h)} i32", "evw_{int_to_str(h)} i32", "evpw_{int_to_str(h)} i32"] ++ acc
  ),
  LInvariantFailure(_, _) => acc,
  LFieldLoad(_h, rec, _off) => walk_locals_expr(rec, acc),
  LConvert(_h, _, operand) => walk_locals_expr(operand, acc),
  LStateSlotStore(_h, _o, v, _) => walk_locals_expr(v, acc),
  LStateInit(_h, _hn, _s, v) => walk_locals_expr(v, acc),
  LConst(_, _) => // H6: exhaustive LowExpr. Leaves declare no locals; LUpval,
  // LConst, LLocal, LGlobal are pure reads. New LIR
  // variants with let-bindings inside must add their recursion
  // explicitly — silent fall-through misses locals and WAT
  // validation fails.
  acc,
  LLocal(_, _) => acc,
  LFeedbackPrior(_) => acc,
  LGlobal(_, _) => acc,
  LUpval(_, _) => acc,
}

// Emit each DISTINCT named local once — the dedupe walk that makes the
// locals row a set (mirror of emit_distinct_repr_ft_types: end-first
// recursion over the cons-collected entries, seen-list skip). `seen`
// arrives seeded with the fn's param entries: a `let` rebinding a
// param re-uses the param register (a WASM param IS a local), so its
// declaration is skipped rather than duplicated. The seven scratch
// preamble names are NOT seeded — a user binding colliding with
// $state_tmp must stay a loud assemble error, never a silent merge
// into a register the emitter clobbers between statements.
fn emit_named_locals(entries, seen: [String]) = if len(entries) == 0 {
  ()
} else {
  let e = last(entries)
  if ls_find_str_local(seen, e, 0) >= 0 {
    emit_named_locals(drop_last(entries), seen)
  } else {
    wat_emit(" (local $")
    wat_emit(e)
    wat_emit(")")
    emit_named_locals(drop_last(entries), [e] ++ seen)
  }
}

// The fn's param entries in the same "name width" spelling the walk
// collects — the seed set for emit_named_locals, rendered from the SAME
// repr-vector the header signed, so a binder's declared width and its
// param slot are one fact and not two agreeing ones.
fn param_local_entries(names, preprs, acc) = if len(names) == 0 {
  acc
} else {
  param_local_entries(
    drop_last(names),
    drop_last(preprs),
    [last(names) ++ " " ++ repr_wat(last(preprs))] ++ acc
  )
}

// LMatch arm walker: each pattern-bound LPVar becomes a function-level
// local entry so the (local.set $name) inside emit_match_arms validates.
// Two arms binding the same name share one register — the entry set
// dedupes at emit_named_locals. Bodies are walked for nested LLet
// locals as usual.
fn walk_locals_arms(arms, sr, acc) = if len(arms) == 0 {
  acc
} else {
  match last(arms) {
    (pat, body) => walk_locals_arms(drop_last(arms), sr, walk_locals_expr(body, walk_locals_pat(pat, sr, acc))),
  }
}

// The DECL walk reads the SAME live channels the BIND emit reads
// (emit_pat_binds_at: ctor_payload_tys_of for con payloads, the tuple
// bind's carried elem_ty, word floors for list/record slots), so a
// binder's declared width and its local.set's value width CANNOT
// disagree — the one decider, two readers. The prior hardcoded " i32"
// leaf declared every Float payload binder a word while the bind
// loaded it f64-wide: the m3 assembly's 20-site local.set class.
fn walk_locals_pat(pat, r, acc) = match pat {
  LPVar(name) => [local_wat_name(name, r) ++ " " ++ repr_wat(r)] ++ acc,
  LPCon(_, _, pairs) => walk_locals_pat_con(ty_of_pairs(pairs), pat_of_pairs(pairs), acc),
  LPUnresolvedCon(_, sub_pats) => // No declaration proves the payload tys — declare each sub-binder at the
  // word floor so the (dead — predicate false) arm body still assembles.
  fold(acc, (a, p) => walk_locals_pat(p, RI32, a), sub_pats),
  LPTuple(elem_binds) => walk_locals_pat_tuple(elem_binds, acc),
  LPList(elem, sub_pats, rest, _) => walk_locals_pat_rest(rest, walk_locals_pat_list(sub_pats, slot_repr(elem), acc)),
  LPRecord(_, rty, field_binds, rest) => walk_locals_pat_rest(rest, walk_locals_pat_record(record_full_fields(rty), rty, field_binds, acc)),
  LPWild => acc,
  LPLit(_) => acc,
  LPAlt(branches) => // Branches bind the same names (infer's alternation law) — branch 0's
  // set carries the whole alternation's bindings.
  match branches {
    [] => acc,
    [b0, ..._] => walk_locals_pat(b0, r, acc),
  },
  LPAs(name, inner) => // The as-binder is the whole matched VALUE at the repr its position
  // proves — a word for records, lists and sums (pointers), the root's
  // own width over a Float scrutinee. The inner pattern's binders follow
  // at the same repr.
  walk_locals_pat(inner, r, [local_wat_name(name, r) ++ " " ++ repr_wat(r)] ++ acc),
}

// Each con-payload sub declares at its payload's slot width — sub i pairs
// with payload i, front-consumed (emit_pat_con_subs_binds' twin).
fn walk_locals_pat_con(ptys, subs, acc) = if len(subs) == 0 {
  acc
} else {
  let pty = if len(ptys) > 0 { fold_strip(list_index(ptys, 0)) } else { TVar(0) }
  let ptys2 = if len(ptys) > 0 { rest(ptys) } else { ptys }
  walk_locals_pat_con(ptys2, rest(subs), walk_locals_pat(list_index(subs, 0), slot_repr(pty), acc))
}

fn walk_locals_pat_rest(rest, acc) = match rest {
  None => acc,
  Some(name) => if name == "_" { acc } else { [name ++ " i32"] ++ acc },
}

// Each record-field sub-pattern declares at its field's slot width, the SAME
// width emit_pat_record_binds loads at.
fn walk_locals_pat_record(full, rty, field_binds, acc) = if len(field_binds) == 0 {
  acc
} else {
  match last(field_binds) {
    (name, sub_pat) => walk_locals_pat_record(
      full,
      rty,
      drop_last(field_binds),
      walk_locals_pat(sub_pat, slot_repr(pat_field_ty(full, rty, name)), acc)
    ),
  }
}

// A record pattern's field type: the whole field set's where the receiver
// resolved, and otherwise the one the receiver's row already knows — the
// width a binder declares at even where the floor makes its read dead.
fn pat_field_ty(full, rty, name: String) = match full {
  Some(fs) => match find(field_named(name, ??), fs) {
    Some(f) => match f {
      (_, t) => t,
    },
    None => TVar(0),
  },
  None => record_field_ty(rty, name),
}

// List elements are word-slotted (emit_pat_subs_binds' RI32 leaf).
// Each list-element sub-pattern declares at the element's slot width, the
// SAME width `emit_pat_subs_binds` reads it at.
fn walk_locals_pat_list(pats, r, acc) = if len(pats) == 0 {
  acc
} else {
  walk_locals_pat_list(drop_last(pats), r, walk_locals_pat(last(pats), r, acc))
}

// The pattern-side offset of tuple element `target`: the align_for +
// repr_width prefix-sum — the IDENTICAL fold construction
// (emit_field_stores_acc) and indexing (tuple_elem_offset) run — over the
// ebs' element types at their slot widths (`slot_repr`), so bind, decl, and
// test agree with the stored layout under any bracket. -1 past the end
// (unprovable, never a silent 0), mirroring tuple_elem_offset.
fn pat_tuple_off(ebs, target, i, off) = if i >= len(ebs) {
  -1
} else {
  match list_index(ebs, i) {
    (ty, _) => {
      let r = slot_repr(ty)
      let here = align_for(off, r)
      if i == target { here } else { pat_tuple_off(ebs, target, i + 1, here + repr_width(r)) }
    },
  }
}

// A tuple pattern's elements are (elem_ty, sub_pat) — the width-summed
// positional product. Each sub declares at the element repr read through
// the live channel, the SAME proven width emit_pat_tuple_binds loads at.
fn walk_locals_pat_tuple(elem_binds, acc) = if len(elem_binds) == 0 {
  acc
} else {
  match last(elem_binds) {
    (elem_ty, sub_pat) => walk_locals_pat_tuple(drop_last(elem_binds), walk_locals_pat(sub_pat, slot_repr(elem_ty), acc)),
  }
}

// The repr of a fn body's result = the repr of the value its tail expression
// leaves on the stack. The body is a stmt list; the result is the last stmt,
// unwrapped through the value-producing wrappers (LReturn / LBlock tail /
// LIf via its then-branch tail — both branches unify to one type). An empty
// body or an unresolved tail projects RI32 (the floor). Read live from the
// tail handle, never re-derived.
// Two branch widths joined: the RI32 floor yields to any proof; equal
// proofs pass through; unequal proofs keep the left (loud at assembly).
fn repr_join(a, b) = match a {
  RI32 => b,
  _ => a,
}

// The ONE width read a let's DECL and its STORE share — the graph's proof at
// the LLet handle joined with the init's computed width (the floor yields to
// either; a float-computing init bound by a let whose handle the weak
// seed-era infer left free still declares f64).
fn llet_repr(h, inner) = repr_join(repr_of(lookup_ty(h)), tail_expr_repr(inner))

// The WASM register NAME of a named slot is a projection of (source name,
// proven repr): a non-word slot is `name.<width>`, so two same-named binders
// of DIFFERENT widths (lower_expr_body's LitInt(v)/LitFloat(v) arms — the
// one m3 redefinition) are two registers, deterministically. Decl and every
// use read THIS one projection — params included (a param's WAT name is
// fn-internal, so no param/local discrimination exists anywhere). The
// repr decides the width AND the name: one decider, extended.
fn local_wat_name(name, r) = match r {
  RI32 => name,
  RI64 => name ++ ".i64",
  RF64 => name ++ ".f64",
  RF32 => name ++ ".f32",
  RV128 => name ++ ".v128",
}

fn body_result_repr(body) =
  if len(body) == 0 { RI32 } else { tail_expr_repr(list_index(body, len(body) - 1)) }

fn tail_expr_repr(expr) = match expr {
  LReturn(_h, inner) => tail_expr_repr(inner),
  LBlock(_h, stmts) => if len(stmts) == 0 { RI32 } else { tail_expr_repr(list_index(stmts, len(stmts) - 1)) },
  LIf(_h, _c, t, e) => // Both branches joined — the floor yields to either side's proof,
  // the same join the LIf emission declares (one width, two readers).
  repr_join(body_result_repr(t), body_result_repr(e)),
  LMatch(_h, _s, arms) => match_arms_repr(arms),
  LConvert(_h, kind, _) => // The reliable STRUCTURAL leaves — the width emission ACTUALLY produces.
  // An IntToFloat convert IS f64 by construction; an arithmetic binop carries
  // operand width (f64 iff either operand is — same-typed operands, §4①, so
  // the join reads the truth). A call reads its NODE's proven type — the same
  // live graph edge inference wrote and every use-site reads, so decl and use
  // agree by construction (the fn-result side-ledger was a Carried-Truth
  // violation: inference already types the call node Float; read it live).
  match kind {
    IntToFloat => RF64,
    FloatToInt => RI32,
  },
  LBinOp(_h, op, l, r) => match binop_kind(op) {
    BKArith => repr_join(tail_expr_repr(l), tail_expr_repr(r)),
    _ => RI32,
  },
  LCall(ch, callee, _) => call_result_repr(callee, ch),
  LShow(_h, _x) => RI32,
  LHash(_h, _x) => RI32,
  LTailCall(ch, callee, _) => call_result_repr(callee, ch),
  LFieldLoad(h, rec, sel) => // what the load emits, read from the receiver's layout
  field_load_repr(h, rec, sel),
  LWasiCall(h, n, args) => // The reading's ops: a lane read is an f64, a lane write and a lanes mint
  // leave a word, and a marked call, perform or install is what it wraps.
  match derive_op_of(n) {
    Some(DoLaneRead) => RF64,
    Some(DoLaneWrite) => RI32,
    Some(DoMintLanes) => RI32,
    Some(DoJvpCall) => wrapped_repr(args),
    Some(DoJvpPerform) => wrapped_repr(args),
    Some(DoJvpInstall) => wrapped_repr(args),
    Some(DoAdjIn) => RF64,
    Some(DoAdjOut) => RI32,
    None => if h == 0 { RI32 } else { repr_of(lookup_ty(h)) },
  },
  other => {
    let h = lexpr_handle(other)
    if h == 0 { RI32 } else { repr_of(lookup_ty(h)) }
  },
}

fn wrapped_repr(args) = match args {
  [] => RI32,
  [inner, ..._] => tail_expr_repr(inner),
}

// The param slots RENDERED from the settled repr-vector. This fn used to
// decide the widths as it wrote them; it now only writes them, which is why
// the header and the call sites cannot differ — there is one vector and both
// read it (the deciding lives in emitted_sig_of_record, once).
fn emit_params(names, preprs) = each(
  {
    (i, name) => {
      // `_` is not a name — it is the absence of one. A wildcard param binds
      // nothing and is never referenced, so it gets a UNIQUE WAT identifier
      // (`_<i>`); WASM params must be uniquely named, and two `_` params (a
      // `(_, _, r) => …` lambda, or inferred params all mk_param'd "_") else
      // both emit `$_` and wat2wasm rejects the redefinition. Real names are
      // unique (a duplicate binding is a prior error) and ARE referenced by
      // the body, so they stay verbatim. field_name_eq carries the String
      // proof — a bare `== "_"` is pointer-eq through m2 (the parsed name and
      // the interned literal never match), so the rename would silently never
      // fire and the collision would stand.
      let wat_name = if field_name_eq(name, "_") { "_{int_to_str(i)}" } else { name }
      let r = list_index(preprs, i)
      wat_emit(" (param $")
      wat_emit(local_wat_name(wat_name, r))
      wat_emit(" ")
      wat_emit(repr_wat(r))
      wat_emit(")")
    },
  },
  enumerate(names)
)

// The param-width ladder that stood here is DELETED — it was three routes to
// one fact the enumeration entry now states: the body's first LLocal use-site
// (a whole-body walk per param), the declared scheme searched BY NAME when
// the walk missed, and the word floor when the name search missed, which for
// the entire synthesized family was always. Its own comment named this column
// as the answer and priced the walk that would have reached it; the O(1) form
// exists, so the ladder goes. Hβ.emit.unused-wide-param-floor closes here: an
// unused wide param signs at its real width because the entry carries the
// param's TYPE, and being unread was never evidence of being a word.
//
// (The 30-arm LowExpr walk that hunted a param's first use-site went with the
// ladder above — a whole traversal of the lowered tree, per parameter, per
// function, run three times over from three readers, to recover a type the
// fn's own TFun states. Nothing reads it now. This is what a Carried-Truth
// fix is supposed to look like from the outside: the column arrives and a
// subsystem leaves.)
//
// A statement is a value used ZERO times — the kernel-uniform word
// every expression yields is DROPPED between statements; only the
// final statement's word is the block's value. Non-yielding forms (a
// let's local.set, a state-slot store, a nested decl, a diverging
// return) emit no word, so no drop. A unit-typed op's Tier-2 perform
// still yields the uniform i32 (every $ft results i32), so a
// statement-position perform is exactly this law's instance — the
// scratch stores in the perform-miss postmortem window were the
// first on the m2 path and left [i32, i32] at an if-branch end.
fn emit_body(stmts) = emit_body_seq(stmts, 0)

fn emit_body_seq(stmts, i) = if i >= len(stmts) {
  ()
} else {
  let s = list_index(stmts, i)
  emit_expr(s)
  if i < len(stmts) - 1 && lexpr_leaves_value(s) { wat_emit("    (drop)\n") } else { () }
  emit_body_seq(stmts, i + 1)
}

// The default IS the law — every expression emission yields one word;
// the arms enumerated here are the forms whose emission consumes its
// own result (local.set / store / decl) or never falls through.
fn lexpr_leaves_value(e) = match e {
  LLet(_, _, _) => false,
  LStateSlotStore(_, _, _, _) => false,
  LStateInit(_, _, _, _) => false,
  LInvariantFailure(_, _) => false,
  LDeclareFn(_) => false,
  LReturn(_, _) => false,
  _ => true,
}

fn emit_start(top_fn_names, value_lets, has_lines, main_params, yield_seen, threaded, arena_on) = {
  // Top-level closures are static data; the static `<~` rings allocate
  // through $__init_lines and top-level VALUE lets initialize through
  // $__init_lets, run FIRST in program order — rings before lets, since an
  // initializer may call into a recurrence — before main's invocation AND
  // before a library-shape module's clean exit (effectful initializers
  // still run). _start invokes main when main exists.
  wat_emit("  (func $_start\n")
  if threaded {
    // The shared heap cell's one initializer: the ROOT instance's _start,
    // before any allocation. Spawned instances never run _start — they
    // read the live cell (initializing it per instance would rewind the
    // shared line mid-run).
    wat_emit("    (i32.atomic.store (i32.const 64) (i32.const 1048576))\n")
  }
  // The arenas' journal, before anything else is allocated
  // (`emit_arena_runtime`).
  if arena_on { wat_emit("    (global.set $ar_jb (call $alloc (i32.const 2097152)))\n") }
  if has_lines { wat_emit("    (call $__init_lines (i32.const 0))\n    (drop)\n") }
  if len(value_lets) > 0 { wat_emit("    (call $__init_lets (i32.const 0))\n    (drop)\n") }
  if ls_find_str_local(top_fn_names, "main", 0) >= 0 {
    // main is graph-known → DIRECT call (never virtualize a known
    // operator): static closure as __state, one EMPTY-LIST arg per
    // declared param. main's result IS the exit code (Unix vocabulary;
    // the seed's _start and the whole micro battery key on it — never
    // dropped). The arg is a fresh alloc'd word — virgin-zero in the
    // bump image = a len-0 flat list — NOT the literal 0: a main that
    // READS its param (the CLI's len(argv)) on address 0 read whatever
    // the process's scratch held — 0 in m2's layout, ≥2 in m3's, so m3
    // dispatched every stdin compile to ParseError/help and emitted
    // NOTHING (the 0/45 battery, the empty m4). Real WASI argv is the
    // named peer Hβ.emit.wasi-argv-in-start.
    wat_emit("    (call $main (global.get $main)")
    // main's FIRST param IS argv — read the live process args (Hβ.emit.wasi-argv-
    // in-start, closed). wasi_args has no captures, so __state = 0 (the
    // __init_lets precedent). Any further params (none in practice) stay empty
    // lists. A 0-param main() gets nothing — the micros never touch argv.
    if main_params > 0 {
      // wasi_args needs io.mn linked. A params-taking main WITHOUT it (the micro
      // harness links memory+strings+lists+prelude only) gets the empty list —
      // the pre-argv behavior — never a dangling $wasi_args.
      if ls_find_str_local(top_fn_names, "wasi_args", 0) >= 0 {
        wat_emit(" (call $wasi_args (i32.const 0))")
      } else {
        wat_emit(" (call $alloc (i32.const 4))")
      }
      each((_) => wat_emit(" (call $alloc (i32.const 4))"), range(1, main_params))
    } else {
      ()
    }
    wat_emit(")\n")
    // band B k1: the UNHANDLED-YIELD backstop — a MultiShot yield no install
    // driver caught reaches the program boundary as an unhandled effect and
    // traps LOUDLY, never exits with the dummy (the anonymous-install /
    // driverless floor made unsilenceable). Gated: only a yielding module
    // has the flag to read.
    if yield_seen > 0 {
      wat_emit("    (global.get $yield_flag)\n")
      wat_emit("    (if (then unreachable)) ;; unhandled multishot yield — no install driver caught it\n")
    }
    wat_emit("    (call $proc_exit)\n")
  } else {
    // No main; the module is library-shape. Exit cleanly.
    wat_emit("    ;; no `main` defined — _start is a clean exit\n")
    wat_emit("    (call $proc_exit (i32.const 0))\n")
  }
  wat_emit("  )\n")
  wat_emit("  (export \"_start\" (func $_start))\n")
  // The thread entry exists only in a spawning module (Law 7 — a
  // thread-free module carries no entry, no import, no spawn substrate).
  if threaded { emit_wasi_thread_start(len(value_lets) > 0, has_lines) }
}

// emit_wasi_thread_start — the spawned instance's whole life. The host
// calls $wasi_thread_start(tid, start_arg) on a fresh instance over the
// SHARED image; start_arg is the task record $spawn_task_impl allocated
// ([task closure@0][completion@4][result@8]). The body:
//   1. stamps the per-instance identity ($tid_g — the thread_id read);
//   2. runs $__init_lets when the module has top-level value lets —
//      globals are per-instance, so the spawned instance's let globals
//      are zero until its own init runs (allocations go through the
//      shared cell, so the copies land in fresh records; interned string
//      constants are static data at identical addresses in the one
//      image, so pointer-licensed compares stay true);
//   3. invokes the task closure through the closure protocol (record as
//      __state, fn_ptr@0, call_indirect — the exact sequence LCall
//      emits for a 0-arg closure value);
//   4. stores the result word (a wide result crosses by reference into
//      the shared image — readable from every instance because the
//      allocator is the shared cell);
//   5. releases the completion word (atomic store AFTER the plain result
//      store — the flag's seq_cst publish orders the result before it)
//      and notifies the joiner.
fn emit_wasi_thread_start(has_lets, has_lines) = {
  wat_emit("  (func $wasi_thread_start (param $tid i32) (param $start_arg i32)\n")
  wat_emit("    (local $clo i32)\n")
  wat_emit("    (global.set $tid_g (local.get $tid))\n")
  wat_emit("    (global.set $world_g (i32.load offset=12 (local.get $start_arg)))\n")
  // The static rings are per instance, as the line globals were: a spawned
  // instance allocates its own set from the shared cell before it runs.
  if has_lines { wat_emit("    (call $__init_lines (i32.const 0))\n    (drop)\n") }
  if has_lets { wat_emit("    (call $__init_lets (i32.const 0))\n    (drop)\n") }
  wat_emit("    (local.set $clo (i32.load offset=0 (local.get $start_arg)))\n")
  wat_emit("    (local.get $start_arg)\n")
  wat_emit("    (local.get $clo)\n")
  wat_emit("    (local.get $clo) (i32.load offset=0)\n")
  wat_emit("    (call_indirect (type $ft_task))\n")
  wat_emit("    (i32.store offset=8)\n")
  wat_emit("    (i32.atomic.store offset=4 (local.get $start_arg) (i32.const 1))\n")
  wat_emit("    (drop (memory.atomic.notify offset=4 (local.get $start_arg) (i32.const -1)))\n")
  wat_emit("  )\n")
  wat_emit("  (export \"wasi_thread_start\" (func $wasi_thread_start))\n")
}

// An install's config arguments, written into its record's first slots in
// source order — expressions of the installing frame, emitted as that
// frame's own. The slot ABI is words (the arms read it), so a wide value
// crosses by reference, the same box the argument boundary uses (the fold
// twin's raw f64 once fed i32.store and failed assembly,
// Hβ.emit.twin-state-width).
fn emit_config_writes(record_local, args) = each(
  {
    (i, arg) => {
      wat_emit("(local.get ${record_local})")
      emit_expr(arg)
      emit_wide_ref(tail_expr_repr(arg))
      wat_emit("(i32.store offset={int_to_str(8 + i * 4)})\n")
    },
  },
  enumerate(args)
)

// Total arm-slot count across a handler's per-effect groups — the record's
// contiguous arm region size.
fn sum_arm_name_lens(groups) = fold(0, (acc, g) => acc + len(group_arms(g)), groups)

// A handler's arm fns' `<~` lines, read from the line registry through the
// same registered arm names the fence is summed from ("" gaps carry
// none). Each line carries the slot lower assigned it, so the order here
// only has to be complete, never the same as lower's.
fn handler_arm_lines(groups) = flat_map(
  (g) => flat_map({ arm => if field_name_eq(arm, "") { [] } else { fn_lines_of(arm) } }, group_arms(g)),
  groups
)

// Lay each effect-group's arm fn-indices contiguously in the ONE record
// (at 8+4*nstate+4*(base+op_slot)) with a running base, and alloc a thin
// per-effect [record, base] evidence-entry bound to "__hstate_<h>_<ename>"
// (= state_local ++ "_" ++ ename). The ev-slot forwards that entry;
// emit_levperform reads (record, base) from it. Mirrors the seed's
// $emit_handler_effect_entries.
fn emit_handler_effect_entries(state_local, nstate, groups, enc) = {
  fold(
    0,
    (base, g) => {
      emit_arm_writes(state_local, nstate, base, group_arms(g), enc)
      let entry_name = "{state_local}_{group_ename(g)}"
      // the 8-byte [record, base] entry
      emit_alloc(8, entry_name)
      wat_emit("(local.get $")
      wat_emit(entry_name)
      wat_emit(")(local.get $")
      wat_emit(state_local)
      // entry[0] = record
      wat_emit(")(i32.store offset=0)\n")
      wat_emit("(local.get $")
      wat_emit(entry_name)
      wat_emit(")(i32.const ")
      wat_emit(int_to_str(base))
      // entry[1] = base
      wat_emit(")(i32.store offset=4)\n")
      base + len(group_arms(g))
    },
    groups
  )
  ()
}

// Write each non-gap arm fn-index into the record: the arm THIS install
// runs, under its own key. The fn-index lives in the global `$<arm>_idx`;
// the install copies it into the record so the perform reads the record,
// not a global — per-install evidence, never a static vtable. The key is
// the install's, not the enclosing twin's: the enclosing bracket's suffix
// named nothing an arm could have. "" gaps (unimplemented ops) are skipped;
// their slot stays zero.
fn emit_arm_writes(state_local, nstate, base, arms, enc) = each(
  {
    (k, arm_name) => if arm_name == "" {
      ()
    } else {
      wat_emit("(local.get ${state_local})(global.get ${arm_symbol(arm_name, enc)}_idx)(i32.store offset={int_to_str(8 + 4 * nstate + 4 * (base + k))})\n")
    },
  },
  enumerate(arms)
)

// The symbol a reference names where emit writes it: an install's arm under
// the install's key, a site under its instantiation, a name as itself.
fn ref_symbol(r) = match r {
  RefArm(ih, n) => arm_symbol(n, arm_install_enc(ih)),
  RefSite(h, n) => spec_target_name(h, n),
  RefCall(h, n) => spec_call_name(h, n),
  RefName(n) => n,
}

// ─── The derivative reading at the record (src/derive.mn) ─────────────
//
// Under a reading every record with captures — a closure's, an install's —
// carries one LANE per capture BEFORE its header: sixteen bytes, an epoch
// word and an f64, at rec − 16·(n − i) for capture i of the n the record
// already counts at offset 4. A lane read compares its epoch with the
// reading's ($__dt_epoch, advanced where each reading opens) and answers
// zero for a lane no reading wrote, or an earlier one did — state and
// captures that live past the extent enter it held fixed; a lane write
// stamps the epoch beside the value. Nothing after the header moves: every
// capture, line and k-tail offset the emit ever wrote stands, and a module
// with no reading allocates no lane (Law 7).
//
// The reading names these through the substrate channel, as it names the
// register (`tangent_in`): one op per lane read and write, one for a mint
// that writes its captures' tangents, three that mark a call, a perform
// and an install as running under the reading — the same nodes, emitted at
// the derivative face — and the two the reverse projection speaks: an
// adjoint twin hands each active Float parameter's adjoint back through a
// register of its own (`adjoint_out`), which the caller reads the instant
// the twin returns (`adjoint_in`).
type DeriveOp
  = DoLaneRead
  | DoLaneWrite
  | DoMintLanes
  | DoJvpCall
  | DoJvpPerform
  | DoJvpInstall
  | DoAdjIn
  | DoAdjOut

fn derive_op_of(name: String) = if name == "lane_read" {
  Some(DoLaneRead)
} else if name == "lane_write" {
  Some(DoLaneWrite)
} else if name == "mint_lanes" {
  Some(DoMintLanes)
} else if name == "jvp_call" {
  Some(DoJvpCall)
} else if name == "jvp_perform" {
  Some(DoJvpPerform)
} else if name == "jvp_install" {
  Some(DoJvpInstall)
} else if name == "adjoint_in" {
  Some(DoAdjIn)
} else if name == "adjoint_out" {
  Some(DoAdjOut)
} else {
  None
}

// The adjoint register for one active parameter position.
fn adjoint_register(j) = "__da{int_to_str(j)}"

// The registers an adjoint twin writes: as many as the widest adjoint twin
// in the module has active Float parameters, one f64 each per instance —
// the return register's shape, one per position rather than one.
fn emit_adjoint_registers(n) = if n <= 0 {
  ()
} else {
  wat_emit("  (global ${adjoint_register(n - 1)} (mut f64) (f64.const 0))\n")
  emit_adjoint_registers(n - 1)
}

fn lanes_on() = derivative_demanded()

fn lane_prefix(n) = if lanes_on() && n > 0 { 16 * n } else { 0 }

// A record's mint: the allocation grows by its lanes and the pointer steps
// past them, so the record's own address is where every reader expects it.
fn emit_record_alloc(size, n, local_name: String) = {
  let prefix = lane_prefix(n)
  emit_alloc(size + prefix, local_name)
  if prefix > 0 {
    wat_emit("    (local.set ${local_name} (i32.add (local.get ${local_name}) (i32.const {int_to_str(prefix)})))\n")
  } else {
    ()
  }
}

fn lane_local(h) = "__lane_{int_to_str(h)}"

// The lane's address off the count the record carries: rec − 16·count + 16·i,
// left in the same local the record arrived in.
fn emit_lane_addr(lane: String, i) =
  wat_emit("    (local.set ${lane} (i32.add (i32.sub (local.get ${lane}) (i32.shl (i32.load offset=4 (local.get ${lane})) (i32.const 4))) (i32.const {int_to_str(16 * i)})))\n")

// A lane's value under the reading that is open: zero unless the lane's
// epoch is the reading's.
fn emit_lane_load(lane: String) =
  wat_emit("    (select (f64.load offset=8 (local.get ${lane})) (f64.const 0) (i32.eq (i32.load (local.get ${lane})) (global.get $__dt_epoch)))\n")

// A lane write at the address already in `lane`: the value, then the epoch.
fn emit_lane_store(lane: String, value) = {
  wat_emit("    (local.get ${lane})\n")
  emit_expr(value)
  wat_emit("    (f64.store offset=8)\n")
  wat_emit("    (local.get ${lane}) (global.get $__dt_epoch) (i32.store)\n")
}

// The (index, tangent) pairs a mint or an install writes into a record whose
// count is known where it is built: lane i of n sits 16·(n − i) bytes before
// the record.
fn emit_lane_pairs(rec_local: String, n, pairs) = match pairs {
  [] => (),
  [ic, t, ...rest] => {
    match ic {
      LConst(_, LInt(i)) => {
        wat_emit("    (i32.sub (local.get ${rec_local}) (i32.const {int_to_str(16 * (n - i))}))\n")
        emit_expr(t)
        wat_emit("    (f64.store offset=8)\n")
        wat_emit("    (i32.sub (local.get ${rec_local}) (i32.const {int_to_str(16 * (n - i))})) (global.get $__dt_epoch) (i32.store)\n")
      },
      _ => wat_emit("    (unreachable)  ;; a lane index that is not a literal\n"),
    }
    emit_lane_pairs(rec_local, n, rest)
  },
  _ => wat_emit("    (unreachable)  ;; a lane pair with no tangent\n"),
}

fn emit_derive_op(h, op, args) = match op {
  DoLaneRead => match args {
    [rec, ic] => match ic {
      LConst(_, LInt(i)) => {
        let lane = lane_local(h)
        emit_expr(rec)
        wat_emit("    (local.set ${lane})\n")
        emit_lane_addr(lane, i)
        emit_lane_load(lane)
      },
      _ => wat_emit("    (unreachable)  ;; lane_read: an index that is not a literal\n"),
    },
    _ => wat_emit("    (unreachable)  ;; lane_read: not (record, index)\n"),
  },
  DoLaneWrite => match args {
    [rec, ic, v] => match ic {
      LConst(_, LInt(i)) => {
        let lane = lane_local(h)
        emit_expr(rec)
        wat_emit("    (local.set ${lane})\n")
        emit_lane_addr(lane, i)
        emit_lane_store(lane, v)
        wat_emit("    (i32.const 0)\n")
      },
      _ => wat_emit("    (unreachable)  ;; lane_write: an index that is not a literal\n"),
    },
    _ => wat_emit("    (unreachable)  ;; lane_write: not (record, index, tangent)\n"),
  },
  DoMintLanes => match args {
    [mint, ...pairs] => match mint {
      LMakeClosure(_, _, caps) => {
        let lane = lane_local(h)
        emit_expr(mint)
        wat_emit("    (local.set ${lane})\n")
        emit_lane_pairs(lane, len(caps), pairs)
        wat_emit("    (local.get ${lane})\n")
      },
      _ => wat_emit("    (unreachable)  ;; mint_lanes: not a mint\n"),
    },
    _ => wat_emit("    (unreachable)  ;; mint_lanes: no mint\n"),
  },
  DoJvpCall => match args {
    [call] => match call {
      LCall(ch, f, cargs) => emit_closure_call_at(ch, f, cargs, false, true),
      LTailCall(ch, f, cargs) => emit_closure_call_at(ch, f, cargs, true, true),
      _ => wat_emit("    (unreachable)  ;; jvp_call: not a call through a value\n"),
    },
    _ => wat_emit("    (unreachable)  ;; jvp_call: not one call\n"),
  },
  DoJvpPerform => match args {
    [perform] => match perform {
      LPerform(ph, disp, pargs) => emit_perform(ph, disp, pargs, true),
      _ => wat_emit("    (unreachable)  ;; jvp_perform: not a perform\n"),
    },
    _ => wat_emit("    (unreachable)  ;; jvp_perform: not one perform\n"),
  },
  DoJvpInstall => match args {
    [install, ...pairs] => match install {
      LHandleWith(ih, body, _handler, hname, inits, arm_names) => emit_install(ih, body, hname, inits, arm_names, Some(pairs)),
      _ => wat_emit("    (unreachable)  ;; jvp_install: not an install\n"),
    },
    _ => wat_emit("    (unreachable)  ;; jvp_install: no install\n"),
  },
  DoAdjIn => match args {
    [LConst(_, LInt(j))] => wat_emit("    (global.get ${adjoint_register(j)})\n"),
    _ => wat_emit("    (unreachable)  ;; adjoint_in: not a register index\n"),
  },
  DoAdjOut => match args {
    [LConst(_, LInt(j)), v] => {
      emit_expr(v)
      wat_emit("    (global.set ${adjoint_register(j)})(i32.const 0)\n")
    },
    _ => wat_emit("    (unreachable)  ;; adjoint_out: not (register index, adjoint)\n"),
  },
}

// ~> install — build the ONE handler record (handler IS state IS closure;
// protocol_handler_is_state_is_closure_is_evidence):
//   [_@0][nstate FENCE@4][state@8..][arms per-effect-contiguous]
// The record is built regardless of hname; commits reach it through the
// resolved record read on LStateSlotStore (the __hrec ladder), so anonymous
// and named installs are ONE shape — no global binds. Under the derivative
// reading (`lanes`: the config tangents the reading passes) the record's
// lanes take each active config's tangent after the config is written, and
// the declaration's init runs as its derivative twin, so a state field born
// from a config carries the config's tangent from its first read.
fn emit_install(h, body, hname, inits, arm_names, lanes) = {
  let local_name = "__hstate_{int_to_str(h)}"
  // INITS are the install's config arguments; the declaration's state
  // follows them, written by its init fn.
  let nfields = handler_state_count(hname)
  let nstate = len(inits) + nfields
  let total_arms = sum_arm_name_lens(arm_names)
  // The arms' `<~` lines follow the arms in this record — one ring per
  // site per INSTALL, so two installs of one handler are two filters.
  // Read off the same registered arm names the fence is summed from, and
  // the init fn's after them; each line carries the slot lower assigned it
  // past the fence.
  let arm_lines =
    handler_arm_lines(arm_names) ++ if nfields > 0 { fn_lines_of(init_fn_name(hname)) } else { [] }
  let size = 8 + 4 * (nstate + total_arms + len(arm_lines))
  emit_record_alloc(size, nstate, local_name)
  // FENCE @ offset 4 = nstate — dispatch locates arms fence-relative.
  wat_emit("(local.get $")
  wat_emit(local_name)
  wat_emit(")(i32.const ")
  wat_emit(int_to_str(nstate))
  wat_emit(")(i32.store offset=4)\n")
  // The install's key (`arm_twin_key`), read under the bracket this
  // install stands in: the arms it runs and the init fn it calls.
  let enc = arm_install_enc(h)
  // the config arguments at 8+i*4, first
  emit_config_writes(local_name, inits)
  // under the reading, the config tangents beside them
  match lanes {
    Some(pairs) => emit_lane_pairs(local_name, nstate, pairs),
    None => (),
  }
  // each effect-group's arms contiguous + its [record, base] entry
  emit_handler_effect_entries(local_name, nstate, arm_names, enc)
  // the arms' `<~` rings, past the arms
  emit_line_mints(arm_lines, local_name)
  // The state, written by the declaration's init fn with this record as its
  // $__state — before the world push below, so an init performs in the
  // installer's world. Under the reading, the init's derivative twin.
  if nfields > 0 {
    let init_sym = match lanes {
      Some(_) => match arm_face_at(h, "$init", spec_enc_active()) {
        Some(twin) => twin,
        None => arm_symbol(init_fn_name(hname), enc),
      },
      None => arm_symbol(init_fn_name(hname), enc),
    }
    wat_emit("(local.get ${local_name})(call ${init_sym})(drop)\n")
  } else {
    ()
  }
  // The WORLD bracket — every install draws its runtime edge: save the
  // live chain, cons one [key][entry][parent][install_world] node per
  // absorbed effect group (entry = the group's [record][base] view built
  // above; install_world = the saved chain, what the arm dispatch sets
  // around the arm call), restore after the extent (the same
  // save/restore shape as the scoped-singleton global below, world
  // outermost). ONE key: the interned effect name at key@0, walked by
  // $ev_declaring_node, which reads the arm slot through the entry to
  // pick the node that DECLARES the op. The second key — the interned
  // handler name at hkey@16, five bytes on every node of every install —
  // existed only so a second walk could find a handler BY NAME, and that
  // walk is gone: naming the handler was never the question, declaring
  // the op was.
  wat_emit("(global.get $world_g)(local.set $")
  wat_emit(local_name)
  wat_emit("_wprev)\n")
  each(
    (g) => {
      wat_emit("(i32.const ")
      wat_emit(int_to_str(string_offset(group_ename(g))))
      wat_emit(")(local.get $")
      wat_emit(local_name)
      wat_emit("_")
      wat_emit(group_ename(g))
      wat_emit(")(local.get $")
      wat_emit(local_name)
      wat_emit("_wprev)(call $world_push)\n")
    },
    arm_names
  )
  emit_expr(body)
  // band B k1 — the yield DRIVER. Takes this install's record as its own
  // __state (the arm call carries it — no global re-read) and is a LOOP
  // (a re-yield of an owned op re-enters the SAME driver with the new
  // k). A remainder's performs resolve through the LIVE world chain the
  // k record froze — the deep-handler law by REPRESENTATION, which the
  // old "the state_g bracket covers every k(v) re-entry" claim was not:
  // a k crossing an EXITED inner install found that install's global
  // restored to 0 while the frozen chain still carried its record (the
  // mn-world-resume-frozen fixture's silent 30). Body returned normally
  // → the flag is clear → the loop exits on its first check with the
  // body's parked value: semantically the ungated leg. A yield of a
  // FOREIGN op exits with the flag INTACT — it bubbles through this
  // install to the enclosing driver (or the _start backstop).
  // Gated on the ONE multishot_ops_of decider (walk_locals reads it
  // identically); an all-OneShot install emits the pre-k1 bytes exactly.
  let ms_ops = multishot_ops_of(hname)
  if len(ms_ops) > 0 {
    // band B M2b — the driver IS one redrive call: park the body result,
    // hand (record, parked) to $op___redrive_<hname> (the dispatch loop's
    // ONE home, shared with every resume flag-arm). A flag still raised
    // on return is a FOREIGN op — the value falls out of the bracket
    // with the flag intact and the enclosing boundary sees it (the
    // bubble, k1's law, unchanged).
    let hs = int_to_str(h)
    wat_emit("    (local.set $__hres_{hs})\n")
    wat_emit("    (local.get $")
    wat_emit(local_name)
    wat_emit(")(local.get $__hres_{hs})(call $op___redrive_")
    wat_emit(hname)
    wat_emit(")(local.set $__hres_{hs})\n")
    wat_emit("    (local.get $__hres_{hs})\n")
  }
  // world restore — unconditional, mirroring the unconditional save
  // (world outermost of the two brackets).
  wat_emit("(local.get $")
  wat_emit(local_name)
  wat_emit("_wprev)(global.set $world_g)\n")
}

// THE ONE PERFORM'S EMIT. Three shapes used to live here and in two other
// arms, and they disagreed about the WORLD BRACKET: the evidence arm saved
// the world, set it to the node's install world around the arm call and
// restored, while the two direct arms called bare. That difference was
// observable — an arm's own perform self-dispatched once before escaping,
// 52 where the deep-handler law says 51 — and it was possible only because
// the bracket was written per-arm. Here the record and the world are
// FETCHED by the dispatch and the bracket is emitted once, outside the
// branch, so no degree of boundness can mean something different from
// another.
//
// A DERIVATIVE QUERY is not dispatched at all: under its reading derive
// replaced it with the value's tangent, and a copy outside every reading
// is unreachable by the row — its effect is unhandled anywhere else, and
// the reading refuses the closure calls that could carry it inside.
//
// UNDER THE READING (`jvp`) the perform reaches the arm's derivative twin:
// a dispatch that names its install calls the twin the reading demanded
// there (`arm_face_at`), and one that walks reaches whatever record the
// walk finds and calls its arm at the derivative face — the slot's index
// one table half past the word face — whatever the target lower named.
fn emit_perform(h, disp, args, jvp) = if perform_is_query(disp) {
  wat_emit("    (unreachable)  ;; a derivative query outside its reading\n")
} else {
  let hs = int_to_str(h)
  // (0) the arm's __state and the world to run it under. A lexical answer
  // reads the install's own two locals; anything that walks resolves the
  // node once into evn_<h> and reads both out of it; a driver drives the
  // install record the lowering read through the record ladder.
  match disp {
    PdFrame(ih, _, _) => wat_emit("    (local.get $__hstate_{int_to_str(ih)})\n"),
    PdWalk(ekey, slot, _, _) => emit_declaring_node(hs, ekey, slot),
    PdDriver(_, record) => emit_expr(record),
  }
  // A PERFORM SPEAKS ITS SITE'S FACE, as a closure call does
  // (`emit_closure_call`): each argument at the width it is emitted at, the
  // result at the width the perform node proves. The arm it reaches is
  // twinned at the install's instance, and the site's types are that
  // instance's — the tee unifies every perform with the handler's — so the
  // two faces agree by construction, and `call_indirect`'s structural
  // match traps LOUDLY where they ever do not. Nothing is boxed: a Float op
  // costs a Float call. The declared face that stood here (the op's
  // parameter types, an effect variable signing the word floor) boxed every
  // wide value crossing a variable's slot — 8 bytes per perform under a
  // row that said nothing of it, every `fold` over Floats paying it per
  // element — and reached every arm wider than its declaration through an
  // adapter (Hβ.emit.generic-op-box-is-unrowed). A driver is not an op and
  // keeps the word protocol it was written in.
  match disp {
    PdDriver(_, _) => emit_args_word(args),
    _ => emit_expr_list(args),
  }
  // (2) the arm's identity, where the target does not already name it: the
  // slot form pushes the fn index out of the record's own arm region.
  // (3) THE WORLD BRACKET, once, for every dispatch — the deep-handler law
  // by construction. PdDriver is the one shape that must NOT bracket, and
  // it is not a dispatch: it is a direct call to a synthesized driver
  // against the install record it drives.
  match disp {
    PdDriver(name, _) => {
      wat_emit("    (call $op_")
      wat_emit(name)
      wat_emit(")\n")
    },
    _ => {
      // The record holds the arm's WORD face, as every fn_ptr does; a site
      // whose own vector is wide dispatches at the native face, and one
      // under the reading at the derivative face.
      match disp {
        PdWalk(_, slot, _, target) => if jvp {
          emit_arm_index(hs, slot)
          wat_emit("    (global.get $jvp_face) (i32.add)\n")
        } else {
          match target {
            ArmSlot => {
              emit_arm_index(hs, slot)
              if vector_is_wide(perform_vector_at(h, args)) {
                wat_emit("    (global.get $native_face) (i32.add)\n")
              } else {
                ()
              }
            },
            ArmNamed(_) => (),
          }
        },
        _ => (),
      }
      wat_emit("    (global.get $world_g)(local.set $evw_")
      wat_emit(hs)
      wat_emit(")\n")
      // the performer's world, exposed to the arm for the extent of its call
      // ($perform_world_g); the enclosing perform's value saved beside it
      wat_emit("    (global.get $perform_world_g)(local.set $evpw_")
      wat_emit(hs)
      wat_emit(")\n    (global.set $perform_world_g (local.get $evw_")
      wat_emit(hs)
      wat_emit("))\n")
      emit_install_world(disp, hs)
      match perform_callee(disp, jvp) {
        Some(name) => // A direct call names the arm at its own face, the one the site's
        // arguments were emitted at.
        wat_emit("    (call ${name})\n"),
        None => {
          wat_emit("    (call_indirect (type ")
          wat_emit(perform_ft(h, disp, args))
          wat_emit("))\n")
        },
      }
      wat_emit("    (global.set $world_g (local.get $evw_")
      wat_emit(hs)
      wat_emit("))\n    (global.set $perform_world_g (local.get $evpw_")
      wat_emit(hs)
      wat_emit("))\n")
    },
  }
  // An op's arm answers at the site's own face; a driver's word result
  // stands for the wide one the site proves.
  match disp {
    PdDriver(_, _) => emit_wide_deref(repr_of(lookup_ty(h))),
    _ => (),
  }
}

// The symbol a perform calls directly, or None for the slot's indirect call.
// Under the reading a dispatch naming its install calls the arm twin the
// reading demanded there, and a walking dispatch always takes the slot.
fn perform_callee(disp, jvp) = if jvp {
  match disp {
    PdFrame(ih, _, op) => match arm_face_at(ih, op, spec_enc_active()) {
      Some(twin) => Some(twin),
      None => Some("__jvp_absent"),
    },
    PdWalk(_, _, _, _) => None,
    PdDriver(name, _) => Some("op_{name}"),
  }
} else {
  match perform_target(disp) {
    Some(target) => Some(ref_symbol(target)),
    None => None,
  }
}

// Exhaustive match on every LowExpr variant; no _ fallback.
fn emit_expr(expr) = match expr {
  LConst(h, val) => emit_const(val, h),
  LLocal(h, name) => {
    // The register name reads the SAME (name, repr) projection the decl
    // wrote — an f64 local's get is $name.f64 (params included).
    let r = if h == 0 { RI32 } else { repr_of(lookup_ty(h)) }
    wat_emit("    (local.get $")
    wat_emit(local_wat_name(name, r))
    wat_emit(")\n")
  },
  LFeedbackPrior(h) => // (LF.B) The `<~` prior-iteration output — read live from the local the
  // LFeedback cycle declares + sets. The recurrence's y[n-1] term; no copy.
  {
    wat_emit("    (local.get $__fb_prev_")
    wat_emit(int_to_str(h))
    wat_emit(")\n")
  },
  LGlobal(h, name) => {
    // The ONE reference surface every named use routes through (direct calls,
    // tail calls and fn-as-value all evaluate their callee
    // here). spec_target_name redirects a wide-keyed generic site to its
    // twin's record; everything else — value lets, monomorphic fns, floor
    // keys — prints the plain name, byte-identical.
    wat_emit("    (global.get $")
    wat_emit(spec_target_name(h, name))
    wat_emit(")\n")
  },
  LLet(h, name, val) => {
    emit_expr(val)
    wat_emit("    (local.set $")
    wat_emit(local_wat_name(name, llet_repr(h, val)))
    wat_emit(")\n")
  },
  LUpval(h, idx) => {
    // W7: read captured value from the closure record at offset
    // 8 + idx*4 (header is [fn_ptr:i32, capture_count:i32]). A wide
    // capture's slot holds the ADDRESS of its bytes (emit_capture_stores'
    // spill); the deref cashes it back to its native width.
    wat_emit("    (local.get $__state)\n")
    wat_emit("    (i32.load offset=")
    wat_emit(int_to_str(8 + idx * 4))
    wat_emit(")\n")
    emit_wide_deref(repr_of(lookup_ty(h)))
  },
  LBinOp(_h, op, l, r) => {
    emit_expr(l)
    emit_expr(r)
    emit_binop_for(op, l, r)
  },
  LShow(h, x) => emit_show(h, x),
  LHash(h, x) => emit_hash(h, x),
  LUnaryOp(h, op, inner) => {
    // The node's handle carries the proven operand type; the neg
    // instruction is its repr projection (emit_unaryop_for — the
    // emit_binop_for shape one operand smaller).
    emit_expr(inner)
    emit_unaryop_for(h, op)
  },
  LDirectCall(h, fh, cname, tail, args) => {
    // The direct native call — the dispatch gradient's cash-out for a
    // callee lower proved to be a top-level fn. Args emit at their PROVEN
    // widths (an f64 argument rides the stack as f64 — no spill cell, no
    // word face); a tail call is a REAL return_call, wide results included
    // (the word-face demotion has nothing to demote, and the wf$ wrapper's
    // per-iteration frame leak — one leaked frame per hop of every deep
    // tail recursion routed through a wide fn's word face — cannot occur:
    // there is no hop). __state = the callee's own static-closure global,
    // the closure convention's exact semantics minus the table indirection.
    // The twin redirect reads the SAME projection every reference surface
    // routes through (the callee-ref handle carries the site's
    // instantiated TFun, so a wide-keyed generic call lands on its twin).
    let cname2 = spec_call_name(fh, cname)
    // The callee's EMITTED widths, read from the column at the symbol this
    // call names. The site follows them arg by arg: native where the slot is
    // wide, the word spill (address of a fresh cell) where the slot is a
    // word but the value is wide. The result mirrors it: a word result whose
    // site type is wide is an ADDRESS the caller derefs — the same
    // emit_wide_ref/emit_wide_deref pair the closure convention uses,
    // applied per the signature the callee's own header signed.
    let widths = direct_callee_widths(cname2, len(args))
    match widths {
      (param_reprs, ret_repr) => {
        wat_emit("    (global.get $")
        wat_emit(cname2)
        wat_emit(")\n")
        each(
          {
            (i, a) => {
              emit_expr(a)
              let declared = list_index(param_reprs, i)
              let actual = tail_expr_repr(a)
              // The four width quadrants, total: native→native and word→word pass
              // through; a wide value meeting a WORD slot spills (address as the
              // word face); a word-protocol REFERENCE meeting a NATIVE-wide slot
              // derefs (the word IS the address of the spilled value — the word
              // protocol's invariant). The missing deref quadrant floored every
              // former evidence-tier float call the direct tier absorbed.
              if repr_is_wide(declared) {
                if repr_is_wide(actual) { () } else { emit_wide_deref(declared) }
              } else {
                emit_wide_ref(actual)
              }
            },
          },
          enumerate(args)
        )
        let site_repr = repr_of(lookup_ty(h))
        let target = direct_call_target(cname2, args)
        // A tail call must agree with the ENCLOSING fn's native result exactly;
        // when the callee's emitted result is the word face of a wide site type
        // the deref must run after the call, so the tail form demotes there —
        // the direct call to a NATIVE-wide callee keeps the true return_call.
        if tail {
          if repr_is_wide(ret_repr) == repr_is_wide(site_repr) {
            wat_emit("    (return_call $")
            wat_emit(target)
            wat_emit(")\n")
          } else {
            wat_emit("    (call $")
            wat_emit(target)
            wat_emit(")\n")
            if repr_is_wide(site_repr) { emit_wide_deref(site_repr) } else { () }
          }
        } else {
          wat_emit("    (call $")
          wat_emit(target)
          wat_emit(")\n")
          if repr_is_wide(site_repr) && repr_is_wide(ret_repr) == false {
            emit_wide_deref(site_repr)
          } else {
            ()
          }
        }
      },
    }
  },
  LCall(h, func, args) => emit_closure_call(h, func, args, false),
  LTailCall(h, func, args) => emit_closure_call(h, func, args, true),
  LReturn(_h, inner) => {
    emit_expr(inner)
    // drift-audit: ignore
    wat_emit("    (return)\n")
  },
  LMakeClosure(h, LFn(fn_name, _arity, _param_names, _body, _fence, lines), captures_exprs) => {
    // H1 closure-record layout (the unified handler state):
    //   offset 0: fn_ptr (i32) — table index into $fns
    //   offset 4: capture_count (i32)
    //   offset 8 + 4*i: capture_i
    //   offset 8 + 4*(nc + j): the body's j-th `<~` line — its ring's
    //     address, so every closure minted here owns its own line
    //
    // MENTL-NATIVE: the record IS the calling convention's $__state.
    // The body's performs dispatch through the live world chain, so the
    // record carries captures only — no evidence region.
    //
    // Allocation routes through `perform emit_alloc(size, target)`,
    // dispatched by the installed EmitMemory handler. Bump today;
    // future arena / GC handlers swap the WAT without touching
    // this site.
    let nc = len(captures_exprs)
    let size = 8 + 4 * nc + 4 * len(lines)
    // THE RECORD POINTER PARKS IN A PER-HANDLE LOCAL, never the shared
    // `$state_tmp`, and the reason was measured rather than foreseen: a
    // capture that is ITSELF a closure re-enters this very arm and
    // overwrites the scratch, so the outer mint's closing read handed back
    // the INNER record. `fn f(p, x) = p(x) + 1` with
    // `let g = f((n) => n * 2)` answered `g(4) == 8` — `p(4)`, the capture
    // called in the callee's place — at exit 0 with ZERO diagnostics,
    // because `g` WAS the lambda. `LCall` already carries this exact fix
    // one arm over (`$call_<h>`, Hβ.emit.lcall-per-handle-state-scratch);
    // the mint is the same class, and a second site of one shape is the
    // census law's stop.
    let rec_local = mkclo_local(h)
    emit_record_alloc(size, nc, rec_local)
    // Store the table index at offset 0 (the nested twin's index when the
    // active bracket names one — spec_closure_name).
    wat_emit("    (local.get ${rec_local})\n")
    wat_emit("    (global.get $")
    wat_emit(spec_closure_name(fn_name))
    wat_emit("_idx)\n")
    wat_emit("    (i32.store offset=0)\n")
    // Store capture count at offset 4 — the fence.
    wat_emit("    (local.get ${rec_local})\n")
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(nc))
    wat_emit(") (i32.store offset=4)\n")
    // A self-recursive closure binds its OWN local to the record BEFORE
    // filling captures, so the self-capture reads the record, not the LLet's
    // not-yet-set local — which is a null fn_ptr, the parse_int nested-go
    // indirect-call-type-mismatch that trapped m3 in the lexer.
    // The self-capture is found by IDENTITY (its handle IS this closure's)
    // and the bind targets THE NAME IT READS: those are the two halves the
    // name-matched predecessor got wrong once the nested-fn discriminator
    // qualifies the emitted symbol, since the local namespace stays
    // source-named. $<that name> is a declared in-scope local exactly when
    // a self-capture exists; the LLet's own local.set re-binds harmlessly.
    // Mirrors the seed, which binds every let-bound closure's local early.
    match self_capture_name(captures_exprs, h) {
      "" => (),
      selfnm => {
        wat_emit("    (local.set $")
        wat_emit(local_wat_name(selfnm, RI32))
        wat_emit(" (local.get ${rec_local}))\n")
      },
    }
    // Store each capture at offset 8 + 4*i.
    emit_capture_stores(captures_exprs, 0, rec_local)
    // The body's `<~` lines follow the captures — one ring each.
    emit_line_mints(lines, rec_local)
    // Result: closure pointer on stack.
    wat_emit("    (local.get ${rec_local})\n")
  },
  LMakeContinuation(h, LFn(resume_fn_name, _arity, _param_names, _body, _fence, lines), captures_exprs, state_idx, ret_slot) => {
    // H7 — the multi-shot continuation record, CLOSURE-IDENTICAL HEAD
    // (band B k1): the k is CALLED through the same W7 convention every
    // closure takes (park as __state, LUpval reads captures at 8+4*i), so
    // its head must BE the closure head. The continuation metadata rides
    // in a TAIL — one contiguous record, so persist = memcpy carries it
    // whole.
    //
    //   offset 0:            fn_ptr (i32) — __k fn table index
    //   offset 4:            capture_count (i32)
    //   offset 8 + 4*i:      capture_i
    //   offset 8 + 4*nc:     state_idx — perform-site discriminator
    //   +4:                  ret_slot (documented: no live reader)
    //   +8:                  the FROZEN WORLD — the live $world_g at this
    //                        reify moment (world-as-value R4). LAST word;
    //                        $__k_world reads it at fixed offset 16+4*nc;
    //                        LResumeK rebinds through it so the remainder
    //                        performs in the world where it was captured.
    //
    // The continuation IS Mentl's oracle substrate — allocated through the
    // SAME emit_alloc swap surface as every heap value (the heap has one
    // story); trail rollback (graph_rollback) reverts speculative binds
    // between branch runs. No vtable: fn_ptr indexes the funcref table;
    // resume is call_indirect — Koka evidence passing (JFP 2022).
    let nc = len(captures_exprs)
    // head (8) + captures + [state_idx, ret, world] + the remainder's `<~`
    // lines (one ring each, shared by every resumption of this k as every
    // other heap write of the remainder is).
    let size = 8 + 4 * nc + 12 + 4 * len(lines)
    // Per-handle, for the reason the closure arm above measured: the head
    // IS the closure head, so it inherits the clobber too — a continuation
    // capturing a closure would return the capture.
    let rec_local = mkclo_local(h)
    emit_alloc(size, rec_local)
    // table index at 0 — the closure head (twin-redirected under a bracket).
    wat_emit("    (local.get ${rec_local})\n")
    wat_emit("    (global.get $")
    wat_emit(spec_closure_name(resume_fn_name))
    wat_emit("_idx)\n")
    wat_emit("    (i32.store offset=0)\n")
    // capture count at 4 — the SAME slot every closure carries.
    wat_emit("    (local.get ${rec_local})\n")
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(nc))
    wat_emit(") (i32.store offset=4)\n")
    // captures at 8 + 4*i — where LUpval reads (base_i 0 = offset 8).
    emit_capture_stores(captures_exprs, 0, rec_local)
    // The metadata tail.
    let state_idx_offset = 8 + 4 * nc
    wat_emit("    (local.get ${rec_local})\n")
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(state_idx))
    wat_emit(") (i32.store offset=")
    wat_emit(int_to_str(state_idx_offset))
    wat_emit(")\n")
    wat_emit("    (local.get ${rec_local})\n")
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(ret_slot))
    wat_emit(") (i32.store offset=")
    wat_emit(int_to_str(state_idx_offset + 4))
    wat_emit(")\n")
    wat_emit("    (local.get ${rec_local})\n")
    wat_emit("    (global.get $world_g)\n")
    wat_emit("    (i32.store offset=")
    wat_emit(int_to_str(state_idx_offset + 8))
    wat_emit(")\n")
    // The remainder's `<~` lines follow the tail (lower slotted them at
    // nc + 3 onward).
    emit_line_mints(lines, rec_local)
    // Result: continuation pointer on stack.
    wat_emit("    (local.get ${rec_local})\n")
  },
  LYield(h, op_name, args, k_expr) => // band B k1/M1.4 — the MultiShot unwind. The REAL form (k = the reified
  // remainder record): park k in $yield_k, the op's args (if any) as the
  // transient word-slot record in $yield_args, the interned op key in
  // $yield_op, raise $yield_flag, and return a width-honest dummy through
  // the frame's own result type (h = the REWRITTEN FRAME's tail node; a
  // Float-tailed frame keeps its f64 ft — never the perform's width). An
  // argless yield's bytes are unchanged (Ruling 3: strictly additive).
  // The FLOOR form carries the EMPTY op name (off-spine resume perform /
  // k2_floor_wrap's re-yield check) — the loud comment-marked refusal. M4:
  // the discriminator is op == "", NEVER the k value: an ABANDON yield's k
  // is also a bare LConst(0) (the dead continuation, stored in $yield_k and
  // never read), but it carries the REAL op name and takes the real-yield
  // path — the driver runs the arm, which returns without calling k, and
  // the loop delivers the arm value flag-clear (abandon by construction).
  if op_name == "" {
    wat_emit("    (unreachable) ;; multishot yield floor — off-spine perform / off-spine k2 boundary / arm-state / re-yield (k2/k3)\n")
  } else {
    emit_expr(k_expr)
    wat_emit("    (global.set $yield_k)\n")
    if len(args) > 0 {
      // The args record: [arg0][arg1]… at fixed word offsets, consumed
      // once by the matching driver dispatch (k is durable; args are
      // not). The record ptr parks in the per-site $yargs local — every
      // shared scratch is clobberable by an inner arg emission; each
      // arg VALUE parks in $state_tmp only after its own emission
      // completes. A non-word op arg meets the arm's loud call
      // mismatch (the callsite-result-width family), never a silent
      // truncation.
      emit_alloc(4 * len(args), "state_tmp")
      wat_emit("    (local.get $state_tmp)(local.set $yargs_")
      wat_emit(int_to_str(h))
      wat_emit(")\n")
      emit_yield_arg_stores(args, h, 0)
      wat_emit("    (local.get $yargs_")
      wat_emit(int_to_str(h))
      wat_emit(")(global.set $yield_args)\n")
    }
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(string_offset(op_name)))
    wat_emit(") (global.set $yield_op)\n")
    wat_emit("    (i32.const 1) (global.set $yield_flag)\n")
    emit_zero_at(repr_of(lookup_ty(h)))
  },
  LKExtend(h, k_expr) => {
    // band B M1.3 — the k2 boundary's yield path: compose the frame's
    // reified remainder onto the unwinding k ($yield_k := compose($yield_k,
    // frame_k) — M1.2's $__k_extend) and evaluate to the frame's
    // width-honest dummy with $yield_flag AND $yield_op UNTOUCHED — the
    // unwind continues as pure dataflow through the same value position the
    // fast path uses (h = the frame's tail node, the same width law
    // LYield's dummy follows; a return here would skip an install's driver
    // bracket).
    emit_expr(k_expr)
    wat_emit("    (call $__k_extend)\n")
    emit_zero_at(repr_of(lookup_ty(h)))
  },
  LIf(_h, cond, then_body, else_body) => {
    // The if's result WIDTH is the branches' proven join, read live
    // from the tails (body_result_repr) — the i32 floor loses to any
    // proof (an f64-computing branch types the if f64); two DISAGREEING
    // proofs keep the then's width and fail loud at assembly (a real
    // width frontier is named, never silently truncated). The baked
    // `(result i32)` was the arity-keyed-decider class STEP 1 deleted.
    let w = repr_join(body_result_repr(then_body), body_result_repr(else_body))
    emit_expr(cond)
    wat_emit("    (if (result ")
    wat_emit(repr_wat(w))
    wat_emit(")\n      (then\n")
    emit_body(then_body)
    wat_emit("      )\n      (else\n")
    emit_body(else_body)
    wat_emit("      ))\n")
  },
  LBlock(_h, stmts) => emit_body(stmts),
  LMakeList(h, elems) => emit_list_literal(h, elems),
  LMakeTuple(h, elems) => emit_tuple_literal(h, elems),
  LSimdLanes(h, lanes) => emit_simd_lanes(h, lanes),
  LFanout(_h, lex, _, forms) => emit_expr(fanout_form(lex, forms)),
  LMakeRecord(h, fields) => {
    // Untagged heap layout: fields at the width-summed offset in declaration
    // sort order (the prefix-sum of repr_width — an f64 field is 8 inline
    // bytes). Mirrors LMakeVariant minus the tag word — records carry their
    // identity in the type system; runtime sees raw fields. The allocation
    // SIZE is that same prefix-sum total (never n*4), so the record is exactly
    // as wide as its read-side offsets reach. emit_alloc routes through the
    // EmitMemory swap surface, same discipline as closures and variants.
    // The base pointer parks in the literal's OWN scratch, `$record_<h>`, as
    // a variant's and a tuple's do. Every record literal had shared one
    // scratch local, so a record literal written as a field of another
    // overwrote it and the outer literal answered the INNER's pointer —
    // `let r = {inner: {den: 5}}` bound `r` to `{den: 5}`, and `r.inner.den`
    // read 0 with no diagnostic, on every boot through 1a68ecc0.
    let size = product_byte_size(fields)
    let local_name = "record_{int_to_str(h)}"
    emit_alloc(size, local_name)
    emit_field_stores_acc(fields, 0, len(fields), 0, local_name)
    wat_emit("    (local.get $")
    wat_emit(local_name)
    wat_emit(")\n")
  },
  LMakeVariant(h, tag_id, fields) => {
    // Per-handle scratch `$variant_<h>` avoids shared-$variant_tmp
    // clobber: for nested constructors like `LConst(handle, LInt(999))`,
    // the inner LMakeVariant's allocation would overwrite the outer's
    // variant_tmp, so the outer's final `(local.get $variant_tmp)`
    // returned the INNER's pointer. Each LMakeVariant's identity IS
    // its graph handle per protocol_canonical_projection_pattern; the
    // scratch local name follows. HB: nullary variants stay sentinel.
    let n = len(fields)
    if n == 0 {
      wat_emit("    (i32.const ")
      wat_emit(int_to_str(tag_id))
      wat_emit(")\n")
    } else {
      // The allocation is the SAME width-summed fold the stores walk
      // (product_byte_size_acc from off=4, after the tag word) — never
      // 4 + n*4: the store fold writes an f64 payload as 8 inline bytes at
      // its aligned offset, so the word-slot size under-allocated and the
      // NEXT record clobbered the payload's high half — every float literal
      // m3 lexed collapsed to ~0.0 (TFloatLit's payload died at birth;
      // 2026-07-10). One fold, three readers: store, size, and the
      // eq/match-bind offsets (variant_payload_offset).
      let size = product_byte_size_acc(fields, 0, n, 4)
      let local_name = "variant_{int_to_str(h)}"
      emit_alloc(size, local_name)
      wat_emit("    (local.get $")
      wat_emit(local_name)
      wat_emit(")\n    (i32.const ")
      wat_emit(int_to_str(tag_id))
      wat_emit(") (i32.store offset=0)\n")
      emit_variant_field_stores_at(fields, 0, local_name)
      wat_emit("    (local.get $")
      wat_emit(local_name)
      wat_emit(")\n")
    }
  },
  LMatch(h, scrutinee, arms) => {
    // ADT match dispatch: cascading if-else over arm tag comparisons.
    // Per arm:
    //   - LPCon(_, tag, sub_pats): load tag at offset=0, compare to
    //     tag_id. On match: bind each sub-pattern at its width-summed
    //     payload offset (variant_payload_offset); emit body.
    //   - LPWild / LPVar at top-level: always-match terminal arm.
    //   - LPLit: scalar equality check on scrutinee directly.
    //   - LPTuple / LPRecord / LPList: predicate + binds through the
    //     shared pattern walkers (pat_tuple_off / record offsets / the
    //     srep-licensed list reads).
    // Empty arm list emits the POSTMORTEM trap — exhaustiveness violation
    // at runtime, complementing the inference-time check.
    //
    // The ROOT value parks at its own width: `scrut_local` names the
    // scratch at the scrutinee's repr, the one decider every root reader
    // takes (the binds, the literal predicates, the postmortem, and
    // `walk_locals_expr`, which declares a wide scratch). A Float scrutinee
    // parked in the word scratch did not assemble — every arm-list literal
    // over a Float is a match on its parameter.
    let sr = tail_expr_repr(scrutinee)
    emit_expr(scrutinee)
    wat_emit("    (local.set ${scrut_local(sr)})\n")
    emit_match_arms(arms, match_arms_repr(arms), h, sr)
  },
  LResumeK(h, k_expr, val_expr) => {
    // The MultiShot resume invoking its continuation record — the ONE site
    // that rebinds the world (the world-as-value arc's R4): save $world_g,
    // set it from the k record's frozen last word ($__k_world — fixed
    // offset 16 + 4*capture_count), run the remainder through the ordinary
    // W7 closure call, restore. The remainder's performs thereby resolve
    // in the world where the continuation was CAPTURED, never the world it
    // happens to be resumed under (the arm-config class's TIME sibling).
    // Save/restore lives HERE (caller side) so the k body's own tail
    // calls cannot leak the frozen world past the resume expression; the
    // composer's interior segment transitions bare-set under this bracket.
    // k_expr is the arm's __k param / a lambda's captured __k — a pure
    // local/upval read, evaluable twice.
    wat_emit("    (global.get $world_g) (local.set $__rk_wprev_{int_to_str(h)})\n")
    wat_emit("    (global.set $world_g (call $__k_world ")
    emit_expr(k_expr)
    wat_emit("))\n")
    // A continuation is the one closure kind a runtime helper also calls
    // blind to its type ($__k_compose), so its table face is the WORD face
    // and the resume speaks it (`emit_word_face_call`).
    emit_word_face_call(h, k_expr, [val_expr])
    wat_emit("    (local.set $__rk_val_{int_to_str(h)})\n")
    wat_emit("    (global.set $world_g (local.get $__rk_wprev_{int_to_str(h)}))\n")
    wat_emit("    (local.get $__rk_val_{int_to_str(h)})\n")
  },
  LHandleWith(h, body, _handler, hname, inits, arm_names) => emit_install(h, body, hname, inits, arm_names, None),
  LDerive(h, _seed, _body) => // The derivative reading: the install builds no record and pushes no world
  // — its DERIVED program stands where it stood. Opening the reading
  // advances the epoch every lane is read against, so state and captures
  // that live past the extent enter it held fixed, and zeroes the tangent
  // ring of every `<~` line its reach ticks, so each line's history before
  // the extent is held fixed; then the program runs.
  match derived_at(h, spec_enc_active()) {
    Some(x) => match x {
      Expansion(r) => {
        wat_emit(match r.mode {
          MForward => "    ;; derivative reading: forward\n",
          MReverse => "    ;; derivative reading: reverse\n",
        })
        wat_emit("    (global.set $__dt_epoch (i32.add (global.get $__dt_epoch) (i32.const 1)))\n")
        each(emit_ring_zero, r.rings)
        emit_expr(r.body)
      },
    },
    None => // Unreachable by construction: `derive_program` reads the very record
    // sets this module writes, under their brackets, and expands every
    // install in them or refuses before the gate — emission says nothing.
    wat_emit("    (unreachable)  ;; derivative reading with no derived program\n"),
  },
  LArena(h, b) => if arena_live() { emit_arena(h, b) } else { emit_expr(b) },
  LFeedback(h, depth, home, body, _spec) => {
    // <~ feedback — the site's line is a ring owned by the record of the
    // function that contains the cycle (`LineHome`, types.mn). Its address
    // is read once per tick from the site's slot in its own `__state` or,
    // for a top-level fn, from the instance global $__init_lines filled —
    // so every closure minted from one lambda, every install of one
    // handler and every twin of one generic ticks its own line.
    //
    // The cycle is load-prior → emit body → tee-current → store → advance,
    // and the prior is the ring's OLDEST slot: y[n-depth], which is what
    // `delay(depth)` asked for. The body's lowering may reference
    // `$__fb_prev_<h>` to consume it (the `(prev) =>` recurrence form binds
    // a name to it). A depth-1 ring is the single slot at offset 8 and
    // carries no head; deeper, the head word at offset 0 indexes the
    // oldest slot and advances one per tick, wrapping at the depth — a
    // load, a store and a bounded increment at any depth. The slot width is
    // the site's own repr read under the active bracket (the same read
    // that sized the ring), so a Float twin's slot is f64 where the
    // floor's is a word.
    let hs = int_to_str(h)
    let r = repr_of(lookup_ty(h))
    let rw = repr_wat(r)
    match home {
      LhStatic => {
        wat_emit("    (global.get $")
        wat_emit(line_global_name(h, emit_site()))
        wat_emit(")\n")
      },
      LhStaticJvp => {
        wat_emit("    (global.get $")
        wat_emit(line_global_name(h, emit_site()))
        wat_emit(")\n")
      },
      LhSlot(slot) => {
        wat_emit("    (i32.load offset=")
        wat_emit(int_to_str(8 + slot * 4))
        wat_emit(" (local.get $__state))\n")
      },
    }
    wat_emit("    (local.set $__ring_{hs})\n")
    if depth > 1 {
      wat_emit("    (local.set $__fbp_{hs} (i32.add (local.get $__ring_{hs}) (i32.add (i32.const 8) (i32.mul (i32.load (local.get $__ring_{hs})) (i32.const {int_to_str(repr_width(r))})))))\n")
      wat_emit("    (local.set $__fb_prev_{hs} ({rw}.load (local.get $__fbp_{hs})))\n")
    } else {
      wat_emit("    (local.set $__fb_prev_{hs} ({rw}.load offset=8 (local.get $__ring_{hs})))\n")
    }
    // The derivative reading's tick: the tangent ring's slot at the SAME
    // index the line's head just chose (read before the head advances), the
    // prior's tangent loaded from it before the body, the output's stored
    // into it after — the recurrence's sensitivity ticking beside it.
    let jvp_tick = match home {
      LhStaticJvp => true,
      LhStatic => false,
      LhSlot(_) => false,
    }
    if jvp_tick {
      wat_emit("    (local.set $__tslot_{hs} (i32.add (global.get ${tline_global_name(h, emit_site())}) ")
      if depth > 1 {
        wat_emit("(i32.sub (local.get $__fbp_{hs}) (local.get $__ring_{hs}))))\n")
      } else {
        wat_emit("(i32.const 8)))\n")
      }
      wat_emit("    (local.set $__fb_dprev_{hs}.f64 (f64.load (local.get $__tslot_{hs})))\n")
    }
    emit_expr(body)
    wat_emit("    (local.tee $__fb_{hs})\n")
    if jvp_tick {
      wat_emit("    (f64.store (local.get $__tslot_{hs}) (local.get $__fb_dcur_{hs}.f64))\n")
    }
    if depth > 1 {
      wat_emit("    ({rw}.store (local.get $__fbp_{hs}) (local.get $__fb_{hs}))\n")
      wat_emit("    (i32.store (local.get $__ring_{hs}) (i32.rem_u (i32.add (i32.load (local.get $__ring_{hs})) (i32.const 1)) (i32.const {int_to_str(depth)})))\n")
    } else {
      wat_emit("    ({rw}.store offset=8 (local.get $__ring_{hs}) (local.get $__fb_{hs}))\n")
    }
    // A line's pointer stored into a ring older than an open arena is
    // journaled with its leaf, as a state commit's is.
    if arena_live() && evac_journals(h) {
      let slot = if depth > 1 {
        "(local.get $__fbp_{hs})"
      } else {
        "(i32.add (local.get $__ring_{hs}) (i32.const 8))"
      }
      wat_emit("    (call $arena_slot_note {slot} (i32.const {int_to_str(leaf_code(evac_leaf_at(h)))}))\n")
    } else {
      ()
    }
  },
  LPerform(h, disp, args) => emit_perform(h, disp, args, false),
  LWasiCall(h, import_name, args) => match derive_op_of(import_name) {
    Some(op) => emit_derive_op(h, op, args),
    None => {
      // Stage 4a: direct substrate dispatch. Memory/Alloc ops project to
      // their instructions (the name IS the op identity, declared in
      // memory.mn — never an evidence round-trip); a unit-returning
      // store/copy pushes the kernel-uniform zero word so the statement
      // law holds. Everything else is a WASM-level import call: NO
      // __state push (imports don't take a closure record), NO $op_
      // prefix (the import IS the bridge). Per
      // PLAN §5.R band E.
      // A preview1 import's args emit at their DECLARED ABI widths — the
      // same wasi_import_reprs home the import decl projects from, so a
      // word arg filling an i64 param (path_open's rights, fd_readdir's
      // cookie) extends at the boundary instead of type-mismatching.
      match host_import(import_name) {
        Some((_, _, preprs, _)) => emit_wasi_args_at_widths(args, preprs, 0),
        None => emit_expr_list(args),
      }
      if import_name == "store_i32" {
        wat_emit("    (i32.store)(i32.const 0)\n")
      } else if import_name == "load_i32" {
        wat_emit("    (i32.load)\n")
      } else if import_name == "store_i8" {
        wat_emit("    (i32.store8)(i32.const 0)\n")
      } else if import_name == "load_i8" {
        wat_emit("    (i32.load8_u)\n")
      } else if import_name == "store_f64" {
        wat_emit("    (f64.store)(i32.const 0)\n")
      } else if import_name == "load_f64" {
        wat_emit("    (f64.load)\n")
      } else if import_name == "mem_copy" {
        wat_emit("    (memory.copy)(i32.const 0)\n")
      } else if import_name == "i32_xor" {
        wat_emit("    (i32.xor)\n")
      } else if import_name == "i32_or" {
        wat_emit("    (i32.or)\n")
      } else if import_name == "i32_and" {
        wat_emit("    (i32.and)\n")
      } else if import_name == "i32_shl" {
        wat_emit("    (i32.shl)\n")
      } else if import_name == "alloc" {
        emit_alloc_top()
      } else if import_name == "heap_mark" {
        // The heap line's HOME is the strategy's (per-instance global vs the
        // shared cell) — the impl fn beside $alloc owns it; the call site is
        // strategy-invariant.
        wat_emit("    (call $heap_mark_impl)\n")
      } else if import_name == "world_top" {
        wat_emit("    (global.get $world_g)\n")
      } else if import_name == "world_restore" {
        wat_emit("    (global.set $world_g)(i32.const 0)\n")
      } else if import_name == "arena_stat" {
        if arena_live() {
          wat_emit("    (call $arena_stat_impl)\n")
        } else {
          wat_emit("    (drop)(i32.const 0)\n")
        }
      } else if import_name == "tangent_in" {
        // The derivative reading's return register (src/derive.mn): a twin's
        // exit writes its result's tangent, the caller reads it the instant the
        // call returns — the world register's shape, one f64 per instance.
        wat_emit("    (global.get $__dt)\n")
      } else if import_name == "tangent_out" {
        wat_emit("    (global.set $__dt)(i32.const 0)\n")
      } else if import_name == "image_key" {
        // The build's identity word — an immutable global computed at emit
        // (emit_image_substrate); equal keys ⟺ a restored image's baked
        // words (table indices, interned offsets) resolve identically.
        wat_emit("    (global.get $build_key)\n")
      } else if import_name == "globals_area" {
        wat_emit("    (call $globals_area_impl)\n")
      } else if import_name == "globals_save" {
        wat_emit("    (call $globals_save)(i32.const 0)\n")
      } else if import_name == "image_restore" {
        wat_emit("    (call $image_restore)\n")
      } else if import_name == "heap_reset" {
        // unit-typed: the call consumes the arg; the (i32.const 0) closes the
        // result slot — the atomic_store precedent. The impl zeroes the
        // region before rewinding (virginity restored — see its emission).
        wat_emit("    (call $heap_reset_impl)(i32.const 0)\n")
      } else if import_name == "spawn_task" {
        // The task-record substrate (threading.mn's WasiThreads ops): the
        // impl fns live beside $alloc in the preamble, emitted only for a
        // spawning module. The closure argument is already its word face on
        // the stack — the record IS the crossing unit.
        wat_emit("    (call $spawn_task_impl)\n")
      } else if import_name == "join_task" {
        wat_emit("    (call $join_task_impl)\n")
      } else if import_name == "thread_id" {
        // Per-instance identity: 0 on the root instance, the host thread id
        // on a spawned one (the thread entry stamps it).
        wat_emit("    (global.get $tid_g)\n")
      } else if import_name == "atomic_load_i32" {
        // The atomics have NO handler arm — they ARE the wasm atomic
        // instruction set on shared memory, the threading peer of the
        // Memory/Alloc projections above. The name IS the op identity.
        wat_emit("    (i32.atomic.load)\n")
      } else if import_name == "atomic_store_i32" {
        wat_emit("    (i32.atomic.store)(i32.const 0)\n")
      } else if import_name == "atomic_rmw" {
        // Dispatch on the RmwOp tag (nullary ctor = its tag word) — the
        // br_table in the preamble impl, decl order = table order.
        wat_emit("    (call $atomic_rmw_impl)\n")
      } else if import_name == "atomic_cmpxchg" {
        // Two-operand compare-exchange — its own op (the one-operand rmw
        // shape cannot carry expected+replacement); args stack in the
        // instruction's own order: addr, expected, replacement.
        wat_emit("    (i32.atomic.rmw.cmpxchg)\n")
      } else if import_name == "wait_i32" {
        // memory.atomic.wait32 takes an i64 timeout; the op declares it i32
        // (timeout_ns: Int), so extend the top-of-stack timeout in place.
        wat_emit("    (i64.extend_i32_u)(memory.atomic.wait32)\n")
      } else if import_name == "notify" {
        wat_emit("    (memory.atomic.notify)\n")
      } else if import_name == "fence" {
        wat_emit("    (atomic.fence)(i32.const 0)\n")
      } else if import_name == "proc_exit" {
        // proc_exit is NORETURN — it terminates the process, so the code
        // after it is unreachable. Emit (unreachable) so the enclosing fn's
        // result type is satisfied (op_fail_exit_fail is `(result i32)` but
        // its body ends here). Matches the seed's `(call $proc_exit)(unreachable)`.
        wat_emit("    (call $proc_exit)(unreachable)\n")
      } else {
        wat_emit("    (call $")
        wat_emit(import_name)
        wat_emit(")")
        // A unit-returning import leaves nothing on the stack; the statement
        // law expects the kernel-uniform zero word (the store/copy/fence
        // precedent above, read here from the table's result column instead
        // of a per-op arm — measured 2026-09-17 as wat2wasm's "type mismatch
        // in drop" on the first unit-returning host op, host_wat_write).
        match host_import(import_name) {
          Some((_, _, _, None)) => wat_emit("(i32.const 0)\n"),
          Some((_, _, _, Some(_))) => wat_emit("\n"),
          None => wat_emit("\n"),
        }
      }
    },
  },
  LInvariantFailure(_h, invariant) => // Compiler-created executable boundaries have no productive-under-error
  // value. Preserve the typed invariant in the WAT diagnostic and terminate;
  // no backend is permitted to guess a handle, row, representation, or edge.
  {
    wat_emit("    (unreachable)  ;; executable-boundary invariant: ")
    wat_emit(show_boundary_invariant(invariant))
    wat_emit("\n")
  },
  LFieldLoad(h, rec, sel) => // W6: field load. The offset PROJECTS HERE from the receiver's live type
  // through field_sel_offset — under the active specialization bracket, so a
  // twin's instantiation closes a generic receiver (the last lower-time
  // layout bake, moved to the read).
  // The load WIDTH is the field's slot width in the same layout
  // (`field_load_repr`): an i32/pointer field is i32.load (byte-identical to
  // the pre-gradient form, Law 7), an f64 field is f64.load at its
  // width-summed offset — the genuine 8 inline bytes, no box, no chase.
  {
    let offset = field_sel_offset(rec, sel)
    if offset < 0 {
      // An offset the graph cannot prove writes the named trap, never an
      // offset-0 load of a foreign field, and the marker names the selector
      // and the receiver's row. The settle point said it before this byte
      // (`settle_node`), and an executable's gate refused there, so this
      // floor is emitted only where nothing runs it (a library's whole-emit).
      wat_emit("    (unreachable)  ;; field offset unprovable: ")
      wat_emit(field_offset_unprovable_why(rec, sel))
      wat_emit("\n")
    } else {
      emit_expr(rec)
      wat_emit("    (")
      wat_emit(repr_wat(field_load_repr(h, rec, sel)))
      wat_emit(".load offset=")
      wat_emit(int_to_str(offset))
      wat_emit(")\n")
    }
  },
  LConvert(_h, kind, operand) => {
    // W11: a REAL machine int<->float convert — the gradient's coercion arm.
    // Emit the operand (which leaves an i32 or f64 on the stack), then the one
    // signed WASM convert the kind names. Never an identity bit-reinterpret.
    emit_expr(operand)
    wat_emit("    (")
    wat_emit(convert_op(kind))
    wat_emit(")\n")
  },
  LStateSlotStore(_h, slot_offset, value, record) => // Hβ.first-light.resume-with-state-mutation: store VALUE into the
  // handler state record at slot_offset, mutating handler state across
  // resume calls. The RECORD is a resolved read minted at lower (the
  // __hrec ladder: the arm's LLet alias of its own $__state, a lambda's
  // capture, a bound callee's trailing param) — a value the frame was
  // born holding, so no bracket-scoped cache exists to go stale. The
  // retired $<hname>_state_g singleton was that cache; a closure's own
  // $__state is its closure record (the measured 32-not-46 / 20-not-25
  // silent state loss, both disciplines). The store WIDTH is the stored
  // value's proven repr. Negative slot_offset = lower-time
  // name-resolution miss (productive-under-error): emit the value as
  // drop, no store.
  //
  // A WIDE value lives in the cell its handler's init fn made for it — the
  // slot holds the cell's address (LStateInit) — so the commit writes
  // THROUGH the slot, in place: no new cell, nothing allocated per resume, a
  // handler's per-sample state as cheap to update as a local. The first form
  // stored the f64 into the word slot itself, eight bytes over a four-byte
  // slot and its neighbor, where the read side expected an address.
  if slot_offset < 0 {
    emit_expr(value)
    wat_emit("    (drop)\n")
  } else {
    let r = tail_expr_repr(value)
    emit_expr(record)
    if repr_is_wide(r) {
      wat_emit("    (i32.load offset={int_to_str(slot_offset)})\n")
      emit_expr(value)
      wat_emit("    ({repr_store_op(r)})\n")
    } else {
      emit_expr(value)
      wat_emit("    (i32.store offset={int_to_str(slot_offset)})\n")
      // A pointer committed into a record older than an open arena is
      // journaled with its leaf (the record is a frame read, so reading it
      // again is reading the same word).
      if arena_live() && evac_journals(lexpr_handle(value)) {
        emit_expr(record)
        wat_emit("    (i32.const {int_to_str(slot_offset)}) (i32.add) (i32.const {int_to_str(leaf_code(evac_leaf_at(lexpr_handle(value))))}) (call $arena_slot_note)\n")
      } else {
        ()
      }
    }
  },
  LStateInit(_h, _hname, slot, value) => {
    // A state field's first store, in its handler's init fn, whose $__state
    // IS the install record. A wide value takes a cell of its own here — the
    // slot ABI is words, and every later commit writes through this cell.
    wat_emit("    (local.get $__state)\n")
    emit_expr(value)
    emit_wide_ref(tail_expr_repr(value))
    wat_emit("    (i32.store offset={int_to_str(8 + slot * 4)})\n")
  },
  LDeclareFn(_fn_ir) => // H1.4: module-level fn declaration. The fn body is emitted
  // by emit_fns_expr's deep walk; this expression-position
  // appearance is a no-op (returns 0 as the LBlock placeholder
  // value). Lower wraps these in LBlock so they're discoverable
  // without ever materializing at runtime.
  wat_emit("    (i32.const 0) ;; LDeclareFn marker\n"),
}

fn emit_expr_list(exprs) = emit_expr_list_at(exprs, 0, len(exprs))

fn emit_expr_list_at(exprs, i, n) = if i >= n {
  ()
} else {
  emit_expr(list_index(exprs, i))
  emit_expr_list_at(exprs, i + 1, n)
}

// emit_const — every LowValue enumerated, so a new constant shape cannot be
// emitted before it is given its width.
fn emit_const(v, h) = match v {
  LInt(n) => {
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(n))
    wat_emit(")\n")
  },
  LFloat(f) => // Float = Word + a representation gradient (PLAN §4①). The literal's
  // PROVEN type (read live at the const handle) projects its machine width:
  // the inferred default is RF64, so a bare `3.14` is a native unboxed
  // (f64.const 3.14) flowing into an f64 slot the gradient made f64
  // everywhere it reaches (param/local/result/field all read the same
  // repr_of). A `repr f32` pin yields (f32.const ...); a lane-sequence pin
  // yields (v128.const ...). The box, the i32-floor zero, and the
  // f64.reinterpret_i64 re-boxing are DELETED — unsayable: with every slot
  // width-typed by repr_of, the float never flows into an i32 slot, so
  // there is nothing to box and no precision to fabricate.
  emit_float_const(f, repr_of(lookup_ty(h))),
  LBool(b) => if b { wat_emit("    (i32.const 1)\n") } else { wat_emit("    (i32.const 0)\n") },
  LString(s) => {
    // W5: string literals live in statically-emitted (data ...)
    // segments. LString's offset was assigned at the plan's
    // collect pass; string_offset looks it up through the
    // string_table handler. No runtime construction.
    let offset = string_offset(s)
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(offset))
    wat_emit(")\n")
  },
  LZero => emit_zero_at(repr_of(lookup_ty(h))),
}

// The zero of a representation — the value every width-agreeing placeholder
// emits (a yield's dummy through the frame's result, a k2 boundary's, the
// floor if's dropped else), read where the width is known.
fn emit_zero_at(r) = match r {
  RI32 => wat_emit("    (i32.const 0)\n"),
  RI64 => wat_emit("    (i64.const 0)\n"),
  RF64 => wat_emit("    (f64.const 0)\n"),
  RF32 => wat_emit("    (f32.const 0)\n"),
  RV128 => wat_emit("    (v128.const i32x4 0 0 0 0)\n"),
}

// emit_float_const — a float literal rendered at its proven representation.
// The same float value `f` projects to f64/f32/v128 by the repr_of at the
// literal's handle; RV128 broadcasts the scalar across four lanes (a literal
// in lane context is the uniform splat). A pointer-repr (RI32) at a float
// literal is an upstream type error — loud floor, never a fabricated zero.
// f: Float — the Intent Boundary pin (the float_render_positive precedent).
// f's only unpinned grounding flows through float_to_str, defined in
// lib/strings.mn, which sorts AFTER this file in the wheel — a
// forward reference whose pre-scheme carries fresh param vars, so at wheel
// scale the definition floored f to i32 while emit_const's callsite read the
// literal's proven Float ($ft_idi_i): m4 generation's first-fn-body ft
// mismatch, the ONE genuine param-width divergence in the dot-aware
// m2-vs-m3 census (2026-07-10).
fn emit_float_const(f: Float, r) = match r {
  RF64 => {
    wat_emit("    (f64.const ")
    wat_emit(float_to_str(f))
    wat_emit(")\n")
  },
  RF32 => {
    wat_emit("    (f32.const ")
    wat_emit(float_to_str(f))
    wat_emit(")\n")
  },
  RV128 => {
    wat_emit("    (v128.const f32x4 ")
    wat_emit(float_to_str(f))
    wat_emit(" ")
    wat_emit(float_to_str(f))
    wat_emit(" ")
    wat_emit(float_to_str(f))
    wat_emit(" ")
    wat_emit(float_to_str(f))
    wat_emit(")\n")
  },
  _ => {
    wat_emit("    ;; float literal at a non-float representation —\n")
    wat_emit("    ;; an HM type error upstream, not a fabricated value.\n")
    wat_emit("    (unreachable)\n")
  },
}

// emit_binop_for — the operand-Ty-directed binop emit. ++ and == are each
// ONE total operation over the unified value/sequence ontology (SYNTAX.md
// §Concatenation, §Equality), the element/field type read live from the
// graph (perform lookup_ty) only to PROJECT the representation cash-out,
// never to select between surface operators. The non-aggregate binops
// (arithmetic/comparison/logical) fall through to emit_binop.
fn emit_binop_for(op, l, r) = {
  let left_h = lexpr_handle(l)
  match op {
    BConcat => // ++ is ONE seq_concat over the unified sequence node-kind (SYNTAX.md
    // §Concatenation: "no String-vs-List dispatch because there is no
    // split"). The element/representation cash-out (byte-buffer vs
    // element-node) is a lower-time projection of the PROVEN element type —
    // never a guess. A resolved TList projects the element-node concat; a
    // resolved byte-sequence (String = [Byte]) projects the byte concat.
    // An UNRESOLVED operand is NOT a silent representation guess (the
    // dissolved E_ConcatTypeUnresolved / unresolved→str_concat fallback) —
    // it surfaces a Reason-carrying diagnostic, the no-silent-fallback law.
    {
      wat_emit("    (local.set $callee_closure)\n")
      wat_emit("    (local.set $state_tmp)\n")
      wat_emit("    (local.get $__state)\n")
      wat_emit("    (local.get $state_tmp)\n")
      wat_emit("    (local.get $callee_closure)\n")
      // ONE concat: a String IS a stride-1 list — the strip resolves the
      // alias to its byte-list truth, and the one list arm emits the O(1)
      // concat node (list_concat threads the carrier's sc). An unresolved
      // operand keeps the loud floor.
      match fold_strip(lookup_ty(left_h)) {
        TList(_) => wat_emit("    (call $list_concat)\n"),
        other => emit_concat_unresolved(other),
      }
    },
    BEq => // == / != is ONE structural-equality derivation, total over the five
    // node-kinds, directed by the operand Ty read live (SYNTAX.md §Equality):
    //   scalar (Int/Bool/byte/nullary tag)      -> i32.eq / i32.ne
    //   sequence ([a], incl String = [Byte])    -> length-then-element
    //         recursion: str_eq is the [Byte] instance, list_eq the [a]
    //         instance — one derivation, two element projections, never two
    //         developer-facing primitives.
    //   product / payload-sum (record/tuple/ADT) -> field/payload recursion
    // BNe = BEq then i32.eqz (the same derivation, negated). Pointer-eq on a
    // heap aggregate lying as structural equality is the named-forbidden
    // silent fallback — a TRecord/TTuple/TRecordOpen surfaces the deep-eq
    // diagnostic, never (i32.eq) on the address. Handle-less LowExpr
    // (left_h == 0) is a flat scalar by construction.
    emit_struct_eq(left_h, false),
    BNe => emit_struct_eq(left_h, true),
    BLt => // < / > / <= / >= over an AGGREGATE operand: the ordering leaf of the SAME
    // structural fold. A record/tuple/sum/sequence has no machine-width compare
    // instruction — a bare i32.lt_s on the heap address is a pointer compare
    // lying as a value ordering, the SAME silent footgun pointer-eq is for `==`
    // (Carried-Truth: the value's ORDER is a property of its proven structure,
    // never its address). emit_struct_cmp routes aggregates to the generated
    // 3-way $compare_<sig> helper (-1/0/1) + the sign test the op selects;
    // scalar words keep the byte-identical emit_binop_repr floor (Law 7).
    emit_struct_cmp(op, left_h),
    BGt => emit_struct_cmp(op, left_h),
    BLe => emit_struct_cmp(op, left_h),
    BGe => emit_struct_cmp(op, left_h),
    _ => // Arithmetic dispatches on the operand's TYPE, exactly as `==` and `<`
    // do (emit_struct_eq / emit_struct_cmp). The width join alone read the
    // operands' emitted widths, so a record, sum, sequence, function or
    // continuation floored to RI32 and `{x: 1} * {x: 2}` multiplied the two
    // ADDRESSES with zero diagnostics (2026-09-27,
    // Hβ.emit.arith-on-aggregate-is-pointer-arith). The judgment gates every
    // arithmetic operand's cell numeric (infer.mn numeric_demand), so what
    // reaches this arm is a word at its proven repr, or a floor twin's
    // quantified var — a word at the floor width by construction.
    emit_arith_for(op, left_h, l, r),
  }
}

fn emit_arith_for(op, left_h, l, r) = if left_h == 0 {
  // Flat scalar word by construction — the machine floor at the join.
  emit_binop_repr(op, repr_join(tail_expr_repr(l), tail_expr_repr(r)))
} else {
  match arith_operand_class(chase_deep(lookup_ty(left_h))) {
    AoWord => // The type's own repr: the pin's width where one is authored
    // (repr_of's TReprPin arm), the gradient's default otherwise — the same
    // fact the join of the emitted widths reads, at its one home.
    emit_binop_repr(op, slot_repr(lookup_ty(left_h))),
    AoUnproven(_) => // A variable at emit is a FLOOR twin's quantified var: every wide
    // instantiation minted its own twin and bound the var under its
    // bracket, so this operand is a word at the floor width. A var the
    // judgment never gated numeric is an invariant broken upstream, which
    // the settle point said before this byte (`settle_arith`).
    emit_binop_repr(op, RI32),
    AoAggregate => // Unreachable by construction — the judgment refused the bind that would
    // put an aggregate here, and the settle point refused the module that
    // reached it anyway (`settle_arith`) — so this floor is written only
    // where nothing runs it.
    wat_emit("    (unreachable)  ;; arithmetic on an aggregate past the gate\n"),
  }
}

fn emit_wide_ref(r) = match r {
  RI32 => (),
  RF64 => {
    // Spill the f64 to a fresh cell; leave the cell's ADDRESS (its word face).
    // The scratch is a DEDICATED local ($wide_cell / $f64_tmp) — never
    // $state_tmp, which the enclosing closure/record construction holds live
    // (the clobber that read a k-cell as a fn record → indirect-call mismatch).
    wat_emit("    (local.set $f64_tmp)\n")
    wat_emit("    (i32.const 8)\n")
    emit_alloc_top()
    wat_emit("    (local.tee $wide_cell)\n")
    wat_emit("    (local.get $f64_tmp)\n")
    wat_emit("    (f64.store)\n")
    wat_emit("    (local.get $wide_cell)\n")
  },
  RI64 => wat_emit("    (unreachable) ;; wide-ref: i64 has no producer yet\n"),
  RF32 => wat_emit("    (unreachable) ;; wide-ref: f32 has no producer yet\n"),
  RV128 => wat_emit("    (unreachable) ;; wide-ref: v128 has no producer yet\n"),
}

// Whether a value's word face is a fresh cell: the one repr `emit_wide_ref`
// spills, read by the allocation audit wherever a word face is taken.
fn wide_ref_allocates(r) = match r {
  RF64 => true,
  RI32 => false,
  RI64 => false,
  RF32 => false,
  RV128 => false,
}

fn emit_wide_deref(r) = match r {
  RI32 => (),
  RF64 => wat_emit("    (f64.load)\n"),
  RI64 => wat_emit("    (unreachable) ;; wide-deref: i64 has no producer yet\n"),
  RF32 => wat_emit("    (unreachable) ;; wide-deref: f32 has no producer yet\n"),
  RV128 => wat_emit("    (unreachable) ;; wide-deref: v128 has no producer yet\n"),
}

// ─── The one perform's three fetches ────────────────────────────────
// Resolve the declaring node ONCE into evn_<h> and push the arm's record.
// The walk is `ev_declaring_node(top, effect key, op slot)` — it stops at the
// innermost node whose handler actually DECLARES this op, and traps with the
// key in the postmortem window on a miss, which is why no dispatch needs a
// chain-miss guard of its own.
//   node = evn_<h>;  entry = node[4];  record = entry[0];  base = entry[1]
fn emit_declaring_node(hs: String, ekey: String, slot) = {
  wat_emit("    (local.set $evn_")
  wat_emit(hs)
  wat_emit(" (call $ev_declaring_node (global.get $world_g) (i32.const ")
  wat_emit(int_to_str(string_offset(ekey)))
  wat_emit(") (i32.const ")
  wat_emit(int_to_str(slot))
  wat_emit(")))\n")
  wat_emit("    (local.get $evn_")
  wat_emit(hs)
  wat_emit(")(i32.load offset=4)(i32.load offset=0)\n")
}

// The arm's fn index out of the record's OWN arm region, fence-relative off
// the record's nstate@4 and this effect's base — an interior read of a
// graph-derived record, never a vtable and never a row slot.
//   arm = record[(8 + 4*slot) + 4*base + 4*record[4]]
fn emit_arm_index(hs: String, slot) = {
  wat_emit("    (local.get $evn_")
  wat_emit(hs)
  wat_emit(")(i32.load offset=4)(i32.load offset=0)\n    (i32.const ")
  wat_emit(int_to_str(8 + 4 * slot))
  wat_emit(")(i32.add)\n    (local.get $evn_")
  wat_emit(hs)
  wat_emit(")(i32.load offset=4)(i32.load offset=4)\n    (i32.const 4)(i32.mul)(i32.add)\n    (local.get $evn_")
  wat_emit(hs)
  wat_emit(")(i32.load offset=4)(i32.load offset=0)(i32.load offset=4)\n    (i32.const 4)(i32.mul)(i32.add)\n    (i32.load offset=0)\n")
}

// The world the arm runs under. A lexical install saved the chain from before
// its own push into `_wprev` at install time — its own comment calls that
// value "what the arm dispatch sets around the arm call", and until this
// landing nothing read it. A walked node carries the same thing at iw@12.
// ONE source per shape, both feeding the one bracket.
fn emit_install_world(disp, hs: String) = match disp {
  PdFrame(ih, _, _) => {
    wat_emit("    (global.set $world_g (local.get $__hstate_")
    wat_emit(int_to_str(ih))
    wat_emit("_wprev))\n")
  },
  _ => {
    wat_emit("    (global.set $world_g (i32.load offset=12 (local.get $evn_")
    wat_emit(hs)
    wat_emit(")))\n")
  },
}

// The statically-known arm name, for the two shapes that have one.
// Word-face an argument list: each arg emits at its native width, then a
// wide one crosses by reference.
fn emit_args_word(args) = each(
  (a) => {
    emit_expr(a)
    emit_wide_ref(tail_expr_repr(a))
  },
  args
)

// The indirect arm call's type — the site's own vector; a driver speaks the
// word face it was written in.
fn perform_ft(h, disp, args) = match disp {
  PdDriver(_, _) => call_ft_name(args),
  _ => vector_ft_name(perform_vector_at(h, args)),
}

// An indirect site's vector: the record word, each argument at the width it
// is emitted at, and the result face the site proves.
fn site_vector(args, result) = ([RI32] ++ map(tail_expr_repr, args), result)

// A closure call's vector — its result the CALLEE's return, read off the
// callee expression's own type. The call node's type is that return at every
// call the source writes, but the synthesized body of a partial calls
// through the partial node itself, whose type is the product's arrow, so a
// wide result there read as a word (`fadd(1.5)` over a Float pair did not
// assemble, 2026-09-30). The callee's arrow is the one home both agree on; a
// callee that is not an arrow (a continuation, a synthesized leaf's own
// node) keeps the site's proof.
fn call_site_vector(f, args, h) = site_vector(args, call_result_repr(f, h))

fn call_result_repr(f, h) = match lexpr_handle(f) {
  0 => repr_of(lookup_ty(h)),
  fh => match lookup_ty(fh) {
    TFun(_, ret, _) => slot_repr(ret),
    _ => repr_of(lookup_ty(h)),
  },
}

// A perform site's vector: its result the op's answer the site proves.
fn perform_vector_at(h, args) = site_vector(args, repr_of(lookup_ty(h)))

// A closure call (W7): the record parks in $call_<h> — per handle, so a call
// nested in an argument cannot clobber it — and rides as the callee's
// __state, the arguments follow, and the fn_ptr at the record's offset 0
// names the callee. THE SITE'S PROVEN VECTOR PICKS THE FACE (`emit_fn_table`).
// An all-word vector dispatches at fn_ptr itself. A vector with a wide slot
// reaches the native face `$native_face` past it and passes its values as
// themselves: a Float closure costs a Float call, not a box. The word protocol
// that stood here from 2026-07-21 spilled every wide argument to a fresh heap
// cell and reached every wide callee through its `$wf$` wrapper, so `fn
// step(f, x: Float) with !Alloc = f(x)` allocated on every call with no row
// saying so. Total monomorphization is what makes the site's vector the
// callee's — a closure of a type is minted from a body emitted at that type —
// and `call_indirect`'s structural match checks it at the boundary, so a
// disagreement is a LOUD type trap, never a silent value. A tail call keeps
// its true `return_call` at any width, because the native face's result is
// the site's own.
// The function a direct call reaches. A store into a list slot where an arena
// lives reaches it through its barrier, `$list_set_j`, carrying the leaf of
// the value it stores (pushed here, after the arguments): the one place the
// stored value's type is known, read under the bracket the call is emitted
// in. A word stores with no barrier, since a word never points. A call
// through `list_set` as a value carries no leaf and reaches the slot's table
// face (`slot_face`), which journals with none.
fn direct_call_target(cname2: String, args) = if cname2 == "list_set" && len(args) == 3 && arena_live() {
  match store_leaf(args[2]) {
    Some(k) => {
      wat_emit("    (i32.const {int_to_str(k)})\n")
      "list_set_j"
    },
    None => cname2,
  }
} else {
  cname2
}

// The leaf a stored value moves through, or none for a word.
fn store_leaf(v) = match evac_at(lexpr_handle(v)) {
  EvWord => None,
  EvWide => Some(leaf_code(LfBoxed)),
  EvShape(_) => Some(leaf_code(evac_leaf_at(lexpr_handle(v)))),
  EvOpaque => Some(leaf_code(LfOpaque)),
}

fn emit_closure_call(h, func, args, tail) = emit_closure_call_at(h, func, args, tail, false)

// The call at its face: the derivative face under the reading (`jvp`), one
// table half past the word face, where the callee's derivative twin stands
// with a tangent slot after every Float parameter — the record's own lanes
// carrying its captures' tangents; the native face where the site's vector
// is wide; the word face otherwise.
fn emit_closure_call_at(h, func, args, tail, jvp) = {
  let hs = int_to_str(h)
  let v = call_site_vector(func, args, h)
  let op = if tail { "return_call_indirect" } else { "call_indirect" }
  emit_expr(func)
  wat_emit("    (local.set $call_{hs})\n    (local.get $call_{hs})\n")
  emit_expr_list(args)
  wat_emit("    (local.get $call_{hs}) (i32.load offset=0)\n")
  if jvp {
    wat_emit("    (global.get $jvp_face) (i32.add)\n")
  } else if vector_is_wide(v) {
    wat_emit("    (global.get $native_face) (i32.add)\n")
  } else {
    ()
  }
  wat_emit("    ({op} (type {vector_ft_name(v)}))\n")
}

// A vector's function-type NAME: the arity face $ftN when every slot is a
// word — the all-word instance of the same key — else
// `$ft_<params>_<result>`, one letter per repr.
fn vector_ft_name(v) = match v {
  (ps, r) => if all(repr_is_i32, ps) && repr_is_i32(r) {
    "$ft{int_to_str(len(ps))}"
  } else {
    "$ft_{str_concat_all(map(repr_letter, ps))}_{repr_letter(r)}"
  },
}

fn repr_letter(r) with Pure = match r {
  RI32 => "i",
  RI64 => "j",
  RF64 => "d",
  RF32 => "f",
  RV128 => "v",
}

// The word face of the indirect boundary, spoken by a caller BLIND to its
// callee's type. In user code that is a continuation's resume alone: the
// composer calls ks it cannot type, so a k is always reached at its word
// index. A wide argument crosses by reference and a wide result comes back by
// dereference; the callee's word slot holds its `$wf$` face (`emit_fn_refs`).
fn emit_word_face_call(h, func, args) = {
  emit_expr(func)
  wat_emit("    (local.set $call_{int_to_str(h)})\n    (local.get $call_{int_to_str(h)})\n")
  emit_args_word(args)
  wat_emit("    (local.get $call_{int_to_str(h)}) (i32.load offset=0)\n")
  wat_emit("    (call_indirect (type {call_ft_name(args)}))\n")
  emit_wide_deref(repr_of(lookup_ty(h)))
}

// The direct call's signature: THE CALLEE'S OWN, read from the column under
// the symbol the call actually names (cname2 — the twin's mangled name at a
// specialized site, the plain name otherwise). Not "the same derivation the
// callee runs" — the SAME FACT the callee's header signed, which is the only
// form of agreement an ABI can have.
//
// What this deletes is a whole parallel derivation: the declared scheme via
// env_lookup, a lookup_ty(fh) fallback, and — at a twinned site — the site's
// instantiation re-applied by hand (spec_site_pairs / spec_subst_pairs) to
// reconstruct the bracket the twin's body had been emitted under. Every one
// of those was a second opinion about a fact the callee had already stated,
// and the last one billed the f64.load miscompile that named this column.
fn direct_callee_widths(cname2: String, n) = sig_of_symbol(cname2, n)

fn emit_fold_state_insert() = {
  wat_emit("    (local.set $callee_closure)\n")
  wat_emit("    (local.set $state_tmp)\n")
  wat_emit("    (local.get $__state)\n")
  wat_emit("    (local.get $state_tmp)\n")
  wat_emit("    (local.get $callee_closure)\n")
}

// The one structural-eq derivation — the eq LEAF of the total structural
// FOLD (STEP 2). `==`/`!=` is the cursor projecting a value against the TYPE
// the graph proved (lookup_ty), recursing the five node-kinds: word (i32/f64
// value-eq), sequence (str_eq/list_eq — the [Byte]/[a] instances), product
// (field-wise recursion via the generated $eq_<sig> helper), sum (tag-then-
// payload). The fold-THROUGH arms (TAlias->inner, TRefined->base, resolved-
// TVar) strip FIRST — representation/structure is a property of the carried
// type, never the authored name or the predicate (the same resolve repr_of
// does). `neg` selects != (i32.eqz the result).
fn emit_struct_eq(left_h, neg) = if left_h == 0 {
  // Flat scalar word — value equality IS structural.
  if neg { wat_emit("    (i32.ne)\n") } else { wat_emit("    (i32.eq)\n") }
} else {
  // THE FOLD BOUNDARY: resolve ONCE at entry (chase_deep — every interior
  // bound var cashed to its binding), and the whole fold family downstream
  // — sigs, dedup, generation, field dispatch, walker callees — reads a
  // var-free type by invariant. The one-level lookup_ty read left interior
  // vars raw, and the family's walks re-chased independently (dispatch
  // yes, sigs no): two TList(TVar) sites with different bindings shared
  // one "li" walker and the second site's elements walked the wrong
  // protocol (measured: the paired tuple/nested-list program trapped in
  // list_eq_loop). One resolve, one truth.
  emit_eq_for_ty(fold_strip(chase_deep(lookup_ty(left_h))), neg)
}

// fold_strip / fold_sig — the structural fold's shared skeleton — now live at
// their Carried-Truth home in types.mn (a type's fold-signature is a property
// OF THE TYPE, read identically by the eq / show / compare / hash / pack leaves).
//
// The eq leaf over an ALREADY-STRIPPED type — H6-exhaustive over the five
// node-kinds. Product (TRecord/TTuple/TRecordOpen) routes to its generated
// recursive helper $eq_<sig> (field-wise deep recursion, never a pointer-eq
// lie). The sum (TName payload-ADT) leaf — env-driven per-variant payload
// recursion — is the positive-form peer Hβ.eq.fold-sum-leaf (the generator
// receives it next; nullary ADT tags ARE words and fold here as i32.eq).
fn emit_eq_for_ty(ty, neg) = match ty {
  TList(e) => // ONE sequence arm, dispatched on the element's RESOLVED face: a byte
  // sequence routes to the [byte] family (so String and [byte] — one type
  // under §4① — can never diverge), a float sequence compares by VALUE
  // through the word protocol (list_eq_f64 derefs each reference; the word
  // list_eq would pointer-compare them), a STRUCTURAL element calls its
  // generated sequence walker (emit_eq_leaf_seq — word compare on a
  // struct element is pointer identity), and a word element keeps the
  // floor, which IS value-faithful for single-word elements.
  {
    emit_fold_state_insert()
    match seq_elem_face(e) {
      TByte => wat_emit("    (call $str_eq)\n"),
      TFloat => wat_emit("    (call $list_eq_f64)\n"),
      face => if seq_face_structural(face) {
        wat_emit("    (call $eq_")
        wat_emit(fold_sig(ty))
        wat_emit(")\n")
      } else {
        wat_emit("    (call $list_eq)\n")
      },
    }
    if neg { wat_emit("    (i32.eqz)\n") } else { () }
  },
  TRecord(fields) => // Product — field-wise structural recursion. The generated $eq_<sig>
  // helper (emit_one_eq_helper) takes (__state, a, b) and ANDs each
  // field's eq at the canonical width-summed offset, recursing for nested
  // products. The eq/hash-disagreement footgun is unsayable: ONE traversal.
  emit_eq_product_call(fold_sig(ty), neg),
  TRecordOpen(fields, _) => emit_eq_product_call(fold_sig(ty), neg),
  TTuple(elems) => emit_eq_product_call(fold_sig(ty), neg),
  TName(_, _) => // Sum payload-ADT — per-variant tag-then-payload recursion via the generated
  // $eq_n<Name> helper (the fifth leaf, reading the env's ConstructorScheme
  // variant payload types). A purely-nullary ADT folds to a tag i32.eq inside
  // the helper; a fielded ADT loads tags then recurses each payload.
  emit_eq_sum_call(fold_sig(ty), neg),
  TFloat => // The word leaf READS THE GRADIENT (§5.U: "the word-leaf reads the
  // gradient — f64.eq for an f64 field"): a proven-Float operand compares
  // at its native width. i32.eq on two f64 operands was the one leaf the
  // cmp twin (emit_cmp_for_ty's TFloat arm) had and this one lacked —
  // float_is_zero's `f == 0.0` emitted (f64.const 0.0)(i32.eq).
  if neg { wat_emit("    (f64.ne)\n") } else { wat_emit("    (f64.eq)\n") },
  _ => // Scalar word: Int / Unit / fn-table index / continuation pointer —
  // resolved types whose value IS one word, so i32.eq IS structural;
  // `==` leaves a Bool regardless of operand width. A VARIABLE reaches this
  // arm only where the settle point proved nothing runs it as anything but a
  // word (`settle_node` refused every executable site where it would be).
  if neg { wat_emit("    (i32.ne)\n") } else { wat_emit("    (i32.eq)\n") },
}

// A ++ on a genuinely-unresolved operand element type: no representation
// to project, so emit refuses to guess (the dissolved unresolved→str_concat
// fallback). Loud Reason-carrying floor, never a fabricated representation.
fn emit_concat_unresolved(_ty) = {
  wat_emit("    ;; ++ on unresolved element type — representation\n")
  wat_emit("    ;; is a lower-time projection of the proven element\n")
  wat_emit("    ;; type; no element type proven here. (no silent guess)\n")
  wat_emit("    (unreachable)\n")
}

// Product == : call the generated recursive fold helper. The state-insert
// reorders the stack to (__state, a, b) — the W7 convention str_eq/list_eq
// also take. The helper returns Bool; != wraps i32.eqz, the same derivation
// negated. The deep field recursion lives in the helper, generated once per
// distinct product type and deduped (the e-graph canonicalizes equal folds).
fn emit_eq_product_call(sig, neg) = {
  emit_fold_state_insert()
  wat_emit("    (call $eq_")
  wat_emit(sig)
  wat_emit(")\n")
  if neg { wat_emit("    (i32.eqz)\n") } else { () }
}

// Sum (TName payload-ADT) eq — the FIFTH leaf of the structural fold, landed.
// A `==` on a sum operand is a CALL to the generated recursive $eq_n<Name>
// helper (mirror of the product $eq_<sig> call): the state-insert reorders the
// stack to (__state, a, b), the helper returns Bool, != wraps i32.eqz. The
// helper reads the env's ConstructorScheme entries for the type — per-variant
// tag-then-payload recursion — never a pointer-eq lie on the variant address.
// Hβ.eq.fold-sum-leaf, realized: == is total over all five node-kinds.
fn emit_eq_sum_call(sig, neg) = {
  emit_fold_state_insert()
  wat_emit("    (call $eq_")
  wat_emit(sig)
  wat_emit(")\n")
  if neg { wat_emit("    (i32.eqz)\n") } else { () }
}

// ─── The eq-leaf of the structural fold: generated recursive helpers ──────
// A product == is a CALL to $eq_<sig>, generated once per distinct product
// type and deduped (the e-graph canonicalizes equal folds). The generator
// mirrors emit_distinct_repr_ft_types exactly: a pre-pass walks the lowered
// IR collecting the product types that appear at a `==`/`!=` site (the graph
// IS the index), and each distinct sig emits ONE recursive helper. The helper
// is well-founded on the value's finite structure: a nested product is a CALL
// to its own helper (recursive ADTs descend the value at runtime, finite);
// inline expansion would not terminate on a self-referential type, a call does.
//
// fold_sig lives at its Carried-Truth home (types.mn) — the structural
// signature every fold leaf shares — with `move_sig` beside it, the one an
// arena's evacuation leaves are named by.
//
// ─── THE UNIFIED EACH — the fold's ONE collection walk + ONE dedup walk ────
//
// §5.U's fold(ty, leaf) at the emit, its traversals unified. FOUR
// byte-identical ~60-arm walkers (eq / compare / hash / show) each re-walked
// the WHOLE lowered tree to collect one leaf's type closure — the same each
// four times over one fact — and the eq/cmp copies dropped their trigger's
// RIGHT subtree (`a == (b == c)`'s inner site was never collected). FOUR
// byte-identical 13-line dedup walkers then each walked their closure; a
// FIFTH walk (register_show_literals) re-collected the show closure for the
// data section. The project_emit_state fold (this file) is the in-repo
// precedent: four parallel walks of one tree became ONE walk with
// per-projection accumulators. Here: ONE walk carries the four closures as
// one record; a TRIGGER arm contributes to its slot (an eq/ne site, an
// ordering site, a $show_ call, a $hash_ call); recursion is uniform over
// EVERY child, so no subtree is dropped. The plan computes the record
// ONCE and both readers (the literal registration, the leaf emission) read
// it. One dedup walk emits each distinct signature's helper once, the leaf
// selected by the FoldOp ADT — four fn names were four spellings of one
// operation fact.
type FoldOp = FoldCompare | FoldEq | FoldHash | FoldShow

fn fold_closures_empty() = {cmp: [], eq: [], evac: [], hash: [], show: []}

// The closed-record pins are load-bearing (Intent Boundary): an unannotated
// acc infers a partial OPEN record per accessor, and an open receiver's field
// offsets are computed over the partial set while the record sorts over the
// full one (Hβ.lower.trecordopen-wrong-field — this fn's first compile hit
// that floor at runtime).
fn fold_acc_eq(acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, lh) =
  {cmp: acc.cmp, eq: eq_operand_contrib(lh, acc.eq), evac: acc.evac, hash: acc.hash, show: acc.show}

// The ordering contribution IS the eq contribution (cmp_agg_operand_contrib
// was a byte-copy of eq_operand_contrib — deleted; one reach, two slots).
fn fold_acc_cmp(acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, lh) =
  {cmp: eq_operand_contrib(lh, acc.cmp), eq: acc.eq, evac: acc.evac, hash: acc.hash, show: acc.show}

fn fold_acc_hash(acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, arg) = {
  cmp: acc.cmp,
  eq: acc.eq,
  evac: acc.evac,
  hash: hash_operand_contrib(arg, acc.hash),
  show: acc.show,
}

fn fold_acc_show(acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, arg) = {
  cmp: acc.cmp,
  eq: acc.eq,
  evac: acc.evac,
  hash: acc.hash,
  show: show_operand_contrib(arg, acc.show),
}

// What an arena's exit moves by type: the arena's value, a handler state's
// a `<~` line's pointer, and a value a list slot stores — every store whose
// barrier journals the slot with the leaf. Collected only in a module that
// opens an arena, so every other module's fold is what it was.
fn fold_acc_evac(acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, ty) = if arena_demanded() {
  {cmp: acc.cmp, eq: acc.eq, evac: evac_root_add(acc.evac, ty), hash: acc.hash, show: acc.show}
} else {
  acc
}

fn fold_acc_evac_at(acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, h) =
  if h == 0 { acc } else { fold_acc_evac(acc, evac_type_at(h)) }

// A list slot's store moves the value it stores by the value's type.
fn fold_acc_store(acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, n: String, args) =
  if n == "list_set" && len(args) == 3 { fold_acc_evac_at(acc, lexpr_handle(args[2])) } else { acc }

fn fold_trigger_binop(op, lh, acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}) = match op {
  BEq => fold_acc_eq(acc, lh),
  BNe => fold_acc_eq(acc, lh),
  BLt => fold_acc_cmp(acc, lh),
  BGt => fold_acc_cmp(acc, lh),
  BLe => fold_acc_cmp(acc, lh),
  BGe => fold_acc_cmp(acc, lh),
  _ => acc,
}

fn collect_fold_tys_list(stmts, acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}) = if len(stmts) == 0 {
  acc
} else {
  collect_fold_tys_list(drop_last(stmts), collect_fold_tys_expr(last(stmts), acc))
}

fn collect_fold_tys_arms(arms, acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}) =
  collect_fold_tys_arms_from(arms, acc, 0)

fn collect_fold_tys_arms_from(arms, acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}, i) = if i >= len(arms) {
  acc
} else {
  match list_index(arms, i) {
    (_, body) => collect_fold_tys_arms_from(arms, collect_fold_tys_expr(body, acc), i + 1),
  }
}

fn collect_fold_tys_expr(expr, acc: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}) = match expr {
  LShow(_h, x) => collect_fold_tys_expr(x, fold_acc_show(acc, x)),
  LHash(_h, x) => collect_fold_tys_expr(x, fold_acc_hash(acc, x)),
  LCall(_h, f, args) => collect_fold_tys_expr(f, collect_fold_tys_list(args, acc)),
  LDirectCall(_h, _fh, n, _t, args) => collect_fold_tys_list(args, fold_acc_store(acc, n, args)),
  LTailCall(_h, f, args) => collect_fold_tys_expr(f, collect_fold_tys_list(args, acc)),
  LBinOp(_h, op, l, r) => collect_fold_tys_expr(r, collect_fold_tys_expr(l, fold_trigger_binop(op, lexpr_handle(l), acc))),
  LResumeK(_h, k, v) => collect_fold_tys_expr(v, collect_fold_tys_expr(k, acc)),
  LLet(_h, _n, inner) => collect_fold_tys_expr(inner, acc),
  LUnaryOp(_h, _op, i) => collect_fold_tys_expr(i, acc),
  LReturn(_h, i) => collect_fold_tys_expr(i, acc),
  LMakeClosure(_h, LFn(_n, _a, _p, body, _f, _l), caps) => collect_fold_tys_list(body, collect_fold_tys_list(caps, acc)),
  LMakeContinuation(_h, LFn(_n, _a, _p, body, _f, _l), caps, _, _) => collect_fold_tys_list(body, collect_fold_tys_list(caps, acc)),
  LYield(_h, _op, args, k) => collect_fold_tys_expr(k, collect_fold_tys_list(args, acc)),
  LKExtend(_h, k) => collect_fold_tys_expr(k, acc),
  LDeclareFn(LFn(_n, _a, _p, body, _f, _l)) => collect_fold_tys_list(body, acc),
  LIf(_h, c, t, e) => collect_fold_tys_list(e, collect_fold_tys_list(t, collect_fold_tys_expr(c, acc))),
  LBlock(_h, stmts) => collect_fold_tys_list(stmts, acc),
  LMakeList(_h, es) => collect_fold_tys_list(es, acc),
  LMakeTuple(_h, es) => collect_fold_tys_list(es, acc),
  LSimdLanes(_h, lanes) => collect_fold_tys_list(lanes, acc),
  LFanout(_h, lex, _, forms) => collect_fold_tys_expr(fanout_form(lex, forms), acc),
  LMakeRecord(_h, fs) => collect_fold_tys_list(fs, acc),
  LMakeVariant(_h, _t, fs) => collect_fold_tys_list(fs, acc),
  LMatch(_h, s, arms) => collect_fold_tys_arms(arms, collect_fold_tys_expr(s, acc)),
  LHandleWith(_h, b, hn, _hn2, inits, _arms) => collect_fold_tys_expr(b, collect_fold_tys_expr(hn, collect_fold_tys_list(inits, acc))),
  LDerive(_h, seed, b) => collect_fold_tys_expr(b, collect_fold_tys_expr(seed, acc)),
  LArena(h, b) => collect_fold_tys_expr(b, fold_acc_evac_at(acc, h)),
  LFeedback(h, _d, _home, b, s) => collect_fold_tys_expr(s, collect_fold_tys_expr(b, fold_acc_evac_at(acc, h))),
  LPerform(_h, _d, args) => collect_fold_tys_list(args, acc),
  LWasiCall(_h, _n, args) => collect_fold_tys_list(args, acc),
  LFieldLoad(_h, rec, _o) => collect_fold_tys_expr(rec, acc),
  LConvert(_h, _, operand) => collect_fold_tys_expr(operand, acc),
  LStateSlotStore(_h, _o, v, _) => collect_fold_tys_expr(v, fold_acc_evac_at(acc, lexpr_handle(v))),
  LStateInit(_h, _hn, _s, v) => collect_fold_tys_expr(v, acc),
  LConst(_, _) => acc,
  LLocal(_, _) => acc,
  LFeedbackPrior(_) => acc,
  LGlobal(_, _) => acc,
  LUpval(_, _) => acc,
  LInvariantFailure(_, _) => acc,
}

// The one dedup walk: emit each distinct fold_sig's helper ONCE, the leaf
// generator selected by the op.
fn emit_distinct_fold_leaves(op, tys, seen) = if len(tys) == 0 {
  ()
} else {
  let ty = last(tys)
  let sig = fold_sig(ty)
  if ls_find_str_local(seen, sig, 0) >= 0 {
    emit_distinct_fold_leaves(op, drop_last(tys), seen)
  } else {
    match op {
      FoldEq => emit_one_eq_helper(sig, ty),
      FoldCompare => emit_one_compare_helper(sig, ty),
      FoldHash => emit_one_hash_helper(sig, ty),
      FoldShow => emit_one_show_helper(sig, ty),
    }
    emit_distinct_fold_leaves(op, drop_last(tys), [sig] ++ seen)
  }
}

// The four leaves behind the one walk. Emission order (eq, compare, hash,
// show) preserves the module layout the four separate entry fns produced.
fn emit_fold_leaf_helpers(closures: {cmp: [Ty], eq: [Ty], evac: [Ty], hash: [Ty], show: [Ty]}) = {
  // One region over the four leaf families: the closures record lives
  // outside the mark; every generated helper streams as it is built.
  //
  let m = heap_mark()
  emit_distinct_fold_leaves(FoldEq, closures.eq, [])
  emit_distinct_fold_leaves(FoldCompare, closures.cmp, [])
  emit_distinct_fold_leaves(FoldHash, closures.hash, [])
  emit_distinct_fold_leaves(FoldShow, closures.show, [])
  // The arena's leaves were settled with the plan (their indices ride the
  // journal), so they are read back rather than collected again.
  if arena_live() { emit_evac_leaves(arena_leaves()) } else { () }
  heap_reset(m)
}

// ─── The sequence-of-struct walkers — the fold leaves' SEQUENCE arm ────
// Generated when a list's element face is STRUCTURAL (seq_face_structural:
// product / sum / nested list): the word runtime fns compare/hash the
// element WORD, which for a struct element is pointer identity standing in
// for structure — the silent fallback the eq law forbids (measured:
// [(1,2,3)] == [(1,2,3)] false; [[1,2]] == [[1,2]] false; a
// computed-[String] == masked only by literal interning; top-level
// hash([1,2]) an undefined-$hash_li assembly break). Shape mirrors
// emit_show_list_body_helper: a recursive body helper carrying the index
// (finite on the list), elements through $list_index (representation-
// total), the element leaf selected by face. Interior runtime names ride
// emit_runtime_contract / wide_binop_seed / hash_reach_names.
//
// The element leaf's callee: a structural face calls its own generated
// $<prefix>_<sig> (the collector self-contributes structural lists, so
// nested walkers exist transitively); a byte / float / word LIST element
// keeps its runtime family — the names arrive as values from each
// walker's own generator, never a mode key.
fn seq_elem_leaf_callee(prefix: String, rt_byte: String, rt_f64: String, rt_word: String, face) = match face {
  TList(inner) => match seq_elem_face(inner) {
    TByte => rt_byte,
    TFloat => rt_f64,
    f2 => if seq_face_structural(f2) { "{prefix}_{fold_sig(face)}" } else { rt_word },
  },
  _ => "{prefix}_{fold_sig(face)}",
}

fn emit_eq_leaf_seq(sig, elem) = {
  wat_emit("  (func $eq_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (result i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  // Identity short-circuit, then length — two equal sequences agree on
  // length before any element walk (list_eq's own protocol).
  //
  wat_emit("    (if (i32.eq (local.get $a) (local.get $b)) (then (return (i32.const 1))))\n")
  wat_emit("    (if (i32.ne (call $len (local.get $__state) (local.get $a)) (call $len (local.get $__state) (local.get $b))) (then (return (i32.const 0))))\n")
  wat_emit("    (call $eq_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (local.get $b) (i32.const 0))\n")
  wat_emit("  )\n")
  emit_eq_seq_body(sig, elem)
}

fn emit_eq_seq_body(sig, elem) = {
  let callee = seq_elem_leaf_callee("eq", "str_eq", "list_eq_f64", "list_eq", seq_elem_face(elem))
  wat_emit("  (func $eq_listbody_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (param $i i32) (result i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (if (result i32)\n")
  wat_emit("      (i32.ge_s (local.get $i) (call $len (local.get $__state) (local.get $a)))\n")
  wat_emit("      (then (i32.const 1))\n")
  wat_emit("      (else\n")
  wat_emit("        (if (result i32)\n")
  wat_emit("          (call $")
  wat_emit(callee)
  wat_emit(" (local.get $__state) (call $list_index (local.get $__state) (local.get $a) (local.get $i)) (call $list_index (local.get $__state) (local.get $b) (local.get $i)))\n")
  wat_emit("          (then (call $eq_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (local.get $b) (i32.add (local.get $i) (i32.const 1))))\n")
  wat_emit("          (else (i32.const 0)))))\n")
  wat_emit("  )\n")
}

// The 3-way walker mirrors list_compare_loop's protocol exactly:
// elementwise first-difference; exhaustion decides (both spent → 0,
// a spent → -1, b spent → 1).
fn emit_cmp_leaf_seq(sig, elem) = {
  wat_emit("  (func $compare_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (result i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (if (i32.eq (local.get $a) (local.get $b)) (then (return (i32.const 0))))\n")
  wat_emit("    (call $compare_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (local.get $b) (i32.const 0))\n")
  wat_emit("  )\n")
  emit_cmp_seq_body(sig, elem)
}

fn emit_cmp_seq_body(sig, elem) = {
  let callee = seq_elem_leaf_callee(
    "compare",
    "str_compare",
    "list_compare_f64",
    "list_compare",
    seq_elem_face(elem)
  )
  wat_emit("  (func $compare_listbody_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (param $i i32) (result i32)")
  wat_emit(" (local $c i32) (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (if (result i32)\n")
  wat_emit("      (i32.ge_s (local.get $i) (call $len (local.get $__state) (local.get $a)))\n")
  wat_emit("      (then (if (result i32) (i32.ge_s (local.get $i) (call $len (local.get $__state) (local.get $b))) (then (i32.const 0)) (else (i32.const -1))))\n")
  wat_emit("      (else\n")
  wat_emit("        (if (result i32) (i32.ge_s (local.get $i) (call $len (local.get $__state) (local.get $b)))\n")
  wat_emit("          (then (i32.const 1))\n")
  wat_emit("          (else\n")
  wat_emit("            (local.set $c (call $")
  wat_emit(callee)
  wat_emit(" (local.get $__state) (call $list_index (local.get $__state) (local.get $a) (local.get $i)) (call $list_index (local.get $__state) (local.get $b) (local.get $i))))\n")
  wat_emit("            (if (result i32) (i32.eqz (local.get $c))\n")
  wat_emit("              (then (call $compare_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (local.get $b) (i32.add (local.get $i) (i32.const 1))))\n")
  wat_emit("              (else (local.get $c)))))))\n")
  wat_emit("  )\n")
}

// The FNV walker mirrors list_hash's exact seed and mix — the length
// seeds the basis, each ELEMENT'S OWN HASH replaces the raw word in the
// xor-then-prime fold, so structural-equal lists hash equal (eq ⇒ hash,
// the agreement the fold enforces).
fn emit_hash_leaf_seq(sig, elem) = {
  wat_emit("  (func $hash_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (result i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (call $hash_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (i32.const 0) (i32.mul (i32.xor (i32.const -2128831035) (call $len (local.get $__state) (local.get $a))) (i32.const 16777619)))\n")
  wat_emit("  )\n")
  emit_hash_seq_body(sig, elem)
}

fn emit_hash_seq_body(sig, elem) = {
  let callee =
    seq_elem_leaf_callee("hash", "str_hash", "list_hash_f64", "list_hash", seq_elem_face(elem))
  wat_emit("  (func $hash_listbody_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $i i32) (param $h i32) (result i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (if (result i32)\n")
  wat_emit("      (i32.ge_s (local.get $i) (call $len (local.get $__state) (local.get $a)))\n")
  wat_emit("      (then (local.get $h))\n")
  wat_emit("      (else (call $hash_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (i32.add (local.get $i) (i32.const 1)) (i32.mul (i32.xor (local.get $h) (call $")
  wat_emit(callee)
  wat_emit(" (local.get $__state) (call $list_index (local.get $__state) (local.get $a) (local.get $i)))) (i32.const 16777619)))))\n")
  wat_emit("  )\n")
}

// emit_one_eq_helper — the $eq_<sig> recursive helper body. Takes (__state,
// a, b) per W7, returns Bool. The node-kind selects the body: a PRODUCT
// (record/tuple) ANDs each field's structural eq at its canonical width-summed
// offset (the SAME field_byte_offset projection lower computes — Carried-Truth,
// never a re-derived 4*i); a SUM (TName payload-ADT) reads the env's variant
// specs and emits sentinel-guard + tag-compare + per-tag payload recursion;
// a SEQUENCE-of-struct walks elements through its own recursive body
// (emit_eq_leaf_seq). One generator per leaf family — divergence is unsayable.
fn emit_one_eq_helper(sig, ty) = match fold_strip(ty) {
  TName(_, _) => emit_eq_leaf_sum(sig, fold_strip(ty)),
  TList(elem) => emit_eq_leaf_seq(sig, elem),
  _ => {
    wat_emit("  (func $eq_")
    wat_emit(sig)
    wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (result i32)")
    wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
    // Identity is the first structural fact: the same record is equal to
    // itself, so one word compare short-circuits the whole field
    // conjunction. Sound unconditionally; effective wherever canonical
    // instances flow (the intern made that the common case for names).
    //
    wat_emit("    (if (i32.eq (local.get $a) (local.get $b)) (then (return (i32.const 1))))\n")
    let fields = product_field_tys(ty)
    emit_eq_leaf_conjunction(fields, 0, len(fields), 0)
    wat_emit("  )\n")
  },
}

// emit_eq_leaf_sum — the $eq_n<Name> sum helper. Two equal values share
// a runtime tag; the fold then descends THAT variant's payload fields. A
// nullary variant is a bare sentinel WORD (< heap_base) and a fielded variant
// a heap record [tag@0][f0@4][f1@8]…, so:
//   - if a < heap_base OR b < heap_base : compare as words (i32.eq) — a
//     nullary tag == another iff the same value; sentinel != pointer always.
//   - else (both heap records) : load tags; if they differ → 0; if equal →
//     dispatch to the matched variant's payload conjunction. A type with no
//     fielded variant degenerates to the word arm (purely-nullary ADT).
// The per-variant payload conjunction recurses each field (offset 4+4*i,
// uniform i32 slots) via emit_field_eq — a sum payload field re-enters this
// family. Recursive ADTs (Tree) call $eq_nTree again: a runtime call, finite
// on the value, never inline-infinite. The env's variant specs are read LIVE.
fn emit_eq_leaf_sum(sig, applied) = {
  let specs = variant_specs_at(applied)
  wat_emit("  (func $eq_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (result i32)")
  wat_emit(" (local $ta i32) (local $tb i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  // Identity short-circuit — the same word is the same value for every
  // operand class (equal sentinels and identical records alike), one
  // compare before any tag load.
  //
  // Sentinel guard: either operand below heap_base ⇒ both are word-comparable
  // (nullary-vs-nullary value-eq, nullary-vs-fielded always-unequal).
  wat_emit("    (if (i32.eq (local.get $a) (local.get $b)) (then (return (i32.const 1))))\n")
  wat_emit("    (if (result i32)\n")
  wat_emit("      (i32.or\n")
  wat_emit("        (i32.lt_u (local.get $a) (i32.const ")
  wat_emit(int_to_str(heap_base()))
  wat_emit("))\n")
  wat_emit("        (i32.lt_u (local.get $b) (i32.const ")
  wat_emit(int_to_str(heap_base()))
  wat_emit(")))\n")
  wat_emit("      (then (i32.eq (local.get $a) (local.get $b)))\n")
  wat_emit("      (else\n")
  // Both heap records: load tags, unequal ⇒ 0, else per-tag payload recursion.
  wat_emit("        (local.set $ta (i32.load offset=0 (local.get $a)))\n")
  wat_emit("        (local.set $tb (i32.load offset=0 (local.get $b)))\n")
  wat_emit("        (if (result i32)\n")
  wat_emit("          (i32.ne (local.get $ta) (local.get $tb))\n")
  wat_emit("          (then (i32.const 0))\n")
  wat_emit("          (else\n")
  emit_eq_sum_tag_dispatch(specs, 0, len(specs))
  // Close the four body forms (inner else, inner if, outer else, outer if);
  // the func itself is closed by the "  )" below. The prior )))))  emitted
  // FIVE — one over — so the first generated $eq_<sum> helper's stray paren
  // closed the MODULE and orphaned every emit after it (the fold-helper tail,
  // the doubled _start): m3 had no entry point at all. No micro caught it —
  // the eq micros compare types that inline rather than generate a sum helper.
  wat_emit("          ))))\n")
  wat_emit("  )\n")
}

// Per-variant tag dispatch: a cascade matching $ta against each fielded
// variant's tag, emitting that variant's payload conjunction. A purely-nullary
// variant (no payload) contributes nothing (its values never reach here — the
// sentinel guard caught them). Tags equal but no fielded variant matched ⇒ the
// values are nullary sentinels misrouted, impossible past the guard: the
// terminal (i32.const 1) (tags already proven equal, no payload to compare).
fn emit_eq_sum_tag_dispatch(specs, i, n) = if i >= n {
  wat_emit("            (i32.const 1)\n")
} else {
  match list_index(specs, i) {
    (tag_id, payloads) => if len(payloads) == 0 {
      emit_eq_sum_tag_dispatch(specs, i + 1, n)
    } else {
      wat_emit("            (if (result i32)\n")
      wat_emit("              (i32.eq (local.get $ta) (i32.const ")
      wat_emit(int_to_str(tag_id))
      wat_emit("))\n")
      wat_emit("              (then\n")
      emit_eq_variant_payload_conjunction(payloads, 0, len(payloads))
      wat_emit("              )\n")
      wat_emit("              (else\n")
      emit_eq_sum_tag_dispatch(specs, i + 1, n)
      wat_emit("              ))\n")
    },
  }
}

// The payload conjunction for one variant: AND each payload field's structural
// eq. Payload field i lives at the width-summed offset (variant_payload_offset —
// the SAME fold the store and the LPCon match-bind read), loaded at its PROVEN
// repr (repr_of), so an f64 payload is genuinely 8 inline bytes loaded f64-wide
// and compared with f64.eq. Carried-Truth: store, load, and eq project ONE
// offset+width — they cannot disagree about where (or how wide) a payload is.
fn emit_eq_variant_payload_conjunction(payloads, i, n) = if n == 0 {
  wat_emit("                (i32.const 1)\n")
} else if i >= n {
  ()
} else {
  let pty = fold_strip(list_index(payloads, i))
  let r = repr_of(pty)
  let off = variant_payload_offset(payloads, i, 0, 4)
  emit_field_load_pair(off, r)
  emit_field_eq(pty)
  if i > 0 { wat_emit("    (i32.and)\n") }
  emit_eq_variant_payload_conjunction(payloads, i + 1, n)
}

// The conjunction body: for field i, push eq(a.field_i, b.field_i) then AND
// with the running accumulator. `off` is the running byte offset (width-summed
// over the canonically-sorted fields, the field_byte_offset arithmetic). The
// first field seeds the accumulator; each subsequent field ANDs in.
//
// empty product — equal
fn emit_eq_leaf_conjunction(fields, i, n, off) = if n == 0 {
  wat_emit("    (i32.const 1)\n")
} else if i >= n {
  ()
} else {
  let fty = list_index(fields, i)
  let r = repr_of(fty)
  let here = align_for(off, r)
  emit_field_load_pair(here, r)
  emit_field_eq(fold_strip(fty))
  if i > 0 { wat_emit("    (i32.and)\n") }
  emit_eq_leaf_conjunction(fields, i + 1, n, here + repr_width(r))
}

// Load a.field and b.field at byte offset `off`. An f64 field loads f64 (the
// width-typed load the repr proves); every other width loads i32 (a pointer or
// a 32-bit word). The pair is left on the stack for the field-eq instruction.
fn emit_field_load_pair(off, r) = {
  let ld = repr_load_op(r)
  wat_emit("    (local.get $a) (")
  wat_emit(ld)
  wat_emit(" offset=")
  wat_emit(int_to_str(off))
  wat_emit(")\n    (local.get $b) (")
  wat_emit(ld)
  wat_emit(" offset=")
  wat_emit(int_to_str(off))
  wat_emit(")\n")
}

fn repr_load_op(r) with Pure = match r {
  RF64 => "f64.load",
  RF32 => "f32.load",
  RI64 => "i64.load",
  RV128 => "v128.load",
  RI32 => "i32.load",
}

// repr_store_op — the STORE twin of repr_load_op. Construction must write a
// field at the same width the read side loads it (Carried-Truth: one repr fact,
// projected at both ends — never a flat i32.store the load re-reads as f64). The
// RI32 arm IS the pre-gradient `i32.store` (byte-identical, Law 7); RF64/RF32
// place the genuine 8/4 inline bytes; RV128 the 16-byte lane.
fn repr_store_op(r) with Pure = match r {
  RF64 => "f64.store",
  RF32 => "f32.store",
  RI64 => "i64.store",
  RV128 => "v128.store",
  RI32 => "i32.store",
}

// W11: the one signed WASM convert op per direction — the gradient's coercion
// arm rendered. IntToFloat widens an i32 to its f64 value; FloatToInt truncates
// an f64 toward zero to i32. Both are value-changing (never bit-reinterpreting).
fn convert_op(k) with Pure = match k {
  IntToFloat => "f64.convert_i32_s",
  FloatToInt => "i32.trunc_f64_s",
}

// The leaf eq instruction over an already-stripped field type, with the two
// field values on the stack. Word -> width-typed value-eq; sequence -> the
// state-threaded str_eq/list_eq call; product -> a recursive $eq_<sig> call;
// sum -> the named-peer floor. The eq/hash family CANNOT split: this IS the
// same five-node-kind leaf emit_eq_for_ty drives at the top-level `==`.
fn emit_field_eq(fty) = match fty {
  TList(e) => // One sequence arm, element-face dispatched (the top-level eq's twin).
  {
    wat_emit("    (local.get $__state)\n")
    emit_swap_under_state()
    match seq_elem_face(e) {
      TByte => wat_emit("    (call $str_eq)\n"),
      TFloat => wat_emit("    (call $list_eq_f64)\n"),
      face => if seq_face_structural(face) {
        wat_emit("    (call $eq_")
        wat_emit(fold_sig(fty))
        wat_emit(")\n")
      } else {
        wat_emit("    (call $list_eq)\n")
      },
    }
  },
  TRecord(_) => emit_field_product_eq(fold_sig(fty)),
  TRecordOpen(_, _) => emit_field_product_eq(fold_sig(fty)),
  TTuple(_) => emit_field_product_eq(fold_sig(fty)),
  TName(_, _) => // A sum-typed field: insert __state under the pair and recurse into the
  // variant's own generated $eq_n<Name> helper (same convention as a nested
  // product). Recursive ADTs descend the value at runtime — finite, the call
  // (never inline) is what makes a self-referential type well-founded.
  emit_field_product_eq(fold_sig(fty)),
  TFloat => wat_emit("    (f64.eq)\n"),
  _ => // Int / Unit / resolved-TVar / nullary-tag / fn-idx / cont-ptr — word eq.
  wat_emit("    (i32.eq)\n"),
}

// A nested product field: the two field pointers are on the stack; insert
// __state under them (the W7 (state, a, b) convention) and recurse.
fn emit_field_product_eq(sig) = {
  wat_emit("    (local.get $__state)\n")
  emit_swap_under_state()
  wat_emit("    (call $eq_")
  wat_emit(sig)
  wat_emit(")\n")
}

// Stack has [a_field, b_field, __state]; rotate __state UNDER the pair to
// (__state, a_field, b_field). Reuse the fn-preamble scratch the W7 helper
// path already declares ($state_tmp, $callee_closure).
fn emit_swap_under_state() = {
  // pop __state
  wat_emit("    (local.set $state_tmp)\n")
  // pop b_field
  wat_emit("    (local.set $callee_closure)\n")
  // pop a_field
  wat_emit("    (local.set $alloc_size)\n")
  wat_emit("    (local.get $state_tmp)\n")
  // a_field
  wat_emit("    (local.get $alloc_size)\n")
  // b_field
  wat_emit("    (local.get $callee_closure)\n")
}

// ─── The COMPARE leaf of the structural fold: 3-way ordering ──────────────
// `<`/`>`/`<=`/`>=` on an AGGREGATE is the ordering sibling of `==`: the SAME
// fold-over-five-node-kinds, the leaf returning -1/0/1 (a TOTAL order, not a
// Bool — so a field-wise/lexicographic fold short-circuits on the first non-
// equal element, which a Bool `<` cannot). The op then sign-tests the 3-way
// result: `<` is `< 0`, `>` is `> 0`, `<=` is `<= 0`, `>=` is `>= 0`. Word/
// float operands keep the byte-identical emit_binop_repr machine compare
// (Law 7); aggregates route to the generated recursive $compare_<sig> helper.
// One traversal, the eq/compare/hash family cannot diverge.
fn emit_struct_cmp(op, left_h) = if left_h == 0 {
  // Flat scalar word by construction — the machine compare floor.
  emit_binop_repr(op, RI32)
} else {
  // the fold boundary (the eq entry's law): resolve once, the family
  // reads var-free. A VARIABLE here is a word by the settle point's
  // refusal (`settle_node`), so the word compare below is its reading.
  emit_cmp_for_ty(op, fold_strip(chase_deep(lookup_ty(left_h))))
}

// The compare leaf over an already-stripped operand type. Aggregates (product/
// tuple/sum/sequence) call the 3-way helper then sign-test; scalar words/floats
// fall to the machine compare at the operand's proven repr (the same gradient
// the arithmetic binops ride). A sequence is the str_compare/list_compare
// [Byte]/[a] instance; a product/sum the generated $compare_<sig>.
fn emit_cmp_for_ty(op, ty) = match ty {
  TList(e) => // One sequence arm, element-face dispatched (the eq routing's twin).
  match seq_elem_face(e) {
    TByte => emit_cmp_seq_call("str_compare", op),
    TFloat => emit_cmp_seq_call("list_compare_f64", op),
    face => if seq_face_structural(face) {
      emit_cmp_agg_call(fold_sig(ty), op)
    } else {
      emit_cmp_seq_call("list_compare", op)
    },
  },
  TRecord(_) => emit_cmp_agg_call(fold_sig(ty), op),
  TRecordOpen(_, _) => emit_cmp_agg_call(fold_sig(ty), op),
  TTuple(_) => emit_cmp_agg_call(fold_sig(ty), op),
  TName(_, _) => emit_cmp_agg_call(fold_sig(ty), op),
  TFloat => emit_binop_repr(op, RF64),
  _ => // Int / Unit / resolved-TVar / nullary-tag / fn-idx / cont-ptr — word compare.
  emit_binop_repr(op, RI32),
}

// A sequence compare: insert __state under (a, b) (the W7 convention), call the
// 3-way runtime compare, then sign-test for the op. Both [Byte] (str_compare)
// and [a] (list_compare) are the ONE length-then-element ordering.
fn emit_cmp_seq_call(rt, op) = {
  emit_fold_state_insert()
  wat_emit("    (call $")
  wat_emit(rt)
  wat_emit(")\n")
  emit_cmp_sign_test(op)
}

// An aggregate (product/tuple/sum) compare: call the generated $compare_<sig>
// helper (state-threaded like $eq_<sig>) then sign-test. The deep field/payload
// ordering lives in the helper, generated once per distinct type and deduped.
fn emit_cmp_agg_call(sig, op) = {
  emit_fold_state_insert()
  wat_emit("    (call $compare_")
  wat_emit(sig)
  wat_emit(")\n")
  emit_cmp_sign_test(op)
}

// The 3-way result (-1/0/1) on the stack → the Bool the op asked for. `<` is
// `(i32.lt_s r 0)`, `>` is `(i32.gt_s r 0)`, `<=` is `(i32.le_s r 0)`, `>=` is
// `(i32.ge_s r 0)`. The order's sign IS the comparison — one compare, four
// sign tests (never four separate traversals).
fn emit_cmp_sign_test(op) = {
  wat_emit("    (i32.const 0)\n")
  match op {
    BLt => wat_emit("    (i32.lt_s)\n"),
    BGt => wat_emit("    (i32.gt_s)\n"),
    BLe => wat_emit("    (i32.le_s)\n"),
    BGe => wat_emit("    (i32.ge_s)\n"),
    _ => wat_emit("    (i32.lt_s)\n"),
  }
}

// emit_one_compare_helper — the $compare_<sig> recursive body. (__state, a, b)
// → i32 ∈ {-1,0,1}. A PRODUCT (record/tuple) compares fields in canonical order,
// returning the first non-zero field-compare (else 0); a SUM (TName payload-ADT)
// compares tags first (sign of the tag difference), then the matched variant's
// payload fields. One generator, two of the five leaves — divergence unsayable.
fn emit_one_compare_helper(sig, ty) = match fold_strip(ty) {
  TName(_, _) => emit_one_compare_sum_helper(sig, fold_strip(ty)),
  TList(elem) => emit_cmp_leaf_seq(sig, elem),
  _ => {
    wat_emit("  (func $compare_")
    wat_emit(sig)
    wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (result i32)")
    wat_emit(" (local $c i32) (local $state_tmp i32)")
    wat_emit(" (local $callee_closure i32) (local $alloc_size i32)")
    wat_emit(" (local $fa f64) (local $fb f64)\n")
    let fields = product_field_tys(ty)
    emit_cmp_helper_chain(fields, 0, len(fields), 0)
    wat_emit("  )\n")
  },
}

// emit_one_compare_sum_helper — the $compare_n<Name> sum helper. A nullary
// variant is a sentinel word, a fielded variant a heap record [tag@0][f0@4]…:
//   - if either operand is a sentinel (< heap_base): compare as words (sub-sign).
//     A nullary tag word vs another word orders by the value; that IS the tag
//     order (declaration order = tag id = sentinel value).
//   - else both heap records: compare tags (sign of difference); if equal,
//     descend the matched variant's payload conjunction (first non-zero wins).
fn emit_one_compare_sum_helper(sig, applied) = {
  let specs = variant_specs_at(applied)
  wat_emit("  (func $compare_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $b i32) (result i32)")
  wat_emit(" (local $ta i32) (local $tb i32) (local $c i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)")
  wat_emit(" (local $fa f64) (local $fb f64)\n")
  // Sentinel guard: either operand below heap_base ⇒ word ordering (sign of a-b).
  wat_emit("    (if (result i32)\n")
  wat_emit("      (i32.or\n")
  wat_emit("        (i32.lt_u (local.get $a) (i32.const ")
  wat_emit(int_to_str(heap_base()))
  wat_emit("))\n")
  wat_emit("        (i32.lt_u (local.get $b) (i32.const ")
  wat_emit(int_to_str(heap_base()))
  wat_emit(")))\n")
  wat_emit("      (then ")
  emit_word_sign_compare("(local.get $a)", "(local.get $b)")
  wat_emit(")\n")
  wat_emit("      (else\n")
  wat_emit("        (local.set $ta (i32.load offset=0 (local.get $a)))\n")
  wat_emit("        (local.set $tb (i32.load offset=0 (local.get $b)))\n")
  wat_emit("        (if (result i32)\n")
  wat_emit("          (i32.ne (local.get $ta) (local.get $tb))\n")
  wat_emit("          (then ")
  emit_word_sign_compare("(local.get $ta)", "(local.get $tb)")
  wat_emit(")\n")
  wat_emit("          (else\n")
  emit_compare_sum_tag_dispatch(specs, 0, len(specs))
  // Four body closes (the func is closed by "  )" below) — the same
  // one-over )))))  the eq sum helper had (emit_eq_leaf_sum): the extra paren
  // closed the module and orphaned the emit tail. Sibling generator, sibling
  // fix. sum-compare micro proves it (module balance 0, exit correct).
  wat_emit("          ))))\n")
  wat_emit("  )\n")
}

// Sign of (x - y) as -1/0/1, both operands WAT s-expression strings on demand.
// `(select 1 (select -1 0 (i32.lt_s x y)) (i32.gt_s x y))`: gt ⇒ 1, else lt ⇒
// -1, else 0. Unsigned-domain tag/sentinel values stay in i32 range, lt_s/gt_s
// order them correctly (heap_base() < 2^31).
fn emit_word_sign_compare(x, y) = {
  wat_emit("(select (i32.const 1) (select (i32.const -1) (i32.const 0) (i32.lt_s ")
  wat_emit(x)
  wat_emit(" ")
  wat_emit(y)
  wat_emit(")) (i32.gt_s ")
  wat_emit(x)
  wat_emit(" ")
  wat_emit(y)
  wat_emit("))")
}

// Per-variant tag dispatch for compare: tags already proven equal, descend the
// matched fielded variant's payload conjunction. A purely-nullary variant
// contributes nothing (its values never reach here — the sentinel guard caught
// them). No fielded variant matched past equal tags ⇒ equal nullary records
// (impossible past the guard): terminal 0 (equal).
fn emit_compare_sum_tag_dispatch(specs, i, n) = if i >= n {
  wat_emit("            (i32.const 0)\n")
} else {
  match list_index(specs, i) {
    (tag_id, payloads) => if len(payloads) == 0 {
      emit_compare_sum_tag_dispatch(specs, i + 1, n)
    } else {
      wat_emit("            (if (result i32)\n")
      wat_emit("              (i32.eq (local.get $ta) (i32.const ")
      wat_emit(int_to_str(tag_id))
      wat_emit("))\n")
      wat_emit("              (then\n")
      emit_cmp_variant_payload_chain(payloads, 0, len(payloads), 4)
      wat_emit("              )\n")
      wat_emit("              (else\n")
      emit_compare_sum_tag_dispatch(specs, i + 1, n)
      wat_emit("              ))\n")
    },
  }
}

// The payload chain for one variant: compare payload field i; if non-zero,
// THAT is the order; else recurse to field i+1; the last field's compare is
// the result. `off` is the running byte offset (variant payload base 4,
// width-summed — the SAME variant_payload_offset the eq + store sides read).
fn emit_cmp_variant_payload_chain(payloads, i, n, off) = if n == 0 {
  wat_emit("                (i32.const 0)\n")
} else if i >= n {
  ()
} else {
  let pty = fold_strip(list_index(payloads, i))
  let r = repr_of(pty)
  if i + 1 >= n {
    // Last payload field — its compare IS the variant's order.
    emit_field_load_pair(off, r)
    emit_field_cmp(pty)
  } else {
    // (local.set $c <field compare>) ; if $c != 0 return $c else next field.
    wat_emit("                (local.set $c ")
    emit_field_load_pair(off, r)
    emit_field_cmp(pty)
    wat_emit(")\n")
    wat_emit("                (if (result i32) (i32.ne (local.get $c) (i32.const 0))\n")
    wat_emit("                  (then (local.get $c))\n")
    wat_emit("                  (else\n")
    emit_cmp_variant_payload_chain(payloads, i + 1, n, off + repr_width(r))
    wat_emit("                  ))\n")
  }
}

// The product compare chain: field i's compare; first non-zero wins, else
// recurse. Mirror of emit_eq_leaf_conjunction but short-circuiting on order
// (not ANDing Bools). `off` is the width-summed running offset (align_for +
// repr_width — the SAME fold the eq leaf and the store side run).
//
// empty product — equal
fn emit_cmp_helper_chain(fields, i, n, off) = if n == 0 {
  wat_emit("    (i32.const 0)\n")
} else if i >= n {
  ()
} else {
  let fty = list_index(fields, i)
  let r = repr_of(fty)
  let here = align_for(off, r)
  if i + 1 >= n {
    emit_field_load_pair(here, r)
    emit_field_cmp(fold_strip(fty))
  } else {
    wat_emit("    (local.set $c ")
    emit_field_load_pair(here, r)
    emit_field_cmp(fold_strip(fty))
    wat_emit(")\n")
    wat_emit("    (if (result i32) (i32.ne (local.get $c) (i32.const 0))\n")
    wat_emit("      (then (local.get $c))\n")
    wat_emit("      (else\n")
    emit_cmp_helper_chain(fields, i + 1, n, here + repr_width(r))
    wat_emit("      ))\n")
  }
}

// The leaf compare instruction over a stripped field type, two field values on
// the stack → i32 ∈ {-1,0,1}. Word → sign-of-difference; float → f64 sign;
// sequence → the state-threaded str_compare/list_compare; product/sum → a
// recursive $compare_<sig> call. The SAME five-node-kind leaf emit_cmp_for_ty
// drives at the top-level compare — eq and compare cannot diverge.
fn emit_field_cmp(fty) = match fty {
  TList(e) => // One sequence arm, element-face dispatched (the eq routing's twin).
  {
    wat_emit("    (local.get $__state)\n")
    emit_swap_under_state()
    match seq_elem_face(e) {
      TByte => wat_emit("    (call $str_compare)\n"),
      TFloat => wat_emit("    (call $list_compare_f64)\n"),
      face => if seq_face_structural(face) {
        wat_emit("    (call $compare_")
        wat_emit(fold_sig(fty))
        wat_emit(")\n")
      } else {
        wat_emit("    (call $list_compare)\n")
      },
    }
  },
  TRecord(_) => emit_field_agg_cmp(fold_sig(fty)),
  TRecordOpen(_, _) => emit_field_agg_cmp(fold_sig(fty)),
  TTuple(_) => emit_field_agg_cmp(fold_sig(fty)),
  TName(_, _) => emit_field_agg_cmp(fold_sig(fty)),
  TFloat => // f64 sign: gt ⇒ 1, else lt ⇒ -1, else 0 — the word arm's shape at f64
  // width. The select consumes the pair TWICE (lt AND gt), so stash both
  // through the f64 scratch pair and re-reference; the bare-(f64.lt) form
  // consumed the pair once and did not assemble (the sortpairs probe).
  {
    wat_emit("    (local.set $fb)\n")
    wat_emit("    (local.set $fa)\n")
    wat_emit("    (select (i32.const 1) (select (i32.const -1) (i32.const 0) (f64.lt (local.get $fa) (local.get $fb))) (f64.gt (local.get $fa) (local.get $fb)))\n")
  },
  _ => // Int / Unit / resolved-TVar / nullary-tag — word sign-of-difference. The
  // stack has [a_field, b_field]; (select 1 (select -1 0 (i32.lt_s)) (i32.gt_s))
  // needs the pair twice, so reload through scratch.
  emit_word_field_sign_compare(),
}

// Word field compare with the pair on the stack: save both, then emit the
// select using the saved locals twice. Reuses the helper's $alloc_size (a) and
// $callee_closure (b) scratch.
fn emit_word_field_sign_compare() = {
  // b
  wat_emit("    (local.set $callee_closure)\n")
  // a
  wat_emit("    (local.set $alloc_size)\n")
  emit_word_sign_compare("(local.get $alloc_size)", "(local.get $callee_closure)")
  wat_emit("\n")
}

// A nested aggregate field compare: insert __state under the pair, recurse into
// $compare_<sig> (the same convention emit_field_product_eq uses for eq).
fn emit_field_agg_cmp(sig) = {
  wat_emit("    (local.get $__state)\n")
  emit_swap_under_state()
  wat_emit("    (call $compare_")
  wat_emit(sig)
  wat_emit(")\n")
}

// The product's field types, in canonical (sorted-for-record, positional-for-
// tuple) order — the field set the fold descends. Read live from the proven
// type (the fields TRecord/TTuple already carry; a tuple's positional elems
// ARE its product fields). Non-product types have no field set (empty).
fn product_field_tys(ty) = match fold_strip(ty) {
  TRecord(fields) => map(field_type_of, fields),
  TRecordOpen(fields, _) => map(field_type_of, fields),
  TTuple(elems) => elems,
  _ => [],
}

// A == operand contributes its aggregate type AND every nested aggregate its
// fields / variant payloads reach (a record-of-records or a Tree needs a helper
// per level). eq_subtys flattens the type's aggregate closure so every nested
// helper is generated. The seen-set of TName names terminates the descent on
// recursive ADTs (Tree's payload reaches Tree — collected ONCE, the runtime
// helper recurses the value).
//
// the fold boundary at the COLLECTOR — the same chase_deep the dispatch
// entry runs, so collection and emission bank/name identical types
fn eq_operand_contrib(left_h, acc) =
  if left_h == 0 { acc } else { eq_subtys(fold_strip(chase_deep(lookup_ty(left_h))), [], acc) }

// The aggregate types reachable from a type (itself if product/sum, plus the
// aggregates its fields / elements / list-element / variant payloads reach).
// Words and sequences-of-words contribute nothing; a list-of-records
// contributes the record; a sum contributes itself and descends each variant's
// payload types read LIVE from the env (variant_specs_of). `seen` guards
// recursive ADTs so the COLLECTION terminates (the helper's runtime recursion
// handles the unbounded value depth). Input arrives RESOLVED (the fold
// boundary chase_deep at eq/hash_operand_contrib), so the walk and the
// dispatch sig identical types by invariant.
fn eq_subtys(ty, seen, acc) = match fold_strip(ty) {
  TRecord(fields) => eq_subtys_fields(fields, 0, len(fields), seen, [ty] ++ acc),
  TRecordOpen(fields, _) => eq_subtys_fields(fields, 0, len(fields), seen, [ty] ++ acc),
  TTuple(elems) => eq_subtys_list(elems, 0, len(elems), seen, [ty] ++ acc),
  TList(elem) => // A structural-face list contributes ITSELF (its generated sequence
  // walker) plus its element's closure; word/byte/float faces ride the
  // runtime families and contribute only what the element reaches.
  if seq_face_structural(seq_elem_face(elem)) {
    eq_subtys(elem, seen, [ty] ++ acc)
  } else {
    eq_subtys(elem, seen, acc)
  },
  TName(_, _) => // The seen-set keys by the fold SIG, not by the type's name. The sig IS
  // the helper's identity, so keying by it terminates a recursive ADT
  // exactly as the name did — `Tree(Int)` reaching `Tree(Int)` is one sig —
  // while keeping `Option(Int)` and `Option(Boxed)` the two collections they
  // are. Keyed by name, the second instantiation was silently skipped and
  // its helper went uncollected.
  if ls_find_str_local(seen, fold_sig(fold_strip(ty)), 0) >= 0 {
    acc
  } else {
    // The specs at THIS instantiation: a payload that is the type's own
    // parameter collects the ARGUMENT's sub-types, so the leaf an
    // `Option(Boxed)` needs — the $eq_ helper of its argument — is collected rather than
    // missed, and the assembly finds every helper the emit will call.
    let specs = variant_specs_at(fold_strip(ty))
    eq_subtys_variants(specs, 0, len(specs), [fold_sig(fold_strip(ty))] ++ seen, [ty] ++ acc)
  },
  _ => acc,
}

fn eq_subtys_fields(fields, i, n, seen, acc) = if i >= n {
  acc
} else {
  match list_index(fields, i) {
    (_name, ty) => eq_subtys_fields(fields, i + 1, n, seen, eq_subtys(ty, seen, acc)),
  }
}

fn eq_subtys_list(elems, i, n, seen, acc) = if i >= n {
  acc
} else {
  eq_subtys_list(elems, i + 1, n, seen, eq_subtys(list_index(elems, i), seen, acc))
}

// Descend each variant's payload types (the (tag_id, [payload_ty]) specs).
fn eq_subtys_variants(specs, i, n, seen, acc) = if i >= n {
  acc
} else {
  match list_index(specs, i) {
    (_tag, payloads) => eq_subtys_variants(specs, i + 1, n, seen, eq_subtys_list(payloads, 0, len(payloads), seen, acc)),
  }
}

// ─── The SHOW leaf of the structural fold: generated recursive $show_<sig> ──
// to_string on an AGGREGATE is a CALL to the generated recursive $show_<sig>
// helper (lower_show_call named it by fold_sig; here the backend emits it). The
// SAME fold-over-five-node-kinds the eq leaf walks, with a DIFFERENT leaf: eq
// ANDs Bools, show CONCATS Strings (str_concat). Product → "{name: …, name: …}";
// tuple → "(…, …)"; sum → "Ctor(…)" / "Ctor"; list → "[…, …]". Each field /
// payload / element re-enters the five-node-kind leaf (show_field), so a nested
// aggregate recurses its own $show_<sig> helper — finite on the value, the same
// well-foundedness the eq leaf has. The env's variant payload types are read
// LIVE (variant_specs_of) — never a re-derived shape at runtime when the graph
// proved the type at the to_string site. The eq/show DIVERGENCE footgun is
// unsayable: both are leaves of one traversal over the same five node-kinds.
//
// emit_one_show_helper — the $show_<sig> recursive helper. Takes (__state, a)
// — the W7 convention every emitted fn uses (the SAME __state-first shape the
// eq helper calls $str_eq with), so a generated helper calls the runtime
// renderers $str_concat / $int_to_str / $float_to_str directly. Returns a
// String pointer. The node-kind selects the body (product / tuple / list / sum),
// each assembling via FOLDED `(call $str_concat (local.get $__state) <l> <r>)`
// s-expressions — the value, the field-loads, and the recursive show calls are
// sub-expressions of the concat tree (correct stack discipline, no interleave).
fn emit_one_show_helper(sig, ty) = match fold_strip(ty) {
  TName(_, _) => emit_one_show_sum_helper(sig, fold_strip(ty)),
  TList(elem) => emit_one_show_list_helper(sig, elem),
  _ => emit_one_show_product_helper(sig, ty),
}

// The helper header: (func $show_<sig> (param $__state i32) (param $a i32)
// (result i32)). The body is one expression leaving the assembled String ptr.
fn emit_show_header(sig) = {
  wat_emit("  (func $show_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (result i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
}

// PRODUCT / TUPLE show: open ++ field_0 ++ ", " ++ field_1 ++ … ++ close, a
// right-nested str_concat tree. A record names its fields ("name: " prefix +
// braces); a tuple is positional + parens. Delimiters are the node-kind's
// structural projection. The fold runs over the canonically-sorted fields at
// their width-summed offsets (the SAME align_for + repr_width the eq leaf and
// the store side run — Carried-Truth).
fn emit_one_show_product_helper(sig, ty) = {
  emit_show_header(sig)
  let is_record = ty_is_record(fold_strip(ty))
  let open = if is_record { "\{" } else { "(" }
  let close = if is_record { "\}" } else { ")" }
  // concat( open, concat( <fields-with-seps>, close ) )
  emit_show_concat_open()
  emit_show_str_literal(open)
  emit_show_concat_open()
  emit_show_product_fields(show_named_fields(fold_strip(ty)), 0, 0, is_record)
  emit_show_str_literal(close)
  emit_show_concat_close()
  emit_show_concat_close()
  wat_emit("  )\n")
}

// ty_is_record — the delimiter discriminator (record → braces+names, tuple →
// parens+positional). Read from the proven node-kind.
fn ty_is_record(ty) with Pure = match ty {
  TRecord(_) => true,
  TRecordOpen(_, _) => true,
  _ => false,
}

// The named field set the show fold descends: a record's (name, ty) pairs in
// canonical sort order; a tuple's elements as positional ("" names). Read live
// from the proven type — the SAME field set product_field_tys gives eq, plus
// the names show prints.
fn show_named_fields(ty) = match ty {
  TRecord(fields) => fields,
  TRecordOpen(fields, _) => fields,
  TTuple(elems) => name_positional(elems, 0, len(elems)),
  _ => [],
}

fn name_positional(elems, i, n) =
  if i >= n { [] } else { [("", list_index(elems, i))] ++ name_positional(elems, i + 1, n) }

// Render the field set as a right-nested concat: each field is
// concat( <name-prefix + ", " sep>, concat( show(field), <rest> ) ). The first
// field has no leading ", "; a record field is prefixed "name: ". The byte
// offset is width-summed (align_for + repr_width). Terminates with "" at the end.
fn emit_show_product_fields(fields, i, off, is_record) = if i >= len(fields) {
  emit_show_str_literal("")
} else {
  match list_index(fields, i) {
    (fname, fty) => {
      let r = repr_of(fty)
      let here = align_for(off, r)
      // prefix = (", " when i>0) ++ ("name: " when record)
      let prefix = "{show_field_sep(i)}{show_field_name(fname, is_record)}"
      emit_show_concat_open()
      emit_show_str_literal(prefix)
      emit_show_concat_open()
      emit_show_field_render(here, r, fold_strip(fty))
      emit_show_product_fields(fields, i + 1, here + repr_width(r), is_record)
      emit_show_concat_close()
      emit_show_concat_close()
    },
  }
}

fn show_field_sep(i) with Pure = if i == 0 { "" } else { ", " }

fn show_field_name(fname: String, is_record) = if is_record { "{fname}: " } else { "" }

// Render one field value at `off`/width `r`: load the field, wrap it in its
// leaf renderer. Word fields → int_to_str / float_to_str; string field → as-is;
// aggregate field → recursive $show_<sig>. The runtime renderer takes __state
// first (W7), so the folded call is (call $renderer (local.get $__state) <load>).
// The leaf renderer for a product/tuple field at `off`/width `r`: the field's
// node-kind picks the renderer name (a word → int_to_str/float_to_str, an
// aggregate → its $show_<sig>, a string → as-is), and the field LOAD is the
// renderer's argument. The renderer-name is the only degree of freedom; the
// load is the SAME width-typed read the eq leaf and the store side use.
fn emit_show_field_render(off, r, fty) = match fty {
  TList(TByte) => // A byte sequence RENDERS AS TEXT (§4①: String is the text VIEW of [byte]) —
  // never the bracket-list render ("hi", not [104, 105]).
  emit_show_field_load(off, r),
  TFloat => emit_show_call_field("float_to_str", off, r),
  TList(_) => emit_show_call_field("show_{fold_sig(fty)}", off, r),
  TRecord(_) => emit_show_call_field("show_{fold_sig(fty)}", off, r),
  TRecordOpen(_, _) => emit_show_call_field("show_{fold_sig(fty)}", off, r),
  TTuple(_) => emit_show_call_field("show_{fold_sig(fty)}", off, r),
  TName(_, _) => emit_show_call_field("show_{fold_sig(fty)}", off, r),
  _ => // Int / Unit / resolved-TVar / closure / continuation — render the word.
  emit_show_call_field("int_to_str", off, r),
}

// emit_show_call_field — a folded `(call $name (local.get $__state) <field-load>)`.
// Every emitted fn takes __state first (W7), so this is the one call shape every
// runtime renderer / recursive show uses. The field-load is the renderer's arg.
fn emit_show_call_field(name, off, r) = {
  wat_emit("    (call $")
  wat_emit(name)
  wat_emit(" (local.get $__state) ")
  emit_show_field_load(off, r)
  wat_emit(")\n")
}

// Load a.field at byte offset `off` at the field's proven width (f64 fields
// load f64, every other width loads i32 — the SAME width-typed read the eq leaf
// and store side use).
fn emit_show_field_load(off, r) = {
  wat_emit("(")
  wat_emit(repr_load_op(r))
  wat_emit(" offset=")
  wat_emit(int_to_str(off))
  wat_emit(" (local.get $a))")
}

// SUM show: sentinel-guard (a nullary variant is a bare tag word < heap_base,
// rendered by its constructor name; a fielded variant a heap record [tag@0]
// [f0@4]…). The tag selects the variant; a fielded variant renders
// "Ctor(" ++ f0 ++ ", " ++ f1 ++ ")". The variant names + payload types are read
// LIVE from the env (variant_named_specs_of). A recursive ADT re-enters
// $show_n<Name> (finite on the value). Mirrors emit_eq_leaf_sum's guard.
fn emit_one_show_sum_helper(sig, applied) = {
  let specs = variant_named_specs_at(applied)
  wat_emit("  (func $show_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (result i32) (local $ta i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (if (result i32)\n")
  wat_emit("      (i32.lt_u (local.get $a) (i32.const ")
  wat_emit(int_to_str(heap_base()))
  wat_emit("))\n")
  // Nullary arm: $a IS the tag word.
  wat_emit("      (then\n")
  emit_show_sum_tag_dispatch(specs, 0, len(specs), "$a")
  wat_emit("      )\n")
  // Heap arm: load tag@0, dispatch on it.
  wat_emit("      (else\n")
  wat_emit("        (local.set $ta (i32.load offset=0 (local.get $a)))\n")
  emit_show_sum_tag_dispatch(specs, 0, len(specs), "$ta")
  wat_emit("      ))\n")
  wat_emit("  )\n")
}

// Per-variant tag switch. `scrutinee` is the local holding the runtime tag
// ($a in the nullary arm, $ta in the heap arm). A nullary variant renders its
// bare name; a fielded variant renders "Ctor(" ++ payloads ++ ")". The cascade
// terminal is "" (the env enumerates every variant; control lands on one arm).
fn emit_show_sum_tag_dispatch(specs, i, n, scrutinee) = if i >= n {
  emit_show_str_literal("")
} else {
  match list_index(specs, i) {
    (tag_id, cname, payloads) => {
      wat_emit("        (if (result i32)\n")
      wat_emit("          (i32.eq (local.get ")
      wat_emit(scrutinee)
      wat_emit(") (i32.const ")
      wat_emit(int_to_str(tag_id))
      wat_emit("))\n")
      wat_emit("          (then\n")
      if len(payloads) == 0 {
        emit_show_str_literal(cname)
      } else {
        // concat( "Ctor(", concat( <payloads-with-seps>, ")" ) )
        emit_show_concat_open()
        emit_show_str_literal("{cname}(")
        emit_show_concat_open()
        emit_show_variant_payloads(payloads, 0, len(payloads))
        emit_show_str_literal(")")
        emit_show_concat_close()
        emit_show_concat_close()
      }
      wat_emit("          )\n")
      wat_emit("          (else\n")
      emit_show_sum_tag_dispatch(specs, i + 1, n, scrutinee)
      wat_emit("          ))\n")
    },
  }
}

// The payload conjunction for one variant: each payload field at offset 4+4*i
// (uniform i32 slots — the SAME layout emit_variant_field_stores_at writes and
// the eq leaf reads), rendered + joined by ", ". A Float payload renders its
// stored 4-byte word via int_to_str (the variant's uniform i32 slotting — never
// float_to_str, which would consume an f64 the slot never held; mirror of
// emit_variant_payload_eq). Right-nested concat, terminating with "".
fn emit_show_variant_payloads(payloads, i, n) = if i >= n {
  emit_show_str_literal("")
} else {
  let pty = fold_strip(list_index(payloads, i))
  let off = variant_payload_offset(payloads, i, 0, 4)
  emit_show_concat_open()
  emit_show_str_literal(show_field_sep(i))
  emit_show_concat_open()
  emit_show_variant_payload_render(off, pty)
  emit_show_variant_payloads(payloads, i + 1, n)
  emit_show_concat_close()
  emit_show_concat_close()
}

// A variant payload renders at its PROVEN repr (the width-summed migration): an
// f64 payload loads f64-wide and renders via float_to_str (it is genuinely an
// f64 now, not a reinterpreted word); a String is the stored pointer; aggregates
// recurse the show fold; every other word renders via int_to_str. The load WIDTH
// is the payload's repr (emit_show_variant_load reads repr_of), so the show
// reads the SAME width the store wrote (Carried-Truth).
fn emit_show_variant_payload_render(off, pty) = match pty {
  TList(TByte) => // text view (§4①)
  emit_show_variant_load(off, pty),
  TFloat => emit_show_call_variant("float_to_str", off, pty),
  TList(_) => emit_show_call_variant("show_{fold_sig(pty)}", off, pty),
  TRecord(_) => emit_show_call_variant("show_{fold_sig(pty)}", off, pty),
  TRecordOpen(_, _) => emit_show_call_variant("show_{fold_sig(pty)}", off, pty),
  TTuple(_) => emit_show_call_variant("show_{fold_sig(pty)}", off, pty),
  TName(_, _) => emit_show_call_variant("show_{fold_sig(pty)}", off, pty),
  _ => emit_show_call_variant("int_to_str", off, pty),
}

// A folded `(call $name (local.get $__state) (<repr>.load offset=off (local.get $a)))`
// — the variant-payload twin of emit_show_call_field, loading at the payload's
// proven width.
fn emit_show_call_variant(name, off, pty) = {
  wat_emit("    (call $")
  wat_emit(name)
  wat_emit(" (local.get $__state) ")
  emit_show_variant_load(off, pty)
  wat_emit(")\n")
}

fn emit_show_variant_load(off, pty) = {
  wat_emit("(")
  wat_emit(repr_load_op(repr_of(pty)))
  wat_emit(" offset=")
  wat_emit(int_to_str(off))
  wat_emit(" (local.get $a))")
}

// LIST show: "[" ++ <element loop, joined by ", "> ++ "]". The element count is
// runtime (len); $show_listbody_<sig> folds str_concat over list_index(a, i),
// joining ", ". The element leaf is read from the proven element type.
fn emit_one_show_list_helper(sig, elem) = {
  emit_show_header(sig)
  emit_show_concat_open()
  emit_show_str_literal("[")
  emit_show_concat_open()
  wat_emit("    (call $show_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (i32.const 0))\n")
  emit_show_str_literal("]")
  emit_show_concat_close()
  emit_show_concat_close()
  wat_emit("  )\n")
  emit_show_list_body_helper(sig, elem)
}

// The recursive element loop: render element i (", " prefix when i>0), then
// recurse to i+1; "" when i == len(a). Tail-recursive over the list length
// (finite). The element leaf reads the proven element type (Carried-Truth).
fn emit_show_list_body_helper(sig, elem) = {
  wat_emit("  (func $show_listbody_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (param $i i32) (result i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (if (result i32)\n")
  wat_emit("      (i32.ge_s (local.get $i) (call $len (local.get $__state) (local.get $a)))\n")
  wat_emit("      (then ")
  emit_show_str_literal_inline("")
  wat_emit(")\n")
  wat_emit("      (else\n")
  // concat( sep, concat( show(elem_i), recurse(i+1) ) )
  wat_emit("        (call $str_concat (local.get $__state)\n")
  wat_emit("          (if (result i32) (i32.gt_s (local.get $i) (i32.const 0))\n")
  wat_emit("            (then ")
  emit_show_str_literal_inline(", ")
  wat_emit(") (else ")
  emit_show_str_literal_inline("")
  wat_emit("))\n")
  wat_emit("          (call $str_concat (local.get $__state)\n")
  emit_show_list_elem_render(fold_strip(elem))
  wat_emit("            (call $show_listbody_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (local.get $a) (i32.add (local.get $i) (i32.const 1)))\n")
  wat_emit("          )))\n")
  // TWO closers: the if, THEN the func — the single ")" left the func open
  // (m3's one structural break: "(func $_start" where an instr belonged;
  // the whole-file paren census counted exactly one missing close).
  wat_emit("  )\n")
  wat_emit("  )\n")
}

// Render list element i: list_index(__state, a, i), wrapped in its leaf renderer.
// The renderer-name is the only degree of freedom; the indexed load is its arg.
fn emit_show_list_elem_render(elem) = match elem {
  TList(TByte) => // text view (§4①)
  // The element read yields the f64's REFERENCE (the word protocol); deref
  // before the native-faced renderer.
  emit_show_list_index(),
  TFloat => emit_show_call_listidx_deref("float_to_str"),
  TList(_) => emit_show_call_listidx("show_{fold_sig(elem)}"),
  TRecord(_) => emit_show_call_listidx("show_{fold_sig(elem)}"),
  TRecordOpen(_, _) => emit_show_call_listidx("show_{fold_sig(elem)}"),
  TTuple(_) => emit_show_call_listidx("show_{fold_sig(elem)}"),
  TName(_, _) => emit_show_call_listidx("show_{fold_sig(elem)}"),
  _ => emit_show_call_listidx("int_to_str"),
}

// A folded `(call $name (local.get $__state) (call $list_index … i))` — the
// list-element twin of emit_show_call_field.
fn emit_show_call_listidx(name) = {
  wat_emit("    (call $")
  wat_emit(name)
  wat_emit(" (local.get $__state) ")
  emit_show_list_index()
  wat_emit(")\n")
}

// The wide-element variant: the indexed read is a reference; f64.load
// cashes it before the native renderer.
fn emit_show_call_listidx_deref(name) = {
  wat_emit("    (call $")
  wat_emit(name)
  wat_emit(" (local.get $__state) (f64.load ")
  emit_show_list_index()
  wat_emit("))\n")
}

fn emit_show_list_index() =
  wat_emit("(call $list_index (local.get $__state) (local.get $a) (local.get $i))")

// ─── show literal/separator emit ──────────────────────────────────────────
// A string literal in the helper body: emit the data-pointer load (the literal
// was registered through visit_string by register_show_literals, so string_offset
// resolves it). The helper assembles via str_concat, so each literal is a leaf
// on the folded concat tree.
fn emit_show_str_literal(s) = {
  wat_emit("    ")
  emit_expr(LConst(0, LString(s)))
}

fn emit_show_str_literal_inline(s) = emit_expr(LConst(0, LString(s)))

// emit_show_concat_open / close — a folded `(call $str_concat (local.get $__state)
// <left> <right> )`: open writes the call head + __state, the two operands follow
// as sub-expressions, close writes the `)`. Right-nesting builds the N-ary concat.
fn emit_show_concat_open() = wat_emit("    (call $str_concat (local.get $__state)\n")

fn emit_show_concat_close() = wat_emit("    )\n")

// The aggregate type closure for show: the type itself if aggregate, plus every
// nested aggregate its fields / elements / variant payloads reach. Unlike eq,
// the LIST arm contributes the LIST type (show needs $show_l<elem>), then
// descends the element. `seen` guards recursive ADTs (collected once; the
// runtime helper recurses the value).
fn show_subtys(ty, seen, acc) = match fold_strip(ty) {
  TRecord(fields) => show_subtys_fields(fields, 0, len(fields), seen, [ty] ++ acc),
  TRecordOpen(fields, _) => show_subtys_fields(fields, 0, len(fields), seen, [ty] ++ acc),
  TTuple(elems) => show_subtys_list(elems, 0, len(elems), seen, [ty] ++ acc),
  TList(TByte) => // text view (§4①): every render surface — the dispatch
  // (spec_is_agg), the product field, the list element, the variant
  // payload — treats a byte sequence AS-IS, so no $show_lb leaf is
  // callable from anywhere. Collecting one minted an UNCALLED body
  // whose int_to_str interior dangled unless an unrelated seed
  // happened to keep the renderer emitted — the accident the demand
  // worklist ended (its dead-decl wide seeds no longer flow), caught
  // as the interp micros' undefined-$int_to_str assembly break. The
  // collector reads the same fact the dispatch reads.
  acc,
  TList(elem) => show_subtys(elem, seen, [ty] ++ acc),
  TName(_, _) => // Keyed by the fold SIG, the helper's own identity — see eq_subtys.
  if ls_find_str_local(seen, fold_sig(fold_strip(ty)), 0) >= 0 {
    acc
  } else {
    let specs = variant_specs_at(fold_strip(ty))
    show_subtys_variants(specs, 0, len(specs), [fold_sig(fold_strip(ty))] ++ seen, [ty] ++ acc)
  },
  _ => acc,
}

fn show_subtys_fields(fields, i, n, seen, acc) = if i >= n {
  acc
} else {
  match list_index(fields, i) {
    (_name, ty) => show_subtys_fields(fields, i + 1, n, seen, show_subtys(ty, seen, acc)),
  }
}

fn show_subtys_list(elems, i, n, seen, acc) = if i >= n {
  acc
} else {
  show_subtys_list(elems, i + 1, n, seen, show_subtys(list_index(elems, i), seen, acc))
}

fn show_subtys_variants(specs, i, n, seen, acc) = if i >= n {
  acc
} else {
  match list_index(specs, i) {
    (_tag, payloads) => show_subtys_variants(specs, i + 1, n, seen, show_subtys_list(payloads, 0, len(payloads), seen, acc)),
  }
}

// show_operand_contrib — the arg of a $show_<sig> LCall contributes its
// aggregate closure. The arg handle carries the proven type (AST-in-graph).
fn show_operand_contrib(arg, acc) = {
  let h = lexpr_handle(arg)
  if h == 0 { acc } else { show_subtys(fold_strip(chase_deep(lookup_ty(h))), [], acc) }
}

// ─── The HASH leaf of the structural fold: generated recursive $hash_<sig> ──
// hash(x) on an AGGREGATE is a CALL to the generated recursive $hash_<sig>
// helper (lower_hash_agg_call named it; here the backend emits it). The SAME
// fold-over-five-node-kinds the eq/compare/show leaves walk, with the HASH
// leaf: FNV-1a mix — h = (h xor field_hash) * prime, folded over the fields /
// payload / elements. Structural-equal values hash equal by construction (eq ⇒
// hash, the agreement the fold enforces): the field set, offsets, and recursion
// are the SAME the eq leaf reads, so two values eq returns true for hash
// identically. The runtime str_hash/list_hash are the sequence leaf; a scalar
// word IS its own hash; a nested aggregate recurses its own $hash_<sig>.
//
// emit_one_hash_helper — the $hash_<sig> recursive body. (__state, a) → i32.
// A PRODUCT (record/tuple) folds the FNV mix over each field's hash at its
// canonical offset; a SUM seeds the mix with the tag, then mixes the matched
// variant's payload. The FNV offset basis (2166136261) and prime (16777619)
// are the SAME str_hash / hash_source share — one hash family, no divergence.
fn emit_one_hash_helper(sig, ty) = match fold_strip(ty) {
  TName(_, _) => emit_one_hash_sum_helper(sig, fold_strip(ty)),
  TList(elem) => emit_hash_leaf_seq(sig, elem),
  _ => {
    wat_emit("  (func $hash_")
    wat_emit(sig)
    wat_emit(" (param $__state i32) (param $a i32) (result i32)")
    wat_emit(" (local $h i32) (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
    wat_emit("    (local.set $h (i32.const 2166136261))\n")
    let fields = product_field_tys(ty)
    emit_hash_field_mix(fields, 0, len(fields), 0)
    wat_emit("    (local.get $h)\n")
    wat_emit("  )\n")
  },
}

// emit_one_hash_sum_helper — the $hash_n<Name> sum helper. A nullary variant is
// a sentinel word (its value IS its hash-seed); a fielded variant a heap record
// [tag@0][f0@4]…, so: seed $h with the FNV basis; if the operand is a sentinel
// (< heap_base) mix the word itself; else mix tag@0, then the matched variant's
// payload fields. Two structurally-equal ADT values fold identically.
fn emit_one_hash_sum_helper(sig, applied) = {
  let specs = variant_specs_at(applied)
  wat_emit("  (func $hash_")
  wat_emit(sig)
  wat_emit(" (param $__state i32) (param $a i32) (result i32)")
  wat_emit(" (local $h i32) (local $ta i32)")
  wat_emit(" (local $state_tmp i32) (local $callee_closure i32) (local $alloc_size i32)\n")
  wat_emit("    (local.set $h (i32.const 2166136261))\n")
  wat_emit("    (if\n")
  wat_emit("      (i32.lt_u (local.get $a) (i32.const ")
  wat_emit(int_to_str(heap_base()))
  wat_emit("))\n")
  // Sentinel (nullary): mix the word itself.
  wat_emit("      (then (local.set $h (i32.mul (i32.xor (local.get $h) (local.get $a)) (i32.const 16777619))))\n")
  wat_emit("      (else\n")
  wat_emit("        (local.set $ta (i32.load offset=0 (local.get $a)))\n")
  wat_emit("        (local.set $h (i32.mul (i32.xor (local.get $h) (local.get $ta)) (i32.const 16777619)))\n")
  emit_hash_sum_tag_dispatch(specs, 0, len(specs))
  wat_emit("      ))\n")
  wat_emit("    (local.get $h)\n")
  wat_emit("  )\n")
}

// Per-variant tag dispatch for hash: the tag already mixed, descend the matched
// fielded variant's payload mix. A nullary variant has no payload (nothing to
// mix past its tag). No fielded variant matched ⇒ a nullary record (its tag is
// its full hash): nothing more to mix.
fn emit_hash_sum_tag_dispatch(specs, i, n) = if i >= n {
  ()
} else {
  match list_index(specs, i) {
    (tag_id, payloads) => if len(payloads) == 0 {
      emit_hash_sum_tag_dispatch(specs, i + 1, n)
    } else {
      wat_emit("        (if\n")
      wat_emit("          (i32.eq (local.get $ta) (i32.const ")
      wat_emit(int_to_str(tag_id))
      wat_emit("))\n")
      wat_emit("          (then\n")
      emit_hash_variant_payload_mix(payloads, 0, len(payloads), 4)
      wat_emit("          )\n")
      wat_emit("          (else\n")
      emit_hash_sum_tag_dispatch(specs, i + 1, n)
      wat_emit("          ))\n")
    },
  }
}

// Mix each payload field at its width-summed offset (variant base 4 — the SAME
// offset fold the eq/compare leaves read). h = (h xor field_hash) * prime.
fn emit_hash_variant_payload_mix(payloads, i, n, off) = if i >= n {
  ()
} else {
  let pty = fold_strip(list_index(payloads, i))
  let r = repr_of(pty)
  wat_emit("            (local.set $h (i32.mul (i32.xor (local.get $h) ")
  emit_field_hash(off, r, pty)
  wat_emit(") (i32.const 16777619)))\n")
  emit_hash_variant_payload_mix(payloads, i + 1, n, off + repr_width(r))
}

// The product hash mix chain: fold the FNV mix over each field at its width-
// summed offset (align_for + repr_width — the SAME fold the eq leaf reads).
fn emit_hash_field_mix(fields, i, n, off) = if i >= n {
  ()
} else {
  let fty = list_index(fields, i)
  let r = repr_of(fty)
  let here = align_for(off, r)
  wat_emit("    (local.set $h (i32.mul (i32.xor (local.get $h) ")
  emit_field_hash(here, r, fold_strip(fty))
  wat_emit(") (i32.const 16777619)))\n")
  emit_hash_field_mix(fields, i + 1, n, here + repr_width(r))
}

// The leaf hash of one field at byte offset `off` → an i32 hash s-expression.
// Word → the loaded word itself; float → str_hash(float_to_str) (value-faithful,
// equal f64 ⇒ equal hash); sequence → the state-threaded str_hash/list_hash;
// product/sum → a recursive $hash_<sig> call. The SAME five-node-kind leaf the
// lower_hash_dispatch drives — eq, compare, and hash cannot diverge.
fn emit_field_hash(off, r, fty) = match fty {
  TList(e) => // Byte sequence == the String family (§4①). Load-bearing here: list_hash
  // seeds its FNV mix with the length, str_hash does not — one type must
  // hash through ONE route or eq-equal values hash unequal.
  match seq_elem_face(e) {
    TByte => emit_field_hash_seq_call(off, "str_hash"),
    TFloat => emit_field_hash_seq_call(off, "list_hash_f64"),
    face => if seq_face_structural(face) {
      emit_field_hash_seq_call(off, "hash_{fold_sig(fty)}")
    } else {
      emit_field_hash_seq_call(off, "list_hash")
    },
  },
  TRecord(_) => emit_field_hash_agg_call(off, fold_sig(fty)),
  TRecordOpen(_, _) => emit_field_hash_agg_call(off, fold_sig(fty)),
  TTuple(_) => emit_field_hash_agg_call(off, fold_sig(fty)),
  TName(_, _) => emit_field_hash_agg_call(off, fold_sig(fty)),
  TFloat => // Float field: hash the decimal rendering of the loaded f64 (value-faithful).
  {
    wat_emit("(call $str_hash (call $float_to_str (f64.load offset=")
    wat_emit(int_to_str(off))
    wat_emit(" (local.get $a))))")
  },
  _ => // Int / Unit / resolved-TVar / nullary-tag — the loaded word IS its hash.
  {
    wat_emit("(")
    wat_emit(repr_load_op(r))
    wat_emit(" offset=")
    wat_emit(int_to_str(off))
    wat_emit(" (local.get $a))")
  },
}

// A sequence field hash: load the field pointer at `off`, call the runtime
// str_hash/list_hash with __state threaded (the W7 (state, ptr) convention).
fn emit_field_hash_seq_call(off, rt) = {
  wat_emit("(call $")
  wat_emit(rt)
  wat_emit(" (local.get $__state) (i32.load offset=")
  wat_emit(int_to_str(off))
  wat_emit(" (local.get $a)))")
}

// A nested aggregate field hash: load the field pointer, recurse its own
// $hash_<sig> (state-threaded). Finite on the value (the call, never inline).
fn emit_field_hash_agg_call(off, sig) = {
  wat_emit("(call $hash_")
  wat_emit(sig)
  wat_emit(" (local.get $__state) (i32.load offset=")
  wat_emit(int_to_str(off))
  wat_emit(" (local.get $a)))")
}

fn hash_operand_contrib(arg, acc) = {
  let h = lexpr_handle(arg)
  if h == 0 { acc } else { eq_subtys(fold_strip(chase_deep(lookup_ty(h))), [], acc) }
}

fn emit_binop_repr(op, r) = match r {
  RI32 => emit_binop(op),
  RF64 => emit_binop_f64(op),
  RF32 => emit_binop_f32(op),
  RI64 => emit_binop_i64(op),
  RV128 => emit_binop_v128(op),
}

fn emit_binop_f64(op) = match op {
  BAdd => wat_emit("    (f64.add)\n"),
  BSub => wat_emit("    (f64.sub)\n"),
  BMul => wat_emit("    (f64.mul)\n"),
  BDiv => wat_emit("    (f64.div)\n"),
  BLt => wat_emit("    (f64.lt)\n"),
  BGt => wat_emit("    (f64.gt)\n"),
  BLe => wat_emit("    (f64.le)\n"),
  BGe => wat_emit("    (f64.ge)\n"),
  _ => // BMod/BAnd/BOr/BEq/BNe/BConcat are not float operations; an inferred-float
  // operand reaching them is an HM type error upstream (Reason-carrying),
  // never a fabricated f64 instruction. Loud floor, no silent guess.
  emit_binop_repr_unsupported("f64", op),
}

fn emit_binop_f32(op) = match op {
  BAdd => wat_emit("    (f32.add)\n"),
  BSub => wat_emit("    (f32.sub)\n"),
  BMul => wat_emit("    (f32.mul)\n"),
  BDiv => wat_emit("    (f32.div)\n"),
  BLt => wat_emit("    (f32.lt)\n"),
  BGt => wat_emit("    (f32.gt)\n"),
  BLe => wat_emit("    (f32.le)\n"),
  BGe => wat_emit("    (f32.ge)\n"),
  _ => emit_binop_repr_unsupported("f32", op),
}

fn emit_binop_i64(op) = match op {
  BAdd => wat_emit("    (i64.add)\n"),
  BSub => wat_emit("    (i64.sub)\n"),
  BMul => wat_emit("    (i64.mul)\n"),
  BDiv => wat_emit("    (i64.div_s)\n"),
  BMod => wat_emit("    (i64.rem_s)\n"),
  BLt => wat_emit("    (i64.lt_s)\n"),
  BGt => wat_emit("    (i64.gt_s)\n"),
  BLe => wat_emit("    (i64.le_s)\n"),
  BGe => wat_emit("    (i64.ge_s)\n"),
  BAnd => wat_emit("    (i64.and)\n"),
  BOr => wat_emit("    (i64.or)\n"),
  _ => emit_binop_repr_unsupported("i64", op),
}

fn emit_binop_v128(op) = match op {
  BAdd => // Homogeneous f32x4 lanes — the value layer meeting the >< parallel verb.
  wat_emit("    (f32x4.add)\n"),
  BSub => wat_emit("    (f32x4.sub)\n"),
  BMul => wat_emit("    (f32x4.mul)\n"),
  BDiv => wat_emit("    (f32x4.div)\n"),
  _ => emit_binop_repr_unsupported("v128", op),
}

// A binop with no machine instruction at the operand's repr (e.g. BMod on a
// float) — an upstream HM type error, surfaced loud, never a fabricated op.
fn emit_binop_repr_unsupported(_w, _op) = {
  wat_emit("    ;; binop has no instruction at this representation —\n")
  wat_emit("    ;; an inferred-width mismatch is an HM type error upstream,\n")
  wat_emit("    ;; not a fabricated op here. (loud floor, no silent guess)\n")
  wat_emit("    (unreachable)\n")
}

fn emit_binop(op) = match op {
  BAdd => wat_emit("    (i32.add)\n"),
  BSub => wat_emit("    (i32.sub)\n"),
  BMul => wat_emit("    (i32.mul)\n"),
  BDiv => wat_emit("    (i32.div_s)\n"),
  BMod => wat_emit("    (i32.rem_s)\n"),
  BEq => wat_emit("    (i32.eq)\n"),
  BNe => wat_emit("    (i32.ne)\n"),
  BLt => wat_emit("    (i32.lt_s)\n"),
  BGt => wat_emit("    (i32.gt_s)\n"),
  BLe => wat_emit("    (i32.le_s)\n"),
  BGe => wat_emit("    (i32.ge_s)\n"),
  BAnd => wat_emit("    (i32.and)\n"),
  BOr => wat_emit("    (i32.or)\n"),
  BConcat => // Per Hβ.emit.runtime-helper-state-push: list_concat is W7-compiled
  // (state, a, b). Stack here has [a, b]; insert state UNDER via
  // save-reload through pre-declared $state_tmp + $callee_closure.
  // ONE concat (§4①): the carrier's sc rides the node, so the handle-less
  // default is the same list_concat every typed site emits.
  {
    wat_emit("    (local.set $callee_closure)\n")
    wat_emit("    (local.set $state_tmp)\n")
    wat_emit("    (local.get $__state)\n")
    wat_emit("    (local.get $state_tmp)\n")
    wat_emit("    (local.get $callee_closure)\n")
    wat_emit("    (call $list_concat)\n")
  },
}

fn emit_unaryop_for(h, op) = match op {
  UNeg => // UNeg reads the node's repr live — the handle proves the operand's
  // width, and the word-floor dance on an f64 was an assembly refusal
  // (caught 2026-07-28 by the wheel's first negative float literal in
  // argument position, the mcp error codes). Floats negate natively;
  // the word floor keeps the sink-and-subtract dance:
  // Hβ.first-light.unary-neg-stack-order — UNeg is `0 - x`, not
  // `x - 0`: sink x into $state_tmp (fn-preamble local), push 0 below,
  // restore x above, i32.sub. An RI64/RV128 operand falls to the same
  // word dance, whose i32 scratch local refuses at assembly — loud by
  // construction until those producers exist (the wide-ref residue).
  match repr_of(lookup_ty(h)) {
    RF64 => wat_emit("    (f64.neg)\n"),
    RF32 => wat_emit("    (f32.neg)\n"),
    RI32 | RI64 | RV128 => wat_emit("    (local.set $state_tmp) (i32.const 0) (local.get $state_tmp) (i32.sub)\n"),
  },
  UNot => wat_emit("    (i32.eqz)\n"),
}

// Emit the stores for each capture in the closure record.
// Captures are indexed from 0; each stored at offset 8 + 4*i.
// The per-handle local a record mint parks its pointer in — one home, so
// the emit and `walk_locals_expr`'s declaration cannot name it differently
// (which is a wat_asm error rather than a silent wrong, but only because
// the assembler is outside the medium).
fn mkclo_local(h) = "mkclo_{int_to_str(h)}"

// The record's `<~` lines: one ring per site, allocated with the record
// and stored at the slot lower assigned the site (`LhSlot`, past the
// captures / state and arms / k tail), so every record minted from one
// body owns its own line. The ring's bytes read the site's type under the
// active bracket — a twin's nested mint sizes its ring at the twin's
// width. A static home in a minted record is a lowering invariant broken
// and refuses as such.
fn emit_line_mints(lines, rec_local: String) = each(
  {
    (h, depth, home) => match home {
      LhSlot(slot) => {
        emit_alloc(line_ring_bytes(h, depth), "state_tmp")
        wat_emit("    (local.get ${rec_local})(local.get $state_tmp)(i32.store offset=")
        wat_emit(int_to_str(8 + slot * 4))
        wat_emit(")\n")
      },
      LhStatic => // A minted record has no static line: the settle point refused the
      // module that would carry one (`settle_minted_lines`).
      (),
      LhStaticJvp => // nor a static derivative line, refused by the same settle
      (),
    },
  },
  lines
)

fn emit_capture_stores(captures, base_i, rec_local: String) = each(
  {
    (i, capture) => {
      wat_emit("    (local.get ${rec_local})\n")
      emit_expr(capture)
      // A wide capture crosses into the word-slot record by reference (§5.U):
      // the slot stores the address of its spilled bytes; LUpval derefs.
      emit_wide_ref(tail_expr_repr(capture))
      wat_emit("    (i32.store offset=")
      wat_emit(int_to_str(8 + (base_i + i) * 4))
      wat_emit(")\n")
    },
  },
  enumerate(captures)
)

// Does this closure capture ITSELF — a self-recursive nested function (a
// go-style inner fn whose body calls itself)? Its self-capture is an LLocal referencing fn_name, filled from
// the enclosing scope where fn_name is the closure's own let-binding. That
// binding is the local the LLet sets AFTER the closure is built, so the
// self-capture must be bound to the record early or it reads a null fn_ptr
// (the parse_int nested-go indirect-call-type-mismatch). field_name_eq carries the
// String proof (a bare `==` would pointer-eq the names — this session's class).
// The self-capture, read by IDENTITY and answered with the name the
// EMITTED BODY uses for it. A nested fn binds its own name to its own
// handle in the enclosing frame, and a self-reference resolves through
// that bind, so the capture's handle IS the closure's handle — one
// comparison, no strings, immune to whether the fn's emitted symbol has
// been qualified. The predecessor compared the capture's name against
// the LowFn's name, which are drawn from two different namespaces the
// moment the nested-fn discriminator qualifies: the local one stays
// source-named while the symbol becomes outer_inner, so the match went
// false, the early bind below was skipped, and the closure's fn_ptr read
// an unset local (the trap: indirect call type mismatch in the lexer).
// Returning the NAME rather than a Bool closes the second half of the
// same defect — the bind targets what the body actually reads.
// "" = no self-capture.
fn self_capture_name(captures, closure_h) = match captures {
  [] => "",
  [c, ...rest] => match c {
    LLocal(ch, nm) => if ch == closure_h { nm } else { self_capture_name(rest, closure_h) },
    _ => self_capture_name(rest, closure_h),
  },
}

// Emit the stores for each payload of an ADT variant record, after the tag
// word at offset 0 (`emit_variant_stores_acc`).
fn emit_variant_field_stores_at(fields, base_i, local_name) =
  emit_variant_stores_acc(fields, 0, len(fields), 4, local_name)

// The variant-payload store fold: each payload field lands at the width-summed
// offset (align_for + repr_width) starting AFTER the tag word (base 4), and is
// written at its PROVEN repr (repr_store_op) — an f64 payload is 8 inline bytes
// via f64.store, every i32 payload i32.store at 4+4*i (byte-identical to the
// pre-gradient uniform slotting, Law 7). The SAME fold the eq-leaf
// (emit_eq_variant_payload_conjunction) and the LPCon match-bind read, so a
// variant payload's store/load/eq agree at one width (Carried-Truth). The field
// repr is the width the value is emitted at (`tail_expr_repr`, the one decider).
fn emit_variant_stores_acc(fields, i, n, off, local_name) = if i >= n {
  ()
} else {
  let fld = list_index(fields, i)
  let r = tail_expr_repr(fld)
  let here = align_for(off, r)
  wat_emit("    (local.get $")
  wat_emit(local_name)
  wat_emit(")\n")
  emit_expr(fld)
  wat_emit("    (")
  wat_emit(repr_store_op(r))
  wat_emit(" offset=")
  wat_emit(int_to_str(here))
  wat_emit(")\n")
  emit_variant_stores_acc(fields, i + 1, n, here + repr_width(r), local_name)
}

// variant_payload_offset — the byte offset of payload field `target` in a
// variant: the width-summed prefix-sum of repr_width over payloads 0..target,
// starting at 4 (after the tag word). The ONE fold the store, the eq-leaf, and
// the LPCon match-bind share so a variant's payload layout has one home. A
// payload's width is its slot's (`slot_repr`): the pattern's payload types are
// the scrutinee's at lower, a generic body's own variables, and a twin reads
// its instantiation through them — read bracket-blind, `second(Pair(1.5, 7))`
// under a Float twin found its Int payload at the word after the tag.
//
// out of range — unprovable, never a silent 0
fn variant_payload_offset(ptys, target, i, off) = if i >= len(ptys) {
  0 - 1
} else {
  let r = slot_repr(fold_strip(list_index(ptys, i)))
  let here = align_for(off, r)
  if i == target { here } else { variant_payload_offset(ptys, target, i + 1, here + repr_width(r)) }
}

// The shared store-fold — the STORE twin of the read-side width-summed
// projection: place field i at the width-summed `off`, advance by this
// field's repr_width. `local_name` is the record, variant or tuple base
// pointer, the literal's own scratch. Each field lands at the prefix-sum of
// repr_width over the canonically-sorted preceding fields (align_for +
// repr_width — the IDENTICAL fold lower's field_byte_offset_acc and
// emit_eq_leaf_conjunction run), and is written with repr_store_op(field_repr)
// — an f64 field is 8 inline bytes via f64.store, every i32/pointer field is
// i32.store at 4*i (byte-identical to the pre-gradient form, Law 7).
// Carried-Truth: construction reads the SAME offset+width the load side reads
// — never a flat 4*i the load re-derives as f64. The field repr is the width
// the value is emitted at (`tail_expr_repr`, the one decider): a record
// update's copied field is a load under the update's own handle, and reading
// that handle stored every copy as a word.
fn emit_field_stores_acc(fields, i, n, off, local_name) = if i >= n {
  ()
} else {
  let fld = list_index(fields, i)
  let r = tail_expr_repr(fld)
  let here = align_for(off, r)
  wat_emit("    (local.get $")
  wat_emit(local_name)
  wat_emit(")\n")
  emit_expr(fld)
  wat_emit("    (")
  wat_emit(repr_store_op(r))
  wat_emit(" offset=")
  wat_emit(int_to_str(here))
  wat_emit(")\n")
  emit_field_stores_acc(fields, i + 1, n, here + repr_width(r), local_name)
}

// product_byte_size — the allocation size of a width-summed product: the
// prefix-sum of repr_width over its fields (the same fold the stores walk, run
// to the end). For an all-i32 record this is exactly len*4 (Law 7 byte-
// identity); an f64 field genuinely widens it by 8. The size and the offsets
// project ONE fold — they cannot disagree on how wide the record is.
fn product_byte_size_acc(fields, i, n, off) = if i >= n {
  off
} else {
  let r = tail_expr_repr(list_index(fields, i))
  let here = align_for(off, r)
  product_byte_size_acc(fields, i + 1, n, here + repr_width(r))
}

fn product_byte_size(fields) = product_byte_size_acc(fields, 0, len(fields), 0)

// Cascading if-else over arm patterns. Classify the WHOLE arm set
// once: pure-nullary (sentinel compare), pure-fielded (offset=0 load
// + compare), or mixed (threshold gate at HEAP_BASE = 4096, then
// dispatch to one or the other branch).
//
// HB substrate: nullary variants emit as (i32.const tag) sentinels;
// fielded variants are heap pointers ≥ HEAP_BASE. The threshold
// comparison `(scrut < HEAP_BASE)` discriminates without ambiguity.
// Pattern algebra — predicate ⊕ projection.
//
// A pattern is the Boolean algebra of value space — the row algebra's
// mirror (PLAN §4③): nesting is intersection (short-circuit
// AND), alternation is union (short-circuit OR), tags and literals are
// atomic predicates, wildcards and vars are `true`. A match is an
// ordered OR-ELSE fold over arms; each arm is
//
//   (pred) (if (result i32) (then binds body) (else rest))
//
// Every constructor's predicate carries its OWN representation guard:
// a nullary constructor compares the sentinel directly; a fielded
// constructor guards (scrut >= heap_base) before loading the tag, so
// sentinel values short-circuit to 0 instead of reading low memory.
// The guard makes mixed matches, cross-shape alternation, and nested
// sentinel/fielded sub-patterns compose from the same two recursive
// projections — no arm-set shape classification, no runtime threshold
// fork, no filtered cascades, no dropped pattern forms. Eliding the
// guard when the scrutinee's type proves every constructor fielded is
// a gradient cash-out (graph-driven), not a shape system.
fn emit_match_arms(arms, w, h, sr) = if len(arms) == 0 {
  // The exhaustive fallthrough IS an autopsy, never a bare trap: an
  // ill-sorted scrutinee — a value whose representation matches no arm
  // of a total match, always a sort-boundary bug upstream — dies with
  // its evidence in the postmortem window: scratch word 0 = the
  // scrutinee's raw word (the scratch still holds the FAILING cascade's
  // own scrutinee — nested matches re-set it on entry), word 4 = the
  // match node's graph handle. A wide root's bits sit at [8, 8 + width)
  // so they never overlap the handle word. The backtrace names the site;
  // the scratch names the value and the graph address to interrogate —
  // the medium narrating its own death instead of dying mute
  // (Hβ.emit.trap-as-exception-postmortem, the larval in-scratch form;
  // the declaring-node walk's own postmortem shape at the match layer).
  let at = if repr_width(sr) > 4 { 8 } else { 0 }
  wat_emit("    (i32.const {int_to_str(at)})(local.get ${scrut_local(sr)})({repr_store_op(sr)})\n")
  wat_emit("    (i32.const 4)(i32.const ")
  wat_emit(int_to_str(h))
  wat_emit(")(i32.store)\n")
  wat_emit("    (unreachable)\n")
} else {
  // FIRST-match-wins: the cascade tests arms in SOURCE order. The prior
  // form recursed from last(arms) — the wrong-end class (§9, b93978f) at
  // the emit layer: the LAST arm tested FIRST, so any match whose final
  // arm is a wildcard collapsed to that arm's body alone (is_pure ≡
  // false — effname-pure's 117; the wrong-value trio). Disjoint-ctor
  // matches survived because their arm order is semantically free,
  // which is how 28 micros stayed green over the inversion.
  match list_index(arms, 0) {
    (pat, body) => if pat_always_matches(pat) {
      emit_pat_binds(pat, sr)
      emit_expr(body)
    } else {
      emit_pat_predicate(pat)
      wat_emit("    (if (result ")
      wat_emit(repr_wat(w))
      wat_emit(")\n      (then\n")
      emit_pat_binds(pat, sr)
      emit_expr(body)
      wat_emit("      )\n      (else\n")
      emit_match_arms(rest(arms), w, h, sr)
      wat_emit("      ))\n")
    },
  }
}

// The match scratch — the ROOT value's local, named at its repr through the
// projection every local's name goes through (`scrut_tmp` for a word).
fn scrut_local(r) = local_wat_name("scrut_tmp", r)

// The match's result width — every arm tail's repr joined (the same
// live read the if's branches take; one width types the whole cascade).
fn match_arms_repr(arms) = if len(arms) == 0 {
  RI32
} else {
  match last(arms) {
    (_, body) => repr_join(tail_expr_repr(body), match_arms_repr(drop_last(arms))),
  }
}

// A pattern that matches every value of its type — the arm is terminal
// (arms after it are dead; the fold stops descending).
fn pat_always_matches(pat) = match pat {
  LPWild => true,
  LPVar(_) => true,
  LPLit(_) => false,
  LPCon(_, _, _) => false,
  LPUnresolvedCon(_, _) => false,
  LPList(_, _, _, _) => false,
  LPTuple(ebs) => tuple_pats_always_match(ebs),
  LPRecord(_, _, fbs, _) => record_pats_always_match(fbs),
  LPAlt(branches) => alt_any_always_matches(branches),
  LPAs(_, inner) => pat_always_matches(inner),
}

// A tuple pattern's elements are (elem_ty, sub_pat); the tuple always matches
// iff every refutable element does (structure is fixed at the type).
fn tuple_pats_always_match(ebs) = if len(ebs) == 0 {
  true
} else {
  match last(ebs) {
    (_, sub_pat) => if pat_always_matches(sub_pat) { tuple_pats_always_match(drop_last(ebs)) } else { false },
  }
}

fn pats_always_match(subs) = if len(subs) == 0 {
  true
} else if pat_always_matches(last(subs)) {
  pats_always_match(drop_last(subs))
} else {
  false
}

fn record_pats_always_match(fbs) = if len(fbs) == 0 {
  true
} else {
  match last(fbs) {
    (_, sub_pat) => if pat_always_matches(sub_pat) { record_pats_always_match(drop_last(fbs)) } else { false },
  }
}

fn alt_any_always_matches(branches) = if len(branches) == 0 {
  false
} else if pat_always_matches(last(branches)) {
  true
} else {
  alt_any_always_matches(drop_last(branches))
}

// ── emit_scrut_at — the value at an offset path ─────────────────────
// path[0..path_len) is the load chain from the root scratch to this
// pattern's position; path_len 0 is the scrutinee itself. Ω.3
// buffer-counter discipline: one 8-slot buffer per walk, slot D owned
// by depth D, siblings overwrite cleanly.
// The scrutinee value at an offset path. Every step but the LAST is a pointer
// chase (i32.load — an aggregate field/payload/element is a handle); the last
// loads the value at its PROVEN repr (leaf_repr), so an f64 field/payload binds
// f64-wide (the same width the store wrote). emit_scrut_at defaults leaf_repr to
// RI32 — the word floor, byte-identical for pointer/i32 leaves (Law 7) — and the
// width-typed leaves (a float payload/field bind) route through emit_scrut_at_repr.
// A pattern path step is one of TWO navigations, never one Int wearing
// two meanings: POff chases a FIXED layout (record field, tuple slot,
// variant payload — offsets lower/emit PROVED), PIdx reads a SEQUENCE
// element through the runtime's own total reader ($list_index — tag- and
// stride-dispatching), so a list pattern matches a rope, snoc, or slice
// exactly as it matches a flat list. The raw 8+4i element read this
// replaces was a representation leak: sound only for tag-0 flat lists,
// garbage on a `++` rope (the pa11 crucible).
type PatStep = POff(Int) | PIdx(Int)

fn emit_scrut_at(path, path_len) = emit_scrut_at_repr(path, path_len, RI32)

// At path length zero the value IS the root, parked in the scratch named at
// its own repr; every deeper path starts from a pointer (a step is a chase),
// so it starts from the word scratch.
fn emit_scrut_at_repr(path, path_len, leaf_repr) = {
  let root = if path_len == 0 { scrut_local(leaf_repr) } else { scrut_local(RI32) }
  wat_emit("    (local.get ${root})\n")
  emit_load_chain_repr(path, 0, path_len, leaf_repr)
}

// ── Predicate projection — ONE i32 on the stack ─────────────────────
fn emit_pat_predicate(pat) = emit_pat_predicate_at(pat, make_list(8), 0)

fn emit_pat_predicate_at(pat, path, path_len) = match pat {
  LPWild => wat_emit("    (i32.const 1)\n"),
  LPVar(_) => wat_emit("    (i32.const 1)\n"),
  LPUnresolvedCon(_, _) => // A ctor no declaration proves can match nothing — the honest constant,
  // never a fabricated out-of-domain tag compare.
  wat_emit("    (i32.const 0)\n"),
  LPLit(lv) => match lv {
    LString(_) => // A STRING-literal pattern is `scrutinee == "literal"` at the match layer,
    // so it is the SAME structural sequence-eq `==` derives — str_eq over the
    // [Byte] view, NEVER the i32.eq the scalar floor below emits on the two
    // POINTERS. The pointer-eq floored every `match s { "lit" => }` in the
    // wheel to a LAYOUT LOTTERY (the token's interned "len" vs the pattern
    // literal's "len" collide by address only when interned together): m2's
    // layout lucked the seq-op `match cname { "len" }` right, m3's did not, so
    // m3 mistyped `len(argv)` as List and emitted list_compare — the m4
    // blocker. The W7 state-insert (scrut, const → __state, scrut, const),
    // then str_eq → Bool (a drop-in for the i32.eq the predicate expects).
    {
      emit_scrut_at_repr(path, path_len, RI32)
      emit_low_value_const(lv)
      emit_fold_state_insert()
      wat_emit("    (call $str_eq)\n")
    },
    _ => // Scalars: value-eq IS structural. A float LOADS the scrutinee f64-wide
    // (emit_scrut_at_repr at low_value_repr) and compares f64.eq (the gradient
    // at the match layer); Int/Bool/Unit take the i32.eq floor (byte-identical,
    // Law 7). The leaf load, the const, and the compare project the SAME repr.
    {
      emit_scrut_at_repr(path, path_len, low_value_repr(lv))
      emit_low_value_const(lv)
      wat_emit("    (")
      wat_emit(repr_wat(low_value_repr(lv)))
      wat_emit(".eq)\n")
    },
  },
  LPCon(_, tag, pairs) => if len(pairs) == 0 {
    // Nullary constructor IS its sentinel (HB) — direct compare.
    emit_scrut_at(path, path_len)
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(tag))
    wat_emit(")\n    (i32.eq)\n")
  } else {
    // Representation guard, then tag, then sub-predicates — each
    // layer short-circuits so loads only fire on live paths. The payload
    // sub-predicates read width-summed offsets (the SAME variant_payload_
    // offset fold the store + eq + show run), so an f64 payload is matched
    // at its genuine 8-byte slot.
    emit_scrut_at(path, path_len)
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(heap_base()))
    wat_emit(")\n    (i32.ge_u)\n")
    wat_emit("    (if (result i32)\n      (then\n")
    emit_scrut_at(path, path_len)
    wat_emit("    (i32.load offset=0)\n")
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(tag))
    wat_emit(")\n    (i32.eq)\n")
    emit_pat_con_subs_predicate(ty_of_pairs(pairs), pat_of_pairs(pairs), 0, path, path_len)
    wat_emit("      )\n      (else (i32.const 0)))\n")
  },
  LPTuple(ebs) => {
    // Tuples are untagged positional products; structure always matches —
    // the predicate is the AND of refutable elements, each at its width-summed
    // offset (the SAME offsets construction/index read, the record-pattern fold).
    wat_emit("    (i32.const 1)\n")
    emit_pat_tuple_subs_predicate(ebs, path, path_len)
  },
  LPRecord(rh, rty, fbs, rest) => match record_full_fields(rty) {
    Some(full) => {
      wat_emit("    (i32.const 1)\n")
      emit_pat_record_subs_predicate(full, fbs, path, path_len)
    },
    None => if record_pats_always_match(fbs) {
      wat_emit("    (i32.const 1)\n")
    } else {
      emit_record_pattern_floor(rty)
    },
  },
  LPList(elem, sub_pats, rest, srep) => {
    // count@0 is the ONE universal sequence header (every representation —
    // flat, snoc, rope, slice — carries it). Elements: a proven-flat list
    // whose element is a word held by value (`list_elem_read`) reads raw
    // POff(8+4i) — the direct loads, bounds-proven by this very length test;
    // every other list reads through $list_index (PIdx), the total reader.
    // The proof becomes the dispatch, per receiver and per twin.
    emit_scrut_at(path, path_len)
    wat_emit("    (i32.load offset=0)\n")
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(len(sub_pats)))
    wat_emit(")\n")
    match rest {
      None => wat_emit("    (i32.eq)\n"),
      Some(_) => wat_emit("    (i32.ge_u)\n"),
    }
    emit_pat_subs_predicate(sub_pats, list_elem_read(srep, elem), path, path_len)
  },
  LPAlt(branches) => emit_pat_alt_predicate(branches, path, path_len),
  LPAs(_, inner) => // The binder never affects MATCHING — the predicate is the inner's.
  emit_pat_predicate_at(inner, path, path_len),
}

// Each refutable field sub-pattern tests at its field's offset in the WHOLE
// field set the receiver resolved to — the offset every field load of the
// same record reads (`record_field_offset`), under whatever twin this is.
fn emit_pat_record_subs_predicate(full, fbs, path, path_len) = if len(fbs) == 0 {
  ()
} else {
  match last(fbs) {
    (name, sub_pat) => if pat_always_matches(sub_pat) {
      emit_pat_record_subs_predicate(full, drop_last(fbs), path, path_len)
    } else {
      wat_emit("    (if (result i32)\n      (then\n")
      let extended = list_set(path, path_len, POff(field_byte_offset(full, name, 0, len(full))))
      emit_pat_predicate_at(sub_pat, extended, path_len + 1)
      emit_pat_record_subs_predicate(full, drop_last(fbs), path, path_len)
      wat_emit("      )\n      (else (i32.const 0)))\n")
    },
  }
}

// A record pattern whose receiver's field set never closed — the named trap,
// never its own field indices taken as offsets. The settle point said it at
// the scrutinee (`settle_pattern`).
fn emit_record_pattern_floor(rty) = {
  wat_emit("    (unreachable)  ;; field offset unprovable: ")
  wat_emit(record_pattern_unprovable_why(rty))
  wat_emit("\n")
}

fn record_pattern_unprovable_why(rty) = "record pattern on {show_type(rty)}"

// Whether a record pattern has work in the binds phase: a field that binds,
// or a rest that is named.
fn record_pat_has_binds(fbs, rest) = if record_pats_have_binders(fbs) {
  true
} else {
  match rest {
    None => false,
    Some(rn) => !field_name_eq(rn, "_"),
  }
}

// A tuple pattern's elements are (elem_ty, sub_pat) — the IDENTICAL projection
// as the record predicate, minus the field name. Each element's offset projects
// at emit through pat_tuple_off (the live width-summed fold), so a twin's
// instantiation places the test where the construction stored the value.
// Iteration stays last-first (the emitted AND-nest is outermost-last),
// byte-identical to the pre-projection order.
fn emit_pat_tuple_subs_predicate(ebs, path, path_len) =
  emit_pat_tuple_subs_predicate_at(ebs, len(ebs) - 1, path, path_len)

fn emit_pat_tuple_subs_predicate_at(ebs, i, path, path_len) = if i < 0 {
  ()
} else {
  match list_index(ebs, i) {
    (_ty, sub_pat) => if pat_always_matches(sub_pat) {
      emit_pat_tuple_subs_predicate_at(ebs, i - 1, path, path_len)
    } else {
      wat_emit("    (if (result i32)\n      (then\n")
      let extended = list_set(path, path_len, POff(pat_tuple_off(ebs, i, 0, 0)))
      emit_pat_predicate_at(sub_pat, extended, path_len + 1)
      emit_pat_tuple_subs_predicate_at(ebs, i - 1, path, path_len)
      wat_emit("      )\n      (else (i32.const 0)))\n")
    },
  }
}

// OR-composition over alternation branches, short-circuit: the first
// matching branch yields 1 without evaluating the rest. All branches
// read the SAME position (path unchanged).
fn emit_pat_alt_predicate(branches, path, path_len) = if len(branches) == 0 {
  wat_emit("    (i32.const 0)\n")
} else {
  emit_pat_predicate_at(last(branches), path, path_len)
  let rest = drop_last(branches)
  if len(rest) == 0 {
    ()
  } else {
    wat_emit("    (if (result i32)\n      (then (i32.const 1))\n      (else\n")
    emit_pat_alt_predicate(rest, path, path_len)
    wat_emit("      ))\n")
  }
}

// ── Binds projection — local.set for every binder ───────────────────
// The scrutinee root is a pointer/word (RI32); the per-element reprs flow in
// from the con/tuple sub-binds (a payload/element's proven repr), so an f64
// leaf binder loads f64-wide. RI32 is the byte-identical floor for every
// pointer/word leaf (Law 7).
// The root value's repr is the scrutinee's (`sr`); every deeper position's
// comes from the type its path proves.
fn emit_pat_binds(pat, sr) = emit_pat_binds_at(pat, make_list(8), 0, sr)

fn emit_pat_binds_at(pat, path, path_len, val_repr) = match pat {
  LPVar(name) => {
    emit_scrut_at_repr(path, path_len, val_repr)
    wat_emit("    (local.set $")
    wat_emit(local_wat_name(name, val_repr))
    wat_emit(")\n")
  },
  LPWild => (),
  LPLit(_) => (),
  LPCon(_, _, pairs) => emit_pat_con_subs_binds(ty_of_pairs(pairs), pat_of_pairs(pairs), 0, path, path_len),
  LPUnresolvedCon(_, sub_pats) => // Dead arm (predicate false) — bind each sub at the scrutinee root, word
  // floor: never executes, always assembles.
  each((p) => emit_pat_binds_at(p, path, path_len, RI32), sub_pats),
  LPTuple(ebs) => emit_pat_tuple_binds(ebs, path, path_len),
  LPRecord(_rh, rty, fbs, rest) => match record_full_fields(rty) {
    Some(full) => {
      emit_pat_record_binds(full, fbs, path, path_len)
      emit_pat_record_rest_bind(full, fbs, rest, path, path_len)
    },
    None => if record_pat_has_binds(fbs, rest) { emit_record_pattern_floor(rty) } else { () },
  },
  LPList(elem, sub_pats, rest, srep) => {
    emit_pat_subs_binds(sub_pats, list_elem_read(srep, elem), path, path_len, slot_repr(elem))
    emit_pat_list_rest_bind(len(sub_pats), rest, path, path_len)
  },
  LPAlt(branches) => emit_pat_alt_binds(branches, path, path_len),
  LPAs(name, inner) => {
    // Bind the WHOLE value at this path — at its own repr, the one the
    // path proves — then the inner's binders at the same.
    emit_scrut_at_repr(path, path_len, val_repr)
    wat_emit("    (local.set $")
    wat_emit(local_wat_name(name, val_repr))
    wat_emit(")\n")
    emit_pat_binds_at(inner, path, path_len, val_repr)
  },
}

// How a list pattern reaches its elements. `$list_index` (PIdx) answers each
// element's word face — its value for a word, its address for a wide element
// (lib/lists.mn's word protocol) — so a wide leaf loads its width through
// the address (`emit_load_chain_repr`). A proven-flat list whose element is
// a word held by value keeps element i at 8 + 4i, read raw.
type ElemRead = ReadRaw | ReadIndexed

// The raw read is licensed when the list is proven flat and its slot holds
// the element by value in one word: the element's type under the twin
// strides four bytes and is not wide. A packed byte, a wide element and
// every other representation read through `$list_index`. It is decided
// here, per twin, because the element's width is the twin's: a generic list
// literal matched in place is born packed at eight bytes a slot under a
// Float twin.
fn list_elem_read(srep, elem) = match srep {
  SRFlat => {
    let t = slot_ty(elem)
    if stride_of(t) == 4 && !repr_is_wide(repr_of(t)) { ReadRaw } else { ReadIndexed }
  },
  SRSnoc | SRRope | SRSlice | SRUnknown => ReadIndexed,
}

fn elem_step(read, i) = match read {
  ReadRaw => POff(8 + i * 4),
  ReadIndexed => PIdx(i),
}

// AND-composition over a list pattern's element sub-patterns, in element
// order. A bool is on the stack when called; each sub that can fail opens
// (if (result i32) (then <its test> …) and the closes follow, one per open —
// short-circuit, so a failed test never evaluates a later element's read.
fn emit_pat_subs_predicate(subs, read, path, path_len) = {
  let tests = filter(elem_test_can_fail, enumerate(subs))
  each(emit_elem_test(??, read, path, path_len), tests)
  each(emit_elem_test_close, tests)
}

fn elem_test_can_fail(e) = match e {
  (_, p) => !pat_always_matches(p),
}

fn emit_elem_test(e, read, path, path_len) = match e {
  (i, p) => {
    wat_emit("    (if (result i32)\n      (then\n")
    emit_pat_predicate_at(p, list_set(path, path_len, elem_step(read, i)), path_len + 1)
  },
}

fn emit_elem_test_close(test) = wat_emit("      )\n      (else (i32.const 0)))\n")

// Each element sub-pattern binds at the element's slot width `r`, in
// element order: sub i is element i.
fn emit_pat_subs_binds(subs, read, path, path_len, r) =
  each(emit_elem_bind(??, read, path, path_len, r), enumerate(subs))

fn emit_elem_bind(e, read, path, path_len, r) = match e {
  (i, p) => emit_pat_binds_at(p, list_set(path, path_len, elem_step(read, i)), path_len + 1, r),
}

// con-payload binders: each sub-pattern at its width-summed payload offset
// (variant_payload_offset — the SAME fold the store/eq/show run), binding at the
// payload's slot width so an f64 payload loads f64-wide. Read live from the
// constructor's payload types.
fn emit_pat_con_subs_binds(ptys, subs, i, path, path_len) = if len(subs) == 0 {
  ()
} else {
  // Sub i pairs with payload i (offset AND repr) — consume from the
  // FRONT. The last(subs)+i pairing bound MkPair(a, b)'s a at b's slot
  // and b at a's (compare-fold's 23: fst/snd swapped end to end).
  let pty = if i < len(ptys) { fold_strip(list_index(ptys, i)) } else { TVar(0) }
  let off = variant_payload_offset(ptys, i, 0, 4)
  let extended = list_set(path, path_len, POff(off))
  emit_pat_binds_at(list_index(subs, 0), extended, path_len + 1, slot_repr(pty))
  emit_pat_con_subs_binds(ptys, rest(subs), i + 1, path, path_len)
}

// con-payload predicates: each refutable sub-pattern at its width-summed payload
// offset. The leaf's own predicate (LPLit) loads at its repr; this only places
// the offset, so no leaf-repr threading is needed here.
fn emit_pat_con_subs_predicate(ptys, subs, i, path, path_len) = if len(subs) == 0 {
  ()
} else {
  // Sub i guards payload i — front-consumed, the binds walker's twin.
  let sub_pat = list_index(subs, 0)
  if pat_always_matches(sub_pat) {
    emit_pat_con_subs_predicate(ptys, rest(subs), i + 1, path, path_len)
  } else {
    wat_emit("    (if (result i32)\n      (then\n")
    let off = variant_payload_offset(ptys, i, 0, 4)
    let extended = list_set(path, path_len, POff(off))
    emit_pat_predicate_at(sub_pat, extended, path_len + 1)
    emit_pat_con_subs_predicate(ptys, rest(subs), i + 1, path, path_len)
    wat_emit("      )\n      (else (i32.const 0)))\n")
  }
}

// Each field sub-pattern binds at its field's offset and slot width in the
// whole field set — an f64 field loads f64 from its 8-byte slot, where a
// word-width bind once read half of it.
fn emit_pat_record_binds(full, fbs, path, path_len) = if len(fbs) == 0 {
  ()
} else {
  match last(fbs) {
    (name, sub_pat) => {
      let extended = list_set(path, path_len, POff(field_byte_offset(full, name, 0, len(full))))
      emit_pat_binds_at(sub_pat, extended, path_len + 1, slot_repr(pat_field_ty(Some(full), TUnit, name)))
      emit_pat_record_binds(full, drop_last(fbs), path, path_len)
    },
  }
}

// Tuple-element binders bind at the element's live-channel repr and the
// pat_tuple_off projection — an f64 element loads f64 at its 8-byte slot,
// a pointer/word loads i32. The SAME offset+width the construction stored,
// under any bracket. Iteration stays last-first (byte-identical order).
fn emit_pat_tuple_binds(ebs, path, path_len) =
  emit_pat_tuple_binds_at(ebs, len(ebs) - 1, path, path_len)

fn emit_pat_tuple_binds_at(ebs, i, path, path_len) = if i < 0 {
  ()
} else {
  match list_index(ebs, i) {
    (elem_ty, sub_pat) => {
      let extended = list_set(path, path_len, POff(pat_tuple_off(ebs, i, 0, 0)))
      emit_pat_binds_at(sub_pat, extended, path_len + 1, slot_repr(elem_ty))
      emit_pat_tuple_binds_at(ebs, i - 1, path, path_len)
    },
  }
}

// rest = slice(xs, n_prefix, len(xs)). $slice is the W7 runtime fn
// (state-first; builtin-only row → const-0 state arg is the honest
// form, the state is never read).
fn emit_pat_list_rest_bind(n_prefix, rest, path, path_len) = match rest {
  None => (),
  Some(name) => if rest_binds(rest) {
    wat_emit("    (i32.const 0)\n")
    emit_scrut_at(path, path_len)
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(n_prefix))
    wat_emit(")\n")
    emit_scrut_at(path, path_len)
    wat_emit("    (i32.load offset=0)\n")
    wat_emit("    (call ${list_rest_callee()})\n")
    wat_emit("    (local.set $")
    wat_emit(name)
    wat_emit(")\n")
  },
}

// Whether a pattern's rest names a binding — `...rest`, never `..._` — the
// test both rest emitters and the allocation audit read.
fn rest_binds(rest) = match rest {
  Some(name) => !field_name_eq(name, "_"),
  None => false,
}

// The record rest: BUILD the remaining-fields record — the whole field set
// less the fields the pattern names, in its own sorted layout. Allocate its
// size, copy each remaining slot from the receiver at its offset and width,
// and bind the declared rest local (the local doubles as the build
// accumulator, so no scratch is spent). `full` is the receiver's field set
// read under the bracket the body is emitted in, so a twin builds its own
// site's residual, each field at its width — and the rest binder's own
// reads spell the same residual (`record_full_fields`: its row's pair is
// what the site proved past the receiver's named fields).
fn emit_pat_record_rest_bind(full, fbs, rest, path, path_len) = match rest {
  None => (),
  Some(name) => if rest_binds(rest) {
    let residual = filter(unnamed_by(fbs, ??), full)
    emit_alloc(record_byte_size(residual), name)
    each(emit_rest_copy(full, residual, name, path, path_len, ??), residual)
  },
}

fn unnamed_by(fbs, f) = match f {
  (n, _) => !any(pat_names_field(n, ??), fbs),
}

fn pat_names_field(n: String, fb) = match fb {
  (m, _) => field_name_eq(m, n),
}

fn emit_rest_copy(full, residual, name: String, path, path_len, f) = match f {
  (fname, fty) => {
    let r = slot_repr(fty)
    wat_emit("    (local.get ${name})\n")
    emit_scrut_at(path, path_len)
    wat_emit("    ({repr_load_op(r)} offset={int_to_str(field_byte_offset(full, fname, 0, len(full)))})\n")
    wat_emit("    ({repr_store_op(r)} offset={int_to_str(field_byte_offset(residual, fname, 0, len(residual)))})\n")
  },
}

// A record's byte size: the width-summed fold over its sorted fields, each
// at its slot width — the fold every offset in it is read from.
fn record_byte_size(fields) = fold(0, record_size_step, fields)

fn record_size_step(off, f) = match f {
  (_, t) => {
    let r = slot_repr(t)
    align_for(off, r) + repr_width(r)
  },
}

// Alternation binds: branches bind the same names (infer's law), but
// each branch extracts along ITS OWN paths — re-dispatch on the branch
// that matched. Binder-free alternation (the common tag-union case)
// emits nothing.
fn emit_pat_alt_binds(branches, path, path_len) =
  if alt_has_binders(branches) { emit_pat_alt_binds_dispatch(branches, path, path_len) } else { () }

fn alt_has_binders(branches) = if len(branches) == 0 {
  false
} else if lowpat_has_binders(last(branches)) {
  true
} else {
  alt_has_binders(drop_last(branches))
}

fn lowpat_has_binders(pat) = match pat {
  LPVar(_) => true,
  LPWild => false,
  LPLit(_) => false,
  LPCon(_, _, pairs) => lowpats_have_binders(pat_of_pairs(pairs)),
  LPUnresolvedCon(_, sub_pats) => lowpats_have_binders(sub_pats),
  LPTuple(ebs) => tuple_pats_have_binders(ebs),
  LPRecord(_, _, fbs, rest) => record_pat_has_binds(fbs, rest),
  LPList(_, sub_pats, rest, _) => if lowpats_have_binders(sub_pats) {
    true
  } else {
    match rest {
      None => false,
      Some(n) => n != "_",
    }
  },
  LPAlt(branches) => alt_has_binders(branches),
  LPAs(_, _) => true,
}

fn lowpats_have_binders(subs) = if len(subs) == 0 {
  false
} else if lowpat_has_binders(last(subs)) {
  true
} else {
  lowpats_have_binders(drop_last(subs))
}

fn record_pats_have_binders(fbs) = if len(fbs) == 0 {
  false
} else {
  match last(fbs) {
    (_, sub_pat) => if lowpat_has_binders(sub_pat) { true } else { record_pats_have_binders(drop_last(fbs)) },
  }
}

fn tuple_pats_have_binders(ebs) = if len(ebs) == 0 {
  false
} else {
  match last(ebs) {
    (_, sub_pat) => if lowpat_has_binders(sub_pat) { true } else { tuple_pats_have_binders(drop_last(ebs)) },
  }
}

fn emit_pat_alt_binds_dispatch(branches, path, path_len) = if len(branches) == 0 {
  ()
} else {
  let rest = drop_last(branches)
  if len(rest) == 0 {
    // Last branch: matched by elimination (the arm predicate held). Alt
    // branches bind at the scrutinee position; the leaf repr is RI32 (the
    // branches bind the same names — an f64-alt-binder rides the same leaf
    // path, RI32-byte-identical for the word case).
    emit_pat_binds_at(last(branches), path, path_len, RI32)
  } else {
    emit_pat_predicate_at(last(branches), path, path_len)
    wat_emit("    (if\n      (then\n")
    emit_pat_binds_at(last(branches), path, path_len, RI32)
    wat_emit("      )\n      (else\n")
    emit_pat_alt_binds_dispatch(rest, path, path_len)
    wat_emit("      ))\n")
  }
}

// emit_load_chain_repr — chain the field-traversal loads to reach the
// pattern's position. Every INTERMEDIATE step is a pointer chase (i32.load —
// the value at a path step is a handle into a deeper aggregate); the FINAL
// step (k == path_len - 1) loads the matched value at its proven leaf_repr,
// so an f64 leaf binds f64-wide (the same width the store wrote —
// Carried-Truth across store/load). Caller has already read the root
// scratch (`emit_scrut_at_repr`).
fn emit_load_chain_repr(path, k, path_len, leaf_repr) = if k == path_len {
  ()
} else {
  match list_index(path, k) {
    POff(off) => // NO negative offset reaches WAT: off < 0 = resolve_field_offset could
    // not PROVE this field's offset (the scrutinee's type is non-record/
    // unresolved or the field is absent). Emit (unreachable) — the loud
    // floor — never i32.load offset=-1 (invalid WAT) nor a silent
    // foreign-field read. The chain stops here: the rest is dead.
    if off < 0 {
      wat_emit("    (unreachable)\n")
    } else {
      // The last step loads at leaf_repr; every prior step is an i32
      // pointer chase (intermediate aggregate handles are always words).
      let is_last = k + 1 == path_len
      let ld = if is_last { repr_load_op(leaf_repr) } else { "i32.load" }
      wat_emit("    (")
      wat_emit(ld)
      wat_emit(" offset=")
      wat_emit(int_to_str(off))
      wat_emit(")\n")
      emit_load_chain_repr(path, k + 1, path_len, leaf_repr)
    },
    PIdx(i) => // A sequence element reads through the runtime's total reader — the
    // SAME tag- and stride-dispatch every subscript takes, so a rope,
    // snoc, or slice scrutinee matches exactly like a flat list. The
    // result is the element's word face (a wide element's is its address —
    // the word protocol), so a deeper step chains unchanged and a wide leaf
    // loads its width through the address.
    {
      wat_emit("    (i32.const ")
      wat_emit(int_to_str(i))
      wat_emit(")\n")
      emit_fold_state_insert()
      wat_emit("    (call $list_index)\n")
      if k + 1 == path_len { emit_wide_deref(leaf_repr) } else { () }
      emit_load_chain_repr(path, k + 1, path_len, leaf_repr)
    },
  }
}

// Emit a low-value as an i32-erased const (used by LPLit dispatch).
fn emit_low_value_const(lv) = match lv {
  LInt(n) => {
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(n))
    wat_emit(")\n")
  },
  LBool(b) => {
    wat_emit("    (i32.const ")
    wat_emit(if b { "1" } else { "0" })
    wat_emit(")\n")
  },
  LFloat(f) => // Float literal pattern: the native (f64.const v) at the default float repr,
  // compared with f64.eq (the LPLit guard). The i32-floor zero and its boxed-
  // f64 peer are DELETED — unsayable now that the value flows at its real
  // width. The pattern and expression positions project the SAME repr.
  {
    wat_emit("    (f64.const ")
    wat_emit(float_to_str(f))
    wat_emit(")\n")
  },
  LString(s) => // A string literal in pattern position is the SAME interned constant the
  // expression position emits (emit_const's LString arm) — walk_lemit_pat
  // registered it through visit_string, string_offset reads it back. The
  // prior `(i32.const 0)` floor made every string-pattern compare
  // str_eq(operand, address-0): every arm missed, wildcards swallowed the
  // dispatch, and infer_seq_op typed every len/slice/... call TList — the
  // eq-dispatch flips that stood between m3 and m4 (2026-07-10).
  {
    let offset = string_offset(s)
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(offset))
    wat_emit(")\n")
  },
  LZero => // No pattern is written with a placeholder zero; a literal pattern's word
  // compare would read it as the word 0.
  wat_emit("    (i32.const 0)\n"),
}

// The repr a low-value (a literal) projects: a float literal is RF64 (the
// gradient's inferred DEFAULT), every other literal is the i32 word floor.
// Drives the LPLit guard's comparison width so the const and the compare agree
// (emit_low_value_const projects the SAME RF64 → f64.const, so a bare float
// pattern compares a bare float scrutinee at one width — Carried-Truth holds at
// the default). An f32/lane PIN would narrow this below RF64 — but a LowValue
// carries no handle, so honoring the pin means threading the LPLit's operand
// handle to read repr_of(lookup_ty(pat_handle)) exactly as the expression
// position does (emit_float_const at the LFloat expr arm). Named peer:
// Hβ.emit.plit-handle-repr — thread the pattern-literal handle so a pinned-f32
// literal compares at f32 in match as in expression. The default RF64 is
// correct by construction for a bare float literal (which IS RF64), so this is
// a coherence-completeness peer, not a present miscompile.
fn low_value_repr(lv) with Pure = match lv {
  LFloat(_) => RF64,
  _ => RI32,
}

fn emit_list_literal(h, elems) = {
  // The graph knows the length at compile time; knows the element
  // type via lookup_ty on each elem's handle; knows the allocation
  // context from the enclosing row. Literals never need cons — cons
  // is for lists the graph doesn't yet know (push / ++ / slice
  // materialize snoc / concat / view tags; lists.mn's
  // list_index dispatches on the tag). A literal is all-flat, all-
  // known.
  //
  // Ultimate emission: one allocation, N inline stores. make_list(n)
  // allocates 8 + n*4 bytes with layout:
  //   offset 0: length
  //   offset 4: tag = 0 (flat)
  //   offset 8 + i*4: element i
  // list_set(state, list, idx, val) stores and returns the list
  // pointer (W7: every fn takes __state first). At iteration top the
  // returned list_ptr is saved to $callee_closure scratch; reloaded
  // onto stack BEFORE elem emission so it survives any clobber inner
  // emit performs on the local. The result is the list pointer (O(1)
  // indexable via list_index@tag=0).
  //
  // When the enclosing row excludes Alloc AND every element is a
  // pure literal, this whole construction can fold into a static
  // data segment — no runtime allocation at all. That fold is a
  // named peer handle tracked in PLAN.md's bands;
  // it does not change the emitted primitive when the fold doesn't
  // apply.
  let n = len(elems)
  // The allocator reads the ELEMENT's stride (the §4① carrier, emit side):
  // a word list keeps make_list (byte-identical floor); a packed element
  // (byte sc 1, f64 sc 2) allocates its stride through make_list_sc, so the
  // literal is born packed and every generic read follows the carrier.
  let sc = literal_stride_class(h)
  wat_emit("    (local.get $__state)\n")
  wat_emit("    (i32.const ")
  wat_emit(int_to_str(n))
  wat_emit(")\n")
  if sc != 0 {
    wat_emit("    (i32.const ")
    wat_emit(int_to_str(sc))
    wat_emit(")\n")
  }
  wat_emit("    (call ${list_literal_callee(sc)})\n")
  emit_list_stores(elems, 0)
}

// The constructor a list literal calls at its stride class, the one name
// the emission writes and the allocation audit reads the row of.
fn list_literal_callee(sc) = if sc == 0 { "make_list" } else { "make_list_sc" }

// The literal's element stride-class, read from the node's proven type.
// An unresolved/non-list shape is the word floor (sc 0).
fn literal_stride_class(h) = match fold_strip(lookup_ty(h)) {
  TList(e) => stride_class(stride_of(seq_elem_face(e))),
  _ => // drift-audit: ignore — the fn's own comment names it: an unresolved/non-list shape IS the word floor (sc 0)
  0,
}

fn emit_list_stores(elems, base_idx) = each(
  {
    (i, elem) => {
      wat_emit("    (local.set $callee_closure)\n")
      wat_emit("    (local.get $__state)\n")
      wat_emit("    (local.get $callee_closure)\n")
      wat_emit("    (i32.const ")
      wat_emit(int_to_str(base_idx + i))
      wat_emit(")\n")
      emit_expr(elem)
      // A wide element crosses to the word-faced list_set by reference; the
      // packed slot's store_strided copies the bytes from behind it.
      emit_wide_ref(tail_expr_repr(elem))
      wat_emit("    (call $list_set)\n")
    },
  },
  enumerate(elems)
)

// A tuple IS a positional product (L1) — construction is the record path: each
// element lands at the width-summed offset (emit_field_stores_acc, the IDENTICAL
// fold the index/match-bind read), the allocation size is the prefix-sum total
// (product_byte_size), and an f64 element genuinely occupies 8 inline bytes via
// f64.store. For an all-i32 tuple the offsets are exactly 4*i and the size is
// len*4 — byte-identical to the old uniform-stride $alloc_tuple (Law 7), with
// the difference that the store-side widths now MATCH the read-side
// (tuple_elem_offset / LFieldLoad / LPTuple match-bind) so an f64 tuple
// round-trips. Per-handle scratch ($tuple_<h>) avoids nested-tuple clobber, the
// same discipline LMakeVariant uses.
fn emit_tuple_literal(h, elems) = {
  let size = product_byte_size(elems)
  let local_name = "tuple_{int_to_str(h)}"
  emit_alloc(size, local_name)
  emit_field_stores_acc(elems, 0, len(elems), 0, local_name)
  wat_emit("    (local.get $")
  wat_emit(local_name)
  wat_emit(")\n")
}

// SIMD lane pack — the `~> Simd` fanout collector (W13). The N branch results
// (each an f32, the branch's RV128-element repr) become the lanes of one v128:
// zero the accumulator, then `f32x4.replace_lane i` each branch value into it.
// The result is one v128 the lane ops (emit_binop_v128: f32x4.add/mul) process
// four-at-once — the value layer's RV128 repr meeting the `><` parallel verb at
// the SPACE axis. NOT a heap allocation: a v128 is a stack/register value, so
// the accumulator is the $simd_<h> v128 local (declared in walk_locals_expr).
fn emit_simd_lanes(h, lanes) = {
  let local_name = "simd_{int_to_str(h)}"
  wat_emit("    (local.set $")
  wat_emit(local_name)
  wat_emit(" (v128.const f32x4 0 0 0 0))\n")
  emit_simd_replace_lanes(lanes, 0, local_name)
  wat_emit("    (local.get $")
  wat_emit(local_name)
  wat_emit(")\n")
}

// Place each branch result into lane i. The wasm SIMD instruction
// `f32x4.replace_lane i` takes (v128, f32) → v128 with lane i overwritten;
// reading the running accumulator keeps the prior lanes. Bounded at 4 lanes
// (the f32x4 width) — a fanout wider than the lane vector overflows the
// representation, an upstream repr/arity check, never a fabricated wider op.
fn emit_simd_replace_lanes(lanes, i, local_name) = if len(lanes) == 0 {
  ()
} else {
  wat_emit("    (local.set $")
  wat_emit(local_name)
  wat_emit(" (f32x4.replace_lane ")
  wat_emit(int_to_str(i))
  wat_emit(" (local.get $")
  wat_emit(local_name)
  wat_emit(")\n")
  emit_expr(last(lanes))
  wat_emit("    ))\n")
  emit_simd_replace_lanes(drop_last(lanes), i + 1, local_name)
}
