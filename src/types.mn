// types.mn — THE vocabulary of Mentl
//
// Every ADT the compiler names. Every effect signature every module
// shares. This file is bedrock — it imports nothing; every other
// module imports it. Its surface is the narrowest possible surface
// that empowers every peer.
//
// ─── The empowerment contract ──────────────────────────────────────
// types.mn owns ONLY shared vocabulary. Every foreign-owned ADT lives
// at its natural owner:
//
//   graph.mn (spec 00)   → chase / occurs / trail revert / graph_handler
//   effects.mn (spec 01) → row algebra (normalize / subsumes / unify)
//   clock.mn (spec 11)   → Clock / Tick / Sample / Deadline + IterContext
//   own.mn (spec 07)     → affine_ledger handler arms, escape check
//   verify.mn (spec 02)  → verify_ledger handler arms
//   mentl.mn (spec 09)   → Capability / Patch / Context + Teach + Synth
//                          + mentl_default (the Annotation a suggestion
//                          carries, and the Teaching it answers with, live
//                          here beside the CursorView that reads them)
//   query.mn (spec 08)   → Question / QueryResult + query_default handler
//
// TVar(id) is a HANDLE into Graph. There is no apply(subst, ty).
// Graph chase (perform graph_chase) replaces any subst-apply pattern.
// The graph IS the subst.
//
// HEAP_BASE = 4096 — substrate invariant (HB / nullary-sentinel).
// The bump allocator's $heap_ptr starts at 1048576 (1 MiB).
// Sentinel values for nullary ADT variants live in [0, HEAP_BASE);
// every heap allocation is ≥ HEAP_BASE. Mixed-variant match
// dispatch in backends/wasm.mn uses this threshold to discriminate
// sentinel from pointer. Bool is the canonical example:
// `type Bool = False | True` — False=0, True=1, both sentinels.
type Ty
  = TInt
  | TFloat
  | TUnit
  // the packed sequence ELEMENT-slot leaf: a
  //   byte VALUE is a word (repr RI32, arithmetic
  //   is Int), but its SLOT stride in a packed
  //   sequence is 1 — so [byte] (TList(TByte),
  //   the §4① String) folds distinctly from
  //   [Int] and lowers to load_i8/store_i8. The
  //   value/slot split is the novel move: Rust's
  //   u8 conflates them. Dead vocabulary until
  //   String = TList(TByte) (the RI64/RF32
  //   gradient-arm precedent — a trigger, not a
  //   new scalar).
  | TByte
  // the ADDRESS: a word that names memory, what `alloc` and the raw
  //   memory ops answer. A word in every machine respect (repr RI32,
  //   compared by identity, ordered unsigned) and not a number — its
  //   arithmetic is `addr_at`, never `+`. The type is what tells an
  //   arena's exit the word points somewhere, so a young one found where
  //   the exit looks keeps the region instead of dangling (lower.mn
  //   `evac_of`).
  | TAddr
  | TList(Ty)
  | TTuple([Ty])
  // params, return, effects
  | TFun([TParam], Ty, EffRow)
  // handle into Graph
  | TVar(Int)
  // nominal type + type args (Bool lives here)
  | TName(String, [Ty])
  // [(name, Ty)]
  | TRecord([(String, Ty)])
  // fields + row-variable handle
  | TRecordOpen([(String, Ty)], Int)
  // refinement type (Verify discharges)
  | TRefined(Ty, Predicate)
  // the representation PIN (SYNTAX §"Representation-pinned alias" +
  // the bare-width param `s: f32`): a gradient INPUT wrapping the
  // value type — `type Cents = Int repr i64` widens the word floor,
  // `f32` narrows the float default. Transparent to unification
  // (representation is never identity); repr_of reads it as the
  // authored width.
  | TReprPin(Repr, Ty)
  // handler continuation R -> S: resume input, answer, cardinality, and the effect-WORLD it was frozen under (the modal-effect lexical-capability set — !E lifted to the TIME axis; a persisted resume under a changed handler-set is a row unification -> E_ResumeWorldMismatch, never a silent memcpy'd miscompile)
  | TCont(Ty, Ty, ResumeDiscipline, EffRow)
  // RN.1 — authored alias name (e.g. "Port") wrapping resolved type
  | TAlias(String, Ty)

// A name that resolves to a constructor where it stands — the env's own
// answer, never a guess read off the name's first letter.
fn constructor_named(name: String) = match env_lookup(name) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      ConstructorScheme(_, _) => true,
      _ => false,
    },
  },
  None => false,
}

// ─── The variant specs AT AN INSTANTIATION ───────────────────────────
//
// The DECLARED payload types with the type's own parameters replaced by the
// arguments the graph proved at this use. `Some`'s declared payload is the
// quantified var `a`, and every emit-side reader that took the declaration at
// its word then compared, rendered, hashed and laid out a payload it could not
// see. MEASURED 2026-09-18, three faces of the one read:
//   `Some(BInt(7)) == Some(BInt(7))`  answered FALSE — the payload compared by
//                                     address, while the monomorphic
//                                     `BInt(7) == BInt(7)` was right
//   `"{Some(BInt(7))}"`               rendered `Some(1048584)` — the address
//   `let a = Some(1.5)`               never assembled: the binder's local was
//                                     declared at the declared width and read
//                                     at the proven one (`unknown local $v.f64`)
// The first two are silent and the third is loud, which is the usual order:
// the loud one is the same defect with a width behind it.
//
// A type with NO arguments grounds to itself, so every monomorphic ADT reads
// exactly what it read before and the emit does not move for it.
//
// The same read is a CONTRACT's at its constructor's fields: `Option(Positive)`
// grounds `Some`'s payload to `Positive`, which is what a value built with
// `Some` owes where it is claimed and what a pattern over it may assume
// (verify.mn `contract_part`). It lives here, below lowering, because the
// judgment reads it too.
//
// This is not a second copy of `subst_ty`. That one FRESHENS — every
// quantified var to a fresh var of its own domain — and its mapping is
// var→var precisely because it serves ROW vars too, which have no `Ty` form.
// This one GROUNDS, var→Ty, over the type arguments a nominal application
// carries. Forcing the two into one walk would need a sum over codomains on
// the compiler's hottest path to buy nothing; they are two operations.
fn variant_specs_at(applied) = map(drop_variant_name, variant_named_specs_at(applied))

fn drop_variant_name(spec) = match spec {
  (t, _, tys) => (t, tys),
}

// The same read carrying each variant's constructor NAME — show prints it.
fn variant_named_specs_at(applied) = match applied {
  TName(name, args) => match env_lookup_variants(name) {
    Some(entry) => match entry {
      (binding, _r, kind) => match kind {
        TypeVariants(specs) => if len(args) == 0 { specs } else { map(ground_variant_spec(type_params_of(binding), args), specs) },
        _ => [],
      },
    },
    None => [],
  },
  _ => [],
}

fn spec_named(cname: String, spec) = match spec {
  (_, n, _) => n == cname,
}

// The declared parameters, read from the type's own RESULT form: the entry's
// binding is `Frozen` over the result `TName(name, params)`, so the params
// stand in exactly the positions the applied arguments do. Reading them from
// the result rather than from the quantifier keeps the correspondence
// positional by construction — a quantifier is a SET, and a set has no
// positions.
// Matched at `Frozen` directly rather than through `judgment_ty`: a
// TypeVariants entry is registered Frozen at its own declaration, and going
// through the general reader would drag generalize's whole row — including
// WASI — into every emit-side payload read for a shape that cannot occur.
fn type_params_of(binding) = match binding {
  Frozen(_, ty) => match ty {
    TName(_, params) => params,
    _ => [],
  },
  Live(_) => // A Live binding here would mean the entry came from somewhere the
  // registration does not reach; inventing parameters for it is the
  // fabrication this whole read exists to end, so it grounds nothing.
  [],
}

fn ground_variant_spec(params, args, spec) = match spec {
  (t, cn, tys) => (t, cn, map(ground_ty(params, args), tys)),
}

// Replace each parameter var with the argument standing in its position.
// H6-exhaustive over Ty: a constructor added here without an arm is a compile
// error rather than a silently un-grounded payload.
//
// A `TFun`'s effect row and a `TCont`'s world pass through: a nominal type's
// arguments are TYPES, so a row parameter is not constructible at this
// boundary today. When it is, the row grounds through the same positions
// (`Hβ.types.nominal-row-parameter`).
fn ground_ty(params, args, ty) = match ty {
  TVar(h) => ground_var(params, args, h, ty),
  TList(elem) => TList(ground_ty(params, args, elem)),
  TTuple(elems) => TTuple(map(ground_ty(params, args), elems)),
  TName(n, as_applied) => TName(n, map(ground_ty(params, args), as_applied)),
  TRecord(fields) => TRecord(map(ground_field(params, args), fields)),
  TRecordOpen(fields, v) => TRecordOpen(map(ground_field(params, args), fields), v),
  TFun(ps, ret, eff) => TFun(map(ground_param(params, args), ps), ground_ty(params, args, ret), eff),
  TRefined(base, pred) => TRefined(ground_ty(params, args, base), pred),
  TReprPin(r, base) => TReprPin(r, ground_ty(params, args, base)),
  TAlias(n, inner) => TAlias(n, ground_ty(params, args, inner)),
  TCont(input, answer, d, world) => TCont(ground_ty(params, args, input), ground_ty(params, args, answer), d, world),
  TInt => ty,
  TFloat => ty,
  TUnit => ty,
  TByte => ty,
  TAddr => ty,
}

fn ground_field(params, args, field) = match field {
  (n, fty) => (n, ground_ty(params, args, fty)),
}

fn ground_param(params, args, p) = match p {
  TParam(n, pty, authored, resolved, dflt, g) => TParam(n, ground_ty(params, args, pty), authored, resolved, dflt, g),
}

// The argument standing in this var's position. Keyed by the union-find ROOT
// on both sides — a parameter var aliased since the declaration is still that
// parameter, the same reason `subst_ty`'s own lookup is root-keyed. A var that
// is not a parameter stays itself: a payload may carry vars the type does not
// quantify, and inventing a grounding for one would be the fabrication this
// whole read exists to end.
fn ground_var(params, args, h, ty) = match find(param_at_root(h), enumerate(params)) {
  Some(hit) => match hit {
    (i, _) => if i < len(args) { list_index(args, i) } else { ty },
  },
  None => ty,
}

fn param_at_root(h, indexed) = match indexed {
  (_, p) => match p {
    TVar(ph) => graph_chase_handle(ph) == graph_chase_handle(h),
    _ => false,
  },
}

// ─── A cell holds a SHAPE ────────────────────────────────────────────
// A refinement is a fact about a VALUE, read along the edges the value
// flowed through (verify.mn's value walk) — never a property of a
// unification class. Union-find merges every value a join can take and
// every operand an operator meets, so a refinement written into a cell is
// claimed for values that never earned it: `x - 1` over `x: Positive` was
// typed Positive, and so was `if c { n } else { 0 }` (P0, 2026-10-01).
// graph_bind writes this projection. A function type's interior is a
// CONTRACT — its parameters' preconditions and its declared postcondition —
// and rides whole: a call through a function value is judged against it.
fn shape_of(ty) = if ty_carries_refinement(ty) { shape_strip(ty) } else { ty }

fn ty_carries_refinement(ty) = match ty {
  TRefined(_, _) => true,
  TAlias(_, inner) => ty_carries_refinement(inner),
  TReprPin(_, base) => ty_carries_refinement(base),
  TList(e) => ty_carries_refinement(e),
  TTuple(es) => any(ty_carries_refinement, es),
  TName(_, args) => any(ty_carries_refinement, args),
  TRecord(fs) => any(field_carries_refinement, fs),
  TRecordOpen(fs, _) => any(field_carries_refinement, fs),
  TCont(r, s, _, _) => ty_carries_refinement(r) || ty_carries_refinement(s),
  TFun(_, _, _) => false,
  TVar(_) => false,
  TInt => false,
  TFloat => false,
  TUnit => false,
  TByte => false,
  TAddr => false,
}

fn field_carries_refinement(f) = match f {
  (_, t) => ty_carries_refinement(t),
}

// An alias whose inner carries a refinement names that refinement, so its
// shape is the stripped inner and the name goes with the predicate; a pin
// keeps its width, which is representation and not a fact about values.
fn shape_strip(ty) = match ty {
  TRefined(base, _) => shape_of(base),
  TAlias(_, inner) => shape_of(inner),
  TReprPin(w, base) => TReprPin(w, shape_of(base)),
  TList(e) => TList(shape_of(e)),
  TTuple(es) => TTuple(map(shape_of, es)),
  TName(n, args) => TName(n, map(shape_of, args)),
  TRecord(fs) => TRecord(map(shape_field, fs)),
  TRecordOpen(fs, v) => TRecordOpen(map(shape_field, fs), v),
  TCont(r, s, d, w) => TCont(shape_of(r), shape_of(s), d, w),
  TFun(_, _, _) => ty,
  TVar(_) => ty,
  TInt => ty,
  TFloat => ty,
  TUnit => ty,
  TByte => ty,
  TAddr => ty,
}

fn shape_field(f) = match f {
  (n, t) => (n, shape_of(t)),
}

// ─── Representation — the value-representation gradient (STEP 0) ─────
// Repr is the SHARED READ all four deep axes ride: the cursor's answer
// to "how wide, and in what machine class, does this Ty's value live?"
// It is a PROJECTION of the type the graph already proved — never a
// re-derivation from arity (the i32-from-arg-count floor is the
// Carried-Truth violation STEP 1 deletes). `repr_of` is structurally a
// peer of the WAT value-type rendering, but it is the FULL gradient: a
// handle IS a 32-bit word, so every pointer-kind AND the unresolved floor
// share RI32 (the pointer-representation and the productive-under-error
// floor are ONE fact). RF64 is TFloat's inferred default, read through
// `repr_wat` at the emit sites that need a width.
// The pinned classes (RI64 / RF32 / RV128) are reachable once STEP 1
// lands their gradient-INPUT surface (the `repr <width>` pin, a
// fixed-point refinement, a homogeneous lane-sequence) — present here as
// arms so STEP 1 ADDS a trigger, never a new type.
// The sequence REPRESENTATION — the fact unification erases and every
// runtime helper re-derives (load tag_word; branch). Minted at the
// construction the graph already knows (a literal is flat, `++` is a rope,
// push is snoc, slice is a view), carried through local bindings by the
// LowerScope edge ls_bind_local already draws, JOINED at control merges
// (equal reps survive; a genuine merge widens to SRUnknown — the honest
// floor where the tag branch is real information). Consumers read it as a
// license: a proven rep turns a runtime dispatch back into the direct
// form, per receiver — the proof becomes the dispatch at the value layer.
type SeqRep = SRFlat | SRSnoc | SRRope | SRSlice | SRUnknown

type Repr
  // 32-bit word: TInt/TBool/TUnit/nullary-tag AND every
  //   pointer-kind (string/list/tuple/record/fun/cont) AND
  //   the unresolved-TVar floor (a handle is a 32-bit word)
  = RI32
  // 64-bit int: `repr i64` pin / fixed-point refinement /
  //   a literal exceeding i32 range (STEP 1 trigger)
  | RI64
  // 64-bit float: TFloat's inferred default (the live decider)
  | RF64
  // 32-bit float: TFloat pinned `repr f32` (STEP 1 trigger)
  | RF32
  // 128-bit lane vector: a homogeneous fixed-width
  //   lane-sequence (STEP 1 / STEP 4 SIMD cashout)
  | RV128

// A SYMBOL'S EMITTED SIGNATURE — the param repr-vector and the result repr,
// the two facts a `(func $name (param ...) (result ...))` header states and
// every call to it must speak. It is ONE fact about ONE symbol, and its home
// is the sigs column (graph_sig_at): decided once at the emit settling point,
// read by the header, the call sites, the word-face wrapper, and the local
// decls. An ABI is a contract, and a contract with two derivations is two
// contracts — which is what the six re-derivations this type retires were:
// each carried a comment asserting the readers "agree", and the agreement was
// coincidence (the caller read the declared scheme, the callee read its body's
// use-sites, the wrapper read both again at module scope, outside the twin
// bracket the header was emitted under). The repr-vector is also the
// call_indirect type key (§5.U STEP 1 — a function type IS a product), so
// this is the interned signature the $ftN fork dissolved into.
type EmitSig = ESig([Repr], Repr)

// repr_of — the SHARED READ (STEP 0). The cursor projects a Ty to its
// machine-representation class. H6-exhaustive over every Ty constructor.
// Alias-strip / refinement-unwrap FIRST (TAlias -> inner, TRefined -> base):
// representation is a property of the underlying value, not the authored
// name or the predicate, so we recurse into the carried type. A bare TVar
// (lookup_ty already chased the top-level chain to root, so this is a
// genuinely-unresolved handle) reads RI32 — a handle IS a 32-bit word, and
// the unresolved floor IS the pointer representation (productive-under-error:
// the value still occupies one word). Every pointer-kind (string, list,
// tuple, record, fun, cont, variant — a tag is a word) is RI32. TFloat is
// the one non-word default => RF64 (the live decider ty_to_wasm_type leaves
// unreached today). RI64/RF32/RV128 are reachable only when STEP 1's
// gradient-INPUT pins land — no arm fabricates them from the current Ty, so
// the existing i32/f64 emit paths stay byte-identical (LAW 7).
fn repr_of(ty) with Pure = match ty {
  TAlias(_, inner) => repr_of(inner),
  TRefined(base, _) => repr_of(base),
  TReprPin(r, _) => // the authored width IS the answer — the pin is the STEP-1
  // gradient input this projection's own comment always named
  r,
  TFloat => // inferred default; STEP 1's `repr f32` pin yields RF32
  RF64,
  TInt => // STEP 1's `repr i64` pin / fixed-point / i64-literal yields RI64
  RI32,
  TUnit => RI32,
  TByte => // a byte VALUE is a word (arithmetic is Int); the
  //   1-byte packing is a SLOT stride, not a value repr
  RI32,
  TAddr => // an address is a word (wasm32's memory index)
  RI32,
  TList(_) => // pointer (STEP 1/4: a fixed-width lane-sequence pins RV128)
  RI32,
  TTuple(_) => // pointer
  RI32,
  TFun(_, _, _) => // table index / closure ptr
  RI32,
  TVar(_) => // genuinely-unresolved handle — a 32-bit word
  RI32,
  TName(_, _) => // variant pointer (Bool lives here — a tag is a word)
  RI32,
  TRecord(_) => // record pointer
  RI32,
  TRecordOpen(_, _) => // record pointer
  RI32,
  TCont(_, _, _, _) => // continuation pointer
  RI32,
}

// repr_width — the byte width of a representation class, by ADT match
// (never `== 4`/`== 8` — drift mode 8). STEP 1's resolve_field_offset
// prefix-sums this over a record's sorted fields; RV128 lanes pad to 16.
fn repr_width(r) with Pure = match r {
  RI32 => 4,
  RI64 => 8,
  RF64 => 8,
  RF32 => 4,
  RV128 => 16,
}

// A representation above the word floor — the class a word-signed boundary
// carries by reference (a box), and the one a twin's key may not move at a
// face it does not convert.
fn repr_is_wide(r) with Pure = match r {
  RI32 => false,
  RI64 => true,
  RF64 => true,
  RF32 => true,
  RV128 => true,
}

// stride_of — the byte STRIDE of a sequence's element SLOT, the axis below
// repr_of. A TByte element packs 1 byte (the §4① String's byte face; a byte
// VALUE stays a word, but its slot is 1); every other element occupies a full
// repr_width slot. This is where "the proof becomes the dispatch" lands for
// sequence access: list_index/list_set/alloc_list read stride_of(elem) to emit
// load_i8 vs load_i32 and to size the buffer — the packed/word distinction the
// String=[Byte] unification rides. Dead until the element-repr-dispatched leaf
// reads it (the RI64/RF32 gradient-arm precedent — a trigger, not a live path).
fn stride_of(elem_ty) with Pure = match elem_ty {
  TByte => 1,
  _ => repr_width(repr_of(elem_ty)),
}

// stride_class — the ZERO-BIASED carrier codec, EMIT side: the stride-code the
// emit packs into a byte/float sequence's tag word (stride_class(stride_of(elem))
// feeds make_list_sc / the data-section header). The bias is load-bearing: sc 0
// => stride 4 (Int/handle/pointer — the FREE word default every existing list
// already writes as tag 0), so `pack_tag(0, 0) == 0` and the whole i32/handle
// world is byte-identical; only a byte (sc 1) or a packed float (sc 2/3) writes a
// nonzero code. Mirrors repr_of (RI32 the free floor; RI64/RF64/RF32/RV128 the
// gradient triggers) one axis down: the element SLOT stride, not the VALUE repr.
// The RUNTIME inverse (`decode_stride`, sc => stride) lives in lib/
// lists.mn beside the readers that consume it — the RTLIBS blob has no src/.
fn stride_class(stride) with Pure = match stride {
  4 => 0,
  1 => 1,
  8 => 2,
  16 => 3,
  2 => 4,
  _ => // drift-audit: ignore — the word class IS stride 4; any unlisted stride is word-classed by definition, not a fabricated default
  0,
}

// repr_wat — the WAT value-type token for a representation class. STEP 1's
// emit slots project `repr_wat(repr_of(lookup_ty(handle)))` instead of
// re-deriving i32 from arity. ty_to_wasm_type (backends/wasm.mn) is the
// first reader: it becomes `ty |> repr_of |> repr_wat`.
fn repr_wat(r) with Pure = match r {
  RI32 => "i32",
  RI64 => "i64",
  RF64 => "f64",
  RF32 => "f32",
  RV128 => "v128",
}

// ─── The structural FOLD's shared skeleton: strip + signature ─────────────
// ==/compare/hash/show/pack/unpack are ONE fold over the five node-kinds; the
// LEAF is the only degree of freedom. fold_strip and fold_sig are the two
// type-level reads EVERY leaf shares, so they live here — the type ontology's
// home — not in any single backend (the eq leaf was the first reader; show /
// compare / hash / pack join it, reading the SAME structural name). This is the
// Carried-Truth home: a type's fold-signature is a property OF THE TYPE.
//
// fold_strip — alias-strip / refinement-unwrap FIRST (TAlias->inner,
// TRefined->base), structurally identical to repr_of's prologue. A Port-style
// (= Int) folds as Int; a `Sample` (= Float where ..) folds as Float. The
// predicate is erased at runtime, so the leaf reads the underlying value.
// ─── ArithOperand — what arithmetic can do with an operand, off its type ──
// The ONE classification the judgment reads at the operator and at the one
// writer of a gated cell (NumericGate), and the emit reads under the twin
// bracket. A word carries the instruction at its repr; a variable is
// unproven HERE and carries its handle out, so the judgment can gate the
// cell it names; everything else is an aggregate the value ontology gives
// no arithmetic — the operands are addresses, and `{x: 1} * {x: 2}`
// multiplied them with zero diagnostics until 2026-09-27
// (Hβ.emit.arith-on-aggregate-is-pointer-arith). A user type's arithmetic
// arrives as a numeric projection's rules
// (Hβ.lower.ad-is-a-demanded-projection), never as pointer arithmetic.
type ArithOperand = AoWord | AoUnproven(Int) | AoAggregate

fn arith_operand_class(ty) = match ty {
  TInt => AoWord,
  TFloat => AoWord,
  TByte => AoWord,
  TVar(h) => AoUnproven(h),
  TAlias(_, inner) => arith_operand_class(inner),
  TRefined(base, _) => arith_operand_class(base),
  TReprPin(_, base) => arith_operand_class(base),
  TAddr => // a word, but not a number: its operands are addresses as surely
  // as an aggregate's are, and it moves with `addr_at`
  AoAggregate,
  TUnit => AoAggregate,
  TList(_) => AoAggregate,
  TTuple(_) => AoAggregate,
  TFun(_, _, _) => AoAggregate,
  TName(_, _) => AoAggregate,
  TRecord(_) => AoAggregate,
  TRecordOpen(_, _) => AoAggregate,
  TCont(_, _, _, _) => AoAggregate,
}

fn fold_strip(ty) with Pure = match ty {
  TAlias(_, inner) => fold_strip(inner),
  TRefined(base, _) => fold_strip(base),
  TReprPin(_, base) => // Identity is the base's; the WIDTH rides repr_of's own TReprPin arm
  // (annotation, not type — §4①). When a wide-int producer lands, band D's
  // fold_sig-reads-repr decision reopens here (a pinned-i64 field must not
  // share the i32 "i" helpers) — today RF64-on-Float is the one live pin
  // and its sig equals the base's.
  fold_strip(base),
  _ => // §4①: a String folds AS its byte-sequence, so fold_sig on it derives "lb" ==
  // fold_sig(TList(TByte)) and a String field and a [byte] field share the one
  // generated `$eq_<sig>`/`$hash_<sig>`/`$show_<sig>` helpers at sig "lb" —
  // the eq/hash-divergence footgun unsayable.
  ty,
}

// fold_sig — a deterministic structural name for a type: the dedup key and the
// generated helper-name suffix (the SAME suffix every leaf's $<leaf>_<sig> uses).
// Two types share a sig iff they fold identically (the same structural-eq the
// cursor derives for records — the proof IS the name). Alias/refinement-stripped
// first, like every other fold-through.
fn fold_sig(ty) = sig_of(ty, "i")

// The name of what an arena's exit moves: a variable the type still holds is
// OPAQUE, never a word. A leaf moving `[(Int, a)]` shares nothing with the one
// moving `[(Int, Int)]` — the first must refuse a young value in its second
// field, the second never looks — and a twin keyed by a move is keyed the same
// way. The word reading shared them, and the exit left a pointer behind in the
// region it zeroed (2026-10-03: the compiler's own judgment trapped reading a
// demand list the exit had reclaimed).
fn move_sig(ty) = sig_of(ty, "o")

fn sig_of(ty, var_sig: String) = match fold_strip(ty) {
  TInt => "i",
  TFloat => "d",
  TUnit => "u",
  TByte => // packed 1-byte slot — distinct from "i" so
  //   [byte] and [Int] never share a fold helper
  "b",
  TAddr => // an address orders unsigned and moves opaque — never "i"'s helpers
  "a",
  TVar(_) => // unresolved handle — a word to every fold leaf, opaque to a move
  var_sig,
  TList(elem) => "l{sig_of(elem, var_sig)}",
  TName(n, args) => // Nominal — the name carries identity, AND the arguments carry the rest of
  // it. This arm read `"n{n}"` and dropped `args` until 2026-09-18; its
  // comment said "name carries identity", which is true of a nullary nominal
  // type and false of an applied one. `Option(Int)`, `Option(String)` and
  // `Option(Boxed)` shared ONE generated helper, which therefore could not
  // know which it served and compared, rendered and hashed its payload as a
  // word — an ADDRESS for anything boxed. Every sibling arm here already
  // folds its payload; this one now does too, so each instantiation names
  // its own leaf, exactly as total monomorphization twins a function per the
  // types its call sites prove. A type with no arguments renders as it always
  // did, so every monomorphic ADT keeps its helper name.
  if len(args) == 0 { "n{n}" } else { "n{n}{sig_list(args, var_sig)}_" },
  TTuple(elems) => "t{sig_list(elems, var_sig)}_",
  TRecord(fs) => "r{sig_fields(fs, var_sig)}_",
  TRecordOpen(fs, _) => "r{sig_fields(fs, var_sig)}_",
  TFun(_, _, _) => // closure — folds at the function leaf
  "fn",
  TCont(_, _, _, _) => // continuation pointer — a word here
  // fold_strip already removed TAlias/TRefined; reaching them is impossible.
  "k",
  TAlias(_, inner) => sig_of(inner, var_sig),
  TRefined(base, _) => sig_of(base, var_sig),
  TReprPin(_, base) => sig_of(base, var_sig),
}

fn sig_list(elems, var_sig: String) = fold("", sig_elem(var_sig, ??, ??), elems)

fn sig_elem(var_sig: String, acc: String, t) = "{acc}_{sig_of(t, var_sig)}"

fn sig_fields(fields: [(String, Ty)], var_sig: String) =
  fold("", sig_field(var_sig, ??, ??), fields)

fn sig_field(var_sig: String, acc: String, field) = match field {
  (name, ty) => "{acc}_{name}{sig_of(ty, var_sig)}",
}

// ─── Ownership (spec 02 · spec 07) ─────────────────────────────────
// Every function parameter wraps Ty with an Ownership marker.
// Inference fills unmarked parameters; Own/Ref are explicit commitments.
type TParam = TParam(String, Ty, Ownership, Ownership, Option(Node), EffRow)

// name, ty, authored, resolved, default, row
// OW.2 — authored = what developer typed (Own/Ref/Unmarked)
//        resolved = what infer_ownership determined
// default = Some(expr_node) when the param has a
//   trailing `= expr` (SYNTAX.md §«Default parameter
//   values»); None otherwise. The default node lives
//   in the graph (parser-minted); lower fills an
//   absent call-site arg edge by projecting it in the
//   callee's scope — the default has ONE home (this
//   slot) and one eval context (the callee). A
//   defaulted slot leaves a DefaultReason edge.
// row = what the parameter's PRECONDITION guards: the
//   row a call pays when its argument's claim against
//   the parameter is not proven there. A declared fn's
//   parameter carries a row cell born at its
//   declaration and filled at its exit (a division the
//   precondition proved total guards `Trap`); a
//   parameter with no precondition guards nothing. The
//   first face of the param-as-{type, row} projection
//   named below.
type Ownership
  // compiler decides (default)
  = Unmarked
  // affine: consumed at use (performs Consume)
  | Own
  // borrowed: cannot escape return position
  | Ref

// How a branch frame's arms relate at runtime — the affine ledger reads it
// at branch_exit to decide whether consuming one name in two arms is a
// violation. `><` / `<|` run every branch (BParallel), so a name consumed
// in two IS a double-consume; `if` / `match` run exactly ONE arm
// (BAlternative), so consuming a name across arms is a single consume on
// whichever path is taken — the arms UNION, never collide.
type BranchMode
  // >< / <| — all arms execute; cross-arm consume is a collision
  = BParallel
  // if / match — one arm executes; cross-arm consume unions
  | BAlternative

// ─── TParam projections — the §2 'project' operation made literal ──
// A param is a PRODUCT node CARRIED whole; every aspect is read through
// a TOTAL named projection defined ONCE here, never a positional
// destructure at a consumer (THE CARRIED-TRUTH LAW — §4①: a product's
// fields are projections read live). The single destructure of the
// 6-tuple lives in each function below; reviewed once against the decl
// (TParam(name, ty, authored, resolved, default, row) = slots 0..5).
//
// Consumers split into three roles:
//   LEAF       — read one aspect via param_{name,ty,authored,resolved,default,row}
//   PROPAGATOR — transform one aspect via param_with_ty / param_with_resolved,
//                which carry the other five BY CONSTRUCTION (dropping a
//                sibling field becomes unsayable — it is never named)
//   PRODUCER   — mint via mk_param (the inferred/synthetic shape: no
//                authored aspect, no default, a row that guards nothing)
//
// Deepening (NAMED, sequenced post-first-light — §4⑤): a param projects to
// {type, row} — ownership IS a Consume in the param's ROW, refinement IS a
// refined type — and the tuple DISSOLVES. The row slot is that projection's
// first face (P0, 2026-10-01): it carries what the precondition guards, and
// ownership's Consume joins it when the tuple goes. These accessor bodies
// are the collapse's larval seam: the {type,row} form swaps behind them
// with no consumer touched (peer Hβ.types.param-projects-to-type-row).
fn param_name(p) = match p {
  TParam(n, _, _, _, _, _) => n,
}

fn param_ty(p) = match p {
  TParam(_, t, _, _, _, _) => t,
}

// The same read as a PRESENT signature slot (EmitFnEntry above): a declared
// parameter always has a type, so lifting it is a fact, never a guess — the
// absent form belongs to the slots that carry no parameter at all.
fn some_param_ty(p) = Some(param_ty(p))

fn param_authored(p) = match p {
  TParam(_, _, a, _, _, _) => a,
}

fn param_resolved(p) = match p {
  TParam(_, _, _, r, _, _) => r,
}

fn param_default(p) = match p {
  TParam(_, _, _, _, d, _) => d,
}

fn param_row(p) = match p {
  TParam(_, _, _, _, _, g) => g,
}

// The row of a parameter with no precondition: it guards nothing, so a call
// pays nothing for it whatever its argument is. One value, built once.
let no_guard_row = EfRow([], [], EtClosed)

fn guards_nothing() with Pure = no_guard_row

// The one move-vs-borrow read of a param product: TRUE where a call site
// borrows its arg. Authored Ref borrows; authored Own moves; an Unmarked
// param goes by its resolved grade — Ref borrows, Own moves, and a
// still-Unmarked slot (a not-yet-graded forward/self reference, or a
// genuinely unused param) BORROWS: the read-safe default. The consume
// default here made decl ORDER load-bearing — set_contains calls its
// textually-later helper, so its own param graded Own and every caller
// moved its set (the wheel's visited conviction, 2026-08-07). Both the
// arg walk's borrow bracket (infer_call_arg) and the ownership grade's
// mode walk (own.mn's usage_of) read this one test — one home.
fn param_borrows(p) = match param_authored(p) {
  Ref => true,
  Own => false,
  Unmarked => match param_resolved(p) {
    Ref => true,
    Own => false,
    Unmarked => true,
  },
}

// Structure-preserving updaters for PROPAGATORS — carry the other five.
fn param_with_ty(p, t) = match p {
  TParam(n, _, a, r, d, g) => TParam(n, t, a, r, d, g),
}

fn param_with_resolved(p, r2) = match p {
  TParam(n, t, a, _, d, g) => TParam(n, t, a, r2, d, g),
}

fn param_with_row(p, g2) = match p {
  TParam(n, t, a, r, d, _) => TParam(n, t, a, r, d, g2),
}

// Smart constructor for inferred/synthetic PRODUCERS — no authored aspect,
// no precondition.
fn mk_param(name, ty) = TParam(name, ty, Unmarked, Unmarked, None, guards_nothing())

// ─── Resume discipline (spec 02 · Affect POPL 2025) ────────────────
// Continuations discriminated at the type level so handler elimination
// (spec 05) and multi-shot × arena (Arc F.4) have the type hook. The
// discipline is INFERRED — infer computes each arm's resume `Usage`
// grade (below) and JOINS it onto the op's EffectOpScheme; lower
// PROJECTS it at the resume site (OneShot → the ~85% direct-return
// floor, MultiShot → the reified heap continuation). There is no
// @resume= annotation; the body IS the contract per
// PLAN §2. The write is inference's (the
// one writer), read live by lower — never a second hand-walk at lower.
type ResumeDiscipline
  = OneShot
  | MultiShot
  | Either
  // M4 — the arm NEVER resumes AND returns a meaningful value: it delivers that value as the INSTALL's, abandoning the continuation (a UZero grade over a concrete return; `abort() -> Option`). A dead continuation, so the perform yields with a dummy k and the remainder deadens — distinct from MultiShot (live k, off-spine unsupportable → floor) and OneShot (bottom/noreturn: `fail -> a`, no value to abandon)
  | Abandon

// ─── Usage — the coeffect multiplicity grade {0, 1, ω} ─────────────
// How many times a value is used, as a join-semilattice. THE shared
// use-count lattice of the medium: OWNERSHIP reads it on a param's
// VarRefs (own.mn classify_usage: 0/1/2+ → Unmarked/Own/Ref — arm 5)
// and RESUME CARDINALITY reads it through `ResumeUse` below — this
// multiplicity extended by the POSITION of the one use (at the arm's
// result, or interior), the same extension ownership's return-transfer
// makes; projected back here it reads 0/1/≥2 → OneShot/OneShot-or-
// reified/MultiShot (the TIME axis). One lattice, two projections: the
// continuation is just a value, and its multiplicity IS its ownership
// grade — `own`/consumed-once ↔ OneShot, `ref`/shared ↔ MultiShot. No
// other effect-handler language shares these (Koka / Effekt compute
// resumption multiplicity as a bespoke analysis); here they are one read
// of a value's use-count. `usage_seq` (⊗) composes sequentially — two
// uses on one path is UMany; `usage_join` (⊔) alternates — disjoint
// branches join, not add (only one branch runs), so a
// branch-and-resume-once arm keeps the OneShot fast path.
// (Ownership's own.mn grade reads the SAME lattice through usage_of's
// mode-paired walk — Hβ.infer.usage-grade-unifies-cardinality-ownership
// realized at §11 4.2: one lattice, two walks, this ADT their one home.)
type Usage = UZero | UOne | UMany

// The lattice's two composition ops, at the ADT's own home (both the
// resume classifier's walk in infer.mn and the ownership grade's walk in
// own.mn fold them; own cannot import infer, so the ops live beside the
// ADT they fold).
fn usage_seq(a, b) = match a {
  UZero => b,
  UMany => UMany,
  UOne => match b {
    UZero => UOne,
    _ => UMany,
  },
}

fn usage_join(a, b) = match a {
  UZero => b,
  UMany => UMany,
  UOne => match b {
    UMany => UMany,
    _ => UOne,
  },
}

// ─── ResumeUse — the resume classifier's grade: multiplicity × position ──
// A continuation is a value and `resume(v)` is its use. The count alone
// decided the representation until 2026-09-27, when the measurement was
// `handler dbl { ask() => { let r = resume(1); r * 2 } }` over `ask() + 1`
// answering 2 where the deep-handler contract says 4: the single use bound
// by `let` lowered as the stack return, so the code after it was dead and
// the install answered the remainder's own value
// (tests/micros/mn-oneshot-nontail-resume.mn). WHERE the one use sits
// decides whether the arm ever HOLDS the continuation: at the RESULT
// position of the arm (through if/match/block tails and a tail call into a
// resuming helper) the arm hands it straight back — the stack return; at an
// INTERIOR position (a let RHS, an operand, an argument, an element, a
// lambda body) the arm keeps computing after the remainder returns, so the
// remainder must exist as a record the arm can call — the reified path,
// called once. That is ownership's own distinction (a value returned is
// transferred; a value used inside is consumed), so this is the
// multiplicity lattice extended by the position mode: RNone/RTail/RDeep/
// RMany project onto Usage as UZero/UOne/UOne/UMany.
type ResumeUse = RNone | RTail | RDeep | RMany

// `a` then `b`, with `b` at the result position of the sequence: any use in
// `a` has code after it, so a tail use in `a` becomes a held one, and two
// uses on one path are many. Not symmetric — the fold that applies it runs
// in source order.
fn resume_seq(a, b) = match a {
  RNone => b,
  RMany => RMany,
  RTail => match b {
    RNone => RDeep,
    RTail => RMany,
    RDeep => RMany,
    RMany => RMany,
  },
  RDeep => match b {
    RNone => RDeep,
    RTail => RMany,
    RDeep => RMany,
    RMany => RMany,
  },
}

// Alternatives — exactly one branch runs, so the grades join, never add.
fn resume_join(a, b) = match a {
  RNone => b,
  RMany => RMany,
  RTail => match b {
    RNone => RTail,
    RTail => RTail,
    RDeep => RDeep,
    RMany => RMany,
  },
  RDeep => match b {
    RNone => RDeep,
    RTail => RDeep,
    RDeep => RDeep,
    RMany => RMany,
  },
}

// The value is consumed at an interior position — an operand, an argument,
// an element, a lambda body — so a tail use becomes a held one.
fn resume_interior(a) = match a {
  RNone => RNone,
  RTail => RDeep,
  RDeep => RDeep,
  RMany => RMany,
}

// ─── Binding (spec 04) — what the env holds (rung 3 landing A) ──────
// The env's slot carries a BINDING, no longer a scheme snapshot.
// `Frozen(qs, ty)` is a publisher's OWN decision carried verbatim — the
// quantifier lists are per-site judgment law (the SCC re-extend
// quantifies rows only; generalize's split shared row-sort cells; a
// single projection rule cannot serve both), so the site that made the
// decision keeps writing it. `Live(h)` is a judgment-published decl's
// graph CELL: the judgment writes the cell in place, a re-publish is a
// pointer write, and there is no materialized view to diverge — the
// trial/final movers' own source. What DELETED with this type is
// generalize's publication-time chase-materialization: the env no
// longer freezes a past view of a decl; consumers who need the
// quantifier of a cell project it at consumption (instantiate folds
// generalize's split rule for exactly that).
type Binding = Frozen([Int], Ty) | Live(Int)

// SchemeKind discriminates env entries by their CONSTRUCTION ORIGIN.
// Same Scheme shape, different downstream stories: lower dispatches on
// this — FnScheme → LDirectCall of the declared symbol, ValueScheme →
// LCall through the value, ConstructorScheme → LMakeVariant with a known
// tag_id, EffectOpScheme → LPerform with the declaring effect already
// attributed. The graph stores the distinction directly rather than
// re-deriving it from type shape.
//
// ConstructorScheme(tag_id, variant count):
//   tag_id is this variant's ordinal within its declaring type
//     (0-based, deterministic from declaration order).
//   the variant count is the total over the declaring type — enables
//     pattern-exhaustiveness as a graph read at infer_match_arms.
//
// EffectOpScheme(effect_name, default_handler, ambiguous, disc): the op
// binding IS the dispatch fact. effect_name is the declaring effect — read to
// know which effect this op participates in without re-inspecting the row.
// default_handler is the UNIQUE handler that declares an arm for this op,
// drawn as an edge at register_handler ("" until then); ambiguous is True
// once a SECOND distinct handler also declares it. lower reads them to cash
// a non-lexical perform of a uniquely-handled op to a direct call against
// the singleton's $<hname>_state_g home (never a threaded ev-slot copy —
// Carried-Truth); an ambiguous op threads evidence instead. disc is the op's
// resume cardinality — the JOIN of every handler arm's Usage grade (MultiShot
// iff some arm resumes twice on one path, else OneShot): the op-level join
// is SOUND for lowering every arm (never under-classifies a genuine
// multi-shot, which would truncate the continuation — the mn-multishot bug),
// and preserves the fast path for always-one-shot ops (the vast majority).
// Written by draw_op_edges, projected by lower's op_resume_discipline.
//
// EffectDeclKind(op_names) is the effect declaration itself.
// `env_lookup("Iterate")` reads this to know the effect's ops
// (["yield", "result"]) — the graph carries effect→ops so
// the world-chain dispatch resolves op→effect at perform sites,
// and the Cursor can project effect structure at any position.
//
// ParamScheme(authored) is a local parameter binding. VarRef inference reads it
// at the same env edge that resolved the name and passes authored ownership to
// Consume. Inferred ownership is written later into the owning TFun's params.
//
type SchemeKind
  // tag 0
  = FnScheme
  // tag 1
  | ConstructorScheme(TagId, Int)
  // tag 2 — (effect_name, default_handler, ambiguous, resume cardinality — the join over handlers' arm grades)
  | EffectOpScheme(String, String, Bool, ResumeDiscipline)
  // tag 3 — [(field_name, ty)]
  | RecordSchemeKind([(String, Ty)])
  // tag 5 — [op_name: String]  (cache byte 5; byte 4 retired with the dissolved capability)
  | EffectDeclKind([String])
  // tag 6 — (residual_row_handle, remainder_world_handle, config params [the fn-param carrier: name + default ride the TParam, names project via lower_param_names], state fields, arms). The remainder world is the row a held resume of this handler RUNS — the cell its arms' continuations carry as their world, never bound: callees reached through a resume gate it, and every install judges those gates against its own remainder (`remainder_gates_check`). Typed payloads: a bare List here erased the element types the consumers prove (the 581a92f class), and the pattern-constraint unification surfaces the conflict as E_TypeMismatch at every destructure.
  | HandlerKind(Int, Int, [TParam], [{init: Node, name: String}], [{args: [String], body: Node, op_name: String}])
  // tag 7 — parameter binding carries authored ownership at the env edge
  | ParamScheme(Ownership)
  // tag 8 — a named effect row (`type X = A + B`, SYNTAX §«Named effect
  // rows»): stores the with-clause's OWN signed triples — one grammar,
  // one representation (Hβ.types.named-effect-rows). An ENV fact only:
  // expansion happens where rows are built (build_declared_row's fold
  // recursively builds the alias's row WHOLE, so grouping holds by
  // construction); the row algebra never sees the name, and Ty never
  // carries it.
  | RowAliasKind([(EffName, Bool, EConn)])
  // tag 8 — the TYPE's own entry: (tag, ctor name, payload tys) per variant, minted at registration where the list is in hand — the variant_specs whole-env scan family's cure
  // HandlerKind (tag 6) is the full handler-effect type AND the handler's
  // identity: a handler is
  // (a ! E+r) ⟿ (a ! R+r) — it REMOVES the handled effect E AND
  // ADDS its arms' residual row (a live row var, config-polymorphic). `~>` reads it: row(expr ~> h) = (row(expr) − E) ⊕ R. Without R
  // the handler-attachment can't transform the row and every map/each loses
  // the effects performed in its arms.
  // The handled effect E is NOT stored: it is a PROJECTION of `arms` — each arm
  // handles an op, and the op's EffectOpScheme carries the effect that declared
  // it (§2 follow-the-edge). `derive_handler_ename(arms, hname)` reads it live at
  // every use; storing it here was a snapshot of a fact `arms` already holds
  // (Carried-Truth: read live, never copy). Realizes Hβ.infer.handler-effect-
  // name-is-live-edge.
  // ONE-GRAPH: the binding also carries the decl's (config, state, arms) — the
  // env NAMES the handler's node, so lower reads its arms/state LIVE here and
  // projects on demand (no registry, no pre-register pass). These are references
  // to the parsed decl (the one home), never copies. (config/state/arms are not
  // cache-serialized — live-only; cross-file handler caching reconstructs them
  // from the decl, peer Hβ.cache.handler-decl-from-source, post-L1.)
  | TypeVariants([(TagId, String, [Ty])])
  // A VALUE binding — a let, a pattern variable, a handler arm's argument
  // or state field: a name for a value computed at run time, never a
  // declared function's symbol. These were FnScheme until 2026-09-28, and
  // the difference is not a label: lower cashes a FnScheme callee into a
  // direct call of `$name`, and a module value holding a closure has no
  // such symbol (`let add3 = make_adder(3)` checked clean and did not
  // assemble). Two lower readers had already written "a value binding" and
  // "value schemes" as if this kind existed.
  | ValueScheme

// The Boolean algebra lives as functions in effects.mn; the ADT lives
// here so every module that speaks types can speak rows.
//
// THE ROW IS ONE CANONICAL TRIPLE — present, absent, tail — the
// Rémy-lineage presence/absence row fused with the crown's negation and
// the handler subtraction (the 2026-07-22 representation ruling; the
// a normalize-by-rewrite representation re-derived per read and
// DROPPED the `~>` subtraction from ungrounded tails — the fat-row
// root). The reading: row = present ∪ ⋃ (each edge's cell ∖ that edge's
// mask), and under EtAll present ∪ (everything ∖ absent). Every form is
// a point in this space:
//   Pure        = ([], [], EtClosed)
//   Closed(A)   = (A,  [], EtClosed)
//   Open(A, v)  = (A,  [], EtOpen([v−∅]))
//   !B          = ([], B,  EtAll)          — the negative capability
//   (A+v)−B     = (A∖B, [], EtOpen([v−B])) — the subtraction, on the EDGE
//                                            it filters and on no other.
// Subtraction is an EAGER LITERAL DIFFERENCE (the handled set is always a
// literal — the Elixir/Castagna lesson: lazy differences accumulate,
// literal differences reduce now). The absent field is the universe's mask
// under EtAll and the authored proof-of-absence record under EtClosed
// (`with Sample + !Sample(44100)`); under EtOpen it is empty, because a
// mask belongs to the path it was written on. It used to be one absent
// for the whole tail, and two edges cannot share one: `f() + ((g()) ~> h)`
// stored as `(r_f + r_g) − E`, erasing f's E (measured 2026-09-26 — the
// program compiled clean and trapped). Unification and subsumption are
// fieldwise set ops — no wrapper trees, no rewrite passes, no read-time
// re-derivation.
type EffRow = EfRow([EffName], [EffName], EffTail)

// present, absent, tail
type EffTail
  // nothing beyond the present set
  = EtClosed
  // the OPEN tail is a SET OF EDGES — row cells whose live content joins
  // into the reading, each minus its own mask. The set is sorted by cell
  // with one entry per cell (§4①'s one set representation); a cell met on
  // two paths keeps the INTERSECTION of their masks, since
  // (v ∖ m1) ∪ (v ∖ m2) = v ∖ (m1 ∩ m2). EtOpen([]) is EtClosed and
  // ef_make canonicalizes it away, so readers never meet the empty set.
  // Mints are singletons; MULTI-edge sets are born where two open tails
  // meet (the join), reads fold every edge, unify binds per edge, and find
  // treats a multi-edge cell as its own terminal. Sortedness is the
  // writers' invariant (tail_set_insert/union — effects.mn), so structural
  // == over two tails is set equality.
  | EtOpen([RowEdge])
  // the universe: anything EXCEPT the absent set — DEMAND-side only (an
  // authored anything-but constraint, the gate's transient universe-minus;
  // THE ETALL LAW, PLAN's settled laws): no publish, bind, or join may
  // store EtAll into an INFERRED row. A stored supply-side EtAll is a
  // census item at zero.
  | EtAll

// One edge of an open tail: the row cell, and the names subtracted on the
// path to it — the `~>` installs between this edge's performs and the row
// that reads them. The mask rides the edge through every fold, union,
// instantiation and chase, so a handler's absorption reaches exactly the
// computation it enclosed. A PRODUCT, not a sum: the record wrapper is the
// wheel's one-constructor idiom (SpinePage, EmitFnEntry), which carries no
// tag word — an edge is minted per open row, so the first form's tagged
// variant was a word per edge that said nothing.
type RowEdge = RowEdge({cell: Int, mask: [EffName]})

// A GATE is a constraint carried by a row CELL — the negation half of a
// declaration (`with !E` — `([], [E], EtAll)`, instance-aware through
// eff_forbids) or the empty closed cap (`with Pure`), with the Reason
// that declared it. It outlives the cell's binding: a gated cell that is
// bound, later taught (the join) or re-finalized is checked at every one
// of those writes, so the gate lives beside the node kinds (a per-handle
// fact in graph_handler's state), never as a payload on NRowFree. The
// negation's `EtAll` appears in gates and nowhere else: a row VALUE is
// never the universe, and the two unify arms that used to store one
// install a gate instead. A declared negation over a body row that
// resolves to free terminals used to be vacuous — `fn run(f) with !E =
// f()` accepted `run(() => op())` — because nothing was written that an
// instantiation downstream could refuse; the gate is that write
// (Hβ.infer.declared-row-vacuous-against-a-free-body-row).
type Gate = Gate({reason: Reason, row: EffRow})

// The ONE row-edge content read — every edge walk (resolve, flatten,
// compress, occurs, free, subst, the lower readers) dispatches an
// edge's chased cell through this projection, so the set of
// row-bearing bindings has exactly one home. Two shapes carry a row:
// a row cell (NRowBound), and a cell bound to a FUNCTION type — the
// crown's HOF residual draws a row edge to an untyped fn param's own
// cell (the edge means "that fn's row joins here"), and when the
// caller binds the param to a real fn the row lives INSIDE the TFun.
// Before this projection the readers traversed NRowBound only, so a
// bound fn-typed edge contributed NOTHING — the measured silent drop
// behind Hβ.infer.forward-hof-row-underpublish (a declared allocator
// publishing Pure). An alias-wrapped fn binding (TAlias over TFun) is
// named residue here, not silently absorbed: extend when measured.
fn edge_row_of(kind) = match kind {
  NRowBound(inner) => Some(inner),
  NBound(ty) => match ty {
    TFun(_, _, frow) => Some(frow),
    _ => None,
  },
  _ => None,
}

// Effect names carry optional install-time arguments. The `with IO`
// declaration is an ENamed wrapping the name IO; `with Sample(44100)`
// is EParameterized wrapping Sample plus [EAInt(44100)]. Two
// parameterized rows match only when both NAME and ARGS coincide —
// Sample(44100) ≠ Sample(48000). The distinction lives at the type
// level only; emit erases the args.
//
// EffArg's scalar variants (EAInt/EAFloat/EAString) are the CONSTANT-FOLDED
// PROJECTION of a parameterized-effect argument's operand node — the literal the
// AST already holds, folded for value-distinct row equality (Sample(44100) ≠
// Sample(48000)). A non-literal argument (`Clock(monotonic)`, `Sample(rate)`) is
// EANode(handle) — an operand Node resolved LIVE via graph_node_body, the
// PExpr-dissolution precedent (predicate operands are handles too, PCompare). The
// EffArg ADT is thus the projection channel, never a parallel re-derivation of the
// literal; row equality unifies node-bodies, not flattened literals.
type EffName
  // the interned name HANDLE (§5.O layer 1:
  // a name is a word; identity is i32.eq,
  // exact by type — a missed intern is a
  // loud E_TypeMismatch, never a silent
  // pointer miss). The spelling is the
  // render projection (eff_name_str →
  // intern_name_of), read only by
  // diagnostics/show/lower's extraction.
  = ENamed(Int)
  // name handle + [EffArg]; shares the
  // handle with its bare ENamed, so
  // bare-name membership matches an
  // instance by one word compare.
  | EParameterized(Int, [EffArg])
  // the union identity — `with Pure` IS the
  // empty row, made an ADT variant (drift-3:
  // not a string key). build_declared_row   // drift-audit: ignore — describes the dissolution
  // maps it to the pure row; it never enters
  // a name-set. Its handle is the reserved
  // absent 0.
  | EPure

type EffArg
  = EAInt(Int)
  | EAFloat(Float)
  | EAString(String)
  // type payload — the effect's op payload type
  // (Iterate(a)). Flows performer→handler at the
  // install; unified, not value-compared. Emit erases.
  | EAType(Ty)
  // a non-literal arg (`Clock(monotonic)`,
  // `Sample(rate)`) — an operand Node handle resolved
  // LIVE via graph_node_body (the PExpr-dissolution
  // precedent). Row equality compares the resolved
  // node bodies, not a flattened literal; emit erases.
  | EANode(Int)
  // an EFFECT standing at an instance-argument position
  // (`Flow(Secret, WASI)`) — the effect's interned name
  // handle, the same word ENamed carries (identity is a
  // contract, 6.1): handle inequality IS value
  // distinctness, one namespace. Folded from EANode at
  // infer's registration, where the env answers; emit
  // erases.
  | EAEffect(Int)
  // a NULLARY ADT constructor at an instance-argument
  // position (`Flow(Sec, Store)`) — the ctor's interned
  // name handle. A nullary ctor is a CONSTANT (its tag):
  // two distinct constructors are distinct VALUES
  // unconditionally, so the fold gives the scalar
  // literals' value-distinct row equality to the ctor
  // vocabulary. A fielded ctor used bare is a function
  // value, never a constant — it stays EANode. Folded at
  // infer's registration; emit erases.
  | EACon(Int)

// The Boolean connective joining a surface effect term to the row
// accumulated to its left — the topology the surface `+ - &` draws
// (SYNTAX.md §«Named effect rows»: full algebra `+ - & ! Pure`).
// `!` is the per-term negation flag, not a connective. The first
// term carries EcUnion (joining onto the pure-row base = itself). The
// fold reads the existing effects.mn algebra live (union_row /
// diff_row / inter_row) — the parser names the connective, infer
// applies it; no row is re-derived.
type EConn
  // `+` — set union
  = EcUnion
  // `-` — set difference (E - F = E & !F)
  | EcDiff
  // `&` — set intersection
  | EcInter

// Substrate owned by graph.mn. The ADTs live here because every
// consumer of the graph names them — Read/Write/Speculate effects,
// chase return type, trail mutations, overlay tags.
type NodeKind
  // resolved — chase terminates; delivers Ty
  = NBound(Ty)
  // unresolved — epoch at allocation time
  | NFree(Int)
  // resolved effect row — the payload is EffRow, ONLY
  | NRowBound(EffRow)
  // unresolved effect row variable
  | NRowFree(Int)
  // record-row residual — a `...R` rest's
  // remaining (name, ty) fields. Its own kind: binding
  // the residual under NRowBound made the row slot an
  // untagged EffRow-or-Ty union, and every row walk's
  // catch-all silently crossed sorts (the census's
  // EffRow-vs-Ty at occurs_in_row's delegation).
  // The second slot is the residual's own TAIL, a RecordRowTail: what the
  // writer KNEW about everything past these fields. It lives in the ROW
  // SORT rather than as a Ty bound onto a row handle — that shortcut was
  // tried and the march broke on it, for the reason this kind exists.
  | NRecordRowBound([(String, Ty)], RecordRowTail)
  // inference observed failure (Hazel marked hole)
  // IFC (§4⑥): no separate NFlowBound/NFlowFree dimension needed. The existing
  // graph already encodes information-flow constraints through two mechanisms:
  //   1. the row's absent set (`!IO + !Network`) — a function proved to carry !IO
  //      cannot let its return value reach a Log/stderr handler; the row unification
  //      catches the violation structurally (not through a parallel label lattice).
  //   2. TRefined(Ty, Predicate) + TName — `type SecretKey = Bytes where classified(self)`
  //      brands values at the type level; the type checker refuses to pass SecretKey
  //      where Bytes is expected. Nominal branding IS the flow label.
  // FlowLabel (below) remains as a pure lattice for use in annotations and the
  // mentl-voice projection (`mentl query flow name`) — a read over the type the graph
  // already holds, not a new graph dimension.
  | NErrorHole(Reason)

// WHAT LIES PAST A RESIDUAL'S FIELDS: nothing, proven — or the rest of the
// record, which is a row variable like any other. There is no third answer.
// A third one stood here until 2026-09-28, the ASSUMED tail, written when two
// open rows met: the union of what each side knew, with nothing standing for
// what neither had seen. Nothing to generalize meant nothing to instantiate,
// so every caller of a helper that reads two fields shared ONE residual and
// the last caller's record decided every caller's offsets —
// `fn pick(u) = u.x * 10 + u.y` over `{x: 1, y: 2}` and `{a: 5, x: 3, y: 4}`
// answered 54 for 46 (tests/micros/mn-row-two-fields-two-shapes.mn). The
// unseen rest IS a variable; naming it is what lets each caller close it.
type RecordRowTail
  // proven: these fields and no more
  = RowClosed
  // the remainder is another row var's residual
  | RowContinues(Int)

type GNode = GNode(NodeKind, Reason)

// every node carries its justification
//
// Inference-created executable boundaries are graph edges, not lowering
// conventions. Each fanout site owns one ordered edge per branch:
//
//   <fanout> -> FanoutBoundary([
//     BoundaryEdge(result_h, thunk_h, carrier_h, thread_ticket_h,   // drift-audit: ignore — doc-comment example of the BoundaryEdge record shape
//                  persist_ticket_h), ...
//   ])
//
// The branch index is the topology; no reverse lookup through a tuple type is
// needed. thunk_h is bound to `() -> carrier_h` with the branch's row; carrier_h is
// the one-field positional product `(result_h,)`. The product is a boundary-
// local representation carrier: generic scheduling handlers transport one word
// while the field keeps the result's exact repr (f64/f32/v128 included). Lower
// follows the edge and immediately projects field 0. No name lookup, cache, or
// boxing policy exists outside the graph.
type BoundaryEdge = BoundaryEdge(Int, Int, Int, Int, Int)

// result, thunk, carrier, Thread ticket, Persist ticket
//
// A suspended effect call has three identities: resume_input_h is the typed R
// hole the continuation accepts, answer_h is the enclosing frame's S result,
// and continuation_h is the heap record itself. The latter is bound to
// `TCont(TVar(resume_input_h), TVar(answer_h), discipline, world)`. Keeping all
// three on one edge prevents either value representation from doubling as a
// pointer type, and makes the captured capability world an inference fact lower
// only reads.
type ContinuationEdge = ContinuationEdge(Int, Int, Int, ResumeDiscipline, EffRow)

// resume input, answer, continuation, discipline, world
type ExecutableBoundary
  = NoBoundary
  // ordered BoundaryEdge values, one per branch
  // The call is seen while its InferCtx frame is live, before later handler
  // declarations have necessarily completed the op's cardinality join.
  | FanoutBoundary([BoundaryEdge])
  // resume input, answer, continuation, world
  | PendingContinuationBoundary(Int, Int, Int, EffRow)
  | ContinuationBoundary(ContinuationEdge)
  // The interpolation's N−1 interior-concat cells, minted ONCE at the
  // judge (the concat-key dossier's settled design): a lower-time
  // fresh mint made lowering non-reproducible, and every
  // program-derived key collides with a call-keyed handle in its own
  // subtree (the fragment's synthesized show parks on the same
  // $call_<h>). Judged, trailed, read by lower's fold — the last
  // lower-time mint dies here.
  | InterpBoundary([Int])

// The bind-home column cell (Hβ.lower.lowering-is-a-column, marched
// step i): lower's ls_resolve decision at a VarRef use site, written
// once at the resolution arm, keyed by the USE node's handle — the
// identity the LowExpr tree DISCARDS at mint (LLocal replaces it with
// the binding-time handle). Payloads carry only what no live read
// answers: the binding-time type-bearing handle and the capture slot;
// the RGlobal sub-split (ctor / fn / missing) stays a live env read.
// First constructor nullary — an unwritten spine cell (0) reads as it.
// READERS ARRIVE AT STEP iii (the emit walk re-rooted on
// program+columns); until then the column is the dual-write
// migration's priced write-only interval, retired by that landing.
type BindHome = BindUnwritten | BindLocal(Int) | BindUpval(Int, Int) | BindPrior(Int) | BindGlobal

// The dispatch-tier column's value (lowering-is-a-column step i, the
// decision-carrier enumeration): lower's perform/wasi fork notes WHICH
// tier it chose at the perform node's handle. All-payload constructors
// by design — the sparse column's absent contract is the addr-0 virgin
// cell, so no nullary tag may alias it.
// The Bool DtSingleton carried was the handler's statefulness, written at the
// one mint site and read NOWHERE — the last residue of the deleted singleton
// dispatch tier, where statefulness answered "can this direct call run
// without a record?". One walk answers it for every dispatch now, so the
// question is gone and so is its field.
type DispatchTier = DtLexical(String, String) | DtSingleton(String) | DtEvidence(String, Int) | DtWasi(String)

// The state-slot-home column's value (lowering-is-a-column step i): a
// resume site's `with field = NEW` updates, each field name paired with
// its resolved byte-slot offset in the handler state record. One
// all-payload constructor — the sparse column's absent contract is the
// addr-0 virgin cell.
type StateSlotHome = SlotPairs([(String, Int)])

// The install-shape column's value (lowering-is-a-column step i): a `~>`
// install site's handler name, the PROGRAM handle of its handler expression,
// its config-arg program handles, and the per-effect arm-name groups — the
// decl-side state inits stay readable at the handler decl through the name.
// The handler expression's type is the instantiated `Handler(inst)`, the
// effect instance this install serves, and the config handles are where the
// config's instantiation is read: together they key the arms it runs
// (`arm_site_pairs`, lower.mn). `NoInstall` comes first so a virgin cell
// reads as it, the `BindUnwritten` precedent.
type InstallShape = NoInstall | InstallOf(String, Int, [Int], [{arms: [String], ename: String}])

// A call's positional product, the judgment's own (`infer_call_node`): the
// declared slots in order as the nodes that fill them — an argument, the
// default that fills an absent field, an authored `??` — and past them the
// cells typing the slots a partial leaves open (one per slot, bound to the
// slot's parameter type at the judgment, `open_slot_cells`). Written once
// at the call node, trailed as `MSetProduct`; the lowering reads it and
// resolves no callee by name. `NoProduct` comes first so a virgin cell
// reads as it, the `NoInstall` precedent.
type CallProduct = NoProduct | ProductOf([Node], [Int])

// The emittable-fn enumeration's entry kind (lowering-is-a-column, the
// no-mint resolution): each synthesized fn shape is a PROJECTION of
// structure the graph holds at its origin handle — the lambda its own
// node, the thunk its boundary's branch, the arm its handler decl, the
// k its continuation edge's substitution walk, the partial its call
// node's hole shape, the nested fn its FnStmt. The enumeration entry
// (kind, origin handle, deterministic name, fence) is what lower's
// seven LFn writers know at construction and k2_floor never rewrites
// (the pass carries LowFn interiors through untouched — each body is
// floored at its own construction). An arm carries the op it answers,
// because its callers name it by that op — a direct perform's target
// (`perform_target`, lower.mn) and the allocation audit's unit name alike;
// a handler's state init is a fn of its own that the install calls
// directly. Both carry their handler's
// name, because the row their code answers to is the handler's own
// (`alloc_unit_named`, wasm.mn), and neither origin handle reaches it.
type EmitFnKind = EfkPartial | EfkLambda | EfkThunk | EfkNested | EfkArm(String, String) | EfkInit(String) | EfkK

// THE ENUMERATION'S ENTRY — one record per emittable symbol, written by
// lower's seven LFn writers at construction. A record, not a widening
// tuple: the fields have identity (the parameter product's own law,
// SYNTAX §«Labeled call arguments»), and a seventh positional slot would
// have been the parallel-arrays drift arriving one field at a time.
//
// `params` pairs each emitted parameter with its TYPE — the fn's own
// inferred TFun, component by component, read at the one site that knows
// it. Lower computes this vector today (param_handles_of, off the origin's
// live TFun) and hands it to ls_enter_frame, where it dies at frame exit.
// Emit then rebuilt it: a walk of the whole body per param looking for a
// use-site, and failing that a search of the declared scheme BY NAME — a
// scan for a fact the graph had already connected, and for the synthesized
// family a scan that always missed, so an unused wide param signed at the
// floor under a caller pushing it wide.
//
// A Ty and not a handle, because ty_handle_of is 0 for every GROUND type:
// a `x: Float` param has no handle to carry, and carrying its absence is
// how a real f64 slot becomes a word. A Ty and not a Repr, because storing
// the width would materialize the projection and a twin's body — emitted
// under an instantiation bracket — must project its OWN. And an OPTION,
// because a slot the graph never judged is ABSENT: the first form wrote a
// TVar(0) sentinel and the census convicted it as drift mode 10 on sight,
// correctly — "handle zero means no node" is a convention every reader must
// learn, where None is a fact the type states and the reader floors on. The
// ONE projection that must not vary by reader (the ABI) is settled once into
// the sigs column at the emit boundary.
type EmitFnEntry
  = EmitFnEntry({caps: [(String, Int)], fence: Int, kind: EmitFnKind, name: String, origin: Int, params: [(String, Option(Ty))], ret: Option(Ty)})

// The snapshot carries exactly what its consumers read: the mint bound
// and the span index. The node cells are NOT here — they live in the
// handler's paged spine and are read through graph_chase/graph_node_body
// (a snapshot copy of them was a write-only field: every destructure
// ignored it); epoch reads through graph_epoch; and the per-module
// overlay view is DELETED whole (graph_fork never performed — the module
// partition never existed at runtime, and module-of-position is the
// module column stamped at each node's mint, read by graph_module_of).
type Graph = Graph(Int, [(ValidSpan, Int)])

// next: next fresh allocation
//
// span_index: [(ValidSpan, Int)] for Mentl QTypeAt queries
//
// Trail mutations — append during forward execution, walk backwards
// on rollback. Powers Mentl's speculative oracle (spec 09).
type Mutation
  // handle, old_node (before overwrite)
  = MSetNode(Int, GNode)
  // handle, old_node (row variant)
  | MSetRow(Int, GNode)
  // fanout site handle, old boundary edges
  | MSetBoundary(Int, ExecutableBoundary)
  // handle allocated (undo = shrink)
  | MFreshNode(Int)
  // a gate entered on the cell (undo = pop the newest gate; the gate
  // column is a LIFO multi-map, so the inverse needs no old value)
  | MSetGate(Int)
  // an instance noted under its root (undo = pop the newest note)
  | MInstanceNote(Int)
  // a demand entered on a type cell (undo = pop the newest)
  | MSetDemand(Int)
  // a call's product written at its node (undo = restore the old value)
  | MSetProduct(Int, CallProduct)
  // a row note entered on a node (undo = pop the newest note)
  | MRowNote(Int)
  // a binder's fact entered under its handle (undo = pop the newest)
  | MBinderFact(Int)
  // a payer recorded under an open guard cell (undo = pop the newest)
  | MOweLate(Int)
  // a contract claimed of the value at a node (undo = pop the newest)
  | MClaimNote(Int)

// What the graph knows of a BINDER the value walk reads through (P0),
// keyed by the binder's own handle; the walk reaches it through a
// reference's link, never through the unification class, which holds a
// shape alone.
type BinderFact
  // A DECLARED function's parameter: its precondition, the row cell
  // callers read for what that precondition guards, and what the judgment
  // has charged to it so far. The charges ride the fact and the cell is
  // written once, at the declaration's exit: a cell that grew after a
  // caller read it would have handed that caller a stale copy, since a
  // stored row folds what its bound edges hold when it is written.
  = ParamFact({guard: Int, owes: EffRow, pre: Precondition})
  // A pattern's binder for a PART of the value the pattern matched: the
  // node it destructured (`whole`, the scrutinee's or an enclosing
  // part's), where in it the part sits, and — for a constructor's field
  // declared with a refinement — that contract, which every construction
  // of the constructor owed where it was built. Destructuring is a
  // value-flow edge, and this is the edge.
  | PartFact({declared: Option(Ty), step: PartStep, whole: Int})
  // A handler's STATE field, noted on its init's node (a state binds where
  // its init stands, as a let binds where its value does): every value
  // written into it — the init and each arm's `resume … with` update of the
  // field. A state at any read is one of them, so a walk reads the join of
  // the writers. Noted before any arm is judged; until then a state was read
  // as its init, so `100 / d` over `with d = 5` checked clean under `!Trap`
  // while an arm wrote `d - 5`.
  //
  // `stores` is the field's OTHER writer: every value an arm stores IN PLACE
  // into what the field holds (`list_set(buf, …)`, directly or through a
  // callee storing into its parameter), as the cells a move of it demands —
  // noted by the arena's store claim where it resolves the target to this
  // field (infer.mn `ages_settle`). The writes replace the record's word; the
  // stores mutate what it names. The arena's install demand and the race
  // rule read the two together as what an arm writes, one fact with one home
  // (`handler_state_writes`, `handler_state_writer`).
  | StateFact({stores: [Int], writes: [Int]})

// A value walk's dynamic scope: the state binders whose writers it is
// reading, and the handler declarations whose arms it is reading. A write
// may read the state it writes (`with d = d + 1`, or through a let), so a
// walk that meets a state it is already inside reads it as unknown rather
// than looping; an arm may install its own handler, and the arms met again
// add no tail (the least fixed point, exact). The chain of handlers
// installed around the walks IS the stack of states and declarations
// entered (verify.mn `walking_state_of`).
effect StateWalk {
  walking_state(b: Int) -> Bool
}

// Where a destructured part sits in its whole: the whole itself (an
// as-pattern binds the value it matches), a tuple's element, a
// constructor's field by the constructor's name, a record's field, one of
// a list's elements, a list's or a record's rest, or — a nominal type read
// as a container — the values of one of its type arguments, wherever its
// constructors hold them.
type PartStep
  = PartWhole
  | PartIndex(Int)
  | PartCtor(String, Int)
  | PartField(String)
  | PartElem
  | PartRest
  | PartTypeArg(Int)

// Where a parameter's precondition comes from. An unannotated parameter
// handed straight to a refined one LEARNS that precondition — its own
// callers owe it from then on — while a parameter annotated with a plain
// type stated its intent and learns nothing (the claim at that edge stays
// a claim).
type Precondition
  // the developer wrote a refinement
  = Stated(Ty)
  // an argument edge handed the unannotated parameter to a refined one
  | Learned(Ty)
  // no annotation, nothing learned yet
  | Unstated
  // annotated with a type that states no refinement
  | Unrefined

fn pre_contract(pre) = match pre {
  Stated(t) => Some(t),
  Learned(t) => Some(t),
  Unstated => None,
  Unrefined => None,
}

// 14 variants, one per operator form in SYNTAX.md's operator
// precedence table. Exhaustive set; add a variant here AND update
// every downstream match (parser op_to_binop, infer_binop,
// emit_binop) — H6's discipline applied at the AST layer. Drift
// mode 8 (string-keyed-when-structured) is closed by this ADT:
// `op: String` becomes `op: BinOp` everywhere an operator is
// dispatched on, and `OpConstraint`'s Reason-label stringifies via
// binop_to_str at the Reason-rendering boundary only.
//
// BinOpKind factors the 14 variants into 4 behavior classes used
// by infer_binop for type-class dispatch. Two orthogonal axes:
// BinOp carries operator identity (for Reason/emit); BinOpKind
// carries semantic behavior (for inference rules).
type BinOp
  // arithmetic (5)
  = BAdd
  | BSub
  | BMul
  | BDiv
  | BMod
  // comparison (6)
  | BEq
  | BNe
  | BLt
  | BGt
  | BLe
  | BGe
  // boolean (2)
  | BAnd
  | BOr
  // seq_concat over the unified sequence kind (1)
  | BConcat

// UnaryOp — the two unary operators per SYNTAX.md operator table
// (line 1119): unary `-` and unary `!`. Mirrors BinOp's ADT discipline;
// the value-level tag is the discriminant (HB drift-6 closure: every
// nullary variant compiles to sentinel via "the heap has one story").
// Seed transcription maps to integer sentinels in the 160-179 reserved
// region (mirror of BinOp's 140-153 region).
type UnaryOp
  // unary `-` per SYNTAX.md
  = UNeg
  // unary `!` per SYNTAX.md
  | UNot

type BinOpKind
  // +, -, *, /, %
  = BKArith
  // ==, !=, <, >, <=, >=
  | BKCmp
  // &&, ||
  | BKBool
  // ++
  | BKConcat

// The primitives the sugar CALLS: `++` and every seam of an interpolation
// call the sequence concat, `xs[i]` calls `list_index`, and a list pattern
// that binds its rest (`[head, ...rest]`) cuts the rest as a slice. They are
// the construct's callees exactly as `f` is a call's — the judgment reads
// their rows live (the concat, subscript and rest charges), and the
// free-name walk draws the edges its callee-first order needs, both from
// these homes. Until 2026-09-28 the walk drew none, so a fn whose only call
// was `++` could be judged before the concat primitive: the judgment read a
// signature not yet judged, and a refusal under `!Alloc` landed at the
// primitive's declaration, twice, instead of at the developer's line.
fn concat_callees() = ["str_concat", "list_concat"]

fn subscript_callee() with Pure = "list_index"

fn list_rest_callee() with Pure = "slice"

fn binop_kind(op) with Pure = match op {
  BAdd => BKArith,
  BSub => BKArith,
  BMul => BKArith,
  BDiv => BKArith,
  BMod => BKArith,
  BEq => BKCmp,
  BNe => BKCmp,
  BLt => BKCmp,
  BGt => BKCmp,
  BLe => BKCmp,
  BGe => BKCmp,
  BAnd => BKBool,
  BOr => BKBool,
  BConcat => BKConcat,
}

fn binop_to_str(op) with Pure = match op {
  BAdd => "+",
  BSub => "-",
  BMul => "*",
  BDiv => "/",
  BMod => "%",
  BEq => // drift-audit: ignore — BinOp→canonical-string rendering for Reason labels; NOT runtime string compare. Centralizes the only "==" string-literal site in the compiler (parser op_string / infer classify_binop / wasm emit_binop no longer carry it post-11.B.1).
  "==",
  BNe => "!=",
  BLt => "<",
  BGt => ">",
  BLe => "<=",
  BGe => ">=",
  BAnd => "&&",
  BOr => "||",
  BConcat => "++",
}

// ─── NumericGate — arithmetic's demand on a type cell ────────────────
// The gate mechanism's second arm (the row gate is the first): `+ - * / %`
// and unary `-` unify their operands and demand one more thing of them, a
// NUMBER. At a bound cell the demand is judged on the spot; at a free cell
// it is a gate the cell carries — the one writer (unify's var binds)
// judges every type that later enters the cell (a word passes, a variable
// inherits the gate, an aggregate refuses E_ArithOnAggregate naming this
// site), instantiation copies it onto the fresh var, and a copy minted
// before the demand is reached through the instance column. One gate per
// arithmetic site; the op renders the refusal's operator.
type NumericGate = NumericGate({op: BinOp, span: Span})

// ─── TypeDemand — what an operation asks of its operand's type cell ────
// One column carries every demand, and they share one mechanism: entered at
// the judgment's site, carried by a free cell, checked or pushed at the one
// writer (unify's var binds, a record row's continuation), ridden across an
// alias, copied at instantiation, reached through the instance column.
//
// A NUMBER is arithmetic's demand, judged: a word passes, an aggregate
// refuses. A SHAPE is a structural read's, and it never refuses — it marks
// the variables whose structure the body reads, which is what a twin of the
// body has to key: a comparison, a show or a hash reads its operand WHOLE,
// every variable in it; a concat reads its operand's OUTER shape (a list or
// not), a field load or a record pattern its receiver's (which fields the
// row holds). A variable no shape reaches is read at its width alone, so a
// twin keys it by its representation digit and never by its structure —
// which is exactly how many distinct bodies an instantiation can emit.
//
// A MOVE is an arena's read: a store into memory an arena may outlive, and
// the arena's own value, are carried out of the region by their whole
// structure, so the read reaches every variable in the type as a whole read
// does — but what a twin keys by is the class the move needs (a word moves
// nothing, a float in a word slot moves its box, anything else moves by its
// shape), and only in a program that opens an arena, since nowhere else is
// there a barrier to read it.
type ShapeRead = WholeShape | OuterShape | MovedShape

type TypeDemand = DemandNumber(NumericGate) | DemandShape(ShapeRead)

// Every graph node and every unification records a Reason. Mentl's
// teach_why (spec 09) walks this DAG. Full provenance falls out.
type Reason
  = Declared(String)
  | Inferred(String)
  | Fresh(Int)
  | OpConstraint(String, Reason, Reason)
  | VarLookup(String, Reason)
  | FnReturn(String, Reason)
  | FnParam(String, Int, Reason)
  | MatchBranch(Reason, Reason)
  | ListElement(Reason)
  | IfBranch(Reason)
  | LetBinding(String, Reason)
  | Unified(Reason, Reason)
  | Instantiation(String, Reason)
  | UnifyFailed(Ty, Ty)
  | Placeholder(Span)
  | BinOpPlaceholder(BinOp)
  | MissingVar(String)
  | Refinement(Predicate, Predicate)
  // spec I13 — site-annotated reasoning edge
  // RX.2 — high-intent structured variants (replacing mechanism-speak strings)
  | Located(Span, Reason)
  // callee_name, inner — "return of call to 'process'"
  | InferredCallReturn(String, Reason)
  // pipe_verb ("|>", "~>", "<~"), inner — verb identity in Why chain
  | InferredPipeResult(String, Reason)
  // handle, context_name — "fresh in 'process'" not "fresh 42"
  | FreshInContext(Int, String)
  // a param defaulted from `= expr` at the
  // decl_site — the Why projection at a
  // defaulted call slot walks here ("ratio
  // defaulted to its declaration; annotate to
  // pin"). SYNTAX.md §«Default parameter values».
  | DefaultReason(String, Span)
  // the SAT model the SMT handler produced
  // for a discharged obligation — proof-
  // evidence the Why-walker reaches (the
  // counterexample/model, surpassing Dafny/F*'s
  // separate dump: the witness IS a Reason edge).
  | VerifyWitness(String)
  // THE ACCEPT EDGE (C4, 2026-09-30): the text the medium proposed at a
  // hole, rendered as the source it became; the proof it was offered
  // with, carried verbatim as the medium said it at proposal time; and
  // the binding's own reason, which the acceptance wraps. A developer
  // did not author the value under this hop — the medium proposed it
  // and they accepted — and that is intent the graph carries losslessly
  // (PLAN §0 property 3), never a fact the source text could hold.
  | Accepted(String, Reason, Reason)

// Caret — the user's text-attention position. ONE input among many to
// Cursor's argmax computation. Updated by the editor's transport
// handler on every focus event (mouse, keyboard, drag-select, arrow
// keys). The caret biases the gradient argmax via proximity weighting;
// it does NOT define the cursor.
//
// (Renamed from the mentl-voice walkthrough:373's `Cursor(Handle, Reason)` per
// the cursor walkthrough §2.2 — the previous name conflated the user's text
// position with the gradient's argmax, which is drift mode 5 by
// PLAN §5.U's one heap record applied to handler-state
// shape.)
type Caret = Caret(Handle, Reason)

// Cursor — the gradient's global argmax over the live graph at the
// moment of query. Cursor is attention, not position. The text-caret
// biases the locus via proximity weighting; the caret does NOT define
// the locus. The impact field carries the argmax score: 0.0 for "no
// suggestion" / fully-annotated positions; positive finite for ranked
// auto-argmax. A developer-pinned `??` position is STRUCTURAL — its
// Reason IS Located(span, "user pinned via ??"), read by case
// (reason_is_pinned) and followed as an override edge BEFORE the
// auto-scored reduce — never a magic-float impact magnitude.
//
// See PLAN §2's cursor table and
// PLAN §2.
type Cursor = Cursor(Handle, Reason, Float)

// SuggestionKind — exhaustive ADT for the axis of an annotation
// suggestion. Drift 8 closure: never a string flag; always tagged
// dispatch. Per the gradient-delta walkthrough §3.2 promotion to live.
type SuggestionKind = SuggestEffectRow | SuggestRefinement | SuggestReturnType

// An annotation the gradient can propose: an INPUT the developer writes
// that the medium has PROVEN changes what the declaration proves (D4,
// 2026-10-02). A row clause locks an absence the body already has; a
// parameter's refinement is a precondition that discharges the body's open
// claims; a return refinement is a postcondition the body proves and its
// callers' open claims stand on. The refinements name an alias the
// declaration's module reaches — a type the developer declared, never one
// the medium invents — and carry the contract the bracket proved it with.
//
// Three kinds the gradient once named are not annotations it proposes, and
// are absent rather than declared and never built: an ownership marker (the
// grade is inferred and projected, and the quiet gate counts authored
// markers DOWN — a marker the medium proposed would be the inference
// failing), a handler wrap (it changes what the body MEANS, so it is a
// fill the proposer judges at a `?? ~> h` hole, never an annotation), and a
// representation pin (no proof the medium makes reads a width until the
// interval fragment models the word it folds over —
// `Hβ.verify.interval-fragment-assumes-unbounded-int`).
type Annotation
  = APure(Option(Span))
  // The general severance: !<name> for ANY name the link performs
  // (Hβ.teach.severance-vocabulary-from-link). The fixed
  // ANotAlloc/ANotIO/ANotNetwork trio is DELETED into it — known
  // names keep their rich labels via capabilities_for_severance.
  | ANotEffect(String, Option(Span))
  // a parameter's precondition: the parameter, the alias naming it
  | ARefined({alias: String, contract: Ty, param: String})
  // a declaration's return contract
  | AReturns({alias: String, contract: Ty})

// What a proven annotation buys, read off the bracket that proved it: the
// open obligations it discharges — in its own declaration for a
// precondition, at its callers for a return contract — the calls whose
// claim it REFUTES (each a call that breaks the requirement: the program's
// own defect, which the annotation makes the medium say), the calls whose
// claim it leaves OPEN (debt a precondition moves to its callers), and the
// effect absences it makes promises of — each a gate a later write must
// meet: one for `!E`, and for `with Pure` every effect the program performs,
// since it locks them all — with the guarantees they name. Debt discharged
// is what makes a program more proven, so it ranks first; a lock changes no
// proof today and ranks last.
type Leverage = Leverage({absences: Int, discharged: Int, locks: [String], opened: Int, refuted: Int})

// What the gradient proposes at a position: the annotation PROVEN there,
// what it buys, and why it leads. The annotation is the fact an accept
// writes into the graph; its axis and its source text are projections of it
// (mentl.mn's suggestion_kind_of and show_annotation), read where they are
// rendered. Until 2026-10-01 the suggestion carried the TEXT in the
// annotation's place, so an accept could only splice a string, and it
// spliced "  with Pure" as a new line above the declaration — a file that
// no longer parsed, in whatever file the session happened to target.
type AnnotationSuggestion = AnnotationSuggestion(Annotation, Leverage, Reason)

// The gradient's ANSWER at a declaration, as one value (§11.1's law at the
// gradient: a list is the medium admitting it does not know). One proven
// annotation is proposed. Two or more proven for ONE position — the same
// parameter, or the return — that discharge the same obligations and
// refute the same calls mean different things the program cannot choose
// between, so the medium ASKS which is meant, naming them. An open
// obligation that leans on a parameter while no alias in reach discharges
// it is a NEED: the medium states the predicate the parameter must carry
// and that no declared type says it — the missing vocabulary, taught.
type Teaching
  = TeachAdd(AnnotationSuggestion)
  | TeachAsk([AnnotationSuggestion])
  // the parameter, the open predicate it must make hold, where it is owed
  | TeachNeed(String, Predicate, Span)
  | TeachNone

// Where a node stands in one verb that holds it, each role naming its verb:
// a `|>` chain's source or its i-th of n stages; the i-th of n branches of a
// `><`; the i-th of n branches of a `<|` or the input it shares; a `~>`'s
// body or its handler; a `<~`'s recurrence or its declared delay.
type VerbRole
  = ChainSource
  | ChainStage(Int, Int)
  | FanBranch(Int, Int)
  | ShareBranch(Int, Int)
  | FanInput
  | InstallBody
  | InstallHandler
  | Recurrence
  | FeedbackDelay

// One verb on the path from a declaration down to a node: the site's handle
// and the node's role there. The topology at a position is the list of them,
// outermost first.
type VerbFrame = VerbFrame(Int, VerbRole)

// What running the node at a position performs: an expression's evaluation;
// for a function value, its evaluation and its body when it is called — two
// facts, because minting a closure costs what calling it never shows; at a
// hole, whatever the position permits, which no row states.
type RowFacet = Evaluates(EffRow) | WhenCalled(EffRow, EffRow) | HoleRow

// CursorView — what cursor_default projects at the cursor's handle.
// Each field is one of the eight kernel primitives, read off the
// graph at the cursor's position. Eight aspects of one read.
//
//   query    — primitive #1 (Graph)            — what's bound here (NodeKind)
//   propose  — primitive #2 (Handlers)         — Synth's candidates
//   topology — primitive #3 (Five verbs)       — the verbs that hold the node
//   row      — primitive #4 (Effect algebra)   — what running it performs
//   trace    — primitive #5 (Ownership)        — own/ref/inferred (existing ADT)
//   verify   — primitive #6 (Refinement)       — pending obligations
//   teach    — primitive #7 (Gradient)         — the gradient's Teaching
//   why      — primitive #8 (HM + Reasons)     — the node's Reason chain, then its type's
type CursorView
  = CursorView(NodeKind, Proposal, [VerbFrame], RowFacet, Ownership, [(Int, Span, Predicate, Reason)], Teaching, [Reason])

// ─── The View — what Mentl Space paints, typed ───────────────────────
//
// The eight aspects at a position, each carrying the sentence the terminal
// says for it and the value behind it (space.mn computes them from the one
// cursor read; the terminal prints them and the page's JSON serializes
// them, two projections of one walk). An ADT, exhaustive at every reader:
// no word the page matches on exists in the wheel — the wire's words are
// made in exactly one place, the serializer.
type Aspect
  // the addressed source, sliced to the node, and what is bound there
  = AQuery(String)
  // the socket's verdict at the position
  | APropose(Socket)
  // the verbs that hold the node, innermost first; empty where none does
  | ATopology(String)
  // what running the node performs — said at every position, Pure included
  | AEffects(String)
  // the grade the use-count inferred
  | AOwnership(Ownership)
  // the obligations standing open at the node — each one a note under it,
  // so the aspect itself carries nothing a count of the notes would repeat
  | AVerify
  // the gradient's answer, said, and which kind of answer it is; at a
  // declaration the gradient has nothing for, the tightening the judgment
  // banked, when it banked one
  | ATeach(String, TeachMode)
  // the first hop of the node's Why; the deeper hops and the type chains
  // are notes under it
  | AWhy(String)

// The socket's content at a position: the one proven fill as source with
// its Reason; a tie's width (its members and the computed question are
// notes); an authored hole nothing proved; and a filled position, which has
// no proposal to report.
type Socket = SkFill(String, String) | SkAsk(Int) | SkNone | SkSilent

// Which answer the Teach aspect gives: an annotation to add, a question
// between two, a predicate a parameter needs, a tightening the judgment
// banked, or nothing.
type TeachMode = TmAdd | TmAsk | TmNeed | TmTighten | TmNone

// What stands under an aspect: the authored lede over the query; a tie's
// member, the computed question, a name the medium would not offer with
// its Why, and the install that serves a perform, under the proposal; an
// open obligation at its own module and span, under verify; a hop of the
// Why, and the chain a type is read from with its own hops.
type Note
  = NoteLede(String)
  | NoteMember(String)
  | NoteQuestion(String)
  | NoteRefusal(String, String)
  | NoteHandler(String)
  | NoteObligation(String, String, Span)
  | NoteHop(String)
  | NoteTypeChain(String, [String])

// One aspect of the ring with what stands under it.
type RingFact = RingFact(Aspect, [Note])

// The Ledger: the module's own facts, each with how much it matters at the
// caret — a top-level declaration (its handle, its kind in the author's
// word, its name, its query line, its span, its proximity to the caret), an
// open obligation of the module (its sentence, the predicate owed, the Why
// it is owed by, its module and span), a tightening the judgment banked.
type LedgerFact
  = LedgerDecl(Int, String, String, String, Span, Float)
  | LedgerObligation(String, String, String, String, Span)
  | LedgerTighten(String, String, Span)

// A position the field lists — an authored hole or a gradient position, its
// handle and span, with the ring its own address projects.
type FieldFact = FieldHole(Int, Span, [RingFact]) | FieldGradient(Int, Span, [RingFact])

// Where a View stands: the module, the line and column the request named,
// the handle the address resolved to, and its span.
type ViewAt = ViewAt({col: Int, h: Int, line: Int, module: String, span: Span})

// The View at an address: the position, the eight-aspect ring at it, and
// the Lens and the Ledger of its module. The page paints this and nothing
// else; the terminal prints its ring. At line 0 the whole module is the
// subject: the ring is empty and the field holds every hole and every
// gradient position, ranked, each with its own ring — the work queue the
// terminal prints with the Ledger's obligations and tightenings. The Lens
// is the bank's own facts, each the report as it fired (the kind, its
// message, its module); the lead sentence the page prints over them is a
// projection of that fact, never a fact of its own.
type View
  = View({at: ViewAt, field: [FieldFact], ledger: [LedgerFact], lens: [(DiagKind, String, String)], ring: [RingFact]})

// The wire's word for a diagnostic's applicability — the automation axis
// (SYNTAX.md), spelled as the catalog spells it.
fn applicability_text(a) = match a {
  MachineApplicable => "MachineApplicable",
  MaybeIncorrect => "MaybeIncorrect",
  HasPlaceholders => "HasPlaceholders",
  Unspecified => "Unspecified",
}

// query   propose  topology     row     trace      verify  teach    why
// ─── SpinePage — the graph's columns, named ONCE ─────────────────────────
// One band's worth of every per-handle fact, each column a flat array the
// handle indexes directly. Pages allocate whole at band-open and NEVER move,
// so a column read is the O(1) chase and a write is one in-place cell store.
//
// This is a COLUMN STORE, not the parallel-arrays drift (CLAUDE.md mode 7):
// mode 7 convicts N lists keyed by POSITION as a fragile proxy for identity,
// and here the index IS the identity — the handle is the key, so the columns
// cannot desynchronize any more than a record's fields can.
//
// It is declared here because the shape was written out THREE times — the
// spine_page annotation, the spine_open_loop literal, and graph_branch_seed's
// op type — so adding a column meant editing a twelve-field record in three
// files and finding out at the type error which one you missed. Three hand
// copies of one type is the Carried-Truth Law at the declaration layer; the
// name is its one home, and the next column is one line.
type SpinePage
  = SpinePage({bind: [BindHome], boundaries: [ExecutableBoundary], canon: [Int], comments: [(String, Span)], dispatch: [DispatchTier], installs: [InstallShape], module: [Int], narrowing: [Int], nodes: [GNode], parent: [Int], products: [CallProduct], program: [NodeBody], slots: [StateSlotHome], spans: [Span]})

// Newlines in a flat string — a module's own extent, sized at its parse.
fn count_lines(ref s) = count_lines_from(s, byte_len(s), 0, 0)

fn count_lines_from(ref s, n, i, acc) = if i >= n {
  acc
} else {
  let step = if byte_at(s, i) == 10 { 1 } else { 0 }
  count_lines_from(s, n, i + 1, acc + step)
}

type Span = Span(Int, Int, Int, Int)

// start_line, start_col, end_line, end_col
//
// The producers CARRY the proof (types.mn's own construction-site law):
// a `-> ValidSpan` return proves span_valid ONCE at this decl — an
// honest V_Pending here until the predicate-unfold fragment discharges
// it — and every consumer boundary collapses by typed identity (the
// weave carried ~85 re-demanded copies of this one obligation at call
// sites before the return was declared, measured 2026-07-30).
fn span_join(a, b) -> ValidSpan = match a {
  Span(sl, sc, _, _) => match b {
    Span(_, _, el, ec) => Span(sl, sc, el, ec),
  },
}

fn span_eq(a, b) with Pure = match a {
  Span(asl, asc, ael, aec) => match b {
    Span(bsl, bsc, bel, bec) => asl == bsl && asc == bsc && ael == bel && aec == bec,
  },
}

// Two spans that begin at one position.
fn span_start_eq(a, b) with Pure = match a {
  Span(asl, asc, _, _) => match b {
    Span(bsl, bsc, _, _) => asl == bsl && asc == bsc,
  },
}

// Closed-interval overlap on line numbers. Sufficient for the
// proximity-tier classification; column-precise comparison is
// peer-handle territory.
fn span_overlaps(a, b) with Pure = match a {
  Span(asl, _asc, ael, _aec) => match b {
    Span(bsl, _bsc, bel, _bec) => ael >= bsl && bel >= asl,
  },
}

// Ground construction — the R3 fragment discharges span_valid(0,0,0,0)
// outright, so this producer's proof costs nothing and every consumer
// reads ValidSpan by type.
fn span_zero() -> ValidSpan = Span(0, 0, 0, 0)

// The span a Reason edge carries, when it carries one — Located wraps the
// site; anything else is genuinely unlocated. The occurs-check's coordinates
// read THIS instead of flooring to 0:0 (SYNTAX principle 5).
fn reason_span_or_zero(ref reason) = match reason {
  Located(span, _) => span,
  _ => span_zero(),
}

// Inference + Verify ledger discharges obligations at construction
// sites. Runtime-erased. Failed discharge surfaces as V_Pending or
// V_Failed diagnostic with the predicate and the failing expression
// span.
type Handle = Int where 0 <= self

type TagId = Int where 0 <= self && self <= 255

type ValidOffset = Int where 0 <= self

type NonEmptyList = [a] where 0 < len(self)

fn span_valid(s) with Pure = match s {
  Span(sl, sc, el, ec) => sl >= 0 && sc >= 0 && el >= sl && (el > sl || ec >= sc),
}

type ValidSpan = Span where span_valid(self)

// The caret on a character is that character's extent. A span's end is one
// past its last column, so a zero-width point at a node's end sat inside it:
// the caret on a call's `(` answered the callee, and on the outer `)` the
// inner call.
fn caret_span(line, col) = Span(line, col, line, col + 1)

fn span_contains(outer, inner) with Pure = match outer {
  Span(osl, osc, oel, oec) => match inner {
    Span(isl, isc, iel, iec) => (osl < isl || osl == isl && osc <= isc) && (oel > iel || oel == iel && oec >= iec),
  },
}

// Tokens are the lexer's output; the parser's input. The wrapper
// pattern mirrors AST nodes: structured value + positional metadata.
// `N(NodeBody, Span, Int)` for nodes; `Tok(TokenKind, Span)` for
// tokens. Same shape, two layers. Accessors are uniform across both.
//
// TokenKind enumerates the 64 lexical forms specified in SYNTAX.md
// — 19 keywords, 7 identifiers/literals (with payload), 14 two-char
// operators, 22 single-char operators/punctuation, 2 layout. The
// parser dispatches via exhaustive `match Tok(kind, _) { … }`;
// adding a TokenKind variant fails compilation across every match
// site until the variant is handled (H6's discipline at the lexical
// layer).
type Token = Tok(TokenKind, Span)

type TokenKind
  // ─── Keywords (18) ───────────────────────────────────────────────
  = TFn
  | TLet
  | TIf
  | TElse
  | TMatch
  | TType
  | TEffect
  | THandler
  | TWith
  | TResume
  | TImport
  | TWhere
  | TOwn
  | TRef
  | TPure
  | TTrue
  | TFalse
  // ─── Identifiers and literals (7) ────────────────────────────────
  | TIdent(String)
  | TIntLit(Int)
  | TFloatLit(Float)
  | TStringLit(String)
  // // — every comment is graph content,
  //   attached to the next decl / enclosing node
  | TComment(String)
  // literal chunk of a "..." string
  //   (amendment C brace-interpolation)
  | TStringPart(String)
  // marks the start of a {expr} splice;
  //   followed by ordinary tokens then
  //   TRBrace (re-used) closes it
  | TStringSplice
  // ─── Two-character operators (14) ────────────────────────────────
  //
  // comparison
  | TEqEq
  | TBangEq
  | TLtEq
  | TGtEq
  // -> and =>
  | TArrow
  | TFatArrow
  // ++ concat
  | TPlusPlus
  // five verbs
  | TPipeGt
  | TLtPipe
  | TGtLt
  | TTildeGt
  | TLtTilde
  // logical
  | TAndAnd
  | TOrOr
  // ─── Single-character operators and punctuation (23) ─────────────
  | TLParen
  | TRParen
  | TLBrace
  | TRBrace
  | TLBracket
  | TRBracket
  | TComma
  | TDot
  | TColon
  | TSemicolon
  | TPlus
  | TMinus
  | TStar
  | TSlash
  | TPercent
  | TEq
  | TLt
  | TGt
  | TBang
  // `&` — effect-row intersection (inter_row);
  // the surface of the Boolean row algebra's `&`
  // (SYNTAX.md §«Named effect rows»). `&&` is the
  // distinct TAndAnd (logical and); maximal munch
  // lexes `&&` before a bare `&` reaches here.
  | TAmp
  | TPipe
  | TAt
  | THole
  // ─── Layout / structural (2) ─────────────────────────────────────
  //
  // statement separator; transparent around binops (layout is never semantics)
  | TNewline
  // end of input — always last
  | TEof

// Token accessors — uniform with N-pattern accessors.
fn token_kind(t) with Pure = match t {
  Tok(k, _) => k,
}

fn token_span(t) with Pure = match t {
  Tok(_, s) => s,
}

// Every expression site is an N(body, span, handle). The handle is
// allocated at parse time via graph_fresh_ty(Placeholder(span)) and
// populated during inference. No null handle. No sentinel zero.
// Type resolution is always a live chase via LookupTy — never a
// cached Ty field.
//
// The span FIELD carries the refinement (the producer-carries-proof
// law at the ctor decl): every destructured node span reads ValidSpan
// by type, so the 31 infer-side call boundaries that each re-demanded
// span_valid collapse by typed identity; the obligation lives at
// N-construction, where span_at/span_join already supply ValidSpan.
type Node = N(NodeBody, ValidSpan, Int)

// body, span, TypeHandle
fn span_of_node(node) = match node {
  N(_, span, _) => span,
}

type NodeBody
  = NExpr(Expr)
  | NStmt(Stmt)
  | NPat(Pat)
  // Hazel marked hole — inference populates with reason
  // Synthetic module entity — one per source file. An orphan module-level
  // comment attaches to this handle in the comment weave (graph_attach_comment);
  // decls lists every top-level Handle so a doc/render projection can
  // walk the module without re-parsing source.
  | NHole(Int)
  // imports: the modules this one imports, as the IDENTITIES their own
  // cells carry — resolved by the driver's walk once and carried here as
  // edges (F0b), so no reader re-resolves an authored spelling.
  | NModule({decls: [Node], imports: [String], path: String, span: Span})
  // An authored type annotation carried live in the graph — the `-> RetTy`
  // return annotation (SYNTAX.md «Return type omission»: absent = inferred,
  // present = a CONSTRAINT). parse_type_expr mints this carrying the real Ty
  // it parsed; infer reads the Ty LIVE and unifies the inferred body return
  // against it (E_TypeMismatch on violation). The Carried-Truth form: the
  // source wrote a type, so the node holds that type — never fabricated away
  // into a dummy LitUnit. Appended last so existing NodeBody tags (the seed's
  // 110-114 view) stay byte-identical.
  | NTypeAnn(Ty)

// ─── Expr (spec 03) ────────────────────────────────────────────────
type Expr
  = LitInt(Int)
  | LitFloat(Float)
  | LitString(String)
  | LitBool(Bool)
  | LitUnit
  | VarRef(String)
  | BinOpExpr(BinOp, Node, Node)
  | UnaryOpExpr(UnaryOp, Node)
  | CallExpr(Node, [Node])
  // a `name = value` call argument (SYNTAX.md
  // §«Labeled call arguments»). The label is the
  // PRODUCT-FIELD name of the parameter-list-as-
  // product: a call constructs its arg product
  // positionally, by field, or mixed — the SAME
  // machinery as a record literal. resolve_call_args
  // reorders these to positional against the callee's
  // declared param names (one read, both infer + lower
  // see the identical order). The wrapper never reaches
  // infer_expr / lower_expr — it is resolved away first.
  | LabeledArg(String, Node)
  // params, body
  | LambdaExpr([TParam], Node)
  | IfExpr(Node, Node, Node)
  // stmts, final expr
  | BlockExpr([Node], Node)
  // scrutinee, arms
  | MatchExpr(Node, [(Pat, Node)])
  // value, state updates
  | ResumeExpr(Node, [{init: Node, name: String}])
  | MakeListExpr([Node])
  | MakeTupleExpr([Node])
  // [(field_name: String, value: Node)] — sorted at parse
  | MakeRecordExpr([(String, Node)])
  // {...base, f: v, ...} — non-destructive update:
  // copy base's fields, overwrite/add the listed
  // [(name, value)] (sorted). base is owned-read,
  // not mutated (SYNTAX.md §«Record update»). One
  // spread base per literal; the override fields
  // are the same product-field machinery as
  // MakeRecordExpr.
  | RecordUpdateExpr(Node, [(String, Node)])
  // type_name + sorted fields — nominal record literal
  | NamedRecordExpr(String, [(String, Node)])
  // `xs[i]` semantic AST — receiver, index.
  // Infer dispatches on receiver's type:
  // TList → list_index (runtime); TTuple →
  // compile-time slot from constant index;
  // TRecord by int-key → the field-offset
  // load. The eager
  // parse-time fold to CallExpr(VarRef("list_index"))
  // was drift mode 9 (eager-form-commitment) —
  // it committed the dispatch before infer knew
  // the receiver's shape. Per #139.
  | IndexExpr(Node, Node)
  // string interpolation fragments — Node list
  // where each Node is either NExpr(LitString(s))
  // for literal chunks OR an arbitrary expression
  // node for a splice. Semantic-preserving form
  // per #138; parser produces this instead of an
  // eager str_concat fold so infer can narrow
  // (each splice must be Showable) and the
  // gradient can teach which splices are constant
  // (foldable at compile time) per Mentl-ultimate
  // string-substrate discipline.
  | MakeStringExpr([Node])
  // The splice's SHOW as a program node (γ's splice half,
  // Hβ.parser.interp-desugars-to-program): the parser wraps every
  // splice fragment at MakeStringExpr's own mint, so the structural
  // to_string is a JUDGED node with a real handle — lower's LShow
  // reads it instead of minting a fresh placeholder cell per run (the
  // 4818 mint, the projector divergence dossier's smaller root).
  // Parser-minted only, inside MakeStringExpr fragments.
  | ShowExpr(Node)
  | FieldExpr(Node, String)
  // |> <| ~> <~ (binary by nature; `<|` is input × branch-tuple)
  | PipeExpr(PipeKind, Node, Node)
  // `><` — the N-ary fanout carrier (the N-ary law, PLAN §11 3.1 /
  // Hβ.parser.pcompose-nary): a `><` chain's branches are PEERS in a
  // LIST, never nested pairs, because the verb's result is a PRODUCT
  // and product arity is semantic. The parser accretes a chain into
  // one FanoutExpr; PipeExpr(PFanout(FanDistribute), _, _) is not
  // constructed (the kind survives as the census/glyph key and the
  // FanShare discriminant). One PFanout node at lower carries both
  // aspects — the surface carriers differ because the operand
  // structure differs by nature.
  | FanoutExpr([Node])
  // `...name` in a list-EXPRESSION slot — the cover grammar for the
  // paren-lambda parameter path (`([h, ...t]) => …` parses its content
  // as an expression before the `=>` is seen, so the list parser mints
  // this marker and ONLY expr_to_pat consumes it into PList's rest).
  // Reaching infer means the rest sat outside a destructuring
  // reinterpretation: ERestOutsideDestructure, loud, never silent.
  | RestExpr(String)
  // ? — parser spawns NHole
  | ExprPlaceholder

// ─── The five verbs (spec 10) ──────────────────────────────────────
// Shape IS the computation graph. Formatter (a handler) emits
// sequential ops at left edge; convergent ops at indented center.
//
// ~> has ONE precedence (1, the loosest binary operator — SYNTAX.md
// §Precedence): the handler at the foot of a chain governs everything
// to its left; parenthesize to narrow. Layout is never semantics —
// block vs inline on the page is the formatter's projection of the
// same PTee node.
// `<|` and `><` are ONE parallel-fanout topology — both fan out to N
// branches and tuple the results — discriminated by INPUT OWNERSHIP
// (arm 5), the share-vs-distribute aspect read from the FanOwnership
// the glyph authors. `<|` = ONE input shared/borrowed (ref, !Mutate)
// across all branches; `><` = N independent owned inputs (each
// consumed). The merge is at the KERNEL (one PFanout node, the
// share-vs-distribute an ownership aspect) — collapsing the duplicate
// PDiverge/PCompose nodes+paths (Carried-Truth). The surface keeps
// BOTH authored glyphs as intent; ownership CHECKS coherence. A verb
// draws an edge; it does NOT schedule — execution (Seq/Thread/Simd/
// Gpu) is a `~>` handler choice over the pure-topology verb, never
// baked into the verb. SYNTAX.md §«><»/§«<|».
type FanOwnership
  // <|   ONE input ref-borrowed across all branches
  = FanShare
  // ><   N independent owned inputs
  | FanDistribute

type PipeKind
  // |>   converge — transparent wire
  = PForward
  // <| / ><   parallel fanout, ownership-discriminated
  | PFanout(FanOwnership)
  // ~>   handler-attach — governs the whole chain to its left
  | PTee
  // <~   feedback — closes cycle under ambient clock
  | PFeedback

// The `<~` RHS vocabulary (FeedbackSpec) has ONE home: lib/prelude.mn's
// Delay/Accumulate/FilterSpec + their constructor fns — the surface SYNTAX
// names. A second, code-dead FeedbackSpec (FbState/FbDelay/FbFilter) lived
// here and silently MERGED with the prelude's under one TName: two variant
// sets sharing tag ids, so a prelude Delay(3) matched an FbState(_) pattern.
// Deleted 2026-07-18 — the duplicate-type-name silent merge, in the wheel's
// own source (the decl-site refusal for the class is the named peer
// Hβ.infer.type-decl-name-registry).
//
// Region (spec I12) — Tofte-Talpin region identity for escape
// analysis. Each region scope (a `~>`-installed arena handler)
// produces a region; values allocated inside it carry that region as a
// tag. A value cannot escape the scope that outlives its region —
// the return-position check uses region identity, not pointer
// reachability, making the analysis O(1) per return edge.
//
// The Region ADT is a pair: a unique region id (fresh per
// arena install) and the span where the region was installed.
// Span tracking lets escape diagnostics point at the ORIGINAL
// region site rather than the escape attempt alone.
type Region = Region(Int, Span)

// RegionTrack (spec I12) — intercepts alloc sites to tag each value
// with its originating region; checks values at return sites for
// escape. Today's effect shape is substrate-prep: arms wire into
// the Alloc effect surface (which surfaces with full W5 arena
// semantics and the existing Consume ownership ledger). The
// region_tracker handler lives in own.mn — region_enter pushes a
// fresh Region id onto a stack; region_exit pops; tag_alloc stamps
// the current-top region onto an alloc return; check_escape
// compares a returned value's region against the ambient region
// on fn return.
fn mk_tok(kind, sl, sc, el, ec) = Tok(kind, Span(sl, sc, el, ec))

effect RegionTrack {
  region_enter(Span) -> Int
  region_exit(Int)
  tag_alloc(Int)
  tag_alloc_join(Int, [Int])
  // value_handle, field_handles —
  // tag with the deepest (innermost)
  // region across (current, fields).
  // Used by record/variant construction.
  check_escape(Int, Span)
}

// StringTable (spec W5) — compile-time interned string literals.
// `emit_plan` collects every LString in the lowered program, assigns
// each unique literal a 4-byte-aligned offset in the string-data
// region (0x10000..0x100000), and `emit_planned` writes the `(data ...)`
// segments. At LString emit time, `string_offset(s)` returns the interned
// offset; the generated WAT is `(i32.const <offset>)` with zero runtime
// construction. `set_string_entries` is called once by the plan after
// collection to populate the handler's state.
effect StringTable {
  string_offset(String) -> Int
  set_string_entries([(String, Int)])
}

// The execution strategy a fanout runs under, read by the lowering from the
// install that governs it. An ADT of scheduler classes, never a
// `mode==0/1/2` int (drift 8).
type Schedule = Seq | Threaded | Simd | Gpu | Persisted

// SpecTwins — the specialization registry (the StringTable pattern one shelf
// over): the plan's emitted reach decides ONCE which twins exist, seeds the
// registry, and every reference-emitting arm then asks spec_twin_known before
// redirecting a site's mangled key to a twin — a site whose key names no twin
// stays at the word-protocol floor.
effect SpecTwins {
  spec_twins_exist() -> Bool
  spec_twin_known(String) -> Bool
  set_spec_twins([String])
  // The fanout reach (graph.mn's one rule): whether a top-level fn reaches
  // a fanout through direct calls — the fact a direct call under a spawning
  // demand reads before it demands the callee's schedule twin. Computed on
  // the first ask and held; a module nothing demands never computes it.
  fanout_reach_known(String) -> Bool
  // A global call site's INSTALLED schedule — the innermost schedule-class
  // install of the site's own frame — noted by the lowering, which holds
  // the frame's chain, and read by the emit before it reads the bracket: a
  // site that installs one is governed by it (a `sequential_compose` inside
  // a threaded twin pins its calls sequential), and a site that installs
  // none inherits the demand the bracket carries.
  site_schedule_note(Int, Schedule)
  site_schedule(Int) -> Option(Schedule)
  // Whether any site was noted under a spawning schedule — the fact the
  // settle point's race walk reads before it walks: a module with none has
  // no demand chain to check and pays nothing for the rule's existence.
  threaded_site_noted() -> Bool
  // The callees of the sequence-fanout forms the lowering built since the
  // last drain — names the lowering introduced, which construction enqueues
  // beside the constructed decl's own references.
  fanout_form_note([String])
  fanout_form_drain() -> [String]
}

// EmitSite — WHERE an emit-time diagnostic is standing. A node minted after
// parse carries no span (`parse_span_of` answers zero on it), so a report at
// one is prose nobody can locate: the unprovable-comparison class's first
// census read 41 of its 56 sites at 0:0 with nothing to name them, which is a count standing in
// for a finding. The emission in flight IS the nearest true coordinate, and it
// is ambient by nature — installed once per fn record where the name is
// already in hand, read by whichever diagnostic needs to say where it stands,
// never threaded through the emit tree as a parameter. RETIREMENT: when a node
// minted after parse carries its nearest authored span
// (`Hβ.why.reason-span-is-a-weave-coordinate`'s family), the span says this and
// the effect goes.
effect EmitSite {
  emit_site() -> String
}

// Evidence (spec W4) — runtime witness of an effect-to-handler-arm
// binding. A polymorphic function that performs an op dispatches
// via an evidence slot: the caller threads the evidence record into
// the callee via `__state`, and the callee loads the arm's fn_idx
// from its evidence slot and invokes it through call_indirect.
//
// DESIGN Ch 4 "handler IS state" — closure captures and evidence
// slots are both frozen handler state, projections of the same
// underlying record. `__state`'s layout:
//   offset 0        : fn_ptr (i32, table index)
//   offset 4        : capture_count (i32)
//   offset 8+4*i    : the i-th capture      (i in 0..capture_count)
//   offset 8+4*C+4*j: the j-th evidence fn idx (C = capture_count)
// The body's evidence count and capture_count are known at emit time;
// the perform's offset arithmetic is compile-time-resolved.
type Evidence = Ev(String, Int)

// op_name, slot_idx — the slot in __state where
// the arm's fn_idx was written by the caller.
//
// ─── Stmt (spec 03) ────────────────────────────────────────────────
type Stmt
  // pat, value, annotation node — NTypeAnn(ty) when present; ABSENT
  // aliases the value node (the parser's no-fresh-mint sentinel at all
  // three LetStmt mints, keeping handle numbering unshifted for every
  // unannotated let). Readers include the channel only when it is
  // NTypeAnn — infer's arm and stmt_child_handles both read it so.
  = LetStmt(Pat, Node, Node)
  | FnStmt(String, [TParam], Node, [(EffName, Bool, EConn)], Node)
  // name, params (TParam), retty, effects, body
  | TypeDefStmt(String, [(String, [Ty], Node)])
  // name, then per variant its name + field types
  | EffectDeclStmt(String, [TParam], [(String, [TParam], Ty, Node)])
  // effect name, instance params, ops (each op is (op_name, params,
  // ret_ty, comment-carrier); ResumeDiscipline is inferred at
  // handler-decl time from each arm body, not declared on the effect
  // op). An op's params are parameters like a fn's: `print(msg: String)`
  // carries its name, and a bare `print(String)` is the wildcard `_`, the
  // spelling a function type's params already use. Until 2026-09-28 the
  // op kept its types alone, so `mentl fmt` rewrote the named form as the
  // bare one. The instance params are the parameterized effect's signature
  // (SYNTAX §«Parameterized effect»: `effect Sample(rate: Int)`) — the
  // same [TParam] product fn params and handler config ride; they
  // register as the effect's env scheme (the instance signature every
  // authored `Sample(44100)` judges against).
  | HandlerDeclStmt(String, String, [TParam], [{init: Node, name: String}], [{args: [String], body: Node, op_name: String}], [(EffName, Bool, EConn)])
  // handler name, effect name, config-params, state-fields, arms, the
  // authored `with` row (the same signed triples a FnStmt carries — until
  // 2026-09-27 the parser skipped it to the arms, so a handler's `!F` bound
  // nothing; A5 carries it: enforced on the arms at registration and on
  // every install's remainder through the handler's own absorption)
  // config: [TParam] — the fn-param carrier (SYNTAX §«Handler
  //   declarations»: the config list IS a parameter product, so
  //   each param carries the product's default slot); values are
  //   closure-captured at install site, absent fields fill from
  //   param_default through resolve_call_args
  // state:  List<{name: String, init: Node}> — per-arm scope; updates via `resume(...) with f = e`
  // The state element type is CARRIED in the ADT field
  // (not bare `List`) so `.name`/`.init` resolve to sorted
  // offsets at lower-time — never field-offset-resolution's
  // silent offset-0 fabrication on an erased element type.
  // arms:   List<{args, body, op_name}>
  // Per Hβ.first-light.handler-config-state-substrate (2026-05-06):
  // config + state extracted at parse time; bound in arm scope at infer + lower
  | ExprStmt(Node)
  | ImportStmt(String)
  | RefineStmt(String, Ty, Predicate)
  // type X = T where P — nominal refinement
  | AliasStmt(String, Ty)
  // type X = A + B — a named effect row (SYNTAX §«Named effect rows»):
  // the RHS is the with-clause's own signed-triple grammar, stored
  // verbatim (Hβ.types.named-effect-rows — one grammar, one
  // representation; expansion at build_declared_row, never in Ty)
  | RowAliasStmt(String, [(EffName, Bool, EConn)])

// A sequence in its runs (`runs_of`): adjacent members that join make ONE
// run and every other member stands alone. A block's `fn` declarations
// join, every name of the run in scope in every body of the run and in
// everything after it (`stmt_runs`); so do the closure bindings the emit
// mints together (`emit_minted_bindings`).
type Run = Joined([a]) | Lone(b)

// The runs of a sequence: `joins` reads each member as a one-member run,
// and adjacent joined runs merge.
fn runs_of(joins, xs) = fold([], run_step(joins), xs)

fn run_step(joins, runs, x) = {
  let member = joins(x)
  match member {
    Joined(ms) => match last_joined(runs) {
      Some(prev) => push(drop_last(runs), Joined(prev ++ ms)),
      None => push(runs, member),
    },
    Lone(_) => push(runs, member),
  }
}

// The joined run a list of runs ends with, if it ends with one.
fn last_joined(runs) = if len(runs) == 0 {
  None
} else {
  match last(runs) {
    Joined(members) => Some(members),
    Lone(_) => None,
  }
}

// type X = T — transparent alias (no `where`, RHS a
// single type-expression, not a record literal, not a
// `|`-alternation). Infer registers TAlias(X, T); X and
// T unify transparently (SYNTAX.md §«Type aliases»). The
// authored name travels in the TAlias for Reason chains.
//
// ─── Pat (spec 03) ─────────────────────────────────────────────────
type Pat
  = PVar(String)
  | PWild
  | PLit(LitValue)
  | PCon(String, [Pat])
  | PTuple([Pat])
  // prefix pats, optional rest name (`...rest`)
  | PList([Pat], Option(String))
  // [(fieldname, Pat)], optional rest name (`...rest` — SYNTAX
  // §"Pattern syntax for records": the rest binds a record of the
  // remaining fields, the list-pattern rest's sibling)
  | PRecord([(String, Pat)], Option(String))
  // pat_1 | pat_2 | ... — any branch matches; branches
  // bind the same names with unifiable types (SYNTAX.md
  // §"Pattern alternation — rule")
  | PAlt([Pat])
  // name @ pat — binds the WHOLE value AND destructures it
  // (SYNTAX.md §"As-patterns — rule")
  | PAs(String, Pat)

type LitValue = LVInt(Int) | LVFloat(Float) | LVString(String) | LVBool(Bool)

// Domain — what a refinement states about the INHABITANTS of a type, read as
// one fact rather than as the lower bound alone. A lower-bound walk once
// asked the same question for half of this and there was no upper half, so a
// `Bit = Int where 0 <= self && self <= 1` could prove its floor and say
// nothing about its ceiling.
//
// THE READING DIRECTION IS A CONTRACT: a Domain is an OVER-approximation of
// the true inhabitant set, never an exact one. Every consumer may therefore
// use it to decide what to CONSTRUCT (a superset misses nothing — the ??-fan's
// Strong Completeness) while the proof gate stays mandatory for what to ADMIT
// (a superset admits too much — Strong Soundness is the gate's, never the
// domain's). Meet keeps that direction by taking the decided side when one
// side is unreadable; join widens to the top when it cannot bound a side.
//
// `DRange` is integral because strict-to-inclusive needs a predecessor and a
// float has none; a float refinement reads `DUndecided` and its consumers fall
// to their floor, which is honest rather than wrong. The open/closed-bound form
// that would carry `Sample = Float where -1.0 <= self` is named residue
// (`Hβ.verify.domain-over-reals`), not a silent gap.
type Domain
  // inclusive lower and upper bounds; None is open. DRange(None, None) is TOP.
  = DRange(Option(Int), Option(Int))
  // exactly these inhabitants — the only exact answer the fragment gives
  | DFinite([LitValue])
  // the fragment stops here. Consumers treat it as TOP for construction; the
  // medium SAYS it rather than pretending the predicate was empty.
  | DUndecided

// Proposal — the oracle's ANSWER at a hole, as one value.
//
// The Synth op answered with a LIST, and a list is the medium admitting it
// does not know (PLAN §11.1). Five surfaces then re-derived the same verdict
// from `len` — the address render, the edit transport's accept path and its
// projection, the teach entry, the cursor's empty case — and the render's
// one-survivor arm DROPPED the Reason while its tie arm kept it: the medium
// showing its reasoning exactly when it is unsure and withholding it exactly
// when the developer is most likely to take the fill on faith. The verdict is
// computed ONCE, where the survivors are known, and read everywhere else.
//
// Rejections sit beside the verdict rather than inside it: a lone survivor
// coexists with three row-refused names, and the refusal teaches either way,
// so repeating the list per arm would be the same fact in three homes.
type Proposal = Proposal({rejected: [(String, Reason)], verdict: Verdict})

// A fill arrives WITH its reason because the constructor holds no other
// shape — the render cannot drop what the type does not let it separate.
type Verdict = VFill(Node, Reason) | VAsk(Divergence, [(Node, Reason)]) | VNone

// WHERE the survivors diverge — PLAN §11.1's first divergence, classified.
// Read from the facts the cursor already projects, never clustered from the
// candidate set, so there is no clustering to be bad at and no scaling in
// candidate count. Precedence is a judgment, most consequential first: a
// capability difference changes what the program may DO, so it outranks
// every other distinction; survivors that denote one value differ only in
// which name carries the intent; a value difference is a choice inside what
// the type admits, so the domain rides it; anything left is structure.
//
// A same-denotation tie is a MEANING tie at the intent altitude, not the
// free form-space tie of PLAN §5's duality. The duality calls a tie free
// when a COST function totally orders it, and cost is blind to what a later
// reader learns from a name — so `7` and `pure_seven()` are not
// interchangeable the way two extraction-equal forms are. Rank orders how a
// tie renders; the divergence is what decides it.
//
// The SOURCE of "which cell" is the trail first (C6): every candidate is
// judged as a segment over the one live graph, the segment carries out the
// context cells its binds moved (`graph_written_since`, read before the
// rollback), and the first of those cells that two survivors bound
// differently IS the divergence — a type cell renders as `DivType` with the
// cell's own Reason, a row cell as `DivRow`. Only when no context cell moves
// — the position was narrowed enough that every survivor fits without
// teaching the context anything — is the question about the TERM itself,
// read off the survivors as before: row, then denotation, then value, then
// shape. The classification and its voice stand either way.
type Divergence
  // the first two survivors whose rows differ, in rank order
  = DivRow(EffRow, EffRow)
  // a context cell two survivors bound to different types, with the cell's
  // own Reason — the proposition the developer never stated, in their
  // vocabulary (the type of a parameter, a return, the position itself)
  | DivType(Ty, Ty, Reason)
  | DivName
  // what the target type admits — the same read that seeded the candidates
  | DivValue(Domain)
  // the survivors are a sum's own nullary constructors — its values, named
  // (C7: Circle against Square is a VALUE question, asked as shape before)
  | DivVariants([String])
  | DivShape
  // survivors at a FUNCTION-typed hole: different computations of one type
  | DivBehavior

// Decidable shape. Verify discharges: ledger (Phase 1) accumulates;
// verify_smt (Arc F.1) routes by theory — Z3 / cvc5 / Bitwuzla.
type Predicate
  = PTrue
  // op over two operand node HANDLES — graph_node_body resolves each Expr live; the AST lives in the graph, the predicate carries the edge
  | PCompare(BinOp, Int, Int)
  | PAnd(Predicate, Predicate)
  | POr(Predicate, Predicate)
  | PNot(Predicate)
  // predicate IS a bool expr node, by handle (a boolean call or bare bool var folds in here)
  | PBoolNode(Int)
  // scrutinee node handle matches pat — match-narrowing
  | PPatternMatch(Pat, Int)
  // IFC obligation (§4⑥): src ⊑ dst in the flow lattice.
  // Compile-time decidable by flow_le — ALWAYS Some(true/false),
  // never deferred. verify(span, PFlowLe(src, dst), reason)
  // IS the flow check; ERefinementRejected carries the violation.
  // No new effect op, no new diagnostic, no new handler arm.
  | PFlowLe(FlowLabel, FlowLabel)
  // the `self` BINDER: the value-node handle self resolves
  // to, carried WITH the predicate as data. self may sit
  // NESTED inside an arithmetic operand (`self + 1`), where a
  // physical operand swap cannot reach without minting a
  // rewritten node — the binder threads through
  // predicate_decide_at into every node_const_at instead.
  // Appended LAST so existing variant tags are unshifted.
  | PWithSelf(Int, Predicate)
  // A PARTIAL PRIMITIVE's precondition, as the claim it is (C5,
  // 2026-09-30): the operator, the dividend node and the divisor node of
  // an integer `/` or `%`. Integer division traps on a zero divisor, and
  // `/` also on INT_MIN / -1; the claim decides from the operands'
  // constants and from what their refined types exclude, refuses at a
  // constant zero, and where it stays open the site charges `Trap` into
  // the row — partiality as a row fact, so `!Trap` proves its absence
  // and the e-graph never drops an operand that could trap.
  | PTotalDiv(BinOp, Int, Int)
  // A PROVISION (H4·D, 2026-10-01): what the body that holds a function
  // hands it at one position. A function-typed parameter that learns its
  // contract learns, at each position, an EDGE to every node its
  // applications hand that position — read live wherever a function
  // crosses into the contract, so a demand is decided against the value
  // handed (`5` proves `Positive`, `0` refutes it) rather than against a
  // contract copied off the value's leaves, which a constant never had. A
  // provision states what ARRIVES, never what is demanded: read as a claim
  // it holds. Inference mints it; it has no surface spelling.
  | PProvides(Provided)

// What one position of a function is handed: nothing yet — no application
// has reached it, the identity of the join — the values at these nodes, or
// the values at these nodes and others nothing here can name. The nodes are
// kept beside the unnamed ones: a function handed there is still judged,
// and a value handed there still refutes a demand it breaks.
type Provided = ProvidedNone | ProvidedAt([Int]) | ProvidedBeyond([Int])

// PExpr is DELETED: its leaves (PSelf/PInt/PEVar/PApp) were a lossy COPY of the
// expression the AST node already holds (the deleted node_to_pexpr re-derived it with a
// `_ => PEVar("?")` surrender). The predicate now carries the live operand Node
// and Verify reads its Expr live — carry the handle, read live, delete the copy.
//
// ─── FlowLabel — the IFC frontier (PLAN.md §4⑥, SYNTAX.md §4⑥) ──────────
//
// The three-level information-flow lattice. Every expression node in the graph
// carries a FlowLabel alongside its Ty and EffRow; infer accumulates it at
// MakeStringExpr splice sites and at handler-install boundaries.
//
// Lattice: Public ⊑ Tainted ⊑ Secret.
//   Public  — safe to observe and log. Default for all unannotated expressions.
//   Tainted — derived from a Secret via a computation (e.g. hash(secret)) — the
//             result is not the secret itself, but the path touched it. Tainted
//             stays tainted through further transformations until an explicit
//             declassify annotation proves the result provably non-invertible
//             (arc F.1 SMT discharge).
//   Secret  — must not flow into any Public observable (log, network, stderr).
//             `"msg: {secret}" ~> Log` is E_IFCFlowViolation: the string splice
//             carries secret's label UP into the string literal, which then
//             flows into the IO-row Log handler — a non-interference violation
//             the type system proves before runtime.
//
// Why a 3-level lattice instead of 2? Tainted models the realistic case where
// secrets MUST be used in computation (signing keys, HMAC) — the output of
// those computations is not the secret, but tracing taint through them is
// necessary for IFC completeness. The lattice has a meet (Public) and a join
// (Secret); Tainted is the intermediate that lets us distinguish "used secret"
// from "IS secret".
//
// Per SYNTAX.md §4⑥: the IFC flow-constraint is sequenced after first-light.
// The ADT is real now; infer.mn's MakeStringExpr arm emits the flow check when the
// splice is Secret or Tainted into a Public-bound context (Arc F.1 discharge).
// The handler swap is verify_smt (not verify_ledger). No new surface form.
type FlowLabel
  // safe to observe; default for all unannotated expressions
  = Public
  // derived from Secret through computation — carries the taint
  | Tainted
  // must not flow into any Public-observable (log/net/stderr)
  | Secret

// flow_label_join — lattice join: the label of a derived expression reaches the
// join of its operands' labels. Pure — the lattice is a compile-time fact.
// H6: exhaustive over all 3×3 pairs; no wildcard arms on a load-bearing ADT.
fn flow_label_join(a, b) with Pure = match a {
  Secret => Secret,
  Tainted => match b {
    Secret => Secret,
    Tainted => Tainted,
    Public => Tainted,
  },
  Public => match b {
    Secret => Secret,
    Tainted => Tainted,
    Public => Public,
  },
}

// flow_le — lattice order: a ⊑ b (a is at least as restrictive as b).
// Public ⊑ Public ⊑ Tainted ⊑ Secret. H6: exhaustive over both dimensions.
fn flow_le(a, b) with Pure = match a {
  Secret => match b {
    Secret => true,
    Tainted => false,
    Public => false,
  },
  Tainted => match b {
    Secret => true,
    Tainted => true,
    Public => false,
  },
  Public => match b {
    Secret => true,
    Tainted => true,
    Public => true,
  },
}

fn show_flow_label(label) with Pure = match label {
  Public => "Public",
  Tainted => "Tainted",
  Secret => "Secret",
}

// Option lives in lib/prelude.mn — the vocabulary type at the vocabulary
// home, ONE declaration serving the wheel's self-build (src+lib) and every
// program that links the prelude.
//
// Scoped bindings via push/pop mark. Env is never passed as argument.
// Every read performs env_lookup; every write performs env_extend.
// Entries are 4-tuples (name, Binding, Reason, SchemeKind) — SchemeKind
// carries construction-origin metadata that lower dispatches on.
// Scoped bindings via push/pop mark. Env is never passed as argument.
// Every read performs env_lookup; every write performs env_extend.
// Entries are 4-tuples (name, Binding, Reason, SchemeKind) — SchemeKind
// carries construction-origin metadata that lower dispatches on. The
// module a name is DECLARED in is deliberately not an entry field: an
// entry is re-published wherever a judgment further on refines it (a handler's
// registration re-publishes its ops, a caller's resolution a HOF's row),
// so the publisher's module is not the declarer's. The declarer is the
// statement's own column, read once per judgment (`inf_decl_module`, F0b).
// The OP VOCABULARY declares HERE — the lowest module every performer
// imports — while the handlers live at their subsystem (pipeline.mn);
// the effects prepass phase (pre_register_effect) makes the pair
// order-independent regardless of the split.
type Env = Env([(String, Binding, Reason, SchemeKind)])

// [(name, Binding, Reason, SchemeKind)]
effect EnvRead {
  env_lookup(String) -> Option((Binding, Reason, SchemeKind))
  env_lookup_type(String) -> Option((Binding, Reason, SchemeKind))
  env_lookup_ctor(String) -> Option((Binding, Reason, SchemeKind))
  env_lookup_variants(String) -> Option((Binding, Reason, SchemeKind))
  // Whether the name's live binding is MODULE-LEVEL: published below every
  // open scope mark. The env is the scope stack, so the entry's position
  // is the fact — false for a parameter, a let, a nested fn, and for a
  // name bound nowhere.
  env_lookup_is_global(String) -> Bool
  env_snapshot() -> Env
}

effect EnvWrite {
  env_extend(String, Binding, Reason, SchemeKind)
  env_scope_enter()
  env_scope_exit()
}

// The branch cursor's env join surface (Phase C, C1c-2). Both ops are
// armed on env_handler and answer BY INSTANCE POSITION: performed
// outside any branch bracket they read the ROOT's live triple (the
// layer-start base capture); performed inside one they read the
// BRANCH's private entries (the publish log the join replays). A
// separate effect — not new EnvRead ops — so no other handler's arm
// set grows (the one-handler-two-effects precedent).
effect BranchEnv {
  // The index is env_index_new's concrete shape — a free var here would
  // PARAMETERIZE the effect and the handler-arm binding refuses a
  // parameterized/bare mix on one handler (measured: BranchEnv(t) vs
  // EnvWrite at both arm sites).
  // The fourth component is the base's MODULE-LEVEL extent — the root's
  // first open scope mark, or its count when no scope is open — so a
  // branch instance answers env_lookup_is_global for a base hit exactly.
  env_base_view() -> ([(String, Binding, Reason, SchemeKind)], Int, [[(String, Int)]], Int)
  env_publishes() -> [(String, Binding, Reason, SchemeKind)]
}

// The lex-name intern (§5.O layer 1) — an identifier's canonical String
// instance, handle, and keyword classification, resolved ONCE per unique
// name. lex_from performs it at every identifier; a repeat occurrence is a
// hash probe returning the SAME String pointer — zero allocation, zero
// keyword compares (the row carries the kind, classified at first sight).
// Handle 0 is reserved = absent; handles are per-install and never cross
// an analysis bracket (a nested infer_context minting its own table is the
// isolation the session-weave contract demands at the name layer). Handled
// by intern_table (pipeline.mn), innermost in the analysis core; the op
// vocabulary declares here, the lowest module every performer imports.
effect Intern {
  intern_span(String, Int, Int) -> (String, Int, Option(TokenKind))
  intern_str(String) -> Int
  intern_name_of(Int) -> String
  // The branch view's config seed (the fan): the root's live table,
  // read once per walk. A spawned cursor's view serves READS (probe
  // hits and name_of — every name interns at parse, so the walk is
  // pre-warmed); its miss is LOUD by construction (a view-minted
  // handle escaping into published state would render garbage at the
  // root — never an accident-invariant).
  intern_seed() -> ([[(String, Int, Option(TokenKind))]], [String], Int)
}

// The Read/Write split IS the "one writer" invariant. Inference
// declares both; lowering, query, display declare Read only.
// A perform graph_bind in a read-only handler is a type error at
// handler install — caught structurally, never shipped to runtime.
//
// graph_push_checkpoint / graph_rollback are the speculative surface:
// Mentl's oracle captures the trail length, tries a tentative patch,
// rolls back to restore. Trail-based; O(M) where M is mutations.
effect GraphRead {
  graph_chase(Int) -> GNode
  // the canonical ROOT handle of a TVar chain (union-find find)
  graph_chase_handle(Int) -> Int
  graph_epoch() -> Int
  // the fresh-handle counter — the node-space bound for saturation
  graph_next() -> Int
  // the handle's OWN reason cell, unchased — a bind's VarLookup survives here even when the bound type is a var the chase would follow; the stmt-layer projection reads reference edges through it
  graph_reason_at(Int) -> Reason
  graph_snapshot() -> Graph
  graph_push_checkpoint() -> Int
  // resolve a node's body by its handle from the parallel program weave — every AST node is registered there at construction (NHole if absent)
  graph_node_body(Int) -> NodeBody
  // the birth-span by HANDLE — the spans spine column's O(1) read (the
  // ordered (span, handle) log stays for containment scans; this is the
  // by-handle projection of the same one write)
  graph_span_of(Int) -> Span
  // the module a node was BORN IN — read from the spine's own column, never
  // re-derived by scanning weave ranges for one that contains the node's
  // line. TOTAL: every node is born inside a module, stdin's included, so
  // there is no absent case and no reader needs a "which file, if any" arm.
  graph_module_of(Int) -> Int
  // the node whose body holds this one, drawn where that body registers, so a
  // question about what surrounds a node walks up its ancestry; None for a
  // module node and for a node no body holds
  graph_parent_of(Int) -> Option(Int)
  // the module currently in force — what the next mint will be attributed to.
  // Read by the diagnostics register to stamp a report with the file it is
  // about, which is how narration scopes to the module the user named now
  // that spans are local and a line range no longer distinguishes files.
  graph_module_current() -> Int
  // Whether a node belongs to the CURRENT generation of its module: false
  // for every node born in a module node that a later parse of the same
  // path superseded. A resident session holds each re-judged module's older
  // generation below the current one, and a read that does not ask this
  // answers about a program that no longer exists — measured 2026-10-02,
  // the proposer offering `main()` at a hole `main` calls, after one edit.
  graph_node_current(Int) -> Bool
  // the current module node of a path — the latest parse registered under
  // it, read where the registration happened rather than by walking the
  // whole graph for module cells and keeping the last
  graph_module_now(String) -> Option(Int)
  // every current module node, in the order the modules were registered
  graph_modules() -> [Int]
  // resolve a node's parse-attached comment prose from the parallel comment weave (empty string if absent); the Why engine / formatter / cursor project it
  graph_comment_at(Int) -> String
  // the comment's own source span, carried from parse (zero span if absent) — the reference diagnostics anchor here
  graph_comment_span_at(Int) -> Span
  // draw a resolved comment-reference edge (owner node -> referent decl node); drawn once at the infer tail
  graph_attach_comment_ref(Int, Int)
  // reverse read: the comment owners referencing this decl — the audit's referenced-by projection
  graph_comment_refs_of(Int) -> [Int]
  // the e-graph canonical pointer at a handle — the equivalence weave's find step (returns the handle itself if it is its own e-class root). One co-indexed weave, exactly like the nodes column's TVar union-find; egraph_extract chases it live.
  graph_canon_at(Int) -> Int
  // the refinement-narrowing pointer at a handle — the path-predicate's bool-node handle proven to hold AT this program point (0 = no narrowing). One co-indexed weave like the canon column; lower's verify-obligation read chases it live to elide a check the path already proves (§4⑥). Appropriate as a side-table: narrowing is a per-program-point boolean fact, not a unifiable variable.
  graph_narrow_at(Int) -> Int
  // exact compiler-created executable edges keyed by fanout site
  // The branch cursor's config seed (the fan, C1c-2): the root's live
  // spine table, open count, and span index, read once after the plan
  // pre-opens every band — the spine is then stable for the whole walk
  // and the span index is complete (graph_index_span is parse-only, so
  // no branch ever appends). A branch graph_handler installs over
  // these with its stmt's planned range as (next0, limit0).
  graph_boundary_at(Int) -> ExecutableBoundary
  graph_branch_seed() -> ([SpinePage], Int, [(ValidSpan, Int)])
  // The REVERSE-EDGE column's read: every reference handle noted under
  // NAME (newest first — the column prepends). refs_of_name's whole-
  // graph VarRef scan and the oracle's quadratic count_dependents both
  // retire onto this O(bucket) read.
  graph_refs_at(String) -> [Int]
  // The APPLICATION edge's read: every application handle noted under
  // NAME, newest first — the reverse call graph a reader follows where it
  // would otherwise scan the graph for call nodes (the gradient's bracket).
  graph_applies_at(String) -> [Int]
  graph_decls_at() -> [Int]
  // The value-holes column's read: (hole handle, entry name) pairs — the
  // executable gate's whole input (lowering-is-a-column (ii), the first
  // walker swap; the four-fn LowExpr walk retired onto this read).
  graph_holes_at() -> [(Int, String)]
  // The emittable-fn enumeration's by-name read: every entry noted under
  // NAME (the identity projection beside the ordered column). The
  // synthesized-family repr read and the enumeration reader take this
  // instead of scanning the column.
  graph_emitfn_at(String) -> [EmitFnEntry]
  // THE SIGNATURE COLUMN's read (lowering-is-a-column (ii)): the emitted
  // symbol's settled ABI. None means no record minted that symbol — a
  // hand-written runtime fn, whose face is the word floor. The floor is
  // still a floor, but it is now ONE floor at ONE key, so a caller and a
  // callee cannot floor differently: that difference was the miscompile.
  graph_sig_at(String) -> Option(EmitSig)
  // The GATE column's read: every gate carried by this cell, newest
  // first. A cell with none answers the empty list — the common case,
  // one bucket read.
  graph_gates_of(Int) -> [Gate]
  // The INSTANCE column's read: every fresh copy instantiate minted from
  // this cell while its declaration was still open — the copies an exit
  // install would otherwise miss (a self-reference or a cycle member
  // instantiating a pre-registered or assumed scheme before the
  // declaration's own exit gated the root).
  graph_instances_of(Int) -> [Int]
  // The DEMAND column's read: every demand entered on the type cell
  // (TypeDemand) — read by the checking var binds, by instantiation's copy,
  // and by the twin key, which keys a variable by its structure exactly when
  // a shape demand reached it.
  graph_demands_of(Int) -> [TypeDemand]
  // The ROW NOTE column's read: every row the judgment charged at this
  // node, newest first (a node that charged nothing answers the empty
  // list). row_of_subtree folds it over a subtree.
  graph_rows_at(Int) -> [EffRow]
  // THE BINDER FACT's read (P0): what the graph knows of a binder the value
  // walk reads through — a declared parameter or a constructor field's
  // binder — by its handle; None for every other handle.
  graph_binder_of(Int) -> Option(BinderFact)
  // THE LATE PAYERS' read (P0): every frame row cell that called through an
  // open guard cell — its declaration not yet exited — newest first.
  graph_late_payers(Int) -> [Int]
  // THE CLAIMS' read (P0): every contract claimed of the value at this
  // node, newest first. At a hole it is what the fill must satisfy; at a
  // let's value it is the annotation a reader of the binder may stand on.
  graph_claims_of(Int) -> [Ty]
  // A node's OWN link: the handle its binding names when it is bound to a
  // bare variable, read without chasing. A reference is bound to its
  // binder's cell exactly so (infer_var_ref), which makes this the edge
  // from a use to what it uses — the one the value walk follows, where the
  // chase would hand back the class root, which a join or an operator may
  // have merged with values the binder never held.
  graph_link_of(Int) -> Option(Int)
  // THE SEGMENT'S WRITE SET (C6): the cells below a handle frontier that a
  // bind since a checkpoint moved — a type or row cell overwritten in the
  // trail's MSetNode / MSetRow entries — each once, in first-write order.
  // A speculative segment reads it BEFORE its rollback, so what a candidate
  // taught the context survives the undo as facts about those cells; the
  // handles above the frontier are the segment's own mints and mean nothing
  // across segments (they collide numerically after rollback).
  graph_written_since(Int, Int) -> [Int]
}

// THE ROW WRITES ARE THEIR OWN EFFECT because they have two handlers with
// two jobs: `graph_handler` answers them RAW, and `row_gate` (effects.mn),
// installed innermost at every judgment chain, answers them JUDGED — a bind
// or a finalize is checked against every gate its target cell carries and
// the gates ride the value's free terminals before the raw write is
// forwarded outward. That is LENS §2.3 lemma (i)'s premise ("every writer
// refuses a violating write and pushes as stated") as a fact of an
// install's extent rather than of a wrapper each writer remembers to call:
// inside a judgment a raw row write is unsayable, since the perform reaches
// the judged handler first. One effect for both jobs would make either
// handler partial (`E_HandlerInexhaustive`); a capability of its own is the
// form (2026-09-30, A7).
effect RowWrite {
  graph_bind_row(Int, EffRow, Reason)
  // the decl-exit REPLACE — inf_exit_fn publishing the frame's accumulated row as the fn's verdict. Distinct from graph_bind_row BY OP because the two writes have different algebra: a teaching bind on an already-bound row cell JOINS (the row is a join-semilattice; joins commute, so N caller branches teaching one cell converge to the same value in any order — LVars' law), while the finalization REPLACES (the frame's accumulation is the decl's own total, already containing everything taught)
  graph_finalize_row(Int, EffRow, Reason)
  // union-find path compression at the row sort — an OPTIMIZATION write, distinct from the judgment bind: it stores the cell's own resolved content, so no gate can be violated by it and the judged handler forwards it unjudged; the root's arm rebinds the chain link to its resolved terminal
  graph_compress_row(Int, EffRow)
}

effect GraphWrite {
  graph_fresh_ty(Reason) -> Handle
  graph_fresh_row(Reason) -> Handle
  // edge-link a node's body into the one graph at its handle (the program column of the handle's page); resolves via graph_node_body
  graph_register_node(Int, NodeBody)
  // attach parse-collected comment prose + its span to a node's handle (the comment column of the handle's page); resolves via graph_comment_at — a comment is graph content
  graph_attach_comment(Int, String, Span)
  // restore a comment cell to the column's absent form ("", zero span) — the seam re-homing's take-side; attach cannot clear because its arm MERGES behind existing text
  graph_clear_comment(Int)
  // draw the e-graph equivalence edge from ≡ to — point the from-side's canonical pointer at the cheaper target. The union-find union step over the equivalence weave; saturation reads it back via graph_canon_at (find). Idempotent: re-pointing an already-rooted source overwrites in place (one cell), never grows a ledger.
  graph_canon_set(Int, Int)
  // draw the refinement-narrowing edge — point the program point's narrowing pointer at the path-predicate's bool-node proven to hold there (§4⑥). One co-indexed weave like the canon column; idempotent (one cell per handle), read back via graph_narrow_at by lower's check-elision.
  graph_narrow_set(Int, Int)
  // draw/replace one fanout's executable edges; trail-backed because inference runs under speculative checkpoints
  graph_boundary_set(Int, ExecutableBoundary)
  // set the module in force for every SUBSEQUENT mint — the parser's own
  // "which file am I in", carried at birth instead of reconstructed. The
  // driver mints a module's NModule node, enters it, and parses that module;
  // every node born under it is attributed by construction. The module node
  // attributes ITSELF, so the column is total with no sentinel: entering a
  // module is what parsing a file is, and there is no parse outside one.
  graph_module_enter(Int)
  graph_bind(Int, Ty, Reason)
  // mark a node an OBSERVED FAILURE (NErrorHole) — the productive-under-error poison. An env miss binds this, never TVar(self): the self-var tripped graph_bind's own occurs check (a spurious 0:0 E_OccursCheck per missing name) and read downstream as a normal free var (the ownership move-default cascade). A hole is the fact itself: unify no-ops on it, generalize preserves the handle, consumers stay silent.
  graph_bind_hole(Int, Reason)
  // enter a gate on a cell — trailed (MSetGate), so a speculative
  // judgment's gates roll back with its bindings; the checking writer
  // (effects.mn gate_install) is the one caller, and it judges the
  // cell's current content and every noted instance in the same move
  graph_gate_add(Int, Gate)
  // note a fresh instance under the root it was copied from — trailed
  // (MInstanceNote); build_inst_mapping is the one writer, and a gate
  // installed on the root later reaches the copy through this column
  graph_instance_note(Int, Int)
  // enter a demand on a type cell — trailed (MSetDemand), so a speculative
  // judgment's demands roll back with its bindings; the judgment's demand
  // sites, the checking var binds and instantiation's copy are its callers
  // (infer.mn demand_install / demands_copy)
  graph_demand_add(Int, TypeDemand)
  graph_bind_record_row(Int, [(String, Ty)], RecordRowTail, Reason)
  graph_rollback(Int)
  // The speculation's ACCEPT: pop the newest checkpoint WITHOUT
  // restoring — every write since it stands, and mutation events
  // resume when the stack empties. graph_rollback is the reject half;
  // a speculative judgment that SUCCEEDS (the Mycroft retry, §11 5.3)
  // commits through this op — leaving the record on the stack forever
  // would suppress graph_mutated for the rest of the compile.
  graph_commit_checkpoint(Int)
  graph_index_span(ValidSpan, Int)
  // The REVERSE-EDGE column's write (Hβ.graph.reverse-edge-and-bound-
  // projection, the 5.5 column arc's opener): infer_var_ref — the ONE
  // writer, where the use edge is drawn — notes (name → the reference's
  // handle) into the smap column, O(1) prepend per reference. The read
  // face is graph_refs_at; three whole-graph scans retire onto the pair.
  graph_ref_note(String, Int)
  // The APPLICATION edge's write: `call_owes`, the one home where an
  // application fills a declaration's parameters, notes (the name applied →
  // the application's handle) for each top-level declaration its callee can
  // be. The refs column's contract: append-only, so a reader re-reads the
  // application at the handle and drops what no longer is one.
  graph_apply_note(String, Int)
  // The decls column — the refs column's sibling at decl granularity:
  // the FnStmt judgment notes its own node handle; the read face is
  // graph_decls_at (the oracle queue's seed). Judgment rounds re-note,
  // so readers dedup by handle.
  graph_decl_note(Int)
  // The value-holes column's writes: lower's authored-hole arm NOTES the
  // surviving hole (value-position is a lowering decision — a consumed
  // call-arg/pipe hole never reaches that arm), and each constructed
  // entry DRAINS pending holes against its own name, so a hole pairs
  // with the name reachability speaks ("" = a module value let, always
  // live via __init_lets). Append-only telemetry, the decls-column
  // contract.
  graph_hole_note(Int)
  graph_hole_drain(String)
  // THE ACCEPT EDGE's write (C4): a proposal accepted at a hole is a
  // fact of the GRAPH first and of the text second. The column holds
  // (module path, the extent the accepted text occupies in that module's
  // own coordinates, the rendered text, the proof it was proposed with),
  // and graph_bind reads it at the one writer: a node minted at that
  // extent is bound with its reason wrapped in `Accepted`, so the Why
  // engine walks from the value to the proposal that proved it. Keyed by
  // POSITION rather than handle because the transport re-parses the
  // module after the splice and the accepted value's node is minted
  // anew (Hβ.synth.accepted-edge-keyed-by-position). An outermost-
  // boundary write, never speculative: the arm traps on a non-empty
  // checkpoint stack rather than store a fact a rollback would lose.
  graph_accept_note(String, Span, String, Reason)
  // THE WRITE GUARD'S REFUSALS, STORED BY THE ARM AND REPORTED BY THE BODY.
  // graph_bind's occurs belt cannot report where it stands: a diagnostic
  // performed from inside an arm resolves OUTER of its own install, so it
  // sails past any capture bracket installed deeper — which is exactly
  // where speculation installs one. Measured: infer_fn_speculative's
  // poly_capture saw only body-raised T_OverDeclared, never the refusal it
  // retries on, so held_has_poly was false and the Mycroft fragment never
  // ran (Hβ.diag.an-arms-report-escapes-an-inner-capture).
  //
  // So the arm STORES the refused fact with its module and inference DRAINS
  // it at the judgment boundary, where the report is rendered in the body's
  // world and every bracket that should see it does. Same shape as the holes
  // pair above, one concern over: an arm may note, only the body may narrate.
  graph_guard_drain() -> [(DiagKind, String)]
  // The pipe completion's retraction: a stage's `??` slot lowers (the
  // note fires at the visit) and is then spliced over by the piped
  // value — consumed, not surviving. The unnote removes it from the
  // PENDING half only; a drained pair is a survival by construction.
  graph_hole_unnote(Int)
  // THE ROW NOTE (C5): what a construct charges, noted on the node that
  // charges it — the frame join's per-node twin, written by the same
  // writer (inf_add_row_at) in the same move, trailed as MRowNote so a
  // speculative judgment's notes roll back with its bindings. A subtree's
  // row is then a READ over structure (row_of_subtree, graph.mn), which is
  // what the e-graph's purity gate needs and what the frame-keyed row
  // could never give a sub-expression.
  graph_row_note(Int, EffRow)
  // THE BINDER FACT's write (P0): a declared parameter's precondition and
  // guard, noted where the parameter is declared and again where the
  // judgment learns or charges it; a constructor field's binder, noted
  // where its pattern binds — trailed as MBinderFact, so a speculative
  // judgment's notes roll back with it; the newest note is the fact.
  graph_binder_note(Int, BinderFact)
  // THE LATE PAYERS' write (P0): a call reached a guard cell its
  // declaration has not written yet, so the frame owes whatever the exit
  // writes there. Keyed by the open cell, the payer's row cell the value;
  // trailed as MOweLate, so a rolled-back judgment's payments go with it.
  graph_owe_late(Int, Int)
  // THE CLAIMS' write (P0): a refinement claimed of the value at a node,
  // noted by `claim_refinement` where the claim is raised. Trailed as
  // MClaimNote, so a rolled-back judgment's claims go with it.
  graph_claim_note(Int, Ty)
  // The bind-home column's write (Hβ.lower.lowering-is-a-column step i):
  // lower's VarRef resolution arm — the ONE decision site — notes its
  // ls_resolve verdict at the use node's handle, an in-place spine cell
  // store. Non-trailed by the ref-note contract: lowering runs after
  // judgment, a re-lower overwrites with the same verdict. The read
  // face lands with step iii's re-rooted emit walk.
  graph_bind_note(Int, BindHome)
  // The dispatch-tier column's write (lowering-is-a-column step i): the
  // perform/wasi fork's arms note the chosen tier at the node's handle —
  // an in-place spine cell store, non-trailed by the bind-note contract.
  graph_dispatch_note(Int, DispatchTier)
  // The state-slot-home column's write: the resume-commit construction
  // notes its update pairs (field name, slot offset) at the resume
  // node's handle — same in-place, non-trailed contract.
  graph_state_slots_note(Int, StateSlotHome)
  // The install-shape column's write: the ~> install's lowering notes
  // the shape at the install node's handle — same in-place, non-trailed
  // contract.
  graph_install_note(Int, InstallShape)
  // Its read, by the install's handle: the install emit, a perform the
  // install answers in its own frame, and the emitted reach all key the
  // install's arms from one home.
  graph_install_at(Int) -> InstallShape
  // The call-product column's write: the judgment notes each call's
  // positional product at the call node — the ONE reader of a callee's
  // parameters — trailed as MSetProduct so a rolled-back judgment leaves no
  // product at a reused handle. Its read is the lowering's, which resolves
  // no callee by name (Hβ.lower.callee-resolved-by-name-in-the-module-env).
  graph_product_note(Int, [Node], [Int])
  graph_product_at(Int) -> CallProduct
  // The emittable-fn enumeration's write (the no-mint resolution):
  // each of lower's seven LFn construction sites notes (kind, origin
  // handle, deterministic name, fence, captures) at the moment those
  // facts are final. Captures are (name, binding-time handle) pairs —
  // the outer-frame reads a body projection re-derives through the
  // enclosing entry's own layout; the PARTIAL and ARM kinds pass []
  // because their capture sets are program-live (the partial's are
  // the call node's own args; the arm's are the handler record's
  // state/config fields, read via __state by the fence contract).
  // Append-only, non-trailed (the decls contract). The read face
  // lands with step iii's enumeration-walking emit; its read-side
  // contract filters by the reach set — lower runs on every decl,
  // emit does not.
  graph_emitfn_note(EmitFnEntry)
  // THE SIGNATURE COLUMN's write — ONE call per compile, carrying the whole
  // table. Not a note-per-symbol: the settling point is a MOMENT (the
  // infer->lower/emit boundary, after every record and every twin bracket is
  // known), and a fact that settles at a moment is written at that moment,
  // whole. N notes would re-open the window a reader could observe half a
  // table through, which is the time-varying read this column exists to end.
  graph_sigs_publish([(String, EmitSig)])
}

// ─── Diagnostics as a graph projection (SYNTAX.md §Diagnostic catalog) ──
//
// A diagnostic's IDENTITY lives on the DiagKind ADT — one constructor per
// E_/V_/W_/T_/P_ code, each carrying ONLY the structured operands its
// message needs (an EffRow, a Ty, a name) plus its Located Span. The
// source, kind (severity class), applicability, and the rendered
// `message` are all PROJECTIONS of the constructor (diag_source / diag_kind
// / diag_applicability / diag_message below) — never string literals copied
// at the call site. So `mentl diagnostics` is `diag_*` walking the DiagKind
// constructors; the SYNTAX.md catalog tables are worked examples of THIS
// ADT, not a parallel hand-maintained registry (drift-8 closed). The
// hover-text and the stderr error-text are byte-identical projections of one
// graph — the Carried-Truth Law at the diagnostic layer (read the operand
// live; never pre-render and copy the String).
//
// Applicability is the four-value automation axis (SYNTAX.md): an ADT, never
// a string. MachineApplicable auto-applies; MaybeIncorrect confirms;
// HasPlaceholders fills in; Unspecified is text-only.
type Applicability = MachineApplicable | MaybeIncorrect | HasPlaceholders | Unspecified

// Severity is the error-vs-narration axis. The category (format-liftable /
// hard error / gradient narration) is the PRODUCT of severity × applicability
// (SYNTAX.md: "the category is their product, not a third column"), read by
// the consumer, never a stored third field.
type Severity
  // a substrate violation
  = SError
  // gradient narration / format-liftable
  | SWarning
  // accrued proof debt (V_Pending)
  | SVerificationPending

type DiagKind
  // ─── parser (P_/E_) ──────────────────────────────────────────────
  //
  // expected one kind, found another
  = PExpectedToken(String, Span)
  | POrphanDocstring(Span)
  // construct name
  | PUnclosedConstruct(String, Span)
  // context note
  | PUnexpectedToken(String, Span)
  | ERedundantBraces(Span)
  | EBlockNeedsBraces(Span)
  | ELambdaFence(Span)
  | ERedundantFnOnLambda(Span)
  | ELambdaAsOrOr(Span)
  | EOrphanHandlerAttach(Span)
  // the typed keyword
  | ENotAKeyword(String, Span)
  | EEffArgNotLiteral(Span)
  // invariant note
  | EInternalInvariant(String, Span)
  | WRedundantWhere(Span)
  // owner name, referenced name, the comment's span
  // ─── infer (E_/T_) ───────────────────────────────────────────────
  | WCommentRefUnresolved(String, String, Span)
  // a vs b — operands carried live
  | ETypeMismatch(Ty, Ty, Reason, Span)
  // type-list arity a vs b
  | ETypeArityMismatch(Int, Int, Span)
  // ctor name, declared fields, pattern binds
  | EConstructorArity(String, Int, Int, Span)
  // op name, declared params, arm binds
  | EHandlerArmArity(String, Int, Int, Span)
  // fn param-count a vs b
  | EFnArityMismatch(Int, Int, Span)
  // handle occurs in ty
  | EOccursCheck(Int, Ty, Span)
  // the unresolved context (name / "constructor: X" / ...)
  | EMissingVariable(String, Span)
  // F0b (2026-09-27): the name resolves only because the whole link carries
  // it — declared in a module the referencing module never imports. Name,
  // the referencing module's path, the declaring module's path.
  | EMissingImport(String, String, String, Span)
  // the type name
  | ENotARecordType(String, Span)
  | EResumeOutsideArm(Span)
  // THE CUT (bank A3): a resume-bearing fn reachable from arms of TWO different handlers — the k's op binding is ambiguous; narrow the call graph
  | EResumeAmbiguousOp(String, Span)
  | EResumeWorldMismatch(ResumeDiscipline, ResumeDiscipline, Span)
  // the label-resolution detail
  | EUnknownArgLabel(String, Span)
  | EFeedbackNoContext(Span)
  // `<~ delay(0)` — the causality rule (Faust's, at Mentl's typed
  // altitude). A cycle whose declared delay is ZERO is non-computable:
  // the prior IS the current output, so the value depends on itself
  // within one iteration. Decidable exactly when the depth is a
  // literal; a computed depth rides the refinement tier.
  | EZeroDelayFeedback(Span)
  // A handler performs an op it itself answers WHILE BUILDING ITSELF —
  // from a state init or a config default, which lower into one inits
  // list and so reach this one class (measured: both refuse). The
  // install's world_push has not run while they run — by construction,
  // for every install of it — so the dispatch's walk provably reaches the
  // chain's end and the loud refusal beneath it is the only outcome. The
  // runtime already says this precisely; saying it at compile time is the
  // difference between a program that traps and one that never ships
  // (handler name, op name).
  | EInitPerformsOwnOp(String, String, Span)
  // handler, effect, the ops of that effect no arm answers — the
  // match-exhaustiveness law at a handler: an install absorbs every op of
  // the effects its arms answer, so an op with no arm would escape the row
  // (measured 2026-09-30: `fn f() with !State = (get() + inc()) ~> only_inc`
  // compiled clean and trapped)
  | EHandlerInexhaustive(String, String, [String], Span)
  // `<~ delay(n)` where n is a runtime value. The line is a ring whose
  // depth the emit sizes from the literal, allocated where its owner is
  // built, so a depth the medium cannot read is a depth it cannot hold —
  // and giving one prior to a site that asked for n is the silent wrong
  // the depth read exists to end.
  | EComputedDelayDepth(Span)
  // a `...name` rest element outside a destructuring parameter slot
  | ERestOutsideDestructure(Span)
  // a row alias referencing itself through its own expansion (name)
  | ERowAliasCycle(String, Span)
  // `with A + !A` — the same name asserted present AND absent in one
  // authored clause: an unsatisfiable row the fold must never resolve
  // by silently dropping a side (the pre-diagnostic meet licensed a
  // perform under a declared negation, measured 2026-08-08).
  | EDeclaredRowContradiction(String, Span)
  // the literal as written, then what the scanner could not read of it
  | EMalformedNumericLiteral(String, String, Span)
  // `!Alias` where the alias's row is not positive-closed (name)
  | ERowAliasNegation(String, Span)
  // field, type_name
  | ERecordFieldExtra(String, String, Span)
  // field, type_name
  | ERecordFieldMissing(String, String, Span)
  // missing, total
  | EPatternInexhaustive(Int, Int, Span)
  // the binding-conflict detail
  | EPatternAlternationBindingMismatch(String, Span)
  | EIfMissingElse(Span)
  // declared, used, fn name
  | TOverDeclared(EffRow, EffRow, String, Span)
  // A4 (2026-09-27): the declared row's bare positive names are exactly
  // what the body proves — an inventory, the projected row written by
  // hand. Declared row, proven row, fn name, decl span. MachineApplicable:
  // `mentl tighten` authors the residue (negations, instance pins), or
  // deletes the clause.
  | TRowInventory(EffRow, EffRow, String, Span)
  // a wide value boxed to cross a slot sized for a word, in a unit whose row
  // does not say Alloc — the representation's cost, not the program's
  // (what crossed, the unit)
  | TWordSlotBox(String, String, Span)
  // The poly-recursion teach (§11 5.3): rides the occurs REFUSAL when
  // the infinite type runs through a named fn's own param/return mint —
  // the question beats the guess; the concrete signature derivation
  // sequences with the Henglein fragment work.
  | TPolyRecursionSignature(String, Span)
  // The relevant tier: an authored `own` never consumed on this path —
  // affine's exactly-once half. Narration until the wheel's own count
  // reaches 0 (the census arming law).
  | TOwnUnconsumed(String, Span)
  // The persist value gate: a replay-boundary thunk captures an own
  // whose finish obligation is still open — the image memcpy carries
  // the bytes but not the duty, so the resumed world holds a resource
  // nobody will ever finish. The effects barrier's value half.
  | TOwnAcrossReplay(String, Span)
  // The affine tier's read half: a borrow of a name the ledger already
  // moved. Silent before this class existed — sound only because the
  // heap never frees, the accident-invariant §5.O layer 3's arena
  // deletes. ARMED 2026-09-15: the decl used to end "Narration until the
  // wheel's own count reaches 0 (the census arming law)", and the count
  // reached 0 at the Phase 4.1 landing and held. A narration held at zero
  // is a counter standing in for a proof — so it became the proof.
  | EUseAfterMove(String, Span)
  // declared vs inferred, and the Reason that DECLARED the row it holds
  // the value to — a gate carries its declaration's own reason to the
  // writing site, so a refusal at a call names the fn whose `!E` it
  // violates (Hβ.diag.effect-mismatch-reason, first face)
  | EEffectMismatch(EffRow, EffRow, Reason, Span)
  // the offending row
  // ─── verify / own / graph / driver ───────────────────────────────
  | EPurityViolated(EffRow, Span)
  | ERefinementRejected(Predicate, Span)
  // a predicate operand the SMT renderer
  // cannot encode — accrues as undischarged
  // (never a fabricated `true` at the proof gate)
  | EVerifyUnencodable(Span)
  // obligation count
  | VPending(Int, Span)
  // the violated-name detail
  | EOwnershipViolation(String, Span)
  | ERegionEscape(String, Span)
  // module name, expected path
  | EMissingModule(String, String, Span)
  // handler name, state field that names an op of the handled effect — ambiguous by construction (the arm body cannot distinguish a state read from an op re-perform; measured: the collision compiles clean and returns the WRONG value)
  | EHandlerStateShadowsOp(String, String, Span)
  // fn name, the effect whose op it collides with
  | EFnShadowsOp(String, String, Span)
  // op name, the effect that already claimed it, the effect claiming it now.
  // The env is name-keyed and read last-write-wins, so the second declaration
  // does not coexist with the first — it REPLACES it, and every prior use
  // retypes against a signature its author never wrote. Measured on
  // tests/crown/leak-handler-residual, whose `effect Feed { yield(x: Int) }`
  // collided with prelude's `Iterate.yield` and turned a 16-line crucible into
  // 44 spurious E_TypeMismatch inside lib, burying the one refusal it exists
  // to prove. Renaming the op left exactly that one.
  | EOpShadowsOp(String, String, String, Span)
  // a second `fn name` in one namespace — the emitter would pick one silently (invalid WAT today; silent under a native path)
  | EDuplicateFnName(String, Span)
  // a second `type name` in one namespace — the decls silently MERGE: disjoint ctor sets share tag ids and a cross-tag match returns the wrong arm (measured: exit 13 where 99 was meant, zero diagnostics)
  | EDuplicateTypeName(String, Span)
  // two DISTINCT emitted fn records claim one symbol. Not a program error — the naming function collided, and the emitter's keep-first dedup would silently drop the second body while every call meaning it went to the first. The sibling above refuses that for AUTHORED names; synthesized ones (lambda_/partial_/__k_/the twins) never reached it, being unique only because a mint counter happens to be unique. This is that invariant checked instead of assumed (symbol)
  | EEmittedNameCollision(String, Span)
  // unresolved handle, epoch (lower-time NFree)
  | EUnresolvedType(Int, Int, Span)
  // effect name, the graph-derived
  // proposal (absorbing handlers in
  // scope, or the declare-one teach),
  // main's span — an EVIDENCE hole:
  // the effect reaches the executable
  // root with no absorbing install
  | EEffectUnhandled(String, String, Span)
  // an effect performed inside a THREADED fanout branch whose handler is
  // not provable at the fanout's own frame, or is stateful there (two
  // instances resuming with a state update on one shared record): the
  // effect name and the reason (B1's race rule, 2026-09-27)
  | EThreadedBranchEffect(String, String, Span)
  // a multi-shot or held op performed where its continuation cannot be
  // captured yet — a position the remainder builder does not rebuild (a
  // `let`'s value, a statement past the first, an argument, a right operand,
  // a branch). Every perform of such an op suspends, so the site would trap
  // the moment it ran: the op name, and the callee through which the op is
  // reached when the position is a CALL whose row proves the op ("" at a
  // perform) (C×A, 2026-10-03; the call face AN-2)
  | EContinuationUncapturable(String, String, Span)
  // a derivative the reading cannot carry to the place that asks for it: a
  // `d(v)` whose argument's tangent was lost (to an aggregate, a closure call,
  // a perform, a line ticked outside the reading, a derivative's own
  // derivative), or a construct the reading cannot enter. The loss site
  // rides the message (L4, 2026-09-28)
  | EDerivativeUnreachable(String, Span)
  // authored value-position hole surviving
  // into the reachable executable (SYNTAX
  // §«Partial application» — productive,
  // never executable)
  | EUnresolvedHole(Int, Span)
  // a field load or a record pattern whose receiver's row never closed
  // where it is emitted: no field set, so no slot to read. Said at the
  // settle point (`emit_plan`), where the gate still reads it; the emit's
  // own `(unreachable)` beside the site is never reached
  | EFieldOffsetUnprovable(String, Span)
  // a comparison, a show, a hash or a `++` whose operand is still a type
  // VARIABLE where it is emitted: nothing proves the shape the read needs,
  // and the word reading the emit would fall to is a lie for anything but a
  // word. Said at the settle point beside its row sibling
  | EShapeUnprovable(String, Span)
  // a reference past the twin cap: a recursion instantiates a generic at a
  // type that grows with every call and a body on the chain reads that
  // structure, so past eight levels no specialization is left to read it
  | EInstantiationDepth(String, Span)
  // arithmetic on a product, sum, sequence, function, continuation or unit —
  // no meaning the value ontology gives it. Judged at the operator when the
  // operand is bound and at the one writer when a gated cell is bound later
  // (NumericGate), so `mentl check` refuses it; the emit multiplied the two
  // ADDRESSES with zero diagnostics until 2026-09-27
  | EArithOnAggregate(String, Span)
  // clock-replay trace ran out
  | EReplayExhausted(Span)

// report takes ONE DiagKind — the structured fact. The handler PROJECTS
// every surface (source/code/kind/message/span/applicability) from it.
// !Diagnostic gates the handler, not the effect.
effect Diagnostic {
  // (kind, MESSAGE, the MODULE it is about). The message is the one part
  // of a report that reads the graph, so it is rendered once, at the
  // PERFORM boundary (the `report` fn below), in the reporter's own world
  // where graph and intern are live, never in an arm. An arm's performs
  // resolve OUTER of its own install (the world law), so an arm-side
  // diag_message chases a graph that is not in its world — the
  // render-chases-wrong-instance class, and the row truth of it (the
  // handler residual carrying GraphRead + Intern past every bracket to
  // main's root) is what the root-row gate refused. Everything else a
  // report says is a pure read of the kind (diag_line), so an arm that
  // prints composes its line from what it was handed, and an arm that
  // banks keeps what it was handed — a fact replayed after a join or read
  // after a rollback says what it said when it fired. The module rides the
  // report because the register's arm is deliberately graph-free — its row
  // rides every install — so it cannot look the module up itself, and a
  // local span cannot name a file (two modules both have a line 8).
  diag_report(DiagKind, String, String)
  // The two live reads of the ledger the handler already keeps. The exit code
  // and the emit gate were both RE-DERIVING this as 0 — the handler saw every
  // diagnostic, printed it, and threw the severity away, so `mentl check` on a
  // missing module printed E_MissingModule and exited 0. Carried-Truth at the
  // instrument: the handler knows; nobody read it.
  //
  // every SError seen. `check`'s exit code.
  diag_errors() -> Int
  // only the ARMED classes (diag_refuses). The emit gate.
  diag_refusals() -> Int
}

// The render REGISTER (SYNTAX: how much surfaces is the gradient reading
// relevance at the cursor — the same law at the diagnostic surface). A
// user-target compile scopes NARRATION to the file the user asked about:
// ScopeAt(start, nlines) is the target module's weave range, and a
// warning whose span falls outside it is the substrate's own business —
// partly weave-relative besides (a solo-weave judgment names
// T_OverDeclared on wheel fns the wheel census holds clean, and comment
// refs that resolve in the full wheel miss in a lib-only namespace), so
// it is not even a truth about the shipped source. ERRORS ALWAYS RENDER
// — a broken substrate changes the answer's validity and scoping never
// silences it. The census paths (compile_stdin, the march) never perform
// the op, so the wheel judging itself stays ScopeAll byte-for-byte.
// ScopeNone: narration admits nowhere — the DISCOVERY phase, where the
// DAG walk parses each module only to read its imports and the weave
// parse re-reports every shape with weave spans (pre-register, each
// warning printed TWICE: once per parse, the discovery copy in
// file-local coordinates no range can place). Errors still render in
// every scope, discovery included.
// ScopeModule(name) is the target MODULE, not a line range. It was
// ScopeAt(start, nlines) — the module's range in the concatenated weave —
// and that only ever worked because every file's spans were offsets into one
// text. With the per-module parse each file's spans start at line 1, so a
// range names nothing; the module does. The register stamps each report with
// the module in force when it fired (graph_module_current), and the filter
// compares that, which is one read instead of a containment test.
type DiagScope = ScopeAll | ScopeNone | ScopeModule(String)

// Armed on the root diagnostics_handler only (the register lives where
// the render lives); a separate effect so the quiet trial, the branch
// collector, and tighten's forwarder keep their arm sets untouched (the
// BranchDiag precedent). The DAG driver performs it once, after the
// concatenation fold places the entry and before any parse — so every
// user-target chain is scoped at one home and no narration predates the
// range.
effect DiagRegister {
  diag_scope(DiagScope)
  // The scope read — the register's live value, for the compiler's own
  // INSTRUMENTS (the movers report, the per-obligation debt lines): raw
  // eprint channels that predate the register and carried the
  // maintainer's whole diagnosis onto every user's first run (~28
  // stderr lines on a hello-world, six audit reports converging on it).
  // Each instrument applies the register's own law to its lines: the
  // movers block is never about the user's file, so it prints only
  // under ScopeAll; a debt line carries a span, so it renders exactly
  // when that span is in scope — a user's OWN pending obligation is
  // their teaching surface and still renders, while the wheel's
  // (types.mn spans on a hello-world) stays the census channel's. The
  // march, the census, and the battery never perform diag_scope, so
  // the maintainer keeps every line. Errors and warnings never route
  // here — they ride diag_report, where the register's own arms scope
  // them with errors always rendering.
  diag_scope_of() -> DiagScope
}

// The branch cursor's diagnostic join surface: the facts a branch's
// collector (diag_branch) holds, taken at the join. Each fact is what the
// report carried — the kind, its message rendered at the perform against
// the branch's live values, its module — so a fact read after the join,
// or after a speculation's rollback, says what it said when it fired; a
// DiagKind re-rendered there would read the post-join graph. The join
// RE-PERFORMS diag_report per fact into the root chain, in statement
// order, so the root arm counts and scope-registers off the kind itself
// and every Diagnostic forwarder — the bank among them — sees the
// structure. A separate effect so the forwarders and diag_quiet keep
// their arm sets untouched.
effect BranchDiag {
  diag_lines_taken() -> [(DiagKind, String, String)]
}

// ─── The catalog AS projections of the DiagKind constructors ───────────
// `mentl diagnostics` walks these. No hand-maintained code registry —
// the constructor IS the identity; source/code/kind/applicability/message
// are READS of it.
fn diag_span(d) with Pure = match d {
  PExpectedToken(_, s) => s,
  POrphanDocstring(s) => s,
  PUnclosedConstruct(_, s) => s,
  PUnexpectedToken(_, s) => s,
  ERedundantBraces(s) => s,
  EBlockNeedsBraces(s) => s,
  ELambdaFence(s) => s,
  ERedundantFnOnLambda(s) => s,
  ELambdaAsOrOr(s) => s,
  EOrphanHandlerAttach(s) => s,
  ENotAKeyword(_, s) => s,
  EEffArgNotLiteral(s) => s,
  EInternalInvariant(_, s) => s,
  WRedundantWhere(s) => s,
  WCommentRefUnresolved(_, _, s) => s,
  ETypeMismatch(_, _, _, s) => s,
  ETypeArityMismatch(_, _, s) => s,
  EConstructorArity(_, _, _, s) => s,
  EHandlerArmArity(_, _, _, s) => s,
  EFnArityMismatch(_, _, s) => s,
  EOccursCheck(_, _, s) => s,
  EMissingVariable(_, s) => s,
  EMissingImport(_, _, _, s) => s,
  ENotARecordType(_, s) => s,
  EResumeOutsideArm(s) => s,
  EResumeAmbiguousOp(_, s) => s,
  EResumeWorldMismatch(_, _, s) => s,
  EUnknownArgLabel(_, s) => s,
  EFeedbackNoContext(s) => s,
  EZeroDelayFeedback(s) => s,
  EInitPerformsOwnOp(_, _, s) => s,
  EHandlerInexhaustive(_, _, _, s) => s,
  EComputedDelayDepth(s) => s,
  ERestOutsideDestructure(s) => s,
  ERowAliasCycle(_, s) => s,
  EDeclaredRowContradiction(_, s) => s,
  EMalformedNumericLiteral(_, _, s) => s,
  ERowAliasNegation(_, s) => s,
  ERecordFieldExtra(_, _, s) => s,
  ERecordFieldMissing(_, _, s) => s,
  EPatternInexhaustive(_, _, s) => s,
  EPatternAlternationBindingMismatch(_, s) => s,
  EIfMissingElse(s) => s,
  TOverDeclared(_, _, _, s) => s,
  TRowInventory(_, _, _, s) => s,
  TWordSlotBox(_, _, s) => s,
  TPolyRecursionSignature(_, s) => s,
  TOwnUnconsumed(_, s) => s,
  TOwnAcrossReplay(_, s) => s,
  EUseAfterMove(_, s) => s,
  EEffectMismatch(_, _, _, s) => s,
  EPurityViolated(_, s) => s,
  ERefinementRejected(_, s) => s,
  EVerifyUnencodable(s) => s,
  VPending(_, s) => s,
  EOwnershipViolation(_, s) => s,
  ERegionEscape(_, s) => s,
  EMissingModule(_, _, s) => s,
  EHandlerStateShadowsOp(_, _, s) => s,
  EFnShadowsOp(_, _, s) => s,
  EOpShadowsOp(_, _, _, s) => s,
  EDuplicateFnName(_, s) => s,
  EDuplicateTypeName(_, s) => s,
  EEmittedNameCollision(_, s) => s,
  EUnresolvedType(_, _, s) => s,
  EEffectUnhandled(_, _, s) => s,
  EThreadedBranchEffect(_, _, s) => s,
  EContinuationUncapturable(_, _, s) => s,
  EDerivativeUnreachable(_, s) => s,
  EUnresolvedHole(_, s) => s,
  EFieldOffsetUnprovable(_, s) => s,
  EShapeUnprovable(_, s) => s,
  EInstantiationDepth(_, s) => s,
  EArithOnAggregate(_, s) => s,
  EReplayExhausted(s) => s,
}

