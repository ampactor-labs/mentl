// Severity — the error-vs-narration axis (a projection).
fn diag_severity(d) with Pure = match d {
  POrphanDocstring(_) => SWarning,
  ERedundantBraces(_) => SWarning,
  EBlockNeedsBraces(_) => SWarning,
  ELambdaFence(_) => SWarning,
  ERedundantFnOnLambda(_) => SWarning,
  ELambdaAsOrOr(_) => SWarning,
  ENotAKeyword(_, _) => SWarning,
  WRedundantWhere(_) => SWarning,
  WCommentRefUnresolved(_, _, _) => SWarning,
  PExpectedToken(_, _) => SWarning,
  PUnexpectedToken(_, _) => SWarning,
  TOverDeclared(_, _, _, _) => SWarning,
  TRowInventory(_, _, _, _) => SWarning,
  TWordSlotBox(_, _, _) => SWarning,
  TPolyRecursionSignature(_, _) => SWarning,
  TOwnUnconsumed(_, _) => SWarning,
  TOwnAcrossReplay(_, _) => SWarning,
  EArithOnAggregate(_, _) => // ARMED at birth: arithmetic on an aggregate has no meaning, and the
  // wheel's census of it is zero (measured at the arming commit).
  SError,
  EDerivativeUnreachable(_, _) => // ARMED at birth: the alternative is a derivative answered as zero where
  // the program asked for one, and the wheel writes no derivative reading.
  SError,
  EUseAfterMove(_, _) => SError,
  VPending(_, _) => SVerificationPending,
  EVerifyUnencodable(_) => SVerificationPending,
  _ => SError,
}

// diag_refuses — the ARMED classes of the refusal law, a projection beside
// diag_severity.
//
// SYNTAX already wrote this law, for one class: "A hole is productive, never
// executable." That is Hazel's own shape, which infer.mn:24 cites by name —
// productive under error at the WALK (a mismatch binds NErrorHole and continues;
// ten mismatches yield ten holes, not one-and-halt), refusing at the BOUNDARY.
// The walk's half was built; the boundary's half was drawn for holes and for
// decidable-false refinements, and never for the other twelve classes. This is
// that same law reaching them — nothing new is invented here.
//
// A class is ARMED when the wheel's own census of it is ZERO: the medium never
// violates it on ITSELF, so enforcing it on everyone cannot refuse the medium.
// The census ratchet (tools/verify-baseline.txt) holds it at zero, so an armed
// class can never un-arm. That licence is the self-hosting property doing the
// work — rustc and tsc gate from day one because they never had errors on their
// own source; here the wheel is the medium's first user, so "a class the medium
// keeps on itself" is a MECHANICAL licence, not a policy.
//
// The all-at-once form — refuse on any SError — was designed, dispatched to an
// adversarial fleet, and REFUTED on the artifact by three independent verifiers:
// the wheel reports 2,266 errors about its own source, so that gate refuses the
// medium itself and no m2 exists. The target does not lower; the WORK sequences
// (§9.3). Classes arm one at a time as their census falls.
//
// `_ => False` is not a fabrication: "not yet armed" is TRUE of every class not
// listed, and the list only grows. When the last one arms, this projection and
// the census line are both DELETED and the law is `diag_severity(d) == SError`.
fn diag_refuses(d) with Pure = match d {
  EMissingModule(_, _, _) => // ARMED 2026-07-17. Census on the wheel: 0. Its silent skip in
  // driver_compile_entry's fold was fixed the same day — `mentl check` reported
  // it while `mentl compile` on the same source said nothing and shipped 2,432
  // bytes of WAT.
  True,
  EHandlerStateShadowsOp(_, _, _) => // ARMED at birth (2026-07-18): both are DECL-SITE facts read from parsed
  // structure — no resolution dependency, so the blob-vs-user-path licence
  // gap the adversarial panel found for name-dependent classes cannot apply.
  // Census on the wheel at arming: 0 (the wheel's one state-shadow — the
  // voice history field — was renamed in the arming commit; the wheel has
  // no duplicate fn names, measured).
  True,
  EArithOnAggregate(_, _) => // ARMED at birth (2026-09-27): a TYPE fact — arithmetic's operand is a
  // product, sum, sequence, function, continuation or unit — judged at the
  // operator for a bound operand and at the one writer for a gated cell
  // bound later (NumericGate), so the judgment refuses and no WAT streams.
  // Census on the wheel at arming: 0.
  True,
  EDuplicateFnName(_, _) => True,
  EPatternInexhaustive(_, _, _) => // ARMED 2026-10-03, the day its one false shape closed: an as-pattern
  // read as covering nothing, so `whole @ Leaf(_)` beside `Pair(a, b)` was
  // "misses 1 of 2" (`pat_tops`). Unarmed, a match missing a variant
  // compiled and trapped when the variant arrived — the hard error SYNTAX
  // names, emitted. Census on the wheel at arming: 0.
  True,
  EEmittedNameCollision(_, _) => // ARMED at birth (2026-09-10) and born at ZERO on every program measured,
  // which is the point: it does not police a mistake, it holds an invariant
  // that was true by two unrelated accidents. Authored duplicates are refused
  // upstream by EDuplicateFnName; synthesized symbols were unique only
  // because a mint counter is unique, and the emitter's keep-first dedup
  // compares NAMES — so the day a symbol stops being minted from a counter,
  // an unchecked collision drops one body and silently redirects every call
  // that meant it. Emitting a program whose calls go to the wrong function is
  // not something to report and proceed through.
  True,
  EOpShadowsOp(_, _, _, _) => // ARMED at birth (2026-09-04), and the arming is the whole point: a
  // reported-but-emitted collision is the corruption plus a note about it.
  // The env holds ONE entry per name, so two effects declaring the same op
  // are not both representable — the second write REPLACES the first and
  // every prior call retypes against a signature its author never wrote.
  // Measured: tests/crown/leak-handler-residual declared `Feed.yield` beside
  // prelude's `Iterate.yield` and compiled to 42 spurious E_TypeMismatch
  // INSIDE lib, burying the one refusal the crucible exists to prove.
  // Renaming the op left exactly that one.
  //
  // Licence, both halves measured: the wheel declares 325 ops across its
  // effects with ZERO cross-effect name reuse, so this cannot refuse the
  // medium; and the corpus fixtures that collide are being renamed in the
  // same landing.
  //
  // WHAT THE REFUSAL COSTS, stated rather than hidden: two effects sharing
  // an op name is ordinary in effect systems (`Reader.get` beside
  // `State.get`), and Mentl cannot express it TODAY because op identity is
  // the bare name. The capability arrives when the env keys an op by
  // (effect, name) — the entry already carries its effect, so the key is
  // what throws it away. `Hβ.env.op-identity-is-effect-and-name` carries it,
  // and this refusal is what makes the limit sayable instead of silent.
  True,
  EPurityViolated(_, _) => // ARMED 2026-09-03, the first of the CROWN's own two verdicts to reach
  // the refusal law. §0's first property is "nothing executes unproven",
  // and a violated `with Pure` was proven, printed, and then emitted: the
  // probe was `fn claims_pure(n) with Pure = shout(n)`, which reported the
  // violation and shipped 38,750 bytes.
  //
  // Both halves of the licence above, measured rather than assumed. The
  // wheel's own census of this class is ZERO (verify's census line), so
  // arming cannot refuse the medium. And the user-path channel was checked
  // across all 372 corpus fixtures: the only carriers left are the two that
  // EXPECT the refusal (mn-constructor-row-charge, mn-index-sugar-row). The
  // one true blocker was mn-cli-dispatch, whose parse_verb and
  // build_question declared `with Pure` while constructing payload-carrying
  // variants — an honestly wrong signature, widened in the same landing,
  // and it had gone unnoticed because this class did not refuse and the
  // micro battery's diagnostic counter could not report a nonzero number.
  //
  // The recorded refutation against the all-at-once form — "the wheel
  // reports 2,266 errors about its own source" — is era-stale; that count
  // is 0 today. It refuted arming EVERY class at once, which is still the
  // right refusal; classes arm one at a time as their census falls, and
  // this one has.
  True,
  EFnShadowsOp(_, _, _) => // ARMED at birth (2026-08-18), read at the op's env write — the one
  // place both claims on the name are present. Wheel census 0.
  True,
  EDuplicateTypeName(_, _) => // ARMED at birth (2026-07-25), same licence as the two above: a DECL-SITE
  // fact read from parsed structure — no resolution dependency. Census on
  // the wheel blob at arming: 0 (the one Level pair lives in two tutorial
  // files, both outside the blob and compiled standalone).
  True,
  EThreadedBranchEffect(_, _, _) => // ARMED at birth (2026-09-27), the same licence as the root gate one arm
  // down: a LOWER-TIME fact read off the branch thunk's row and the
  // fanout's own lexical install stack, born at wheel-ZERO by construction
  // (the wheel installs no threaded schedule). A stateful handler two
  // spawned instances resume into is a definite race on one shared state
  // record; a handler beyond the frame fence is unprovable from the site.
  True,
  EContinuationUncapturable(_, _, _) => // ARMED at birth (2026-10-03): the floor it replaces trapped the moment
  // the perform ran and said nothing before — a program that compiled clean
  // and exited 134. Every perform of a multi-shot or held op suspends, so
  // the site is certain to reach the floor whenever it runs.
  True,
  EDerivativeUnreachable(_, _) => // ARMED at birth (2026-09-28), born at wheel-ZERO by construction (the
  // wheel installs no derivative reading). What it refuses is a derivative
  // the reading would otherwise answer as ZERO — the silent wrong the whole
  // reading exists not to tell — so it can never be a narration.
  True,
  EEffectUnhandled(_, _, _) => // ARMED at birth (2026-07-22): an EXECUTABLE-root fact read from main's
  // resolved row at the gate — the row representation is true (the triple),
  // the wheel's own main carries only substrate-grounded names (census 0 at
  // arming), and check/edit never route through the gate, so the productive
  // surfaces stay open. The unhandled effect was the LAST undiagnosed
  // 0x100000000 class: a perform whose evidence no install threads.
  True,
  ERefinementRejected(_, _) => // ARMED 2026-07-18, panel-corrected licence: census 0 on the wheel AND the
  // user-path channel verified. ERefinementRejected fires only on a predicate
  // DECIDED false (undecidable defers to V_Pending, decidable-true passes —
  // the panel found no false-refusal channel); §11 claimed this class was
  // locked while a decidable-false `let bad: Sample = 1.5` emitted 2,513
  // bytes at exit 0. EOwnershipViolation's one false channel (an unresolved
  // callee's move default) died with graph_bind_hole + the callee-miss borrow
  // guard; the detector survived adversarial falsification on resolved
  // programs (a genuine double move still refuses, disjoint arms still pass).
  True,
  EOwnershipViolation(_, _) => True,
  EUseAfterMove(_, _) => // ARMED 2026-09-15 — the affine tier's READ half joining the consume half
  // above, and the arming condition was written by the class itself: its
  // decl and its fixture both said "narration until the wheel's own count
  // reaches 0 (the census arming law)". The count reached 0 at the Phase 4.1
  // landing (pin 8ba768c810c4) and has held every board since, so what
  // remained was a counter standing in for a proof — `use_after_move_max: 0`
  // in verify-baseline, retired by this arm because an armed class has
  // nothing to count: a wheel carrying one cannot compile.
  // WHAT IT HOLDS, and why proceeding is not an option: the ledger already
  // proved the name moved, and the read takes the bytes anyway. Today that is
  // sound only by accident — the bump heap never frees, the
  // accident-invariant §5.O layer 3's arena deletes — so this is a
  // use-after-free the day ownership gets a real reclaim, emitted silently
  // at exit 0. The licence is the same one its sibling holds: the detector
  // reads the used-set BEFORE borrow_depth (4.1's ordering fix), so a borrow
  // of a live name cannot reach it, and tests/frontier/mn-use-after-move.mn
  // is the falsifying witness, re-banked from run_narration to the refusal
  // contract in the same landing and seen RED first (exit 0, 4,474 WAT bytes
  // against the unarmed tree).
  True,
  EMissingImport(_, _, _, _) => // ARMED at birth (F0b, 2026-09-27): born at zero on the wheel — the solo
  // sweep it replaces held `solo_violations_max: 0` across 63 modules — and
  // the class is exactly what that sweep ran 63 processes to find.
  True,
  EMissingVariable(_, _) => // ARMED 2026-07-18, the manifest arc's dividend: wheel census 0, and the
  // user-path licence MEASURED — a no-import stdlib program (map / fold /
  // len / any) resolves via the DAG's prelude seed and runs; the stdin
  // contract is self-contained input (the wheel's own build form), where a
  // missing name is a real break. Pre-arming, the refusal fixture compiled
  // a missing-name executable to 2,795 bytes at exit 0 with the diagnostic
  // on stderr — the silent-wrong this class's arming deletes.
  True,
  EOccursCheck(_, _, _) => // ARMED 2026-07-18, the eighth — the same day its fixture found the spin:
  // a genuinely infinite type (selfapply f = f(f)) used to TRAP the compiler
  // (chase_deep / subst_ty stack exhaustion, zero reports) because the occurs
  // leaf compared handles where the cycle lived in BOUND STRUCTURE (bind
  // graph_bind(a, TFun([b], r)) first, then graph_bind(b, TVar(a)) closes
  // the cycle — no comparison sees
  // it). The leaf now recurses into the root's binding, the write guard is
  // total, and the fixture reports E_OccursCheck and refuses. Wheel census 0
  // throughout; the phantom cascade stayed dead (one miss, one diagnostic).
  True,
  EDeclaredRowContradiction(_, _) => // ARMED at birth (2026-08-08), the decl-site licence: a fact read from
  // the authored clause's own signed fold — no resolution dependency.
  // Census on the wheel at arming: 0 (the birth landing's march measured
  // the whole wheel contradiction-free). The pre-diagnostic meet let a
  // performing body check CLEAN under a declared !E; an unsatisfiable
  // clause must never reach an executable.
  True,
  EMalformedNumericLiteral(_, _, _) => // ARMED at birth (2026-08-18), the lexical licence: the judgment is
  // read from the source bytes themselves at the scan, so it has no
  // resolution dependency and cannot differ between the blob link and a
  // user path. Census on the wheel at arming: 0 — every literal the
  // medium's own source writes is well-formed, and the march is the
  // proof. This is the class the armed contract exists for: 0b1012 read
  // 5 and ran, 0o1238 read 83 and ran, a bare 0x read 0 and ran. A
  // value the medium cannot read is not a proven value, and nothing
  // executes unproven.
  True,
  EZeroDelayFeedback(_) => // ARMED at birth (2026-08-12), the literal licence: the depth is read
  // from the authored `delay(<int literal>)` at the `<~` site — no
  // resolution dependency, so the blob-vs-user-path gap cannot apply.
  // Census on the wheel at arming: 0 (all thirteen `<~` sites declare
  // delay(1) or accumulate). A cycle with no delay has no computable
  // value, and today it SILENTLY became a one-sample delay — the emit
  // never read the depth at all, measured by probe (delay(0), delay(1)
  // and delay(3) each returned 30).
  True,
  EHandlerInexhaustive(_, _, _, _) => // ARMED at birth (2026-09-30): the judgment is the declaration's own
  // arms against the effect's declared ops, both parse facts; the wheel
  // and the runtime floor carry zero partial handlers, and the one shape
  // that admitted one was a false absence proof that trapped.
  true,
  EInitPerformsOwnOp(_, _, _) => // ARMED at birth (2026-08-18): the judgment is STRUCTURAL, read from
  // the lowered install itself — a direct-perform inside `LHandleWith`'s
  // own inits list, naming that same install's handler. No resolution
  // dependency and no extent guess: the install's world_push has not run
  // while its inits run, for every install, so the dispatch's walk
  // provably reaches the chain's end. The runtime already refuses precisely
  // there (ev_declaring_node's own trap); arming moves the same verdict to a
  // point where nothing has been emitted. Census on the wheel at arming:
  // 0 — every handler in it has a pure init, which is why no gate saw the
  // shape until one was written for it.
  True,
  EEffectMismatch(_, _, _, _) => // ARMED 2026-09-25 — the crown's own verdict, and it was not armed:
  // a declared row's refusal printed and the program RAN. Measured on the
  // boot the day it was armed: `fn f() with !E = op()` under an outer
  // handler reported the mismatch and exited 7 (the op's value); the
  // authored-parameter form `fn run(f: () -> Int with !E) = f()` called
  // with a performing callback reported and ran; a fixture in the frontier
  // battery (`mn-hof-row-gate`) banked "exit 42 with exactly one
  // E_EffectMismatch" as its expectation — a real `!WASI` leak canonized by
  // the era that banked it (§9.11). The licence is the standard one: the
  // wheel's own census of the class is ZERO (`mentl check src/main.mn`
  // answers no diagnostics; the blob compile carries none), so this cannot
  // refuse the medium. What it refuses is exactly PLAN §0's first property
  // at its own boundary: a program whose declared row is contradicted by
  // its inferred row is a program whose proof is false, and nothing
  // executes unproven.
  True,
  ETypeMismatch(_, _, _, _) => // ARMED 2026-09-25, one pin after E_EffectMismatch, on the harm that
  // pin measured: a build of the compiler whose own source carried two
  // E_TypeMismatch (a frame record missing a field at two literals) reported
  // them, EMITTED anyway, and the resulting compiler trapped on every program
  // including `fn main() = 3`. A narrated type error is a program whose
  // meaning the judgment could not establish; emitting it is exactly what
  // PLAN §0 says never happens. The licence is the same one: the wheel's
  // census of the class is zero (`mentl check src/main.mn` answers no
  // diagnostics; the blob compile carries none). The proposer's refused
  // candidates are unaffected: `segment_bracket` judges each under its own
  // `diag_branch`, and only a proven candidate joins the root — which it
  // does carrying no diagnostic, since a diagnostic is what refuses it.
  True,
  EFnArityMismatch(_, _, _) => // ARMED 2026-09-27, the day the tuple-decomposition rule left
  // pair_fn_params: a call whose argument count is not its callee's
  // parameter count has no calling convention to emit into — the four
  // shapes that rule admitted trapped at the indirect call or returned 0.
  // Its surface name is E_TypeMismatch, the arity face of the class armed
  // above, on the same licence: the wheel's census is zero (the m2 built
  // under the refusal with no diagnostic).
  True,
  EComputedDelayDepth(_) => // ARMED at birth (2026-08-12), the same literal licence its sibling
  // rides: the judgment is "was a literal written here", read from the
  // authored RHS with no resolution dependency. Census on the wheel at
  // arming: 0 — every `delay(...)` in src/ and lib/ is `delay(1)`, and
  // the other feedback sites are `accumulate`. A line is a fixed set of
  // globals, so an unreadable depth cannot be held; refusing is what
  // keeps the depth read honest, because the alternative is handing a
  // site that asked for n the one slot it did not ask for.
  True,
  EInternalInvariant(_, _) => // An invariant the judgment guaranteed and a later pass found broken
  // is a module the medium cannot vouch for — "nothing executes unproven"
  // applies to the compiler's own claims first. Zero on the wheel (the
  // trial pass that muted thirteen of these is gone, 2026-09-17).
  True,
  EFieldOffsetUnprovable(_, _) => // ARMED 2026-09-28 (R0″) at wheel-zero, the settle point being what made
  // arming possible: the class was decided inside per-fn emission, after the
  // gate and after bytes, so an armed report would have refused a module
  // already on stdout. It is asked of every body the emitted reach walks,
  // under that body's bracket, before the gate reads.
  True,
  EShapeUnprovable(_, _) => // ARMED 2026-09-28 (R0″) with its row sibling. The eq and show narrations
  // it replaces counted two sites on the wheel, both `list_compare_loop`'s
  // element compares; the loop reads its elements as the words the emit's
  // by-name dispatch guarantees, and the count is zero.
  True,
  EInstantiationDepth(_, _) => // ARMED at birth (2026-09-28, R0″): a twin chain reaches its cap only when
  // a structurally-read type grows with every call, so the floor it falls to
  // would read that structure as a word. Measured the day it was born: two
  // ten-deep lists compared unequal and a nested show printed an address.
  True,
  _ => False,
}

// The word a report's line prints for its severity.
fn diag_kind(d) with Pure = match diag_severity(d) {
  SWarning => "Warning",
  SVerificationPending => "VerificationPending",
  SError => "error",
}

// Applicability — the automation axis (SYNTAX.md table), a projection.
fn diag_applicability(d) with Pure = match d {
  ERedundantBraces(_) => MachineApplicable,
  EBlockNeedsBraces(_) => MachineApplicable,
  WRedundantWhere(_) => MachineApplicable,
  WCommentRefUnresolved(_, _, _) => MaybeIncorrect,
  TOverDeclared(_, _, _, _) => MachineApplicable,
  TRowInventory(_, _, _, _) => MachineApplicable,
  TWordSlotBox(_, _, _) => MaybeIncorrect,
  TPolyRecursionSignature(_, _) => HasPlaceholders,
  TOwnUnconsumed(_, _) => // Not mechanically applicable: the fix is a consume the developer
  // must place (or an honest widening to `ref`), never a patch.
  Unspecified,
  TOwnAcrossReplay(_, _) => Unspecified,
  EUseAfterMove(_, _) => // The fix is structural — drop the read or restructure so the
  // move happens after it — never a patch.
  Unspecified,
  EPatternInexhaustive(_, _, _) => HasPlaceholders,
  EHandlerInexhaustive(_, _, _, _) => HasPlaceholders,
  EEffectUnhandled(_, _, _) => MaybeIncorrect,
  EThreadedBranchEffect(_, _, _) => MaybeIncorrect,
  EContinuationUncapturable(_, _, _) => MaybeIncorrect,
  EDerivativeUnreachable(_, _) => Unspecified,
  EUnresolvedHole(_, _) => HasPlaceholders,
  EFieldOffsetUnprovable(_, _) => MaybeIncorrect,
  EShapeUnprovable(_, _) => MaybeIncorrect,
  EInstantiationDepth(_, _) => Unspecified,
  EArithOnAggregate(_, _) => Unspecified,
  ERefinementRejected(_, _) => Unspecified,
  EVerifyUnencodable(_) => Unspecified,
  ETypeMismatch(_, _, _, _) => Unspecified,
  ETypeArityMismatch(_, _, _) => Unspecified,
  EConstructorArity(_, _, _, _) => MaybeIncorrect,
  EHandlerArmArity(_, _, _, _) => MaybeIncorrect,
  EFnArityMismatch(_, _, _) => Unspecified,
  EOccursCheck(_, _, _) => Unspecified,
  EOwnershipViolation(_, _) => Unspecified,
  EOrphanHandlerAttach(_) => Unspecified,
  EResumeOutsideArm(_) => Unspecified,
  EResumeAmbiguousOp(_, _) => MaybeIncorrect,
  EEmittedNameCollision(_, _) => // Nothing the reader can apply — the collision is in the compiler's own
  // naming, and the program that provoked it is correct.
  Unspecified,
  _ => MaybeIncorrect,
}

// Whether the step a report names is one the medium takes by itself: the one
// test for a step on offer. The Lens ranks such a report above a warning and
// its lead offers the step exactly when the patch applies without a question.
fn diag_applies_itself(d) = diag_applicability(d) == MachineApplicable

// The rendered message — operands read LIVE from the constructor, never a
// String copied at the call site. This is the Carried-Truth win: the fact
// is structured; the prose is its projection.
fn diag_message(d) with !Mutate = match d {
  PExpectedToken(note, _) => "expected token: {note}",
  POrphanDocstring(_) => "comment has no following declaration to attach to",
  PUnclosedConstruct(detail, _) => detail,
  PUnexpectedToken(detail, _) => detail,
  ERedundantBraces(_) => "redundant braces around a non-block body",
  EBlockNeedsBraces(_) => "statements require braces",
  ELambdaFence(_) => // drift-audit: ignore — diagnostic message prose, not Mentl syntax
  "`|params|` lambda fence — use `(params) => body`",
  ERedundantFnOnLambda(_) => // drift-audit: ignore — diagnostic message prose
  "`fn` is reserved for named declarations — remove it for a lambda",
  ELambdaAsOrOr(_) => // drift-audit: ignore — diagnostic message prose
  "`||` is logical or — use `() => expr` for a zero-arg lambda",
  EOrphanHandlerAttach(_) => "`~>` with no preceding chain",
  ENotAKeyword(kw, _) => "`{kw}` is not a Mentl keyword — use the verb form",
  EEffArgNotLiteral(_) => "parameterized-effect argument must be a literal",
  EInternalInvariant(note, _) => "internal invariant: {note}",
  WRedundantWhere(_) => "`where true` is a vacuous predicate — drop it",
  WCommentRefUnresolved(owner, name, _) => "comment on `{owner}` references `{name}`, which resolves nowhere — a backticked name is a reference; if this is prose, drop the backticks",
  ETypeMismatch(a, b, reason, _) => "{show_type(a)} vs {show_type(b)} — {reason_line(reason)}",
  ETypeArityMismatch(a, b, _) => "type list arity mismatch: {int_to_str(a)} vs {int_to_str(b)}",
  EConstructorArity(name, declared, got, _) => "constructor {name} takes {int_to_str(declared)} fields; the pattern binds {int_to_str(got)}",
  EHandlerArmArity(name, declared, got, _) => "op {name} declares {int_to_str(declared)} params; the arm binds {int_to_str(got)}",
  EFnArityMismatch(a, b, _) => "function arity mismatch: {int_to_str(a)} param(s) vs {int_to_str(b)} param(s)",
  EOccursCheck(h, ty, _) => "infinite type: {int_to_str(h)} occurs in {show_type(ty)}",
  EMissingVariable(what, _) => what,
  EMissingImport(name, rm, dm, _) => "`{name}` resolves only because the whole link carries it: it is declared in `{dm}`, which `{rm}` never imports — on its own, `{rm}` would not compile. Add `import {dm}` to `{rm}`",
  ENotARecordType(name, _) => "{name} is not a record type",
  EResumeOutsideArm(_) => "`resume` outside a handler arm",
  EResumeAmbiguousOp(name, _) => "'{name}' resumes under arms of two different handlers — the k record's op binding is ambiguous",
  EResumeWorldMismatch(da, db, _) => "resume cardinality mismatch: {show_discipline(da)} vs {show_discipline(db)}",
  EUnknownArgLabel(detail, _) => detail,
  EFeedbackNoContext(_) => "`<~` used outside an iterative context",
  EZeroDelayFeedback(_) => "`<~ delay(0)` closes a cycle with no delay — the prior would be the value being computed. Raise the delay to at least 1",
  EInitPerformsOwnOp(hname, op, _) => "handler {hname} performs {op} while building itself — in a state init or a config default, both of which run before the install exists — and {hname} is what answers {op}, so nothing can absorb it. Move the perform into an arm, or compute the value from a handler installed around this one",
  EHandlerInexhaustive(hname, en, missing, _) => "handler {hname} answers no {join(", ", missing)} of {en} — an install absorbs every op of the effects its arms answer, so a perform of the missing op would reach nothing and read garbage evidence. Add the arm; an arm that performs its own op forwards it to the enclosing handler (`op(…) => resume(op(…))`), and the ops this handler answers can be declared as their own effect",
  EComputedDelayDepth(_) => "the delay depth must be a literal — a feedback line is a fixed set of slots, and a depth read at runtime would silently get one. Write the depth, or hold the history yourself",
  ERestOutsideDestructure(_) => "`...` rest element outside a destructuring parameter — rest lives in patterns (`([h, ...t]) =>`, `let [h, ...t] =`), and `++` joins lists in expressions",
  ERowAliasCycle(nm, _) => "row alias `{nm}` expands through itself — a row is a finite signed set; name the effects directly",
  EDeclaredRowContradiction(nm, _) => "the clause asserts `{nm}` AND `!{nm}` — one row cannot both permit and forbid a name; drop one side",
  EMalformedNumericLiteral(text, why, _) => "`{text}` is not a number the medium can read: {why}. A literal whose value cannot be read is not a proven value, and the old scanner answered one anyway — it stopped at the offending byte and let the rest become a second token",
  ERowAliasNegation(nm, _) => "`!{nm}` negates a row alias whose row is not positive-closed — the shorthand is sound only over plain unions; name the forbidden effects directly",
  ERecordFieldExtra(field, tn, _) => // drift-audit: ignore — diagnostic message string, not a control keyword
  "record literal has unknown field '{field}' for type {tn}",
  ERecordFieldMissing(field, tn, _) => // drift-audit: ignore — diagnostic message string, not a control keyword
  "record literal missing field '{field}' for type {tn}",
  EPatternInexhaustive(missing, total, _) => "match misses {int_to_str(missing)} of {int_to_str(total)} variants — add the missing arms or a wildcard",
  EPatternAlternationBindingMismatch(detail, _) => detail,
  EIfMissingElse(_) => "`if` without `else` requires a unit body",
  TOverDeclared(declared, used, name, _) => "function '{name}' declares {show_effrow(declared)} but body only uses {show_effrow(used)} — tighten the signature to unlock capabilities",
  TRowInventory(declared, used, name, _) => "function '{name}' declares {show_effrow(declared)}, which is exactly what the body proves ({show_effrow(used)}) — an inventory: the positive row is projected at the address surface, so author only what inference cannot say (a negation, an instance pin, Pure, or a cap on a callback's row); `mentl tighten` writes the residue",
  TWordSlotBox(what, unit, _) => "{what} is boxed into a fresh cell in `{unit}`, whose row does not say `Alloc` — a wide value crossing a slot sized for a word: the representation's cost, not the program's, until the slot takes the value's own width (Hβ.value.seq-element-stride-carrier)",
  TPolyRecursionSignature(name, _) => "the infinite type runs through '{name}''s own parameter or return — if '{name}' calls itself at a different type (polymorphic recursion), a FULL signature on '{name}' (every parameter and the return annotated) buys the poly self-call",
  TOwnUnconsumed(msg, _) => msg,
  TOwnAcrossReplay(msg, _) => msg,
  EUseAfterMove(msg, _) => msg,
  EEffectMismatch(declared, inferred, why, _) => "effect row mismatch: {show_effrow(declared)} vs {show_effrow(inferred)} — {show_reason(why)}",
  EPurityViolated(row, _) => "expected Pure but found effects: {show_effrow(row)}",
  ERefinementRejected(pred, _) => "refinement predicate proven false at compile time: {show_predicate(pred)}",
  EVerifyUnencodable(_) => // drift-audit: ignore — diagnostic message string
  "refinement predicate operand cannot be encoded for the solver — obligation accrued as pending",
  VPending(count, _) => "{int_to_str(count)} verification obligations pending",
  EOwnershipViolation(detail, _) => detail,
  ERegionEscape(detail, _) => detail,
  EMissingModule(name, path, _) => "module source not found: {name} (expected at {path})",
  EHandlerStateShadowsOp(hname, field, _) => "handler '{hname}' state field '{field}' names an op of the handled effect — a state read and an op call become indistinguishable in the arm bodies; rename the field",
  EFnShadowsOp(name, ename, _) => "`fn {name}` collides with an op of effect `{ename}` that this program links — so this declaration is not a second definition, it is an unreachable one: every call to `{name}` performs the op, and the body is judged against the op's signature. Rename the function",
  EOpShadowsOp(name, prior, now, _) => "effect `{now}` declares an op `{name}` that effect `{prior}` already declares, and this program links both. The env holds one entry per name, so the second declaration REPLACES the first rather than joining it: every existing call to `{name}` is now judged against `{now}`'s signature, and the errors surface wherever those calls are — inside the library, at spans your program never wrote. Rename this op",
  EDuplicateFnName(name, _) => "a second `fn {name}` in one namespace — the first declaration already binds it; rename one",
  EDuplicateTypeName(name, _) => "a second `type {name}` in one namespace — the declarations would merge and their constructor sets share tag ids; rename one",
  EEmittedNameCollision(symbol, _) => "two different functions both emit as `{symbol}` — the dedup keeps the first, so every call meaning the second would reach the first instead. This is the compiler's own naming, not your program: report it",
  EUnresolvedType(h, epoch, _) => "handle {int_to_str(h)} @epoch={int_to_str(epoch)}",
  EEffectUnhandled(ename, proposal, _) => "effect {ename} reaches the executable root with no absorbing handler — calling one of its ops would read garbage evidence at runtime; nothing executes unproven. {proposal}",
  EThreadedBranchEffect(ename, why, _) => "effect {ename} is performed inside a threaded branch and {why} — two spawned instances would race, or reach a handler this site cannot see. Install a stateless handler for {ename} at the fanout's own frame, or install the handler inside the branch",
  EContinuationUncapturable(op, via, _) => "{uncapturable_subject(op, via)} suspends the computation around it — its handler resumes it more than once, or after doing more work — and the rest of the computation cannot be captured at this position yet: a continuation is captured where the perform or the call is the first work its function, block or arena does — the whole expression, or an operand of an operator chain whose earlier operands are plain values. Move it there, or move what precedes it into a function that is called before it",
  EDerivativeUnreachable(why, _) => "{why} — the derivative reading would answer zero here, and zero is not what the program asked for; nothing is emitted rather than a wrong slope",
  EUnresolvedHole(h, _) => "unresolved value hole (handle {int_to_str(h)}) — fill it (accept a proven survivor) or suspend it into a parameter product",
  EFieldOffsetUnprovable(why, _) => "{why} — the receiver's row never closed where this is emitted, so there is no slot to read; close the row: annotate the receiver at its Intent Boundary, or give the call site a shape its specialization can key on",
  EShapeUnprovable(why, _) => "{why} — the operand's type is still a variable where this is emitted, so nothing proves the shape the read needs, and reading it as a word is a lie for anything but a word; prove the operand: give the call site a shape its specialization can key on, or name the type at its Intent Boundary",
  EInstantiationDepth(why, _) => "{why} — the recursion instantiates it at a type that grows with every call and a body on the chain reads that structure, so the medium specializes eight levels deep and refuses the ninth rather than read it as a word; keep the type the recursion reads from growing",
  EArithOnAggregate(why, _) => "{why} — arithmetic on an address, or on a product, sum, sequence, function, continuation or unit, has no meaning: the operands are addresses, and the result would be arithmetic on where the values live, never on the values. A number is a word (Int, Float, Byte); give this operand one, read the field you meant, or move an address with addr_at",
  EReplayExhausted(_) => "clock replay trace exhausted",
}

// Early exit. An arm that never resumes abandons the computation around the
// perform, and the install's value is the arm's (SYNTAX §«Resume
// discipline»); `abort` returns `!` because nothing after it runs.
effect Abort {
  abort() -> !
}

// Mutation capability marker.
// !Mutate on a function proves read-only access to all parameters.
// Vale-style region-freeze: "N parallel readers, no writers" through
// the same Boolean algebra that proves !Alloc and !IO.
// Mutate carries the graph_mutated event — performed by graph_handler
// at the OUTERMOST commit boundary so the IC fixpoint (the oracle's
// project_queue_merger, src/oracle.mn) re-projects only on real graph
// state changes. Speculative writes between graph_push_checkpoint /
// graph_rollback never reach this op — Mentl's own oracle would
// otherwise subscribe to her speculations and recursively explore
// forever.
//
// epoch — graph epoch at which the mutation committed. The epoch IS the
// one cache key: the IC projection memoizes by it, re-deriving the queue
// only when the epoch bumps (PLAN §2: read live is the meaning, cached
// by epoch is the mechanism).
// Mutation — MSetNode | MSetRow | MFreshNode (per the Mutation type at
// src/types.mn:163). The event carries enough for the projection to
// re-derive over the changed graph (Q-2 (B) scope: transitive dependents
// via Reason chain).
effect Mutate {
  graph_mutated(Int, Mutation)
}

// effect LookupTy lives in graph.mn beside lookup_ty_graph — the
// effect-beside-handler law at the projection's own home.
//
// Inference mints via graph_fresh_ty; query mints display ids. One
// function, two handlers, different semantics for the same op.
effect FreshHandle {
  mint(Reason) -> Int
  mint_row(Reason) -> Int
}

// Tracks the stack of (locals, captures) frames so VarRef can resolve
// to LLocal / LUpval / LGlobal at lower time. LambdaExpr computes its
// captures via collect_free_vars + ls_resolve in the OUTER frame,
// then ls_enter_frame with (params, captures). Body lowering
// dispatches every VarRef through ls_resolve. Closure heap records
// materialize from the captures_exprs list in LMakeClosure.
type Resolution
  // name is a local of the current frame, read at the REGISTER its innermost
  // binder took — the source name, or a name of its own where that binder
  // shadows another local of the frame (ls_bind_local)
  = RLocal(String)
  // name is captured at slot; emit offset-loads from __state
  | RUpval(Int)
  // top-level name — emit references $<name> as a global
  | RGlobal
  // name is a `<~`-bound prior — emit references $__fb_prev_<h>
  // (LF.B): the `(prev) => body <~ delay(1)` lambda param resolves
  // to the feedback handle's prior-iteration local, read LIVE at
  // the body. The prior is the feedback NODE; no copy/snapshot —
  // the emit-declared $__fb_prev_<h> local IS the carried value.
  | RFbPrior(Int)

// `ls_resolve` returns (Resolution, type_handle) where type_handle is
// the type handle the local was BOUND with (via ls_bind_local). For
// captured names (RUpval) the handle is the local's own handle from
// the enclosing frame — the LowExpr describing the captured value's
// type. RGlobal returns the var-ref's enclosing handle (caller-side
// fallback). This is the W7 + A1 capture-handle correctness fix.
// Where a `<~` site's delay line lives — the record of the function that
// contains the cycle. `LhSlot(i)` is word `i` past the record header (a
// closure's captures, a handler record's state and arms, a continuation's
// metadata tail all precede it): the site reads the ring's address at
// `8 + 4*i` off its own `__state`, so every closure minted from one lambda,
// every install of one handler and every reified remainder owns its own
// line. `LhStatic` is a top-level fn's site: its record is the module's
// immutable data record, so the line address rides an instance global
// instead (`$__line_<site>_<symbol>`, one per emitted twin, allocated at
// start — a spawned instance allocates its own, the semantics the module
// globals had). `LhStaticJvp` is the same static line read under the
// derivative reading: the tick carries the line's TANGENT ring beside it
// (`$__tline_<site>_<symbol>`, the same geometry at f64, indexed by the
// primal ring's head), so a recurrence's sensitivity to the seed is itself
// a recurrence — only derive (src/derive.mn) writes it.
type LineHome = LhStatic | LhSlot(Int) | LhStaticJvp

effect LowerScope {
  // fn_name, locals_names, locals_handles, captures_names, captures_handles,
  // line_base — the record slot the frame's FIRST `<~` line takes (the
  // words before it: a closure's captures, a handler record's state and
  // arms, a k record's captures and metadata tail); -1 for a top-level
  // fn's frame, whose lines are static
  ls_enter_frame(String, [String], [Int], [String], [Int], Int)
  // the frame's `<~` sites as (site handle, depth, home) — the LowFn carries
  // them so the record's minter sizes the record and fills each line's slot
  ls_exit_frame() -> [(Int, Int, LineHome)]
  // a `<~` site (handle, depth) takes the innermost frame's next line slot
  ls_line_slot(Int, Int) -> LineHome
  // how many frames are open — 0 at a top-level declaration's own entry
  ls_frame_depth() -> Int
  // bind a local (name, type handle); returns the register the binder takes
  ls_bind_local(String, Int) -> String
  // (LF.B) bind a `<~` lambda param to its feedback site's prior — a binder
  // of the current frame, retired with the scope around the recurrence body
  ls_bind_fb_prior(String, Int)
  ls_resolve(String) -> (Resolution, Int)
  ls_register_globals([String])
  // the symbol a named fn declaration (name, handle) emits as: its name at
  // top level, else the enclosing named fn's symbol, a `.` and its name,
  // and `$k` on the k-th further declaration that path names
  ls_fn_symbol(String, Int) -> String
  // checkpoint = current frame's local count
  ls_push_scope() -> Int
  // truncate frame locals back to checkpoint
  ls_pop_scope(Int)
  // install the flow-closure map (name → escaping name-set; elements are the interned effect NAMES — eff_names_of's form, the ev ledger's native key)
  ls_register_escaping([(String, [String])])
  // a name's flow-closure name-set — the same string elements the register wrote (None = not a top-level fn → leaf); escaping_row lifts it at the one consumer
  ls_escaping_of(String) -> Option([String])
  // band B M1.3 — does ANY declared effect carry a MultiShot op? (computed once at lower_program)
  ls_register_may_yield(Bool)
  // the A1 prove-absence gate's global short-circuit: no MultiShot op anywhere ⇒ nothing can yield ⇒ every row proves absence
  ls_program_may_yield() -> Bool
  // AN-2 — the ops some provider of which may UNWIND: a handler whose residual row may yield, by name or by an open tail, every op of its arms (computed once at lower_program; [] when nothing yields)
  ls_register_unwinding_ops([String])
  // whether a direct perform of this op must be followed by the boundary check — an arm abandoning past it returns with the flag raised
  ls_unwinding_op(String) -> Bool
  // THE CUT (bank A3) — [(fn_name, hname)]: resume-bearing fns reachable from a MultiShot arm, bound to their handler (computed once at lower_program)
  ls_register_resume_binds([(String, String)])
  // the fn's bound handler name; "" = unbound (no wrap, no evidence threading)
  ls_resume_bind_of(String) -> String
  // whether a nominal type holds a wide-element sequence anywhere in its structure — settled once per name (the reach walk's read at an ==/ordering site), None while unsettled
  ls_wide_memo(String) -> Option(Bool)
  // settle a nominal type's wide-sequence fact
  ls_wide_note(String, Bool)
  // whether the walk is inside this nominal type's own structure (the cycle cut)
  ls_wide_walking(String) -> Bool
  // enter a nominal type's structure; leave it
  ls_wide_enter(String)
  ls_wide_leave()
}

// Every refinement unification performs verify(span, pred, reason).
// verify_ledger accumulates (V_Pending); verify_smt discharges (E_RefinementRejected on
// reject). Handler swap; source code unchanged.
effect Verify {
  // the module the obligation was raised in rides the perform: the ledger arm
  // is graph-free (its row rides every install), so it cannot read the module
  // itself, and a local span alone cannot name a file — two modules both have
  // a line 8. Captured where it is live, carried, never re-derived.
  // THE LEDGER ANSWERS ITS VERDICT (C5): Some(true) proven, Some(false)
  // refused (reported at the site), None accrued as pending debt. A
  // judgment that needs the outcome — the division site charging `Trap`
  // only when its precondition stays open — reads it here, off the one
  // decide, never a second decide beside the ledger's.
  verify(Int, Span, Predicate, Reason) -> Option(Bool)
  verify_debt() -> [(Int, Span, Predicate, Reason)]
  // The generation boundary's clear, for the modules about to be re-judged:
  // the obligations raised in each one's CURRENT node are dropped before its
  // judgment re-accrues them, and every other module's stand, because a
  // module outside the re-judged cone was judged against exactly the tree it
  // is judged against now. It cleared the WHOLE ledger while the session
  // re-derived the whole weave, which was the only thing that made that
  // sound; and the warm compile, which re-judges a cone inside a restored
  // image, never cleared at all — measured 2026-10-02 on boot 713745c6, one
  // edit to an entry carrying one open claim and the warm compile reported
  // it twice. Keyed by the module HANDLE so the arm stays graph-free.
  verify_forget([Int])
}

// ifc non-interference: verify(span, PFlowLe(src, dst), reason)
// predicate_decide(PFlowLe(a,b)) = Some(flow_le(a,b)) — always compile-time decidable.
// ERefinementRejected carries the violation; show_predicate renders "Secret ⊑ Public".
// No separate op. No separate handler arm. No separate diagnostic.
//
// Every VarRef performs consume(name, ownership, span), carrying authored
// parameter ownership from the env lookup that already happened at the use-site.
// affine_ledger enforces linearity only for authored Own. Unmarked params are
// resolved later by the structural use-count pass and written into the TFun.
//
// Branching ops implement the branching ledger for BOTH parallel
// (`><` / `<|`) and alternative (`if` / `match`) arms — the BranchMode
// carried at branch_enter tells them apart. At branch_enter the handler
// stashes `used` as a base and the mode; branch_divider captures the
// delta since base, stashes it in the frame, resets used to base;
// branch_exit captures the final arm's delta, unions all deltas into
// used, pops the frame — and, for BParallel only, pairwise-checks
// collisions (a name consumed in two arms that BOTH run is a double
// consume → E_OwnershipViolation). Alternative arms never collide: only
// one runs, so a name consumed across arms is one consume on the taken
// path.
effect Consume {
  consume(String, Ownership, Span)
  branch_enter(BranchMode)
  branch_divider(Span)
  branch_exit(Span)
  // A function body is a consume SCOPE — its `own` params are its own
  // linear resources, unrelated to any other body's. infer_fn brackets
  // each body with enter/exit so a name consumed in one function never
  // pollutes the next (affine_ledger is installed once at the pipeline,
  // not per body). Re-entrant for nested fn decls: enter pushes a fresh
  // frame, exit restores the parent's.
  consume_enter_fn()
  consume_exit_fn()
  // THE RELEVANT TIER (at-most-once gains its exactly-once half). The
  // ledger is AFFINE: it reports a name consumed twice and says nothing
  // about a name never consumed, so an `own` resource opened and dropped
  // on some path is silent — no finalization proof, and a persisted
  // continuation capturing it loses the obligation entirely. This op
  // records an AUTHORED `own` binding as it enters scope; consume_exit_fn
  // reports the ones the body never consumed. Declared, not inferred:
  // infer_ownership runs AFTER the body walk, so at entry the honest
  // fact is what the developer WROTE — and an authored `own` is exactly
  // the claim "this is mine to finish."
  consume_declare(String, Span)
  // This frame's authored-own names, projected whole. The persist value
  // gate reads it at a replay-boundary argument edge: a frame-declared
  // own FREE in the thunk crosses the wire, and the image memcpy carries
  // bytes, never the duty to finish them — each resumed run re-consumes.
  // Declared, not declared-minus-used: capturing the own IS its consume,
  // so a used-subtraction would blind the gate to the exact target.
  consume_declared() -> [String]
  // A BORROW scope — an `if` condition / `match` scrutinee is READ to
  // decide control, never moved, so a use inside it is a borrow, not a
  // consume. Between enter/exit the ledger drops consumes (a value read
  // here stays available in the arms). Nested via a depth counter.
  borrow_enter()
  borrow_exit()
  // The branch-cursor triple (the fan, C1c-2): a branch judges under a
  // FRESH ledger seeded with the root's consumed-set frozen at layer
  // start (consume_seed at bracket entry; consume_base is the root-side
  // capture), banks its own successful first-consumes (consume_log —
  // the sites list, prepend-ordered), and the join re-performs them at
  // the root in occurrence order — a same-layer double-consume
  // re-detects deterministically at the replay, never inside a branch.
  consume_seed([String])
  consume_base() -> [String]
  consume_log() -> [(String, Span)]
}

// Generic file I/O (read/write, mkdir, exists) — the driver's module
// reads and any build output. Operates relative to a preopen fd
// (wasmtime's --dir=. grants preopen fd 3 by convention).
//
// Row semantics: `with Filesystem` declares the function MAY touch
// the filesystem. `with !Filesystem` PROVES it does not — audit-
// driven linker severance can drop path_open / fd_close / etc.
// imports from binaries with proven !Filesystem.
//
// v1 takes preopen fd 3 as implicit. Parameterization via
// `with Filesystem("/workspace")` (H3.1 parameterized effects)
// lands when audit-driven permission scopes become meaningful.
//
// Returns bytes as a flat Mentl String (length prefix + bytes) —
// same shape as read_stdin for uniform downstream handling.
effect Filesystem {
  // ─── Original 4 ops (FS walkthrough; commit 1debfdc) ──────────
  fs_exists(String) -> Bool
  fs_read_file(String) -> String
  fs_write_file(String, String)
  fs_mkdir(String)
  // ─── FX.A.basics extension ops (FX walkthrough §1) ────────────
  // Cover the FileHandle-shaped surface Mentl-voice's Interact ops
  // need. Returns are domain-free (Int fd / Bool errno); ADT
  // projection (FileHandle / TreeEntry) lifted to mentl_voice_filesystem
  // handler per FX walkthrough §3.1.
  //
  // fs_list_dir lands separately as FX.A.dirent (dirent record parsing
  // is its own focused sub-handle).
  fs_open(String) -> Int
  // create+truncate for writing, returning the fd — distinct from fs_open's
  // read/write open (WASI oflags CREAT|TRUNC, write rights). It was missing
  // while three routes wrote files, which is the whole reason those routes
  // reached past this effect to fs_create_impl.
  fs_create(String) -> Int
  fs_close(Int)
  fs_unlink(String) -> Bool
  fs_rename(String, String) -> Bool
}

// diag_line — the line a report prints, one home: a pure read of the kind
// around the message the report carried, so any arm can print it and none
// re-renders the graph-reading part. Sequenced projections, then ONE
// splice-of-vars line: a single 5-splice interpolation mis-rendered the
// LAST splice when an earlier splice's evaluation allocated (the
// shared-scratch clobber class, §9); a splice list of pre-built values has
// nothing to clobber.
// THE ADDRESS IS (MODULE, SPAN) — the same law the census site line and the
// refs facet answer to. `at 4479:38` names a line in NO FILE, and `src` does
// not rescue it: src is the PHASE (`infer`, `parser`), not the module, so a
// diagnostic about main.mn reads `parser: … at 148:32` and the reader greps to
// find out whose line 148 that was. The module was already carried — report
// reads it live and hands it to every arm, whose own comment says the module
// "rides along unread" — so this was a rendered fact one parameter from being
// an address. Measured 2026-09-14 by a representation probe whose ~135 type
// errors named lines in fifteen different files and no file at all.
fn diag_line(diag, msg: String, dmod: String) with !Mutate = {
  let src = diag_source(diag)
  let code = diag_code(diag)
  let kindw = diag_kind(diag)
  let sp = show_span(diag_span(diag))
  "{src}: {code} {kindw}: {msg} at {dmod}:{sp}\n"
}

// A diagnostic AT a node: the module is the node's own column read
// (graph_module_of, total by construction), never the cursor's ambient
// position. That distinction is the whole reason this boundary exists in
// this form. The ambient module is right exactly while a
// walk is inside one file — the parse — and wrong the moment a walk spans the
// program: emit visits every reachable fn in table order, so "the module in
// force" is wherever the walk happens to be, and under the driver's
// ScopeModule register a report attributed that way filters out as another
// file's business. Measured on the driver path: a program with a field-offset
// floor compiled to an EMPTY stderr and trapped at the instruction that admits
// it, while the blob path (no scope) printed the class all along — a gate green
// on a chain the developer never runs.
//
// The target this is one step toward, ripple measured 2026-09-17: DiagKind's
// 65 constructors each COPY a Span out of a handle their report site had in
// hand (§11's provenance face, the same defect Reason carries). The copy
// deletes when the constructor carries the handle and span/module are both
// column reads; what gates that is the parser's 17 sites, which report at a
// token span and leave the hole to their caller, so recovery must change
// before they can report at a node. Until then this takes the handle and the
// diag keeps its span.
fn report_at(h, diag) = diag_report_at(diag, module_name_of_handle(graph_module_of(h)))

// The parse-phase form: a report inside the module being parsed, where the
// module in force IS the right one because the parser never leaves a file.
// Defined as report_at at the module node — the module attributes itself, so
// this is the same read — and NOT a second boundary: a site that has a node
// reports at it, and a site that reaches for this instead of its handle after
// the parse is reporting from the wrong place.
fn report(diag) = report_at(graph_module_current(), diag)

// The one place a report is rendered: its message, once, here in the
// reporter's own world, where the graph and the intern are live, riding the
// op beside its kind and its module. Every arm downstream composes its line
// from those (diag_line), and buffers, tallies or prints it without reading
// the graph, so no diagnostic arm depends on where the graph is installed.
// The module is read once and rides beside the message, so the line an arm
// prints and the scope it registers cannot drift apart into two answers
// about one report.
fn diag_report_at(diag, dmod) = diag_report(diag, diag_message(diag), dmod)

// A module handle's own name, read from its node. The non-NModule arm REFUSES
// rather than answering "": every value in the module column was written by
// graph_module_enter with an NModule handle, and every compile enters its link
// root before anything can report, so a miss here is a node minted outside any
// module — a defect in the caller. Answering with an empty name would hand
// every downstream reader a file called nothing and make the defect invisible,
// which is the wildcard-fabrication the census convicts.
fn module_name_of_handle(h) = match graph_node_body(h) {
  NModule(m) => m.path,
  _ => {
    out_of_range()
    ""
  },
}

// Every show_* that renders a Ty chases TVars through graph_chase.
// A raw handle only appears when chase terminates on NFree/NRowFree —
// the query layer reads that as "unresolved at epoch e." No cached
// display. Same discipline as lowering: live observer, never mirror.
fn show_type(ref ty) with !Mutate = match ty {
  TInt => "Int",
  TFloat => "Float",
  TUnit => "()",
  TByte => "Byte",
  TAddr => "Addr",
  TList(elem) => "List({show_type(elem)})",
  TTuple(elems) => "({show_list(elems, show_type, ", ")})",
  TFun(params, ret, row) => "({show_list(params, show_tparam, ", ")}) -> {show_type(ret)}{show_row_suffix(row)}",
  TVar(id) => show_handle(id),
  TName(name, args) => "{name}{show_type_args(args)}",
  TRecord(fields) => "\{ {show_list(fields, show_field, ", ")} \}",
  TRecordOpen(fields, v) => "\{ {show_list(fields, show_field, ", ")} | {show_handle(v)} \}",
  TRefined(base, pred) => "{show_type(base)} where {show_predicate(pred)}",
  TCont(input, answer, disc, world) => "Cont({show_type(input)} {show_discipline(disc)} {show_type(answer)}{show_row_suffix(world)})",
  TAlias(name, _) => // RN.1 — show the alias name (intent), not the resolved type
  name,
  TReprPin(r, base) => "{show_type(base)} repr {repr_wat(r)}",
}

// A residual bind, rendered with WHAT ITS WRITER KNEW. The fields alone
// cannot say whether a remainder was proven or merely unseen, and reading
// them as though they could is the wrong-slot class at the projection
// layer — `{ }` from a closed partner is a proof, `{ }` from two partial
// sets is a guess, and they used to print identically.
fn show_record_row_residual(fields, tail) with !Mutate = match tail {
  RowClosed => show_type(TRecord(fields)),
  RowContinues(v) => "{show_type(TRecord(fields))} | {show_handle(v)}",
}

// show_handle — the live-chase projection. Resolved handles show the
// bound type; free handles show the raw handle with allocation epoch
// so query can surface "unresolved at epoch e"; error holes show the
// failure reason inline.
fn show_handle(h) with !Mutate = {
  let node = graph_chase(h)
  match node {
    GNode(NBound(ty), _) => show_type(ty),
    GNode(NRowBound(row), _) => show_effrow(row),
    GNode(NRecordRowBound(fields, tail), _) => show_record_row_residual(fields, tail),
    GNode(NFree(epoch), _) => "t{int_to_str(h)}@e{int_to_str(epoch)}",
    GNode(NRowFree(epoch), _) => "r{int_to_str(h)}@e{int_to_str(epoch)}",
    GNode(NErrorHole(reason), _) => "!hole[{show_reason(reason)}]",
  }
}

// A call's arguments as the callee's positional PRODUCT: positionally, by
// field (label), mixed, or with defaults filling absent fields, one machinery
// with a record literal (SYNTAX §«Labeled call arguments»). This is the
// judgment's one read; its answer is written at the call node (the
// call-product column, `graph_product_note`) and the lowering reads that, so
// the two see one product by construction. The LabeledArg wrappers and the
// reorder are resolved away here; downstream sees only positional value
// nodes.
//
// PARAMS are the callee's declared TParams, which the judgment reads off the
// callee NODE's own type, never by name. Positional args fill the next un-claimed slot
// left-to-right; a labeled arg claims its named slot (skip-over); a slot no
// arg reaches is filled by the param's default node (the absent product
// field's fallback construction). An unknown label is E_UnknownArgLabel —
// Located, productive-under-error (the arg is dropped, parsing continues).
//
// No declared params (forward ref / fn-param callee / constructor): no labels
// to resolve against. Strip any stray LabeledArg wrappers to their value so
// downstream never meets the wrapper, and keep positional order.
fn resolve_call_args(params, args, cname: String) =
  if len(params) == 0 { map(unwrap_labeled_arg, args) } else { fill_arg_slots(params, args, cname) }

// Unwrap a LabeledArg to its value node; a positional arg passes through.
fn unwrap_labeled_arg(arg) with Pure = match arg {
  N(body, _, _) => match body {
    NExpr(LabeledArg(_, v)) => v,
    _ => arg,
  },
}

// Build the positional slot buffer (one slot per declared param, 0 = unfilled
// sentinel — a real arg node is a non-zero handle). Two passes over the args:
// labeled args claim their named slot first (skip-over); positional args then
// fill the remaining unfilled slots left-to-right. Then collect each slot to
// its placed value or its param default.
fn fill_arg_slots(params, args, cname) = {
  let n = len(params)
  let claimed = place_labeled(params, args, 0, make_list(n), cname)
  let filled = place_positional(args, 0, 0, claimed, n)
  collect_slot_nodes(params, filled, 0, n, make_list(n), 0)
}

// Pass 1 — place each LabeledArg at its named param slot; positional args are
// skipped here. An unknown label is E_UnknownArgLabel (Located, productive:
// the arg is dropped, the remaining args resolve). Returns the slot buffer.
fn place_labeled(params, args, i, slots, cname: String) = if i >= len(args) {
  slots
} else {
  let arg = list_index(args, i)
  match arg {
    N(body, sp, _) => {
      let next = match body {
        NExpr(LabeledArg(label, v)) => {
          let idx = param_index(params, label, 0)
          if idx < 0 {
            report(EUnknownArgLabel("no parameter named `{label}` on `{cname}`", sp))
            slots
          } else {
            list_set(slots, idx, v)
          }
        },
        _ => slots,
      }
      place_labeled(params, args, i + 1, next, cname)
    },
  }
}

// Pass 2 — fill positional (non-labeled) args into the next unfilled slot,
// left-to-right, skipping slots a label already claimed. `cur` is the arg
// cursor; `slot` advances past filled slots.
fn place_positional(args, cur, slot, slots, n) = if cur >= len(args) {
  slots
} else {
  let arg = list_index(args, cur)
  match arg {
    N(body, aspan, _) => match body {
      NExpr(LabeledArg(_, _)) => place_positional(args, cur + 1, slot, slots, n),
      _ => {
        let free = next_free_slot(slots, slot, n)
        if free >= n {
          // An argument with no slot is the refusal, and it must be
          // spoken HERE: dropping it is what makes every downstream count
          // equal, so no later judgment can see the mismatch. The span is
          // the surplus argument's own — the thing with no home.
          report(EFnArityMismatch(n, len(args), aspan))
          slots
        } else {
          place_positional(args, cur + 1, free + 1, list_set(slots, free, arg), n)
        }
      },
    },
  }
}

// A slot word's presence — the Option-of-handle niche read at the repr
// altitude (0 = absent, a node's handle-word = present; §5.U: a handle IS a
// word). Substrate-table-typed `a -> Bool` so the test never pins the slot's
// element type onto Int (the census's Node-vs-Int at collect_slot_nodes);
// the raw body compares the word. The full niche repr — construction and
// match projection — is Hβ.emit.option-niche-repr; this is its read half,
// the one piece the arg-slot machinery needs.
fn slot_present(w) with Pure = w != 0

// The first slot at or after `from` still absent; n when none remain.
fn next_free_slot(slots, from, n) = if from >= n {
  n
} else if slot_present(list_index(slots, from)) {
  next_free_slot(slots, from + 1, n)
} else {
  from
}

// The param index whose name is `label`, or -1 when no param bears it.
fn param_index(params, label, i) = if i >= len(params) {
  -1
} else {
  if param_name(list_index(params, i)) == label { i } else { param_index(params, label, i + 1) }
}

// Project each slot to its placed value node, or — when the slot is the 0
// sentinel — the param's default node. A sentinel slot with no default is
// dropped (a genuinely-missing required arg is infer's arity check, surfaced
// at the call). The contiguous prefix of present args is returned in order.
fn collect_slot_nodes(params, slots, i, n, out, count) = if i >= n {
  slice(out, 0, count)
} else {
  let placed = list_index(slots, i)
  if slot_present(placed) {
    collect_slot_nodes(params, slots, i + 1, n, list_set(out, count, placed), count + 1)
  } else {
    match param_default(list_index(params, i)) {
      Some(expr) => collect_slot_nodes(params, slots, i + 1, n, list_set(out, count, expr), count + 1),
      None => collect_slot_nodes(params, slots, i + 1, n, out, count),
    }
  }
}

// The prefixes a desugar mints a parameter's name under, one home for the
// spelling: `dp_prefix` for a pattern written in parameter position,
// `al_prefix` for the arm-list literal's one parameter. They are two because
// the formatter may render only the first back into parameter position: a
// parameter-position pattern is one the parser could read as an expression,
// while an arm's pattern is arbitrary, and rendering `{ 0 => 1 }` as a
// parameter would turn its literal into a wildcard.
let dp_prefix = "__dp"

let al_prefix = "__al"

fn name_has_prefix(nm, prefix) =
  byte_len(nm) >= byte_len(prefix) && str_slice(nm, 0, byte_len(prefix)) == prefix

// A parameter no author named. A type renders it as its type alone, since
// the name it carries exists in no source a developer can read.
fn minted_param_name(nm) = name_has_prefix(nm, dp_prefix) || name_has_prefix(nm, al_prefix)

fn show_tparam(ref tp) = {
  let base = if minted_param_name(param_name(tp)) {
    show_type(param_ty(tp))
  } else {
    "{param_name(tp)}: {show_type(param_ty(tp))}"
  }
  match param_authored(tp) {
    Unmarked => match param_resolved(tp) {
      Unmarked => base,
      _ => "{base}{show_ownership(param_resolved(tp))} — inferred",
    },
    _ => "{base}{show_ownership(param_authored(tp))} — declared",
  }
}

fn show_ownership(o) with Pure = match o {
  Unmarked => "",
  Own => " own",
  Ref => " ref",
}

fn show_discipline(d) with Pure = match d {
  OneShot => "OneShot",
  MultiShot => "MultiShot",
  Either => "Either",
  Abandon => "Abandon",
}

fn show_field(ref field: (String, Ty)) with !Mutate = match field {
  (name, ty) => "{name}: {show_type(ty)}",
}

fn show_type_args(ref args) with !Mutate =
  if len(args) == 0 { "" } else { "({show_list(args, show_type, ", ")})" }

fn show_row_suffix(ref row) with !Mutate = match row {
  EfRow([], [], EtClosed) => "",
  _ => " with {show_effrow(row)}",
}

// An edge in the row's own algebra: the cell alone, or `(r - E - F)` when a
// `~>` on its path subtracts — the difference SYNTAX already spells, so the
// projection names which computation each absorption covered.
fn show_row_edge(e: RowEdge) with !Mutate = if len(e.mask) == 0 {
  show_handle(e.cell)
} else {
  "({show_handle(e.cell)} - {show_list(e.mask, show_eff_name, " - ")})"
}

// The triple's voice: presents joined with `+`, the absent set as `!X`
// terms, the tail as its var handle; an empty closed row is Pure.   // drift-audit: ignore — human-facing rendering string for diagnostics/show; not an effect-keyed lookup; tracked by Hβ.perf.name-is-handle; effect-rendering normalization
fn show_effrow(ref row) with !Mutate = match row {
  EfRow(p, a, t) => {
    let parts = show_list(p, show_eff_name, " + ")
    let negs = show_list(a, (n) => "!{show_eff_name(n)}", " + ")
    let joiner = if len(p) > 0 && len(a) > 0 { " + " } else { "" }
    let head = "{parts}{joiner}{negs}"
    match t {
      EtClosed => // drift-audit: ignore — the renderer WRITES the surface word for the empty row (SYNTAX: Pure is the identity's spelling); no dispatch reads it
      if len(p) == 0 && len(a) == 0 { "Pure" } else { head },
      EtAll => // A named EtAll row must render distinguishably from a closed one:
      // reading = p ∪ (ALL ∖ a), so the tail carries "everything else" — the
      // 2026-07-31 census read forty EtAll-vs-EtClosed refusals as phantom
      // positives mismatches because this arm rendered `head` bare.
      if len(p) == 0 && len(a) == 0 { "Any" } else { "{head} + Any" },
      EtOpen(vs) => // every edge renders (the set is the tail); the empty set
      // reads as closed — ef_make canonicalizes it away, and the voice
      // stays total over it regardless (display-totality).
      if len(vs) == 0 {
        if len(p) == 0 && len(a) == 0 { "Pure" } else { head }
      } else {
        let tails = show_list(vs, show_row_edge, " + ")
        if len(p) == 0 && len(a) == 0 { tails } else { "{head} + {tails}" }
      },
    }
  },
}

// What a refinement states about a type's inhabitants, said to a person. The
// open-bounded arms name the side that IS bounded rather than inventing an
// infinity symbol for the side that is not, and TOP says the truth the
// unbounded-domain residue names (`Hβ.synth.unbounded-domain-asks`): nothing
// here narrows the position, which is why the medium is asking at all.
fn show_domain(d) = match d {
  DRange(lo, hi) => match (lo, hi) {
    (Some(l), Some(h)) => "the type admits {int_to_str(l)} through {int_to_str(h)}",
    (Some(l), None) => "the type admits {int_to_str(l)} and up",
    (None, Some(h)) => "the type admits up to {int_to_str(h)}",
    (None, None) => "nothing here bounds the value — a refinement would",
  },
  DFinite(vs) => "the type admits exactly {int_to_str(len(vs))} value(s)",
  DUndecided => "the predicate is past the decidable fragment, so the type's bound is unread",
}

// The arm's NAME — what a proposal fixture's `// propose` contract names
// (`mentl test` over tests/proposals), so a contract binds the
// classification and never the sentence.
fn divergence_arm(d) with Pure = match d {
  DivRow(_, _) => "row",
  DivType(_, _, _) => "type",
  DivName => "name",
  DivValue(_) => "value",
  DivVariants(_) => "value",
  DivShape => "shape",
  DivBehavior => "behavior",
}

// The tie's one line: the proposition the developer never stated, spoken in
// the vocabulary of whatever separates the survivors. Never "one more
// constraint collapses it" — that sentence was the same words at every tie,
// which is a placeholder wearing a teaching voice.
fn show_divergence(d) with !Mutate = match d {
  DivRow(a, b) => "these differ in what they may DO — {show_effrow(a)} against {show_effrow(b)}: which capability does this position carry?",
  DivType(a, b, r) => "these differ in TYPE — {show_type(a)} against {show_type(b)}: which type does this position hold? (the cell that moves: {show_reason(r)})",
  DivName => "every survivor denotes the same value — the question is which name carries the intent",
  DivValue(dom) => "the survivors differ in VALUE and {show_domain(dom)}: which one does this position mean?",
  DivVariants(names) => "the survivors are the type's own values — {join(" or ", names)}: which one does this position mean?",
  DivShape => "the survivors differ in SHAPE — what structure does this position hold?",
  DivBehavior => "these are different computations of the same type — an example of the result, or a refinement on it, decides which one this position means",
}

fn show_eff_name(ref name) with !Mutate = match name {
  ENamed(h) => intern_name_of(h),
  EParameterized(h, args) => "{intern_name_of(h)}({show_list(args, show_eff_arg, ", ")})",
  EPure => // drift-audit: ignore — variant→surface-label render, not a name key
  // DISPLAY-TOTALITY, not a data-drop. The mentl voice must be TOTAL — it can
  // never crash while REPORTING a diagnostic (a renderer that traps mid-report
  // is the worst failure). A malformed name-slot (a non-EffName the seed's
  // incomplete inference minted into a FAILED-type's row — E_OccursCheck — that
  // reaches only STDERR, never the WAT) is SHOWN honestly here, never hidden:
  // Carried-Truth governs DATA carrying truth; this is DISPLAY, which must
  // render every input. The mint is the seed catching up — peer
  // Hβ.infer.effect-row-no-null-name shrinks the census (§7 shadow) toward 0;
  // this is the voice's total floor, on the m3-produced (productive-under-error)
  // half of first-light, orthogonal to the m3==m4 fixpoint (WAT-only).
  "Pure",
  _ => // drift-audit: ignore — display-totality floor; honest placeholder, not data classification
  "«invalid-effect»",
}

fn show_eff_arg(ref arg) with !Mutate = match arg {
  EAInt(n) => int_to_str(n),
  EAFloat(f) => float_to_str(f),
  EAString(s) => "\"{s}\"",
  EAType(t) => // The instance's payload IS a type the renderer already speaks — the
  // old opaque marker hid the exact instance the diagnostic exists to
  // teach (!Cast vs Cast(<type>) named the class live, 2026-07-24).
  show_type(t),
  EANode(h) => // The operand node's own source spelling — the row render is the
  // developer's surface, and the debug form broke fmt's render→re-parse
  // fixpoint the day an EANode instance reached a with-clause (measured
  // 2026-08-08: `Sample(rate)` rendered `Sample(<operand #N>)`, which
  // the canonical render's own re-parse refused). A shape beyond a bare
  // name keeps the honest placeholder (display totality).
  match graph_node_body(h) {
    NExpr(VarRef(name)) => name,
    _ => "<operand #{int_to_str(h)}>",
  },
  EAEffect(h) => // The bare spelling holds the fmt fixpoint: the render
  // re-parses to EANode and re-resolves to the same folded form.
  intern_name_of(h),
  EACon(h) => intern_name_of(h),
}

fn show_predicate(ref pred) = match pred {
  PTrue => "true",
  PCompare(op, a, b) => "{show_pred_operand(a)} {show_cmp_op(op)} {show_pred_operand(b)}",
  PAnd(a, b) => "{show_predicate(a)} && {show_predicate(b)}",
  POr(a, b) => "{show_predicate(a)} || {show_predicate(b)}",
  PNot(p) => "!{show_predicate(p)}",
  PBoolNode(n) => show_pred_operand(n),
  PPatternMatch(_, n) => "{show_pred_operand(n)} matches _",
  PFlowLe(src, dst) => // IFC: src must not exceed dst in the lattice
  // The binder renders as its body — the diagnostic reads `self + 1 <= 10`
  // with self SYMBOLIC (the SYNTAX-canonical spelling), never the
  // substituted value.
  "{show_flow_label(src)} ⊑ {show_flow_label(dst)}",
  PWithSelf(_, inner) => show_predicate(inner),
  PTotalDiv(op, a, b) => match op {
    BMod => "{show_pred_operand(b)} != 0 (the divisor of {show_pred_atom(a)} % {show_pred_atom(b)})",
    _ => "{show_pred_operand(b)} != 0 && {show_pred_atom(a)} / {show_pred_atom(b)} fits (never INT_MIN / -1)",
  },
  PProvides(provided) => show_provided(provided),
}

fn show_provided(provided) = match provided {
  ProvidedNone => "self is never handed a value",
  ProvidedAt(nodes) => "self is one of {join(", ", nodes |> map(show_pred_operand))}",
  ProvidedBeyond(nodes) => if len(nodes) == 0 {
    "self is any value"
  } else {
    "self is one of {join(", ", nodes |> map(show_pred_operand))}, or any value"
  },
}

fn show_cmp_op(ref op) with Pure = match op {
  BEq => "==",
  BNe => "!=",
  BLt => "<",
  BLe => "<=",
  BGt => ">",
  BGe => ">=",
  _ => "?",
}

// Resolve a predicate operand HANDLE to its Expr live and render it.
fn show_pred_operand(handle) = match graph_node_body(handle) {
  NExpr(VarRef(name)) => name,
  NExpr(LitInt(n)) => int_to_str(n),
  NExpr(LitFloat(f)) => float_to_str(f),
  NExpr(LitString(s)) => "\"{s}\"",
  NExpr(CallExpr(callee, _)) => "{show_callee_name(callee)}(...)",
  NExpr(UnaryOpExpr(UNeg, inner)) => // The predicate grammar's compound operands render recursively — a
  // refinement's `-1.0 <= self` carries UnaryOpExpr(UNeg, LitFloat) on the
  // left, and `self % 2` carries a BinOpExpr; both rendered `<expr>` before,
  // fabricating away the exact bound the diagnostic exists to teach.
  match inner {
    N(_, _, ih) => "-{show_pred_operand(ih)}",
  },
  NExpr(UnaryOpExpr(UNot, inner)) => match inner {
    N(_, _, ih) => "!{show_pred_operand(ih)}",
  },
  NExpr(BinOpExpr(op, l, r)) => match l {
    N(_, _, lh) => match r {
      N(_, _, rh) => "{show_pred_atom(lh)} {binop_to_str(op)} {show_pred_atom(rh)}",
    },
  },
  NExpr(CallExpr(callee, args)) => // The canonical refinement vocabulary is call-shaped (len(self),
  // abs(x)) — render the call rather than a placeholder; an exotic
  // callee degrades through show_callee_name's own sentinel.
  "{show_callee_name(callee)}({show_list(args, { N(_, _, ah) => show_pred_operand(ah) }, ", ")})",
  _ => "<expr>",
}

// An operand standing beside an operator keeps the parentheses its source
// needs when it is itself an operation: the partiality claim of
// `100 / (k - 1)` rendered `100 / k - 1`, a different program (measured on
// boot 8b071ba3 at the caret's Verify facet and in the ledger's line alike).
fn show_pred_atom(handle) = match graph_node_body(handle) {
  NExpr(BinOpExpr(_, _, _)) => "({show_pred_operand(handle)})",
  _ => show_pred_operand(handle),
}

fn show_callee_name(ref callee) with Pure = match callee {
  N(cbody, _, _) => match cbody {
    NExpr(VarRef(n)) => n,
    _ => "_",
  },
}

// One hop of a Reason chain in a developer's words, never its subtree: the
// caret's Why prints each hop with it and walks the hops beneath, and the
// emit's comment at a function boundary prints the head. `show_reason` below
// is the other projection, the whole chain on one line.
fn reason_phrase(reason) with !Mutate = match reason {
  Declared(name) => "declared {name}",
  Inferred(s) => s,
  Fresh(_) => "a fresh type variable",
  OpConstraint(op, _, _) => "the operator {op}",
  VarLookup(name, _) => "{name} flows in here",
  FnReturn(name, _) => "returned from {name}",
  FnParam(name, i, _) => "parameter {int_to_str(i + 1)} of {name}",
  MatchBranch(_, _) => "a match's branches",
  ListElement(_) => "a list element",
  IfBranch(_) => "an if's branches",
  LetBinding(name, _) => "let {name}",
  Unified(_, _) => "two provenances unified",
  Instantiation(name, _) => "an instance of {name}",
  UnifyFailed(_, _) => "a unification that failed",
  Placeholder(_) => "authored here",
  BinOpPlaceholder(_) => "an operator's operand",
  MissingVar(name) => "{name} is unresolved",
  Refinement(_, _) => "a refinement",
  Located(_, inner) => reason_phrase(inner),
  InferredCallReturn(name, _) => "the call to {name}",
  InferredPipeResult(v, _) => "through {v}",
  FreshInContext(_, ctx) => "fresh in {ctx}",
  DefaultReason(name, _) => "{name} defaulted",
  VerifyWitness(w) => "the witness {w}",
  Accepted(text, proof, _) => "accepted `{text}` — proposed: {show_reason(proof)}",
}

fn show_reason(ref reason) with !Mutate = match reason {
  Declared(name) => "declared as {name}",
  Inferred(ctx) => "inferred from {ctx}",
  Fresh(id) => "fresh {show_handle(id)}",
  OpConstraint(op, l, r) => "operator {op} constrains {show_reason(l)} with {show_reason(r)}",
  VarLookup(name, inner) => "lookup {name} → {show_reason(inner)}",
  FnReturn(name, inner) => // drift-audit: ignore — "return of" is a Reason rendering string, not a control keyword
  "return of {name} → {show_reason(inner)}",
  FnParam(name, idx, _) => "parameter {int_to_str(idx + 1)} of {name}",
  MatchBranch(a, b) => "match branch: {show_reason(a)} ~ {show_reason(b)}",
  ListElement(inner) => "list element: {show_reason(inner)}",
  IfBranch(inner) => "if branch: {show_reason(inner)}",
  LetBinding(name, inner) => "let {name} = {show_reason(inner)}",
  Unified(a, b) => "{show_reason(a)} unified with {show_reason(b)}",
  Instantiation(name, inner) => "instantiate {name} → {show_reason(inner)}",
  UnifyFailed(ta, tb) => "cannot unify {show_type(ta)} with {show_type(tb)}",
  Placeholder(span) => "placeholder at {show_span(span)}",
  BinOpPlaceholder(op) => "binop {binop_to_str(op)}",
  MissingVar(name) => "unbound variable: {name}",
  Refinement(p, q) => "refinement: {show_predicate(p)} ∧ {show_predicate(q)}",
  Located(span, inner) => "at {show_span(span)}: {show_reason(inner)}",
  InferredCallReturn(callee, inner) => // RX.2 — high-intent structured variants
  "call to '{callee}' → {show_reason(inner)}",
  InferredPipeResult(verb, inner) => "{verb} pipe → {show_reason(inner)}",
  FreshInContext(id, ctx) => "fresh {show_handle(id)} in '{ctx}'",
  DefaultReason(pname, span) => "{pname} defaulted at {show_span(span)}",
  VerifyWitness(model) => "proved by SMT witness: {model}",
  Accepted(text, proof, inner) => "accepted `{text}` — {show_reason(proof)} → {show_reason(inner)}",
}

// A diagnostic's reason on the diagnostic's own line: the outer address is
// the span the diagnostic already carries, so it is dropped, and what
// remains is the chain the unify was asked with, so `Int vs List(Byte)` at
// an install says which arm answered the second.
fn reason_line(reason) with !Mutate = match reason {
  Located(_, inner) => show_reason(inner),
  _ => show_reason(reason),
}

// What suspends at an uncapturable position: the op performed there, or the
// callee whose row proves it performs the op somewhere inside.
fn uncapturable_subject(op: String, via: String) =
  if byte_len(via) == 0 { "`{op}`" } else { "`{via}`, whose row carries `{op}`," }

fn show_span(ref span) = match span {
  Span(sl, sc, el, ec) => "{int_to_str(sl)}:{int_to_str(sc)}-{int_to_str(el)}:{int_to_str(ec)}",
}

// ─── The seam render — weave spans as the developer's coordinates ───
//
// The module seams read once from the graph: the driver minted one
// NModule per woven file at discovery (the same seam truth the comment
// re-homing pass reads), so any weave span resolves to `path:local_line`
// live — no side table, no hand map. A seam-free blob weave (stdin, the
// march) yields an empty seam list and every span renders raw — the
// census's own coordinates, by construction. One home; the verify debt
// lines and the query refs facet both project through it.
// module_seams / seams_walk / span_render_local / seam_of_line DELETED with
// the weave. They existed to answer "which file is this weave line in" by
// scanning every module's range for one that contained it — O(nodes) per
// call, three callers. Spans are the developer's own coordinates now, so the
// question has no content: every module starts at line 1, which also makes
// the scan actively WRONG rather than merely slow (it would resolve any line
// to the first module). A span that still needs its file needs a HANDLE, not
// a range table — Hβ.why.reason-span-is-a-weave-coordinate.
fn show_pipe_kind(pk) with Pure = match pk {
  PForward => "|>",
  PFanout(FanShare) => "<|",
  PFanout(FanDistribute) => "><",
  PTee => "~>",
  PFeedback => "<~",
}

// Renders FIRST-first: the last/drop_last walk (O(1) on snoc) rendered
// every list REVERSED — function params, tuple elements, and record
// fields in show_type all spoke backwards (measured live: map's
// declared (f, xs) rendered as (xs, f...)). Declaration order is the
// truth; the index walk pays O(depth) per element on snoc-built lists,
// immaterial at render scale.
fn show_list(ref items, ref render, ref sep) with !Mutate =
  show_list_from(items, render, sep, 0, len(items))

fn show_list_from(ref items, ref render, ref sep, i, n) with !Mutate = if i >= n {
  ""
} else if i + 1 >= n {
  render(items[i])
} else {
  render(items[i]) ++ sep ++ show_list_from(items, render, sep, i + 1, n)
}

// ── DAG-homed here (the import-truth sweep, 2026-07-23): each fn below
// moved from a module DOWNSTREAM of its users so every user reaches it
// through a forward import edge — the manifest tells the truth.
//
// query_flow_label — the IFC projection (§4⑥).
// Reads FlowLabel from the Ty the graph already holds; no new state.
//
//   TRefined  — pred |> predicate_flow_label; join with base's label
//   TName     — follow env to the TypeDecl's predicate (graph-native; no string matching)
//   TFun      — row  |> row_flow_label (the absent set IS the non-interference proof)
//   TList     — elem |> query_flow_label (label propagates through containers)
//   TTuple    — elems |> map |> fold(Public, flow_label_join)
//   TRecord   — fields |> map |> fold(Public, flow_label_join)
//   _         — Public (open-world default; unannotated = observable)
//
// H6: exhaustive over every Ty constructor.
// GraphRead + EnvRead: predicate_flow_label follows PBoolNode handles into graph;
// TName arm follows the type's env entry to read its predicate.
fn query_flow_label(ref ty) = match ty {
  TRefined(base, pred) => flow_label_join(pred |> predicate_flow_label, query_flow_label(base)),
  TName(name, _) => // Follow the type's env entry to its TypeDecl predicate — graph-native.
  // A nominal type with a refinement predicate (e.g. `type SecretKey = Bytes
  // where classified(self)`) carries its IFC classification in that predicate.
  // No string matching: the graph's env entry IS the source of truth.
  match env_lookup(name) {
    None => // unknown type: open-world default
    Public,
    Some(entry) => match entry {
      (scheme, _, _) => match scheme {
        Frozen(_, ty) => match ty {
          TAlias(_, TRefined(_, pred)) => predicate_flow_label(pred),
          TRefined(_, pred) => predicate_flow_label(pred),
          _ => // non-refined nominal: Public
          Public,
        },
        Live(h) => match graph_chase(h) {
          GNode(kind, _) => match kind {
            NBound(ty) => query_flow_label(ty),
            _ => // a type decl's cell is NBound; row and error kinds carry no nominal label
            Public,
          },
        },
      },
    },
  },
  TFun(_, ret, row) => // A fn's flow character joins its RETURN's label with its row
  // confinement — a source returning Secret is a Secret channel
  // whatever its capabilities (the 2026-08-08 Phase-7 walk: `flow
  // getpw` on a `-> Secret where classified(self)` source answered
  // Public because this arm read the row alone).
  flow_label_join(query_flow_label(ret), row_flow_label(row)),
  TAlias(_, inner) => inner |> query_flow_label,
  TReprPin(_, base) => base |> query_flow_label,
  TList(elem) => elem |> query_flow_label,
  TTuple(elems) => elems |> map(query_flow_label) |> fold(Public, flow_label_join),
  TRecord(fields) => fields |> map({ (_, fty) => query_flow_label(fty) }) |> fold(Public, flow_label_join),
  TRecordOpen(fields, _) => fields |> map({ (_, fty) => query_flow_label(fty) }) |> fold(Public, flow_label_join),
  TCont(input, answer, _, _) => flow_label_join(query_flow_label(input), query_flow_label(answer)),
  TInt => Public,
  TFloat => Public,
  TUnit => Public,
  TByte => Public,
  TAddr => Public,
  TVar(_) => // unresolved: open-world default (no proof = observable)
  Public,
}

// predicate_flow_label — classify a Predicate's flow sensitivity.
// PBoolNode follows the handle into the graph to read the actual call node.
// A predicate call to a function whose name contains secret / classified /
// sensitive raises the label. This reads the AUTHORED name
// from the graph — not re-deriving, reading what the graph holds.
// H6: exhaustive over every Predicate variant.
fn predicate_flow_label(ref pred) = match pred {
  PTrue => Public,
  PCompare(_, _, _) => // numeric comparison: not a secrecy annotation
  Public,
  PPatternMatch(_, _) => // match-narrowing: not a secrecy signal
  Public,
  PNot(_) => // negation of secret IS NOT secret (non-monotone)
  Public,
  PFlowLe(a, _) => // the predicate itself carries the src label
  a,
  PAnd(a, b) => flow_label_join(predicate_flow_label(a), predicate_flow_label(b)),
  POr(a, b) => flow_label_join(predicate_flow_label(a), predicate_flow_label(b)),
  PWithSelf(_, inner) => // the `self` binder is transparent to flow
  predicate_flow_label(inner),
  PTotalDiv(_, _, _) => // a primitive's precondition: not a secrecy annotation
  Public,
  PProvides(_) => // a provision names the values handed, not a secrecy annotation
  Public,
  PBoolNode(h) => // Follow the handle into the graph — read the actual call node's callee name.
  // The callee name IS the authored intent; reading it is reading the graph.
  match graph_node_body(h) {
    NExpr(CallExpr(callee, _)) => match callee {
      N(cbody, _, _) => match cbody {
        NExpr(VarRef(fname)) => if str_contains(fname, "secret") || str_contains(fname, "classified") || str_contains(fname, "sensitive") {
          Secret
        } else {
          Public
        },
        _ => Public,
      },
    },
    _ => Public,
  },
}

// row_flow_label — the absent set in a function's row IS the non-interference
// proof. `with !IO + !Network` proves the function cannot route output to
// public sinks. On the canonical triple the stance is the TAIL: EtAll is the
// proved-absence form (masked universe); EtClosed/EtOpen rows are observably
// Public (their absent set records proofs but the row itself flows). H6:
// exhaustive over the three tails.
fn row_flow_label(ref row) with Pure = match row {
  EfRow(_, _, EtAll) => // A universal tail is the proved-absence stance (!E) — Secret; every
  // other form is observably Public (subtraction/openness conservative).
  Secret,
  EfRow(_, _, EtOpen(_)) => Public,
  EfRow(_, _, EtClosed) => Public,
}

// Resolve every `TVar` transitively through the graph. Every query
// that returns a `Ty` calls this so the user sees the resolved shape,
// never raw handles.

