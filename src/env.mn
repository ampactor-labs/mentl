// env.mn — the env substrate: the flat binding buffer, its O(1) index,
// and the handler that manages them (spec 04). Relocated from
// pipeline.mn (PLAN §11 Phase 3.5, the infer→pipeline handler seam):
// the install chain in infer names this handler, so the DECLARATION
// lives BELOW infer — the state's own module, imported by every
// installer. type Env + effect EnvRead/EnvWrite/BranchEnv still
// declare in types.mn, the op vocabulary's home; the handler lives
// with the state it manages.
import types

import strings

// env_handler — the scope the judgment resolves names through, and nothing
// else. One writer (inference). An entry is a name and the handle of the
// node that declares it: a statement, a constructor's variant, an op, the
// cell a parameter or a pattern binds, or the cell the judgment mints for a
// primitive. What the judgment learns about the declaration — its scheme,
// its reason, its kind — is published at that handle in the graph
// (`graph_publish`), so the scope maps a name to a node and the node carries
// its facts: a reader holding a reference follows its edge
// (`graph_ref_decl`) to the same facts, and a rollback takes them with every
// other write.
//
// The buffer is flat with a length counter; a scope's mark is the counter at
// its entry. The index is a 4096-bucket str_hash array whose buckets are
// SNOC STACKS of (name, position), pushed at the extend and popped at the
// scope's exit, newest first — so a bucket holds exactly the live bindings
// and a lookup walks only names that share its hash. Until 2026-10-14 the
// pairs were prepended and never removed: every scope re-entry left a dead
// pair behind, each lookup validated its way past them against the buffer,
// and that walk was a seventh of the self-compile.
fn env_index_new() = list_filled(4096, [])

fn env_bucket_of(name: String) = i32_and(str_hash(name), 4095)

fn env_index_add(idx, name: String, pos) = {
  let b = env_bucket_of(name)
  list_set(idx, b, push(list_index(idx, b), (name, pos)))
}

// A replaced statement's entries of `name` leave its bucket, whichever
// generation wrote them, so the name's live position is what the bucket held
// below them. Retraction happens with no scope open, so every pair it drops
// is the link's.
fn env_index_retract(buf, idx, name: String, stmt) = {
  let b = env_bucket_of(name)
  list_set(idx, b, filter({ pair => !declared_in(buf, pair, name, stmt) }, list_index(idx, b)))
}

fn declared_in(buf, pair, name: String, stmt) = match pair {
  (bn, pos) => bn == name && match list_index(buf, pos) {
    (_, decl) => enclosing_decl(decl) == Some(stmt),
  },
}

// A scope's exit pops its extends newest first, so the pair it pops is
// always the top of its bucket.
fn env_index_pop(idx, name: String) = {
  let b = env_bucket_of(name)
  list_set(idx, b, drop_last(list_index(idx, b)))
}

// The live position of `name` in its bucket, or -1: the stack read from
// its top, one step per name that shares the hash.
fn env_bucket_pos(bucket, name: String) = if len(bucket) == 0 {
  -1
} else {
  match last(bucket) {
    (bn, pos) => if bn == name { pos } else { env_bucket_pos(drop_last(bucket), name) },
  }
}

// The declaration at `name`'s live position in `buf`, or None.
fn scope_find(buf, count, idx, name: String) = {
  let pos = scope_pos(buf, count, idx, name)
  if pos < 0 {
    None
  } else {
    match list_index(buf, pos) {
      (_, decl) => Some(decl),
    }
  }
}

// The position of `name`'s live entry in `buf`, or -1. `count` bounds a base
// view: a branch reads its base's buffer up to the count it captured.
fn scope_pos(buf, count, idx, name: String) = {
  let pos = env_bucket_pos(list_index(idx, env_bucket_of(name)), name)
  if pos < count { pos } else { -1 }
}

// The TYPE-position read. One env, one namespace of entries; the KIND is the
// namespace discriminator (an effect decl and a type alias may share a name —
// `effect Sample` + `type Sample = Float where …` are both canonical). A type
// position (quantify_ctor_ty — every annotation surface) wants the newest
// TYPE-BEARING declaration: an alias-schemed Frozen (the only transparent
// kind) or a nominal record's RecordSchemeKind. The plain resolution returns
// the newest declaration of ANY kind, so a later-registered effect decl
// shadows the alias and the annotation bakes a bare nominal TName that never
// unifies with its base.
fn env_entry_is_type(ref scheme, ref kind) with Pure = match scheme {
  Frozen(_, TAlias(_, _)) => true,
  _ => match kind {
    RecordSchemeKind(_) => true,
    _ => false,
  },
}

// Every scope the judgment opens is a body's, so the link's own entries are
// the ones below the outermost open scope — the whole buffer when none is.
fn link_extent(scopes, count) = if len(scopes) == 0 { count } else { list_index(scopes, 0) }

fn any_declaration(_scheme, _kind) with Pure = true

// A type's TypeVariants declaration, reached past any same-named ctor shadow
// (the single-variant `type Instant = Instant(_)` shape).
fn env_entry_is_variants(ref _scheme, ref kind) with Pure = match kind {
  TypeVariants(_) => true,
  _ => false,
}

// ONE predicated walk serves every kind-filtered read: the predicate reads
// what each candidate's declaration published, and the predicate is a
// TOP-LEVEL fn passed as its static closure pointer, so the
// parameterization allocates nothing.
fn scope_pos_where(buf, bucket, name: String, count, pred) = if len(bucket) == 0 {
  -1
} else {
  match last(bucket) {
    (bn, pos) => if bn == name && pos < count && decl_holds(buf, pos, pred) {
      pos
    } else {
      scope_pos_where(buf, drop_last(bucket), name, count, pred)
    },
  }
}

fn decl_holds(buf, pos, pred) = match list_index(buf, pos) {
  (_, decl) => match graph_published(decl) {
    Some((scheme, _, kind)) => pred(scheme, kind),
    None => false,
  },
}

fn scope_find_where(buf, count, idx, name: String, pred) = {
  let pos = scope_pos_where(buf, list_index(idx, env_bucket_of(name)), name, count, pred)
  if pos < 0 {
    None
  } else {
    match list_index(buf, pos) {
      (_, decl) => Some(decl),
    }
  }
}

// The snapshot: each name's LATEST live binding, exactly what env_resolve
// answers, with what its declaration published — never the raw buffer,
// which holds a declaration once per publication. An entry survives iff its
// position IS its name's latest live position, answered by the same bucket
// probe every resolution makes, and no level above it (`shadows`, each a
// buffer with its count and index) holds the name. One forward walk over
// the FLAT buffer, keepers written flat (buffer-counter, sliced) so
// consumers keep index-cheap access.
fn scope_latest(buf, count, idx, shadows) =
  scope_latest_walk(buf, count, idx, shadows, make_list(count), 0, 0)

fn scope_latest_walk(buf, count, idx, shadows, own out, i, kept) = if i >= count {
  slice(out, 0, kept)
} else {
  match list_index(buf, i) {
    (name, decl) => {
      let live = scope_pos(buf, count, idx, name) == i && !any(shadow_holds(name, ??), shadows)
      match (live, graph_published(decl)) {
        (true, Some((scheme, reason, kind))) => scope_latest_walk(
          buf,
          count,
          idx,
          shadows,
          list_set(out, kept, (name, scheme, reason, kind, decl)),
          i + 1,
          kept + 1
        ),
        (false, _) | (true, None) => scope_latest_walk(buf, count, idx, shadows, out, i + 1, kept),
      }
    },
  }
}

fn shadow_holds(name: String, shadow) = match shadow {
  (sbuf, scount, sidx) => scope_pos(sbuf, scount, sidx, name) >= 0,
}

// The empty view the verb entries stand over.
fn env_root() = EnvView{below: None, buf: make_list(0), count: 0, index: env_index_new()}

// The declaration `name` resolves to through the views below an instance:
// the nearest view whose live entry of the name is one the predicate admits,
// or any live entry where no predicate is asked.
fn view_find(v: EnvView, name: String) = match scope_find(v.buf, v.count, v.index, name) {
  None => match v.below {
    None => None,
    Some(b) => view_find(b, name),
  },
  found => found,
}

fn view_find_where(v: EnvView, name: String, pred) = match scope_find_where(v.buf, v.count, v.index, name, pred) {
  None => match v.below {
    None => None,
    Some(b) => view_find_where(b, name, pred),
  },
  found => found,
}

// The live bindings of every view below an instance, the deepest first, each
// view's entries shadowed by the views above it.
fn view_latest(v: EnvView, shadows) = match v.below {
  None => scope_latest(v.buf, v.count, v.index, shadows),
  Some(b) => view_latest(b, push(shadows, (v.buf, v.count, v.index))) ++ scope_latest(v.buf, v.count, v.index, shadows),
}

// The buffer with one more entry at its end.
fn entries_appended(buf, count, name: String, decl) =
  list_set(list_extend_to(buf, count + 1), count, (name, decl))

// Config: THE VIEW BELOW (types.mn EnvView) — the empty one at the verb
// entries (`env_root`), and at a fork the view of the instance it stands
// over (`env_base_view`), so a resolve tries this instance's entries first
// and then each view below in turn, as a fork's graph reads through the
// versions below it, and an extend lands in this instance's buffer alone: a
// fork's publishes die with it unless a keep replays them.
handler env_handler(base: EnvView) with entries_buf = make_list(1024), entries_count = 0, scopes = [], index = env_index_new() {
  env_resolve(name) => resume(match scope_find(entries_buf, entries_count, index, name) {
    None => view_find(base, name),
    found => found,
  }),
  env_resolve_linked(name) => resume(match scope_find_where(entries_buf, link_extent(scopes, entries_count), index, name, any_declaration) {
    None => view_find_where(base, name, any_declaration),
    Some(d) => Some(d),
  }),
  env_resolve_type(name) => resume(match scope_find_where(entries_buf, entries_count, index, name, env_entry_is_type) {
    None => view_find_where(base, name, env_entry_is_type),
    found => found,
  }),
  env_resolve_variants(name) => resume(match scope_find_where(entries_buf, entries_count, index, name, env_entry_is_variants) {
    None => view_find_where(base, name, env_entry_is_variants),
    found => found,
  }),
  env_snapshot() => // Composition mirrors resolution order: an entry of a view below survives
  // unless a view above it holds its name; this instance's entries dedup
  // among themselves (the root stands over the empty view, so its snapshot
  // is one walk).
  resume(Env(view_latest(base, [(entries_buf, entries_count, index)]) ++ scope_latest(entries_buf, entries_count, index, []))),
  env_base_view() => // The view of this instance (BranchEnv): its entries, with the view it
  // stands over below them. Nothing is copied — the buffer is append-only
  // and the count freezes the extent — so a fork installed with it reads
  // what this instance resolves, and this instance writes nothing while the
  // fork runs.
  resume(EnvView{below: Some(base), buf: entries_buf, count: entries_count, index}),
  env_entries() => resume(slice(entries_buf, 0, entries_count)),
  env_extend(name, scheme, reason, kind, decl) => {
    graph_publish(decl, scheme, reason, kind)
    resume() with entries_buf = entries_appended(entries_buf, entries_count, name, decl), entries_count = entries_count + 1, index = env_index_add(index, name, entries_count)
  },
  env_adopt(name, decl) => // A kept fork's entry, adopted: what the declaration holds is in the
  // graph already, merged with the fork's columns, so only the binding of
  // the name to its declaration enters — and not where this instance's
  // newest entry for the name is that declaration already (a pre-registered
  // member a fork published again).
  if scope_find(entries_buf, entries_count, index, name) == Some(decl) {
    resume()
  } else {
    resume() with entries_buf = entries_appended(entries_buf, entries_count, name, decl), entries_count = entries_count + 1, index = env_index_add(index, name, entries_count)
  },
  env_retract(name, stmt) => resume() with index = env_index_retract(entries_buf, index, name, stmt),
  env_scope_enter() => resume() with scopes = push(scopes, entries_count),
  env_scope_exit() => if len(scopes) == 0 {
    resume()
  } else {
    let mark = last(scopes)
    env_index_unwind(entries_buf, index, entries_count, mark)
    resume() with entries_count = mark, scopes = drop_last(scopes)
  },
}

// A scope's exit pops the index pairs of every entry it extended, newest
// first, so the index holds the live bindings and nothing else.
fn env_index_unwind(buf, idx, i, mark) = if i <= mark {
  ()
} else {
  match list_index(buf, i - 1) {
    (name, _) => {
      env_index_pop(idx, name)
      env_index_unwind(buf, idx, i - 1, mark)
    },
  }
}

// The op's resume cardinality, PROJECTED off its EffectOpScheme — inference
// wrote it (draw_op_edges joined every handler arm's Usage grade), and this
// reads it live, at the declaration a reference's edge or a name's one
// resolution yields: an arm and a perform hand their edge, the compiler's
// own vocabulary its resolution. Its home is here, beside the entry it
// projects: lower's dispatch-tier selection and infer's own reads are two
// READERS of one projection, not two copies of one walk. An op with no
// scheme (never a real perform) floors to OneShot — the direct-return fast
// path, sound because a genuine multi-shot arm always carries a MultiShot
// scheme by the monotone join.
fn op_resume_discipline(od) = match published_at(od) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      EffectOpScheme(_, _, _, disc) => disc,
      _ => OneShot,
    },
  },
  None => OneShot,
}

// The op's declared argument TYPES — the SAME entry the discipline reads,
// one field over. A handler arm's parameters ARE the op's parameters (the
// effect declaration stated them; the arm binds them), so the arm's
// enumeration entry carries these as its param edges. Emit previously
// walked each arm's whole body hunting a use-site of each binder to
// recover exactly this. Not an op — or an op whose scheme is not a
// readable TFun — yields the empty vector, and the reader floors.
fn op_param_tys(od) = match published_at(od) {
  Some(entry) => match entry {
    (scheme, _, kind) => match kind {
      EffectOpScheme(_, _, _, _) => match scheme {
        // Read through the BINDING, not through judgment_ty: env.mn sits
        // BELOW infer by design (its module comment says so, and the alias
        // predicate above already destructures Frozen the same way), and an
        // op's signature is DECLARED at its effect — never a decl cell that
        // generalizes late — so the frozen form is the only one it has.
        Frozen(_, TFun(tparams, _, _)) => map(some_param_ty, tparams),
        _ => [],
      },
      _ => [],
    },
  },
  None => [],
}

// The op's DECLARED result — the value a resume hands back to the performer
// (R), read from the same binding as its parameters. A OneShot arm returns it
// to the performer directly, so its header signs this, never the handler's
// answer type. None where the op's scheme is not a readable TFun.
fn op_ret_ty(od) = match published_at(od) {
  Some(entry) => match entry {
    (scheme, _, kind) => match kind {
      EffectOpScheme(_, _, _, _) => match scheme {
        Frozen(_, TFun(_, ret, _)) => Some(ret),
        _ => None,
      },
      _ => None,
    },
  },
  None => None,
}
