// env.mn — the env substrate: the flat binding buffer, its O(1) index,
// and the handler that manages them (spec 04). Relocated from
// pipeline.mn (PLAN §11 Phase 3.5, the infer→pipeline handler seam):
// the install chain in infer names this handler, so the DECLARATION
// lives BELOW infer — the state's own module, imported by every
// installer. type Env + effect EnvRead/EnvWrite/BranchEnv still
// declare in types.mn, the op vocabulary's home; the handler lives
// with the state it manages.
import types

import strings

// env_handler — scoped binding stack (spec 04)
// Peer of graph_handler. One writer (inference). Scoping via
// mark-and-truncate: enter pushes len(entries); exit truncates to
// that mark. Functional; no mutable pointers.
//
// FLAT-BUFFER env (the graph handler's own substrate pattern: "flat
// buffer + length counter, not a linked list"). The snoc-chain form
// scanned via last/drop_last — a 16-byte slice mint PER STEP over
// 2,500+ entries, at EVERY name resolution, with top-level names
// (pre-registered first) always at full scan depth: the env was the
// infer phase's dominant allocator. Now: extend = one write + count
// bump (amortized-doubling growth); scope-exit resets count to mark, O(1),
// no truncation walk; lookup = a backward index-walk over the flat
// buffer, ZERO allocation. Shadowing is position, exactly as before.
//
// ── O(1) env resolution — the str_hash-bucket index (§5.O layer 2) ──────────
// A binding is an edge env_extend DREW; the index reads the edge in O(1): a
// 4096-bucket str_hash array over the flat buffer, each bucket a prepended
// list of (name, position). env_resolve returns the first LIVE
// (position < count) binding validated against the buffer — latest-wins,
// O(1) amortized. Carried-Truth: read the handle, never re-scan. (The
// linear-scan form this replaced was the §5.O convergent hot path; its
// fallback survived until 2026-07-24, when the profile showed the
// stale-bucket case was HOT, not rare — every scope re-entry reuses
// positions — and the validated walk made it unreachable.)
// CONDEMNED FAMILY (the resolved design D6): buffer, bucket index, and
// per-generation dedup are all downstream of the scheme being a
// name-keyed snapshot. When a name resolves ONCE at the scope walk to
// its decl's cell, nothing in the judgment is name-keyed and the
// family deletes; name-keyed reads survive only at human boundaries
// (query, REPL, diagnostics) as projections.
fn env_index_new() with Memory + Alloc = list_filled(4096, [])

fn env_index_add(idx, name: String, pos) with Memory + Alloc = {
  let b = i32_and(str_hash(name), 4095)
  list_set(idx, b, [(name, pos)] ++ list_index(idx, b))
}

// The first (name, pos) whose BUFFER entry still bears the name — the latest
// LIVE binding position, or -1. Prepended latest-first, so index 0 is the
// newest. Validation happens INSIDE the walk (the type/ctor siblings' shape):
// scope_exit reuses positions, so a bucket pair can go stale — the walk skips
// it and continues to an older live pair. Complete by construction: every
// env_extend adds its bucket pair and pairs are never removed, so no live
// binding lacks one — which is why no linear-scan fallback exists.
fn env_bucket_pos(ref buf, ref bucket, name: String, count, i, n) with Memory = if i >= n {
  -1
} else {
  match list_index(bucket, i) {
    (bn, pos) => if pos < count && bn == name {
      match list_index(buf, pos) {
        (en, _scheme, _reason, _kind) => if en == name { pos } else { env_bucket_pos(buf, bucket, name, count, i + 1, n) },
      }
    } else {
      env_bucket_pos(buf, bucket, name, count, i + 1, n)
    },
  }
}

fn env_resolve(ref buf, count, ref idx, name: String) with Memory + Alloc = {
  let b = i32_and(str_hash(name), 4095)
  let bucket = list_index(idx, b)
  let pos = env_bucket_pos(buf, bucket, name, count, 0, len(bucket))
  if pos < 0 {
    None
  } else {
    match list_index(buf, pos) {
      (_, scheme, reason, kind) => Some((scheme, reason, kind)),
    }
  }
}

// The TYPE-position read. One env, one namespace of entries; the KIND is the
// namespace discriminator (an effect decl and a type alias may share a name —
// `effect Sample` + `type Sample = Float where …` are both canonical). A type
// position (quantify_ctor_ty — every annotation surface) wants the newest
// TYPE-BEARING entry: an alias-schemed Frozen (the only transparent kind) or a
// nominal record's RecordSchemeKind. The plain lookup returns the newest entry
// of ANY kind, so a later-registered effect decl shadows the alias and the
// annotation bakes a bare nominal TName that never unifies with its base.
fn env_entry_is_type(ref scheme, ref kind) with Pure = match scheme {
  Frozen(_, TAlias(_, _)) => true,
  _ => match kind {
    RecordSchemeKind(_) => true,
    _ => false,
  },
}

// ONE predicated walk serves every kind-filtered read (type / ctor /
// variants — the fourth copy was the eight-interrogations' catch): the
// predicate is a TOP-LEVEL fn passed as its static closure pointer, so
// the parameterization allocates nothing. The PLAIN resolve keeps its
// own predicate-free walk — it is the compiler's hottest path and its
// shape genuinely differs (no filter slot at all).
fn env_bucket_pos_where(ref buf, ref bucket, name: String, count, i, n, pred) with Memory + Alloc = if i >= n {
  -1
} else {
  match list_index(bucket, i) {
    (bn, pos) => if pos < count && bn == name {
      match list_index(buf, pos) {
        (en, scheme, _, kind) => if en == name && pred(scheme, kind) {
          pos
        } else {
          env_bucket_pos_where(buf, bucket, name, count, i + 1, n, pred)
        },
      }
    } else {
      env_bucket_pos_where(buf, bucket, name, count, i + 1, n, pred)
    },
  }
}

fn env_resolve_where(ref buf, count, ref idx, name: String, pred) with Memory + Alloc = {
  let b = i32_and(str_hash(name), 4095)
  let bucket = list_index(idx, b)
  let pos = env_bucket_pos_where(buf, bucket, name, count, 0, len(bucket), pred)
  if pos < 0 {
    None
  } else {
    match list_index(buf, pos) {
      (_, scheme, reason, kind) => Some((scheme, reason, kind)),
    }
  }
}

fn env_resolve_type(ref buf, count, ref idx, name: String) with Memory + Alloc =
  env_resolve_where(buf, count, idx, name, env_entry_is_type)

// The CTOR-position read — env_resolve_type's sibling at the third kind
// resolved by name: the newest live ConstructorScheme entry. The pattern
// path reads a constructor's payload types at every LPCon bind; the
// snapshot scan this index read replaces walked the whole env backward per
// read (6.86% of the self-compile, perf 2026-07-24) — the edge the index
// already draws, followed instead of re-derived.
fn env_entry_is_ctor(ref _scheme, ref kind) with Pure = match kind {
  ConstructorScheme(_, _) => true,
  _ => false,
}

fn env_resolve_ctor(ref buf, count, ref idx, name: String) with Memory + Alloc =
  env_resolve_where(buf, count, idx, name, env_entry_is_ctor)

// A type's TypeVariants entry, reached past any same-named ctor shadow
// (the single-variant `type Instant = Instant(_)` shape).
fn env_entry_is_variants(ref _scheme, ref kind) with Pure = match kind {
  TypeVariants(_) => true,
  _ => false,
}

fn env_resolve_variants(ref buf, count, ref idx, name: String) with Memory + Alloc =
  env_resolve_where(buf, count, idx, name, env_entry_is_variants)

// The snapshot's dedup — resolution semantics as a list, read from the
// EDGE THE INDEX ALREADY DRAWS (Carried-Truth at the snapshot): an
// entry survives iff its position IS its name's latest live position,
// answered by the same O(1) bucket probe every lookup makes. One
// forward walk over the FLAT buffer, keepers written flat
// (buffer-counter, sliced) so consumers keep index-cheap access. The
// first form here was a seen-list scan over the raw buffer returning
// a cons spine — three snapshot calls per self-compile (the gate's two
// + the redrive census) cost ~20 minutes at wheel scale (O(n²) string
// probes over the round-multiplied entries) and every consumer's
// list_index went O(depth); the march stayed CLEAN through it, so the
// slowness was the only defect — this is the same fix at the same law
// as env_resolve's own bucket walk.
fn env_dedup_latest(ref buf, count, ref idx, shadow_buf, shadow_count, shadow_idx) with Memory + Alloc =
  env_dedup_walk(buf, count, idx, shadow_buf, shadow_count, shadow_idx, make_list(count), 0, 0)

fn env_dedup_walk(ref buf, count, ref idx, ref sbuf, scount, ref sidx, own out, i, kept) with Memory + Alloc = if i >= count {
  slice(out, 0, kept)
} else {
  match list_index(buf, i) {
    (name, scheme, reason, kind) => {
      let b = i32_and(str_hash(name), 4095)
      let latest = env_bucket_pos(buf, list_index(idx, b), name, count, 0, len(list_index(idx, b)))
      // Survive iff this IS the name's latest position here AND no
      // shadowing level holds the name (the branch's private entries
      // shadow the base; the root passes the empty shadow).
      let shadowed = if scount > 0 {
        env_bucket_pos(sbuf, list_index(sidx, b), name, scount, 0, len(list_index(sidx, b))) >= 0
      } else {
        false
      }
      if latest == i && !shadowed {
        env_dedup_walk(
          buf,
          count,
          idx,
          sbuf,
          scount,
          sidx,
          list_set(out, kept, (name, scheme, reason, kind)),
          i + 1,
          kept + 1
        )
      } else {
        env_dedup_walk(buf, count, idx, sbuf, scount, sidx, out, i + 1, kept)
      }
    },
  }
}

// Config: a BRANCH CURSOR (the parallel fan's per-thread instance) installs
// over the root's SHARED entries as a read-only BASE — its own extends land
// in a fresh private buffer that dies at the join (publishes re-apply
// through the root, in stmt order). The root installs pass the empty base,
// so every resolve is one level exactly as before; a branch resolve tries
// its private level first, then the base.
handler env_handler(base_buf, base_count, base_index) with entries_buf = make_list(1024), entries_count = 0, scopes = [], index = env_index_new() {
  env_lookup(name) => resume(match env_resolve(entries_buf, entries_count, index, name) {
    None => env_resolve(base_buf, base_count, base_index, name),
    found => found,
  }),
  env_lookup_type(name) => resume(match env_resolve_type(entries_buf, entries_count, index, name) {
    None => env_resolve_type(base_buf, base_count, base_index, name),
    found => found,
  }),
  env_lookup_ctor(name) => resume(match env_resolve_ctor(entries_buf, entries_count, index, name) {
    None => env_resolve_ctor(base_buf, base_count, base_index, name),
    found => found,
  }),
  env_lookup_variants(name) => resume(match env_resolve_variants(entries_buf, entries_count, index, name) {
    None => env_resolve_variants(base_buf, base_count, base_index, name),
    found => found,
  }),
  env_snapshot() => // Snapshots project the RESOLUTION SEMANTICS — each name's LATEST
  // live entry, exactly what env_lookup answers — never the raw
  // append-only buffer. The converged judge re-registers every decl
  // per pass (the trial and the final), so the raw buffer holds one
  // entry PER GENERATION per name: the ??-fan's vocabulary walked it
  // and proposed the same fn three times (the sole-pure-survivor and
  // two-survivor-tie legs both red, and the accept path refused the
  // "tie" its own duplicates minted). A snapshot that aliased the
  // mutable buffer would be the stale-read lie; the dedup walk copies.
  // Composition mirrors resolution order: base entries survive unless
  // the private level shadows their name; private entries dedup among
  // themselves (the root passes the empty base, so its snapshot is one
  // walk).
  resume(Env(env_dedup_latest(base_buf, base_count, base_index, entries_buf, entries_count, index) ++ env_dedup_latest(entries_buf, entries_count, index, make_list(0), 0, env_index_new()))),
  env_base_view() => // The branch join surface (BranchEnv), answering by instance position:
  // the ROOT instance's view is the layer-start base capture (the buffer
  // is append-only and the count freezes the extent, so the triple is a
  // true snapshot without a copy); a BRANCH instance's publishes are its
  // private entries in occurrence order — the log the join replays
  // through the root's env_extend, Reasons riding whole.
  resume((entries_buf, entries_count, index)),
  env_publishes() => resume(list_to_flat(slice(entries_buf, 0, entries_count))),
  env_extend(name, scheme, reason, kind) => {
    let grown = if entries_count >= len(entries_buf) {
      list_copy_into(entries_buf, make_list(len(entries_buf) * 2), 0, entries_count)
    } else {
      entries_buf
    }
    resume() with entries_buf = list_set(grown, entries_count, (name, scheme, reason, kind)), entries_count = entries_count + 1, index = env_index_add(index, name, entries_count)
  },
  env_scope_enter() => // drift-audit: ignore — O(1) mark push, one per scope enter, popped by scope exit
  resume() with scopes = scopes ++ [entries_count],
  env_scope_exit() => if len(scopes) == 0 {
    resume()
  } else {
    let mark = last(scopes)
    resume() with entries_count = mark, scopes = drop_last(scopes)
  },
}

// The op's resume cardinality, PROJECTED off its EffectOpScheme — inference
// wrote it (draw_op_edges joined every handler arm's Usage grade), and this
// reads it live. Its home is here, beside the entry it projects: lower's
// dispatch-tier selection and infer's own reads are two READERS of one
// projection, not two copies of one walk. An op with no scheme (never a real
// perform) floors to OneShot — the direct-return fast path, sound because a
// genuine multi-shot arm always carries a MultiShot scheme by the monotone
// join.
fn op_resume_discipline(op_name) = match env_lookup(op_name) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      EffectOpScheme(_, _, _, disc) => disc,
      _ => OneShot,
    },
  },
  None => OneShot,
}

// The op's declared argument TYPES — the SAME entry the discipline reads,
// one field over. A handler arm's parameters ARE the op's parameters (the
// effect declaration stated them; the arm binds them), so the arm's
// enumeration entry carries these as its param edges. Emit previously
// walked each arm's whole body hunting a use-site of each binder to
// recover exactly this. Not an op — or an op whose scheme is not a
// readable TFun — yields the empty vector, and the reader floors.
fn op_param_tys(op_name) = match env_lookup(op_name) {
  Some(entry) => match entry {
    (scheme, _, kind) => match kind {
      EffectOpScheme(_, _, _, _) => match scheme {
        // Read through the BINDING, not through judgment_ty: env.mn sits
        // BELOW infer by design (its module comment says so, and the alias
        // predicate above already destructures Frozen the same way), and an
        // op's signature is DECLARED at its effect — never a decl cell that
        // generalizes late — so the frozen form is the only one it has.
        Frozen(_, TFun(tparams, _, _)) => map(some_param_ty, tparams),
        _ => [],
      },
      _ => [],
    },
  },
  None => [],
}
