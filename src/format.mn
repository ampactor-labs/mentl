// format.mn — canonical-render handler · the medium handles formatting
//
// The substrate-honest answer to "what about indent / tabs / 2-space-
// vs-4-space?": the formatter renders the cursor's projection back to
// disk in canonical form. The developer types meaning; the editor
// renders properly; the file on disk is canonical regardless of what
// the developer typed. Same source, same bytes, every save.
//
// Layout is projection, never contract (chain-link-5): the parser
// tolerates any structurally-
// valid indent (relative ordering of verb-vs-operand suffices); the
// formatter normalizes column counts. Indent is a render decision, not
// a parse contract — the same chain-link-5 realization at the layout
// layer that earlier closed `with EXPR` parsing and the seed's
// ident-fabrication.
//
// The formatter IS a `~>` handler on the cursor — same kernel primitive
// as every other tentacle. Composes:
//
//   keystroke
//     |> tokenize
//     |> parse_to_graph
//     ~> format_default        // canonical render before display
//     ~> render_to_transport   // terminal / LSP frame / web
//       <~ accumulate(graph)   // IC re-renders on next keystroke
//
// Five verbs realized inside the formatter itself: each rendering
// pipeline composes |> sequentially, ~> attaches per-form handlers,
// <| fans out per-form rendering, >< parallelizes independent
// sub-renders, <~ closes on stability (canonical form is a fixpoint —
// running format twice IS the same as running once).
//
// SYNTAX.md §1185 governs the canonical layout. Authority:
// - SYNTAX.md §342-389 (per-verb layout rules)
// - SYNTAX.md §1142-1186 (layout enforcement)
// - PLAN §2 (the cursor as the gradient's argmax)
// - CLAUDE.md Anchor 2 (parse structurally; never a form-special-case)
import types

import effects

import graph

import parser

import strings

// ─── The Format effect ──────────────────────────────────────────────
//
// Three ops:
//   format_program — render the whole AST as canonical String
//   format_at_handle — render one node + canonical-spaced surroundings
//   format_chain — render a single |> / ~> / <| / >< / <~ chain
//
// Resume cardinality is INFERRED from arm body structure per Phase B
// substrate (CLAUDE.md ⌁ Mentl's anchor — interrogation #2).
// format_default arms call resume exactly once → OneShot.
effect Format {
  format_program([Node]) -> String
  format_at_handle(Int) -> String
  format_chain(Node) -> String
}

// ─── format_default — canonical render handler ──────────────────────
//
// `with !Mutate` — read-only over graph + AST; same constraint as
// cursor_default + interrogate_default per the read-only-projection
// discipline.
//
// Each arm composes the five verbs in its own rendering logic:
//   <|  per-node-kind branches (each NodeBody variant gets its own
//       render branch; the eight aspects of the cursor's projection
//       fan out into eight render-aspect branches)
//   ><  parallel sub-render (independent siblings render concurrently)
//   |>  sequential through tokenize → indent → emit
//   ~>  buffer handler attaches output sink
//   <~  fixpoint check (running format twice = running once)
//
// Drift refused: 1 (no dispatch table; render IS graph projection); 6
// (no primitive special-case — each NodeBody variant is one branch
// of the same fanout); 7 (one record per RenderResult, not parallel-
// arrays); 9 (every NodeBody variant bodied; no "later").
handler format_default {
  format_program(ast) => resume(render_program(ast)),
  format_at_handle(handle) => resume(render_node_at(handle)),
  format_chain(chain_node) => resume(render_chain_node(chain_node)),
}

// ─── THE THREE IMPLEMENTATIONS, as plain fns ────────────────────────
//
// AN ARM MAY NOT PERFORM ITS OWN HANDLER'S OPS. A deep handler is not
// installed for its own arms — the arm body runs in the world OUTSIDE the
// install, which is what `tests/frontier/mn-deep-handler-arm.mn` pins at 51
// — so an op performed from inside an arm walks PAST its own handler. With
// `format_default` the only Format install, that walk reached the chain's
// end and refused: `mentl fmt` trapped on real input, having compiled with
// zero diagnostics. It read `ev_declaring_node <- format_one_stmt <-
// op_format_default_format_program`.
//
// It was authored against a missing bracket. The lexical dispatch tier used
// to emit a bare direct call with NO world bracket, so a perform inside an
// arm resolved to the arm's own handler and this shape worked. Making the
// bracket uniform made the law true everywhere and left these behind.
//
// The form is a DELETION, not a mechanism: an arm that needs a sibling op
// already holds that op's implementation, so performing it re-derives
// something in scope — Carried-Truth at the handler boundary. The op is the
// INTERFACE, for callers outside; the fn is the implementation, for the arms
// and for every helper the arms call. Rows stay inferred (Intent Boundaries
// only), and the arms become one line each.
fn render_program(ast) = {
  let stmts = ast_top_level_stmts(ast)
  let rendered = stmts |> map(format_one_stmt)
  join_lines(rendered)
}

// ─── render_node_at — render one node ─────────────────────────────
//
// A node's text is its prose, its indent, its tokens and its line break, read
// in that order. This was a seven-branch fanout of which the assembly read
// four: the span branch was a constant, the reason branch walked the node's
// Why and threw it away, and the sibling branch read a "render context" that
// SCANNED EVERY HANDLE IN THE GRAPH for a parent of this node — once per
// top-level statement of every file `mentl fmt` touched — to answer a context
// the indent never read and the separator mapped to "" in every case
// (measured 2026-10-02, the third whole-graph parent scan the E4 caret audit
// found; the cursor's and the eight-loop's read the declaration's path now).
fn render_node_at(handle) with !Mutate = {
  let body = graph_node_body(handle)
  render_comment_at(handle) ++ render_indent_for(body) ++ render_body_tokens(body) ++ render_line_break_after(body)
}

// ─── render_chain_node — render one verb-chain ────────────────────
//
// Distinguishes the five verb-classes; each gets canonical layout
// per SYNTAX.md §342-389. `<|` opens-tuple-on-same-line with branches
// indented. `><` alone-on-line at indented center between paren-
// pipelines. `<~` indented center, optionally inline. `|>` and `~>`
// at left edge with stages on indented lines.
fn render_chain_node(chain_node) = {
  let kind = ast_kind_of(chain_node)
  // ast_kind_of projects the NodeBody altitude — the Expr sits one
  // constructor in (NExpr(PipeExpr(..))); the bare-Expr arms never
  // matched and every chain fell to the non-chain render (order-masked;
  // the order-independent judge named it, 2026-07-25).
  let rendered = match kind {
    NExpr(PipeExpr(PForward, l, r)) => // |>
    // `<|`/`><` are ONE PFanout; the formatter projects the glyph from
    // the ownership aspect — FanShare → `<|`, FanDistribute → `><` (the
    // surface keeps both authored glyphs as intent).
    render_converge_chain(l, r),
    NExpr(PipeExpr(PFanout(FanShare), l, r)) => // <|
    render_diverge_chain(l, r),
    NExpr(FanoutExpr(branches)) => // >< — the N-ary carrier
    render_compose_chain(branches),
    NExpr(PipeExpr(PTee, l, r)) => // ~>
    render_tee(l, r),
    NExpr(PipeExpr(PFeedback, l, r)) => // <~
    render_feedback_chain(l, r),
    _ => render_non_chain(chain_node),
  }
  rendered
}

// ─── Canonical layout constants (SYNTAX.md §1185) ───────────────────
//
// 2-space indent for left-edge verbs (|>, ~>, <|).
// 4-space indent for indented-center convergent verbs (><, <~).
// Tabs convert to spaces at format time.
fn left_edge_indent() with Pure = 2

fn indented_center() with Pure = 4

// The fanout kind as a top-level value: the N-ary carrier has no verb
// VALUE in its match (the kind is the census/glyph key, not a field),
// so arms that need its precedence or glyph read this one binding —
// constructed once, never per render call (the row stays alloc-free).
let fanout_distribute_kind = PFanout(FanDistribute)

// ─── Render a |> chain — sequential left-edge ───────────────────────
//
// canonical layout per SYNTAX.md §342-346:
//
//   input
//     |> stage_a
//     |> stage_b
//
// Input on its own line at base indent; |> at base + 2; stages on
// the same line as their |>. The chain reads top-to-bottom = data flow.
//
// A chain-position operand below every operator's precedence (the lambda,
// prec 0 — its body extends maximally rightward) re-wraps, or the re-parse
// absorbs the verb into the body (the recurrence `((prev) => …) <~ delay(1)`
// rendered bare read back as `delay(1)(prev)` — an application). One read
// of the ONE table, shared by every chain renderer's head.
fn render_chain_pos(node) =
  if expr_prec_of(node) < 1 { parenthesize(render_chain_node(node)) } else { render_chain_node(node) }

fn render_converge_chain(left, right) = {
  let left_str = render_chain_pos(left)
  let right_str = render_chain_pos(right)
  "{left_str}\n{spaces(left_edge_indent())}|> {right_str}"
}

fn render_diverge_chain(input, branches_tuple) = {
  let input_str = render_chain_node(input)
  // The right operand is the branch-tuple NODE; render_branch_tuple eats
  // the element LIST (the converged judge caught the node passed whole).
  // A non-tuple right operand is a single branch, rendered as one chain.
  match branches_tuple {
    N(bkind, _, _) => {
      let branches = match bkind {
        NExpr(MakeTupleExpr(elems)) => render_branch_tuple(elems),
        _ => "{spaces(indented_center())}{render_chain_node(branches_tuple)},",
      }
      "{input_str}\n{spaces(left_edge_indent())}<| (\n{branches}\n{spaces(left_edge_indent())})"
    },
  }
}

// ─── Render a >< fanout — parallel composition, N-ary ───────────────
//
// Canonical per SYNTAX.md §><:
//
//   (pipeline_a)
//       ><
//   (pipeline_b)
//       ><
//   (pipeline_c)
//
// Each branch parenthesized at base indent; >< alone on its line at
// indented center (4-space) between consecutive branches. The carrier
// is FanoutExpr's branch LIST (the N-ary law) — the render walks it.
fn render_compose_chain(branches) = match branches {
  [] => "",
  [one] => parenthesize(render_chain_node(one)),
  [h, ...t] => "{parenthesize(render_chain_node(h))}\n{spaces(indented_center())}><\n{render_compose_chain(t)}",
}

// A named row renders as its authored signed triples: the first term
// bare, each subsequent led by its connective glyph, negation as `!` —
// the with-clause's own grammar, round-trippable by construction.
fn render_row_triples(effs, i) = if i >= len(effs) {
  ""
} else {
  match list_index(effs, i) {
    (name, negated, conn) => {
      let bang = if negated { "!" } else { "" }
      let glyph = match conn {
        EcUnion => "+",
        EcDiff => "-",
        EcInter => "&",
      }
      let lead = if i == 0 { "" } else { " {glyph} " }
      "{lead}{bang}{show_eff_name(name)}{render_row_triples(effs, i + 1)}"
    },
  }
}

fn render_fanout_inline(branches) = match branches {
  [] => "",
  [one] => render_operand(one, pipe_prec(fanout_distribute_kind), false),
  [h, ...t] => "{render_operand(h, pipe_prec(fanout_distribute_kind), false)} >< {render_fanout_inline(t)}",
}

// ─── Render a ~> chain — handler-attach ────────────────────────────
//
// One PTee node; layout is the formatter's projection of the LHS
// shape (layout is never semantics — SYNTAX.md §~>). A chain body
// earns the block layout, ~> on its own line at left-edge indent:
//
//   source
//     |> lex
//     |> parse
//     ~> env_handler          // governs the whole prior chain
//     ~> diagnostics_handler  // outermost — sandbox boundary
//
// A single-stage body renders inline — same tree, same scope:
//
//   (try_fn()) ~> catch_abort
fn render_tee(body, handler_expr) = {
  let body_str = render_chain_pos(body)
  let handler_str = render_chain_pos(handler_expr)
  let hc = graph_comment_at(node_handle(handler_expr))
  match ast_kind_of(body) {
    NExpr(PipeExpr(_, _, _)) => "{body_str}\n{spaces(left_edge_indent())}~> {handler_str}",
    _ => if hc == "" {
      "{body_str} ~> {handler_str}"
    } else {
      "{body_str}\n{spaces(left_edge_indent())}~> {handler_str}"
    },
  }
}

// ─── Render a <~ chain — feedback / iterative ──────────────────────
//
// Canonical per SYNTAX.md §483-489:
//
//   signal
//       <~ delay(3)
//
// <~ at indented center (4-space) with the FeedbackSpec on the same
// line. Requires iterative context (Sample / Tick / Clock / IC handler
// installed upstream); without it, parser rejects with E_FeedbackNoContext.
fn render_feedback_chain(input, spec) = {
  let input_str = render_chain_pos(input)
  let spec_str = render_chain_pos(spec)
  "{input_str}\n{spaces(indented_center())}<~ {spec_str}"
}

// ─── Multi-source format — map over an AST list ─────────────────────
//
// The DELETED format_pair (binary special-case) was erased per
// CLAUDE.md Anchor 6: callers compose
// `map(format_program, asts)` directly. `format_program` itself
// already maps over top-level statements (line 93); the same stage
// composes at the multi-source level. Drift 6 erasure.
//
// THE FOURTH UNCALLED `<~ accumulate` IC FIXPOINT WAS HERE, and the family
// is the finding rather than this one member. format_ic_loop, teach_ic_loop
// (src/mentl.mn), oracle_ic_fixpoint (src/oracle.mn) and ic_compile_loop
// (src/pipeline.mn) were four decls, in four modules, each a one-line
// statement that "build IS the `<~` loop closing", and NONE of them had a
// caller — the IC effect they all declared a row against had no live
// performer and no install anywhere. Four prose claims about the medium's
// own shape, none of them a mechanism. They are deleted with the effect,
// whose name goes unbackticked here because it no longer resolves.
//
// THE PROPERTY THEY DESCRIBED IS REAL AND IS BUILT — just not here: `fmt`
// writes its own fixpoint in one invocation by rendering, re-parsing and
// writing the SECOND render (`fmt_run`, src/main.mn), which is the idempotence
// this loop only asserted. A verb whose output feeds its own reader carries
// the loop internally; it does not need a `<~` wrapper nobody calls.
//
// ─── Helper functions — transforms over String (each builds its answer) ──
fn spaces(n) = if n == 0 { "" } else { " {spaces(n - 1)}" }

fn parenthesize(s: String) = "({s})"

// Head-first join: parser lists are source-ordered (built `[x] ++ rest`),
// so iteration walks index 0 upward — the last/drop_last form rendered
// every list REVERSED, unseen because this module had zero callers.
fn join_lines(lines) = join_lines_from(lines, 0)

fn join_lines_from(ref lines, i) = if i >= len(lines) {
  ""
} else if i == len(lines) - 1 {
  lines[i]
} else {
  "{lines[i]}\n{join_lines_from(lines, i + 1)}"
}

// ─── Render-aspect helpers — one per cursor-projection lens ────────
//
// render_tokens_for IS the parser's inverse: a per-NodeBody projection that
// emits the canonical token text the parser would re-consume to the SAME graph
// (format∘parse = identity). Each AST variant reads its child nodes live and
// renders them recursively — the formatter shares the surface SYNTAX.md binds,
// so the bytes round-trip. No "node@42" placeholder.
// THE UNIFORM EMIT — the one place every node's attached prose renders:
// it prefixes the node's own tokens as leading `//` lines. Attachment is
// uniform (the weave pass), so emission must be too; the per-construct
// emission calls this replaced covered only the statement-shaped sites
// and lost every expression-position attach at render. A mid-line
// node's prose forces its line to break, which the fits-or-breaks rule
// cascades outward — and the verb's internal re-render makes the
// written file the fixpoint of any resulting movement.
fn render_tokens_for(node) with !Mutate = match node {
  N(body, _, h) => {
    let c = graph_comment_at(h)
    if c == "" {
      render_body_tokens(body)
    } else {
      "//{replace(c, "\n", "\n//")}\n{render_body_tokens(body)}"
    }
  },
}

fn render_body_tokens(body) with !Mutate = match body {
  NExpr(e) => render_expr_tokens(e),
  NStmt(s) => render_stmt_tokens(s),
  NPat(p) => render_pat_tokens(p),
  NHole(_) => "??",
  NModule(m) => "// module {m.path}",
  NTypeAnn(ty) => render_type_tokens(ty),
}

fn render_expr_tokens(e) with !Mutate = match e {
  LitInt(n) => // int_to_str(INT_MIN) prints its own minus, which re-parses as a unary
  // minus over the WRAPPING positive literal and accretes one `-` per fmt
  // pass. The wrapping spelling IS the authored surface (the lexer wraps
  // 2147483648 back to INT_MIN) — value-identical, idempotent. Every
  // other negative is stable: `-5` re-parses UNeg(5) and re-renders `-5`.
  if n == 0 - 2147483648 { "2147483648" } else { int_to_str(n) },
  LitFloat(f) => float_to_str(f),
  LitString(s) => "\"{str_escape(s)}\"",
  LitBool(b) => if b { "true" } else { "false" },
  LitUnit => "()",
  VarRef(name) => name,
  BinOpExpr(op, l, r) => {
    let rc = graph_comment_at(node_handle(r))
    if rc == "" {
      "{render_operand(l, binop_prec(op), false)} {binop_to_str(op)} {render_operand(r, binop_prec(op), true)}"
    } else {
      "{render_operand(l, binop_prec(op), false)} {binop_to_str(op)}\n{render_operand(r, binop_prec(op), true)}"
    }
  },
  UnaryOpExpr(op, x) => "{unary_op_glyph(op)}{render_operand(x, 90, true)}",
  CallExpr(callee, args) => {
    let inline = "{render_postfix_head(callee)}({render_node_list(args, ", ")})"
    if (fits_inline(inline) || len(args) < 2) && !args_carry_prose(args, 0) {
      inline
    } else {
      "{render_postfix_head(callee)}(\n{indent_block(render_arg_lines(args, 0))}\n)"
    }
  },
  LabeledArg(label, v) => "{label} = {render_tokens_for(v)}",
  FieldExpr(recv, field) => "{render_postfix_head(recv)}.{field}",
  IndexExpr(recv, idx) => "{render_postfix_head(recv)}[{render_tokens_for(idx)}]",
  PipeExpr(verb, l, r) => {
    let rc = graph_comment_at(node_handle(r))
    if rc == "" {
      "{render_operand(l, pipe_prec(verb), false)} {show_pipe_kind(verb)} {render_operand(r, pipe_prec(verb), true)}"
    } else {
      "{render_operand(l, pipe_prec(verb), false)} {show_pipe_kind(verb)}\n{render_operand(r, pipe_prec(verb), true)}"
    }
  },
  FanoutExpr(branches) => // >< inline: each branch an operand at the fanout's prec
  render_fanout_inline(branches),
  RestExpr(nm) => "...{nm}",
  IfExpr(c, t, el) => {
    let inline = "if {render_tokens_for(c)} {render_if_branch(t)}{render_else(el)}"
    if fits_inline(inline) {
      inline
    } else {
      "if {render_tokens_for(c)} {render_branch_block(t)}{render_else_block(el)}"
    }
  },
  MakeListExpr(elems) => // An element carrying prose forces the VERTICAL layout (the CallExpr
  // args law at the tuple/list altitude): an inline pack embeds the
  // prose's newlines mid-expression, and the next parse re-homes the
  // comment to whatever now starts the following line — the layout
  // migration that broke fmt idempotence on the fan's labeled branches
  // (measured: the eight-interrogation branch tuple's labels walked one
  // arm per pass).
  if args_carry_prose(elems, 0) {
    "[\n{indent_block(render_arg_lines(elems, 0))}\n]"
  } else {
    "[{render_node_list(elems, ", ")}]"
  },
  MakeTupleExpr(elems) => if args_carry_prose(elems, 0) {
    "(\n{indent_block(render_arg_lines(elems, 0))}\n)"
  } else {
    "({render_node_list(elems, ", ")})"
  },
  ExprPlaceholder => "??",
  BlockExpr(stmts, final) => // The final expr's attached prose renders exactly as a statement's does
  // — the weave attaches a before-final interior comment (and the
  // block-tail comment, whose home is the final's own handle when nothing
  // follows) to the final, and dropping it violated "never dropped" (the
  // fmt census's blocker 5: a third of parser.mn's prose was
  // body-interior).
  "\{\n{indent_block("{render_block_stmts(stmts, 0)}{render_grouped_body(final)}")}\n\}",
  LambdaExpr(params, body) => match arm_list_of(params, body) {
    Some(arms) => render_arm_literal(arms),
    None => match resugar_head(params, body) {
      Some(pair) => match pair {
        (plist, inner) => "({plist}) => {render_grouped_body(inner)}",
      },
      None => "({render_param_list(params)}) => {render_grouped_body(body)}",
    },
  },
  MakeRecordExpr(fields) => render_record(fields, ""),
  NamedRecordExpr(tname, fields) => "{tname}{render_record(fields, "")}",
  RecordUpdateExpr(base, fields) => render_record(fields, "...{render_tokens_for(base)}"),
  MakeStringExpr(parts) => // Interpolation is the parse's inverse: literal chunks re-escape,
  // every other fragment renders as a live splice.
  "\"{render_string_parts(parts, 0)}\"",
  ShowExpr(inner) => // Outside a string context the wrap is invisible surface — the
  // inner renders bare (parser-minted only inside fragments).
  render_tokens_for(inner),
  MatchExpr(scrut, arms) => "match {render_tokens_for(scrut)} \{\n{indent_block(strip_trailing_nl(render_match_arms(arms, 0)))}\n\}",
  ResumeExpr(v, updates) => "{render_resume_head(v)}{render_state_updates(updates, 0)}",
}

fn render_stmt_tokens(s) with !Mutate = match s {
  FnStmt(name, params, retty, effs, body) => match module_arm_list(params, body) {
    Some(arms) => // A module-scope `let name = { arms }` is born a declaration whose one
    // parameter the literal minted (parser.mn `let_at_scope`), so it renders
    // as the literal it was written as: the fresh name never reaches the page.
    "let {name} = {render_arm_literal(arms)}",
    None => render_fn_decl(name, params, retty, effs, body),
  },
  ImportStmt(path) => "import {path}",
  ExprStmt(e) => // A unit expression statement is the file-tail prose CARRIER (and a
  // bare `()` statement is dead weight either way): its comment renders,
  // its tokens do not.
  match ast_kind_of(e) {
    NExpr(LitUnit) => "",
    _ => render_grouped_body(e),
  },
  AliasStmt(name, ty) => "type {name} = {render_decl_type(ty)}",
  RowAliasStmt(name, effs) => "type {name} = {render_row_triples(effs, 0)}",
  LetStmt(pat, value, ann) => {
    let lhead = "let {render_pat_tokens(pat)}{render_let_ann(ann)} ="
    let lv = render_tokens_for(value)
    if str_contains(lv, "\n") || fits_inline("{lhead} {lv}") {
      "{lhead} {lv}"
    } else {
      "{lhead}\n{indent_block(lv)}"
    }
  },
  TypeDefStmt(name, variants) => "type {name}{render_variants(variants, 0)}",
  EffectDeclStmt(name, params, ops) => // An op's params carry the author's names (a bare type is the wildcard
  // `_`), so the render is the parse's inverse over both spellings. The
  // instance params render through the same product projection the
  // handler head uses (format∘parse identity over SYNTAX §«Parameterized
  // effect»).
  "effect {name}{render_config_params(params)} \{\n{indent_block(strip_trailing_nl(render_effect_ops(ops, 0)))}\n\}",
  HandlerDeclStmt(hname, _ename, config, states, arms, effs) => "handler {hname}{render_config_params(config)}{render_handler_clause(effs, states)} \{\n{indent_block(strip_trailing_nl(render_handler_arms(arms, 0)))}\n\}",
  RefineStmt(name, ty, pred) => "type {name} = {render_decl_type(ty)} where {render_predicate_tokens(pred)}",
}

// A representation pin at a type declaration's right-hand side renders
// with its suffix (`Float repr f64`, SYNTAX's representation-pinned alias)
// and anywhere else as its bare width (`s: f64`). Both spellings parse to
// one pin, so the position decides the spelling and neither page loses a
// word: until 2026-09-28 a canonical pair rendered bare everywhere, and a
// declaration written as SYNTAX writes it came back as `type Coeff = f64`.
fn render_decl_type(ty) with !Mutate = match ty {
  TReprPin(r, base) => "{render_type_tokens(base)} repr {repr_wat(r)}",
  t => render_type_tokens(t),
}

fn render_pat_tokens(p) = match p {
  PVar(name) => name,
  PWild => "_",
  PCon(name, ps) => if len(ps) == 0 { name } else { "{name}({render_pat_list(ps, ", ")})" },
  PLit(lv) => render_lit_value(lv),
  PTuple(ps) => "({render_pat_list(ps, ", ")})",
  PList(ps, rest) => "[{render_plist_inner(ps, rest)}]",
  PRecord(fields, rest) => match rest {
    None => "\{{render_pat_fields(fields, 0)}\}",
    Some(rn) => if len(fields) == 0 { "\{...{rn}\}" } else { "\{{render_pat_fields(fields, 0)}, ...{rn}\}" },
  },
  PAlt(ps) => render_pat_list(ps, " | "),
  PAs(name, inner) => "{name} @ {render_pat_tokens(inner)}",
}

// Every list renderer walks HEAD-FIRST (index 0 upward): parser lists are
// source-ordered, so the old last/drop_last walks rendered them reversed —
// unseen while this module had zero callers.
// The broken-call form: one argument per line, each argument's attached
// prose above its line (a prose-carrying argument FORCES this form —
// the inline join has nowhere to put a comment).
fn args_carry_prose(ref args, i) = if i >= len(args) {
  false
} else if graph_comment_at(node_handle(args[i])) == "" {
  args_carry_prose(args, i + 1)
} else {
  true
}

fn render_arg_lines(ref args, i) with !Mutate = if i >= len(args) {
  ""
} else {
  let one = render_tokens_for(args[i])
  if i == len(args) - 1 { one } else { "{one},\n{render_arg_lines(args, i + 1)}" }
}

fn render_node_list(ref nodes, sep) with !Mutate = render_node_list_from(nodes, 0, sep)

fn render_node_list_from(ref nodes, i, sep: String) with !Mutate = if i >= len(nodes) {
  ""
} else if i == len(nodes) - 1 {
  render_tokens_for(nodes[i])
} else {
  "{render_tokens_for(nodes[i])}{sep}{render_node_list_from(nodes, i + 1, sep)}"
}

fn render_pat_list(ref pats, sep) with !Mutate = render_pat_list_from(pats, 0, sep)

fn render_pat_list_from(ref pats, i, sep: String) = if i >= len(pats) {
  ""
} else if i == len(pats) - 1 {
  render_pat_tokens(pats[i])
} else {
  "{render_pat_tokens(pats[i])}{sep}{render_pat_list_from(pats, i + 1, sep)}"
}

// A param renders its AUTHORED intent boundaries — the ownership marker
// (TParam's authored slot, never the resolved one), the annotation when
// one was written (an unannotated param's ty is the parse-minted TVar —
// the structural discriminator), and the default. Dropping any of these
// on round-trip would change semantics the affine/refinement checks read.
fn render_param_list(ref params) with !Mutate = join(", ", map(render_one_param, params))

fn render_one_param(p) with !Mutate = {
  let marker = match param_authored(p) {
    Own => "own ",
    Ref => "ref ",
    Unmarked => "",
  }
  let ann = match param_ty(p) {
    TVar(_) => "",
    ty => ": {render_type_tokens(ty)}",
  }
  let dflt = match param_default(p) {
    Some(d) => " = {render_tokens_for(d)}",
    None => "",
  }
  "{marker}{param_name(p)}{ann}{dflt}"
}

// ─── The lambda-destructure re-sugar ────────────────────────────────
//
// Parse desugars a pattern-shaped param to a fresh __dp<handle> param
// whose body head destructures it (parser.mn fresh_param_name — the
// prepend-let that desugar_block turns into the one-arm match). The
// render is the parse's inverse, so the sugar comes BACK: a canonical
// page must never bake the minted names (handle numbers in source
// text) nor the machine match. Recognition is the desugar's own
// contract — a __dp-prefixed param whose body is a one-arm match on
// exactly that name — applied left-to-right across the param list
// (each __dp param consumes one match layer, the prepend order); any
// miss falls back to the literal render, productive never refusing.
fn resugar_head(ref params, body) with !Mutate = resugar_walk(params, 0, body, "")

// A declared fn's head and body. A pattern-shaped param rides the same
// desugar as a lambda's (one parse_one_param), so the head re-sugars
// through the same recognizer.
fn render_fn_decl(name, params, retty, effs, body) with !Mutate = match match resugar_head(params, body) {
  Some(pair) => pair,
  None => (render_param_list(params), body),
} {
  (plist, b_node) => {
    let head = fn_head_text(name, plist, retty, effs)
    let b = render_grouped_body(b_node)
    if str_contains(b, "\n") || fits_inline("{head} {b}") {
      "{head} {b}"
    } else {
      "{head}\n{indent_block(b)}"
    }
  },
}

// A declaration's head through its binder — the one shape the whole
// declaration's render and an accepted clause's splice share.
fn fn_head_text(name, plist, retty, effs) with !Mutate =
  "fn {name}({plist}){render_retty(retty)}{render_with_clause(effs)} ="

// The head ALONE, for a reader that writes a declaration's signature back
// without its body: the same param re-sugaring the whole render does.
fn render_fn_head(name, params, retty, effs, body) with !Mutate = match resugar_head(params, body) {
  Some(pair) => match pair {
    (plist, _) => fn_head_text(name, plist, retty, effs),
  },
  None => fn_head_text(name, render_param_list(params), retty, effs),
}

// The arms of a declaration whose only parameter an arm-list literal
// minted — never a parameter an author named, since `fn f(o) = match o
// { … }` is written that way on purpose.
fn module_arm_list(params, body) =
  if len(params) == 1 && is_al_name(param_name(params[0])) { arm_list_of(params, body) } else { None }

// The literal renders as the arms alone — the head it would otherwise
// carry is the wrapper this form exists to delete, and `match`'s own
// renderer is the one that draws arms. Inline when it fits, because the
// commonest literal is one short destructuring arm and spending six lines
// on `map({ (name, _) => name }, xs)` would trade a wrapper for a worse
// page.
fn render_arm_literal(arms) with !Mutate = {
  let one_line = "\{ {render_arm_list_inline(arms, 0)} \}"
  if !str_contains(one_line, "\n") && fits_inline(one_line) {
    one_line
  } else {
    "\{\n{indent_block(strip_trailing_nl(render_match_arms(arms, 0)))}\n\}"
  }
}

fn resugar_walk(ref params, i, body, acc) with !Mutate = if i >= len(params) {
  Some((acc, body))
} else {
  let sep = if i == 0 { "" } else { ", " }
  let p = params[i]
  let nm = param_name(p)
  if is_dp_name(nm) {
    match dp_match_arm(body, nm) {
      Some(arm) => match arm {
        (pat, inner) => resugar_walk(params, i + 1, inner, "{acc}{sep}{render_pat_tokens(pat)}"),
      },
      None => None,
    }
  } else {
    resugar_walk(params, i + 1, body, "{acc}{sep}{render_one_param(p)}")
  }
}

// A name the PARAM-POSITION desugar minted rather than an author wrote,
// read back through `dp_prefix`. The arm-list literal's own prefix never
// answers true here, which is the whole point of their being two
// (parser.mn `fresh_param_under`).
fn is_dp_name(nm) = name_has_prefix(nm, dp_prefix)

// The arm-list literal's own minted parameter, read back through
// `al_prefix`.
fn is_al_name(nm) = name_has_prefix(nm, al_prefix)

// The arms on ONE line — the literal's inline layout. A trailing comma is
// the multi-line form's separator discipline, not the inline one's.
fn render_arm_list_inline(arms, i) with !Mutate = if i >= len(arms) {
  ""
} else {
  let sep = if i == 0 { "" } else { ", " }
  match arms[i] {
    (pat, body) => "{sep}{render_pat_tokens(pat)} => {render_grouped_body(body)}{render_arm_list_inline(arms, i + 1)}",
  }
}

// The one-arm match the desugar minted: the scrutinee IS the __dp name.
fn dp_match_arm(body, nm) = match ast_kind_of(body) {
  NExpr(MatchExpr(scrut, arms)) => if len(arms) == 1 {
    match ast_kind_of(scrut) {
      NExpr(VarRef(snm)) => if snm == nm { Some(arms[0]) } else { None },
      _ => None,
    }
  } else {
    None
  },
  _ => None,
}

// ─── Precedence-inverse parenthesization ────────────────────────────
//
// The render is the parse's inverse under the ONE precedence table
// (SYNTAX §Operator precedence), so an operand whose own precedence is
// LOOSER than its parent's — or equal on the right of a left-assoc
// operator — re-wraps in the parens the parse consumed. Without this,
// (a + b) * c re-rendered as a + b * c: both typecheck, only behavior
// tells — the fmt gate runs the program pre/post and compares exits.
fn render_operand(child, parent_prec, is_right) with !Mutate = {
  let cp = expr_prec_of(child)
  if cp < parent_prec || cp == parent_prec && is_right {
    "({render_tokens_for(child)})"
  } else {
    render_tokens_for(child)
  }
}

// The head of a postfix form — a call's callee, a field read's receiver, an
// index's receiver. Postfix binds tighter than every operator, so the head
// re-wraps whenever it is anything but an atom. Rendered bare, the parse
// took the postfix onto the head's last operand: `(run() ~> hold).beta`
// came back as `run() ~> hold.beta`, an install of `hold.beta`, and fmt
// wrote it into three micros as "names conserved" (measured 2026-09-28).
fn render_postfix_head(head) with !Mutate = render_operand(head, 100, false)

fn expr_prec_of(node) with Pure = match ast_kind_of(node) {
  NExpr(BinOpExpr(op, _, _)) => binop_prec(op),
  NExpr(PipeExpr(k, _, _)) => pipe_prec(k),
  NExpr(FanoutExpr(_)) => pipe_prec(fanout_distribute_kind),
  NExpr(UnaryOpExpr(_, _)) => 90,
  NExpr(IfExpr(_, _, _)) => 15,
  NExpr(MatchExpr(_, _)) => 15,
  NExpr(LambdaExpr(_, _)) => // A lambda's body extends maximally rightward — as an operand it must
  // ALWAYS re-wrap, or the re-parse absorbs the operator into the body
  // (measured: the recurrence `((prev) => …) <~ delay(1)` rendered
  // paren-free, and pass 2 read `delay(1)(prev)` as an application).
  // Prec 0 sits below every operator, so render_operand wraps it in
  // every operand position — SYNTAX's own canonical spelling.
  0,
  _ => 100,
}

// The literal SYNTAX table integers (op_prec's own values — one table,
// this is its render-side projection).
fn binop_prec(op) with Pure = match op {
  BMul => 10,
  BDiv => 10,
  BMod => 10,
  BAdd => 9,
  BSub => 9,
  BConcat => 8,
  BLt => 7,
  BGt => 7,
  BLe => 7,
  BGe => 7,
  BEq => 6,
  BNe => 6,
  BAnd => 5,
  BOr => 4,
}

fn pipe_prec(k) with Pure = match k {
  PForward => 3,
  PFanout(_) => 2,
  PFeedback => 2,
  PTee => 1,
}

// ─── The totality helpers — one per structural form ─────────────────
//
// Interior comments are graph content (the weave attaches them to the
// following statement) — the block render carries each statement's prose
// or the formatter would destroy it. A trailing same-line comment
// re-renders as a leading block: movement, not loss, and stable from the
// second pass (it re-parses as a leading comment).
fn render_block_stmts(ref stmts, i) with !Mutate = if i >= len(stmts) {
  ""
} else {
  "{render_tokens_for(stmts[i])}\n{render_block_stmts(stmts, i + 1)}"
}

// The one interior-prose render — a node's attached comment as leading
// `//` lines at block indent (trailing attachments merged into the same
// cell render as leading: movement, never loss — the decl-comment
// contract at the interior altitude).
fn render_stmt_comment(n) with !Mutate = {
  let c = graph_comment_at(node_handle(n))
  if c == "" { "" } else { "//{replace(c, "\n", "\n//")}\n" }
}

// A record's braces: inline when the whole literal fits and no field carries
// prose, else one field per line — the CallExpr arguments' law at the record
// altitude. A record never broke before, so a fourteen-field literal rendered
// as one 300-column line. `lead` is an update's `...base`, first on either
// layout ("" for a literal).
fn render_record(fields: [(String, Node)], lead: String) with !Mutate = if len(fields) == 0 {
  "\{{lead}\}"
} else {
  let inline = if lead == "" {
    "\{{render_field_inits(fields, 0)}\}"
  } else {
    "\{{lead}, {render_field_inits(fields, 0)}\}"
  }
  if fits_inline(inline) && !fields_carry_prose(fields, 0) {
    inline
  } else {
    let lines = render_field_lines(fields, 0)
    let body = if lead == "" { lines } else { "{lead},\n{lines}" }
    "\{\n{indent_block(body)}\n\}"
  }
}

// One field per line, each closed by its comma — SYNTAX §«Records»' own
// multi-line layout, so a field added at the end is a one-line diff.
fn render_field_lines(fields: [(String, Node)], i) with !Mutate = if i >= len(fields) {
  ""
} else {
  match fields[i] {
    (fname, v) => {
      let one = "{fname}: {render_tokens_for(v)},"
      if i == len(fields) - 1 { one } else { "{one}\n{render_field_lines(fields, i + 1)}" }
    },
  }
}

fn fields_carry_prose(fields: [(String, Node)], i) = if i >= len(fields) {
  false
} else {
  match fields[i] {
    (_, v) => if graph_comment_at(node_handle(v)) == "" { fields_carry_prose(fields, i + 1) } else { true },
  }
}

fn render_field_inits(ref fields: [(String, Node)], i) with !Mutate = if i >= len(fields) {
  ""
} else {
  match fields[i] {
    (fname, v) => {
      let one = "{fname}: {render_tokens_for(v)}"
      if i == len(fields) - 1 { one } else { "{one}, {render_field_inits(fields, i + 1)}" }
    },
  }
}

fn render_string_parts(ref parts, i) with !Mutate = if i >= len(parts) {
  ""
} else {
  let one = match ast_kind_of(parts[i]) {
    NExpr(LitString(s)) => str_escape(s),
    NExpr(ShowExpr(inner)) => // The splice's ShowExpr wrap is invisible surface — the braces
    // render the INNER (render∘parse fixpoint over the wrap).
    "\{{render_tokens_for(inner)}\}",
    _ => "\{{render_tokens_for(parts[i])}\}",
  }
  "{one}{render_string_parts(parts, i + 1)}"
}

// An if-branch is braced by the IF SURFACE itself (the header rule: the
// condition ends at `{`), and the parser wraps a braced branch in a
// BlockExpr — so the render supplies the braces EXACTLY ONCE (render∘parse
// identity, the fmt census's blocker 3): a statement-carrying block takes
// the multi-line block render (its own braces); a single-expression block
// takes the single-line braced form — never literal braces AROUND the
// block render, which accreted a wrap per pass until the inner `\{ x \}`
// re-parsed as the record pun `\{x: x\}`, a float becoming a record; an
// else-if chain renders bare (`else if …`, never `else \{ if … \}`); a
// brace-less branch (the parse_expr arm) gains the canonical braces.
// The overflow form: every branch takes its brace block and the chain
// stays cuddled (`} else {`, `} else if c {`) — SYNTAX's own chase_node
// shape. A prose-carrying else keeps the line-broken form render_else
// already emits.
fn render_branch_block(n) with !Mutate = match ast_kind_of(n) {
  NExpr(BlockExpr(_, _)) => render_tokens_for(n),
  _ => "\{\n{indent_block(render_grouped_body(n))}\n\}",
}

// The else-if DESTRUCTURES its child node and renders the pieces, so the
// child's uniform emission never fires — its attached prose emits here,
// uncuddling the chain at exactly the prose-carrying link.
fn render_else_block(el) with !Mutate = match ast_kind_of(el) {
  NExpr(LitUnit) => "",
  NExpr(IfExpr(c2, t2, e2)) => {
    let core = "else if {render_tokens_for(c2)} {render_branch_block(t2)}{render_else_block(e2)}"
    let ec = graph_comment_at(node_handle(el))
    if ec == "" { " {core}" } else { "\n//{replace(ec, "\n", "\n//")}\n{core}" }
  },
  _ => " else {render_branch_block(el)}",
}

fn render_if_branch(n) with !Mutate = match ast_kind_of(n) {
  NExpr(BlockExpr(stmts, final)) => // Attached prose forces the block layout — a comment needs its own
  // line, and the single-line form would drop it (measured: the
  // if-branch finals were the interior-prose loss's biggest residue).
  if len(stmts) == 0 && graph_comment_at(node_handle(final)) == "" {
    "\{ {render_tokens_for(final)} \}"
  } else {
    render_tokens_for(n)
  },
  NExpr(IfExpr(_, _, _)) => render_tokens_for(n),
  _ => "\{ {render_tokens_for(n)} \}",
}

// The implicit else is the parser's own unit node — rendering it back
// would add `else \{ () \}` to every authored else-less if; omitting it is
// the identity (the re-parse re-inserts the same unit node).
fn render_else(el) with !Mutate = match ast_kind_of(el) {
  NExpr(LitUnit) => "",
  _ => " else {render_if_branch(el)}",
}

// ─── Reindent-on-compose — the depth engine's one primitive ─────────
//
// Every interior renders at depth ZERO; each enclosing block indents its
// WHOLE interior exactly once at composition. Depth is therefore never
// threaded and never wrong: nesting depth IS composition depth (the old
// fixed two-space literals rendered a nested match's arms at column 2
// regardless of depth).
fn indent_block(s) = "  {replace(s, "\n", "\n  ")}"

// The fits-or-breaks rule: an inline render survives when it is one line
// within the budget; otherwise the construct takes its block layout. The
// budget measures at depth zero (reindent-on-compose means a render never
// knows its depth) — deep code runs a few columns wider, the honest
// approximation until the layout engine threads exact width.
fn fits_inline(s) -> Bool = byte_len(s) <= 100 && !str_contains(s, "\n")

fn strip_trailing_nl(s) = {
  let n = byte_len(s)
  if n > 0 && byte_at(s, n - 1) == 10 { str_slice(s, 0, n - 1) } else { s }
}

// A body-lead position: fn, lambda, arm and let bodies route here. A record
// literal or update renders bare, because every brace slot reads its `{`
// through the parser's one discrimination (`brace_form`); until
// 2026-09-28 a fn body read a leading `{` as a block alone, so this wrapped
// a body record in parens the parser then consumed — the formatter
// projecting the parser's gap onto every page.
fn render_grouped_body(node) with !Mutate = match ast_kind_of(node) {
  NExpr(BlockExpr(stmts, final)) => // The E_RedundantBraces format-lift, at the ONE altitude where braces
  // are genuinely optional (fn/lambda/arm/let bodies route here): a
  // stmt-less block IS its final expression, and emitting its braces
  // re-minted the lint on the canonical page (measured: 1654 warnings
  // on the first whole-wheel sweep). Brace-mandatory positions are safe
  // by composition — render_branch_block and the block final add their
  // own braces AROUND this result, exactly once. A block carrying its
  // own attached prose keeps the braces: the prose's anchor.
  if len(stmts) == 0 && graph_comment_at(node_handle(node)) == "" {
    render_grouped_body(final)
  } else {
    render_tokens_for(node)
  },
  _ => // drift-audit: ignore — the brace-lead expr forms and the stmt-less block are the enumerated classes; everything else renders unwrapped by design
  render_tokens_for(node),
}

fn render_match_arms(ref arms, i) with !Mutate = if i >= len(arms) {
  ""
} else {
  match arms[i] {
    (pat, body) => "{render_pat_tokens(pat)} => {render_grouped_body(body)},\n{render_match_arms(arms, i + 1)}",
  }
}

fn render_resume_head(v) with !Mutate = match ast_kind_of(v) {
  NExpr(LitUnit) => "resume()",
  _ => "resume({render_tokens_for(v)})",
}

fn render_state_updates(ref updates: [{init: Node, name: String}], i) with !Mutate = if i >= len(updates) {
  ""
} else {
  let u = updates[i]
  let one = "{u.name} = {render_tokens_for(u.init)}"
  let lead = if i == 0 { " with " } else { ", " }
  "{lead}{one}{render_state_updates(updates, i + 1)}"
}

fn render_let_ann(ann) with !Mutate = match ast_kind_of(ann) {
  NTypeAnn(ty) => ": {render_type_tokens(ty)}",
  _ => // drift-audit: ignore — the ADT's own absence sentinel: LetStmt's ann node is LitUnit when unannotated (the LetStmt decl comment); any non-NTypeAnn body IS that absence, rendered as no clause
  "",
}

// A commented variant set renders VERTICAL (prose above each variant,
// `=`/`|` leading); a prose-free set keeps the inline ` | ` join.
fn render_variants(ref variants, i) with !Mutate = if variants_carry_prose(variants, 0) {
  "\n{indent_block(render_variants_vertical(variants, 0))}"
} else {
  let inline = " = {render_variants_inline(variants, i)}"
  if fits_inline(inline) { inline } else { "\n{indent_block(render_variants_vertical(variants, 0))}" }
}

fn variants_carry_prose(ref variants, i) = if i >= len(variants) {
  false
} else {
  match variants[i] {
    (_, _, cn) => if graph_comment_at(node_handle(cn)) == "" { variants_carry_prose(variants, i + 1) } else { true },
  }
}

fn render_variants_inline(ref variants, i) with !Mutate = if i >= len(variants) {
  ""
} else {
  match variants[i] {
    (vname, tys, _) => {
      let one = if len(tys) == 0 { vname } else { "{vname}({render_ty_list(tys, 0)})" }
      if i == len(variants) - 1 { one } else { "{one} | {render_variants_inline(variants, i + 1)}" }
    },
  }
}

fn render_variants_vertical(ref variants, i) with !Mutate = if i >= len(variants) {
  ""
} else {
  match variants[i] {
    (vname, tys, cn) => {
      let one = if len(tys) == 0 { vname } else { "{vname}({render_ty_list(tys, 0)})" }
      let lead = if i == 0 { "=" } else { "|" }
      let tail = if i == len(variants) - 1 { "" } else { "\n{render_variants_vertical(variants, i + 1)}" }
      "{render_stmt_comment(cn)}{lead} {one}{tail}"
    },
  }
}

// ─── The SURFACE-type projection — the parse's inverse over authored
// type syntax, the formatter's ONE type renderer. show_type is the VOICE
// (diagnostics: List(T) spellings, tN@eN free-var handles, every row
// rendered) and borrowing it here leaked internals into rendered source —
// an effect op's fn-typed param rendered `with t45323@e23311`, which the
// second fmt pass misparsed into three bogus op declarations. Surface
// rules: [T] never List(T); fn-type params are TYPES (a type position
// carries no names — the voice's `_:` invention does not parse); a row
// renders only its AUTHORED content (present + !absent), because a bare
// parse-minted tail var IS authored absence.
fn render_type_tokens(ref ty) with !Mutate = match ty {
  TInt => "Int",
  TFloat => "Float",
  TUnit => "()",
  TByte => "Byte",
  TAddr => "Addr",
  TList(elem) => "[{render_type_tokens(elem)}]",
  TTuple(elems) => "({render_type_list(elems, 0)})",
  TFun(params, ret, row) => "({render_tparam_types(params, 0)}) -> {render_type_tokens(ret)}{render_row_surface(row)}",
  TVar(id) => render_type_handle(id),
  TName(name, args) => if len(args) == 0 { name } else { "{name}({render_type_list(args, 0)})" },
  TRecord(fields) => "\{{render_type_fields(fields, 0)}\}",
  TRecordOpen(fields, _) => "\{{render_type_fields(fields, 0)}, ...\}",
  TRefined(base, pred) => "{render_type_tokens(base)} where {render_predicate_tokens(pred)}",
  TCont(input, answer, disc, world) => show_type(TCont(input, answer, disc, world)),
  TAlias(name, _) => name,
  TReprPin(r, base) => // Parse-inverse: a pin whose base is the width's own bare atom
  // renders bare (`f32` — the atom mints exactly this pair); any other
  // pairing renders the authored `repr` suffix.
  match (r, base) {
    (RF64, TFloat) => "f64",
    (RF32, TFloat) => "f32",
    (RI64, TInt) => "i64",
    (RV128, TInt) => "v128",
    _ => "{render_type_tokens(base)} repr {repr_wat(r)}",
  },
}

// The formatter's OWN predicate projection — the parse's inverse, never
// the voice: show_predicate compresses a call operand to `(...)` (the
// diagnostic register's economy), and a page rendered through it
// destroyed the authored refinement — `len(self)` became `len(...)`, a
// parse break the render register then scoped out of the user's stderr
// (the whole-weave fan collapse this projection exists to prevent). An
// operand is a node HANDLE: read its body live, render through the
// total token render; the cmp glyph is binop_to_str, total by match.
fn render_predicate_tokens(pred) with !Mutate = match pred {
  PTrue => "true",
  PCompare(op, a, b) => "{render_pred_node(a)} {binop_to_str(op)} {render_pred_node(b)}",
  PAnd(a, b) => "{render_pred_grouped(a, 5, false)} && {render_pred_grouped(b, 5, true)}",
  POr(a, b) => "{render_pred_grouped(a, 4, false)} || {render_pred_grouped(b, 4, true)}",
  PNot(p) => "!{render_pred_grouped(p, 90, false)}",
  PBoolNode(n) => render_pred_node(n),
  PPatternMatch(p, n) => // The non-surface predicates (inference-minted narrowing, IFC
  // obligations, partiality, provisions) have no parseable spelling; the
  // voice is their only projection, and the fmt verb's own reparse
  // refuses loudly if one ever reaches a page.
  show_predicate(PPatternMatch(p, n)),
  PFlowLe(src, dst) => show_predicate(PFlowLe(src, dst)),
  PWithSelf(_, inner) => render_predicate_tokens(inner),
  PTotalDiv(op, a, b) => show_predicate(PTotalDiv(op, a, b)),
  PInBounds(recv, idx) => show_predicate(PInBounds(recv, idx)),
  PProvides(provided) => show_predicate(PProvides(provided)),
}

// Precedence-inverse at the predicate altitude — render_operand's rule
// on the predicate tree: a child strictly looser than its parent (or a
// right child at the same tier) re-wraps in the parens the parse consumed.
fn render_pred_grouped(pred, parent_prec, is_right) with !Mutate = {
  let cp = pred_prec(pred)
  if cp < parent_prec || cp == parent_prec && is_right {
    "({render_predicate_tokens(pred)})"
  } else {
    render_predicate_tokens(pred)
  }
}

fn pred_prec(pred) with Pure = match pred {
  PCompare(op, _, _) => binop_prec(op),
  PAnd(_, _) => 5,
  POr(_, _) => 4,
  _ => 90,
}

fn render_pred_node(h) with !Mutate = render_body_tokens(graph_node_body(h))

fn render_type_list(ref tys, i) with !Mutate = if i >= len(tys) {
  ""
} else if i == len(tys) - 1 {
  render_type_tokens(tys[i])
} else {
  "{render_type_tokens(tys[i])}, {render_type_list(tys, i + 1)}"
}

fn render_tparam_types(ref params, i) with !Mutate = if i >= len(params) {
  ""
} else if i == len(params) - 1 {
  render_type_tokens(param_ty(params[i]))
} else {
  "{render_type_tokens(param_ty(params[i]))}, {render_tparam_types(params, i + 1)}"
}

fn render_type_fields(ref fields: [(String, Ty)], i) with !Mutate = if i >= len(fields) {
  ""
} else {
  match fields[i] {
    (name, fty) => {
      let one = "{name}: {render_type_tokens(fty)}"
      if i == len(fields) - 1 { one } else { "{one}, {render_type_fields(fields, i + 1)}" }
    },
  }
}

// A bound var renders its binding (the resolved surface); a free or
// row-state handle has NO parseable surface spelling, so it delegates to
// the voice — loud in the idempotence gate if it ever reaches source,
// never silently absorbed.
fn render_type_handle(h) with !Mutate = match graph_chase(h) {
  GNode(NBound(ty), _) => render_type_tokens(ty),
  GNode(NRecordRowBound(fields, _), _) => render_type_tokens(TRecord(fields)),
  GNode(NFree(_), _) => show_handle(h),
  GNode(NRowBound(_), _) => show_handle(h),
  GNode(NRowFree(_), _) => show_handle(h),
  GNode(NErrorHole(_), _) => show_handle(h),
}

// The row's AUTHORED face: present and absent sets render; the tail never
// does (no surface syntax spells a tail — an open var is authored absence,
// and a Pure-closed empty row is the identity `with Pure` canonically
// drops).
fn render_row_surface(ref row) with !Mutate = match row {
  EfRow(p, a, _) => if len(p) == 0 && len(a) == 0 {
    ""
  } else {
    let pos = render_row_names(p, 0, "")
    let joined = render_row_negs(a, 0, pos)
    " with {joined}"
  },
}

fn render_row_names(ref names, i, acc) with !Mutate = if i >= len(names) {
  acc
} else {
  let one = render_authored_eff_name(names[i])
  let next = if acc == "" { one } else { "{acc} + {one}" }
  render_row_names(names, i + 1, next)
}

fn render_row_negs(ref names, i, acc) with !Mutate = if i >= len(names) {
  acc
} else {
  let one = "!{render_authored_eff_name(names[i])}"
  let next = if acc == "" { one } else { "{acc} + {one}" }
  render_row_negs(names, i + 1, next)
}

fn render_ty_list(ref tys, i) with !Mutate = if i >= len(tys) {
  ""
} else if i == len(tys) - 1 {
  render_type_tokens(tys[i])
} else {
  "{render_type_tokens(tys[i])}, {render_ty_list(tys, i + 1)}"
}

fn render_effect_ops(ref ops: [(String, [TParam], Ty, Node)], i) with !Mutate = if i >= len(ops) {
  ""
} else {
  match ops[i] {
    (oname, params, rty, cnode) => {
      let ret = match rty {
        TUnit => "",
        t => " -> {render_type_tokens(t)}",
      }
      "{render_stmt_comment(cnode)}{oname}({join(", ", map(render_op_param, params))}){ret}\n{render_effect_ops(ops, i + 1)}"
    },
  }
}

// An op's parameter as the author wrote it: `msg: String` named, the bare
// type where the op wrote one (the wildcard `_`, a function type's own
// spelling for a parameter with no name).
fn render_op_param(p) with !Mutate = if param_name(p) == "_" {
  render_type_tokens(param_ty(p))
} else {
  "{param_name(p)}: {render_type_tokens(param_ty(p))}"
}

// Config is [TParam] — render each field as `name` or `name = default`
// (the product's default is authored surface, carried back verbatim;
// format∘parse identity over SYNTAX §«Default parameter values»).
// An effect's instance parameters and a handler's config parameters are
// parameters, and render as one: `render_one_param` carries the marker, the
// authored annotation and the default. Until 2026-09-28 this head had its own
// copy that rendered the name and the default alone, so `mentl fmt` deleted
// every annotation it met here — `effect Sample(rate: Int)` became `effect
// Sample(rate)`, and the declared `Sample(48000)` then refused against a bare
// variable.
fn render_config_params(ref config) with !Mutate =
  if len(config) == 0 { "" } else { "({render_param_list(config)})" }

fn render_name_list(ref names, i) = if i >= len(names) {
  ""
} else if i == len(names) - 1 {
  names[i]
} else {
  "{names[i]}, {render_name_list(names, i + 1)}"
}

// Both handler renders read through the TYPED closed projections
// (state_field_name/init, handler_arm_op_name/args/body — parser.mn's own
// accessors): the bare field reads on the open records computed offsets
// over the partial demanded set and the emitter floored every handler
// decl (the fmt census's blocker 2; the cure existed and was bypassed).
fn render_state_inits(ref states, i) with !Mutate = if i >= len(states) {
  ""
} else {
  let st = states[i]
  let one = "{state_field_name(st)} = {render_tokens_for(state_field_init(st))}"
  let lead = if i == 0 { " with " } else { ", " }
  "{lead}{one}{render_state_inits(states, i + 1)}"
}

// A handler's `with` is one slot read by position (SYNTAX §«With-clauses»):
// its own effect row when it authors one, else its state inits — the
// parse's inverse over what the node carries.
fn render_handler_clause(effs, states) with !Mutate =
  if len(effs) > 0 { " with {render_row_triples(effs, 0)}" } else { render_state_inits(states, 0) }

fn render_handler_arms(ref arms, i) with !Mutate = if i >= len(arms) {
  ""
} else {
  let a = arms[i]
  "{handler_arm_op_name(a)}({render_name_list(handler_arm_args(a), 0)}) => {render_grouped_body(handler_arm_body(a))},\n{render_handler_arms(arms, i + 1)}"
}

fn render_lit_value(lv) = match lv {
  LVInt(n) => int_to_str(n),
  LVFloat(f) => float_to_str(f),
  LVString(s) => "\"{str_escape(s)}\"",
  LVBool(b) => if b { "true" } else { "false" },
}

fn render_plist_inner(ref ps, rest: Option(String)) = {
  let prefix = render_pat_list(ps, ", ")
  match rest {
    Some(rname) => if len(ps) == 0 { "...{rname}" } else { "{prefix}, ...{rname}" },
    None => prefix,
  }
}

fn render_pat_fields(ref fields, i) = if i >= len(fields) {
  ""
} else {
  match fields[i] {
    (fname, p) => {
      // Punning is the canonical form when the pattern binds the field's
      // own name (SYNTAX §records).
      let one = match p {
        PVar(n) => if n == fname { fname } else { "{fname}: {n}" },
        other => "{fname}: {render_pat_tokens(other)}",
      }
      if i == len(fields) - 1 { one } else { "{one}, {render_pat_fields(fields, i + 1)}" }
    },
  }
}

// The declared with-clause, rendered from the parser's SIGNED TRIPLES —
// [(EffName, negated, EConn)] — verbatim: the authored surface is the only
// faithful render (a closed-row rebuild cannot represent - / & connectors
// or per-entry !, and feeding the triples to the row constructor read
// tuples as bare EffNames — «invalid-effect» destroyed 41 declared rows
// across the five pass-once files, the fmt census's blocker 1).
fn render_with_clause(effs) with !Mutate =
  if len(effs) == 0 { "" } else { " with {render_signed_effs(effs, 0)}" }

fn render_signed_effs(ref effs, i) with !Mutate = if i >= len(effs) {
  ""
} else {
  match effs[i] {
    (name, negated, conn) => {
      // The first entry's connector is its position; each later entry
      // carries the operator the author joined it with.
      let lead = if i == 0 {
        ""
      } else {
        match conn {
          EcUnion => " + ",
          EcDiff => " - ",
          EcInter => " & ",
        }
      }
      let bang = if negated { "!" } else { "" }
      "{lead}{bang}{render_authored_eff_name(name)}{render_signed_effs(effs, i + 1)}"
    },
  }
}

fn render_authored_eff_name(name) with !Mutate = match name {
  EPure => // drift-audit: ignore — the ADT match RENDERING the surface keyword, not a string-keyed dispatch
  "Pure",
  ENamed(h) => intern_name_of(h),
  EParameterized(h, args) => "{intern_name_of(h)}({render_authored_eff_args(args, 0)})",
}

// The instance args render through show_eff_arg — the ONE arg renderer
// (the diagnostics voice and the formatter speak the same projection).
fn render_authored_eff_args(ref args, i) with !Mutate = if i >= len(args) {
  ""
} else {
  let one = show_eff_arg(args[i])
  if i == len(args) - 1 { one } else { "{one}, {render_authored_eff_args(args, i + 1)}" }
}

// An authored `-> RetTy` carries back verbatim (the fmt census's blocker
// 4: the discarded binder silently dropped 91 authored heads); the absent
// annotation renders nothing.
fn render_retty(retty) with !Mutate = match retty {
  N(b, _, _) => match b {
    NTypeAnn(ann_ty) => " -> {render_type_tokens(ann_ty)}",
    _ => // drift-audit: ignore — the documented absent-annotation contract (an inferred return renders no clause)
    "",
  },
}

// Canonical indent depth per node kind. Match-arm bodies +2; let-
// value at same indent as let; fn body +2 from fn signature; etc.
// Each kind's indent is the PARENT's indent + verb-class offset.
fn render_indent_for(kind) = spaces(canonical_indent_depth(kind))

fn render_line_break_after(kind) with Pure = match kind {
  NStmt(_) => "\n",
  NExpr(_) => "",
  NPat(_) => "",
  NHole(_) => "",
  NModule(_) => "\n",
  NTypeAnn(_) => "",
}

// The one comment, read LIVE from the comment weave at the node's handle
// (graph_comment_at) — never a copied string. The weave stores the prose with
// leading // stripped, contiguous lines joined by \n; render restores the //
// prefix on every line (re-prefixing each internal newline via `replace`) and a
// trailing newline so the block leads the declaration. Empty string when the
// node carries no comment (an honest read, not a stub).
fn render_comment_at(h) with !Mutate = {
  let text = graph_comment_at(h)
  if text == "" { "" } else { "//{replace(text, "\n", "\n//")}\n" }
}

fn render_branch_tuple(branches) = if len(branches) == 0 {
  ""
} else {
  let head = last(branches)
  let tail = drop_last(branches)
  let head_str = render_chain_node(head)
  let head_line = spaces(indented_center()) ++ head_str ++ ","
  if len(tail) == 0 { head_line } else { head_line ++ "\n" ++ render_branch_tuple(tail) }
}

fn render_non_chain(node) = render_node_at(node_handle(node))

fn format_one_stmt(stmt) = render_node_at(node_handle(stmt))

fn ast_top_level_stmts(ast) with Pure = ast

fn ast_kind_of(node) with Pure = match node {
  N(body, _, _) => body,
}

// node_handle() — see src/infer.mn (canonical Node-handle accessor).
fn canonical_indent_depth(kind) with Pure = match kind {
  NStmt(_) => 0,
  NExpr(_) => left_edge_indent(),
  _ => // drift-audit: ignore — non-stmt/expr kinds sit at left edge; depth 0 IS their canonical indent, not a fabricated default
  0,
}

// The unary operator glyph per SYNTAX.md — `-` negate, `!` logical-not.
fn unary_op_glyph(op) with Pure = match op {
  UNeg => "-",
  UNot => "!",
}

// ─── The conservation census — what a render may never lose ─────────
//
// THE NAME CENSUS a rendered text answers to: the render's identifiers and
// literals counted, then SPENT against the source's, and every source atom
// left unpaid is a loss. A multiset rather than a sequence, because the
// canonical render reorders on purpose (record fields sort at parse), and a
// count rather than a set, because a render that keeps one of two uses of a
// name has still lost one. A literal is keyed by its VALUE — `48_000` and `48000` are
// one atom — so a spelling the render changes is not a loss here; that one
// is `Hβ.fmt.literal-spelling-is-intent`. Homed beside the formatter
// because it is the formatter's law: the fmt verb's write and an accepted
// clause's splice both answer to it.
fn lost_atoms(src_toks, out_toks) = lost_atoms_beside(src_toks, out_toks, [])

// The census of an edit that replaces a written name with one that states
// it: each name in `stated` is counted as present once — an accepted
// refinement over `n: Int` writes `n: NonZero`, and `Int` survives as the
// base NonZero's own declaration names (D4). Nothing else is admitted.
fn lost_atoms_beside(src_toks, out_toks, stated: [String]) = match fold(
  (fold(fold(smap_new(), atom_counted, out_toks), key_counted, stated), []),
  atom_spent,
  src_toks
) {
  (_, lost) => lost,
}

fn atom_counted(counts, t) = match atom_key(t) {
  Some(k) => key_counted(counts, k),
  None => counts,
}

fn key_counted(counts, k: String) = smap_add(counts, k, atom_count(counts, k) + 1)

fn atom_spent(acc, t) = match acc {
  (counts, lost) => match atom_key(t) {
    Some(k) => {
      let c = atom_count(counts, k)
      if c > 0 { (smap_add(counts, k, c - 1), lost) } else { (counts, push(lost, t)) }
    },
    None => acc,
  },
}

fn atom_count(counts, k: String) = match smap_get(counts, k) {
  Some(c) => c,
  None => 0,
}

// What an authored token says, as the census compares it: a name as itself,
// a literal by its value under a kind mark, so a name and a string that spell
// it are two atoms. Keywords and punctuation are the render's to choose.
fn atom_key(t) = match token_kind(t) {
  TIdent(s) => Some(s),
  TIntLit(n) => Some("#{int_to_str(n)}"),
  TFloatLit(f) => Some("#{float_to_str(f)}"),
  TStringLit(s) => Some("\"{s}"),
  TStringPart(s) => Some("\"{s}"),
  _ => None,
}

// One TComment token per authored prose line — the lexical census the
// conservation gate reads on both sides of a round trip.
fn count_comment_tokens(tokens, i, acc) = if i >= len(tokens) {
  acc
} else {
  match token_kind(tokens[i]) {
    TComment(_) => count_comment_tokens(tokens, i + 1, acc + 1),
    _ => count_comment_tokens(tokens, i + 1, acc),
  }
}
