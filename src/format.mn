// format.mn — the canonical render: the developer types meaning and the
// file on disk is the graph projected back in canonical form, the same
// bytes for the same program on every save.
//
// Layout is projection, never contract: the parser reads no whitespace, so
// indent, line breaks and the parentheses precedence already implies are
// this module's decisions, and a render is canonical exactly when it is
// its own fixpoint — formatting twice is formatting once. SYNTAX's
// canonical layout is the authority this render answers to.
import types

import effects

import graph

import parser

import strings

// A program's top-level statements rendered as its canonical text.
effect Format {
  format_program([Node]) -> String
}

// The canonical render, read-only over the graph.
handler format_default {
  format_program(ast) => resume(render_program(ast)),
}

// AN ARM MAY NOT PERFORM ITS OWN HANDLER'S OPS. A deep handler is not
// installed for its own arms — the arm body runs in the world OUTSIDE the
// install, which is what `tests/frontier/mn-deep-handler-arm.mn` pins at 51
// — so an op performed from inside an arm walks PAST its own handler. With
// `format_default` the only Format install, that walk reached the chain's
// end and refused: `mentl fmt` trapped on real input, having compiled with
// zero diagnostics. It read `ev_declaring_node <- format_one_stmt <-
// op_format_default_format_program`.
//
// It was authored against a missing bracket. The lexical dispatch tier used
// to emit a bare direct call with NO world bracket, so a perform inside an
// arm resolved to the arm's own handler and this shape worked. Making the
// bracket uniform made the law true everywhere and left these behind.
//
// The form is a DELETION, not a mechanism: an arm that needs a sibling op
// already holds that op's implementation, so performing it re-derives
// something in scope — Carried-Truth at the handler boundary. The op is the
// INTERFACE, for callers outside; the fn is the implementation, for the arms
// and for every helper the arms call. Rows stay inferred (Intent Boundaries
// only), and the arms become one line each.
fn render_program(ast) = {
  let stmts = ast_top_level_stmts(ast) |> imports_in_path_order
  let rendered = stmts |> map(render_node_at)
  join_lines(rendered)
}

// A module's imports are a set (the parse keeps one edge per module), and a
// set has no authored order — each run of import statements renders in path
// order, so an unrelated edit never churns the block. An import that carries
// prose stays where its author put it — the module's header rides the first
// statement, and a comment naming why an import is there anchors it — so a
// commented import closes the run before it and stands on its own.
fn imports_in_path_order(stmts) = match fold(([], []), import_run_step, stmts) {
  (out, run) => out ++ imports_sorted(run),
}

fn import_run_step(acc, stmt) = match acc {
  (out, run) => match import_path_of(stmt) {
    Some(_) => if graph_comment_at(stmt) == "" {
      (out, push(run, stmt))
    } else {
      (out ++ imports_sorted(run) ++ [stmt], [])
    },
    None => (out ++ imports_sorted(run) ++ [stmt], []),
  },
}

fn import_path_of(stmt) = match graph_node_body(stmt) {
  NStmt(ImportStmt(path)) => Some(path),
  _ => None,
}

fn imports_sorted(run) = fold([], import_inserted, run)

fn import_inserted(sorted, stmt) = match import_path_of(stmt) {
  Some(p) => {
    let before = filter(import_before(p, ??), sorted)
    before ++ [stmt] ++ drop(len(before), sorted)
  },
  None => push(sorted, stmt),
}

fn import_before(p: String, s) = match import_path_of(s) {
  Some(q) => !str_lt(p, q),
  None => true,
}

// ─── render_node_at — render one node ─────────────────────────────
//
// A node's text is its prose, its indent, its tokens and its line break, read
// in that order. This was a seven-branch fanout of which the assembly read
// four: the span branch was a constant, the reason branch walked the node's
// Why and threw it away, and the sibling branch read a "render context" that
// SCANNED EVERY HANDLE IN THE GRAPH for a parent of this node — once per
// top-level statement of every file `mentl fmt` touched — to answer a context
// the indent never read and the separator mapped to "" in every case
// (measured 2026-10-02, the third whole-graph parent scan the E4 caret audit
// found; the cursor's and the eight-loop's read the declaration's path now).
fn render_node_at(handle) with !Mutate = {
  let body = graph_node_body(handle)
  render_comment_at(handle) ++ render_indent_for(body) ++ render_body_tokens(handle, body) ++ render_line_break_after(body)
}

// The canonical indents: two spaces for the left-edge verbs (`|>`, `~>`,
// `<|`), four for the convergent verbs at indented center (`><`, `<~`).
fn left_edge_indent() with Pure = 2

fn indented_center() with Pure = 4

// The fanout kind as a top-level value: the N-ary carrier has no verb
// VALUE in its match (the kind is the census/glyph key, not a field),
// so arms that need its precedence or glyph read this one binding —
// constructed once, never per render call (the row stays alloc-free).
let fanout_distribute_kind = PFanout(FanDistribute)

// Every branch renders parenthesized, inline as in the vertical layout
// (SYNTAX §`><`, the render rule): the parentheses are the branch's visual
// boundary. Wrapped only where precedence demanded it, `((1 + 1) >< (2 + 2))`
// rendered as `(1 + 1 >< 2 + 2)` — the same tree, read as one sum.
fn render_fanout_inline(branches) = match branches {
  [] => "",
  [one] => parenthesize(render_tokens_for(one)),
  [h, ...t] => "{parenthesize(render_tokens_for(h))} >< {render_fanout_inline(t)}",
}

// Each branch on its own line, `><` alone between them at indented center.
fn render_fanout_vertical(branches) = match branches {
  [] => "",
  [one] => parenthesize(render_tokens_for(one)),
  [h, ...t] => "{parenthesize(render_tokens_for(h))}\n{spaces(indented_center())}><\n{render_fanout_vertical(t)}",
}

// An install node the judgment bound `ChainInstall`: the node its author
// wrote the chain's name at and how many members it became (infer.mn's
// infer_chain_install). A parse-only render never meets one — the rewrite is
// the judgment's — so `mentl fmt` reads the authored reference as written.
fn chain_installed(h) = chain_of_reason(graph_reason_at(h))

fn chain_of_reason(reason) = match reason {
  ChainInstall(r, n) => Some((r, n)),
  Located(_, inner) => chain_of_reason(inner),
  _ => None,
}

// The body under a chain's installs: `k` nested member installs unwrapped
// from the install node's left side.
fn chain_body(l, k) = if k <= 0 {
  l
} else {
  match graph_node_body(l) {
    NExpr(PipeExpr(PTee, inner, _)) => chain_body(inner, k - 1),
    _ => l,
  }
}

// A chain declaration's members on one line, joined by ` ~> `.
fn render_chain_members(h) with !Mutate = match graph_node_body(h) {
  NExpr(PipeExpr(PTee, l, r)) => "{render_chain_members(l)} ~> {render_tokens_for(r)}",
  _ => render_tokens_for(h),
}

fn spaces(n) = if n == 0 { "" } else { " {spaces(n - 1)}" }

fn parenthesize(s: String) = "({s})"

// Head-first join: parser lists are source-ordered (built `[x] ++ rest`),
// so iteration walks index 0 upward — the last/drop_last form rendered
// every list REVERSED, unseen because this module had zero callers.
fn join_lines(lines) = join_lines_from(lines, 0)

fn join_lines_from(ref lines, i) = if i >= len(lines) {
  ""
} else if i == len(lines) - 1 {
  lines[i]
} else {
  "{lines[i]}\n{join_lines_from(lines, i + 1)}"
}

// ─── Render-aspect helpers — one per cursor-projection lens ────────
//
// render_tokens_for IS the parser's inverse: a per-NodeBody projection that
// emits the canonical token text the parser would re-consume to the SAME graph
// (format∘parse = identity). Each AST variant reads its child nodes live and
// renders them recursively — the formatter shares the surface SYNTAX.md binds,
// so the bytes round-trip. No "node@42" placeholder.
// THE UNIFORM EMIT — the one place every node's attached prose renders:
// it prefixes the node's own tokens as leading `//` lines. Attachment is
// uniform (the weave pass), so emission must be too; the per-construct
// emission calls this replaced covered only the statement-shaped sites
// and lost every expression-position attach at render. A mid-line
// node's prose forces its line to break, which the fits-or-breaks rule
// cascades outward — and the verb's internal re-render makes the
// written file the fixpoint of any resulting movement.
fn render_tokens_for(node) with !Mutate = {
  let c = graph_comment_at(node)
  let lead = if c == "" { "" } else { "//{replace(c, "\n", "\n//")}\n" }
  match let_born(node) {
    Some((scrut, pat, rest)) => "{lead}\{\n{indent_block(render_let_chain(scrut, pat, rest))}\n\}",
    None => "{lead}{render_installed_tokens(node)}",
  }
}

// A judged install of a named chain renders as the author wrote it — the
// body under the chain's member installs, then `~> NAME` — wherever the
// node stands: a statement, an operand, an argument. The check read the
// handle only on the chain-render route until 2026-10-14, so every
// `body ~> infer_context` in a judged module rendered as its members.
fn render_installed_tokens(node) with !Mutate = {
  let body = graph_node_body(node)
  match (chain_installed(node), body) {
    (Some((r, n)), NExpr(PipeExpr(PTee, l, _))) => "{render_operand(chain_body(l, n - 1), pipe_prec(PTee), false)} ~> {render_tokens_for(r)}",
    _ => render_body_tokens(node, body),
  }
}

// The one-arm match a destructuring let became, as its scrutinee, pattern and
// the rest of the block — or None for a match the author wrote. The parse
// makes `let pat = v` and the rest of its block one arm of a
// `match` (desugar_block), and births that match `LetBinding`. The render is
// the parse's inverse, so the let comes back: `let pat = v`, then the
// statements and final the arm holds, at the block's own indent — never the
// match pyramid one level deeper per destructure. A `match` the author wrote
// is born a placeholder and renders as a match.
fn let_born(n) = match graph_node_body(n) {
  NExpr(MatchExpr(scrut, arms)) => if len(arms) == 1 && graph_let_born(n) {
    match arms[0] {
      (pat, body) => Some((scrut, pat, body)),
    }
  } else {
    None
  },
  _ => None,
}

fn render_let_chain(scrut, pat, body) with !Mutate =
  "let {render_pat_tokens(pat)} = {render_tokens_for(scrut)}\n{render_block_rest(body)}"

// What follows a let in its block: the statements the parse folded into the
// arm, then the block's final.
fn render_block_rest(body) with !Mutate = match graph_node_body(body) {
  NExpr(BlockExpr(stmts, final)) => "{render_stmt_comment(body)}{render_block_stmts(stmts, 0)}{render_block_final(final)}",
  _ => render_block_final(body),
}

// A block's final, at the block's indent: a destructuring let continues the
// block, anything else is the block's value.
fn render_block_final(final) with !Mutate = match let_born(final) {
  Some((scrut, pat, rest)) => "{render_stmt_comment(final)}{render_let_chain(scrut, pat, rest)}",
  None => render_grouped_body(final),
}

// A node's body as tokens. Every name a reference writes is its
// declaration's, read through the reference's edge (`ref_spelling`), so a
// rename is one write at the declaration and the page follows it; a node
// the judgment never linked writes the name it holds.
fn render_body_tokens(node, body) with !Mutate = match body {
  NExpr(e) => render_expr_tokens(node, e),
  NStmt(s) => render_stmt_tokens(s),
  NPat(p) => render_pat_value(node, p),
  NHole(_) => "??",
  NModule(m) => "// module {m.path}",
  NLink(_) => "// link",
  NTypeAnn(ty) => render_type_tokens(ty),
  NName(written) => match written {
    RowEffect(name) => render_authored_eff_name(term_spelled(name, Some(node))),
    ArmOp(op) => ref_spelling(node, op),
    StateWrite(field) => ref_spelling(node, field),
  },
  NRow(terms) => render_authored_row(terms),
  NParam(p) => render_param_body(p),
}

fn render_expr_tokens(node, e) with !Mutate = match e {
  // A negative literal node is a literal the lexer WRAPPED — `0x811C9DC5`,
  // `2147483648` — since an authored `-5` parses as UNeg(5). int_to_str
  // prints its minus, which re-parses as a unary minus over a different
  // literal: INT_MIN accreted one `-` per pass, and `0x811C9DC5` became
  // two tokens the conservation census could not pair. The wrapping
  // spelling IS the value — the unsigned word the lexer wraps back — one
  // token, idempotent, and the authored radix returns through `respell`.
  LitInt(n) => if n < 0 { unsigned_word_text(n) } else { int_to_str(n) },
  LitFloat(f) => float_literal_text(f),
  LitString(s) => "\"{str_escape(s)}\"",
  LitBool(b) => if b { "true" } else { "false" },
  LitUnit => "()",
  VarRef(name) => ref_spelling(node, name),
  BinOpExpr(op, l, r) => {
    let rc = graph_comment_at(r)
    if lifts_zero_minus(op, l, r) {
      "-{render_tokens_for(r)}"
    } else if rc == "" {
      "{render_operand(l, binop_prec(op), false)} {binop_to_str(op)} {render_operand(r, binop_prec(op), true)}"
    } else {
      "{render_operand(l, binop_prec(op), false)} {binop_to_str(op)}\n{render_operand(r, binop_prec(op), true)}"
    }
  },
  UnaryOpExpr(op, x) => "{unary_op_glyph(op)}{render_operand(x, 90, true)}",
  CallExpr(callee, args) => {
    let inline = "{render_postfix_head(callee)}({render_node_list(args, ", ")})"
    if (fits_inline(inline) || len(args) < 2) && !args_carry_prose(args, 0) {
      inline
    } else {
      "{render_postfix_head(callee)}(\n{indent_block(render_arg_lines(args, 0))}\n)"
    }
  },
  LabeledArg(label, v) => "{label_spelling(node, label, v)} = {render_tokens_for(v)}",
  FieldExpr(recv, field) => "{render_postfix_head(recv)}.{field}",
  IndexExpr(recv, idx) => "{render_postfix_head(recv)}[{render_tokens_for(idx)}]",
  PipeExpr(verb, l, r) => {
    let rc = graph_comment_at(r)
    if rc == "" {
      "{render_operand(l, pipe_prec(verb), false)} {show_pipe_kind(verb)} {render_operand(r, pipe_prec(verb), true)}"
    } else {
      "{render_operand(l, pipe_prec(verb), false)} {show_pipe_kind(verb)}\n{render_operand(r, pipe_prec(verb), true)}"
    }
  },
  // Inline when it fits; past the width, SYNTAX §`><`'s vertical layout.
  FanoutExpr(branches) => {
    let inline = render_fanout_inline(branches)
    if fits_inline(inline) { inline } else { render_fanout_vertical(branches) }
  },
  RestExpr(nm) => "...{nm}",
  IfExpr(c, t, el) => {
    let inline = "if {render_tokens_for(c)} {render_if_branch(t)}{render_else(el)}"
    if fits_inline(inline) {
      inline
    } else {
      "if {render_tokens_for(c)} {render_branch_block(t)}{render_else_block(el)}"
    }
  },
  // An element carrying prose forces the VERTICAL layout (the CallExpr
  // args law at the tuple/list altitude): an inline pack embeds the
  // prose's newlines mid-expression, and the next parse re-homes the
  // comment to whatever now starts the following line — the layout
  // migration that broke fmt idempotence on the fan's labeled branches
  // (measured: the eight-interrogation branch tuple's labels walked one
  // arm per pass).
  // A literal past the width breaks one element per line, as a call's
  // arguments do — a `<|` branch tuple included.
  MakeListExpr(elems) => {
    let inline = "[{render_node_list(elems, ", ")}]"
    if args_carry_prose(elems, 0) || !fits_inline(inline) {
      "[\n{indent_block(render_arg_lines(elems, 0))}\n]"
    } else {
      inline
    }
  },
  MakeTupleExpr(elems) => {
    let inline = "({render_node_list(elems, ", ")})"
    if args_carry_prose(elems, 0) || !fits_inline(inline) {
      "(\n{indent_block(render_arg_lines(elems, 0))}\n)"
    } else {
      inline
    }
  },
  ExprPlaceholder => "??",
  // The final expr's attached prose renders exactly as a statement's does
  // — the weave attaches a before-final interior comment (and the
  // block-tail comment, whose home is the final's own handle when nothing
  // follows) to the final, and dropping it violated "never dropped" (the
  // fmt census's blocker 5: a third of parser.mn's prose was
  // body-interior).
  BlockExpr(stmts, final) => "\{\n{indent_block("{render_block_stmts(stmts, 0)}{render_block_final(final)}")}\n\}",
  LambdaExpr(params, body) => match arm_list_of(params, body) {
    Some(arms) => render_arm_literal(arms),
    None => "({render_param_list(params)}) => {render_grouped_body(body)}",
  },
  MakeRecordExpr(fields) => render_record(fields, ""),
  NamedRecordExpr(head, fields) => "{render_tokens_for(head)}{render_record(fields, "")}",
  RecordUpdateExpr(base, fields) => render_record(fields, "...{render_tokens_for(base)}"),
  // Interpolation is the parse's inverse: literal chunks re-escape,
  // every other fragment renders as a live splice.
  MakeStringExpr(parts) => "\"{render_string_parts(parts, 0)}\"",
  // Outside a string context the wrap is invisible surface — the
  // inner renders bare (parser-minted only inside fragments).
  ShowExpr(inner) => render_tokens_for(inner),
  MatchExpr(scrut, arms) => "match {render_tokens_for(scrut)} \{\n{indent_block(strip_trailing_nl(render_match_arms(arms, 0)))}\n\}",
  ResumeExpr(v, updates) => "{render_resume_head(v)}{render_state_updates(updates, 0)}",
}

fn render_stmt_tokens(s) with !Mutate = match s {
  FnStmt(name, params, retty, effs, body) => match module_arm_list(params, body) {
    // A module-scope `let name = { arms }` is born a declaration whose one
    // parameter the literal minted (parser.mn `let_at_scope`), so it renders
    // as the literal it was written as: the fresh name never reaches the page.
    Some(arms) => "let {name} = {render_arm_literal(arms)}",
    None => render_fn_decl(name, params, retty, effs, body),
  },
  ImportStmt(path) => "import {path}",
  // A unit expression statement is the file-tail prose CARRIER (and a
  // bare `()` statement is dead weight either way): its comment renders,
  // its tokens do not.
  ExprStmt(e) => match graph_node_body(e) {
    NExpr(LitUnit) => "",
    _ => render_grouped_body(e),
  },
  AliasStmt(name, ty) => "type {name} = {render_decl_type(ty)}",
  RowAliasStmt(name, effs) => "type {name} = {render_authored_row(effs)}",
  LetStmt(pat, value, ann) => {
    let lhead = "let {render_pat_tokens(pat)}{render_let_ann(ann)} ="
    let lv = render_tokens_for(value)
    if str_contains(lv, "\n") || fits_inline("{lhead} {lv}") {
      "{lhead} {lv}"
    } else {
      "{lhead}\n{indent_block(lv)}"
    }
  },
  TypeDefStmt(name, variants) => match nominal_record_of(name, variants) {
    Some(fields) => render_record_decl(name, fields),
    None => "type {name}{render_variants(variants, 0)}",
  },
  // An op's params carry the author's names (a bare type is the wildcard
  // `_`), so the render is the parse's inverse over both spellings. The
  // instance params render through the same product projection the
  // handler head uses (format∘parse identity over SYNTAX §«Parameterized
  // effect»).
  // An effect with no operations is a marker (`effect Mutate {}`): its body
  // renders closed on the head's line, never as a brace pair around an
  // indented empty line (the trailing-space line the block form wrote).
  EffectDeclStmt(name, params, ops) => match ops {
    [] => "effect {name}{render_config_params(params)} \{\}",
    _ => "effect {name}{render_config_params(params)} \{\n{indent_block(strip_trailing_nl(render_effect_ops(ops, 0)))}\n\}",
  },
  HandlerDeclStmt(hname, _ename, config, states, arms, effs) => "handler {hname}{render_config_params(config)}{render_handler_clause(effs, states)} \{\n{indent_block(strip_trailing_nl(render_handler_arms(arms, 0)))}\n\}",
  // A chain declaration is one line, its members joined by ` ~> ` — the
  // layout of a composition, not of an install over a body.
  HandlerChainStmt(name, chain) => "handler {name} = {render_chain_members(chain)}",
  // The predicate renders as the expression its author wrote: `self > 0`
  // stays `self > 0`, where a render of the verifier's projection wrote
  // `0 < self`.
  RefineStmt(name, ty, pred) => "type {name} = {render_decl_type(ty)} where {render_pred_node(pred)}",
}

// A representation pin at a type declaration's right-hand side renders
// with its suffix (`Float repr f64`, SYNTAX's representation-pinned alias)
// and anywhere else as its bare width (`s: f64`). Both spellings parse to
// one pin, so the position decides the spelling and neither page loses a
// word: until 2026-09-28 a canonical pair rendered bare everywhere, and a
// declaration written as SYNTAX writes it came back as `type Coeff = f64`.
fn render_decl_type(ty) with !Mutate = match ty {
  TReprPin(r, base) => "{render_type_tokens(base)} repr {repr_wat(r)}",
  t => render_type_tokens(t),
}

fn render_pat_tokens(h) = render_pat_value(h, pat_of(h))

// A pattern as written: a binder writes the name it declares, a
// constructor the name its edge reaches.
fn render_pat_value(node, p) = match p {
  PVar(name) => name,
  PWild => "_",
  PCon(name, ps) => {
    let cname = ref_spelling(node, name)
    if len(ps) == 0 { cname } else { "{cname}({render_pat_list(ps, ", ")})" }
  },
  PLit(lv) => render_lit_value(lv),
  PTuple(ps) => "({render_pat_list(ps, ", ")})",
  PList(ps, rest) => "[{render_plist_inner(ps, rest)}]",
  PRecord(fields, rest) => match rest {
    None => "\{{render_pat_fields(fields, 0)}\}",
    Some(r) => if len(fields) == 0 {
      "\{...{render_pat_tokens(r)}\}"
    } else {
      "\{{render_pat_fields(fields, 0)}, ...{render_pat_tokens(r)}\}"
    },
  },
  // Branches that each bind the whole value under one name are that
  // binder over the alternation, `b @ (C(_) | D)` — the lift `lifted_at`
  // states, one name per branch the grouped spelling writes once.
  PAlt(ps) => match binder_of_branches(ps) {
    Some((name, inners)) => render_binder_over(name, map(render_pat_tokens, inners)),
    None => render_alternation(map(render_pat_tokens, ps)),
  },
  PAs(name, inner) => match pat_of(inner) {
    PAlt(ps) => render_binder_over(name, map(render_pat_tokens, ps)),
    PVar(_) | PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAs(_, _) => "{name} @ {render_pat_tokens(inner)}",
  },
}

// An alternation, inline when it fits; past the width, one branch per line,
// each continuation led by its `|` (SYNTAX §«Pattern alternation — rule»):
// the roster a catch-all stood for is often forty names, and the parser
// passes over the newline before a `|` as layout.
fn render_alternation(branches) = {
  let inline = join(" | ", branches)
  if fits_inline(inline) { inline } else { join("\n| ", branches) }
}

// The binder over the alternation it groups, one branch per line past the
// width as the bare alternation breaks.
fn render_binder_over(name: String, branches) = {
  let inline = "{name} @ ({join(" | ", branches)})"
  if fits_inline(inline) { inline } else { "{name} @ (\n{indent_block(join("\n| ", branches))}\n)" }
}

// The roster a catch-all over a sum stands for, as `mentl tighten` writes it:
// each constructor with its payload left to `_`, Bool's two by their
// literals, under the arm's binder when it bound one.
fn render_roster(roster) = match roster {
  Roster(binder, ctors) => {
    let branches = map(render_roster_ctor, ctors)
    match (binder, branches) {
      (Some(name), [one]) => "{name} @ {one}",
      (Some(name), _) => render_binder_over(name, branches),
      (None, _) => render_alternation(branches),
    }
  },
}

fn render_roster_ctor(entry) = match entry {
  ("True", 0) => "true",
  ("False", 0) => "false",
  (cname, k) => if k == 0 { cname } else { "{cname}({join(", ", map({ _ => "_" }, range(0, k)))})" },
}

// The one binder every branch of an alternation places over the whole value,
// with the branches under it — `b @ C(_) | b @ D` is `b @ (C(_) | D)`.
fn binder_of_branches(ps) = match ps {
  [first, ..._] => match pat_of(first) {
    PAs(name, _) => match fold(Some([]), as_branches_step(name, ??, ??), ps) {
      Some(inners) => Some((name, inners)),
      None => None,
    },
    PVar(_) | PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) => None,
  },
  [] => None,
}

fn as_branches_step(name: String, acc, branch) = match acc {
  None => None,
  Some(inners) => match pat_of(branch) {
    PAs(n, inner) => if n == name { Some(push(inners, inner)) } else { None },
    PVar(_) | PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) => None,
  },
}

// Every list renderer walks HEAD-FIRST (index 0 upward): parser lists are
// source-ordered, so the old last/drop_last walks rendered them reversed —
// unseen while this module had zero callers.
// The broken-call form: one argument per line, each argument's attached
// prose above its line (a prose-carrying argument FORCES this form —
// the inline join has nowhere to put a comment).
fn args_carry_prose(ref args, i) = if i >= len(args) {
  false
} else if graph_comment_at(args[i]) == "" {
  args_carry_prose(args, i + 1)
} else {
  true
}

fn render_arg_lines(ref args, i) with !Mutate = if i >= len(args) {
  ""
} else {
  let one = render_tokens_for(args[i])
  if i == len(args) - 1 { one } else { "{one},\n{render_arg_lines(args, i + 1)}" }
}

fn render_node_list(ref nodes, sep) with !Mutate = render_node_list_from(nodes, 0, sep)

fn render_node_list_from(ref nodes, i, sep: String) with !Mutate = if i >= len(nodes) {
  ""
} else if i == len(nodes) - 1 {
  render_tokens_for(nodes[i])
} else {
  "{render_tokens_for(nodes[i])}{sep}{render_node_list_from(nodes, i + 1, sep)}"
}

fn render_pat_list(ref pats, sep) with !Mutate = render_pat_list_from(pats, 0, sep)

fn render_pat_list_from(ref pats, i, sep: String) = if i >= len(pats) {
  ""
} else if i == len(pats) - 1 {
  render_pat_tokens(pats[i])
} else {
  "{render_pat_tokens(pats[i])}{sep}{render_pat_list_from(pats, i + 1, sep)}"
}

// A parameter renders as it was written: its ownership marker, its pattern,
// the annotation when one was written, and the default. Dropping any of
// these on round-trip would change semantics the affine/refinement checks
// read.
fn render_param_list(ref params) with !Mutate = join(", ", map(render_one_param, params))

fn render_one_param(p) with !Mutate = render_param_body(param_of(p))

fn render_param_body(p) with !Mutate = render_param_typed(
  p,
  match p.ann {
    Some(a) => ": {render_type_tokens(ann_ty_of(a))}",
    None => "",
  }
)

// A parameter's head with its annotation as given — the one its author
// wrote, or the alias an accepted refinement restates it as.
fn render_param_typed(p, ann: String) with !Mutate = {
  let dflt = match p.dflt {
    Some(d) => " = {render_tokens_for(d)}",
    None => "",
  }
  "{ownership_marker(p.marker)}{render_pat_tokens(p.pat)}{ann}{dflt}"
}

// A declared fn's head and body.
fn render_fn_decl(name, params, retty, effs, body) with !Mutate = {
  let head = fn_head_text(name, render_param_list(params), graph_node_body(retty), effs)
  let b = render_grouped_body(body)
  if str_contains(b, "\n") || fits_inline("{head} {b}") {
    "{head} {b}"
  } else {
    "{head}\n{indent_block(b)}"
  }
}

// A declaration's head through its binder — the one shape the whole
// declaration's render and an accepted clause's splice share. `ann` is the
// return annotation itself (`render_retty`).
fn fn_head_text(name, plist, ann, effs) with !Mutate =
  "fn {name}({plist}){render_retty(ann, effs)}{render_with_clause(effs)} ="

// The head ALONE, for a reader that writes a declaration's signature back
// without its body.
fn render_fn_head(name, params, ann, effs) with !Mutate =
  fn_head_text(name, render_param_list(params), ann, effs)

// The arms of a declaration whose only parameter an arm-list literal
// minted — never a parameter an author named, since `fn f(o) = match o
// { … }` is written that way on purpose.
fn module_arm_list(params, body) = if len(params) == 1 && is_al_name(param_binder(params[0])) {
  arm_list_of(params, body)
} else {
  None
}

// The literal renders as the arms alone — the head it would otherwise
// carry is the wrapper this form exists to delete, and `match`'s own
// renderer is the one that draws arms. Inline when it fits, because the
// commonest literal is one short destructuring arm and spending six lines
// on `map({ (name, _) => name }, xs)` would trade a wrapper for a worse
// page.
fn render_arm_literal(arms) with !Mutate = {
  let one_line = "\{ {render_arm_list_inline(arms, 0)} \}"
  if !str_contains(one_line, "\n") && fits_inline(one_line) {
    one_line
  } else {
    "\{\n{indent_block(strip_trailing_nl(render_match_arms(arms, 0)))}\n\}"
  }
}

// The arm-list literal's own minted parameter, read back through
// `al_prefix`.
fn is_al_name(nm) = name_has_prefix(nm, al_prefix)

// The arms on ONE line — the literal's inline layout. A trailing comma is
// the multi-line form's separator discipline, not the inline one's.
fn render_arm_list_inline(arms, i) with !Mutate = if i >= len(arms) {
  ""
} else {
  let sep = if i == 0 { "" } else { ", " }
  match arms[i] {
    (pat, body) => "{sep}{render_comment_at(pat)}{render_pat_tokens(pat)} => {render_grouped_body(body)}{render_arm_list_inline(arms, i + 1)}",
  }
}

// ─── Precedence-inverse parenthesization ────────────────────────────
//
// The render is the parse's inverse under the ONE precedence table
// (SYNTAX §Operator precedence), so an operand whose own precedence is
// LOOSER than its parent's — or equal on the right of a left-assoc
// operator — re-wraps in the parens the parse consumed. Without this,
// (a + b) * c re-rendered as a + b * c: both typecheck, only behavior
// tells — the fmt gate runs the program pre/post and compares exits.
fn render_operand(child, parent_prec, is_right) with !Mutate = {
  let cp = expr_prec_of(child)
  if cp < parent_prec || cp == parent_prec && is_right {
    "({render_tokens_for(child)})"
  } else {
    render_tokens_for(child)
  }
}

// The head of a postfix form — a call's callee, a field read's receiver, an
// index's receiver. Postfix binds tighter than every operator, so the head
// re-wraps whenever it is anything but an atom. Rendered bare, the parse
// took the postfix onto the head's last operand: `(run() ~> hold).beta`
// came back as `run() ~> hold.beta`, an install of `hold.beta`, and fmt
// wrote it into three micros as "names conserved" (measured 2026-09-28).
fn render_postfix_head(head) with !Mutate = render_operand(head, 100, false)

fn expr_prec_of(node) = match graph_node_body(node) {
  NExpr(BinOpExpr(op, l, r)) => if zero_minus_literal(op, l, r) { 90 } else { binop_prec(op) },
  NExpr(PipeExpr(k, _, _)) => pipe_prec(k),
  NExpr(FanoutExpr(_)) => pipe_prec(fanout_distribute_kind),
  NExpr(UnaryOpExpr(_, _)) => 90,
  NExpr(IfExpr(_, _, _)) => 15,
  NExpr(MatchExpr(_, _)) => 15,
  // A binder lambda's body extends maximally rightward — as an operand it
  // must ALWAYS re-wrap, or the re-parse absorbs the operator into the body
  // (measured: the recurrence `((prev) => …) <~ delay(1)` rendered
  // paren-free, and pass 2 read `delay(1)(prev)` as an application).
  // Prec 0 sits below every operator, so render_operand wraps it in
  // every operand position. An arm list is its own delimiter — the braces
  // close it — so `{ prev => … } <~ delay(1)` renders bare, SYNTAX's own
  // canonical spelling of a recurrence.
  NExpr(LambdaExpr(params, body)) => match arm_list_of(params, body) {
    Some(_) => 100,
    None => 0,
  },
  _ => 100,
}

// The literal SYNTAX table integers (op_prec's own values — one table,
// this is its render-side projection).
fn binop_prec(op) with Pure = match op {
  BMul => 10,
  BDiv => 10,
  BMod => 10,
  BAdd => 9,
  BSub => 9,
  BConcat => 8,
  BLt => 7,
  BGt => 7,
  BLe => 7,
  BGe => 7,
  BEq => 6,
  BNe => 6,
  BAnd => 5,
  BOr => 4,
}

fn pipe_prec(k) with Pure = match k {
  PForward => 3,
  PFanout(_) => 2,
  PFeedback => 2,
  PTee => 1,
}

// ─── The totality helpers — one per structural form ─────────────────
//
// Interior comments are graph content (the weave attaches them to the
// following statement) — the block render carries each statement's prose
// or the formatter would destroy it. A trailing same-line comment
// re-renders as a leading block: movement, not loss, and stable from the
// second pass (it re-parses as a leading comment).
fn render_block_stmts(ref stmts, i) with !Mutate = if i >= len(stmts) {
  ""
} else {
  "{render_tokens_for(stmts[i])}\n{render_block_stmts(stmts, i + 1)}"
}

// The one interior-prose render — a node's attached comment as leading
// `//` lines at block indent (trailing attachments merged into the same
// cell render as leading: movement, never loss — the decl-comment
// contract at the interior altitude).
fn render_stmt_comment(n) with !Mutate = {
  let c = graph_comment_at(n)
  if c == "" { "" } else { "//{replace(c, "\n", "\n//")}\n" }
}

// A record's braces: inline when the whole literal fits and no field carries
// prose, else one field per line — the CallExpr arguments' law at the record
// altitude. A record never broke before, so a fourteen-field literal rendered
// as one 300-column line. `lead` is an update's `...base`, first on either
// layout ("" for a literal).
fn render_record(fields: [(String, Node)], lead: String) with !Mutate = if len(fields) == 0 {
  "\{{lead}\}"
} else {
  let inits = fields |> map(field_init) |> join(", ", ??)
  let inline = if lead == "" { "\{{inits}\}" } else { "\{{lead}, {inits}\}" }
  if fits_inline(inline) && !any(field_carries_prose, fields) {
    inline
  } else {
    // one field per line, each closed by its comma — SYNTAX §«Records»' own
    // multi-line layout, so a field added at the end is a one-line diff
    let lines = fields |> map(field_line) |> join("\n", ??)
    let body = if lead == "" { lines } else { "{lead},\n{lines}" }
    "\{\n{indent_block(body)}\n\}"
  }
}

// A field as a literal writes it: its name alone when the value is the
// variable of that name (SYNTAX's field punning), else `name: value`.
fn field_init(field) with !Mutate = match field {
  (fname, v) => if field_puns(fname, v) { fname } else { "{fname}: {render_tokens_for(v)}" },
}

fn field_line(field) with !Mutate = "{field_init(field)},"

// A value that is the variable its field is named for, as the variable
// renders, with no prose of its own to carry.
fn field_puns(fname, v) = match graph_node_body(v) {
  NExpr(VarRef(n)) => ref_spelling(v, n) == fname && graph_comment_at(v) == "",
  other => false,
}

fn field_carries_prose(field) = match field {
  (fname, v) => graph_comment_at(v) != "",
}

fn render_string_parts(ref parts, i) with !Mutate = if i >= len(parts) {
  ""
} else {
  let one = match graph_node_body(parts[i]) {
    NExpr(LitString(s)) => str_escape(s),
    // The splice's ShowExpr wrap is invisible surface — the braces
    // render the INNER (render∘parse fixpoint over the wrap).
    NExpr(ShowExpr(inner)) => "\{{render_tokens_for(inner)}\}",
    _ => "\{{render_tokens_for(parts[i])}\}",
  }
  "{one}{render_string_parts(parts, i + 1)}"
}

// An if-branch is braced by the IF SURFACE itself (the header rule: the
// condition ends at `{`), and the parser wraps a braced branch in a
// BlockExpr — so the render supplies the braces EXACTLY ONCE (render∘parse
// identity, the fmt census's blocker 3): a statement-carrying block takes
// the multi-line block render (its own braces); a single-expression block
// takes the single-line braced form — never literal braces AROUND the
// block render, which accreted a wrap per pass until the inner `\{ x \}`
// re-parsed as the record pun `\{x: x\}`, a float becoming a record; an
// else-if chain renders bare (`else if …`, never `else \{ if … \}`); a
// brace-less branch (the parse_expr arm) gains the canonical braces.
// The overflow form: every branch takes its brace block and the chain
// stays cuddled (`} else {`, `} else if c {`) — SYNTAX's own chase_node
// shape. A prose-carrying else keeps the line-broken form render_else
// already emits.
fn render_branch_block(n) with !Mutate = match graph_node_body(n) {
  NExpr(BlockExpr(_, _)) => render_tokens_for(n),
  _ => match let_born(n) {
    Some(_) => render_tokens_for(n),
    None => "\{\n{indent_block(render_grouped_body(n))}\n\}",
  },
}

// The else-if DESTRUCTURES its child node and renders the pieces, so the
// child's uniform emission never fires — its attached prose emits here,
// uncuddling the chain at exactly the prose-carrying link.
fn render_else_block(el) with !Mutate = match graph_node_body(el) {
  NExpr(LitUnit) => "",
  NExpr(IfExpr(c2, t2, e2)) => {
    let core = "else if {render_tokens_for(c2)} {render_branch_block(t2)}{render_else_block(e2)}"
    let ec = graph_comment_at(el)
    if ec == "" { " {core}" } else { "\n//{replace(ec, "\n", "\n//")}\n{core}" }
  },
  _ => " else {render_branch_block(el)}",
}

fn render_if_branch(n) with !Mutate = match graph_node_body(n) {
  // Attached prose forces the block layout — a comment needs its own
  // line, and the single-line form would drop it (measured: the
  // if-branch finals were the interior-prose loss's biggest residue).
  NExpr(BlockExpr(stmts, final)) => if len(stmts) == 0 && graph_comment_at(final) == "" {
    "\{ {render_tokens_for(final)} \}"
  } else {
    render_tokens_for(n)
  },
  NExpr(IfExpr(_, _, _)) => render_tokens_for(n),
  _ => match let_born(n) {
    Some(_) => render_tokens_for(n),
    None => "\{ {render_tokens_for(n)} \}",
  },
}

// The implicit else is the parser's own unit node — rendering it back
// would add `else \{ () \}` to every authored else-less if; omitting it is
// the identity (the re-parse re-inserts the same unit node).
fn render_else(el) with !Mutate = match graph_node_body(el) {
  NExpr(LitUnit) => "",
  _ => " else {render_if_branch(el)}",
}

// ─── Reindent-on-compose — the depth engine's one primitive ─────────
//
// Every interior renders at depth ZERO; each enclosing block indents its
// WHOLE interior exactly once at composition. Depth is therefore never
// threaded and never wrong: nesting depth IS composition depth (the old
// fixed two-space literals rendered a nested match's arms at column 2
// regardless of depth).
fn indent_block(s) = "  {replace(s, "\n", "\n  ")}"

// The fits-or-breaks rule: an inline render survives when it is one line
// within the budget; otherwise the construct takes its block layout. The
// budget measures at depth zero (reindent-on-compose means a render never
// knows its depth) — deep code runs a few columns wider, the honest
// approximation until the layout engine threads exact width.
fn fits_inline(s) -> Bool = byte_len(s) <= 100 && !str_contains(s, "\n")

fn strip_trailing_nl(s) = {
  let n = byte_len(s)
  if n > 0 && byte_at(s, n - 1) == 10 { str_slice(s, 0, n - 1) } else { s }
}

// A body-lead position: fn, lambda, arm and let bodies route here. A record
// literal or update renders bare, because every brace slot reads its `{`
// through the parser's one discrimination (`brace_form`); until
// 2026-09-28 a fn body read a leading `{` as a block alone, so this wrapped
// a body record in parens the parser then consumed — the formatter
// projecting the parser's gap onto every page.
fn render_grouped_body(node) with !Mutate = match graph_node_body(node) {
  // The E_RedundantBraces format-lift, at the ONE altitude where braces
  // are genuinely optional (fn/lambda/arm/let bodies route here): a
  // stmt-less block IS its final expression, and emitting its braces
  // re-minted the lint on the canonical page (measured: 1654 warnings
  // on the first whole-wheel sweep). Brace-mandatory positions are safe
  // by composition — render_branch_block and the block final add their
  // own braces AROUND this result, exactly once. A block carrying its
  // own attached prose keeps the braces: the prose's anchor.
  NExpr(BlockExpr(stmts, final)) => if len(stmts) == 0 && graph_comment_at(node) == "" {
    render_grouped_body(final)
  } else {
    render_tokens_for(node)
  },
  // drift-audit: ignore — the brace-lead expr forms and the stmt-less block are the enumerated classes; everything else renders unwrapped by design
  _ => render_tokens_for(node),
}

fn render_match_arms(ref arms, i) with !Mutate = if i >= len(arms) {
  ""
} else {
  match arms[i] {
    (pat, body) => "{render_comment_at(pat)}{render_pat_tokens(pat)} => {render_grouped_body(body)},\n{render_match_arms(arms, i + 1)}",
  }
}

fn render_resume_head(v) with !Mutate = match graph_node_body(v) {
  NExpr(LitUnit) => "resume()",
  _ => "resume({render_tokens_for(v)})",
}

fn render_state_updates(ref updates: [{init: Node, name: Node}], i) with !Mutate = if i >= len(updates) {
  ""
} else {
  let u = updates[i]
  let one = "{ref_spelling(state_field_node(u), state_field_name(u))} = {render_tokens_for(u.init)}"
  let lead = if i == 0 { " with " } else { ", " }
  "{lead}{one}{render_state_updates(updates, i + 1)}"
}

fn render_let_ann(ann) with !Mutate = match graph_node_body(ann) {
  NTypeAnn(ty) => ": {render_type_tokens(ty)}",
  // drift-audit: ignore — the ADT's own absence sentinel: LetStmt's ann node is LitUnit when unannotated (the LetStmt decl comment); any non-NTypeAnn body IS that absence, rendered as no clause
  _ => "",
}

// The record a nominal record type IS: a lone variant named as its type,
// its one payload a record, is what SYNTAX writes `type X = {f: T, …}`.
// Both spellings parse to that one variant, so the render writes the
// documented one — until 2026-10-09 it wrote `type X = X({f: T, …})`, the
// redundant spelling principle 2 rejects. A variant carrying prose of its
// own keeps the variant line the prose stands above.
fn nominal_record_of(name, variants) = match variants {
  [(vname, [TRecord(fields)], cn)] => if vname == name && graph_comment_at(cn) == "" { Some(fields) } else { None },
  others => None,
}

// A record type's braces follow a record literal's law: inline when the
// declaration fits the line, else one field per line, each closed by its
// comma.
fn render_record_decl(name, fields) with !Mutate = {
  let inline = "type {name} = {render_type_tokens(TRecord(fields))}"
  if fits_inline(inline) {
    inline
  } else {
    "type {name} = \{\n{indent_block(fields |> map(record_type_field_line) |> join("\n", ??))}\n\}"
  }
}

fn record_type_field_line(field) with !Mutate = match field {
  (fname, ty) => "{fname}: {render_type_tokens(ty)},",
}

// A commented variant set renders VERTICAL (prose above each variant,
// `=`/`|` leading); a prose-free set keeps the inline ` | ` join.
fn render_variants(ref variants, i) with !Mutate = if variants_carry_prose(variants, 0) {
  "\n{indent_block(render_variants_vertical(variants, 0))}"
} else {
  let inline = " = {render_variants_inline(variants, i)}"
  if fits_inline(inline) { inline } else { "\n{indent_block(render_variants_vertical(variants, 0))}" }
}

fn variants_carry_prose(ref variants, i) = if i >= len(variants) {
  false
} else {
  match variants[i] {
    (_, _, cn) => if graph_comment_at(cn) == "" { variants_carry_prose(variants, i + 1) } else { true },
  }
}

fn render_variants_inline(ref variants, i) with !Mutate = if i >= len(variants) {
  ""
} else {
  match variants[i] {
    (vname, tys, _) => {
      let one = if len(tys) == 0 { vname } else { "{vname}({render_ty_list(tys)})" }
      if i == len(variants) - 1 { one } else { "{one} | {render_variants_inline(variants, i + 1)}" }
    },
  }
}

fn render_variants_vertical(ref variants, i) with !Mutate = if i >= len(variants) {
  ""
} else {
  match variants[i] {
    (vname, tys, cn) => {
      let one = if len(tys) == 0 { vname } else { "{vname}({render_ty_list(tys)})" }
      let lead = if i == 0 { "=" } else { "|" }
      let tail = if i == len(variants) - 1 { "" } else { "\n{render_variants_vertical(variants, i + 1)}" }
      "{render_stmt_comment(cn)}{lead} {one}{tail}"
    },
  }
}

// ─── The SURFACE-type projection — the parse's inverse over authored type
// syntax: the one renderer every surface shares (`render_ty`), under the
// authored face. A row renders only what an author wrote (present and
// `!absent`), because a bare parse-minted tail IS authored absence; a free
// variable has no spelling on a page and renders as its forensic handle,
// loud in fmt's own re-parse; a predicate a type carries renders through
// its projection's inverse (`render_predicate_tokens`), never the voice's
// compression, and a refinement's declaration renders its expression.
fn render_type_tokens(ty) with !Mutate = render_ty(ty) ~> authored_names(render_predicate_tokens)

// The formatter's OWN predicate projection — the parse's inverse, never
// the voice: show_predicate compresses a call operand to `(...)` (the
// diagnostic register's economy), and a page rendered through it
// destroyed the authored refinement — `len(self)` became `len(...)`, a
// parse break the render register then scoped out of the user's stderr
// (the whole-weave fan collapse this projection exists to prevent). An
// operand is a node HANDLE: read its body live, render through the
// total token render; the cmp glyph is binop_to_str, total by match.
fn render_predicate_tokens(pred) with !Mutate = match pred {
  PTrue => "true",
  PCompare(op, a, b) => "{render_pred_node(a)} {binop_to_str(op)} {render_pred_node(b)}",
  PAnd(a, b) => "{render_pred_grouped(a, 5, false)} && {render_pred_grouped(b, 5, true)}",
  POr(a, b) => "{render_pred_grouped(a, 4, false)} || {render_pred_grouped(b, 4, true)}",
  PNot(p) => "!{render_pred_grouped(p, 90, false)}",
  PBoolNode(n) => render_pred_node(n),
  // The non-surface predicates (inference-minted narrowing, partiality,
  // provisions) have no parseable spelling; the voice is their only
  // projection, and the fmt verb's own reparse refuses loudly if one ever
  // reaches a page.
  PPatternMatch(p, n) => show_predicate(PPatternMatch(p, n)),
  PWithSelf(_, inner) => render_predicate_tokens(inner),
  PTotalDiv(op, a, b) => show_predicate(PTotalDiv(op, a, b)),
  PInBounds(recv, idx) => show_predicate(PInBounds(recv, idx)),
  PProvides(provided) => show_predicate(PProvides(provided)),
}

// Precedence-inverse at the predicate altitude — render_operand's rule
// on the predicate tree: a child strictly looser than its parent (or a
// right child at the same tier) re-wraps in the parens the parse consumed.
fn render_pred_grouped(pred, parent_prec, is_right) with !Mutate = {
  let cp = pred_prec(pred)
  if cp < parent_prec || cp == parent_prec && is_right {
    "({render_predicate_tokens(pred)})"
  } else {
    render_predicate_tokens(pred)
  }
}

fn pred_prec(pred) with Pure = match pred {
  PCompare(op, _, _) => binop_prec(op),
  PAnd(_, _) => 5,
  POr(_, _) => 4,
  _ => 90,
}

fn render_pred_node(h) with !Mutate = render_body_tokens(h, graph_node_body(h))

fn render_ty_list(tys) with !Mutate = join(", ", map(render_type_tokens, tys))

fn render_effect_ops(ref ops: [(String, [TParam], Ty, Node)], i) with !Mutate = if i >= len(ops) {
  ""
} else {
  match ops[i] {
    (oname, params, rty, cnode) => {
      let ret = match rty {
        TUnit => "",
        t => " -> {render_type_tokens(t)}",
      }
      "{render_stmt_comment(cnode)}{oname}({join(", ", map(render_op_param, params))}){ret}\n{render_effect_ops(ops, i + 1)}"
    },
  }
}

// An op's parameter as the author wrote it: `msg: String` named, the bare
// type where the op wrote one (the wildcard `_`, a function type's own
// spelling for a parameter with no name).
fn render_op_param(p) with !Mutate = if param_name(p) == "_" {
  render_type_tokens(param_ty(p))
} else {
  "{param_name(p)}: {render_type_tokens(param_ty(p))}"
}

// Config is [TParam] — render each field as `name` or `name = default`
// (the product's default is authored surface, carried back verbatim;
// format∘parse identity over SYNTAX §«Default parameter values»).
// An effect's instance parameters and a handler's config parameters are
// parameters, and render as one: `render_one_param` carries the marker, the
// authored annotation and the default. Until 2026-09-28 this head had its own
// copy that rendered the name and the default alone, so `mentl fmt` deleted
// every annotation it met here — `effect Sample(rate: Int)` became `effect
// Sample(rate)`, and the declared `Sample(48000)` then refused against a bare
// variable.
fn render_config_params(ref config) with !Mutate =
  if len(config) == 0 { "" } else { "({render_param_list(config)})" }

// Both handler renders read through the TYPED closed projections
// (state_field_name/init, handler_arm_op_name/args/body — parser.mn's own
// accessors): the bare field reads on the open records computed offsets
// over the partial demanded set and the emitter floored every handler
// decl (the fmt census's blocker 2; the cure existed and was bypassed).
fn render_state_inits(ref states, i) with !Mutate = if i >= len(states) {
  ""
} else {
  let st = states[i]
  let one = "{state_field_name(st)} = {render_tokens_for(state_field_init(st))}"
  let lead = if i == 0 { " with " } else { ", " }
  "{lead}{one}{render_state_inits(states, i + 1)}"
}

// A handler's `with` is one slot read by position (SYNTAX §«With-clauses»):
// its own effect row when it authors one, else its state inits — the
// parse's inverse over what the node carries.
fn render_handler_clause(effs, states) with !Mutate =
  if len(effs) > 0 { " with {render_authored_row(effs)}" } else { render_state_inits(states, 0) }

fn render_handler_arms(ref arms, i) with !Mutate = if i >= len(arms) {
  ""
} else {
  let a = arms[i]
  let op = ref_spelling(handler_arm_op(a), handler_arm_op_name(a))
  "{op}({render_param_list(handler_arm_args(a))}) => {arm_head_prose(a)}{render_grouped_body(handler_arm_body(a))},\n{render_handler_arms(arms, i + 1)}"
}

// The prose an arm's head carries, written where its body's prose goes,
// after the `=>`. A run on the arm's line or above it lands on the widest
// node the line starts past the op's name — the first parameter, where the
// arm has one.
fn arm_head_prose(a) =
  handler_arm_args(a) |> flat_map(param_prose_homes) |> map(render_comment_at) |> join("", ??)

fn param_prose_homes(p) = [p, param_pat(p)]

// A label as the name of the parameter its slot fills, read through the
// call's product and its callee's edge, so a renamed parameter's labels
// follow it; a label the judgment placed nowhere writes the name it holds.
fn label_spelling(node, label: String, v) = match graph_parent_of(node) {
  Some(call) => match call_slot_param(call, v) {
    Some(p) => match decl_spelling(param_pat(p)) {
      Some(s) => s,
      None => label,
    },
    None => label,
  },
  None => label,
}

// The parameter node whose slot a value fills in a call's product.
fn call_slot_param(call, v) = match graph_product_at(call) {
  ProductOf(slots, _, _) => match call_callee_decl(call) {
    Some(d) => map_option(slot_param, find(slot_is(v, ??), zip(slots, callee_params(d)))),
    None => None,
  },
  NoProduct => None,
}

fn slot_is(v, pair) = match pair {
  (s, _) => s == v,
}

fn slot_param(pair) = match pair {
  (_, p) => p,
}

fn call_callee_decl(call) = match graph_node_body(call) {
  NExpr(CallExpr(f, _)) => graph_ref_decl(f),
  NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => None,
}

// The parameter nodes a callee's declaration holds: a function's, a
// handler's configuration, or the function literal a let binds.
fn callee_params(d) = match graph_node_body(d) {
  NStmt(FnStmt(_, ps, _, _, _)) => ps,
  NStmt(HandlerDeclStmt(_, _, cfg, _, _, _)) => cfg,
  NPat(_) => bound_literal_params(d),
  NStmt(_)
  | NExpr(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => [],
}

fn bound_literal_params(b) = match graph_parent_of(b) {
  Some(s) => match graph_node_body(s) {
    NStmt(LetStmt(_, value, _)) => literal_params(value),
    NStmt(_)
    | NExpr(_)
    | NPat(_)
    | NHole(_)
    | NModule(_)
    | NLink(_)
    | NTypeAnn(_)
    | NName(_)
    | NRow(_)
    | NParam(_) => [],
  },
  None => [],
}

fn literal_params(value) = match graph_node_body(value) {
  NExpr(LambdaExpr(ps, _)) => ps,
  NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => [],
}

fn render_lit_value(lv) = match lv {
  LVInt(n) => int_to_str(n),
  LVFloat(f) => float_literal_text(f),
  LVString(s) => "\"{str_escape(s)}\"",
  LVBool(b) => if b { "true" } else { "false" },
}

// `0 - <literal>` is unary minus spelled as a subtraction (SYNTAX principle
// 2): the render writes `-<literal>` wherever the literal's own kind makes the
// two one value. An Int is exact at every literal — negation IS `0 - x` in
// the word. A Float is exact at every literal but zero: `0.0 - 0.0` is +0.0
// and `-(0.0)` is -0.0, so that one keeps its subtraction. Over a variable
// the kind needs the judgment, which fmt does not run — that rewrite is
// tighten's, and a Float variable's is MaybeIncorrect for the same zero.
// The census reads this one predicate for the `0` it lifts (`lifted_atoms`).
fn zero_minus_literal(op, l, r) = match op {
  BSub => match graph_node_body(l) {
    NExpr(LitInt(0)) => match graph_node_body(r) {
      NExpr(LitInt(_)) => true,
      _ => false,
    },
    NExpr(LitFloat(z)) => match graph_node_body(r) {
      NExpr(LitFloat(f)) => z == 0.0 && f != 0.0,
      _ => false,
    },
    _ => false,
  },
  _ => false,
}

// The lift as the render takes it: never across prose, which rides the
// operand it is attached to.
fn lifts_zero_minus(op, l, r) =
  zero_minus_literal(op, l, r) && graph_comment_at(l) == "" && graph_comment_at(r) == ""

// ─── The stated equivalences — what a lift removes, and what still carries it
//
// The census is a multiset: a canonicalization that removes an atom would
// read as a loss — the second `import verify` leaves one `verify` unpaid, a
// lifted `0 - 5` one `0`. Each lift therefore STATES what it removes, read off
// the parse it was rendered from, and the census counts each stated atom as
// present: a dropped duplicate import is carried by the import of the same
// module the parse kept; a lifted zero by the negation it became. A real loss
// is still a loss, since nothing else is stated. The parse's nodes are the
// handles it minted, [from, to); `kept` is the statement list it returned.
fn lifted_atoms(from, to, kept) = flat_map(lifted_at(kept, ??), range_list(from, to))

fn lifted_at(kept, h) = match graph_node_body(h) {
  NStmt(ImportStmt(path)) => if any(has_handle(h, ??), kept) { [] } else { path_atoms(path) },
  NExpr(BinOpExpr(op, l, r)) => if lifts_zero_minus(op, l, r) {
    match graph_node_body(l) {
      NExpr(LitInt(_)) => ["#0"],
      _ => ["#{float_to_str(0.0)}"],
    }
  } else {
    []
  },
  // `type X = X({f: T})` renders as `type X = {f: T}`: the variant's name is
  // carried by the type's, which is the same name
  NStmt(TypeDefStmt(name, variants)) => match nominal_record_of(name, variants) {
    Some(fields) => [name],
    None => [],
  },
  // `{at: at}` renders as `{at}`: the value's name is carried by the field's
  NExpr(MakeRecordExpr(fields)) => punned_names(fields),
  NExpr(NamedRecordExpr(head, fields)) => punned_names(fields),
  NExpr(RecordUpdateExpr(base, fields)) => punned_names(fields),
  // `b @ C(_) | b @ D` renders as `b @ (C(_) | D)`: the binder is written once
  // for branches the parse read it on each of
  NExpr(MatchExpr(_, arms)) => flat_map(arm_grouped_binders, arms),
  _ => [],
}

fn arm_grouped_binders(arm) = match arm {
  (pat, _) => match pat_of(pat) {
    PAlt(ps) => match binder_of_branches(ps) {
      Some((name, inners)) => map({ _ => name }, range_list(1, len(inners))),
      None => [],
    },
    _ => [],
  },
}

fn punned_names(fields) = fields |> filter(field_puns_entry) |> map(field_name_of)

fn field_puns_entry(field) = match field {
  (fname, v) => field_puns(fname, v),
}

fn field_name_of(field) = match field {
  (fname, v) => fname,
}

fn has_handle(h, stmt) = stmt == h

// An import path's atoms — its segments, each a name the lexer reads.
fn path_atoms(path: String) = path_atoms_from(path, 0, 0, [])

fn path_atoms_from(path: String, i, start, acc) = if i >= byte_len(path) {
  push(acc, str_slice(path, start, i))
} else if byte_at(path, i) == 47 {
  path_atoms_from(path, i + 1, i + 1, push(acc, str_slice(path, start, i)))
} else {
  path_atoms_from(path, i + 1, start, acc)
}

fn range_list(from, to) = range_from(from, to, [])

fn range_from(i, to, acc) = if i >= to { acc } else { range_from(i + 1, to, push(acc, i)) }

// A negative word as the unsigned decimal it wraps from, n + 2^32, computed
// in halves so no step leaves the word: 2^32 + n = 2^31 + a with
// a = n + 2^31, and 2^31 = 214748364 * 10 + 8.
fn unsigned_word_text(n) = {
  let a = n + 2147483647 + 1
  let low = a % 10 + 8
  "{int_to_str(214748364 + a / 10 + low / 10)}{int_to_str(low % 10)}"
}

// A float as a literal the lexer reads back. The voice renders a small or
// large magnitude in scientific form (`1.0e-5`), which no Mentl literal
// spells, so a page rendered through it did not re-lex: `0.00001` came back
// as `1.0e-5`, three tokens, and the conservation gate refused the file
// (measured 2026-09-28 on tests/frontier/derive-crucible). Moving the point
// is exact — the digits are the same faithful run, so the literal parses to
// the same value.
fn float_literal_text(f) = {
  let s = float_to_str(f)
  match byte_index_from(s, 101, 0) {
    None => s,
    Some(e) => if byte_at(s, 0) == 45 {
      "-{fixed_of_scientific(str_slice(s, 1, e), signed_int_of(str_slice(s, e + 1, byte_len(s))))}"
    } else {
      fixed_of_scientific(str_slice(s, 0, e), signed_int_of(str_slice(s, e + 1, byte_len(s))))
    },
  }
}

fn fixed_of_scientific(mantissa: String, exp) = {
  let dot = match byte_index_from(mantissa, 46, 0) {
    Some(d) => d,
    None => byte_len(mantissa),
  }
  let digits =
    str_slice(mantissa, 0, dot) ++ str_slice(mantissa, min(dot + 1, byte_len(mantissa)), byte_len(mantissa))
  let point = dot + exp
  let n = byte_len(digits)
  if point <= 0 {
    trim_fraction_zeros("0.{float_zero_pad(0 - point)}{digits}")
  } else if point >= n {
    "{digits}{float_zero_pad(point - n)}.0"
  } else {
    trim_fraction_zeros("{str_slice(digits, 0, point)}.{str_slice(digits, point, n)}")
  }
}

// Trailing zeros after the point are no digit of the value; one stays, so
// the literal keeps its point.
fn trim_fraction_zeros(s: String) = {
  let n = byte_len(s)
  if n >= 2 && byte_at(s, n - 1) == 48 && byte_at(s, n - 2) != 46 {
    trim_fraction_zeros(str_slice(s, 0, n - 1))
  } else {
    s
  }
}

fn signed_int_of(s: String) = if byte_len(s) > 0 && byte_at(s, 0) == 45 {
  0 - digits_value(s, 1, 0)
} else if byte_len(s) > 0 && byte_at(s, 0) == 43 {
  digits_value(s, 1, 0)
} else {
  digits_value(s, 0, 0)
}

fn digits_value(s: String, i, acc) =
  if i >= byte_len(s) { acc } else { digits_value(s, i + 1, acc * 10 + (byte_at(s, i) - 48)) }

fn byte_index_from(s: String, b, i) = if i >= byte_len(s) {
  None
} else if byte_at(s, i) == b {
  Some(i)
} else {
  byte_index_from(s, b, i + 1)
}

fn render_plist_inner(ref ps, rest) = {
  let prefix = render_pat_list(ps, ", ")
  match rest {
    Some(r) => if len(ps) == 0 { "...{render_pat_tokens(r)}" } else { "{prefix}, ...{render_pat_tokens(r)}" },
    None => prefix,
  }
}

fn render_pat_fields(ref fields, i) = if i >= len(fields) {
  ""
} else {
  match fields[i] {
    (fname, p) => {
      // Punning is the canonical form when the pattern binds the field's
      // own name (SYNTAX §records).
      let one = match pat_of(p) {
        PVar(n) => if n == fname { fname } else { "{fname}: {n}" },
        _ => "{fname}: {render_pat_tokens(p)}",
      }
      if i == len(fields) - 1 { one } else { "{one}, {render_pat_fields(fields, i + 1)}" }
    },
  }
}

// The declared with-clause — and a named row's right side, and a handler's
// `with` — rendered from the parser's SIGNED TERMS verbatim. The authored
// surface is the only faithful render: a closed-row rebuild cannot represent
// `-` / `&` connectors, per-term `!`, or a group.
fn render_with_clause(effs) with !Mutate =
  if len(effs) == 0 { "" } else { " with {render_authored_row(effs)}" }

// A row as its author wrote it, under the authored face.
fn render_authored_row(effs) with !Mutate =
  render_written_row(effs) ~> authored_names(render_predicate_tokens)

// An authored effect name — the one name renderer (`render_eff_name`, the
// voice's and the page's alike) under the authored face.
fn render_authored_eff_name(name) with !Mutate =
  render_eff_name(name) ~> authored_names(render_predicate_tokens)

// An authored `-> RetTy` carries back verbatim (the fmt census's blocker
// 4: the discarded binder silently dropped 91 authored heads); the absent
// annotation renders nothing. It takes the annotation it renders — the
// body at a declaration's return node, or the contract an accepted
// suggestion writes — never a node, so nothing stands at a handle no cell
// owns.
// A function-typed return before the head's own `with` keeps the parens
// that group it: the type grammar's `with` is greedy, so without them the
// head's clause re-parses as the returned function's row. An explicit
// `-> ()` is the unit return written out, which SYNTAX's unit-return rule
// omits.
fn render_retty(ann, effs) with !Mutate = match ann {
  NTypeAnn(TUnit) => "",
  NTypeAnn(ann_ty) => match ann_ty {
    TFun(_, _, _) => if len(effs) > 0 {
      " -> ({render_type_tokens(ann_ty)})"
    } else {
      " -> {render_type_tokens(ann_ty)}"
    },
    _ => " -> {render_type_tokens(ann_ty)}",
  },
  // drift-audit: ignore — the documented absent-annotation contract (an inferred return renders no clause)
  _ => "",
}

// Canonical indent depth per node kind. Match-arm bodies +2; let-
// value at same indent as let; fn body +2 from fn signature; etc.
// Each kind's indent is the PARENT's indent + verb-class offset.
fn render_indent_for(kind) = spaces(canonical_indent_depth(kind))

fn render_line_break_after(kind) with Pure = match kind {
  NStmt(_) => "\n",
  NExpr(_) => "",
  NPat(_) => "",
  NHole(_) => "",
  NModule(_) => "\n",
  NLink(_) => "\n",
  NTypeAnn(_) => "",
  NName(_) => "",
  NRow(_) => "",
  NParam(_) => "",
}

// The one comment, read LIVE from the comment weave at the node's handle
// (graph_comment_at) — never a copied string. The weave stores the prose with
// leading // stripped, contiguous lines joined by \n; render restores the //
// prefix on every line (re-prefixing each internal newline via `replace`) and a
// trailing newline so the block leads the declaration. Empty string when the
// node carries no comment (an honest read, not a stub).
fn render_comment_at(h) with !Mutate = {
  let text = graph_comment_at(h)
  if text == "" { "" } else { "//{replace(text, "\n", "\n//")}\n" }
}

fn ast_top_level_stmts(ast) with Pure = ast

fn canonical_indent_depth(kind) with Pure = match kind {
  NStmt(_) => 0,
  NExpr(_) => left_edge_indent(),
  // drift-audit: ignore — non-stmt/expr kinds sit at left edge; depth 0 IS their canonical indent, not a fabricated default
  _ => 0,
}

// The unary operator glyph per SYNTAX.md — `-` negate, `!` logical-not.
fn unary_op_glyph(op) with Pure = match op {
  UNeg => "-",
  UNot => "!",
}

// ─── The conservation census — what a render may never lose ─────────
//
// THE NAME CENSUS a rendered text answers to: the render's identifiers and
// literals counted, then SPENT against the source's, and every source atom
// left unpaid is a loss. A multiset rather than a sequence, because the
// canonical render reorders on purpose (record fields sort at parse), and a
// count rather than a set, because a render that keeps one of two uses of a
// name has still lost one. A literal is keyed by its VALUE — `48_000` and `48000` are
// one atom — so a spelling the render changes is not a loss here; that one
// is `Hβ.fmt.literal-spelling-is-intent`. Homed beside the formatter
// because it is the formatter's law: the fmt verb's write and an accepted
// clause's splice both answer to it. An edit that replaces a written name
// with one that states it counts each name in `stated` as present once — an
// accepted refinement over `n: Int` writes `n: NonZero`, and `Int` survives
// as the base NonZero's own declaration names (D4). Nothing else is admitted.
fn lost_atoms_beside(src_toks, out_toks, stated: [String]) = match fold(
  (fold(fold(smap_new(), atom_counted, out_toks), key_counted, stated), []),
  atom_spent,
  src_toks
) {
  (_, lost) => lost,
}

fn atom_counted(counts, t) = match atom_key(t) {
  Some(k) => key_counted(counts, k),
  None => counts,
}

fn key_counted(counts, k: String) = smap_add(counts, k, atom_count(counts, k) + 1)

fn atom_spent(acc, t) = match acc {
  (counts, lost) => match atom_key(t) {
    Some(k) => {
      let c = atom_count(counts, k)
      if c > 0 { (smap_add(counts, k, c - 1), lost) } else { (counts, push(lost, t)) }
    },
    None => acc,
  },
}

fn atom_count(counts, k: String) = match smap_get(counts, k) {
  Some(c) => c,
  None => 0,
}

// What an authored token says, as the census compares it: a name as itself,
// a literal by its value under a kind mark, so a name and a string that spell
// it are two atoms. Keywords and punctuation are the render's to choose.
fn atom_key(t) = match token_kind(t) {
  TIdent(s) => Some(s),
  TIntLit(n) => Some("#{int_to_str(n)}"),
  TFloatLit(f) => Some("#{float_to_str(f)}"),
  TStringPart(s) => Some("\"{s}"),
  _ => None,
}

// ─── A literal's authored spelling — intent the source holds ─────────
//
// A numeric literal's radix and digit grouping are the author's: `48_000`,
// `0x811C9DC5` and `0.00001` each say something `48000`, `-2128831035` and
// a shortest decimal do not. The parse keeps the value and drops the lexeme,
// so a render written from the parse alone spelled every literal by value —
// Pulse's prose said `Sample(48_000)` over code fmt had rewritten to
// `Sample(48000)`. This pass gives each rendered literal its authored
// spelling back: the source's numeric literals, keyed as the census keys
// them (kind and value), queued in source order, and each rendered literal of
// a key takes the next one. A spelling of the same key always re-lexes to the
// same value, so the swap is exact by construction; a key the render holds
// more often than the source keeps its value spelling for the extra ones.
// One pass serves every position a literal can stand in — an expression, a
// pattern, an effect's instance argument — because it reads the text both
// sides lex to, not the tree.
fn respell(src: String, out: String) = {
  let authored =
    fold(smap_new(), spelling_queued, flat_map(literal_spelled(src, line_starts(src), ??), lex(src)))
  let rendered = flat_map(literal_spelled(out, line_starts(out), ??), lex(out))
  match fold((authored, smap_new(), []), literal_swap, rendered) {
    (_, _, swaps) => splice_swaps(out, swaps, 0, 0, ""),
  }
}

// A numeric literal token as (its census key, its byte range, its text).
fn literal_spelled(text: String, starts, t) = match numeric_key(t) {
  Some(k) => match span_range(starts, token_span(t)) {
    (s, e) => [(k, (s, e), str_slice(text, s, e))],
  },
  None => [],
}

fn spelling_queued(m, lit) = match lit {
  (k, _, spelled) => smap_add(m, k, push(spellings_of(m, k), spelled)),
}

fn numeric_key(t) = match token_kind(t) {
  TIntLit(_) => atom_key(t),
  TFloatLit(_) => atom_key(t),
  _ => None,
}

fn spellings_of(m, k: String) = match smap_get(m, k) {
  Some(q) => q,
  None => [],
}

// The render's literal takes the next authored spelling of its key.
fn literal_swap(acc, lit) = match acc {
  (authored, used, swaps) => match lit {
    (k, range, now) => {
      let i = atom_count(used, k)
      let q = spellings_of(authored, k)
      if i >= len(q) {
        acc
      } else {
        let spelled = q[i]
        let used_next = smap_add(used, k, i + 1)
        if spelled == now {
          (authored, used_next, swaps)
        } else {
          (authored, used_next, push(swaps, (range, spelled)))
        }
      }
    },
  },
}

// The rendered text with each swapped range replaced, in offset order.
fn splice_swaps(out: String, swaps, i, from, acc) = if i >= len(swaps) {
  acc ++ str_slice(out, from, byte_len(out))
} else {
  match swaps[i] {
    ((s, e), spelled) => splice_swaps(out, swaps, i + 1, e, acc ++ str_slice(out, from, s) ++ spelled),
  }
}

// A token's byte range from its span: lines count from 1, columns from 1,
// and the end column is one past the last byte.
fn span_range(starts, sp) = match sp {
  Span(l, c, el, ec) => (starts[l - 1] + c - 1, starts[el - 1] + ec - 1),
}

// One TComment token per authored prose line — the lexical census the
// conservation gate reads on both sides of a round trip.
fn count_comment_tokens(tokens, i, acc) = if i >= len(tokens) {
  acc
} else {
  match token_kind(tokens[i]) {
    TComment(_) => count_comment_tokens(tokens, i + 1, acc + 1),
    _ => count_comment_tokens(tokens, i + 1, acc),
  }
}
