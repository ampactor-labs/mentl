// egraph.mn — equality saturation as a cursor read (LEAP 4)
//
// The graph IS the e-graph. Every program node is a resolvable handle in the
// one fabric (graph_node_body, the whole-AST-in-graph weave); every node carries
// a Reason; and equivalence is ONE more fabric edge — the canonical pointer at a
// handle (graph_canon_set / graph_canon_at), co-indexed by handle exactly like
// the TVar union-find in the graph's node array. So there is NO e-graph data structure beyond
// the graph: union-find is a graph edge (graph_canon_set draws it, graph_canon_at
// chases it = `find`), and extraction is that chase to the root — the root IS the
// extracted term, so there is no separate extraction pass. The DELETED side-ledger
// (a snoc-list of (from,to) pairs, linear rw_lookup, re-appended every pass — the
// O(N²) growth that OOM'd) is DELETED; the relation lives where every other graph
// relation lives, read live.
//
// CONGRUENCE CLOSURE falls out of reading operands' canonical forms. A rule
// reads each operand through egraph_extract (the canon chase), so once a ≡ b is
// drawn, any parent f(a) sees f(canon(a)) = f(b) on the NEXT pass — a≡b ⇒
// f(a)≡f(b) with no congruence table, because the parent re-reads its operands
// live. Identity/absorb/fold compose across passes by this single mechanism.
//
// THE ULTIMATE-MEDIUM EDGE — rewrites are EFFECT-GATED. egg and every other
// e-graph rewrite syntactically; Mentl reads each operand's effect ROW from the
// resolved program (is_pure reads effs_at LIVE) and fires a DROPPING rewrite
// (x * 0 ≡ 0) only when the dropped operand is provably Pure — preserving what
// RUNS, not only what the value equals. Proof, not heuristic: only a row that
// subsumes the pure row is droppable.
//
// This is the generative-audit payoff (PLAN §2): the AST-in-graph move made the
// program a graph the optimizer reads at a handle — optimization IS a cursor
// mode (the canon-weave read), not a bolted-on pass.
import types

import graph

import effects

import io

// Follow the equivalence edge to the canonical (cheapest) node — the union-find
// `find`, now a single live graph read. Depth-bounded so a malformed rule set
// that draws a cycle stays total; the cap is the fixpoint guard (a cycle is a
// rule-set bug, surfaced by hitting it), never a silent truncation. Because
// graph_canon_set always points `from` at a strictly-cheaper `to`, a chain is
// monotone and terminates well under the cap.
fn egraph_extract(handle) with GraphRead = extract_chase(handle, 0)

fn extract_chase(handle, depth) with GraphRead = if depth > 1000 {
  handle
} else {
  let to = graph_canon_at(handle)
  if to == handle { handle } else { extract_chase(to, depth + 1) }
}

// ─── Effect gating ────────────────────────────────────────────────────
//
// A node is droppable iff evaluating it performs no effects. The ULTIMATE read
// is the node's inferred effect ROW (effs_at), not its AST shape: a `Pure`-typed
// call IS droppable, a syntactically-pure form that performs through a captured
// evidence is NOT. effs_at projects the row the inference already proved at this
// handle; row_subsumes(row, mk_ef_pure()) is true exactly when the row is
// empty (the Boolean-algebra identity: the pure row is the bottom, subsumed
// only by itself).
// Soundness over completeness: a missed optimization is free; a dropped effect is
// a miscompile. Droppable = (a) the node's BODY is a value-producing form whose
// EVALUATION performs nothing (a literal, a var, or arithmetic over droppable
// operands — a call/perform/hole is NOT, its effects are not on its result type),
// AND (b) the node's TYPE carries no effect row (effs_at — a functional value
// closing over an effectful evidence is caught here even when its body looks
// value-shaped). The conjunction is the honest live read: the substrate binds
// effect rows PER-FRAME (graph_bind_row on the frame's row_handle), not per-expr,
// so a call operand's effects are not readable on its own node — the body form is
// the only sound per-node signal, and the type row catches the closure case the
// body form would miss. (When infer grows a per-expr row binding, is_pure reduces
// to effs_at alone — peer Hβ.egraph.per-expr-effect-row.)
fn is_pure(handle) with GraphRead + LookupTy + Memory + Alloc =
  body_is_pure(handle) && row_subsumes(effs_at(handle), mk_ef_pure())

// The structural purity of a node's EVALUATION — read live from its body. A
// literal/var performs nothing; arithmetic over pure operands is pure; ANY other
// form (a call, a perform, a hole) may run effects, so it is NOT provably pure.
// This is the per-node signal the frame-keyed effect row cannot give.
fn body_is_pure(handle) with GraphRead + LookupTy + Memory + Alloc = match graph_node_body(handle) {
  NExpr(LitInt(_)) => true,
  NExpr(LitFloat(_)) => true,
  NExpr(LitString(_)) => true,
  NExpr(LitBool(_)) => true,
  NExpr(VarRef(_)) => true,
  NExpr(BinOpExpr{left: l, right: r}) => is_pure(node_handle(l)) && is_pure(node_handle(r)),
  _ => false,
}

// The effect row inference proved at this handle's TYPE, read LIVE (lookup_ty —
// the same live read lower's derive_ev_slots uses). A functional node carries its
// row in TFun's third field — a closure over effectful evidence is caught here; a
// value node carries NONE, which IS the pure row (a value performs nothing to BE a
// value). No fabrication, no AST re-derivation: the row is read where infer wrote it.
fn effs_at(handle) with LookupTy = match lookup_ty(handle) {
  TFun{row} => row,
  _ => mk_ef_pure(),
}

// ─── Rewrite rules ────────────────────────────────────────────────────
//
// Each rule reads the node at `handle` (graph_node_body) THROUGH its operands'
// canonical forms (egraph_extract — this is what closes congruence), and if it
// matches, draws an equivalence edge (graph_canon_set) to an EXISTING subnode (no
// node creation, so the canonical target is already a fabric citizen) and returns
// true. The edge is drawn only when `handle` is not already pointed at that
// target — `rewrite_to` reads the current edge first, so a fixpoint pass draws
// NOTHING and saturation converges (the OOM cure: re-firing an already-rewritten
// node records no new fact, so the fired count falls to 0).
//
// Draw `from ≡ to` iff it is a NEW edge (idempotent at the fixpoint). Returns
// whether a fresh fact was recorded — the saturation progress signal.
fn rewrite_to(from, to) with GraphRead + GraphWrite = if graph_canon_at(from) == to {
  false
} else {
  graph_canon_set(from, to)
  true
}

// x + 0 ≡ x  and  0 + x ≡ x  — the survivor is kept, never gated.
fn rw_add_identity(handle) with GraphRead + GraphWrite = match graph_node_body(handle) {
  NExpr(BinOpExpr{op: BAdd, left: l, right: r}) => {
    let lh = egraph_extract(node_handle(l))
    let rh = egraph_extract(node_handle(r))
    if is_zero(rh) {
      rewrite_to(handle, lh)
    } else if is_zero(lh) {
      rewrite_to(handle, rh)
    } else {
      false
    }
  },
  _ => false,
}

// x * 1 ≡ x  and  1 * x ≡ x  — survivor kept, never gated.
fn rw_mul_identity(handle) with GraphRead + GraphWrite = match graph_node_body(handle) {
  NExpr(BinOpExpr{op: BMul, left: l, right: r}) => {
    let lh = egraph_extract(node_handle(l))
    let rh = egraph_extract(node_handle(r))
    if is_one(rh) {
      rewrite_to(handle, lh)
    } else if is_one(lh) {
      rewrite_to(handle, rh)
    } else {
      false
    }
  },
  _ => false,
}

// x * 0 ≡ 0  and  0 * x ≡ 0  — DROPS the non-zero operand, so it fires only
// when that operand is provably pure (the effect gate, read LIVE from the row).
// The canonical target is the zero literal node, already in the fabric.
fn rw_mul_absorb(handle) with GraphRead + GraphWrite + LookupTy + Memory + Alloc = match graph_node_body(handle) {
  NExpr(BinOpExpr{op: BMul, left: l, right: r}) => {
    let lh = egraph_extract(node_handle(l))
    let rh = egraph_extract(node_handle(r))
    if is_zero(rh) && is_pure(lh) {
      rewrite_to(handle, rh)
    } else if is_zero(lh) && is_pure(rh) {
      rewrite_to(handle, lh)
    } else {
      false
    }
  },
  _ => false,
}

// x - 0 ≡ x — survivor kept, never gated. (0 - x is NOT x, so left only.)
fn rw_sub_identity(handle) with GraphRead + GraphWrite = match graph_node_body(handle) {
  NExpr(BinOpExpr{op: BSub, left: l, right: r}) => {
    let rh = egraph_extract(node_handle(r))
    if is_zero(rh) { rewrite_to(handle, egraph_extract(node_handle(l))) } else { false }
  },
  _ => false,
}

// x / 1 ≡ x — survivor kept, never gated.
fn rw_div_identity(handle) with GraphRead + GraphWrite = match graph_node_body(handle) {
  NExpr(BinOpExpr{op: BDiv, left: l, right: r}) => {
    let rh = egraph_extract(node_handle(r))
    if is_one(rh) { rewrite_to(handle, egraph_extract(node_handle(l))) } else { false }
  },
  _ => false,
}

fn is_zero(handle) with GraphRead = match graph_node_body(handle) {
  NExpr(LitInt(n)) => n == 0,
  _ => false,
}

fn is_one(handle) with GraphRead = match graph_node_body(handle) {
  NExpr(LitInt(n)) => n == 1,
  _ => false,
}

// ─── Constant folding — lit op lit ≡ lit (the one rule that CREATES) ───
//
// A binary op over two integer literals folds to a single literal. This is the
// only rule that MINTS a node: the folded literal is registered in the program
// weave AND type-bound to Int — saturate runs after inference, so an un-bound new
// node would be NFree at lower time. Operands are read through egraph_extract, so
// a folded subterm (already ≡ a literal) folds transitively (the congruence
// payoff for fold). Div/mod by zero does NOT fold: the trap is the program's
// meaning, not a constant. The edge is drawn idempotently (rewrite_to), so a
// re-fold pass mints nothing new and converges.
fn const_int(handle) with GraphRead + Memory + Alloc = match graph_node_body(handle) {
  NExpr(LitInt(n)) => Some(n),
  _ => None,
}

fn fold_int(op, a, b) with Memory + Alloc = match op {
  BAdd => Some(a + b),
  BSub => Some(a - b),
  BMul => Some(a * b),
  BDiv => if b == 0 { None } else { Some(a / b) },
  BMod => if b == 0 { None } else { Some(a % b) },
  _ => None,
}

fn rw_const_fold(handle) with GraphRead + GraphWrite + Memory + Alloc = match graph_node_body(handle) {
  NExpr(BinOpExpr{op, left: l, right: r}) => match const_int(egraph_extract(node_handle(l))) {
    Some(a) => match const_int(egraph_extract(node_handle(r))) {
      Some(b) => match fold_int(op, a, b) {
        Some(v) => // Already folded to v on a prior pass? The current canonical
        // form is a literal v — draw nothing, report no progress.
        match const_int(egraph_extract(handle)) {
          Some(existing) => if existing == v { false } else { mint_fold(handle, v) },
          None => mint_fold(handle, v),
        },
        None => false,
      },
      None => false,
    },
    None => false,
  },
  _ => false,
}

fn mint_fold(handle, v) with GraphWrite + Memory + Alloc = {
  let h = graph_fresh_ty(Inferred("const-fold"))
  graph_register_node(h, NExpr(LitInt(v)))
  graph_bind(h, TInt, Inferred("const-fold result : Int"))
  graph_canon_set(handle, h)
  true
}

// ─── Saturation ───────────────────────────────────────────────────────
//
// Apply every rule to every node, repeating until a full pass draws no fresh
// equivalence edge (the fixpoint — equality saturation). Because every rule
// draws its edge idempotently (rewrite_to / the const-fold guard), an
// already-canonicalized node fires NOTHING on the next visit, so the fired count strictly
// decreases to 0 — the OOM the re-appending snoc-list caused cannot recur. The
// node space is bounded by the fresh-handle counter at the START of saturation;
// const-fold mints new literal nodes ABOVE that bound, but they are already in
// canonical form (a bare literal matches no rule's LHS), so the bound need not
// chase them — the relation reaches its fixpoint over the original program space.
fn saturate(bound) with GraphRead + GraphWrite + LookupTy + Memory + Alloc =
  saturate_until(bound, 0)

// ─── The FORM half of the fork/merge composition (PLAN §5) ───────────
//
// Saturation confined to a handle RANGE — the ?? fan's freshly-minted
// candidate space, never the whole program. The fan has just proved
// WHICH MEANINGS are admissible (fork: candidates conflict, so each
// verifies in its own rolled-back world); this saturates the survivors'
// own nodes so extraction can pick the cheapest FORM of each (merge:
// members are equal by construction, so nothing is ever undone). The
// order is forced — extract-then-prove would optimize an inadmissible
// program — and the range is what keeps the form half cheap: a fan at
// one cursor position must not re-saturate a session's whole graph.
// apply_rules_from already takes its start, so the range costs one
// parameter and no new machinery.
fn saturate_range(start, bound) with GraphRead + GraphWrite + LookupTy + Memory + Alloc =
  saturate_range_until(start, bound, 0)

fn saturate_range_until(start, bound, pass) with GraphRead + GraphWrite + LookupTy + Memory + Alloc = if pass > bound - start {
  ()
} else {
  let fired = apply_rules_from(start, bound, 0)
  if fired == 0 { () } else { saturate_range_until(start, bound, pass + 1) }
}

// The saturation pass: populate the e-graph over the whole node space
// (graph_next bounds it at entry), then pass the program through unchanged — the
// equivalence edges are the side effect lower reads via egraph_extract. A `|>`
// stage between frontend and lower in the pipeline spine.
fn saturate_pass(program) with GraphRead + GraphWrite + LookupTy + Memory + Alloc = {
  saturate(graph_next())
  program
}

// The outer cap is `bound` passes: each productive pass draws at least one edge
// and the relation only grows toward roots, so `bound` passes suffice; the cap is
// a total-function guard, never reached at fixpoint (fired hits 0 first).
fn saturate_until(bound, pass) with GraphRead + GraphWrite + LookupTy + Memory + Alloc = if pass > bound {
  ()
} else {
  let fired = apply_rules_from(0, bound, 0)
  if fired == 0 { () } else { saturate_until(bound, pass + 1) }
}

// One pass: every rule at every node. const-fold is tried first (it only matches
// lit-op-lit, reading operands through their canonical forms); the algebraic
// identities match var-involving forms; the cases are disjoint, so `||`
// short-circuits to the single rule that can fire. Returns the count of FRESH
// equivalence edges drawn this pass (the convergence signal).
fn apply_rules_from(i, bound, acc) with GraphRead + GraphWrite + LookupTy + Memory + Alloc = if i >= bound {
  acc
} else {
  let fired =
    rw_const_fold(i) || rw_add_identity(i) || rw_mul_identity(i) || rw_mul_absorb(i) || rw_sub_identity(i) || rw_div_identity(i)
  apply_rules_from(i + 1, bound, if fired { acc + 1 } else { acc })
}
