// driver.mn — the module DAG walk
//
// Walks the import DAG from an entry module, visits each module once
// in dependency order (post-order: leaves before importers), and
// resolves each name to a path (`driver_module_path`, over the roots
// `module_roots` names, tried in order). Every compile judges the DAG as ONE
// program — each module parsed on its own, all of them inferred together —
// so the diagnostics are whole-program truth, never per-module fragments
// missing their cross-module names. There is no cache in this file: a
// cross-run skip is the graph image restored whole
// (Hβ.persist.module-image-cache).
//
// The per-module env overlay is still open: env install merges flat into
// env_handler and the graph chase walks one global graph
// (Hβ.driver.per-module-env-overlay).
import types

import fs

import infer

import io

import lexer

import parser

import persist

import strings

import verify

// Where a module's source can live, each root with the LAYER a module found
// there belongs to, in the order an ENTRY is resolved: the direct read
// (`mentl check foo` beside foo.mn in any directory; `sub/thing` and
// absolute paths ride it — a user's own module), the repository's `src/`
// (the compiler) and `lib/` (the library), then the same two under
// `/mentl-home`, where the install shim (tools/install.sh) maps $MENTL_HOME
// so a project outside the repo reaches the pinned boot's own vocabulary
// with no configuration. The layer is a fact of the module from the root
// that found it: it rides the walk's entry (`ModuleEntry`), the module's
// node (`NModule`) and every report the module makes (`report_at`), and is
// never a path prefix re-tested by a reader.
fn module_roots() = [
  (User, ""),
  (Compiler, "src/"),
  (Lib, "lib/"),
  (Compiler, "/mentl-home/src/"),
  (Lib, "/mentl-home/lib/")
]

// The roots an IMPORT edge probes, decided by the IMPORTER: a user's module
// reaches its own folder (an entry outside the cwd finds its siblings beside
// itself, never in the cwd) and the library, and never the compiler's roots
// (a file the user's own folder holds is the user's, whatever it contains);
// a library module reaches the library alone, its own root first; a compiler
// module keeps the entry's whole order. So the library cannot import the
// compiler and a user cannot `import graph`: E_MissingModule names the
// places that were probed, which is the only refusal the layering needs —
// an inversion is unconstructible rather than detected. `None` is the entry
// itself, which no edge reached.
fn import_roots(importer) = match importer {
  None => module_roots(),
  Some((User, dir)) => [(User, dir), (Lib, "lib/"), (Lib, "/mentl-home/lib/")],
  Some((Lib, root)) => [(Lib, root), (Lib, "lib/"), (Lib, "/mentl-home/lib/")],
  Some((Compiler, _)) => module_roots(),
}

// The files a module's name can be under the given roots, each with the
// layer and the root that would have found it.
// The String pin is an Intent Boundary: unpinned, module_name's only uses
// are splices, the fn generalizes, and a free-typed caller routes the word
// floor — paths minted as pointer numerals.
fn module_candidates(module_name: String, roots) =
  roots |> map({ (layer, root) => (layer, root, "{root}{module_name}.mn") })

// The probe paths alone, under the entry's roots — what a verb that names a
// module says it searched.
fn module_probes(module_name: String) =
  candidate_paths(module_candidates(module_name, module_roots()))

fn candidate_paths(candidates) = map({ (_, _, path) => path }, candidates)

// The directory a name names under the entry's roots, the first that exists:
// a directory under lib/ reaches here by its bare name, the command line
// having read the path as a module's.
fn driver_dir_path(name: String) =
  module_roots() |> map({ (_, root) => "{root}{name}" }) |> find(is_dir)

fn is_dir(path) = match fs_list_dir(path) {
  Some(_) => true,
  None => false,
}

// The candidate a module's name resolves to under the given roots — its
// layer, the root that found it and its path — or None. A module with no
// file has no path, so nothing reads or writes one in its name; each caller
// says what the absence means.
fn driver_resolve(module_name: String, roots) =
  find({ (_, _, path) => fs_exists(path) }, module_candidates(module_name, roots))

fn resolved_layer(resolved) = match resolved {
  Some((layer, _, _)) => layer,
  None => User,
}

// The file a module's name resolves to as an ENTRY would — the first probe
// that exists under every root, or None — the read every verb that names a
// module by itself takes.
fn driver_module_path(module_name: String) = match driver_resolve(module_name, module_roots()) {
  Some((_, _, path)) => Some(path),
  None => None,
}

// The directory a path's siblings live in, with its slash — "" for a bare
// name in the cwd — the root a user module's own imports probe first.
fn path_dir(path: String) = match drop_last(split("/", path)) {
  [] => "",
  parts => "{join("/", parts)}/",
}

// A resolved module's path as a list — empty where the name resolves to no
// file, so an import that names nothing draws no edge.
fn module_path_list(module_name: String) = match driver_module_path(module_name) {
  Some(path) => [path],
  None => [],
}

// Module DAG collection — depth-first post-order walk from entry.
// Leaves before importers; visited set prevents cycles.
//
// THE PRELUDE IS PRE-IMPORTED — that is what the word means. Every module
// speaks the prelude's vocabulary (map / fold / Option / FeedbackSpec)
// without an import line, so the DAG seeds with `prelude` before the
// entry: its own imports (the runtime floor) resolve first, and the
// post-order puts the whole standard vocabulary ahead of every user
// module. Without the seed, `mentl compile main` reached a DAG that
// omitted the vocabulary every program speaks and
// emitted a module that could not assemble ($ev_lookup undefined —
// Hβ.driver.wheel-imports-are-the-manifest, the fleet's measured
// finding).
//
// THE WALK IS AN ARENA (lib/arena.mn): what it publishes is the list of
// (name, path, source, imports) it resolved, and everything it computed to
// get there — each header's tokens, the resolver's probe paths — dies at its
// exit. Measured 2026-10-06 when every compile became this walk (M9): the
// heap stood at 75.6 MB once the wheel's link was discovered, of which the
// module texts are 3.7 MB, and the judgment carried the other 72 MB to its
// end.
fn driver_collect_dag(ref entry_module) =
  driver_collect_dag_resolved(entry_module, driver_resolve(entry_module, module_roots()))

// The walk from an entry already resolved — the routes that enter the link
// root with the entry's layer resolve it once, before the root, and hand the
// resolution here rather than probing the roots again.
// The walk answers what it found and the key the prelude was walked under,
// the link's prelude edge.
fn driver_collect_dag_resolved(entry_module, resolved) = match driver_seeded() {
  ((seeded, seeded_visited), prelude_key) => match driver_collect_resolved(entry_module, resolved, None, seeded, seeded_visited) {
    (((final_buf, final_count), _final_visited), _key) => (slice(final_buf, 0, final_count), prelude_key),
  },
} ~> arena

// A program read from stdin is an entry like a file is: its import lines are
// edges the same walk follows, after the same prelude seed, and the text itself
// is the last module, named `<stdin>`. It used to be judged ALONE — its imports
// drew nothing, so every gate that fed a program on stdin concatenated the
// library files ahead of it, a third link model beside the DAG, and the blob's
// repeated imports were one module's duplicates once a duplicate import refused.
fn driver_collect_text(text) = {
  let imports = driver_extract_imports(text)
  match driver_seeded() {
    ((seeded, seeded_visited), prelude_key) => match driver_collect_visit_list(imports, Some((User, "")), seeded, seeded_visited) {
      (((buf, count), _visited), dep_keys) => {
        let extended = list_extend_to(buf, count + 1)
        (
          slice(list_set(extended, count, ("<stdin>", "<stdin>", Some(text), dep_keys, User)), 0, count + 1),
          prelude_key
        )
      },
    },
  }
} ~> arena

// The prelude edge every link starts from. The seed is conditional on
// RESOLUTION: the prelude is pre-imported where the stdlib is reachable (the
// repo, an installed MENTL_HOME); a bare scratch context with no lib/ compiles
// bare programs — seeding an unresolvable prelude there would hand the ARMED
// E_MissingModule a phantom and refuse every compile.
// The seed answers the key the prelude was walked under beside what the walk
// collected — the one place the prelude is named, so the link's edge to it is
// drawn from here and never found again by its name.
fn driver_seeded() = {
  let buf = make_list(16)
  match driver_resolve("prelude", module_roots()) {
    Some(found) => match driver_collect_resolved("prelude", Some(found), None, (buf, 0), []) {
      (collected_visited, key) => (collected_visited, Some(key)),
    },
    None => (((buf, 0), []), None),
  }
}

// collected is a (buf, count) pair threaded through DAG traversal.
// Post-order: append self AFTER visiting deps.
//
// THE ELEMENT CARRIES WHAT THE WALK RESOLVED — (name, path, source, imports).
// It used to be the name alone, so every consumer downstream re-derived the
// rest BY NAME: the weave's sort re-resolved the path for its key,
// the compile fold re-resolved it and re-read the file, the tree scan did both
// and re-lexed for the imports, and driver_module_in_dag_deps did all three
// again. Path resolution is up to five fs_exists probes, so a five-module
// prelude paid dozens of stat calls and read and lexed every file twice in one
// compile — the canonical re-derivation, following a name instead of the edge
// the walk had already drawn. Measured at the probe that named this: removing
// the second read+lex alone took `fn main() = 7` from 0.74s to 0.46s.
// A missing module carries None, not "" — the absence is the ADT's, never a
// sentinel the consumer has to recognize.
// `!Diagnostic` is MEASURED, not asserted: the walk's only reporting reach was
// the discovery parse, and the header scan absorbs lex's own under diag_quiet.
// The absence is what the comment below already claimed in prose — the walk
// does not report, the per-module check does — so the row now proves it and a
// future report here is a refusal rather than a surprise.
// A MODULE'S IDENTITY IS WHAT IT RESOLVES TO, NEVER THE SPELLING THAT
// REACHED IT. The visited set keyed the NAME and resolved on the next
// line, so `lists` and `lib/lists` — one file, two spellings — each
// passed the check and collected the same source twice; every
// declaration in it then collided with itself. Resolution moves ABOVE
// the check and the set keys the path, so a second edge to a module
// already walked is the no-op that drawing an existing edge is.
// The walk's step for one import edge: resolve the spelling under the
// IMPORTER's roots, then collect. The answer carries the KEY the module was
// walked under — its path, or its name when it has none — so the importer's
// entry can record its deps as the identities they resolved to.
fn driver_collect_visit(ref module_name, importer, collected, visited) with !Diagnostic = driver_collect_resolved(
  module_name,
  driver_resolve(module_name, import_roots(importer)),
  importer,
  collected,
  visited
)

fn driver_collect_resolved(module_name, resolved, importer, collected, visited) with !Diagnostic = {
  // A module with no file is keyed by its name: a name never ends in `.mn`,
  // so it cannot meet a path.
  let key = match resolved {
    Some((_, _, path)) => path,
    None => module_name,
  }
  if set_contains(visited, key) {
    ((collected, visited), key)
  } else {
    let visited2 = set_insert(visited, key)
    match resolved {
      // No file: a terminal with no source and no deps, its path the places
      // the resolver looked for the module that asked — E_MissingModule names
      // them where the entry is checked. Its layer is its importer's: the
      // world it would have joined.
      None => match collected {
        (buf, count) => {
          let extended = list_extend_to(buf, count + 1)
          let searched = join(", ", candidate_paths(module_candidates(module_name, import_roots(importer))))
          let written = list_set(extended, count, (module_name, searched, None, [], importer_layer(importer)))
          (((written, count + 1), visited2), key)
        },
      },
      Some((layer, root, path)) => driver_collect_present(module_name, layer, root, path, collected, visited2),
    }
  }
}

fn importer_layer(importer) = match importer {
  None => User,
  Some((layer, _)) => layer,
}

fn driver_collect_present(module_name, layer, root, path, collected, visited2) = {
  let source = fs_read_file(path)
  let imports = driver_extract_imports(source)
  // The module's own edges probe from where IT was found: a user module's
  // folder, a library module's root.
  let own_importer = Some((
    layer,
    match layer {
      User => path_dir(path),
      Lib => root,
      Compiler => root,
    }
  ))
  // Visit dependencies first, then add self (post-order); the deps ride the
  // entry as the KEYS the walk resolved them to, so no reader re-resolves a
  // spelling.
  match driver_collect_visit_list(imports, own_importer, collected, visited2) {
    ((after_deps_collected, after_deps_visited), dep_keys) => match after_deps_collected {
      (buf, count) => {
        let extended = list_extend_to(buf, count + 1)
        let written = list_set(extended, count, (module_name, path, Some(source), dep_keys, layer))
        (((written, count + 1), after_deps_visited), path)
      },
    },
  }
}

// What the walk resolved about one module, carried whole: the spelling that
// reached it (for the human in a diagnostic), the path that IS its identity,
// the source already read, the import edges as the KEYS they resolved to,
// and the layer of the root that found it. Naming the quint gives the layer
// partition a pin it can state and the five projections below a subject.
type ModuleEntry = (String, String, Option(String), [String], Layer)

// The DAG element's five projections — one home each, so a consumer reads
// the field instead of destructuring a positional quint at nine sites.
fn module_name_of(entry) with Pure = match entry {
  (n, _p, _s, _i, _l) => n,
}

fn module_path_of(entry) with Pure = match entry {
  (_n, p, _s, _i, _l) => p,
}

fn module_source_of(entry) with Pure = match entry {
  (_n, _p, s, _i, _l) => s,
}

fn module_imports_of(entry) with Pure = match entry {
  (_n, _p, _s, i, _l) => i,
}

fn module_layer_of(entry) with Pure = match entry {
  (_n, _p, _s, _i, l) => l,
}

// The walk over one module's import list: each spelling collected under the
// importer's roots, the keys gathered in import order.
fn driver_collect_visit_list(ref modules, importer, collected, visited) with !Diagnostic = fold(
  ((collected, visited), []),
  (acc, m) => match acc {
    ((c, v), keys) => match driver_collect_visit(m, importer, c, v) {
      (collected_visited, key) => (collected_visited, push(keys, key)),
    },
  },
  modules
)

// The module's import edges — a LEX, never a parse.
//
// The dep walk asks one question of every module: which modules does it
// name? That is answered by the token stream (parser.mn's import_edges),
// so this read builds no tree and writes no graph cell. The former shape
// ran a full parse_program per module and dropped the AST, which the
// judging pass then re-derived; it needed a private graph instance to
// contain those mints, because unbracketed they entered the live weave as
// a SECOND generation and the duplicate holes reached the position
// enumerators (the edit workflows focused a ghost). No mints, no instance
// to bracket — the isolation went with the parse it isolated.
//
// diag_quiet STAYS: lex still reports, and a structure read is not the
// reporting pass. Its file-local spans are unplaceable, and the weave
// parse re-reports every one of them placeably, so the unabsorbed form
// printed each lex diagnostic TWICE.
fn driver_extract_imports(ref source) = source |> lex |> import_edges ~> diag_quiet

// THE LINK IS THE PROGRAM, AND ITS ORDER IS THE WALK'S OWN. Every compile —
// the fixed point, `mentl compile`, a battery fixture, a lesson on the page —
// is the import DAG from the module a person named plus the prelude edge,
// judged as ONE program in the walk's post-order: the prelude's closure
// first, every module after the modules it imports, the named module last,
// and an import cycle's members in the order the walk reached them, which no
// verdict reads: the judgment's callee-first walk over binding groups orders
// every declaration itself and judges each cycle as one group (the session's
// cone is the same judgment over a subset). The link node holds that program
// — its modules in that order, the module a person named and the prelude —
// and every reader starts from it: the compile lowers its declarations, the
// session watches its modules' files, the address reads its named module.
//
// THE RENDER SCOPE IS THE CALLER'S DECISION, NOT THIS MECHANISM'S: a
// user-target verb hears its own project, and the medium's own board hears
// every module (`Hβ.voice.comment-ref-gate-reads-the-flattened-link`).
fn driver_link(entry_module) = driver_link_scoped(entry_module, Project)

fn driver_link_scoped(ref entry_module, audience) = {
  // Discovery is a STRUCTURE read: the DAG walk lexes each module only for
  // its imports, and the parse below re-reports every shape with the
  // module's own spans, so discovery narration is a duplicate in coordinates
  // nothing places. ScopeNone silences exactly that copy; discovery ERRORS
  // still render.
  diag_scope(ScopeNone)
  // The named module resolves ONCE, before the link: the link takes its
  // layer (it is the program the developer asked for), and the walk takes
  // the resolution rather than probing the roots a second time.
  let resolved = driver_resolve(entry_module, module_roots())
  let layer = resolved_layer(resolved)
  let link = enter_link_root(layer)
  match driver_collect_dag_resolved(entry_module, resolved) {
    (entries, prelude_key) => driver_judge_link(
      link,
      entries,
      resolved_key(entry_module, resolved),
      prelude_key,
      link_scope(audience, layer)
    ),
  }
}

// The stdin program's link: the same discovery register and link as a file
// entry's, the same judgment after it. A program read from stdin is the
// user's.
fn driver_text_scoped(text, audience) = {
  diag_scope(ScopeNone)
  let link = enter_link_root(User)
  match driver_collect_text(text) {
    (entries, prelude_key) => driver_judge_link(link, entries, "<stdin>", prelude_key, link_scope(audience, User)),
  }
}

// The key the walk records a resolved name under: its path, or the name
// where no file answers.
fn resolved_key(module_name: String, resolved) = match resolved {
  Some((_, _, path)) => path,
  None => module_name,
}

// The render register a route's audience asks for: the census hears every
// module; the project is the layer of the module a person named. It scopes
// by LAYER: the module each report carries is compared with the named
// module's, never a name and never a line range.
fn link_scope(audience, layer) = match audience {
  Census => ScopeAll,
  Project => ScopeProject(layer),
  Unheard => ScopeNone,
}

// What discovery found, judged as ONE program in the walk's order. Every
// module is minted as a node before any is parsed, so each import line is an
// edge to the node its resolution reached — an import cycle's back edge
// included — and the link holds them all. The named module's node answers,
// or None where it did not load.
fn driver_judge_link(link, entries, entry_key: String, prelude_key, dscope) = {
  let discovered = heap_mark()
  // The render register at its one home, set BEFORE any parse or judgment
  // can narrate (types.mn DiagScope; errors always render).
  diag_scope(dscope)
  // The link's own phase line beside the judgment's (infer.mn) and the
  // compile's (pipeline.mn heap_line): where the heap stands once the walk
  // has read every module and lexed its header.
  match dscope {
    ScopeAll => said("heap: {discovered} byte(s) when the link is discovered\n"),
    ScopeNone | ScopeProject(_) => (),
  }
  let start = graph_next()
  let keyed = fold([], mint_entry, entries)
  each(draw_entry_imports(keyed, ??), entries)
  let modules = map({ (_, mh) => mh }, keyed)
  linked(len(modules))
  let entry = keyed_node(keyed, entry_key)
  link_register(link, entry, modules, keyed_opt(keyed, prelude_key))
  infer_modules_converged(modules, start)
  entry
}

// A walked module minted as a node, keyed by the identity the walk resolved
// it to. A module the resolver could not find is REPORTED, never skipped —
// a skip made `mentl check` say E_MissingModule while `mentl compile` on the
// same source shipped WAT — and is minted as nothing: the absence is the
// walk's own None, not a second probe.
fn mint_entry(acc, entry) = match module_source_of(entry) {
  Some(text) => push(
    acc,
    (
      module_path_of(entry),
      mint_module(module_name_of(entry), module_path_of(entry), text, module_layer_of(entry))
    )
  ),
  None => {
    report(EMissingModule(module_name_of(entry), module_path_of(entry), span_zero()))
    acc
  },
}

// A module's import edges, each to the node its key was minted as. A key no
// node was minted for — a module with no file — draws nothing.
fn draw_entry_imports(keyed, entry) = match keyed_node(keyed, module_path_of(entry)) {
  Some(mh) => module_imports_draw(mh, flat_map(keyed_nodes(keyed, ??), module_imports_of(entry))),
  None => (),
}

fn keyed_node(keyed, key: String) = match find({ (k, _) => k == key }, keyed) {
  Some((_, mh)) => Some(mh),
  None => None,
}

fn keyed_nodes(keyed, key: String) = match keyed_node(keyed, key) {
  Some(mh) => [mh],
  None => [],
}

fn keyed_opt(keyed, key) = match key {
  Some(k) => keyed_node(keyed, k),
  None => None,
}

// The declarations of the module a person named, read off the link; none
// where no module was named or it did not load.
fn link_entry_decls() = match link_entry() {
  Some(mh) => module_of(mh).decls,
  None => [],
}

// The tree's identity as a value — the resident session's staleness read:
// each module of the link's (path hash, byte length, content hash). A PURE
// READ by construction: no discovery, no parsing, no graph write. Word
// triples, deliberately: a hash IS its own value. Coverage: an edited module,
// a deleted module, and a NEWLY-imported module (the importer's text changed)
// all move some banked triple. The one honest hole: a module that was MISSING
// at derivation (reported, never linked) and then created on disk moves
// nothing banked. An mtime probe (once io carries fd_filestat) is the cheaper
// read; content re-hash is the floor.
// THE READ IS THE POINT — it must come from DISK, every time: this is the
// staleness baseline the session compares against its banked copy to decide
// whether the tree moved, and a read whose whole job is to notice that the
// world changed cannot be served from the text the judgment read.
fn driver_manifest() = map(module_identity, link_modules())

fn module_identity(mh) = {
  let file = module_of(mh).file
  if fs_exists(file) {
    let text = fs_read_file(file)
    (str_hash(file), byte_len(text), str_hash(text))
  } else {
    (str_hash(file), -1, 0)
  }
}

// The link's modules as the tree's walk keys them: each file and the hash of
// the text its judgment read.
fn link_text_pairs() = map(text_pair, link_modules())

fn text_pair(mh) = {
  let m = module_of(mh)
  (m.file, str_hash(m.text))
}

// The walked modules keyed as the link's text pairs are: each file and the
// hash of the text the walk read. A module with no file pairs nothing.
fn walked_text_pairs(entries) = flat_map(walked_text_pair, entries)

fn walked_text_pair(entry) = match module_source_of(entry) {
  Some(text) => [(module_path_of(entry), str_hash(text))],
  None => [],
}

// The cache path is keyed by ENTRY alone — the weave's state lives in
// the manifest INSIDE the image, so a changed tree still finds its old
// image and re-derives only the changed cone (a weave-keyed filename
// could never be found again after any edit). The path is CWD-RELATIVE
// (the shim mounts the project at "."), so a compile whose cwd sits on
// tmpfs mints this cache into RAM — measured 2026-07-31: one fleet
// morning parked 4.3GB of images on /tmp and fed the OOM that killed a
// session; probe runs work under .build/probe, never /tmp. Nothing
// prunes sibling images yet (19 entries held 7.2GB) — keep-newest-N
// retention is this writer's own named follow-up.
//
// AND BY THE WORLD (`world_key`): an image restores the handler world that
// wrote it, its output sink included, so `mentl run x` then `mentl compile x`
// under one filename emitted the module into the executor's buffer, and the
// reverse order printed the module and ran nothing (exit 134).
fn driver_warm_path(ref entry_module) =
  ".build/warm-compile-e{int_to_str(str_hash(entry_module))}-w{int_to_str(world_key())}.img"

fn driver_warm_ready(path) = if fs_exists(path) {
  let wire = fs_read_file(path)
  if byte_len(wire) >= 16 {
    let p = str_payload(wire)
    load_i32(p) == image_key()
  } else {
    false
  }
} else {
  false
}

fn driver_compile_entry(ref entry_module) = {
  let path = driver_warm_path(entry_module)
  if driver_warm_ready(path) {
    said("warm: restoring the analyzed image\n")
    image_resume(path)
    driver_incremental()
  } else {
    driver_link(entry_module)
    driver_warm_persist(entry_module)
  }
}

// Persist the analyzed state whole — the graph, its link included — one
// image, whenever the analysis is CLEAN (the diagnostics ledger rides the
// image as counts, not replayable prints). image_header and a streaming
// write keep no second image-sized buffer, so a judgment of any size
// persists, the wheel's own ~2.3 GB line among them.
//
// No continuation names this image: a warm start re-enters through the link
// the restored graph holds, so the header's continuation word is the null
// address.
fn driver_warm_persist(ref entry_module) = if diag_errors() == 0 {
  fs_mkdir(".build")
  persist(image_header(null_addr()), driver_warm_path(entry_module))
} else {
  ()
}

// The warm compile, run entirely in the RESTORED world: the link the restored
// graph holds names the module the image was derived for and carries the
// text each of its modules was judged from, and the current tree reads fresh
// off the host fs. An empty diff is the pure warm hit; a changed cone
// re-derives IN the restored image — re-registration shadows the stale
// entries (the env's latest edge wins), the graph grows monotonically, and
// the named module is ALWAYS in a nonempty cone (every module of the DAG is
// one of its transitive deps, so the downstream closure of any change reaches
// it). The re-judged state re-persists, so the image tracks the tree edit by
// edit.
//
// WHAT AN EMPTY DIFF SKIPS is inference alone: saturate, lower,
// reachability, the gate and emit re-run over the restored graph — measured
// at 3.8 s of a 5.75 s warm compile for a five-line program whose whole
// output is 78 KB, so it is derivation and not delivery, and it goes to zero
// when the lowered form becomes graph columns (PLAN §11, the keystone). And a cone's
// emission is not the cold one's bytes: the superseded generations' nodes
// stay in the graph and the twin demand reads them, so one wheel source
// emitted 7,493 functions cold and 9,206 through a thirteen-module cone
// (`Hβ.graph.module-nodes-are-a-column`, its emit face); a candidate compiler
// is built cold.
fn driver_incremental() = match link_entry() {
  None => (),
  Some(em) => {
    let entry_module = module_of(em).path
    match driver_collect_dag(entry_module) {
      (entries, prelude_key) => {
        let changed = changed_modules(link_text_pairs(), walked_text_pairs(entries))
        if len(changed) == 0 {
          said("warm: inference restored — lowering and emit re-derive\n")
        } else {
          match edit_judged(entries, module_of(em).file, prelude_key, verify_forget) {
            (n, m) => said("warm: re-judged {int_to_str(n)} declaration(s) in {int_to_str(m)} module(s)\n"),
          }
          driver_warm_persist(entry_module)
        }
      },
    }
  },
}

// A module changed when its current hash differs from the manifest's, or
// the manifest never saw it. A VANISHED module needs no arm of its own:
// whoever imported it changed by text (the dropped import), and a module
// nothing imports is not in the DAG at all.
fn changed_modules(ref old_pairs, ref cur_pairs) =
  cur_pairs |> filter({ (m, h) => manifest_hash_of(old_pairs, m) != h }) |> map({ (m, _) => m })

fn manifest_hash_of(ref pairs, name: String) = match find({ (m, _) => m == name }, pairs) {
  Some(pr) => match pr {
    (_, h) => h,
  },
  None => 0,
}

// The downstream closure over the walked tree: a module joins when any module
// it imports is in it, to the fixpoint.
fn closure_fix(ref dag, cone) = {
  let grown = fold(
    cone,
    (acc, md) => match md {
      (m, deps) => if module_in(acc, m) {
        acc
      } else if any((d) => module_in(acc, d), deps) {
        push(acc, m)
      } else {
        acc
      },
    },
    dag
  )
  if len(grown) == len(cone) { cone } else { closure_fix(dag, grown) }
}

fn module_in(ref xs, m: String) = any((x) => x == m, xs)

// A module's statements after an edit, in order: one the edit keeps, a run of
// its lines to read again, or the statements such a run was read as.
type Segment = KeptStmt(Int) | ReadLines(Int, Int) | ReadStmts([Int])

// One module of the walk as an edit leaves it: its node, the text it holds,
// its statements before the edit beside the line extents they stood at, its
// statements after, and the import edges a module read whole draws again.
type ModuleEdit = {
  imports: Option([String]),
  node: Int,
  old: [Int],
  segments: [Segment],
  spans: [Span],
  text: String,
}

fn edit_of(e) = match e {
  ModuleEdit(r) => r,
}

fn edit_with(e, segments) = ModuleEdit({...edit_of(e), segments})

fn edit_node(e) = edit_of(e).node

// A program judged once, then edited, is judged again where the edit was
// made. Every module the walk reads keeps each top-level statement whose text
// and lines the edit left as they were — its nodes, and everything its
// judgment wrote at them — and reads again, from their own lines, the
// statements the edit rewrote or moved. A moved statement is read again
// because its positions are copied into its reasons and its reports; a Reason
// that is an edge to its node (PLAN §11, the keystone) lets a moved statement keep its
// judgment. Every statement whose judgment read a replaced one is read again
// with it: one holding a reference or a comment mention into its subtree,
// transitively; one declaring a name a rewritten statement now declares, with
// every reader of it; and one the bank holds a report for, since a report can
// name what moved. A module holding a report with no position is read whole
// once anything in it is, since such a report could have come from any of its
// statements; so is a module whose import lines moved, or that the walk reads
// for the first time, with every module downstream of it, since what a name
// resolves to follows the import edges. What stays was judged against exactly
// the program it stands in now, and what was read again is judged as one
// judgment, the cold route's own machine over those statements. Answers how
// many statements the edit judged and in how many modules.
fn edit_judged(entries, entry_key: String, prelude_key, forget) = {
  let changed = changed_modules(link_text_pairs(), walked_text_pairs(entries))
  let reread = closure_fix(entries_dag(entries), flat_map(imports_moved, entries))
  let zeros = unplaced_report_modules()
  let start = graph_next()
  let planned =
    entries |> flat_map(module_edit(entries, changed, reread, zeros, ??)) |> map(read_runs)
  let seeds =
    flat_map(edit_gone, planned) ++ (planned |> flat_map(edit_read) |> flat_map(name_collisions)) ++ flat_map(reporting_stmts(planned, ??), diag_banked())
  edit_round(planned, seeds, zeros, entry_key, prelude_key, forget, start, (0, 0))
}

// One round of the judgment: the cone the seeds start, its statements read
// again, the program rewritten, and what was read judged. A replaced handler
// whose arms now grade an op differently moves that op's discipline, which
// every perform of it reads, so the effect declaring it starts a round of
// its own.
fn edit_round(planned, seeds, zeros, entry_key: String, prelude_key, forget, start, counted) = match cone_of(seeds, zeros) {
  (gone, gone_set) => {
    let edits = planned |> map(flip_gone(gone_set, ??)) |> map(read_runs)
    let served_before = flat_map(handler_served, gone)
    commit_edits(edits, gone, entry_key, prelude_key, forget)
    let fresh = flat_map(edit_read, edits)
    if len(fresh) > 0 { infer_program_once(fresh, start, graph_next()) } else { () }
    let tally = match counted {
      (n, m) => (n + len(fresh), m + len(filter(edit_reads, edits))),
    }
    match served_moved(served_before, flat_map(handler_served, fresh)) {
      [] => tally,
      effects => edit_round(
        map(kept_now, edits),
        effects,
        zeros,
        entry_key,
        prelude_key,
        forget,
        graph_next(),
        tally
      ),
    }
  },
}

// The program rewritten to what the edit leaves: each module that moved holds
// its new statements, text and import edges; the replaced statements stand
// in no current program, their declarations leave the scope, and the reports
// and obligations they made go; the link holds the modules the walk read.
fn commit_edits(edits, gone, entry_key: String, prelude_key, forget) = {
  let keyed = map({ e => (module_of(edit_node(e)).file, edit_node(e)) }, edits)
  edits |> filter(edit_moves) |> each(rewrite_module(keyed, ??))
  graph_supersede(gone)
  gone |> each(retract_stmt)
  forget(flat_map(edit_replaced, edits))
  match graph_link() {
    Some(link) => link_register(
      link,
      keyed_node(keyed, entry_key),
      map({ (_, mh) => mh }, keyed),
      keyed_opt(keyed, prelude_key)
    ),
    None => (),
  }
}

fn rewrite_module(keyed, e) = {
  let r = edit_of(e)
  let m = module_of(r.node)
  let imports = match r.imports {
    Some(keys) => flat_map(keyed_nodes(keyed, ??), keys),
    None => m.imports,
  }
  graph_register_node(
    r.node,
    NModule({
      ...m,
      decls: flat_map(segment_stmts, r.segments),
      imports,
      span: Span(1, 0, count_lines(r.text) + 2, 0),
      text: r.text,
    })
  )
}

fn retract_stmt(s) = stmt_names(s) |> each(env_retract(??, s))

// A module's text with one edit made, judged as a question: the lines the
// edit moved are read again as `edit_round` reads them, the statements they
// replace leave the scope, and what was read is judged by the cold route's
// machine — beside the program as it stands, since the caller stands in a
// fork (`speculate`) and a fork writes columns of its own over the version
// below, rewriting nothing beneath it. The gradient asks what a declaration
// publishes without a pin this way, so the live cells, which hold the pinned
// type whichever side decided it, are never asked to answer a counterfactual.
// Answers the statements read again.
fn rewritten_judged(mh, text) = {
  let m = module_of(mh)
  let start = graph_next()
  let e = read_runs(diff_edit(mh, m.decls, m.text, text))
  edit_gone(e) |> each(retract_stmt)
  let fresh = edit_read(e)
  infer_program_once(fresh, start, graph_next())
  fresh
}

// The module path's walk edges, as the downstream closure reads them.
fn entries_dag(entries) = map({ e => (module_path_of(e), module_imports_of(e)) }, entries)

// A module read whole: one the walk reads for the first time, one whose
// import lines moved or repeat an edge (the parse refuses a repeat, and only
// a whole read sees both lines).
fn imports_moved(entry) = match graph_module_now(module_path_of(entry)) {
  None => [module_path_of(entry)],
  Some(mh) => if import_files(mh) == module_imports_of(entry) && len(unique(module_imports_of(entry))) == len(module_imports_of(entry)) {
    []
  } else {
    [module_path_of(entry)]
  },
}

fn import_files(mh) = map({ h => module_of(h).file }, module_of(mh).imports)

// The modules a report with no position stands in.
fn unplaced_report_modules() = diag_banked() |> flat_map(unplaced_report)

fn unplaced_report(entry) = match entry {
  (diag, _, dmod, _) => match diag_span(diag) {
    Span(line, _, _, _) => if line == 0 { [dmod] } else { [] },
  },
}

// What the edit does to one module of the walk. A module with no file is
// reported where an import line naming it was just read; a module read for
// the first time is minted and read whole.
fn module_edit(entries, changed, reread, zeros, entry) = match module_source_of(entry) {
  None => {
    if any(imports_key(reread, module_path_of(entry), ??), entries) {
      report(EMissingModule(module_name_of(entry), module_path_of(entry), span_zero()))
    } else {
      ()
    }
    []
  },
  Some(text) => match graph_module_now(module_path_of(entry)) {
    None => [
      whole_edit(
        mint_module(module_name_of(entry), module_path_of(entry), text, module_layer_of(entry)),
        [],
        text,
        Some(module_imports_of(entry))
      )
    ],
    Some(mh) => [planned_edit(changed, reread, zeros, entry, mh, text)],
  },
}

fn imports_key(reread, key: String, entry) =
  module_in(reread, module_path_of(entry)) && module_in(module_imports_of(entry), key)

fn planned_edit(changed, reread, zeros, entry, mh, text) = {
  let m = module_of(mh)
  let path = module_path_of(entry)
  if module_in(reread, path) {
    whole_edit(mh, m.decls, text, Some(module_imports_of(entry)))
  } else if module_in(changed, path) && module_in(zeros, module_name_of_handle(mh)) {
    whole_edit(mh, m.decls, text, None)
  } else if module_in(changed, path) {
    diff_edit(mh, m.decls, m.text, text)
  } else {
    kept_edit(mh, m.decls, text)
  }
}

fn whole_edit(mh, old, text, imports) = ModuleEdit{
  imports,
  node: mh,
  old,
  segments: [ReadLines(1, count_lines(text) + 1)],
  spans: stmt_extents(old),
  text,
}

fn kept_edit(mh, old, text) =
  ModuleEdit{imports: None, node: mh, old, segments: map(KeptStmt, old), spans: stmt_extents(old), text}

// The module as an earlier round of the same edit left it.
fn kept_now(e) = kept_edit(edit_node(e), module_of(edit_node(e)).decls, edit_of(e).text)

// A module whose text moved keeps the statements before the first line the
// edit changed and, when the edit left its line count alone, those after the
// last; the lines between are read again.
fn diff_edit(mh, old, old_text, text) = {
  let spans = stmt_extents(old)
  let p = common_prefix(old_text, text)
  let first = line_of(old_text, p)
  let through = line_of(old_text, max(p, byte_len(old_text) - common_suffix(old_text, text, p) - 1))
  let same = count_lines(old_text) == count_lines(text)
  ModuleEdit{
    imports: None,
    node: mh,
    old,
    segments: diff_segments(line_groups(old, spans), first, through, same, text),
    spans,
    text,
  }
}

fn diff_segments(groups, first, through, same, text) = {
  let before = filter(group_ends_before(first, ??), groups)
  let after = if same { filter(group_starts_after(through, ??), groups) } else { [] }
  let from = match before {
    [] => 1,
    _ => group_last_line(last(before)) + 1,
  }
  let upto = match after {
    [] => count_lines(text) + 1,
    [g, ..._] => group_first_line(g) - 1,
  }
  flat_map(group_kept, before) ++ [ReadLines(from, upto)] ++ flat_map(group_kept, after)
}

// Each statement's line extent: from the line after the statement before it
// ends — or its own first line, where it starts on that line — through its
// own last line, so the comments above a statement are its own.
fn stmt_extents(old) = match fold((0, []), extent_step, old) {
  (_, spans) => spans,
}

fn extent_step(acc, s) = match acc {
  (prev_end, spans) => match graph_span_of(s) {
    Span(sl, _, el, _) => (el, push(spans, Span(min(prev_end + 1, sl), 0, el, 0))),
  },
}

// The statements in groups that share no line: one that starts on the line
// the statement before it ends joins its group, so a run of lines read again
// never cuts a statement in two.
fn line_groups(old, spans) = fold([], join_group, zip(old, spans))

fn join_group(groups, pair) = match pair {
  (s, sp) => match groups {
    [] => [([s], sp)],
    _ => match last(groups) {
      (members, gsp) => if span_first_line(sp) <= span_last_line(gsp) {
        push(drop_last(groups), (push(members, s), Span(span_first_line(gsp), 0, span_last_line(sp), 0)))
      } else {
        push(groups, ([s], sp))
      },
    },
  },
}

fn span_first_line(sp) = match sp {
  Span(a, _, _, _) => a,
}

fn span_last_line(sp) = match sp {
  Span(_, _, b, _) => b,
}

fn group_first_line(g) = match g {
  (_, sp) => span_first_line(sp),
}

fn group_last_line(g) = match g {
  (_, sp) => span_last_line(sp),
}

fn group_ends_before(line, g) = group_last_line(g) < line

fn group_starts_after(line, g) = group_first_line(g) > line

fn group_kept(g) = match g {
  (members, _) => map(KeptStmt, members),
}

// The bytes two texts share from their start.
fn common_prefix(a, b) = match fold((0, false), prefix_step(a, b, ??, ??), range(0, min(byte_len(a), byte_len(b)))) {
  (p, _) => p,
}

fn prefix_step(a, b, acc, i) = match acc {
  (p, true) => (p, true),
  (p, false) => if byte_at(a, i) == byte_at(b, i) { (p + 1, false) } else { (p, true) },
}

// The bytes two texts share at their end, short of the `p` they share at
// their start.
fn common_suffix(a, b, p) = match fold((0, false), suffix_step(a, b, ??, ??), range(0, min(byte_len(a), byte_len(b)) - p)) {
  (s, _) => s,
}

fn suffix_step(a, b, acc, k) = match acc {
  (s, true) => (s, true),
  (s, false) => if byte_at(a, byte_len(a) - 1 - k) == byte_at(b, byte_len(b) - 1 - k) {
    (s + 1, false)
  } else {
    (s, true)
  },
}

// The line the byte at `q` stands on.
fn line_of(text, q) = 1 + count_lines(str_slice(text, 0, max(0, q)))

// The statements one module's runs of lines are read as, each run found
// through the text's line starts, read once for the module.
fn read_runs(e) = {
  let r = edit_of(e)
  if any(is_run, r.segments) {
    let starts = line_starts(r.text)
    edit_with(e, map(read_segment(r, starts, ??), r.segments))
  } else {
    e
  }
}

fn is_run(seg) = match seg {
  ReadLines(_, _) => true,
  KeptStmt(_) | ReadStmts(_) => false,
}

fn read_segment(r, starts, seg) = match seg {
  ReadLines(a, b) => ReadStmts(parse_lines(
    r.node,
    str_slice(r.text, nth(starts, a - 1, byte_len(r.text)), nth(starts, b, byte_len(r.text))),
    a
  )),
  KeptStmt(s) => KeptStmt(s),
  ReadStmts(f) => ReadStmts(f),
}

fn segment_stmts(seg) = match seg {
  KeptStmt(s) => [s],
  ReadStmts(f) => f,
  ReadLines(_, _) => [],
}

fn kept_stmt(seg) = match seg {
  KeptStmt(s) => [s],
  ReadStmts(_) | ReadLines(_, _) => [],
}

fn read_stmt(seg) = match seg {
  ReadStmts(f) => f,
  KeptStmt(_) | ReadLines(_, _) => [],
}

// The statements one module's edit read again, and those it replaced.
fn edit_read(e) = flat_map(read_stmt, edit_of(e).segments)

fn edit_reads(e) = len(edit_read(e)) > 0

fn edit_gone(e) = {
  let kept = edit_of(e).segments |> flat_map(kept_stmt) |> fold(wmap_new(64), mark_handle)
  filter(unmarked(kept, ??), edit_of(e).old)
}

fn edit_moves(e) = edit_reads(e) || len(edit_gone(e)) > 0 || match edit_of(e).imports {
  Some(_) => true,
  None => false,
}

fn mark_handle(set, h: Int) = wmap_add(set, h, 1)

fn unmarked(set, h: Int) = match wmap_get(set, h) {
  Some(_) => false,
  None => true,
}

// What a module's edit replaced, as the generation boundary's clear reads it:
// the module whole when it kept none of its statements, else the extents of
// the statements it replaced.
fn edit_replaced(e) = match edit_gone(e) {
  [] => [],
  gone => if any({ seg => len(kept_stmt(seg)) > 0 }, edit_of(e).segments) {
    [ReplacedExtents(edit_node(e), module_name_of_handle(edit_node(e)), gone_extents(edit_of(e), gone))]
  } else {
    [ReplacedModule(edit_node(e), module_name_of_handle(edit_node(e)))]
  },
}

fn gone_extents(r, gone) = {
  let set = fold(wmap_new(64), mark_handle, gone)
  zip(r.old, r.spans) |> filter({ (s, _) => !unmarked(set, s) }) |> map({ (_, sp) => sp })
}

fn module_replaced(mh) = ReplacedModule(mh, module_name_of_handle(mh))

// A module's kept statements in a group the cone reached become one run of
// lines read again.
fn flip_gone(gone_set, e) = {
  let r = edit_of(e)
  let flipped = filter(group_reached(gone_set, ??), line_groups(r.old, r.spans))
  edit_with(e, flat_map(flip_segment(flipped, ??), r.segments))
}

fn group_reached(gone_set, g) = match g {
  (members, _) => any({ s => !unmarked(gone_set, s) }, members),
}

fn flip_segment(flipped, seg) = match seg {
  KeptStmt(s) => match find(group_holds(s, ??), flipped) {
    Some(g) => match g {
      (members, sp) => if head(members) == s { [ReadLines(span_first_line(sp), span_last_line(sp))] } else { [] },
    },
    None => [KeptStmt(s)],
  },
  ReadLines(a, b) => [ReadLines(a, b)],
  ReadStmts(f) => [ReadStmts(f)],
}

fn group_holds(s: Int, g) = match g {
  (members, _) => any({ m => m == s }, members),
}

// The statements the edit judges, wave by wave: the seeds, and every
// statement whose judgment read one of them — a reference or a comment
// mention into its subtree. A module holding a report with no position joins
// whole. Answers the statements and the set of them.
fn cone_of(seeds, zeros) = cone_wave(wmap_new(256), seeds, zeros, [])

fn cone_wave(seen, frontier, zeros, acc) = match frontier |> flat_map(whole_if_unplaced(zeros, ??)) |> fold(([], seen), admit) {
  (admitted, seen2) => if len(admitted) == 0 {
    (acc, seen2)
  } else {
    cone_wave(seen2, flat_map(stmt_dependents, admitted), zeros, acc ++ admitted)
  },
}

fn admit(acc, s: Int) = match acc {
  (admitted, seen) => if unmarked(seen, s) { (push(admitted, s), mark_handle(seen, s)) } else { acc },
}

fn whole_if_unplaced(zeros, s) = match graph_parent_of(s) {
  Some(mh) => if module_in(zeros, module_name_of_handle(mh)) { module_of(mh).decls } else { [s] },
  None => [s],
}

// The statements whose judgment read a statement: each one holding a
// reference whose edge reaches a node under it, or a comment that mentions
// one.
fn stmt_dependents(s) = nodes_under(s) |> flat_map(in_edge_owners) |> flat_map(owner_stmt)

fn in_edge_owners(n) = graph_refs_of(n) ++ graph_comment_refs_of(n)

fn owner_stmt(o) = match enclosing_decl(o) {
  Some(t) => [t],
  None => [],
}

// A statement a rewritten one collides with: the current holder of a name the
// rewritten one declares, which every reader of the name resolved to.
fn name_collisions(s) = stmt_names(s) |> flat_map(name_holders)

fn name_holders(name) = holder_of(env_resolve(name)) ++ holder_of(env_resolve_type(name))

fn holder_of(found) = match found {
  Some(d) => owner_stmt(d),
  None => [],
}

// The statement a banked report stands in, read where the report placed it.
fn reporting_stmts(edits, entry) = match entry {
  (diag, _, dmod, _) => match diag_span(diag) {
    Span(line, _, _, _) => if line == 0 {
      []
    } else {
      edits |> filter({ e => module_name_of_handle(edit_node(e)) == dmod }) |> flat_map(stmts_at_line(line, ??))
    },
  },
}

fn stmts_at_line(line, e) =
  zip(edit_of(e).old, edit_of(e).spans) |> filter({ (_, sp) => span_first_line(sp) <= line && line <= span_last_line(sp) }) |> map({ (s, _) => s })

// The session's cone: driver_incremental judges an edit inside a RESTORED
// image, and the resident session holds that world live, so the edit is
// judged into it directly. Discovery runs as the cold route runs it —
// silenced, its reports the link's — and a module the program no longer links
// is handed to `forget` whole, so nothing the program left keeps a report or
// a claim. Answers how many statements the edit judged, and in how many
// modules.
fn driver_session_cone(ref entry_module, forget) = {
  diag_scope(ScopeNone)
  let resolved = driver_resolve(entry_module, module_roots())
  match graph_link() {
    Some(link) => graph_module_enter(link),
    None => (),
  }
  match driver_collect_dag_resolved(entry_module, resolved) {
    (entries, prelude_key) => {
      let before = link_modules()
      diag_scope(link_scope(Project, resolved_layer(resolved)))
      let judged = edit_judged(entries, resolved_key(entry_module, resolved), prelude_key, forget)
      forget(map(module_replaced, left_the_link(before)))
      judged
    },
  }
}

// The modules a link held that the link registered after it does not: each
// read from a file no module of the new link was read from.
fn left_the_link(before) = {
  let files = map({ mh => module_of(mh).file }, link_modules())
  filter({ mh => !module_in(files, module_of(mh).file) }, before)
}
