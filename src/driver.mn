// driver.mn — the module DAG walk
//
// Walks the import DAG from an entry module, visits each module once
// in dependency order (post-order: leaves before importers), and
// resolves each name to a path (driver_module_path — four homes, tried
// in order). driver_compile_entry concatenates the DAG into ONE program
// so the whole thing is parsed and inferred together and the diagnostics
// are whole-program truth, never per-module fragments missing their
// cross-module names.
//
// The header here described "cache hit detection" and "consults the .kai
// cache to skip re-inference on unchanged sources" for two weeks after
// the .kai layer was DELETED WHOLE (2026-07-02): it snapshotted env
// entries lossily, DROPPING Reason chains, and pinned an Inka-era wire
// format. There is no cache in this file. Cross-run skipping returns as
// image-persist (Hβ.persist.module-image-cache, PLAN §5.R band O) — the
// graph image memcpy'd whole, keyed by source + transitive dep hashes,
// never a second serializer.
//
// The per-module env overlay is still open: env install merges flat into
// env_handler and the graph chase walks one global graph
// (Hβ.driver.per-module-env-overlay).
import types

import parser

import lexer

import infer

import strings

import io

import persist

import verify

// Resolve a module name to a file path — four homes, tried in order:
//   the DIRECT read (an arg naming an existing file resolves as itself —
//     `mentl check foo` beside foo.mn in ANY directory; `sub/thing` and
//     absolute paths ride the same read),
//   `src/{name}.mn` then `lib/{name}.mn` (the repo layout),
//   `/mentl-home/{src,lib}/{name}.mn` — the well-known guest path when
//     running OUTSIDE the repo: the install shim (tools/install.sh) maps
//     $MENTL_HOME there, so a user project's `import prelude` reaches the
//     pinned boot's own vocabulary — and its transitive `import types` (the
//     substrate effect decls live in src/types.mn) — with zero
//     configuration (the shim is a pointer to the live boot; the mapping
//     is an address, not an env var). In-repo the src/lib homes win
//     first — byte-identical behavior; on a total miss the repo-relative
//     lib path returns so the E_MissingModule diagnostic stays as before.
// The String pin is an Intent Boundary, load-bearing since splices
// stopped forcing String (spec_mangle's law): unpinned, module_name's
// only uses ARE splices, the fn generalizes, and a free-typed caller
// (the tree scan's erased list) routes the word floor — paths minted as
// pointer numerals, fs_exists false for every module, the warm manifest
// all zeros, and the incremental compile blind to every edit.
fn driver_module_path(ref module_name: String) with Filesystem = {
  let direct = "{module_name}.mn"
  if fs_exists(direct) {
    direct
  } else {
    let src_path = "src/{module_name}.mn"
    if fs_exists(src_path) {
      src_path
    } else {
      let lib_path = "lib/{module_name}.mn"
      if fs_exists(lib_path) {
        lib_path
      } else {
        let home_src = "/mentl-home/src/{module_name}.mn"
        if fs_exists(home_src) {
          home_src
        } else {
          let home_lib = "/mentl-home/lib/{module_name}.mn"
          if fs_exists(home_lib) { home_lib } else { lib_path }
        }
      }
    }
  }
}

// Module DAG collection — depth-first post-order walk from entry.
// Leaves before importers; visited set prevents cycles.
//
// THE PRELUDE IS PRE-IMPORTED — that is what the word means. Every module
// speaks the prelude's vocabulary (map / fold / Option / FeedbackSpec)
// without an import line, so the DAG seeds with `prelude` before the
// entry: its own imports (the runtime floor) resolve first, and the
// post-order puts the whole standard vocabulary ahead of every user
// module. Without the seed, `mentl compile main` reached a DAG that
// omitted the vocabulary the concatenated-wheel build supplies and
// emitted a module that could not assemble ($ev_lookup undefined —
// Hβ.driver.wheel-imports-are-the-manifest, the fleet's measured
// finding).
fn driver_collect_dag(ref entry_module) with Memory + Alloc + Filesystem + Intern + GraphRead = {
  let buf = make_list(16)
  let visited = []
  // The seed is conditional on RESOLUTION: the prelude is pre-imported where
  // the stdlib is reachable (the repo, an installed MENTL_HOME); a bare
  // scratch context with no lib/ compiles bare programs — seeding an
  // unresolvable prelude there would hand the ARMED E_MissingModule a
  // phantom and refuse every driver-path compile.
  match if fs_exists(driver_module_path("prelude")) {
    driver_collect_visit("prelude", (buf, 0), visited)
  } else {
    ((buf, 0), visited)
  } {
    (seeded, seeded_visited) => match driver_collect_visit(entry_module, seeded, seeded_visited) {
      ((final_buf, final_count), _final_visited) => slice(final_buf, 0, final_count),
    },
  }
}

// collected is a (buf, count) pair threaded through DAG traversal.
// Post-order: append self AFTER visiting deps.
//
// THE ELEMENT CARRIES WHAT THE WALK RESOLVED — (name, path, source, imports).
// It used to be the name alone, so every consumer downstream re-derived the
// rest BY NAME: driver_canonical_order re-resolved the path for its sort key,
// the compile fold re-resolved it and re-read the file, the tree scan did both
// and re-lexed for the imports, and driver_module_in_dag_deps did all three
// again. Path resolution is up to five fs_exists probes, so a five-module
// prelude paid dozens of stat calls and read and lexed every file twice in one
// compile — the canonical re-derivation, following a name instead of the edge
// the walk had already drawn. Measured at the probe that named this: removing
// the second read+lex alone took `fn main() = 7` from 0.74s to 0.46s.
// A missing module carries None, not "" — the absence is the ADT's, never a
// sentinel the consumer has to recognize.
// `!Diagnostic` is MEASURED, not asserted: the walk's only reporting reach was
// the discovery parse, and the header scan absorbs lex's own under diag_quiet.
// The absence is what the comment below already claimed in prose — the walk
// does not report, the per-module check does — so the row now proves it and a
// future report here is a refusal rather than a surprise.
// A MODULE'S IDENTITY IS WHAT IT RESOLVES TO, NEVER THE SPELLING THAT
// REACHED IT. The visited set keyed the NAME and resolved on the next
// line, so `lists` and `lib/lists` — one file, two spellings — each
// passed the check and collected the same source twice; every
// declaration in it then collided with itself. Resolution moves ABOVE
// the check and the set keys the path, so a second edge to a module
// already walked is the no-op that drawing an existing edge is.
fn driver_collect_visit(ref module_name, own collected, own visited) with Memory + Alloc + Filesystem + Intern + GraphRead + !Diagnostic = {
  let path = driver_module_path(module_name)
  if set_contains(visited, path) {
    (collected, visited)
  } else {
    let visited2 = set_insert(visited, path)
    if !fs_exists(path) {
      // Module source missing — treat as terminal (no further deps).
      // Driver's per-module check will surface E_MissingModule when
      // it tries to process this name.
      match collected {
        (buf, count) => {
          let extended = list_extend_to(buf, count + 1)
          let written = list_set(extended, count, (module_name, path, None, []))
          ((written, count + 1), visited2)
        },
      }
    } else {
      let source = fs_read_file(path)
      let imports = driver_extract_imports(source)
      // Visit dependencies first, then add self (post-order).
      match driver_collect_visit_list(imports, collected, visited2) {
        (after_deps_collected, after_deps_visited) => match after_deps_collected {
          (buf, count) => {
            let extended = list_extend_to(buf, count + 1)
            let written = list_set(extended, count, (module_name, path, Some(source), imports))
            ((written, count + 1), after_deps_visited)
          },
        },
      }
    }
  }
}

// What the walk resolved about one module, carried whole: the spelling that
// reached it (for the human in a diagnostic), the path that IS its identity,
// the source already read, and the import edges already lexed. Naming the
// quad gives the layer partition a pin it can state and the four projections
// below a subject.
type ModuleEntry = (String, String, Option(String), [String])

// The DAG element's four projections — one home each, so a consumer reads the
// field instead of destructuring a positional quad at nine sites.
fn module_name_of(entry) with Pure = match entry {
  (n, _p, _s, _i) => n,
}

fn module_path_of(entry) with Pure = match entry {
  (_n, p, _s, _i) => p,
}

fn module_source_of(entry) with Pure = match entry {
  (_n, _p, s, _i) => s,
}

fn module_imports_of(entry) with Pure = match entry {
  (_n, _p, _s, i) => i,
}

fn driver_collect_visit_list(ref modules, own collected, own visited) with Memory + Alloc + Filesystem + Intern + GraphRead + !Diagnostic = fold(
  (collected, visited),
  (acc, m) => match acc {
    (c, v) => driver_collect_visit(m, c, v),
  },
  modules
)

// The module's import edges — a LEX, never a parse.
//
// The dep walk asks one question of every module: which modules does it
// name? That is answered by the token stream (parser.mn's import_edges),
// so this read builds no tree and writes no graph cell. The former shape
// ran a full parse_program per module and dropped the AST, which the
// judging pass then re-derived; it needed a private graph instance to
// contain those mints, because unbracketed they entered the live weave as
// a SECOND generation and the duplicate holes reached the position
// enumerators (the edit workflows focused a ghost). No mints, no instance
// to bracket — the isolation went with the parse it isolated.
//
// diag_quiet STAYS: lex still reports, and a structure read is not the
// reporting pass. Its file-local spans are unplaceable, and the weave
// parse re-reports every one of them placeably, so the unabsorbed form
// printed each lex diagnostic TWICE.
fn driver_extract_imports(ref source) with Memory + Alloc + Intern + GraphRead =
  source |> lex |> import_edges ~> diag_quiet

// Infer one module: its exports install into env_handler as the
// converged judgment walks (the graph IS the record of what this module
// publishes — no snapshot, no side-file). Cross-run module skip is
// the §4④ image-persist peer (Hβ.persist.module-image-cache): the
// graph image memcpy'd whole, keyed by source + transitive dep
// hashes — never a second serializer.
// ImageAlloc is honest, and it arrived by DELETION: a singleton judge block
// now runs its branch as a direct call instead of a spawned task, and a task's
// body row never reached its spawner. The allocation was always performed —
// the thread boundary was hiding it from the row.
// The ENTRY is the argument, not a name to re-resolve. The walk already
// probed the path, already read the source, and already recorded absence as
// None — so this read is three deletions: the second driver_module_path (up
// to five fs_exists probes per module), the second fs_read_file, and the
// fs_exists test the ADT already answers. That is the same re-derivation
// this file's header names for every OTHER consumer of the walk; the
// per-module check was the last one still following a name.
fn driver_check_module(ref entry) with Memory + Alloc + ImageAlloc + Filesystem + WASI + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + DiagRegister + LookupTy + Verify + InferCtx + Intern + Cast + Mutate + BranchEnv + Consume + WasiThreads = match module_source_of(entry) {
  None => report(EMissingModule(module_name_of(entry), module_path_of(entry), span_zero())),
  Some(source) => {
    source |> infer_program_converged
    ()
  },
}

// A module's exports live in env_handler because the judgment put
// them there — the graph carries them; there is no install step and
// no exported-entries snapshot. A qualified `module.name` reference
// resolves by following the import edge to the module env node
// (SYNTAX.md §Imports) — never a dotted-string-key alias re-resolved
// by name at each call site (Carried-Truth: that is the canonical
// re-derivation).
//
// ─── Topological-layer walk (cargo-class) ───────────────────────────
//
// `driver_collect_dag` produces modules in post-order; this layer
// peels them into topological levels. Layer 0 = leaves (no in-DAG
// deps); layer N = modules whose deepest in-DAG dep is in layer N-1.
// Modules WITHIN a layer are dep-independent; each walks a layer, and
// layers process sequentially: layer N completes (every module's
// exports install into env) BEFORE layer N+1 starts (so dependents
// see all their deps).
//
// The layer partition IS the topological half of
// `Hβ.driver.level-set-par-walk`; the multi-core half is a `><`
// fanout under its own `~> Thread` written at this site — the
// schedule is read at the fanout's install, never across a call
// (Hβ.lower.schedule-specialized-callee).
//
// Process the entry module and all its transitive dependencies.
// Each module either loads from cache or re-infers; envs install in
// dependency order so every imported name is in `env_handler` before
// the entry module's inference runs.
fn driver_check(ref entry_module) with Memory + Alloc + ImageAlloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx + Intern + Cast + Mutate + WASI + BranchEnv + Consume + WasiThreads + DiagRegister =
  entry_module |> driver_collect_dag_with_deps |> driver_partition_layers |> each((layer) => each(driver_check_module, layer))

// driver_check_entry — the compile path's check: infer every DEP of the
// entry (each installs into env_handler), then parse+infer the ENTRY
// ITSELF exactly ONCE and hand its inferred AST back so compile lowers
// the SAME graph it proved. The entry is never re-read or re-inferred
// downstream (Carried-Truth: compile's old second fs_read + frontend +
// re-judgment was the canonical re-derivation this deletes — the entry
// is parsed+typed here, once, and lowered live).
// The COMPILE form of the entry read: an executable IS the one-namespace
// concatenation of its dep DAG — deps first, post-order, entry last — the
// exact form the wheel's own build proves daily (`find src lib | xargs
// cat`). Parsed and inferred as ONE program, so every dep's decls lower
// and emit with the entry (reachability prunes the unused) and the
// diagnostics are the whole-program truth, never per-module fragments
// missing their cross-module names. The per-module env overlay
// (Hβ.driver.per-module-env-overlay) is the sequenced refinement; the
// concatenation is the proven form.
// The one-namespace concatenation WITH its module-range map — the map is a
// fact of the fold that builds the source (each module's start line and
// line count in the concatenated coordinate space), computed exactly where
// the concatenation happens, once. The cursor-address transport renders
// every span back to file:line through it; driver_compile_entry is its
// map-dropping projection.
// The weave order is CANONICAL, never the discovery order. The pinned blob
// build concatenates `find src | sort` then `find lib | sort`; one-namespace
// pre-registration makes ANY order compile, but verdicts are not yet
// order-independent — a runtime fn declared before its prelude consumer
// meets the TIGHT inferred scheme where the canon's order met the loose
// pre-registered one, and three real latent mismatches surface (prelude's
// sum / chunk / trim under a leaves-first weave — the banked measurement,
// Hβ.infer.order-independent-verdicts). One canon, one truth: the DAG
// discovers the SET; the sort fixes the WEAVE to the blob's own order, so
// the two build paths read one input.
fn driver_canonical_order(modules) with Memory + Alloc = {
  let keyed = map((m) => (driver_module_order_key(module_path_of(m)), m), modules)
  map(
    (pair) => match pair {
      (_, m) => m,
    },
    driver_sort_keyed(keyed)
  )
}

// src/ ranks before lib/ (the blob's find order); within a rank, the path's
// own byte order. The rank digit prefixes the resolved path as the key.
// The rank reads the src/ SEGMENT, not a position-0 prefix: under an
// installed mount the resolver returns /mentl-home/src/..., and a prefix
// test would re-rank every src module as lib (a mount-dependent weave).
fn driver_module_order_key(p) with Memory + Alloc =
  if str_contains(p, "src/") { "0{p}" } else { "1{p}" }

fn driver_sort_keyed(pairs) with Memory + Alloc =
  fold([], (acc, p) => driver_insert_keyed(p, acc), pairs)

fn driver_insert_keyed(pair, sorted) with Memory + Alloc = if len(sorted) == 0 {
  [pair]
} else {
  match pair {
    (k, _) => match sorted[0] {
      (k0, _) => if str_lt(k, k0) {
        [pair] ++ sorted
      } else {
        [sorted[0]] ++ driver_insert_keyed(pair, rest(sorted))
      },
    },
  }
}

// A module's weave range off the fold's own map — homed beside the fold
// that mints it; at_run and the session read it through this same edge.
fn range_of_module(ref ranges, ref target) with Memory + Alloc = find(
  (r) => match r {
    (m, _, _, _) => m == target,
  },
  ranges
)

// The tree's identity as a value — the resident session's staleness
// read: each WOVEN module's (path hash, byte length, content hash),
// projected off the range map the derivation already minted. A PURE
// READ by construction: no discovery, no parsing, no graph write —
// the first form re-ran driver_collect_dag, whose per-module import
// parse minted nodes and comment attaches into the LIVE graph on
// every message, and a resettable message's region reclaim killed
// that spine growth under later reads (the fork-spine class, measured
// twice: spine_comment_at's list_index trap on the next check, and
// address_case_a walking a reset span-index buffer). Word triples,
// deliberately: a String element would meet == at the word floor as
// pointer identity (the §9 class, also measured — every message
// re-derived); a hash IS its own value. Coverage: an edited module,
// a deleted module, and a NEWLY-imported module (the importer's text
// changed) all move some banked triple. The one honest hole: a module
// that was MISSING at derivation (reported, never woven) and then
// created on disk moves nothing banked — banking reported-missing
// paths is the named single. An mtime probe (once io carries
// fd_filestat) is the cheaper read; content re-hash is the floor.
fn driver_manifest(ref ranges) with Memory + Alloc + Filesystem = map(
  (r) => match r {
    (_m, p, _start, _nlines) => if fs_exists(p) {
      let text = fs_read_file(p)
      (str_hash(p), byte_len(text), str_hash(text))
    } else {
      (str_hash(p), -1, 0)
    },
  },
  ranges
)

// One module's top-level nodes cut from the weave ast by its range —
// the resident session's scoping read (audit/teach over the entry
// alone, matching the CLI's entry-parsed ast). The NModule mint below
// computes this same filter and holds it in its decls field, but
// discards the minted handle — reading the node instead of
// re-filtering is the O(1) form once the mint keeps an edge to it.
fn driver_module_ast(ref ast, ref ranges, ref target) with Memory + Alloc = match range_of_module(ranges, target) {
  Some(r) => match r {
    (_m, _p, rstart, rn) => {
      let mspan = Span(rstart, 0, rstart + rn, 0)
      filter(
        (n) => match n {
          N(_, dsp, _) => span_contains(mspan, dsp),
        },
        ast
      )
    },
  },
  None => ast,
}

fn driver_entry_with_ranges(ref entry_module) with Memory + Alloc + ImageAlloc + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + DiagRegister + LookupTy + Verify + InferCtx + Intern + Mutate + Cast + WASI + BranchEnv + Consume + WasiThreads = {
  // Discovery is a STRUCTURE read: the DAG walk parses each module only
  // for its imports, and the weave parse below re-reports every shape
  // with weave spans — so discovery narration is a duplicate in
  // coordinates no range can place (it was the pre-register doubling:
  // every parse warning printed twice). ScopeNone silences exactly that
  // copy; discovery ERRORS still render.
  diag_scope(ScopeNone)
  let modules = driver_canonical_order(driver_collect_dag(entry_module))
  match fold(
    ("", 1, []),
    (acc, entry) => match acc {
      (src_acc, line_acc, r_acc) => {
        let m = module_name_of(entry)
        let p = module_path_of(entry)
        // A module the resolver cannot find is REPORTED, never skipped. The
        // `else` that once dropped it silently made `mentl check` say
        // E_MissingModule while `mentl compile` on the same source said
        // nothing and shipped WAT — two verbs, two answers, one truth.
        // The absence is the walk's own None, not a second fs_exists probe.
        match module_source_of(entry) {
          Some(text) => {
            let nlines = count_lines(text) + 1
            ("{src_acc}{text}\n", line_acc + nlines, push(r_acc, (m, p, line_acc, nlines)))
          },
          None => {
            report(EMissingModule(m, p, span_zero()))
            acc
          },
        }
      },
    },
    modules
  ) {
    (source, _next_line, ranges) => {
      // The render register set at its one home: the entry's weave range exists
      // the moment the fold completes — BEFORE any parse or judgment can
      // narrate — so every user-target chain scopes narration to the file the
      // user named (types.mn DiagScope; errors always render). An entry the
      // resolver could not place leaves ScopeAll: nothing is ever silently
      // dropped when the question itself failed.
      match range_of_module(ranges, entry_module) {
        Some(r) => match r {
          (_em, _ep, rstart, rn) => diag_scope(ScopeAt(rstart, rn)),
        },
        None => (),
      }
      let ast = infer_program_converged(source)
      // The weave carries its own MODULE STRUCTURE: each range entry minted as
      // an NModule node — the module's NAME, its weave span, and the top-level
      // decls the span contains. The fabric's NModule readers (same_module's
      // proximity decay, module_path_of_span, the import walks) were built
      // against this node and had ZERO writers, so every span resolved to the
      // "" module and the argmax's module-aware decay flattened to one tie
      // (the edit session focusing a prelude recovery hole instead of the
      // entry's own `??`). The range map held the same fact out-of-band; the
      // graph is its one home.
      let mods = map(
        (r) => match r {
          (m, _p, line_start, nlines) => {
            let mspan = Span(line_start, 0, line_start + nlines, 0)
            match mint_node(
              NModule({decls: filter(
                (n) => match n {
                  N(_, dsp, _) => span_contains(mspan, dsp),
                },
                ast
              ), path: m, span: mspan}),
              mspan
            ) {
              N(_, _, nmh) => (line_start, nlines, nmh),
            }
          },
        },
        ranges
      )
      rehome_seam_comments(mods)
      (ast, ranges)
    },
  }
}

// A comment attached ACROSS a module seam re-homes to its own module's
// NModule node. The parser attaches over ONE weave — forward attach is
// correct single-file semantics, and the parser cannot see seams — so
// the seam truth arrives HERE with the ranges and the re-homing lives
// here (the layering, never a parser patch). The measured face: a lib
// file's tail comment attached to the NEXT module's first decl, and
// the entry's own fns rendered kernel prose as their Lede
// (Hβ.parser.comment-attach-module-boundary resolves at this pass).
// The walk covers exactly the parse nodes (the span log is
// parse-only); a module has at most one file tail, so an NModule cell
// never collides.
fn rehome_seam_comments(ref mods) with GraphRead + GraphWrite + Memory + Alloc = match graph_snapshot() {
  Graph(_x, sp) => rehome_walk(list_to_flat(sp), mods, 0),
}

fn rehome_walk(ref spans, ref mods, i) with Memory + GraphRead + GraphWrite = if i >= len(spans) {
  ()
} else {
  match spans[i] {
    (s, h) => {
      rehome_one(s, h, mods)
      rehome_walk(spans, mods, i + 1)
    },
  }
}

fn rehome_one(ref s, h, ref mods) with GraphRead + Memory + GraphWrite = {
  let text = graph_comment_at(h)
  if byte_len(text) > 0 {
    let cspan = graph_comment_span_at(h)
    let cl = match cspan {
      Span(l, _, _, _) => l,
    }
    let nl2 = match s {
      Span(l2, _, _, _) => l2,
    }
    let cm = module_slot_of(mods, cl, 0)
    let nm = module_slot_of(mods, nl2, 0)
    if cm != nm && cm >= 0 {
      match mods[cm] {
        (_ls, _nl, nmh) => {
          graph_attach_comment(nmh, text, cspan)
          graph_clear_comment(h)
        },
      }
    } else {
      ()
    }
  } else {
    ()
  }
}

fn module_slot_of(ref mods, line, i) with Memory = if i >= len(mods) {
  0 - 1
} else {
  match mods[i] {
    (ls, nl, _) => if line >= ls && line < ls + nl { i } else { module_slot_of(mods, line, i + 1) },
  }
}

// Newlines in a flat string — the concatenation fold's line accountant.
fn count_lines(ref s) with Memory = count_lines_from(s, byte_len(s), 0, 0)

fn count_lines_from(ref s, n, i, acc) with Memory = if i >= n {
  acc
} else {
  let step = if byte_at(s, i) == 10 { 1 } else { 0 }
  count_lines_from(s, n, i + 1, acc + step)
}

// ─── The warm start (Hβ.persist.module-image-cache; B-i landing 2) ────
// A clean analysis persists the whole rooted image, keyed by weave +
// build; the next compile of the same weave RESTORES it and lowers the
// live graph — frontend and inference skipped whole (§4④: the cross-run
// module skip IS image-persist, never a second serializer). The probe
// pre-checks the build key so a stale or foreign cache falls back to
// the cold path instead of refusing; image_resume's own gate stays as
// the trap beneath. warm_asts is the typed
// re-entry: the globals record restores the let, whose cell hands back
// the persisted run's typed AST (the persist-image fixture's proven
// pattern — no up-cast exists on the path). Only a CLEAN analysis
// caches: the diagnostics ledger rides the image as counts, not
// replayable prints, so a dirty run re-derives and re-prints honestly.
// The warm line prints BEFORE the swap (a post-restore interpolation
// would read this process's dead pre-swap heap).
// The image's own roots — typed cells the globals record restores. The
// incremental path runs entirely POST-swap, so it can take NO pre-swap
// heap arguments (they die under the image copy); everything it needs
// rides the image: the entry name reconstructs the cache path, the
// manifest names each DAG module's persisted text hash, and warm_asts
// holds the analyzed weave as per-module statement buckets — the ONE
// ast home (the whole program is its flatten, warm_program; a second
// stored flat copy would be a cache of that read).
let warm_manifest = [[]]

let warm_entry = [""]

let warm_asts = [[]]

fn warm_program() with Memory + Alloc = list_index(warm_asts, 0) |> map((pr) => match pr {
  (_, ss) => ss,
}) |> flatten

// ─── The ONE tree scan ────────────────────────────────────────────────
// Discovery walks the DAG once; then ONE content pass per module yields
// canonical-ordered (module, text-hash, in-tree deps) — the manifest,
// the downstream closure, and the reassembly order are all projections
// of this single read (the pairs walk, the deps walk, and the order walk
// were three passes over the same files — the eight-interrogations cut).
// The scan's identity is the module's PATH, the same key the DAG walk, the
// dep edges and the layer partition use. It has to be: the triple's deps are
// matched against it to build the downstream closure, so a spelling here
// against paths there would drop an importer out of the cone and leave a
// stale judgment standing after its dep was edited.
fn driver_tree_scan(ref entry_module) with Memory + Alloc + Filesystem + Intern + GraphRead = {
  let modules = driver_canonical_order(driver_collect_dag(entry_module))
  let paths = map(module_path_of, modules)
  map(
    (entry) => match module_source_of(entry) {
      Some(text) => (
        module_path_of(entry),
        str_hash(text),
        filter(
          (dep_path) => contains_module(paths, dep_path),
          map(driver_module_path, module_imports_of(entry))
        )
      ),
      None => (module_path_of(entry), 0, []),
    },
    modules
  )
}

fn scan_pairs(ref scan) with Memory + Alloc = map(
  (t) => match t {
    (m, h, _) => (m, h),
  },
  scan
)

// The cache path is keyed by ENTRY alone — the weave's state lives in
// the manifest INSIDE the image, so a changed tree still finds its old
// image and re-derives only the changed cone (a weave-keyed filename
// could never be found again after any edit). The path is CWD-RELATIVE
// (the shim mounts the project at "."), so a compile whose cwd sits on
// tmpfs mints this cache into RAM — measured 2026-07-31: one fleet
// morning parked 4.3GB of images on /tmp and fed the OOM that killed a
// session; probe runs work under .build/probe, never /tmp. Nothing
// prunes sibling images yet (19 entries held 7.2GB) — keep-newest-N
// retention is this writer's own named follow-up.
fn driver_warm_path(ref entry_module) with Memory + Alloc =
  ".build/warm-compile-e{int_to_str(str_hash(entry_module))}.img"

fn driver_warm_ready(path) with Memory + Alloc + Filesystem = if fs_exists(path) {
  let wire = fs_read_file(path)
  if byte_len(wire) >= 16 {
    let p = str_payload(wire)
    load_i32(p) == image_key()
  } else {
    false
  }
} else {
  false
}

fn driver_compile_entry(ref entry_module) with Memory + Alloc + ImageAlloc + Cast + Persist + Fail + WASI + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + DiagRegister + LookupTy + Verify + InferCtx + Intern + Mutate + BranchEnv + Consume + WasiThreads = {
  let path = driver_warm_path(entry_module)
  if driver_warm_ready(path) {
    eprint_string("warm: restoring the analyzed image\n")
    image_resume(path)
    driver_incremental()
  } else {
    match driver_entry_with_ranges(entry_module) {
      (ast, ranges) => {
        driver_warm_persist(
          entry_module,
          split_weave_by_module(ast, ranges),
          scan_pairs(driver_tree_scan(entry_module))
        )
        ast
      },
    }
  }
}

// Persist the analyzed state whole — the ast root, the manifest, the
// entry name — one image, only when the analysis is CLEAN (the
// diagnostics ledger rides the image as counts, not replayable prints)
// AND the image fits its own wire: image_pack allocates a second
// image-sized buffer above the line, and the allocator's bound
// arithmetic crosses at the signed 2GB boundary — measured 2026-07-30,
// a 1017MB line trapped where 807MB packed clean. The warm cache is
// best-effort POLICY, so past the capacity it skips loudly and the
// next run derives cold; the capacity itself dissolves with the
// per-decl arena's image/scratch split (§5.O layer 3).
fn driver_warm_persist(ref entry_module, ref asts, ref pairs) with Memory + Alloc + Cast + Persist + WASI + Filesystem + Diagnostic = if diag_errors() == 0 {
  // The capacity read is SIGNED, so a heap line past 2GB reads NEGATIVE
  // and `negative < 960MB` waved it through — the guard inverting at
  // exactly the loads it exists to refuse (measured 2026-07-31: four
  // frontier fixtures whose judgment crossed 2GB walked the persist into
  // alloc's 4GB wraparound trap under the gate's invocation). The
  // non-negative conjunct is the signed word's own honest bound.
  let line = heap_mark()
  if line >= 0 && line < 960 * 1048576 {
    fs_mkdir(".build")
    list_set(warm_asts, 0, asts)
    list_set(warm_manifest, 0, pairs)
    list_set(warm_entry, 0, entry_module)
    persist(addr(asts), driver_warm_path(entry_module))
  } else {
    eprint_string("warm: image past the wire capacity — skipping the persist (cold next run)\n")
  }
} else {
  ()
}

// Attribute each weave statement to its module by the range map's line
// spans — the split runs once at persist and its buckets ARE the
// incremental cursor's reuse units.
// The bucket is keyed by the module's PATH, the same identity the tree scan
// and the manifest use — these pairs are read back by assoc_stmts on the warm
// path, and a name key here against a path key there silently returns EMPTY
// for every cached module: the incremental compile then emits the cone alone
// and drops the whole restored program (measured — 2933 bytes against the
// cold compile's 37644, the frontier's warm-inc divergence leg). The range
// tuple carries name AND path; range_of_module keeps matching the NAME,
// because that one is addressed by what a user typed.
fn split_weave_by_module(ref ast, ref ranges) with Memory + Alloc = map(
  (r) => match r {
    (_m, p, start, nlines) => (p, filter(
      (stmt) => match stmt {
        N(_, sp, _) => match sp {
          Span(sl, _, _, _) => sl >= start && sl < start + nlines,
        },
      },
      ast
    )),
  },
  ranges
)

fn assoc_stmts(ref pairs, name: String) with Memory + Alloc = match find(
  (pr) => match pr {
    (m, _) => m == name,
  },
  pairs
) {
  Some(pr) => match pr {
    (_, ss) => ss,
  },
  None => [],
}

// ─── The incremental cursor (§2 cached-cursor mode, cross-run) ───────
// Runs entirely in the RESTORED world: the manifest and entry name are
// restored roots; the current tree reads fresh off the host fs. An empty
// diff is the pure warm hit; a changed cone re-derives IN the restored
// image — re-registration shadows the stale entries (the env's latest
// edge wins), the graph grows monotonically, and the entry is ALWAYS in
// a nonempty cone (every DAG module is one of its transitive deps, so
// the downstream closure of any change reaches it). The re-judged state
// re-persists, so the image tracks the tree edit by edit.
fn driver_incremental() with Memory + Alloc + ImageAlloc + Cast + Persist + Fail + WASI + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx + Intern + Mutate + BranchEnv + Consume + WasiThreads + DiagRegister = {
  let entry = list_index(warm_entry, 0)
  let scan = driver_tree_scan(entry)
  let cur_pairs = scan_pairs(scan)
  let changed = changed_modules(list_index(warm_manifest, 0), cur_pairs)
  if len(changed) == 0 {
    eprint_string("warm: image current — nothing re-derived\n")
    warm_program()
  } else {
    let cone = downstream_closure(scan, changed)
    eprint_string("warm: re-deriving {names_join(cone)}\n")
    let fresh = rederive_cone(cone)
    let old_asts = list_index(warm_asts, 0)
    // The full program reassembles in the scan's own canonical order: an
    // unchanged module contributes its restored (already-inferred)
    // bucket, a cone module its fresh one — lower and emit see the whole
    // weave either way.
    let merged = scan |> map((t) => match t {
      (m, _, _) => (m, if module_in(cone, m) { assoc_stmts(fresh, m) } else { assoc_stmts(old_asts, m) }),
    })
    driver_warm_persist(entry, merged, cur_pairs)
    flatten(map(
      (pr) => match pr {
        (_, ss) => ss,
      },
      merged
    ))
  }
}

// A module changed when its current hash differs from the manifest's, or
// the manifest never saw it. A VANISHED module needs no arm of its own:
// whoever imported it changed by text (the dropped import), and a module
// nothing imports is not in the DAG at all.
fn changed_modules(ref old_pairs, ref cur_pairs) with Memory + Alloc = cur_pairs |> filter((pr) => match pr {
  (m, h) => manifest_hash_of(old_pairs, m) != h,
}) |> map((pr) => match pr {
  (m, _) => m,
})

fn manifest_hash_of(ref pairs, name: String) with Memory + Alloc = match find(
  (pr) => match pr {
    (m, _) => m == name,
  },
  pairs
) {
  Some(pr) => match pr {
    (_, h) => h,
  },
  None => 0,
}

// The downstream closure over the scanned tree: a module joins the cone
// when any of its deps is in it; iterate to the fixpoint, then project
// the cone in the scan's canonical (deps-first) order so re-derivation
// reads every re-judged dep before its importer.
fn downstream_closure(ref scan, changed) with Memory + Alloc = {
  let dag = map(
    (t) => match t {
      (m, _, deps) => (m, deps),
    },
    scan
  )
  let cone = closure_fix(dag, changed)
  scan |> map((t) => match t {
    (m, _, _) => m,
  }) |> filter((m) => module_in(cone, m))
}

fn closure_fix(ref dag, cone) with Memory + Alloc = {
  let grown = fold(
    cone,
    (acc, md) => match md {
      (m, deps) => if module_in(acc, m) {
        acc
      } else if any((d) => module_in(acc, d), deps) {
        push(acc, m)
      } else {
        acc
      },
    },
    dag
  )
  if len(grown) == len(cone) { cone } else { closure_fix(dag, grown) }
}

fn module_in(ref xs, m: String) with Memory + Alloc = any((x) => x == m, xs)

fn names_join(ref xs) with Memory + Alloc =
  fold("", (acc, m) => if byte_len(acc) == 0 { m } else { "{acc} {m}" }, xs)

// Re-judge the cone in canonical order (deps before importers by the
// closure's own projection): each module parses fresh and infers into
// the restored world — re-registration shadows its stale entries — and
// keeps its statement bucket for the reassembly.
// ImageAlloc: the same deletion as driver_check_module above — the branch's
// allocation stopped hiding behind a thread boundary.
// The cone's elements ARE paths (driver_tree_scan's identity), so the read
// is the read — the driver_module_path call that stood here re-resolved a
// name the scan had already resolved, and against a path it would not have
// resolved at all.
fn rederive_cone(ref cone) with Memory + Alloc + ImageAlloc + WASI + Filesystem + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + LookupTy + Verify + InferCtx + Intern + Cast + BranchEnv + Consume + WasiThreads + DiagRegister = map(
  (m) => {
    let ast = infer_program_converged(fs_read_file(m))
    (m, ast)
  },
  cone
)

fn driver_check_entry(ref entry_module) with Memory + Alloc + ImageAlloc + Filesystem + WASI + EnvRead + EnvWrite + GraphRead + GraphWrite + Diagnostic + DiagRegister + LookupTy + Verify + InferCtx + Intern + Cast + Mutate + BranchEnv + Consume + WasiThreads = {
  // Check the deps DAG (every module the entry imports) — not the entry.
  // "Not the entry" is an IDENTITY question, so it is asked of the path: the
  // entry reached by one spelling and collected under its resolved path is
  // the same module, and a spelling-compare here would judge it twice.
  let entry_path = driver_module_path(entry_module)
  entry_module |> driver_collect_dag_with_deps |> filter((m_with_deps) => match m_with_deps {
    (m, _) => module_path_of(m) != entry_path,
  }) |> driver_partition_layers |> each((layer) => each(driver_check_module, layer))
  // Parse + infer the entry ONCE; its AST is what compile lowers live.
  // An unreadable entry REPORTS, never parses emptiness — the silent
  // form answered zero fns at exit 0 on every analysis verb whenever
  // the path had no mount route (measured: `mentl audit <abs-path>`
  // from outside the repo printed nothing and exited clean).
  let path = driver_module_path(entry_module)
  if fs_exists(path) {
    infer_program_converged(fs_read_file(path))
  } else {
    report(EMissingModule(entry_module, path, span_zero()))
    []
  }
}

// Walk the post-order DAG and pair each module with its in-DAG deps.
// In-DAG: dep PATHS that appear among the collected modules (filters
// out missing-module fallbacks that have no source). Returns
// `[(entry, [dep_path])]` in post-order.
// Each module's imports come from the walk that already read them; the
// in-DAG filter drops out-of-DAG modules (missing ones, vocabulary aliases
// the driver doesn't process), which contribute nothing to the layer
// partition's wait condition. A missing module carries no imports, which is
// the same empty list its own fs_exists test used to produce.
//
// The dep edge is matched on the RESOLVED PATH for the same reason the
// visited set keys it: an importer spelling a dep one way and the DAG
// holding it under another is one module, and a name-match would drop the
// edge — the partition would then run the importer before its dep, which
// is the identity bug wearing an ordering costume. The PAIR carries the
// whole entry, so the per-module check reads the name for its diagnostic
// and the path for its read instead of re-resolving either by name.
fn driver_collect_dag_with_deps(ref entry_module) with Memory + Alloc + Filesystem + Intern + GraphRead = {
  let modules = driver_collect_dag(entry_module)
  let paths = map(module_path_of, modules)
  map(
    (entry) => (
      entry,
      filter(
        (dep_path) => contains_module(paths, dep_path),
        map(driver_module_path, module_imports_of(entry))
      )
    ),
    modules
  )
}

fn contains_module(ref modules: [String], ref target: String) with Memory + Alloc =
  any((m) => m == target, modules)

// Partition modules-with-deps into topological layers. Each pass
// peels off the "ready set" — modules whose deps are all processed.
// Iteration bound: DAG depth (typically ≤ 10 for a wheel-class graph).
fn driver_partition_layers(ref modules_with_deps) with Memory + Alloc =
  driver_partition_peel(modules_with_deps, [], [])

// processed / layers_rev pinned (the Intent Boundary): both thread from []
// through the recursion, so their element types have no other source — an
// unpinned `processed ++ layer_paths` floored the concat in m3's copy.
// `processed` is the set of module IDENTITIES already ordered, so it carries
// PATHS — the same key the dep edges and the visited set use, because a
// wait condition comparing a different key than the edges is the identity
// bug one layer up. The layers themselves carry whole entries.
fn driver_partition_peel(ref remaining, ref processed: [String], ref layers_rev: [[ModuleEntry]]) with Memory + Alloc = if len(remaining) == 0 {
  reverse(layers_rev)
} else {
  let layer_pairs = filter(
    (m_with_deps) => match m_with_deps {
      (_, deps) => all((d) => contains_module(processed, d), deps),
    },
    remaining
  )
  if len(layer_pairs) == 0 {
    // Cycle or unsatisfiable dep — process remaining sequentially
    // as a final layer to surface diagnostics at driver_check_module.
    let leftover = map(((m, _)) => m, remaining)
    reverse([leftover] ++ layers_rev)
  } else {
    let layer_entries = map(((m, _)) => m, layer_pairs)
    let layer_paths = map(module_path_of, layer_entries)
    let next_remaining = filter(
      (m_with_deps) => match m_with_deps {
        (m, _) => !contains_module(layer_paths, module_path_of(m)),
      },
      remaining
    )
    let next_processed = processed ++ layer_paths
    driver_partition_peel(next_remaining, next_processed, [layer_entries] ++ layers_rev)
  }
}
