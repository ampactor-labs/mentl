// cursor_transport.mn — the cursor's projection handed to a person: a
// transport renders the CursorView at the cursor's argmax, reads what the
// person does there, and folds it into the next step, the `<~` loop at the
// human boundary. Every transport is a handler on the one Surface effect,
// so swapping the handler swaps the surface over the same kernel.
import types

import cursor

import driver

import effects

import egraph

import format

import fs

import io

import mentl

import query

import strings

import verify

// ─── The Surface effect ─────────────────────────────────────────────
//
// One effect; four canonical handlers. Each handler renders the
// CursorView for its target surface. The Surface effect is HOW the
// medium speaks to the human — every IDE, LSP, terminal hover,
// browser-WASM editor, vim plugin routes through here.
effect Surface {
  /// Render the eight-aspect CursorView at the cursor's position.
  /// Called whenever CursorRead's argmax shifts (graph delta + caret
  /// change). Cadence is the transport's responsibility.
  surface_render(Cursor, CursorView)
  /// Receive an action from the human — accept, defer, override,
  /// caret-move. The transport translates input events into Action
  /// values; the kernel reads them through the same effect.
  surface_action() -> Action
  /// Negotiate transport readiness (handshake; LSP-style for IDEs;
  /// no-op for terminal). Called once per session.
  surface_handshake()
}

// ─── ADTs the transport reads + writes ──────────────────────────────
//
// What the human does at a Cursor's surfaced proposal: accept it (apply
// the gradient's suggestion and commit the patch) or defer it (the cursor
// advances to the next argmax).
type Action = AccAccept | AccDefer

// The transport's one record: the caret, the cursor, the reason of the last
// render and the session's step count.
type TransportState = {caret: Caret, cursor: Cursor, last_render: Reason, session_id: Int}

fn transport_state_init(initial_caret) = TransportState({
  caret: initial_caret,
  cursor: Cursor(0, Inferred("session-init"), 0.0),
  last_render: Inferred("none"),
  session_id: 0,
})

// ─── terminal_transport — text-mode rendering ───────────────────────
//
// The simplest transport: reads CursorView, writes ANSI-formatted
// text to fd 1 (stdout). Used by `mentl teach`, `mentl query`, and
// terminal-only sessions. Eight-tentacle voice surfaces as labeled
// blocks; cadence default = on-explicit-ask (CLI is interactive).
handler terminal_transport with state = transport_state_init(Caret(0, Inferred("term-init"))) {
  surface_handshake() => {
    // Verb-neutral: terminal_transport serves teach, query, AND edit —
    // a handshake naming one verb lies on the other routes.
    print_string("Mentl — eight tentacles ready.\n")
    resume()
  },
  surface_render(cursor, view) => {
    print_string(render_cursor_block(cursor, view))
    resume() with state = state_with_render(state, cursor)
  },
  surface_action() => resume(parse_action(read_stdin_line())),
}

// render_cursor_block — project the eight-aspect CursorView to its
// terminal block form. Pure of I/O: the projection composes the
// labeled aspects into ONE string; the transport arm writes it at
// the WASI boundary in one print_string. Any text-mode surface
// (terminal, CI log, doc snapshot) reads the same projection.
fn render_cursor_block(cursor, view) with !Mutate = match view {
  CursorView(query, propose, topology, row, trace, verify, teach, why) => "Mentl @ " ++ show_handle_label(cursor) ++ "\n────────────────────────────────────────────\n" ++ "Query    │ " ++ show_node_kind(query) ++ "\nPropose  │ " ++ show_proposals(propose) ++ "\nTopology │ " ++ show_verb_path(topology, show_span) ++ "\nRow      │ " ++ show_row_facet(row) ++ "\nTrace    │ " ++ show_ownership(trace) ++ "\nVerify   │ " ++ show_verify_count(verify) ++ "\nTeach    │ " ++ show_teaching(teach) ++ "\nWhy      │ " ++ join(" — its type: ", map(show_reason, why)) ++ "\n",
}

// ─── LSP / web / vim transports — peer frame-adapters ───────────────
//
// The terminal_transport above IS the live cursor projection. LSP, web,
// and vim are PEER transports: the SAME Surface effect, the SAME
// CursorView projection, only the outermost frame-adapter differs (LSP =
// JSON-RPC, web = DOM, vim = nvim-RPC). The LSP transport's canonical
// home is `src/lsp.mn` — it routes JSON-RPC frames through the Interact/
// Query projection (consult/propose over the live graph), the rust-
// analyzer-surpassing form where one cursor read answers hover /
// completion / references / diagnostics. No second LSP stack lives here;
// duplicating its LspMessage/bridges was the two-parallel-mechanisms
// drift (the file failing its own one-cursor-N-transports thesis).
//
// The browser-WASM DOM wire and the nvim-RPC wire are the ONLY
// genuinely-external boundary — they cross out of the medium into the
// host's event surface. Named positive-form peers (the external-transport
// boundary, peer of the web IDE), each a thin frame-adapter that consults
// the SAME Interact projection terminal_transport and src/lsp.mn share:
//   Hμ.cursor.transport.web-dom-wire   — browser keystroke/DOM event ↔ Surface
//   Hμ.cursor.transport.nvim-rpc-wire  — Neovim virtual-text/RPC ↔ Surface
// Their absence is the statement: the projection is one; only the wire is
// per-host, and a wire is implemented at the host boundary, not fabricated
// as dead Mentl that never installs.
//
// ─── The bus-compressor loop — `<~` at the human boundary ───────────
//
// Per the cursor walkthrough §3.4 + PLAN §1: the kernel's
// primitive #3 (five verbs) describes the medium's own editing
// model. The cursor-transport loop IS `<~` applied at the human-
// medium boundary. Pipe verbs are visible on the page; the loop
// is visible in the substrate.
//
// The edit session IS the `<~` feedback verb at the human-medium
// boundary (SYNTAX.md §`<~`): one cycle's output state loops back as the
// next cycle's input under the Surface iterate-class context. The DELETED
// hand-rolled tail-recursion (cursor_loop calling itself per arm) was the
// `<~` verb un-named — the exact drift the prime directive forbids. The
// state threads through `<~ accumulate`; cursor_step is one cycle.
fn cursor_session(initial_caret) = {
  surface_handshake()
  transport_state_init(initial_caret) |> cursor_step <~ accumulate(transport_state_init(initial_caret))
}

// cursor_step — ONE feedback cycle: project the cursor + view, render,
// read the human action, fold it into the next state. The `<~` closure
// feeds this next state back as the cycle's input (no self-recursion —
// the feedback verb carries the loop).
fn cursor_step(state) = match state {
  TransportState(s) => {
    // Compute the cursor: gradient argmax with caret bias.
    let cursor = cursor_argmax(s.caret)
    // Project the eight-aspect CursorView at the cursor's own handle — it
    // was re-resolved through its span, a scan that cannot tell one file's
    // line 3 from another's.
    let view = cursor_at_handle(handle_of_cursor(cursor))
    // Render through the installed transport handler.
    surface_render(cursor, view)
    // Receive an action from the human, fold into the next state.
    match surface_action() {
      AccAccept => {
        apply_suggestion(cursor, view)
        state_advance(state, cursor)
      },
      AccDefer => state_advance(state, cursor),
    }
  },
}

// ─── Helpers ────────────────────────────────────────────────────────
fn state_advance(state, latest_cursor) = match state {
  TransportState(s) => match latest_cursor {
    Cursor(_, reason, _) => TransportState({caret: s.caret, cursor: latest_cursor, last_render: reason, session_id: s.session_id + 1}),
  },
}

fn state_with_render(state, cursor) = match state {
  TransportState(s) => match cursor {
    Cursor(_, reason, _) => TransportState({caret: s.caret, cursor, last_render: reason, session_id: s.session_id}),
  },
}

fn handle_of_cursor(cursor) = match cursor {
  Cursor(handle, _, _) => handle,
}

// handle_at_span() — see src/cursor.mn (the module-scoped resolver).
fn apply_suggestion(cursor, view) = match cursor {
  Cursor(handle, _, _) => match view {
    // A hole accepts its PROPOSE survivor: the verdict says whether there
    // is one, and the accept path READS it rather than re-deriving it from
    // a survivor count. `VAsk` is the teaching TIE-BREAK — surface the
    // question, never guess between proven survivors (PLAN §5); `VNone`
    // and non-hole positions accept the teach annotation.
    CursorView(_, propose, _, _, _, _, teach, _) => match propose {
      Proposal(p) => match p.verdict {
        VFill(survivor, reason) => if authored_hole(handle) {
          accept_fill(handle, survivor, reason)
        } else {
          accept_teaching(handle, teach)
          ()
        },
        VAsk(_, _) => {
          accept_teaching(handle, teach)
          ()
        },
        VNone => {
          accept_teaching(handle, teach)
          ()
        },
      },
    },
  },
}

// THE ACCEPT IS A GRAPH WRITE, AND THE TEXT IS ITS PROJECTION (C4,
// 2026-09-30). Until this landing an accept was a text splice alone: the
// medium proposed a value with a proof, the developer accepted, and the
// graph forgot both — the re-derived node read as an authored literal and
// `Why` at the position said "int literal", the one hop that was false.
// The edge is drawn FIRST — the module path and the extent the rendered
// text will occupy, the text, and the proof the proposal carried — and the
// splice that re-derives the module is what makes the edge readable: the
// node minted at that extent is bound with its reason wrapped in
// `Accepted`, so the Why walks from the value to the proposal that proved
// it. One home for both routes: the edit session's `y` and the address
// form's `mentl accept` call this.
fn accept_fill(handle, survivor, proof) with !Mutate = {
  let span = graph_span_of(handle)
  let text = render_candidate_source(survivor)
  let module = module_name_of_handle(graph_module_of(handle))
  match driver_module_path(module) {
    Some(path) => {
      graph_accept_note(module, accepted_extent(span, text), text, proof)
      write_module(module, splice_span(fs_read_file(path), span, text))
    },
    None => eprint_string("mentl accept: `{module}` resolves to no file — nothing written\n"),
  }
}

// THE GRADIENT'S ACCEPT (D4). A declaration's position carries no proposal;
// what it carries is the gradient's answer, the one the Teach facet renders
// there, accepted by the same verbs: one proven annotation is written into
// the declaration's head; a question is refused with its alternatives named
// (a tie between meanings is never guessed); a need says what is missing;
// nothing to accept says so. Answers whether anything was written.
fn accept_teaching(handle, teach) = match teach {
  TeachAdd(s) => accept_annotation(handle, s),
  TeachAsk(_) => {
    eprint_string("mentl accept: {show_teaching(teach)}\n")
    false
  },
  TeachNeed(_, _, _) => {
    eprint_string("mentl accept: nothing to write — {show_teaching(teach)}\n")
    false
  },
  TeachNone => {
    eprint_string("mentl accept: no proposal at this position\n")
    false
  },
}

// AN ACCEPTED ANNOTATION IS A HEAD THE FORMATTER WRITES (2026-10-01; the
// refinements D4). The proven annotation joins the declaration's own head —
// a clause its row, a precondition its parameter's type, a contract its
// return — and the head is re-rendered by the formatter's head render
// (`render_fn_head`) and spliced over the head it replaces, in the file of
// the module the declaration belongs to. Until 2026-10-01 the accept
// inserted the suggestion's TEXT as a new line above the declaration's line
// number, in the session's target file: `  with Pure` above `fn add(a, b) =
// a + b` never parses, and a suggestion at another module's declaration
// landed at that line of the wrong file. The head render is guarded by the
// formatter's conservation census: a head whose render would lose a name, a
// literal or a comment is not written.
fn accept_annotation(handle, s) = match s {
  AnnotationSuggestion(ann, _, _) => match graph_node_body(handle) {
    NStmt(FnStmt(name, params, retty, effs, body)) => {
      let module = module_name_of_handle(graph_module_of(handle))
      match driver_module_path(module) {
        None => {
          eprint_string("mentl edit: `{module}` resolves to no file — nothing written\n")
          false
        },
        Some(path) => match splice_decl_head(
          fs_read_file(path),
          graph_span_of(handle),
          graph_span_of(body),
          annotated_head(ann, name, params, graph_node_body(retty), effs),
          stated_by(ann, params)
        ) {
          Some(edited) => {
            write_module(module, edited)
            true
          },
          None => {
            eprint_string("mentl edit: `{name}`'s head did not render conserved — nothing written\n")
            false
          },
        },
      }
    },
    _ => {
      eprint_string("mentl edit: the suggestion's position is not a declaration — nothing written\n")
      false
    },
  },
}

// The head an annotation writes: the declaration re-rendered with the
// clause joined to its row, a parameter's type set to the alias, or the
// return set to it. `ret` is the declaration's return annotation itself,
// and a return contract writes the alias as the annotation in its place.
fn annotated_head(ann, name: String, params, ret, effs) with !Mutate = match ann {
  APure(_) => render_fn_head(name, params, ret, effs ++ [(RtEff(EPure, None), false, EcUnion)]),
  ANotEffect(n, _) => render_fn_head(name, params, ret, effs ++ [(RtEff(ENamed(intern_str(n)), None), true, EcUnion)]),
  ARefined(r) => fn_head_text(name, join(", ", map(restated_param(r.param, r.alias, ??), params)), ret, effs),
  AReturns(r) => render_fn_head(name, params, NTypeAnn(TName(r.alias, [])), effs),
}

// The parameter the refinement restates renders with the alias as its
// annotation; every other renders as written.
fn restated_param(pname: String, alias: String, p) with !Mutate = if param_binder(p) == pname {
  render_param_typed(param_of(p), ": {alias}")
} else {
  render_one_param(p)
}

// The written names an annotation replaces that its alias still states: a
// refinement over a parameter written with a word type keeps that type as
// the base the alias's own declaration names (`type NonZero = Int where
// …`), so the census counts it present. A clause, a contract, and a
// refinement over an unannotated parameter replace nothing.
fn stated_by(ann, params) = match ann {
  ARefined(r) => params |> flat_map(written_base(r.param, r.contract, ??)),
  APure(_) => [],
  ANotEffect(_, _) => [],
  AReturns(_) => [],
}

fn written_base(pname: String, contract, p) = match param_ann(p) {
  Some(a) => {
    let ty = ann_ty_of(a)
    if param_binder(p) == pname && is_word_base(ty) && same_base(base_of(contract), ty) {
      [show_type(ty)]
    } else {
      []
    }
  },
  None => [],
}

// The head is the source from the declaration's start to the whitespace
// before its body; the new head replaces it and the whitespace stays, so
// a body on the next line stays there. The splice answers None when the
// replaced head held a comment or any name or literal the new head does
// not and the annotation does not state — the conservation census the fmt
// verb answers to.
fn splice_decl_head(ref source, decl_sp, body_sp, ref head: String, stated: [String]) = {
  let n = byte_len(source)
  match decl_sp {
    Span(dl, dc, _, _) => match body_sp {
      Span(bl, bc, _, _) => {
        let start = line_start(source, dl) + (dc - 1)
        let body_at = line_start(source, bl) + (bc - 1)
        let head_end = fold(
          body_at,
          (e, i) => if is_space_byte(byte_at(source, i)) && i + 1 == e { i } else { e },
          reverse(range(start, body_at))
        )
        let old_toks = lex(str_slice(source, start, head_end))
        if count_comment_tokens(old_toks, 0, 0) > 0 || len(lost_atoms_beside(old_toks, lex(head), stated)) > 0 {
          None
        } else {
          Some("{str_slice(source, 0, start)}{head}{str_slice(source, head_end, n)}")
        }
      },
    },
  }
}

fn is_space_byte(b) with Pure = b == 32 || b == 10 || b == 9 || b == 13

// The extent the accepted text occupies after the splice: the hole's own
// start, and the text's width past it. Every candidate renders on one line
// (a literal, a bare name, a zero-argument call), so the end line is the
// start line.
fn accepted_extent(span, text: String) = match span {
  Span(sl, sc, _, _) => Span(sl, sc, sl, sc + byte_len(text)),
}

// The address form's accept: the position's Propose verdict decides at a
// hole, and only a single proven survivor at an authored hole draws the
// edge. A tie is the question the medium asks, never a guess between proven
// survivors; a filled position has nothing to accept. A position with no
// proposal accepts the gradient's answer there (D4) — `mentl accept
// main.mn:4:1` on a declaration writes the annotation its Teach facet names.
// Answers whether anything was written, so the verb's exit code is the
// verdict.
fn accept_at(handle, view) = match view {
  CursorView(_, propose, _, _, _, _, teach, _) => match propose {
    Proposal(p) => match p.verdict {
      VFill(survivor, reason) => if authored_hole(handle) {
        accept_fill(handle, survivor, reason)
        true
      } else {
        eprint_string("mentl accept: the position is filled — a proposal is accepted at a hole\n")
        false
      },
      VAsk(divergence, survivors) => {
        eprint_string("mentl accept: {int_to_str(len(survivors))} proven survivors — a tie is a question, never a guess: {show_divergence(divergence)}\n")
        false
      },
      VNone => accept_teaching(handle, teach),
    },
  },
}

// A survivor renders as its SOURCE — the formatter's own token projection
// of the candidate node, which is what the accept splices and what the
// developer reads: a literal, a bare name, `f()`, `Some(??)` with the
// value the next fill supplies, `[]`, `(??, ??)`, `{x: ??, y: ??}`, a lambda
// skeleton. Until C7 this was a literal renderer with a hole-marker floor,
// so every structured candidate showed as `??` — the medium showing a
// proposal it could not name (`Hβ.felt.candidate-render-is-format`, closed).
fn render_candidate_source(node) with !Mutate = render_body_tokens(node, graph_node_body(node))

// ─── Format / parse helpers per transport ──────────────────────────
fn show_handle_label(cursor) = match cursor {
  Cursor(handle, _, _) => "handle={int_to_str(handle)}",
}

fn show_node_kind(kind) with Pure = match kind {
  NBound(_) => "bound",
  NFree(_) => "free",
  NRowBound(_) => "row-bound",
  NRowFree(_) => "row-free",
  NRecordRowBound(_, _) => "record-row-bound",
  NErrorHole(_) => "error-hole",
}

fn show_proposals(props) with !Mutate = match props {
  Proposal(p) => {
    let verdict_block = show_verdict(p.verdict)
    // The rejections TEACH: each row-refused name keeps its Why on the same
    // projection (a pruned candidate the developer cannot see is a guess
    // they cannot audit — PLAN §5).
    if len(p.rejected) == 0 {
      verdict_block
    } else {
      "{verdict_block}{str_concat_all(map(show_one_rejection, p.rejected))}"
    }
  },
}

// The edit transport's own voice for the verdict. A tie carries its
// divergence here too — the question is computed once in synth, so every
// surface says the same thing about the same tie.
fn show_verdict(verdict) with !Mutate = match verdict {
  VNone => "(none)",
  VFill(node, reason) => "1 candidate(s){show_one_proposal((node, reason))}",
  VAsk(divergence, survivors) => "{int_to_str(len(survivors))} candidate(s){str_concat_all(map(show_one_proposal, survivors))} · {show_divergence(divergence)}",
}

// The pair pin is an Intent Boundary (spec_mangle's law): name's only
// use is the splice, so unpinned it generalizes and the floor renders
// the rejected candidate as a pointer numeral instead of its name.
fn show_one_rejection(pair: (String, Reason)) with !Mutate = match pair {
  (name, reason) => " · rejected {name} — {show_reason(reason)}",
}

// Each survivor: its source text and its Reason — the pair the Synth
// contract carries (the seed reason lives in the candidate record, not on
// the node's mint placeholder).
fn show_one_proposal(proposal) with !Mutate = match proposal {
  (node, reason) => " · {render_candidate_source(node)} — {show_reason(reason)}",
}

fn show_verify_count(preds) =
  if len(preds) == 0 { "no obligations" } else { "{int_to_str(len(preds))} pending" }

fn parse_action(line) with Pure =
  if line == "y" { AccAccept } else if line == "n" { AccDefer } else { AccDefer }

// ─── Patch — the apply-suggestion-to-file effect ────────────────────
//
// The Surface effect's terminal_transport projects the cursor; Patch is
// how an Accept lands a suggestion into the source. One effect, one
// handler (patch_to_file), composed in edit_run's chain.
//
// A write names the MODULE it writes — the module the accepted position
// was born in, read off its handle by the accept — and the target is only
// the entry the session re-derives after it. Until 2026-10-01 every write
// went to the target's file at the position's line numbers, whichever
// module the position was in.
effect PatchWrite {
  // the entry a write re-derives
  patch_set_target(String)
  // a module's whole new text, written to its file
  write_module(String, String)
}

// A patch RE-DERIVES the module through the ONE weave read the session and
// the address form project (driver_entry_with_ranges), never the per-module
// check walk. The walk parsed each module in its own span space under
// whatever module was last in force, so the generation it minted was not
// addressable: `mentl accept` re-projected its position and found the OLD
// hole, typed and proposing, while the file already carried the accepted
// value (measured 2026-09-30, the first probe of C4). One read, one span
// space, and the accepted node is the one the address reaches.
// A module's new text, written to the file its name resolves to. A module
// that resolves to no file is never given one: the write is refused aloud,
// because the path a missing module would get is a guess.
fn module_write(module: String, text: String) = match driver_module_path(module) {
  Some(path) => fs_write_file(path, text),
  None => eprint_string("mentl: `{module}` resolves to no file — nothing written\n"),
}

handler patch_to_file with target_module = "" {
  patch_set_target(name) => resume() with target_module = name,
  write_module(module, text) => {
    module_write(module, text)
    driver_link(target_module)
    resume()
  },
}

// A patch the RESIDENT SESSION writes: the text lands in the module's file
// and nothing re-derives here, because the session's living check is the one
// door a moved tree comes through — it re-judges the cone the write moved,
// exactly as it re-judges an edit made outside the session, and the session
// answers over that. Re-deriving here as well would judge one write twice,
// and the second time the whole weave.
handler patch_written {
  patch_set_target(_) => resume(),
  write_module(module, text) => {
    module_write(module, text)
    resume()
  },
}

// Replace the byte range a source span covers. Lines and columns are
// 1-based (the lexer's token spans); the end column is exclusive.
fn splice_span(ref source, ref span, ref text: String) = match span {
  Span(sl, sc, el, ec) => {
    let start = line_start(source, sl) + (sc - 1)
    let end = line_start(source, el) + (ec - 1)
    "{str_slice(source, 0, start)}{text}{str_slice(source, end, byte_len(source))}"
  },
}
