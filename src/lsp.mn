// lsp.mn — the LSP transport: an editor's JSON-RPC over stdio, answered by
// the same reads the medium's own verbs make.
//
// A frame becomes a JsonValue, an LspMessage and an LspMethodKind at the
// boundary; opening a document judges its module, and hover, diagnostics,
// definition and references read the judged graph — the type at a span,
// the open obligations, a name's declaration and its references — and
// project each answer back to JSON.
import types

import driver

import egraph

import io

import json

import lsp_frame

import mentl

import query

import strings

// ─── LspMessage — incoming JSON-RPC message shape ─────────────────────
//
// LspMessage — request (id + method + params), notification (method
// + params, no id), or response (id + result + optional error).
// Per drift mode 6 + H6: structural ADT, not flag-keyed.
type LspMessage
  = LspRequest(Int, String, JsonValue)
  | LspNotification(String, JsonValue)
  | LspResponse(Int, JsonValue, Option(JsonValue))

// LspMethodKind — classification ADT. LSP method strings come from
// the protocol (unavoidable string-keyed input); classify_method
// projects to this ADT IMMEDIATELY at the dispatch boundary;
// downstream code matches on LspMethodKind only. Per drift mode 8
// mitigation per MV-LSP-adapter §2.1.
type LspMethodKind
  = LspInitialize
  | LspInitialized
  | LspShutdown
  | LspExit
  | LspTextDocDidOpen
  | LspTextDocDidChange
  | LspTextDocDidSave
  | LspTextDocDidClose
  | LspTextDocHover
  | LspTextDocDiagnostic
  | LspTextDocDefinition
  | LspTextDocReferences
  | LspUnknown(String)

// LspResponseBody — typed shape of an LSP response payload. Each
// variant projects to JsonValue via response_to_json.
type LspResponseBody
  = LspNullResp
  | LspHoverResp(Option(HoverContent))
  | LspDiagnosticResp([LspDiagnostic])
  | LspDefinitionResp(Option(Location))
  | LspReferencesResp([Location])
  // server capabilities + serverInfo
  | LspInitializeResp(JsonValue)

// markdown text
type HoverContent = HoverContent(String)

type LspDiagnostic = LspDiagnostic(Int, Int, Int, Int, Int, String, String)

// sl, sc, el, ec, severity, code, message
type Location = Location(String, Int, Int, Int, Int)

// uri, sl, sc, el, ec
//
// ─── parse_lsp_message — JsonValue → LspMessage ───────────────────────
//
// parse_lsp_message — extract id / method / params from JsonValue.
// Per drift mode 6: explicit shape detection (request has id+method;
// notification has method no id; response has id+result no method).
// Anything else is an LspUnknown notification with empty params.
fn parse_lsp_message(v) = {
  let method_opt = json_obj_get(v, "method")
  let id_opt = json_obj_get(v, "id")
  let params = match json_obj_get(v, "params") {
    None => JNull,
    Some(p) => p,
  }
  match method_opt {
    Some(m_val) => {
      let method = json_str_or_default(m_val, "")
      match id_opt {
        Some(id_val) => {
          let id = json_int_or_default(id_val, 0)
          LspRequest(id, method, params)
        },
        None => LspNotification(method, params),
      }
    },
    None => {
      let id = match id_opt {
        None => 0,
        Some(id_val) => json_int_or_default(id_val, 0),
      }
      let result = match json_obj_get(v, "result") {
        None => JNull,
        Some(r) => r,
      }
      LspResponse(id, result, None)
    },
  }
}

// ─── classify_method — String → LspMethodKind ─────────────────────────
//
// classify_method — project the LSP method string to LspMethodKind
// ADT. The ONE place where strings cross into the dispatch substrate;
// downstream is ADT-only. Per drift mode 8: input strings are
// projected, not stored.
fn classify_method(method) = if method == "initialize" {
  LspInitialize
} else if method == "initialized" {
  LspInitialized
} else if method == "shutdown" {
  LspShutdown
} else if method == "exit" {
  LspExit
} else if method == "textDocument/didOpen" {
  LspTextDocDidOpen
} else if method == "textDocument/didChange" {
  LspTextDocDidChange
} else if method == "textDocument/didSave" {
  LspTextDocDidSave
} else if method == "textDocument/didClose" {
  LspTextDocDidClose
} else if method == "textDocument/hover" {
  LspTextDocHover
} else if method == "textDocument/diagnostic" {
  LspTextDocDiagnostic
} else if method == "textDocument/definition" {
  LspTextDocDefinition
} else if method == "textDocument/references" {
  LspTextDocReferences
} else {
  LspUnknown(method)
}

// ─── dispatch_request / dispatch_notification ─────────────────────────
//
// dispatch_request — request methods (require response). H6
// exhaustive over LspMethodKind. Notification-shaped methods that
// arrive as requests get LspNullResp (graceful protocol tolerance).
fn dispatch_request(kind, params) = match kind {
  LspInitialize => handle_initialize(params),
  LspShutdown => LspNullResp,
  LspTextDocHover => handle_hover(params),
  LspTextDocDiagnostic => handle_diagnostic(params),
  LspTextDocDefinition => handle_definition(params),
  LspTextDocReferences => handle_references(params),
  LspUnknown(_m) => LspNullResp,
  LspInitialized => LspNullResp,
  LspExit => LspNullResp,
  LspTextDocDidOpen => LspNullResp,
  LspTextDocDidChange => LspNullResp,
  LspTextDocDidSave => LspNullResp,
  LspTextDocDidClose => LspNullResp,
}

// dispatch_notification — notification methods (no response). H6
// exhaustive. Request-shaped methods that arrive as notifications
// are silently ignored.
fn dispatch_notification(kind, params) = match kind {
  LspInitialized => (),
  LspExit => (),
  LspTextDocDidOpen => handle_did_open(params),
  LspTextDocDidChange => (),
  LspTextDocDidSave => (),
  LspTextDocDidClose => (),
  LspInitialize => (),
  LspShutdown => (),
  LspTextDocHover => (),
  LspTextDocDiagnostic => (),
  LspTextDocDefinition => (),
  LspTextDocReferences => (),
  LspUnknown(_) => (),
}

// ─── LSP param extraction helpers ─────────────────────────────────────
//
// lsp_extract_uri — pull `params.textDocument.uri` String. Default
// empty when missing.
fn lsp_extract_uri(params) = match json_obj_get(params, "textDocument") {
  None => "",
  Some(td) => match json_obj_get(td, "uri") {
    None => "",
    Some(u) => json_str_or_default(u, ""),
  },
}

// lsp_extract_position — pull `params.position.{line, character}`.
// Returns (line, character) Ints. Default (0, 0) on missing.
fn lsp_extract_position(params) = match json_obj_get(params, "position") {
  None => (0, 0),
  Some(p) => {
    let line = json_int_or_default(json_obj_get_unwrap(p, "line"), 0)
    let ch = json_int_or_default(json_obj_get_unwrap(p, "character"), 0)
    (line, ch)
  },
}

fn json_obj_get_unwrap(v, key) = match json_obj_get(v, key) {
  None => JNull,
  Some(x) => x,
}

// position_to_span — LSP (line, character) → Mentl Span. LSP positions
// are 0-indexed; Mentl spans 1-indexed. v1 produces a zero-width span
// at (line+1, char+1); refined ranges (selection-aware) land as
// MV-LSP.range peer sub-handle.
fn position_to_span(pos) = match pos {
  (line, ch) => caret_span(line + 1, ch + 1),
}

// ─── handle_* — LSP method bodies ─────────────────────────────────────
//
// handle_initialize — the capabilities the transport answers: a document's
// open (which judges its module; its edits are not synced, change kind 0),
// hover, diagnostics, definition and references.
fn handle_initialize(_params) = {
  let caps = JObj([
    ("textDocumentSync", JObj([("openClose", JBool(true)), ("change", JNum(0.0))])),
    ("hoverProvider", JBool(true)),
    ("diagnosticProvider", JObj([])),
    ("definitionProvider", JBool(true)),
    ("referencesProvider", JBool(true))
  ])
  let server_info = JObj([("name", JStr("mentl-lsp")), ("version", JStr("0.1.0"))])
  let result = JObj([("capabilities", caps), ("serverInfo", server_info)])
  LspInitializeResp(result)
}

// handle_hover — the type of the node under the caret, with the reason it
// was bound for (`type_at_span`, the read `mentl query … type at` makes).
fn handle_hover(params) = match type_at_span(position_to_span(lsp_extract_position(params))) {
  None => LspHoverResp(None),
  Some((ty, reason)) => LspHoverResp(Some(hover_from_type(ty, reason))),
}

// handle_diagnostic — the open obligations the judged graph holds, each a
// diagnostic at its site.
fn handle_diagnostic(params) =
  LspDiagnosticResp(diagnostics_from_debt_lsp(verify_debt(), lsp_extract_uri(params)))

// handle_definition — resolve the identifier at the cursor, then read
// its binding span LIVE from the env entry's Located Reason (the graph
// proved where the name lives). No echo of the cursor's own position;
// the defining span IS the goto target. None when unresolved.
fn handle_definition(params) with !Mutate = {
  let uri = lsp_extract_uri(params)
  let span = position_to_span(lsp_extract_position(params))
  match name_at_span(span) {
    None => LspDefinitionResp(None),
    Some(name) => match defining_span_of(name) {
      None => LspDefinitionResp(None),
      Some(def_span) => LspDefinitionResp(Some(span_to_location(uri, def_span))),
    },
  }
}

// handle_references — the identifier at the cursor resolved, then every
// reference to it (`refs_of_name`, the read `mentl query … refs of` makes),
// each site a Location.
fn handle_references(params) with !Mutate = {
  let uri = lsp_extract_uri(params)
  match name_at_span(position_to_span(lsp_extract_position(params))) {
    None => LspReferencesResp([]),
    Some(name) => LspReferencesResp(spans_to_locations(map({ (_m, sp, _note) => sp }, refs_of_name(name)), uri)),
  }
}

// span_to_location — project a Mentl Span to an LSP Location at the doc URI.
fn span_to_location(uri, span) = match span {
  Span(sl, sc, el, ec) => Location(uri, sl, sc, el, ec),
}

// spans_to_locations — project each reference Span to a Location (buffer-rev
// accumulate; the projection is order-stable over the use-edge set).
fn spans_to_locations(spans, uri) = map_spans_to_locations(spans, uri, 0, len(spans), [])

fn map_spans_to_locations(spans, uri, i, n, acc_rev) = if i >= n {
  reverse(acc_rev)
} else {
  let loc = span_to_location(uri, list_index(spans, i))
  map_spans_to_locations(spans, uri, i + 1, n, [loc] ++ acc_rev)
}

// diagnostics_from_debt_lsp — project each pending obligation (span,
// predicate, reason) to an LSP LspDiagnostic. severity 1 = Error (a refinement
// the path could not discharge). The predicate's text is the message; the
// span is the obligation site (read live from the debt the graph holds).
fn diagnostics_from_debt_lsp(debt, uri) with !Mutate =
  map_debt_to_diagnostics(debt, 0, len(debt), [])

fn map_debt_to_diagnostics(debt, i, n, acc_rev) with !Mutate = if i >= n {
  reverse(acc_rev)
} else {
  match list_index(debt, i) {
    (_modh, span, predicate, reason) => match span {
      Span(sl, sc, el, ec) => {
        let diag = LspDiagnostic(
          sl,
          sc,
          el,
          ec,
          1,
          "E_RefinementRejected",
          "{show_predicate(predicate)}: {show_reason(reason)}"
        )
        map_debt_to_diagnostics(debt, i + 1, n, [diag] ++ acc_rev)
      },
    },
  }
}

// handle_did_open — judge the opened module's link into the session's graph,
// the one every later hover, definition and reference reads: the document
// and every module it reaches judged as one program, as the CLI judges it.
// The judgment's writes land in serve_run's session-level handlers, so they
// persist across the session; the client opens a document once, so it is
// judged once, and an edit is not re-judged (change kind 0).
fn handle_did_open(params) = {
  driver_link(uri_to_module(lsp_extract_uri(params)))
  ()
}

// uri_to_module — the opened document's module name for driver_link. Strips
// the file:// scheme (uri_to_path) and the .mn suffix; driver_module_path
// re-adds .mn and resolves it (its DIRECT-read arm accepts an absolute or
// relative path as itself), so an editor's file://<abs>/foo.mn reaches foo.mn
// from any directory — the same resolver `mentl check <path>` rides.
fn uri_to_module(uri) = {
  let p = uri_to_path(uri)
  if ends_with(p, ".mn") { str_slice(p, 0, byte_len(p) - 3) } else { p }
}

// uri_to_path — the path a file: URI names; any other scheme passes through.
fn uri_to_path(uri) = {
  let prefix = "file://"
  let plen = byte_len(prefix)
  if byte_len(uri) > plen && uri_starts_with(uri, prefix, 0, plen) {
    str_slice(uri, plen, byte_len(uri))
  } else {
    uri
  }
}

fn uri_starts_with(uri, prefix, i, n) = if i >= n {
  true
} else if byte_at(uri, i) == byte_at(prefix, i) {
  uri_starts_with(uri, prefix, i + 1, n)
} else {
  false
}

fn hover_from_type(ty, _reason) with !Mutate = {
  let type_text = show_type(ty)
  HoverContent("`{type_text}`")
}

// ─── response_to_json — LspResponseBody → JsonValue ───────────────────
//
// response_to_json — project the typed response shape to JsonValue
// for serialization. H6 over LspResponseBody.
fn response_to_json(body) = match body {
  LspNullResp => JNull,
  LspHoverResp(None) => JNull,
  LspHoverResp(Some(content)) => hover_content_to_json(content),
  LspDiagnosticResp(diags) => JObj([("kind", JStr("full")), ("items", JArr(map_diagnostics_to_json(diags, 0, len(diags), [])))]),
  LspDefinitionResp(None) => JNull,
  LspDefinitionResp(Some(loc)) => location_to_json(loc),
  LspReferencesResp(locs) => JArr(map_locations_to_json(locs, 0, len(locs), [])),
  LspInitializeResp(result) => result,
}

fn hover_content_to_json(content) = match content {
  HoverContent(md) => JObj([("contents", JObj([("kind", JStr("markdown")), ("value", JStr(md))]))]),
}

fn map_diagnostics_to_json(diags, i, n, acc_rev) = if i >= n {
  reverse(acc_rev)
} else {
  let d = list_index(diags, i)
  match d {
    LspDiagnostic(sl, sc, el, ec, severity, code, msg) => {
      let json = JObj([
        ("range", range_to_json(sl, sc, el, ec)),
        ("severity", JNum(float_of_int(severity))),
        ("code", JStr(code)),
        ("message", JStr(msg))
      ])
      map_diagnostics_to_json(diags, i + 1, n, [json] ++ acc_rev)
    },
  }
}

fn map_locations_to_json(locs, i, n, acc_rev) = if i >= n {
  reverse(acc_rev)
} else {
  let loc = list_index(locs, i)
  map_locations_to_json(locs, i + 1, n, [location_to_json(loc)] ++ acc_rev)
}

fn location_to_json(loc) = match loc {
  Location(uri, sl, sc, el, ec) => JObj([("uri", JStr(uri)), ("range", range_to_json(sl, sc, el, ec))]),
}

fn range_to_json(sl, sc, el, ec) = JObj([
  ("start", JObj([("line", JNum(float_of_int(sl - 1))), ("character", JNum(float_of_int(sc - 1)))])),
  ("end", JObj([("line", JNum(float_of_int(el - 1))), ("character", JNum(float_of_int(ec - 1)))]))
])

// ─── lsp_adapter handler + session loop ───────────────────────────────
//
// lsp_adapter — outermost handler in the Mentl chain. State carries
// msg_id_counter for outgoing notifications and initialized flag for the
// protocol state machine.
//
// Its `graph_mutated` arm DISCARDS the mutation; this block used to say it
// "subscribes to graph_mutated for push diagnostics (MV-LSP.push peer extends
// this)", which read as a live wire and is an intention. Nothing here pushes
// anything: the arm takes `(handle, prior value)` — the delta a push
// diagnostic would be computed FROM — and resumes. Corrected 2026-09-19 with
// its sibling at `mutate_sink` (graph.mn), the other half of the same
// write-only effect; `Hβ.graph.mutation-delta-is-write-only` carries the
// class, and push diagnostics are what this arm grows into when it does.
handler lsp_adapter with msg_id_counter = 0, initialized = false, shutdown_received = false {
  graph_mutated(_epoch, _mutation) => resume(),
}

// lsp_session — the session loop entry. Reads frames from stdin
// in a tail-recursive loop terminating on LspFrameEof; dispatches each
// message; writes responses to stdout. Composes through the full
// Mentl handler chain at install per MV-LSP-adapter §3.
fn lsp_session() = match read_lsp_frame() {
  LspFrameEof => (),
  LspFrame(body) => {
    let parsed = json_parse(body)
    let dispatch_input = match parsed {
      JOk(v, _) => v,
      JErr(_msg, _pos) => JNull,
    }
    let msg = parse_lsp_message(dispatch_input)
    handle_message(msg)
    lsp_session()
  },
}

fn handle_message(msg) = match msg {
  LspRequest(id, method, params) => {
    let kind = classify_method(method)
    let resp = dispatch_request(kind, params)
    let resp_json =
      JObj([("jsonrpc", JStr("2.0")), ("id", JNum(float_of_int(id))), ("result", response_to_json(resp))])
    write_lsp_frame(json_serialize(resp_json))
  },
  LspNotification(method, params) => {
    let kind = classify_method(method)
    dispatch_notification(kind, params)
  },
  LspResponse(_, _, _) => (),
}
