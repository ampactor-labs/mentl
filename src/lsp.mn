// lsp.mn — Mentl's LSP transport handler (MV-LSP.scaffold + dispatch + responses + handlers)
//
// Per MV-LSP-adapter walkthrough (commit 4d0fce1). Layer C of the
// transport stack: lsp_adapter handler + session loop + LSP method
// → Interact op routing + LspResponseBody projection.
//
// Composition (per Insight #1: handler chain IS capability stack):
//
//   lsp_session()
//     ~> lsp_adapter                 ← outermost = least trusted; sandbox boundary
//     ~> mentl_voice_filesystem      ← FX.B: 7 file ops + handles_table
//     ~> mentl_voice_default         ← MV.2.e: 10 voice/state arms
//     ~> wasi_filesystem             ← FX.A.basics: 9 fs syscalls
//     ~> graph_handler / oracle handlers / etc.
//
// VS Code → JSON-RPC over stdin → lsp_frame → JsonValue → LspMessage
// → classify_method → dispatch_* → handle_* → Interact ops →
// LspResponseBody → JsonValue → frame → stdout → VS Code.
//
// Per kernel-closure (insight #13): pure composition on the closed
// Interact substrate. No new effects; no new primitives.
import types

import mentl

import voice

import query

import driver

import json

import lsp_frame

import strings

import io

import oracle

import egraph

// ─── LspMessage — incoming JSON-RPC message shape ─────────────────────
//
// LspMessage — request (id + method + params), notification (method
// + params, no id), or response (id + result + optional error).
// Per drift mode 6 + H6: structural ADT, not flag-keyed.
type LspMessage
  = LspRequest(Int, String, JsonValue)
  | LspNotification(String, JsonValue)
  | LspResponse(Int, JsonValue, Option(JsonValue))

// LspMethodKind — classification ADT. LSP method strings come from
// the protocol (unavoidable string-keyed input); classify_method
// projects to this ADT IMMEDIATELY at the dispatch boundary;
// downstream code matches on LspMethodKind only. Per drift mode 8
// mitigation per MV-LSP-adapter §2.1.
type LspMethodKind
  = LspInitialize
  | LspInitialized
  | LspShutdown
  | LspExit
  | LspTextDocDidOpen
  | LspTextDocDidChange
  | LspTextDocDidSave
  | LspTextDocDidClose
  | LspTextDocHover
  | LspTextDocCompletion
  | LspTextDocCodeAction
  | LspTextDocDiagnostic
  | LspTextDocDefinition
  | LspTextDocReferences
  | LspUnknown(String)

// LspResponseBody — typed shape of an LSP response payload. Each
// variant projects to JsonValue via response_to_json. Variants cover
// the 12 v1 LSP method response shapes per MV-LSP-adapter §1.3.
type LspResponseBody
  = LspNullResp
  | LspHoverResp(Option(HoverContent))
  | LspCompletionResp([CompletionItem])
  | LspCodeActionResp([CodeAction])
  | LspDiagnosticResp([LspDiagnostic])
  | LspDefinitionResp(Option(Location))
  | LspReferencesResp([Location])
  // server capabilities + serverInfo
  | LspInitializeResp(JsonValue)

// markdown text
type HoverContent = HoverContent(String)

// label, detail, kind
type CompletionItem = CompletionItem(String, String, Int)

// title, edit_text
type CodeAction = CodeAction(String, String)

type LspDiagnostic = LspDiagnostic(Int, Int, Int, Int, Int, String, String)

// sl, sc, el, ec, severity, code, message
type Location = Location(String, Int, Int, Int, Int)

// uri, sl, sc, el, ec
//
// ─── parse_lsp_message — JsonValue → LspMessage ───────────────────────
//
// parse_lsp_message — extract id / method / params from JsonValue.
// Per drift mode 6: explicit shape detection (request has id+method;
// notification has method no id; response has id+result no method).
// Anything else is an LspUnknown notification with empty params.
fn parse_lsp_message(v) with Memory + Alloc = {
  let method_opt = json_obj_get(v, "method")
  let id_opt = json_obj_get(v, "id")
  let params = match json_obj_get(v, "params") {
    None => JNull,
    Some(p) => p,
  }
  match method_opt {
    Some(m_val) => {
      let method = json_str_or_default(m_val, "")
      match id_opt {
        Some(id_val) => {
          let id = json_int_or_default(id_val, 0)
          LspRequest(id, method, params)
        },
        None => LspNotification(method, params),
      }
    },
    None => {
      let id = match id_opt {
        None => 0,
        Some(id_val) => json_int_or_default(id_val, 0),
      }
      let result = match json_obj_get(v, "result") {
        None => JNull,
        Some(r) => r,
      }
      LspResponse(id, result, None)
    },
  }
}

// ─── classify_method — String → LspMethodKind ─────────────────────────
//
// classify_method — project the LSP method string to LspMethodKind
// ADT. The ONE place where strings cross into the dispatch substrate;
// downstream is ADT-only. Per drift mode 8: input strings are
// projected, not stored.
fn classify_method(method) with Memory + Alloc = if method == "initialize" {
  LspInitialize
} else if method == "initialized" {
  LspInitialized
} else if method == "shutdown" {
  LspShutdown
} else if method == "exit" {
  LspExit
} else if method == "textDocument/didOpen" {
  LspTextDocDidOpen
} else if method == "textDocument/didChange" {
  LspTextDocDidChange
} else if method == "textDocument/didSave" {
  LspTextDocDidSave
} else if method == "textDocument/didClose" {
  LspTextDocDidClose
} else if method == "textDocument/hover" {
  LspTextDocHover
} else if method == "textDocument/completion" {
  LspTextDocCompletion
} else if method == "textDocument/codeAction" {
  LspTextDocCodeAction
} else if method == "textDocument/diagnostic" {
  LspTextDocDiagnostic
} else if method == "textDocument/definition" {
  LspTextDocDefinition
} else if method == "textDocument/references" {
  LspTextDocReferences
} else {
  LspUnknown(method)
}

// ─── dispatch_request / dispatch_notification ─────────────────────────
//
// dispatch_request — request methods (require response). H6
// exhaustive over LspMethodKind. Notification-shaped methods that
// arrive as requests get LspNullResp (graceful protocol tolerance).
fn dispatch_request(kind, params) with Interact + Memory + Alloc + Intern + GraphRead + EnvRead = match kind {
  LspInitialize => handle_initialize(params),
  LspShutdown => LspNullResp,
  LspTextDocHover => handle_hover(params),
  LspTextDocCompletion => handle_completion(params),
  LspTextDocCodeAction => handle_code_action(params),
  LspTextDocDiagnostic => handle_diagnostic(params),
  LspTextDocDefinition => handle_definition(params),
  LspTextDocReferences => handle_references(params),
  LspUnknown(_m) => LspNullResp,
  LspInitialized => LspNullResp,
  LspExit => LspNullResp,
  LspTextDocDidOpen => LspNullResp,
  LspTextDocDidChange => LspNullResp,
  LspTextDocDidSave => LspNullResp,
  LspTextDocDidClose => LspNullResp,
}

// dispatch_notification — notification methods (no response). H6
// exhaustive. Request-shaped methods that arrive as notifications
// are silently ignored.
fn dispatch_notification(kind, params) = match kind {
  LspInitialized => (),
  LspExit => (),
  LspTextDocDidOpen => handle_did_open(params),
  LspTextDocDidChange => handle_did_change(params),
  LspTextDocDidSave => handle_did_save(params),
  LspTextDocDidClose => handle_did_close(params),
  LspInitialize => (),
  LspShutdown => (),
  LspTextDocHover => (),
  LspTextDocCompletion => (),
  LspTextDocCodeAction => (),
  LspTextDocDiagnostic => (),
  LspTextDocDefinition => (),
  LspTextDocReferences => (),
  LspUnknown(_) => (),
}

// ─── LSP param extraction helpers ─────────────────────────────────────
//
// lsp_extract_uri — pull `params.textDocument.uri` String. Default
// empty when missing.
fn lsp_extract_uri(params) with Memory + Alloc = match json_obj_get(params, "textDocument") {
  None => "",
  Some(td) => match json_obj_get(td, "uri") {
    None => "",
    Some(u) => json_str_or_default(u, ""),
  },
}

// lsp_extract_position — pull `params.position.{line, character}`.
// Returns (line, character) Ints. Default (0, 0) on missing.
fn lsp_extract_position(params) with Memory + Alloc = match json_obj_get(params, "position") {
  None => (0, 0),
  Some(p) => {
    let line = json_int_or_default(json_obj_get_unwrap(p, "line"), 0)
    let ch = json_int_or_default(json_obj_get_unwrap(p, "character"), 0)
    (line, ch)
  },
}

fn json_obj_get_unwrap(v, key) with Memory + Alloc = match json_obj_get(v, key) {
  None => JNull,
  Some(x) => x,
}

// position_to_span — LSP (line, character) → Mentl Span. LSP positions
// are 0-indexed; Mentl spans 1-indexed. v1 produces a zero-width span
// at (line+1, char+1); refined ranges (selection-aware) land as
// MV-LSP.range peer sub-handle.
fn position_to_span(pos) with Memory + Alloc = match pos {
  (line, ch) => Span(line + 1, ch + 1, line + 1, ch + 1),
}

// ─── handle_* — LSP method bodies ─────────────────────────────────────
//
// handle_initialize — capability negotiation. v1 declares fixed
// capabilities (text-sync = full; hover; completion; codeAction;
// diagnostic; definition; references). Project root extracted from
// rootUri or workspaceFolders.
fn handle_initialize(_params) with Interact + Memory + Alloc = {
  project_root()
  let caps = JObj([
    // 1 = Full
    ("textDocumentSync", JNum(1.0)),
    ("hoverProvider", JBool(true)),
    ("completionProvider", JObj([])),
    ("codeActionProvider", JBool(true)),
    ("diagnosticProvider", JObj([])),
    ("definitionProvider", JBool(true)),
    ("referencesProvider", JBool(true))
  ])
  let server_info = JObj([("name", JStr("mentl-lsp")), ("version", JStr("0.1.0"))])
  let result = JObj([("capabilities", caps), ("serverInfo", server_info)])
  LspInitializeResp(result)
}

// handle_hover — focus + ask(QTypeAt) → HoverContent. Per MV §2.8 AT1.
fn handle_hover(params) with Memory + Alloc + Interact + GraphRead + Intern = {
  let uri = lsp_extract_uri(params)
  let pos = lsp_extract_position(params)
  let span = position_to_span(pos)
  ensure_doc_open(uri)
  focus(TargetSpan(span))
  let answer = consult(QTypeAt(span))
  match answer {
    AnsSilence => LspHoverResp(None),
    AnsType(ty, reason) => LspHoverResp(Some(hover_from_type(ty, reason))),
    AnsRow(row, reason) => LspHoverResp(Some(hover_from_row(row, reason))),
    AnsReason(reason) => LspHoverResp(Some(hover_from_reason(reason))),
    AnsRefs(_, _) => LspHoverResp(None),
    AnsDebt(_, _) => LspHoverResp(None),
  }
}

// handle_completion — propose at the cursor position; project the
// returned VoiceLine's slots to CompletionItems. The cursor's Propose
// tentacle IS the completion source (PLAN §2 proposing-cursor): one
// propose, the SIdent slots become items. Silence → empty list.
fn handle_completion(params) with Interact + Alloc + Memory = {
  let uri = lsp_extract_uri(params)
  let pos = lsp_extract_position(params)
  let span = position_to_span(pos)
  ensure_doc_open(uri)
  focus(TargetSpan(span))
  match propose(TargetSpan(span)) {
    Silence => LspCompletionResp([]),
    VoiceLine(_, _, slots, _) => LspCompletionResp(completion_items_from_slots(slots)),
  }
}

// handle_code_action — propose at the cursor; project the VoiceLine's
// offering slots to CodeActions. Same propose path as completion (MV
// §2.7.6: codeAction and completion both surface Propose-tentacle
// voice). SLit slots (offering closers) become the quick-fix actions.
fn handle_code_action(params) with Interact + Alloc + Memory = {
  let uri = lsp_extract_uri(params)
  let pos = lsp_extract_position(params)
  let span = position_to_span(pos)
  ensure_doc_open(uri)
  focus(TargetSpan(span))
  match propose(TargetSpan(span)) {
    Silence => LspCodeActionResp([]),
    VoiceLine(_, _, slots, _) => LspCodeActionResp(code_actions_from_slots(slots)),
  }
}

// handle_diagnostic — consult(QVerifyDebt) for the live pending
// obligations the graph holds; project each (span, predicate, reason)
// to an LSP LspDiagnostic. The verify-debt IS the diagnostic set (the
// graph proved it) — read live, never an empty []-fabrication.
fn handle_diagnostic(params) with Memory + Alloc + Interact + GraphRead + Intern = {
  let uri = lsp_extract_uri(params)
  ensure_doc_open(uri)
  match consult(QVerifyDebt) {
    AnsDebt(debt, _) => LspDiagnosticResp(diagnostics_from_debt_lsp(debt, uri)),
    AnsSilence => LspDiagnosticResp([]),
    AnsType(_, _) => LspDiagnosticResp([]),
    AnsRow(_, _) => LspDiagnosticResp([]),
    AnsReason(_) => LspDiagnosticResp([]),
    AnsRefs(_, _) => LspDiagnosticResp([]),
  }
}

// handle_definition — resolve the identifier at the cursor, then read
// its binding span LIVE from the env entry's Located Reason (the graph
// proved where the name lives). No echo of the cursor's own position;
// the defining span IS the goto target. None when unresolved.
fn handle_definition(params) with Memory + Alloc + Interact + GraphRead + !Mutate + EnvRead = {
  let uri = lsp_extract_uri(params)
  let pos = lsp_extract_position(params)
  let span = position_to_span(pos)
  ensure_doc_open(uri)
  focus(TargetSpan(span))
  match name_at_span(span) {
    None => LspDefinitionResp(None),
    Some(name) => match defining_span_of(name) {
      None => LspDefinitionResp(None),
      Some(def_span) => LspDefinitionResp(Some(span_to_location(uri, def_span))),
    },
  }
}

// handle_references — resolve the identifier at the cursor, then
// consult(QRefsOf(name)) for the live use-edge set (every VarRef the
// parser wove). Each span projects to a Location. This [Location] IS
// the rename edit set — read live, never an empty []-fabrication.
fn handle_references(params) with Memory + Alloc + Interact + GraphRead + !Mutate = {
  let uri = lsp_extract_uri(params)
  let pos = lsp_extract_position(params)
  let span = position_to_span(pos)
  ensure_doc_open(uri)
  focus(TargetSpan(span))
  match name_at_span(span) {
    None => LspReferencesResp([]),
    Some(name) => match consult(QRefsOf(name)) {
      AnsRefs(spans, _) => LspReferencesResp(spans_to_locations(spans, uri)),
      AnsSilence => LspReferencesResp([]),
      AnsType(_, _) => LspReferencesResp([]),
      AnsRow(_, _) => LspReferencesResp([]),
      AnsReason(_) => LspReferencesResp([]),
      AnsDebt(_, _) => LspReferencesResp([]),
    },
  }
}

// span_to_location — project a Mentl Span to an LSP Location at the doc URI.
fn span_to_location(uri, span) with Memory + Alloc = match span {
  Span(sl, sc, el, ec) => Location(uri, sl, sc, el, ec),
}

// spans_to_locations — project each reference Span to a Location (buffer-rev
// accumulate; the projection is order-stable over the use-edge set).
fn spans_to_locations(spans, uri) with Memory + Alloc =
  map_spans_to_locations(spans, uri, 0, len(spans), [])

fn map_spans_to_locations(spans, uri, i, n, acc_rev) with Memory + Alloc = if i >= n {
  reverse(acc_rev)
} else {
  let loc = span_to_location(uri, list_index(spans, i))
  map_spans_to_locations(spans, uri, i + 1, n, [loc] ++ acc_rev)
}

// diagnostics_from_debt_lsp — project each pending obligation (span,
// predicate, reason) to an LSP LspDiagnostic. severity 1 = Error (a refinement
// the path could not discharge). The predicate's text is the message; the
// span is the obligation site (read live from the debt the graph holds).
fn diagnostics_from_debt_lsp(debt, uri) with Memory + Alloc + GraphRead + !Mutate + Intern =
  map_debt_to_diagnostics(debt, 0, len(debt), [])

fn map_debt_to_diagnostics(debt, i, n, acc_rev) with Memory + Alloc + GraphRead + !Mutate + Intern = if i >= n {
  reverse(acc_rev)
} else {
  match list_index(debt, i) {
    (_modh, span, predicate, reason) => match span {
      Span(sl, sc, el, ec) => {
        let diag = LspDiagnostic(
          sl,
          sc,
          el,
          ec,
          1,
          "E_RefinementRejected",
          "{show_predicate(predicate)}: {show_reason(reason)}"
        )
        map_debt_to_diagnostics(debt, i + 1, n, [diag] ++ acc_rev)
      },
    },
  }
}

// handle_did_open — register the doc handle, then RUN THE FRONTEND so the
// transport queries a LIVE graph. driver_check lex/parse/infers the opened
// module (and its import DAG) into the ambient graph_handler — the SAME graph
// every subsequent hover / definition / reference then projects. Without this
// the transport read an unpopulated graph and every query fell to AnsSilence
// (Hβ.lsp.transport-runs-frontend). driver_check's Env/Graph/Consume/Region/
// Verify writes land in serve_run's session-level handlers, so they persist
// across the whole session; the LSP client opens a document exactly once, so
// the inference runs once. Live re-inference on didChange / didSave (the
// session <~ loop, which needs a graph reset or IC re-projection to avoid
// re-registration) is the named peer Hβ.lsp.session-reinfer.
fn handle_did_open(params) = {
  let uri = lsp_extract_uri(params)
  ensure_doc_open(uri)
  driver_check(uri_to_module(uri))
  ()
}

// uri_to_module — the opened document's module name for driver_check. Strips
// the file:// scheme (uri_to_path) and the .mn suffix; driver_module_path
// re-adds .mn and resolves it (its DIRECT-read arm accepts an absolute or
// relative path as itself), so an editor's file://<abs>/foo.mn reaches foo.mn
// from any directory — the same resolver `mentl check <path>` rides.
fn uri_to_module(uri) with Memory + Alloc = match uri_to_path(uri) {
  Path(p) => if ends_with(p, ".mn") { str_slice(p, 0, byte_len(p) - 3) } else { p },
}

// handle_did_change — text-sync = Full; replace cached text via edit.
// v1 uses re-open semantics as the honest fallback (edit substrate
// gates on MV.2.e.P.edit peer sub-handle which lands separately).
fn handle_did_change(params) with Memory + Alloc + Interact = {
  let uri = lsp_extract_uri(params)
  ensure_doc_open(uri)
  ()
}

// handle_did_save — save_file on the cached FileHandle. The
// mentl_voice_filesystem handler's save arm writes cached text to disk.
fn handle_did_save(params) with Memory + Alloc + Interact = {
  let uri = lsp_extract_uri(params)
  let fh = ensure_doc_open(uri)
  save_file(fh)
  ()
}

// handle_did_close — v1 no-op; the close op is a named Interact peer.
fn handle_did_close(_params) with Pure = ()

// ─── Doc table — URI ↔ FileHandle plumbing ────────────────────────────
//
// The lsp_adapter caches uri ↔ FileHandle mappings so didOpen + subsequent
// hover/completion/etc. share the same handle. ensure_doc_open looks
// up or opens. The cache lives in lsp_adapter handler state; access
// here is via Interact.open_file which mentl_voice_filesystem handles.
//
// v1 simplification: every ensure_doc_open performs open_file
// unconditionally; mentl_voice_filesystem's handles_table grows
// monotonically. Cache eviction is MV-LSP.doctable-evict peer.
fn ensure_doc_open(uri) with Memory + Alloc + Interact = {
  let path = uri_to_path(uri)
  open_file(path)
}

// uri_to_path — strip "file://" prefix; pass through other schemes.
// v1 supports file: scheme only; richer URI parsing (file:///host/...,
// percent-encoding) is MV-LSP.uri-parse peer.
fn uri_to_path(uri) with Memory + Alloc = {
  let prefix = "file://"
  let plen = byte_len(prefix)
  if byte_len(uri) > plen && uri_starts_with(uri, prefix, 0, plen) {
    Path(str_slice(uri, plen, byte_len(uri)))
  } else {
    Path(uri)
  }
}

fn uri_starts_with(uri, prefix, i, n) with Memory = if i >= n {
  true
} else if byte_at(uri, i) == byte_at(prefix, i) {
  uri_starts_with(uri, prefix, i + 1, n)
} else {
  false
}

// ─── HoverContent / CompletionItem / CodeAction projection ────────────
fn hover_from_type(ty, _reason) with Memory + Alloc + GraphRead + !Mutate + Intern = {
  let type_text = show_type(ty)
  HoverContent("`{type_text}`")
}

fn hover_from_row(row, _reason) with Memory + Alloc + GraphRead + !Mutate + Intern = {
  let row_text = show_effrow(row)
  HoverContent("Effect row: `{row_text}`")
}

fn hover_from_reason(reason) with Memory + Alloc + GraphRead + !Mutate + Intern =
  HoverContent("Reason: {show_reason(reason)}")

// completion_items_from_slots — project VoiceLine slots to LSP
// CompletionItems. SIdent slots become items (label = ident,
// kind=14 = Keyword as v1 placeholder). Other slot kinds skipped.
fn completion_items_from_slots(slots) with Alloc + Memory = flatten(map(
  (s) => match s {
    SIdent(name) => [CompletionItem(name, "", 14)],
    SType(_) => [],
    SRow(_) => [],
    SSpan(_) => [],
    SReason(_) => [],
    SCap(_) => [],
    SAnnot(_) => [],
    SLit(_) => [],
  },
  slots
))

// code_actions_from_slots — project VoiceLine slots to LSP
// CodeActions. SLit slots carrying suggestion text become actions.
fn code_actions_from_slots(slots) with Alloc + Memory = flatten(map(
  (s) => match s {
    SLit(text) => [CodeAction(text, "")],
    SIdent(_) => [],
    SType(_) => [],
    SRow(_) => [],
    SSpan(_) => [],
    SReason(_) => [],
    SCap(_) => [],
    SAnnot(_) => [],
  },
  slots
))

// ─── response_to_json — LspResponseBody → JsonValue ───────────────────
//
// response_to_json — project the typed response shape to JsonValue
// for serialization. H6 over LspResponseBody.
fn response_to_json(body) with Memory + Alloc = match body {
  LspNullResp => JNull,
  LspHoverResp(None) => JNull,
  LspHoverResp(Some(content)) => hover_content_to_json(content),
  LspCompletionResp(items) => JArr(map_completion_items_to_json(items, 0, len(items), [])),
  LspCodeActionResp(actions) => JArr(map_code_actions_to_json(actions, 0, len(actions), [])),
  LspDiagnosticResp(diags) => JObj([("kind", JStr("full")), ("items", JArr(map_diagnostics_to_json(diags, 0, len(diags), [])))]),
  LspDefinitionResp(None) => JNull,
  LspDefinitionResp(Some(loc)) => location_to_json(loc),
  LspReferencesResp(locs) => JArr(map_locations_to_json(locs, 0, len(locs), [])),
  LspInitializeResp(result) => result,
}

fn hover_content_to_json(content) with Memory + Alloc = match content {
  HoverContent(md) => JObj([("contents", JObj([("kind", JStr("markdown")), ("value", JStr(md))]))]),
}

fn map_completion_items_to_json(items, i, n, acc_rev) with Memory + Alloc = if i >= n {
  reverse(acc_rev)
} else {
  let item = list_index(items, i)
  match item {
    CompletionItem(label, detail, kind) => {
      let json =
        JObj([("label", JStr(label)), ("detail", JStr(detail)), ("kind", JNum(float_of_int(kind)))])
      map_completion_items_to_json(items, i + 1, n, [json] ++ acc_rev)
    },
  }
}

fn map_code_actions_to_json(actions, i, n, acc_rev) with Memory + Alloc = if i >= n {
  reverse(acc_rev)
} else {
  let action = list_index(actions, i)
  match action {
    CodeAction(title, _edit) => {
      let json = JObj([("title", JStr(title)), ("kind", JStr("quickfix"))])
      map_code_actions_to_json(actions, i + 1, n, [json] ++ acc_rev)
    },
  }
}

fn map_diagnostics_to_json(diags, i, n, acc_rev) with Memory + Alloc = if i >= n {
  reverse(acc_rev)
} else {
  let d = list_index(diags, i)
  match d {
    LspDiagnostic(sl, sc, el, ec, severity, code, msg) => {
      let json =
        JObj([("range", range_to_json(sl, sc, el, ec)), ("severity", JNum(float_of_int(severity))), ("code", JStr(code)), ("message", JStr(msg))])
      map_diagnostics_to_json(diags, i + 1, n, [json] ++ acc_rev)
    },
  }
}

fn map_locations_to_json(locs, i, n, acc_rev) with Memory + Alloc = if i >= n {
  reverse(acc_rev)
} else {
  let loc = list_index(locs, i)
  map_locations_to_json(locs, i + 1, n, [location_to_json(loc)] ++ acc_rev)
}

fn location_to_json(loc) with Memory + Alloc = match loc {
  Location(uri, sl, sc, el, ec) => JObj([("uri", JStr(uri)), ("range", range_to_json(sl, sc, el, ec))]),
}

fn range_to_json(sl, sc, el, ec) with Memory + Alloc =
  JObj([("start", JObj([("line", JNum(float_of_int(sl - 1))), ("character", JNum(float_of_int(sc - 1)))])), ("end", JObj([("line", JNum(float_of_int(el - 1))), ("character", JNum(float_of_int(ec - 1)))]))])

// ─── lsp_adapter handler + session loop ───────────────────────────────
//
// lsp_adapter — outermost handler in the Mentl chain. Subscribes to
// graph_mutated for push diagnostics (MV-LSP.push peer extends this).
// State carries msg_id_counter for outgoing notifications and
// initialized flag for protocol state machine.
handler lsp_adapter with msg_id_counter = 0, initialized = false, shutdown_received = false {
  graph_mutated(_epoch, _mutation) => resume(),
}

// lsp_session — the session loop entry. Reads frames from stdin
// in a tail-recursive loop terminating on LspFrameEof; dispatches each
// message; writes responses to stdout. Composes through the full
// Mentl handler chain at install per MV-LSP-adapter §3.
fn lsp_session() = match read_lsp_frame() {
  LspFrameEof => (),
  LspFrame(body) => {
    let parsed = json_parse(body)
    let dispatch_input = match parsed {
      JOk(v, _) => v,
      JErr(_msg, _pos) => JNull,
    }
    let msg = parse_lsp_message(dispatch_input)
    handle_message(msg)
    lsp_session()
  },
}

fn handle_message(msg) = match msg {
  LspRequest(id, method, params) => {
    let kind = classify_method(method)
    let resp = dispatch_request(kind, params)
    let resp_json =
      JObj([("jsonrpc", JStr("2.0")), ("id", JNum(float_of_int(id))), ("result", response_to_json(resp))])
    write_lsp_frame(json_serialize(resp_json))
  },
  LspNotification(method, params) => {
    let kind = classify_method(method)
    dispatch_notification(kind, params)
  },
  LspResponse(_, _, _) => (),
}
