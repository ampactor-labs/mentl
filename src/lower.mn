// lower.mn — LowIR from live graph observation (spec 05)
//
// The projection. Lowers typed AST into LowIR by reading types LIVE
// from Graph through LookupTy. No cached types in LowExpr. No
// subst threading. An unresolved handle at lower time is a build
// failure, not a fallback.
//
// Declares: with GraphRead + EnvRead + LookupTy + Diagnostic.
// (The old "NO GraphWrite" claim here was refuted by the medium's own
// audit — lowering performs GraphWrite; the second-tree restructure
// is Hβ.lower.lowering-is-a-column.)
//
// Handler elimination (the dispatch gradient, PLAN §6):
//   TailResumptive (~85%)  → direct call to the arm's own fn
//   static singleton       → direct call, record from the live world chain
//   polymorphic            → call_indirect via the evidence entry
//   MultiShot              → heap continuation record + re-execution driver
// Classification reads TCont's discipline. Monomorphic detection is a
// graph read (row_is_ground), not a sidecar table.
//
// Pipe desugarings (spec 10):
//   left |> right   →  LCall(h, right, [left])
//   left <| (fs)    →  LMakeTuple(h, [f(left) for f in fs])
//   left >< right   →  LMakeTuple(h, [left, right])
//   left ~> right   →  LHandleWith(h, left, right)
//   left <~ spec    →  LFeedback(h, depth, home, left, spec) — depth from the spec, home from the frame
import graph

import effects

import egraph

import env

import imap

import infer

import parser

import persist

import types

// The handler-arm context. `lower_one_arm_decl` installs `arm_state_ctx`
// around each arm body's lowering, and a lambda or a nested fn minted in the
// arm lowers inside it; ResumeExpr reads `current_state_fields()` to resolve `with field = NEW`
// updates' slot offsets AND `current_resume_discipline()` to pick its
// representation (OneShot → LReturn floor; MultiShot → a call of the
// continuation record). The discipline is carried LIVE on the context
// — read at the resume site, never re-derived from a side-ledger.
effect ArmStateContext {
  current_state_fields() -> [String]
  current_resume_discipline() -> ResumeDiscipline
  // band B M2b — the declaration of the enclosing arm's handler, whose redrive the resume flag-arm calls (None outside arms)
  current_arm_handler() -> Option(Int)
}

handler arm_state_ctx(fields, disc, hd) {
  current_state_fields() => resume(fields),
  current_resume_discipline() => resume(disc),
  current_arm_handler() => resume(hd),
}

// There is NO second handler. The non-arm default ([], OneShot, None) is the
// pipeline BOUNDARY install `~> arm_state_ctx([], OneShot, None)`, so the op
// edge is UNIQUE and every arm-context read reaches the innermost live
// install. The context is a DYNAMIC fact; its one home is the innermost live
// bracket. A second, default handler would make the op AMBIGUOUS, pushing
// these reads to the evidence walk — the give-arm resume read a starved pair
// four hops from its live bracket that way (the rw4 trap, 2026-07-12). One
// handler, one home, read live.
//
// A handler is its declaration. An install reads the declaration its
// reference reaches (`installed_handler`), the declaration's own lowering
// holds its statement, and everything the lowering and the emit ask of the
// handler — its config, state and arms (`handler_shape_at`), the class it
// answers, the symbols its arms and init are emitted under — is read off
// that one handle; the handler's name is spelled only where a symbol is.
//
// The handler declaration an install's reference reaches, read along the
// edge the judgment drew when it resolved the install (infer.mn's
// `install_decl`). None for a handler held by a value — a let, a parameter
// — which the judgment reads as absorbing nothing, so its install lowers to
// its body (a value carrying its handler's record is PLAN §11, the keystone).
fn installed_handler(right) = match tee_handler_decl(right) {
  Some(d) => match handler_shape_at(d) {
    Some(_) => Some(d),
    None => None,
  },
  None => None,
}

// The handler's MultiShot-classified ops as (name, arity) pairs, projected
// live from its decl arms + the op scheme's disc (band B k1/M1.4 — the ONE
// decider the emit's locals walk (walk_lemit) and the LHandleWith emit read; the
// arity drives the driver's $yield_args loads). An all-OneShot handler
// answers [], so its install keeps the ungated emission byte-for-byte.
fn multishot_ops_of(hd) = match handler_shape_at(hd) {
  Some((_, _, _, arms)) => arms |> filter((a) => match op_resume_discipline(handler_arm_op_decl(a)) {
    MultiShot => true,
    // M4 — an abandon op needs the driver too: it delivers the arm value on flag-clear (the redrive's existing behaviour IS abandon)
    Abandon => true,
    OneShot => false,
  }) |> map((a) => (handler_arm_op_name(a), handler_arm_arity(a))),
  None => [],
}

// How many `with` state fields a handler declares.
fn handler_state_count(hd) = match handler_shape_at(hd) {
  Some((_, _, state, _)) => len(state),
  None => 0,
}

// Per-effect arm-name groups for a handler, projected live from its decl.
fn handler_arm_groups(hd) = match handler_shape_at(hd) {
  Some((_, _, _, arms)) => build_handler_arm_names(hd, arms),
  None => [],
}

// ─── Lower-phase handler-stack ─────────────────────────────────────
// Pushed at each `~>` / handle install (before the body lowers), popped
// after. A Tier-1 perform inside the body resolves the innermost handler
// installed for its op AND that install's handle — so emit threads the
// SAME state record (`__hstate_<h>`) the arm was installed against, not
// the caller's __state misread as state. The handler stack IS a Mentl
// effect (handler IS state); the install handle is
// graph-carried, never re-derived (Anchor 1).
//
// `lower_handler_stack_ctx` installs in the COMPILE CHAIN beside
// `lower_scope`, not around `lower_stmt_list` — the extent is the whole
// remainder because construction relocates to emit time
// (Hβ.lower.lowering-is-a-column): a body projected from columns at
// emit performs the frame fence, and a capability scoped to
// `lower_program` would leave that perform with no handler. Every push
// is straight-line paired with its pop (the PTee arm and the five
// frame-fence sites), so the stack is empty at every decl boundary and
// the widened extent is behaviour-identical.
// An entry of the stack: the frame fence, or an install — its handle, its
// handler's declaration, the install CLASS that declaration answers
// (`projection_of`), and the word of the instance it serves (0 where it
// serves every instance), each read once where the install is pushed: every
// global call inside the extent asks the stack which schedule governs it,
// and every perform which install serves its instance.
type StackEntry = Fence | Installed(Int, Int, Projection, Int)

effect LowerHandlerStack {
  lower_handler_push(StackEntry) -> Int
  lower_handler_pop() -> Int
  lower_handler_stack_now() -> [StackEntry]
}

handler lower_handler_stack_ctx with stack = [] {
  lower_handler_push(entry) => // drift-audit: ignore — O(1) push at the end last/drop_last read (the one stack law)
  resume(0) with stack = stack ++ [entry],
  lower_handler_pop() => if len(stack) == 0 { resume(0) } else { resume(0) with stack = drop_last(stack) },
  lower_handler_stack_now() => // Head-first = innermost-first; resolution walks it as a plain fn.
  resume(stack),
}

// The lexical evidence FENCE. A Tier-1 resolution names an `__hstate_<h>`
// LOCAL — a slot of the fn frame the install lowered in. A new fn frame
// (named fn, lambda, handler arm, fanout thunk, reified k) is a NEW WASM
// function: the enclosing frame's locals do not exist there, so lexical
// resolution STOPS at the frame boundary and the perform falls to the
// singleton/evidence tiers (the world chain carries the installs across
// every frame boundary — dynamic by construction). Surfaced when THE
// CUT flipped the wheel's choose/enumerate MultiShot and reify_frame_k
// re-lowered pipeline remainders inside fresh k frames while the lexical
// stack still held compile_source's installs (a reified k frame's dangling
// per-install state global); the each-with-effects lambda gap is the
// same hole.
fn lower_frame_fence_push() = lower_handler_push(Fence)

fn index_of_name(names: [String], target: String, i) = if i >= len(names) {
  -1
} else if names[i] == target {
  i
} else {
  index_of_name(names, target, i + 1)
}

// A compiler-created executable edge can fail only by violating one of these
// graph/lower contracts. Keep the failure typed through LowIR; the backend may
// render it, but cannot reinterpret it as a value-producing expression.
type BoundaryInvariant
  = MissingFanoutBoundary
  | WrongFanoutBoundaryKind
  // expected branch ordinal
  | MissingFanoutEdge(Int)
  // thunk graph handle
  | UnresolvedBoundaryThunk(Int)
  // the boundary's handle — a live boundary whose remainder the frame's own
  // checked tree does not hold, which the continuation pass found the
  // boundary in
  | RemainderLost(Int)
  // the read's handle — a value a remainder reads from before its boundary
  // that the pass collecting the record's captures did not find
  | CaptureLost(Int)
  // A resume whose "__k" resolves neither as the arm's param nor as a
  // capture — impossible past infer's E_ResumeOutsideArm refusal; the
  // typed loud floor for the impossible branch, never a fabricated k.
  | ResumeKOutsideLadder
  // callee handle — Hβ.lower.partial-local-callee
  | PartialCalleeShape(Int)
  // the unbound name — a VarRef bound by nothing the lowering sees. The
  // lowering must not GUESS it into `(global.get $name)`: the guess
  // fabricates the one fact the graph most clearly holds and emits WAT no
  // assembler accepts, so the precise diagnostic would surface 350k lines
  // downstream, as a wat2wasm error about a symbol the developer never wrote. A
  // name the judgment proved missing is refused before the plan
  // (E_MissingVariable), so what reaches this is a binding the lowering
  // lost — a block local inside a module-scope `let`, lowered with no frame
  // (measured 2026-09-28) — and the settle point refuses it as the
  // invariant it is.
  | MissingName(String)
  // the handler name — a singleton-tier perform whose state global is still
  // 0 at runtime: the handler was never installed in THIS dynamic extent.
  // The column-projection invariant (the lowering-column arc): a
  // projector was asked to build a fn body from an origin whose
  // program-column node is not the expected shape. Probe-proven
  // unreachable for lambdas (the column equals the walked value at
  // every lambda, whole-wheel); the typed terminal keeps the refusal
  // loud if the invariant ever breaks.
  | ProjectionOriginShape(Int)
  // `tangent_of` lowered outside a derivative reading — already refused
  // at the call (E_DerivativeUnreachable); the terminal keeps the node total.
  | TangentOutsideReading
  // A sequence fanout (`fanout(f, xs)`) at a site whose frame installs a
  // spawning schedule whose library implementation the program never links
  // — a Thread-class handler declared beside no `fanout_threaded`. The
  // name is the implementation the schedule's vocabulary owes.
  | SequenceFanoutUnlinked(String)
  // A module-scope `let` whose pattern is not one binder: the init function
  // stores the value a single binder names, and nothing else, so the let is
  // refused where it is emitted rather than dropped with its value.
  | ModuleLetPattern

fn show_boundary_invariant(invariant) = match invariant {
  MissingFanoutBoundary => "missing fanout boundary",
  WrongFanoutBoundaryKind => "wrong boundary kind at fanout",
  MissingFanoutEdge(i) => "missing fanout edge at ordinal {int_to_str(i)}",
  UnresolvedBoundaryThunk(h) => "unresolved boundary thunk {int_to_str(h)}",
  RemainderLost(h) => "the remainder of the live boundary at {int_to_str(h)} is not in its own frame's tree",
  CaptureLost(h) => "the read at {int_to_str(h)} is not among the captures of its remainder's record",
  ResumeKOutsideLadder => "resume k outside the argument/capture ladder — impossible past E_ResumeOutsideArm",
  PartialCalleeShape(h) => "partial over non-global callee shape {int_to_str(h)}",
  MissingName(name) => "`{name}` has no binding the lowering can see, though the judgment resolved it — the lowering will not guess it into a global",
  ProjectionOriginShape(h) => "column projection at {int_to_str(h)}: the program-column node is not the projector's shape",
  TangentOutsideReading => "tangent_of outside a derivative reading — refused at the call",
  SequenceFanoutUnlinked(impl) => "the sequence fanout runs under a schedule whose implementation `{impl}` is not linked — import the library that declares this schedule's vocabulary",
  ModuleLetPattern => "a module-scope let binds one name, and this one binds a pattern the module's init does not store — bind the value to one name and take it apart where it is read",
}

// What a lowered reference to module scope denotes, decided once by the
// node's writer: a DECLARATION — the edge the reference drew at the
// judgment, or the vocabulary a lowering or an emit names, resolved where it
// is minted — or a unit the compiler SYNTHESIZES (a runtime global, a
// derivative twin), which no declaration answers and whose symbol is its
// identity. Every reader takes the declaration for what it asks; the symbol
// is spelled off it in one place (`callee_symbol`).
type Callee = DeclaredAt(Int) | Synthesized(String)

// Every value-bearing variant carries a source TypeHandle (Int), never a cached Ty.
// Type reads go through `perform lookup_ty(h)`. Emit consumes this IR;
// the handle is the live bridge back to the graph.
type LowExpr
  = LConst(Int, LowValue)
  // handle, local name (matches LLet storage)
  | LLocal(Int, String)
  // handle, what the reference denotes
  | LGlobal(Int, Callee)
  | LLet(Int, String, LowExpr)
  | LUpval(Int, Int)
  | LBinOp(Int, BinOp, LowExpr, LowExpr)
  | LUnaryOp(Int, UnaryOp, LowExpr)
  // monomorphic direct call
  | LCall(Int, LowExpr, [LowExpr])
  | LTailCall(Int, LowExpr, [LowExpr])
  // call handle, callee-ref handle, callee, tail, args — the DIRECT native call to a known top-level fn: lower resolved the callee's FnScheme, so the emit calls its symbol with NATIVE argument types (an f64 arg stays f64 — no spill cell, no word face, no wrapper hop) and the WAT instruction return_call in tail position (true tails for wide results too — the word-face demotion and the wrapper's per-iteration frame leak both die at this node). __state stays the callee's own static-closure global, byte-equal semantics to the closure convention minus the table hop. The closure path remains for genuine VALUE callees; the callee-ref handle feeds the twin-demand scan (the reference's instantiated TFun lives there)
  | LDirectCall(Int, Int, Callee, Bool, [LowExpr])
  | LReturn(Int, LowExpr)
  // handle, fn, captures
  | LMakeClosure(Int, LowFn, [LowExpr])
  // The YIELD of a multi-shot perform: handle (the perform), op name, the
  // op's lowered arguments, and the continuation the frame's remainder is
  // minted as. The arguments go into the instance's yield area, the record
  // into $yield_k, the op's key into $yield_op, and the flag is raised; then
  // the frame leaves by its innermost landing, as an abandon does, since
  // everything after the perform is the remainder's.
  | LYield(Int, String, [LowExpr], KSite)
  // A BOUNDARY CHECK: handle, the expression a yield may leave with the flag
  // raised (a call, a perform, an install, an arena, a resume's re-drive),
  // and the continuation the frame's remainder is minted as when a LIVE one
  // may cross it. The value is parked; at a raised flag a live continuation
  // first takes the remainder, composed onto it, and the frame leaves by its
  // innermost landing. With no site the boundary carries dead continuations
  // only, which compose nothing.
  | LCheck(Int, LowExpr, Option(KSite))
  // AN-2 (2026-10-03) — the DEAD-k yield: a perform of an op whose every arm
  // abandons (`Abandon`). handle, op name, the op's lowered args. The emit
  // stores the args in the instance's yield-args area at their widths, sets
  // $yield_op, $yield_k = 0 and $yield_flag, and UNWINDS to the innermost
  // landing — an install body's block, so its driver runs (an owned op
  // dispatches, a foreign one bubbles) and its world restores; an arena
  // body's block, so its exit runs; the function's return otherwise. Nothing
  // of the frame past the perform runs: `g(ab(), 1)` called g with the
  // dummy and `let v = ab(); v + 1` left a block with no value on boot
  // 311479e1. No record is built, so `!Alloc` holds over an abandon.
  | LAbandon(Int, String, [LowExpr])
  // module-level fn declaration (handler arm) — no runtime slot
  | LDeclareFn(LowFn)
  | LIf(Int, LowExpr, [LowExpr], [LowExpr])
  | LBlock(Int, [LowExpr])
  | LMakeList(Int, [LowExpr])
  | LMakeTuple(Int, [LowExpr])
  // SIMD lane pack — the `~> Simd` cash-out of a `><` f32 fanout (W13). The N
  // branch results (each an f32-repr value) become the N lanes of a v128: emit
  // a zeroed `v128.const f32x4` base, then `f32x4.replace_lane i` for each
  // branch. The branch thunks are the SAME strategy-neutral closures Seq/Thread
  // run — only the COLLECTOR differs (lanes, not a tuple). The result is one
  // v128 the lane ops (emit_binop_v128) operate on in parallel — the value
  // layer (RV128 repr) meeting the `><` parallel verb at the SPACE axis.
  //
  // handle, [lane_value] (≤4 f32 branch results → v128)
  | LSimdLanes(Int, [LowExpr])
  // A fanout site: its handle, the schedule its OWN frame installs (none
  // when it inherits), what it fans (the branches, or the sequence and the
  // function it applies) and one lowered FORM per schedule the site can run
  // under — its own frame's, or with none installed the sequential form and
  // each spawning schedule a caller's install may demand of it through a
  // direct call (`fanout_form`). One node, read at the site's schedule or at
  // the bracket's; every walker descends into the selected form and no
  // other.
  | LFanout(Int, Option(Schedule), FanBranches, [(Schedule, LowExpr)])
  // handle, [field_value] sorted by field name
  | LMakeRecord(Int, [LowExpr])
  // A record update: handle, the record it copies, and the fields it writes
  // by name. Its layout is a type fact, read where it is emitted, so a copy
  // of a generic function builds the record its own caller's shape spells.
  | LRecordUpdate(Int, LowExpr, [(String, LowExpr)])
  // handle, tag_id, field exprs
  | LMakeVariant(Int, TagId, [LowExpr])
  | LMatch(Int, LowExpr, [(LowPat, LowExpr)])
  // The MultiShot resume INVOKING its continuation record: handle, the k
  // expr (the arm's __k argument / a lambda's captured __k), the record of
  // the install whose arm holds it, the resume value. Its own node — not an
  // LCall — because the invocation REBINDS the world: emit brackets the call
  // in the remainder's world and restores the resumer's after it. That world
  // is the continuation's own segment of the world it froze, through the
  // nodes of the install whose record this is, rooted on the world where the
  // resume stands, so an install the resumer stands under governs every
  // perform past that segment, as the rows judge it.
  //
  // handle, k_expr, hrec_expr, value
  // ~> desugaring. ONE handler record (handler IS state IS closure):
  // [_@0][nstate FENCE@4][state@8..][arms per-effect-contiguous].
  //   4th = the handler's declaration.
  //   5th = the config arguments ([LowExpr], source order, written at
  //         8+i*4); the declaration's init fn writes the state after them.
  //   6th = arm_names — per-effect groups of (effect name, arm-fn names), op-decl
  //         order within each effect; emit lays each group contiguously and
  //         builds a thin [record, base] evidence-entry per effect (the world
  //         chain node's entry — what the perform's walk reads to reach an arm).
  // Per PLAN §5.U.
  | LResumeK(Int, LowExpr, LowExpr, LowExpr)
  | LHandleWith(Int, LowExpr, LowExpr, Int, [LowExpr], [{arms: [String], ename: String}])
  // The DERIVATIVE READING's install, `(e) ~> grad(w)`: handle, the seed
  // (the lowered w — a local or a capture), the body. It builds no record
  // and pushes no world, because the projection replaces the install:
  // derive (src/derive.mn) expands it at emit's settling point into the
  // body's derivative program, the primal unchanged and a tangent beside
  // every value the seed reaches.
  | LDerive(Int, LowExpr, LowExpr)
  // An ARENA (`~> arena`, lib/arena.mn): the body whose allocations die at
  // the exit but for what its value and the barriers' journal reach. No
  // record, no world push, no question asked of anyone: the arena's install
  // IS the arena, as the derivative's is its reading.
  | LArena(Int, LowExpr)
  // <~ desugaring (iterative ctx required)
  // (LF.B) the prior-iteration output of feedback handle h, read LIVE from the
  // $__fb_prev_<h> local the LFeedback emit declares + loads. A `<~` lambda
  // param (`(prev) => ...`) lowers to THIS — the recurrence y[n]=f(x[n],y[n-1])
  // is expressed, not commented. Carried-Truth: the feedback NODE is the value;
  // no register copy, no snapshot — emit reads the one local the cycle writes.
  // handle, DEPTH, HOME, body, spec. The depth is the authored `delay(N)`
  // read at the site — the number of priors the line carries, so the emit
  // sizes an N-slot ring and reads the oldest. The home is where that ring
  // lives (`LineHome`, types.mn): a slot in the record of the function
  // that contains the cycle, or the instance global a top-level fn's site
  // reads. Both ride the node because the AST is where the literal lives
  // and the frame stack is where the owner is known — this pass sees both.
  | LFeedback(Int, Int, LineHome, LowExpr, LowExpr)
  // handle of the enclosing <~ site
  | LFeedbackPrior(Int)
  // THE ONE PERFORM. It replaced LPerform + LDirectPerform + LEvPerform,
  // which were never three operations: they were ONE — walk the install
  // chain innermost-out to the handler that DECLARES this op, run its arm
  // against its record, under its install world — whose answer happened to
  // be known to three different degrees. Written three times they disagreed
  // twice in one session, on the KEY (silently wrong, 15 where 33 is right)
  // and on the WORLD BRACKET (52 where the deep-handler law says 51), and
  // neither divergence was a typo: two implementations of one operation
  // cannot be held in agreement, and the failure is silent.
  // Hβ.kernel.staging-is-an-epoch-not-a-mode is the position — compile time
  // is the prefix of one execution that the bound edges permit, so what
  // varies between these constructors is HOW MUCH WAS BOUND, never what the
  // operation means. The bracket is uniform across all three by
  // construction, which is what makes the divergence unconstructible rather
  // than fixed.
  | LPerform(Int, PerformDispatch, [LowExpr])
  // W6: handle, record, SELECTOR. The byte offset is a PROJECTION of the
  // receiver's resolved type (prefix-sum of repr_width over the sorted
  // fields) and projects at EMIT under the active specialization bracket —
  // never a lower-time bake, so a generic body's field read heals when its
  // call site's instantiation closes the record (the LShow precedent, one
  // layer deeper). FByName selects a record field; FByIndex a positional
  // product slot.
  | LFieldLoad(Int, LowExpr, FieldSel)
  // A word primitive applied: its arguments, then the one instruction its
  // declaration is (types.mn's `Primitive`), never a call.
  //
  // handle, primitive, arguments
  | LPrim(Int, Primitive, [LowExpr])
  // `resume(val) with field = expr` (SYNTAX §State updates via with on
  // resume) lowers each (field, value) update to an LStateSlotStore before
  // the LReturn: the arm fn's __state IS the handler's state record (PLAN
  // §5.U's one record), so the store mutates handler state across resume
  // calls.
  //
  // handle, slot_offset, value, record READ — resolved at lower through the __hrec ladder (arm frame: the LLet alias of the arm's own $__state; a lambda or a nested fn minted in the arm: the seeded capture). The record is a value the frame was born holding — the retired $<hname>_state_g singleton was a bracket-scoped CACHE of it, and a closure's own $__state is its closure record (the measured 32-not-46 / 20-not-25 silent state loss, both disciplines)
  | LStateSlotStore(Int, Int, LowExpr, LowExpr)
  // handle, handler declaration, slot index, value — a state field's FIRST
  // store, in its handler's init fn (`lower_init_decl`), whose $__state is
  // the install record. A commit writes through a wide field's cell
  // (LStateSlotStore); the init makes the cell. The handler is what the emit
  // walk judges a perform inside the init against: that handler is not
  // installed yet while its init runs.
  | LStateInit(Int, Int, Int, LowExpr)
  // to_string — operand type read at EMIT under the active
  //   specialization bracket (show_node_of, backends/wasm.mn —
  //   the one dispatch home; emit_binop_for's altitude)
  | LShow(Int, LowExpr)
  // hash — the same emit-time read (eq/hash agreement in twins)
  // Typed terminal for a compiler-created executable-edge invariant. It has no
  // value representation and no recovery arm; emit projects only `unreachable`.
  | LHash(Int, LowExpr)
  | LInvariantFailure(Int, BoundaryInvariant)
  // Stage 4a: direct WASM-level op. A perform whose op_name is in
  // is_wasi_import_op (spawn_task, join_task, fd_write, path_open, the
  // atomics, …) bridges through this variant so emit produces the raw
  // instruction sequence or `(call $<name>)` directly — bypassing the
  // LPerform/$op_<name> handler-arm dispatch (which would require a
  // wrapper fn). The import IS the bridge; no wrapper.
  //
  // handle, import name (no $ prefix), args
  | LWasiCall(Int, String, [LowExpr])

// HOW MUCH OF THE WALK WAS ALREADY DONE — the one perform's only variation.
// The operation is fixed: find, innermost-out, the installed handler that
// DECLARES this op; run its arm against its record, under its install world.
// What differs is the epoch at which each part of that answer became
// available, which is a property of the program and not a mode anyone
// selects (Hβ.kernel.staging-is-an-epoch-not-a-mode).
//
// TWO AXES, NOT THREE TIERS, and the first shape of this node got that
// wrong. It shipped as PdLexical | PdResolved | PdWalked — which is exactly
// the lexical / singleton / evidence tiers the collapse had just deleted,
// re-entered as an enum, with the emit still branching on them FIVE times
// inside the one arm that claimed they were one operation. The axes are
// independent:
//
//   WHERE THE RECORD AND WORLD COME FROM — the frame (the install's own two
//     locals, because the walk finished at compile time) or the walk (the
//     node, whose entry carries the record and whose iw@12 carries the world)
//   HOW THE ARM IS REACHED — a static symbol, or an index out of the
//     record's own slot
//
// Three constructors over two binary axes leaves the fourth combination
// (frame, slot) representable and meaningless — a PRODUCT encoded as a SUM,
// which is drift-8 at the type level. Nesting ArmTarget under PdWalk makes it
// unconstructible: a frame answer knows the handler, so it always knows the
// symbol, and only a walk can reach an arm through a slot.
//
// PdFrame(install, handler declaration, op) — the install is in this very
//   frame.
// PdWalk(effect key, op slot, op, target) — the walk yields record and world;
//   the target holds the declaration of the handler when one declares the
//   op, else ArmSlot and the arm comes out of the record.
// PdDriver(handler declaration, record) — NOT a dispatch. A direct call to
//   the handler's redrive (`redrive_fn_name`) against the INSTALL record it drives, read through the
//   record ladder (`resolve_hrec`): the arm's own `$__state` at arm level, a
//   lambda's or a nested fn's captured record. It used to be
//   the CALLER's own `$__state`, which is the install record only in the
//   arm's own frame; a resume inside a lambda re-drove through the closure
//   record and the install answered an address (measured 2026-10-01,
//   tests/micros/mn-held-resume-lambda-reyield.mn). It stays in this type
//   because it stands in the dispatch position, and it is the one shape
//   that must not bracket — naming it is what lets every other shape
//   bracket unconditionally.
//
// The HANDLER and the OP stay separate, never the `<h>_<op>` symbol they
// spell. Emit wants the symbol; the emit-walk's preinstall-init check wants
// the handler alone and the executable-root census wants the op alone, and a
// stored fusion serves the first by making the other two unaskable —
// measured once already in this arc, as three micros that stopped naming
// E_InitPerformsOwnOp the moment the name went in pre-joined. The emit
// spells the symbol where it calls it — under the install's key for a frame
// answer (`arm_site_pairs`) — and nothing stores it.
type ArmTarget = ArmNamed(Int) | ArmSlot

type PerformDispatch = PdFrame(Int, Int, String) | PdWalk(String, Int, String, ArmTarget) | PdDriver(Int, LowExpr)

// The op a dispatch performs — None for a driver, which is not an op.
fn perform_op_name(disp) = match disp {
  PdFrame(_, _, op_name) => Some(op_name),
  PdWalk(_, _, op_name, _) => Some(op_name),
  PdDriver(_, _) => None,
}

// LZero is the zero of the representation its handle reads at EMIT, under
// the bracket in force — the value a width-agreeing placeholder needs, since
// a twin's bracket decides that width and lowering runs before it exists.
type LowValue = LInt(Int) | LFloat(Float) | LString(String) | LBool(Bool) | LZero

type LowFn = LFn(String, Int, [String], [LowExpr], Int, [(Int, Int, LineHome)])

// name, arity, param names, body stmts, fence, lines. It carries no effect
// row: the row a fn's code answers to is the judgment's, read live where it
// is asked (alloc_unit_named, wasm.mn), and the copy that stood here was
// read by nothing while five of its seven writers filled it with `Pure`.
// lines = the fn's `<~` sites as (site handle, depth, home), so the record's minter (a
// closure mint, an install, a k reification, the static line init) sizes
// the record by their count and fills each line's own slot with its ring.
// fence = where this fn's __state evidence region starts,
// in slots past the 8-byte header: closures pass their
// capture count; handler arm fns pass nstate+total_arms
// (the record's captured-evs sit after state AND arms);
// plain top-level fns pass 0. emit_fn_body installs it as
// the body-context so every LEvRef key-scans the
// captured_evs region based at 8+4*fence — one rule across all three fn shapes.
type FieldSel = FByName(String) | FByIndex(Int)

// The continuation a boundary mints when a live one crosses it: the
// remainder's function, the values the remainder reads from before the
// boundary, and the `<~` lines it ticks — each the line its frame owns,
// shared into the record (`LhShare`). The record is a closure head
// [fn][nc][captures], then the world it was captured in, then the lines.
type KSite = KSite(KFn, [LowExpr], [(Int, Int, LineHome)])

// A remainder's function: declared at the boundary in the frame that owns
// it, and named where an earlier boundary's remainder reaches the same
// boundary and mints the record again from its own scope.
type KFn = KDef(LowFn) | KRef(String)

type LowPat
  = LPVar(String)
  | LPWild
  // name, tag_id (from ConstructorScheme), and each sub-pattern WITH the
  // payload type the scrutinee proved at this use — the same shape LPTuple
  // has carried since its own offsets stopped being baked. The emit walkers
  // used to take the pattern from here and the payload types from a SECOND
  // read keyed by the constructor's NAME, and that second read answered with
  // the DECLARED types: `Some`'s payload is the quantified `a`, so a binder
  // for `Some(1.5)` was declared at the word floor and read back at f64 —
  // `unknown local $v.f64`, a module that does not assemble (measured
  // 2026-09-18). One source, one truth: the two lists cannot disagree
  // because there is only one.
  | LPCon(String, TagId, [(Ty, LowPat)])
  // a pattern naming a ctor no declaration proves — infer already reported the miss; the match test is FALSE (no tag exists to compare) and the sub-binders still declare so the dead arm body assembles. Replaces the fabricated tag -1, which violated TagId's own 0..255 refinement — the armed E_RefinementRejected caught it on the wheel the hour the class armed.
  | LPUnresolvedCon(String, [LowPat])
  // [(elem_ty: Ty, sub_pat: LowPat)]
  // positional product: each element carries its
  // proven Ty — a LIVE var handle in a generic
  // body. (offset, width) project at EMIT through
  // the bracket-aware channel (slot_repr /
  // pat_tuple_off), so a twin's instantiation
  // closes the layout; a lower-time offset bake
  // would freeze the word floor into the twin
  | LPTuple([(Ty, LowPat)])
  | LPLit(LowValue)
  // (element type, prefix pats, optional rest name, the scrutinee's proven
  // representation). The element type is the one this position matched, a
  // generic body's own variable included, so the emit reads each element's
  // width through it under whatever twin it emits, and reads a proven-flat
  // list raw only where that width is a word held by value
  // (wasm.mn's list_elem_read).
  | LPList(Ty, [LowPat], Option(String), SeqRep)
  // (scrutinee handle, receiver type, [(field_name, sub_pat)], rest binder).
  // The receiver's type is the one this position matched, a generic body's
  // own variables included, so the emit reads the WHOLE field set through
  // it under whatever twin it emits (`record_full_fields`): each named
  // field's offset and width, and the rest's residual record, which it
  // builds by copying each remaining slot. A field set that never closes
  // floors loudly, reported at the scrutinee.
  | LPRecord(Int, Ty, [(String, LowPat)], Option(String))
  // name @ pat — binds the whole value at the pattern's own path,
  // then the inner pattern destructures the same slot
  | LPAs(String, LowPat)
  // alternation branches; arm matches if ANY
  // branch matches (predicate = OR); branches
  // bind the same names (infer's law)
  | LPAlt([LowPat])

// Extract the source TypeHandle from any `LowExpr` variant.
// One arm per variant, no fallback — new variants surface at compile time.
fn lexpr_handle(e) with Pure = match e {
  LConst(h, _) => h,
  LLocal(h, _) => h,
  LGlobal(h, _) => h,
  LLet(h, _, _) => h,
  LUpval(h, _) => h,
  LBinOp(h, _, _, _) => h,
  LUnaryOp(h, _, _) => h,
  LCall(h, _, _) => h,
  LTailCall(h, _, _) => h,
  LDirectCall(h, _, _, _, _) => h,
  LReturn(h, _) => h,
  LMakeClosure(h, _, _) => h,
  LShow(h, _) => h,
  LHash(h, _) => h,
  LResumeK(h, _, _, _) => h,
  LYield(h, _, _, _) => h,
  LCheck(h, _, _) => h,
  LAbandon(h, _, _) => h,
  LDeclareFn(_) => 0,
  LIf(h, _, _, _) => h,
  LBlock(h, _) => h,
  LMakeList(h, _) => h,
  LMakeTuple(h, _) => h,
  LSimdLanes(h, _) => h,
  LFanout(h, _, _, _) => h,
  LMakeRecord(h, _) => h,
  LRecordUpdate(h, _, _) => h,
  LMakeVariant(h, _, _) => h,
  LMatch(h, _, _) => h,
  LHandleWith(h, _, _, _, _, _) => h,
  LDerive(h, _, _) => h,
  LArena(h, _) => h,
  LFeedback(h, _, _, _, _) => h,
  LFeedbackPrior(h) => h,
  LPerform(h, _, _) => h,
  LFieldLoad(h, _, _) => h,
  LPrim(h, _, _) => h,
  LStateSlotStore(h, _, _, _) => h,
  LStateInit(h, _, _, _) => h,
  LInvariantFailure(h, _) => h,
  LWasiCall(h, _, _) => h,
}

// to_string / hash are STRUCTURAL nodes (LShow / LHash) — their type
// dispatch lives at EMIT (show_node_of / hash_node_of, backends/wasm.mn),
// where the operand's type is read live under whatever specialization
// bracket is active. Lower used to read the type HERE and bake a renderer
// NAME into the tree — the one pair of type-directed decisions an emit-time
// bracket could not re-make (a twin's to_string on its instantiated var
// rendered the ADDRESS; its hash used the pointer). The reach projections
// (show_reach_names / hash_reach_names) mirror the same dispatch so the
// prune keeps what emit will mint.
//
// Hβ.lower.tail-call-mark-pass — rewrite LCall→LTailCall in tail position.
// Tail position is a structural property: branches of LIf, last stmt of
// LBlock, arm bodies of LMatch. LHandleWith / LFeedback do NOT
// propagate tail (their cleanup runs after the body's last expression).
// Without this, lex_from / scan_decimal recursive calls compile as
// regular call_indirect and exhaust the WASM stack on long inputs.
// Called by FnStmt / LambdaExpr / handler-arm-body lowering after lower_expr.
fn mark_tail(e) = match e {
  LCall(h, fn_, args) => LTailCall(h, fn_, args),
  LDirectCall(h, fh, n, _, args) => LDirectCall(h, fh, n, true, args),
  LFanout(h, lex, br, forms) => LFanout(h, lex, br, map(mark_tail_form, forms)),
  LIf(h, cond, then_b, else_b) => LIf(h, cond, mark_tail_last_in(then_b), mark_tail_last_in(else_b)),
  LBlock(h, stmts) => LBlock(h, mark_tail_last_in(stmts)),
  LMatch(h, scrut, arms) => LMatch(h, scrut, mark_tail_arms(arms)),
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LTailCall(_, _, _) | LReturn(_, _) | LMakeClosure(_, _, _)
  | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _) | LDeclareFn(_) | LMakeList(_, _)
  | LMakeTuple(_, _) | LSimdLanes(_, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _)
  | LMakeVariant(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _)
  | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
  | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
  | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => e,
}

// A fanout's forms each stand in the fanout's own position: a sequence
// fanout's form is a call, and a tail site's call is a tail call.
fn mark_tail_form(sf) = match sf {
  (s, e) => (s, mark_tail(e)),
}

// Return a fresh flat list with the last element replaced by mark_tail(last).
// Materializes via list_to_flat so callers can pass any list shape (concat,
// slice, snoc) — substrate-honest per list_set's tag=0 contract.
fn mark_tail_last_in(stmts) = {
  let n = len(stmts)
  if n == 0 {
    stmts
  } else {
    let flat = list_to_flat(stmts)
    let last_idx = n - 1
    list_set(flat, last_idx, mark_tail(list_index(flat, last_idx)))
  }
}

fn mark_tail_arms(arms) = map({ (pat, body) => (pat, mark_tail(body)) }, arms)

// The symbol a callee is emitted under at the floor: its declaration's
// (`decl_symbol`), or a synthesized unit's identity. A twin mangles it
// (`spec_mangle`).
fn callee_symbol(c) = match c {
  DeclaredAt(d) => decl_symbol(d),
  Synthesized(s) => s,
}

// The symbol a module-scope declaration is emitted under: its module's name
// and the name of the declaration that holds it (`enclosing_decl_name`),
// joined by `.`. A name is unique within its module and a module's name
// within the link, so two modules that declare one name emit two symbols. A
// function nested in a declaration extends its symbol (`ls_fn_symbol`), and
// a handler's arms, state init and redrive are spelled off it
// (`arm_fn_name`). Spelled once per declaration (`ls_decl_symbol`) and read
// after: every reference, twin key and demand reads it. A declaration no
// statement holds — a primitive the judgment mints — constructs no unit and
// has no symbol, and every call site lowers it as an instruction, so
// reaching one here is a defect in the caller.
fn decl_symbol(d) = match enclosing_decl(d) {
  Some(s) => ls_decl_symbol(s),
  None => trap(),
}

// The symbol a name of the compiler's own vocabulary is emitted under: the
// declaration it resolves to at the link's scope, or the spelling where no
// declaration answers — a function the emit writes itself.
fn vocab_symbol(n: String) = callee_symbol(vocabulary_callee(n))

// A name of the compiler's own vocabulary — a library function a lowering
// or an emit calls by name — as the declaration it resolves to at the link's
// scope, read where the call is minted. A name the link declares nowhere is
// the symbol it spells.
fn vocabulary_callee(n: String) = match env_resolve_linked(n) {
  Some(d) => DeclaredAt(d),
  None => Synthesized(n),
}

// The primitive a sugar calls, read off the edge the judgment drew at the
// sugar's node; a sugar whose primitive the link does not declare calls the
// runtime's own, under the vocabulary's name.
fn sugar_callee(h, n: String) = match graph_ref_decl(h) {
  Some(d) => DeclaredAt(d),
  None => Synthesized(n),
}

// What a callee's declaration was published as; a synthesized unit was
// published as nothing.
fn callee_kind(c) = match c {
  DeclaredAt(d) => published_kind(Some(d)),
  Synthesized(_) => None,
}

// A call's positional product, read where the judgment wrote it (the
// call-product column): the argument nodes in declaration order — labels
// resolved, absent fields filled by their defaults, an authored `??` in
// place — the cells typing the slots a partial leaves open past them, and
// the shape the judgment decided, applied or suspended. The lowering
// resolves no callee by name and re-decides no shape: the product is the
// call node's own fact, whatever the module env says of the name — a
// parameter, a local or a field callee is the callee the call resolves to
// (Hβ.lower.callee-resolved-by-name-in-the-module-env). A call the judgment
// never reached has no product; that is the compiler's own invariant
// broken, reported, with the raw arguments the productive-under-error order.
fn call_product_at(handle, args) = match graph_product_at(handle) {
  ProductOf(nodes, open, shape) => (nodes, open, shape),
  NoProduct => {
    report(EInternalInvariant(
      "a call's argument product was never judged: the lowering reached a call the judgment did not",
      graph_span_of(handle)
    ))
    (map(unwrap_labeled_arg, args), [], CallApplied)
  },
}

fn call_product_nodes(handle, args) = match call_product_at(handle, args) {
  (nodes, _, _) => nodes,
}

// The `CallExpr` dispatch falls back to this when the callee isn't a
// `SchemeKind`-recognized constructor or effect op. Every call is BARE:
// the callee's performs dispatch through the LIVE WORLD CHAIN
// (the world-as-value arc's R2), so no call threads an evidence region,
// and a callee that resumes reads the continuation its own record carries.
fn lower_call_default(handle, f, lo_args) = lower_call_of(handle, lower_expr(f), lo_args)

// A call whose callee is already lowered: the dispatch that resolved the
// callee's name hands its read over, so the name is resolved once per call.
// The direct cash-out: a callee lower resolved to a top-level fn's OWN
// global (LGlobal minted from a FnScheme VarRef — locals shadowed it first,
// value bindings carry another kind) calls the fn BY NAME with native args.
// Carried-Truth at the dispatch: lower proved the callee's identity;
// routing through the closure re-derived it at runtime through a table hop
// that broke tail-calls (the wf$ wrapper frame leak — one leaked frame per
// iteration of every deep tail recursion routed through a wide fn's word
// face, measured at 4096 frames under the signal crucible).
fn lower_call_of(handle, lo_f, lo_args) = match lo_f {
  LGlobal(gh, c) => match callee_kind(c) {
    Some(FnScheme) => LDirectCall(handle, gh, c, false, lo_args),
    None | Some(_) => LCall(handle, lo_f, lo_args),
  },
  LConst(_, _) | LLocal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
  | LDeclareFn(_) | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _)
  | LSimdLanes(_, _) | LFanout(_, _, _, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _)
  | LMakeVariant(_, _, _) | LMatch(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _)
  | LDerive(_, _, _) | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
  | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
  | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => LCall(handle, lo_f, lo_args),
}

// The saturated call's ONE dispatch body — two callers project through it:
// lower_expr's CallExpr arm (behind the partial fork) and lower_pipe_complete
// (fork-free by construction: the pipe owns its hole and completes it by the
// inline splice, so a pipe-right hole-bearing call must never mint a partial
// closure — the splice is the zero-record, evidence-correct projection of
// the same hole-filling semantics).
//
// A named callee is resolved ONCE, here, and the resolution decides. A
// binding the lowering's own scope holds — a parameter, a local, a capture —
// is this call's callee whatever the global env says of the same name (an
// op, a constructor, an intrinsic): a parameter named `result`, called, was
// lowered as the `Iterate` op of that name and trapped at the root (measured
// 2026-09-28 in derive.mn's jvp_pair).
fn lower_call_dispatch(handle, f, fbody, r_args) = {
  let lo_args = lower_expr_list(r_args)
  match fbody {
    NExpr(VarRef(name)) => match ls_resolve(name) {
      (RGlobal, _) => {
        site_schedule_seed(f)
        lower_global_call(handle, f, name, r_args, lo_args)
      },
      (res, local_h) => lower_call_of(handle, lower_resolved_ref(f, name, res, local_h), lo_args),
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => lower_call_default(handle, f, lo_args),
  }
}

// A global call site notes the schedule its own frame installs, keyed by the
// callee reference the emitted call carries, so the emit's demand reads the
// site's own install before the bracket (`twin_call_key`); a site under no
// install notes nothing and inherits. Only a global call can name a fn the
// schedule reaches, which is why the seed stands at this one arm.
fn site_schedule_seed(fh) = match lower_site_schedule() {
  Some(s) => site_schedule_note(fh, s),
  None => (),
}

// A call whose callee resolved to module scope, where the env's kinds live:
// a primitive, an intrinsic, a substrate op, a constructor, an effect op, or
// a function. A primitive is read off the declaration the callee's edge
// reaches; it applies its instruction where it stands.
fn lower_global_call(handle, fh, name: String, r_args, lo_args) = match published_kind(graph_ref_decl(fh)) {
  Some(PrimitiveKind(p)) => LPrim(handle, p, lo_args),
  Some(_) | None => lower_named_call(handle, fh, name, r_args, lo_args),
}

fn lower_named_call(handle, fh, name: String, r_args, lo_args) = if name == "to_string" && len(r_args) == 1 {
  LShow(handle, last(lo_args))
} else if name == "hash" && len(r_args) == 1 {
  // hash(x) IS the HASH leaf of the structural fold — dispatched at
  // EMIT from the node's live type (hash_node_of), never a name baked
  // here, so a twin's bracket re-answers it (eq/hash agreement).
  LHash(handle, last(lo_args))
} else if name == "tangent_of" {
  // What `d(v)` MEANS under `~> grad(w)` — and only there. The one arm that
  // writes it is a projection's, which is never lowered, so reaching
  // this line means a program called it where no reading can answer.
  report(EDerivativeUnreachable(
    "`tangent_of` is what `d` means inside a derivative reading, and this call is outside every one; ask `d(v)` inside `(…) ~> grad(w)`",
    graph_span_of(handle)
  ))
  LInvariantFailure(handle, TangentOutsideReading)
} else if name == "fanout" && len(r_args) == 2 {
  // THE SEQUENCE FANOUT — `><` over a runtime sequence: `fanout(f, xs)`
  // applies f to each element as an INDEPENDENT branch and collects the
  // results in order, under whatever schedule governs the site (its own
  // frame's install, or a caller's reaching it through a direct call). The
  // prelude declares it as the sequential reading (`map`, which is what a
  // compiler without this arm runs); here it is a fanout node like the
  // syntactic ones, its branches the function argument's applications,
  // each form a call into the library that owns the schedule's vocabulary
  // — `map` sequentially, `fanout_threaded` under Thread,
  // `fanout_persisted` under Persist. `map` itself stays a sequential loop
  // by construction (SYNTAX §Vocabulary): only a fanout declares its
  // applications independent. A pipe reaches the same node with the datum
  // as its second field (`completed_call`).
  lower_fanout_seq(handle, fh, list_index(r_args, 0), lo_args)
} else if is_substrate_mem_op(name) {
  // Memory / Alloc ops ARE the instruction set — "the WASM runtime
  // IS the handler" (lib/memory.mn). They project to raw
  // instructions, never through evidence: routing them Tier-2 made
  // the evidence walk's own loads dispatch through the evidence
  // walk (the scan recursing into itself — the handler rung's
  // runtime stack overflow). LWasiCall is the direct-substrate
  // node; emit dispatches the name to its instruction.
  LWasiCall(handle, name, lo_args)
} else {
  match published_kind(graph_ref_decl(fh)) {
    Some(ConstructorScheme(tag_id, _)) => LMakeVariant(handle, tag_id, lo_args),
    // Nominal-record CALL-form construction `Pri({...})`: the runtime
    // representation IS the bare record (NamedRecordExpr's own arm
    // lowers to LMakeRecord — type identity is type-system-only, no
    // tag). The single argument already IS that record; the wrapper
    // is the identity at this layer. Arity is the infer gate's
    // business (the ctor-pattern arrow view unifies one param); a
    // zero-arg call (already reported there) lowers to the empty
    // record, never a garbage read past an empty args list.
    Some(RecordSchemeKind(_)) => if len(lo_args) == 0 { LMakeRecord(handle, []) } else { list_index(lo_args, 0) },
    // ONE perform, whose DISPATCH says how much of the walk this
    // site could finish now (PerformDispatch). PLAN §6's
    // handler-elimination tiers are degrees of that boundness, not
    // three operations: the meaning is always "walk innermost-out to
    // the node that DECLARES this op, run its arm against its record,
    // under its install world."
    // A WASI import op bridges directly to the WASM-level import
    // (no $op_<name> handler arm) — the import IS the bridge.
    // addr (effect Cast) erases to its OPERAND: the word face IS
    // the address, so the emission is identity and no demand ever
    // reaches the executable gate — the row carries the whole
    // meaning (with Cast admits; !Cast severs).
    Some(EffectOpScheme(_, _, _)) => if is_cast_erased_op(name) {
      list_index(lo_args, 0)
    } else if is_wasi_import_op(name) {
      LWasiCall(handle, name, lo_args)
    } else {
      lower_perform_dispatch(handle, name, lo_args)
    },
    None | Some(_) => lower_call_of(handle, lower_resolved_ref(fh, name, RGlobal, 0), lo_args),
  }
}

// The partial fork's ONE decider reads the judgment's decision off the call
// node's product (`CallShape`, written by infer_call_node): a call the
// judgment SUSPENDED mints the partial, the callee's declared arity its proof
// — the TFun read once here and carried to the mint, never re-derived there
// — and an APPLIED call dispatches. A substrate op's holed form is the
// pipe's to complete and is never minted here (a hole it leaves in value
// position is refused as a hole). Before 2026-10-13 this fork re-read the
// authored `??` and the argument count to re-make the decision, so a call
// the judgment applied with a value hole at an operand (`choose(??) + 1`)
// would have minted a closure where the judgment had typed a word; the
// shape is one fact with one writer.
//
// THE ARITY IS THE SIGNAL the judgment reads, and it used to be the authored
// `??` alone. Requiring the marker made SYNTAX's own headline spelling
// miscompile: `add(1)` against a 2-param fn typed clean, fell through to the
// direct-call emit, and produced `(call $add)` with two operands where three
// were expected — caught by wat2wasm, an oracle outside the medium, and by
// nothing inside it. The `??`-marked twin ran correctly throughout, so the
// mint was built and only the decider refused; `partial_split` has always
// turned a slot past the supplied args into a param (its own comment says
// "or a hole-adjacent short tail").
//
// The reason the marker was there — a recovered callee's TFun arity is a
// guess under productive-under-error — is real, and it is already answered
// one layer down rather than here: `partial_callee_form` admits only a
// resolved FnScheme or ConstructorScheme, and `lower_call_partial` floors
// everything else typed (LInvariantFailure/PartialCalleeShape). A guessed
// arity therefore reaches a floor, never a wrong call. Measured beside it:
// a callee that failed to resolve raises E_MissingVariable, an armed class,
// so that program emits zero bytes and has no module to collapse.
fn partial_unfilled(fh, shape) = match shape {
  CallApplied => None,
  CallSuspended => if reaches_substrate(fh) {
    None
  } else {
    match lookup_ty(fh) {
      TFun(ps, _, _) => Some(len(ps)),
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
      | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => None,
    }
  },
}

// The partial's declaration-order slots — ONE walk, each arg visited once
// (O(1) per slot; the flat r_args indexes O(1)), producing all three
// projections in the same descent: (captures, param_names, body_args).
// A supplied slot's arg lowers HERE, in arg order (evaluation-once —
// product fields are constructed at the product's mint, filling a hole
// RESUMES and never re-evaluates), rides the closure record, and is read
// back by its capture ordinal (LUpval). An unfilled slot (authored `??`,
// or a hole-adjacent short tail) becomes a param of the synthesized fn
// (LLocal), typed by its own cell — the hole node's handle for an authored
// `??`, and for a tail slot the cell the judgment bound beside the product
// (`open_slot_cells`, infer.mn) — so each open slot reads at its own width.
// The descent's fourth projection is that cell per open slot, in order: the
// synthesized fn's signature. A tail slot used to carry the partial node's
// handle, the arrow's word, so a wide tail parameter's local was declared
// at the word and never defined (`fadd(1.5)` over a Float pair did not
// assemble, measured 2026-09-30).
fn partial_split(r_args, open, n_args, n_ps, handle, i, ci) = if i >= n_ps {
  ([], [], [], [])
} else if i >= n_args {
  let pn = "__part_{int_to_str(i)}"
  let cell = open_slot_handle(open, i - n_args, handle)
  match partial_split(r_args, open, n_args, n_ps, handle, i + 1, ci) {
    (caps, names, bargs, cells) => (caps, [pn] ++ names, [LLocal(cell, pn)] ++ bargs, [cell] ++ cells),
  }
} else {
  let arg = list_index(r_args, i)
  match graph_node_body(arg) {
    NHole(_) => {
      let pn = "__part_{int_to_str(i)}"
      match partial_split(r_args, open, n_args, n_ps, handle, i + 1, ci) {
        (caps, names, bargs, cells) => (caps, [pn] ++ names, [LLocal(arg, pn)] ++ bargs, [arg] ++ cells),
      }
    },
    NExpr(_) | NStmt(_) | NPat(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => {
      let e = lower_expr(arg)
      match partial_split(r_args, open, n_args, n_ps, handle, i + 1, ci + 1) {
        (caps, names, bargs, cells) => ([e] ++ caps, names, [LUpval(lexpr_handle(e), ci)] ++ bargs, cells),
      }
    },
  }
}

// The cell typing the k-th open tail slot, written by the judgment beside
// the product. A slot past the cells is the invariant broken — reported,
// the partial node's own handle the productive stand-in.
fn open_slot_handle(open, k, handle) = if k < len(open) {
  list_index(open, k)
} else {
  report(EInternalInvariant("a partial's open slot has no cell typing it", graph_span_of(handle)))
  handle
}

// The callee shapes a partial can synthesize a body for, as a VALUE rather
// than as a returned closure: fn name · variant tag · the singleton-tier
// perform's (handler, op, stateful) triple · a local callee's value · a
// primitive's instruction · the structural show and hash. Each carries
// exactly what apply_callee_form needs and nothing the site could re-derive.
type PartialCalleeForm
  = PcfCall(Callee)
  | PcfVariant(TagId)
  | PcfPerform(PerformDispatch)
  | PcfLocal(LowExpr)
  | PcfPrim(Primitive)
  | PcfShow
  | PcfHash

// The callee is resolved ONCE, by scope, exactly as the saturated call's
// dispatch resolves it (`lower_call_dispatch`): a binding the lowering's
// own scope holds — a parameter, a local, a capture — is the callee
// whatever the module env says of the same name, and its value rides the
// partial's record as the last capture, called by the synthesized body. A
// let-bound function that shadowed a top-level one of its name used to be
// looked up by name in the module env, so the partial called the top-level
// one (6 for 5, zero diagnostics, boot 523f1732), and a local with no module entry
// was a floor (Hβ.lower.callee-resolved-by-name-in-the-module-env). Module
// scope keeps its kinds: a top-level fn or module value (LCall through its
// global), ADT construction (LMakeVariant), an op reified as a value.
fn partial_callee_form(handle, fbody, fh) = match fbody {
  NExpr(VarRef(name)) => match ls_resolve(name) {
    (RGlobal, _) => partial_global_callee_form(fh, name),
    (res, local_h) => Some(PcfLocal(lower_resolved_ref(fh, name, res, local_h))),
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// A module-scope callee's form, by what its declaration was published as —
// the declaration the reference's edge reaches. A primitive is a function
// like any other, so a reference to one as a value is the closure whose body
// applies its instruction, and so is the show or the hash a fold face's
// call is (its raw body never runs). The substrate/wasi instruction ops have
// no global fn to LCall — a partial over one floors typed with the rest of
// the unbuilt shapes, never a call past the projection.
fn partial_global_callee_form(fh, name) = if name == "to_string" {
  Some(PcfShow)
} else if name == "hash" {
  Some(PcfHash)
} else if is_substrate_mem_op(name) || is_wasi_import_op(name) {
  None
} else {
  let decl = graph_ref_decl(fh)
  match published_kind(decl) {
    // A module value holding a closure is called through its global
    // exactly as a declared fn's static closure is. Only module-scope
    // entries answer here: a local's binding left the env with its scope.
    Some(FnScheme) | Some(ValueScheme) => match decl {
      Some(d) => Some(PcfCall(DeclaredAt(d))),
      None => None,
    },
    Some(ConstructorScheme(tag_id, _)) => Some(PcfVariant(tag_id)),
    // An OP reified as a value, and it passes None for the lexical
    // answer — not to disable a tier, but because it HAS no lexical
    // answer: this body becomes a lifted fn, so a frame local resolved
    // here would name a frame that is gone by the time it runs. The walk
    // therefore finishes at call time, which is where an escaped
    // closure's handler actually is (the same read-the-schedule-live law
    // `><` obeys).
    //
    // This arm used to REFUSE whenever the op was ambiguous, because the
    // only runtime walk it could reach keyed on the handler NAME and an
    // ambiguous op has no single one. That refusal was the whole of the
    // eta-wrapper ceiling. The op-keyed walk has no such gap, so there is
    // nothing left to decline.
    Some(EffectOpScheme(_, _, _)) => Some(PcfPerform(perform_dispatch_of(name, None))),
    Some(PrimitiveKind(p)) => Some(PcfPrim(p)),
    None | Some(_) => None,
  }
}

// The callee form APPLIED — the one place a settled form meets its args.
// This used to be three returned CLOSURES, which is drift mode 1 with the
// serial numbers filed off: a closure carrying a dispatch decision IS the
// vtable, the word never appears in correct Mentl, and the anonymity tier
// counted all three as effectful lambdas. The form is an ADT and the
// dispatch is a match, so the decision is a VALUE the caller can read,
// name and test — and the three lambdas are gone rather than relocated.
fn apply_callee_form(form, handle, fh, bargs, n_caps) = match form {
  PcfCall(c) => LCall(handle, LGlobal(fh, c), bargs),
  PcfVariant(tag_id) => LMakeVariant(handle, tag_id, bargs),
  PcfPerform(disp) => LPerform(handle, disp, bargs),
  // The callee value rides the record past the supplied fields, at the
  // capture ordinal the supplied slots leave free; the body calls it.
  PcfLocal(v) => LCall(handle, LUpval(lexpr_handle(v), n_caps), bargs),
  PcfPrim(p) => LPrim(handle, p, bargs),
  PcfShow => LShow(handle, last(bargs)),
  PcfHash => LHash(handle, last(bargs)),
}

// What the callee form adds to the partial's record: a local callee's
// value, captured beside the supplied fields; the module-scope forms name
// their callee statically and capture nothing.
fn partial_callee_capture(form) = match form {
  PcfLocal(v) => [v],
  PcfCall(_) => [],
  PcfVariant(_) => [],
  PcfPerform(_) => [],
  PcfPrim(_) => [],
  PcfShow => [],
  PcfHash => [],
}

// PARTIAL APPLICATION AS A VALUE — the mint. The record is LambdaExpr's
// exactly (fn_ptr@0, nc@4, captures@8; emit's deep walk lifts the LFn, the
// caller dispatches through the same W7 closure-call convention), built by
// the k1 lower-time LFn-synthesis precedent. An EFFECTFUL callee needs no
// evidence in the synthesized frame — its performs dispatch through the
// live world chain at call time (the world-as-value arc dissolved
// Hβ.lower.partial-effectful-callee's typed floor).
// The lambda body PROJECTOR (the lowering-column arc, landing shape α
// — the direct swap): the ONE construction of a lambda's LowFn, seeded
// from program+columns — params from the origin's own program-column
// LambdaExpr (probe-proven equal to the walked value at every lambda,
// whole-wheel), the frame from the capture pairs the caller just noted
// into the enumeration. LOWERING IS A PURE PROJECTION (the mint
// census reached zero: the splice-show mint died into the
// parse-minted ShowExpr; the interior-concat mint into the
// judge-minted InterpBoundary) — same graph in, same tree out, so
// dual-run coherence is available again wherever a gate wants it;
// this construction stays single-run and behaviorally gated.
fn project_lambda_fn(origin, cap_pairs) = match graph_node_body(origin) {
  NExpr(LambdaExpr(params, body_node)) => {
    let cap_names = map({ (n, _) => n }, cap_pairs)
    let cap_handles = map({ (_, h) => h }, cap_pairs)
    let param_names_list = lower_param_names(params)
    // A lambda's lines follow its captures in the closure record.
    ls_enter_frame("", param_names_list, params, cap_names, cap_handles, len(cap_pairs))
    lower_frame_fence_push()
    let layers = lower_param_destructures(params)
    let lo_body =
      capture_frame(mark_tail(wrap_param_destructures(layers, lower_expr(body_node))), ret_ty_of(origin))
    lower_handler_pop()
    let lines = ls_exit_frame()
    Some(LFn("lambda_{int_to_str(origin)}", len(params), param_names_list, [lo_body], len(cap_pairs), lines))
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// The nested-fn body projector (landing shape α, second kind): the ONE
// construction of a nested FnStmt's LowFn — params from the origin's node,
// the frame from the entry's capture pairs, the composed name from the
// enumeration entry. A nested fn is minted where it is declared, as a lambda
// is, so its body lowers in the context it stands in: a resume in it belongs
// to the arm that encloses the declaration, reads the k and the install
// record its record captured there (`lower_seed_k`), and resolves its state
// fields and its discipline through that arm's context.
fn project_nested_fn(origin, fn_name, cap_pairs) = match graph_node_body(origin) {
  NStmt(FnStmt(_name, params, _ret_ann, _effs, body_node)) => {
    let cap_names = map({ (n, _) => n }, cap_pairs)
    let cap_handles = map({ (_, h) => h }, cap_pairs)
    let param_names_list = lower_param_names(params)
    // A top-level fn's frame is entered with no frame below it; its record
    // is the module's static data record, so its lines are STATIC — an
    // instance global per site. A nested fn is a closure: its lines follow
    // its captures in the record its mint builds.
    let line_base = if ls_frame_depth() == 0 { -1 } else { len(cap_pairs) }
    ls_enter_frame(fn_name, param_names_list, params, cap_names, cap_handles, line_base)
    lower_frame_fence_push()
    let layers = lower_param_destructures(params)
    let lo_body =
      capture_frame(mark_tail(wrap_param_destructures(layers, lower_expr(body_node))), ret_ty_of(origin))
    lower_handler_pop()
    let lines = ls_exit_frame()
    Some(LFn(fn_name, len(param_names_list), param_names_list, [lo_body], len(cap_pairs), lines))
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

// The thunk body projector (landing shape α, third move — and the
// uniform pass over the fanout pair): ONE construction for both thunk
// shapes, the share-vs-distribute discriminator an Option —
// Some(input_h) is the `<|` diverge (the branch APPLIED to the shared
// input riding capture slot 0), None the `><` branch (the branch
// evaluated as its own value). The per-site family collapses; the
// sites keep the boundary destructure and the capture machinery that
// feed the columns.
fn project_thunk_fn(thunk_name, cap_pairs, branch_node, result_h, carrier_h, shared_input) = {
  let cap_names = map({ (n, _) => n }, cap_pairs)
  let cap_handles = map({ (_, h) => h }, cap_pairs)
  ls_enter_frame("", [], [], cap_names, cap_handles, len(cap_pairs))
  lower_frame_fence_push()
  let inner = match shared_input {
    // the branch is a stage applied to the input riding capture slot 0 —
    // the same completion the in-frame form runs, so a spawned branch costs
    // what the sequential one does inside its thunk
    Some(input_h) => lower_pipe_complete(LUpval(input_h, 0), branch_node, result_h),
    None => lower_expr(branch_node),
  }
  let lo_body = capture_frame(LMakeTuple(carrier_h, [inner]), Some(lookup_ty(carrier_h)))
  lower_handler_pop()
  let lines = ls_exit_frame() |> map(share_enclosing_line)
  LFn(thunk_name, 0, [], [lo_body], len(cap_pairs), lines)
}

// A branch's `<~` site is the enclosing frame's line, which the in-frame
// form registered before this thunk was lowered (`fanout_at`): the thunk's
// slot takes that line at the mint, so a spawning schedule ticks the line a
// sequential one does. A site the enclosing frame never registered keeps
// the thunk's own.
fn share_enclosing_line(line) = match line {
  (h, depth, home) => match home {
    LhSlot(slot) => match ls_line_home_of(h) {
      Some(from) => (h, depth, LhShare(slot, from)),
      None => line,
    },
    LhStatic | LhStaticJvp | LhShare(_, _) => line,
  },
}

fn line_home_in(lines, h: Int) = match find({ (lh, _, _) => lh == h }, lines) {
  Some((_, _, home)) => Some(home),
  None => None,
}

fn lower_call_partial(handle, fbody, fh, r_args, open, n_ps) = match partial_callee_form(handle, fbody, fh) {
  None => LInvariantFailure(handle, PartialCalleeShape(fh)),
  Some(form) => {
    let flat_args = list_to_flat(r_args)
    match partial_split(flat_args, open, len(flat_args), n_ps, handle, 0, 0) {
      (captures, param_names, body_args, slot_cells) => {
        // The record: the supplied fields in slot order, then a local
        // callee's value (`partial_callee_capture`), so the body reaches
        // its callee at the supplied count's ordinal.
        let all_caps = captures ++ partial_callee_capture(form)
        // The hole-product's remaining fields are typed by their own cells
        // (the split's fourth projection), and the synthesized fn returns
        // the CALLEE's return, read where the callee's arrow is — at fh —
        // never off the partial node, whose own type is the arrow (a bare
        // name reifies to it, and `Some(lookup_ty(handle))` would have
        // published the whole arrow as the ABI's return where the arrow's
        // RESULT is meant).
        graph_emitfn_note(EmitFnEntry{
          caps: [],
          fence: len(all_caps),
          kind: EfkPartial,
          name: "partial_{int_to_str(handle)}",
          origin: handle,
          params: zip(param_names, map(some_slot_ty, slot_cells)),
          ret: ret_ty_of(fh),
        })
        let fn_ir = LFn(
          "partial_{int_to_str(handle)}",
          len(param_names),
          param_names,
          [apply_callee_form(form, handle, fh, body_args, len(captures))],
          len(all_caps),
          []
        )
        LMakeClosure(handle, fn_ir, all_caps)
      },
    }
  },
}

// An open slot's type is its cell, read through the twin bracket the entry
// is emitted under (`slot_ty`).
fn some_slot_ty(cell) = Some(TVar(cell))

// The dispatched names of the WHOLE row, in canonical order: the present
// field inline, the tail chased and folded (a variable carries the rest of
// the row), the absent field masking what the tail contributes.
fn effects_of_row(row) = match row {
  EfRow(names, ab, t) => {
    let inline = row_dispatched_names(eff_names_of(names))
    match t {
      EtOpen(vs) => effects_of_edges(vs, inline, ab),
      EtClosed | EtAll => inline,
    }
  },
}

// The edge walk, structural (the row walks' discipline): each bound
// edge's dispatched names fold in through ITS OWN mask and the row's.
fn effects_of_edges(ref vs: [RowEdge], acc, ref ab) = match vs {
  [] => acc,
  [e, ...rest] => {
    let next = match graph_chase(edge_cell(e)) {
      GNode(kind, _) => match edge_row_of(kind) {
        Some(inner) => set_canonicalize(acc ++ names_diff_strs(effects_of_row(inner), eff_names_of(ab) ++ eff_names_of(edge_mask(e)))),
        None => acc,
      },
    }
    effects_of_edges(rest, next, ab)
  },
}

fn names_diff_strs(ref xs, ref mask) = filter((n) => !string_in_list(mask, n), xs)

// Whether a yield may unwind THROUGH a call to this callee: the boundary
// check follows the call unless the callee's row proves the absence of every
// effect with a yielding op — the negative proven, never assumed. A program
// that declares no yielding op proves it once for every call
// (`ls_program_may_yield`); otherwise the callee's row decides. A yielding
// effect among its names checks — one the callee handles inside is already
// absent, since the install subtracted it — a closed tail with none proves
// absence, and a free tail, a negation or intersection form, or a callee
// that is not a function is unproven and checks.
fn can_yield(callee_handle) = may_yield_by(callee_handle, effect_has_multishot_op)

fn may_yield_by(callee_handle, effect_pred) = if !ls_program_may_yield() {
  false
} else {
  match lookup_ty(callee_handle) {
    TFun(_, _, row) => row_may_yield_by(row, effect_pred),
    TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
    | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => true,
  }
}

// Whether an arena's body may suspend: a module that never yields cannot,
// and otherwise the arena's own row says whether its body may carry an
// effect whose handler suspends — the read a call's boundary takes of its
// callee, made of the subtree the arena brackets.
fn arena_may_yield(h) = subtree_may_yield_by(h, effect_has_multishot_op)

// Whether an arena's body may carry out a LIVE continuation, whose remainder
// rides the arena's re-entry.
fn arena_may_yield_live(h) = subtree_may_yield_by(h, effect_has_live_op)

// Whether a subtree's own row may carry an effect the predicate names — the
// read a call's boundary takes of its callee, made of an install or an arena
// where the row is the bracket's.
fn subtree_may_yield_by(h, effect_pred) = if !ls_program_may_yield() {
  false
} else {
  match row_of_subtree(h) {
    Some(row) => row_may_yield_by(row, effect_pred),
    None => true,
  }
}

// A row MAY carry a MultiShot-graded effect: its known names say so, or
// any tail edge is unproven. Total over the three tails — the unproven
// forms answer true (check), never a fabricated "safe".
fn row_may_multishot(row) = row_may_yield_by(row, effect_has_multishot_op)

fn row_may_yield_by(row, effect_pred) = match row {
  EfRow(names, _, t) => if any(effect_pred, eff_names_of(names)) {
    true
  } else {
    match t {
      EtClosed => false,
      EtAll => true,
      EtOpen(vs) => edges_may_yield_by(vs, effect_pred),
    }
  },
}

fn edges_may_yield_by(ref vs: [RowEdge], effect_pred) = match vs {
  [] => false,
  [e, ...rest] => {
    let here = match graph_chase(edge_cell(e)) {
      GNode(kind, _) => match edge_row_of(kind) {
        Some(inner) => row_may_yield_by(inner, effect_pred),
        None => !capped_without(edge_cell(e), effect_pred),
      },
    }
    if here { true } else { edges_may_yield_by(rest, effect_pred) }
  },
}

// A free row holds only what its gates admit, so a closed cap among them
// bounds every row it can come to hold: one naming no effect the predicate
// holds of keeps the row out of it, as a fold's pending work is capped at
// `Memory + Alloc` (infer.mn's `spill_row`).
fn capped_without(cell, effect_pred) = gates_at(cell) |> any({
  g => match gate_row(g) {
    EfRow(names, _, t) => match t {
      EtClosed => !any(effect_pred, eff_names_of(names)),
      EtOpen(_) | EtAll => false,
    },
  },
})

// An effect yields when any of its ops suspends the perform — a multi-shot
// op (a live continuation) or an abandoning one (a dead continuation: the
// caller treats the call as a boundary and unwinds on the flag). Each op's
// resume grade lives on its EffectOpScheme, so whether an effect yields is a
// fact of the effect, fixed once the judgment ends: `lower_program` reads it
// once per declared effect (`effect_yield_facts`) and the gate asks it at
// every call. A name no statement declares is read off its ops directly.
fn effect_has_multishot_op(ename) = match ls_effect_yield_fact(ename) {
  Some((yields, _)) => yields,
  None => effect_has_op_by(ename, disc_yields),
}

fn effect_has_live_op(ename) = match ls_effect_yield_fact(ename) {
  Some((_, live)) => live,
  None => effect_has_op_by(ename, disc_live),
}

// Each declared effect's two yield facts: whether an op yields, and whether
// a handler resumes one.
fn effect_yield_facts(stmts) = flat_map(
  {
    s => match graph_node_body(s) {
      NStmt(EffectDeclStmt(ename, _, _)) => [(ename, (effect_has_op_by(ename, disc_yields), effect_has_op_by(ename, disc_live)))],
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => [],
    },
  },
  stmts
)

fn disc_yields(d) = match d {
  MultiShot => true,
  Abandon => true,
  OneShot => false,
}

fn disc_live(d) = match d {
  MultiShot => true,
  Abandon => false,
  OneShot => false,
}

// An op's discipline satisfies the predicate — the one test every reader of
// an effect's ops applies, a reference with its predicate supplied.
fn op_disc_holds(disc_pred, op) = disc_pred(op_resume_discipline(env_resolve(op)))

fn effect_has_op_by(ename, disc_pred) = any(op_disc_holds(disc_pred), effect_op_names(ename))

// A handler whose arms JOIN a thread may return with the flag raised: a
// branch's abandon is re-raised at the join (the runtime's $join_task_impl), so the
// performer of such a handler's op checks after it as it checks after one
// whose arms may yield.
fn effect_joins_a_thread(ename: String) = ename == "WasiThreads"

// AN-2 — the ops a direct perform must CHECK after: every op of every
// handler whose residual row (what its arms perform) may yield, by name or
// by an open tail, or joins a thread, whose abandon the join re-raises. A
// OneShot arm is called directly; when it — or what it called — abandons,
// it returns with the flag raised and a dummy, and the performer would run
// on without the check. Computed once at lower_program, as the global
// short-circuit is; [] where nothing yields.
fn unwinding_ops(stmts) = handler_ops_where(handler_may_unwind, stmts)

// The ops a direct perform may hand back a LIVE continuation through: every
// op of every handler whose residual row may carry an effect a handler
// resumes. The performer's check takes the rest of its frame there.
fn live_ops(stmts) = handler_ops_where(handler_may_resume_live, stmts)

fn handler_ops_where(pred, stmts) = flat_map(
  {
    s => match graph_node_body(s) {
      NStmt(HandlerDeclStmt(_, _, _, _, arms, _)) => if pred(s) { map(handler_arm_op_name, arms) } else { [] },
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => [],
    },
  },
  stmts
)

fn handler_may_resume_live(hd) = match handler_shape_at(hd) {
  Some((r, _, _, _)) => row_may_yield_by(mk_ef_open([], r), effect_has_live_op),
  None => false,
}

// A handler may unwind when its residual row — the cell `register_handler`
// judged the arms under, read as `handler_arm_effects` reads it — may yield.
fn handler_may_unwind(hd) = match handler_shape_at(hd) {
  Some((r, _, _, _)) => {
    let row = mk_ef_open([], r)
    row_may_multishot(row) || row_may_yield_by(row, effect_joins_a_thread)
  },
  None => false,
}

// Effect-row names as bare strings, in the row's (already-canonical) order.
// EPure is the union identity and never enters a row name-set (consumed to
// the pure row at build_declared_row), so its arm is the unreachable-but-total case:
// the empty name (it contributes no evidence slot — it is never present here).
// The old `name == 0` null guard is gone WITH its class: the name-set ops
// whose slack slots once leaked nulls (the dissolved sorted insert) are
// buffer-counter builds now, slicing to their exact count — no null element
// survives to this projection (the battery + self-compile arbitrated the
// guard's removal).
// THE STRING BOUNDARY: EffName carries the intern HANDLE; this projection
// is where the lower layer's bare-string world (evidence keys, escaping
// name-sets, "{hname}_{op}" targets) begins, so the handle renders to its
// canonical spelling HERE — pushing the raw handle word into the erased
// string list was invisible to inference (no type meets an erased list)
// and surfaced only as str_lt walking a tiny address in the escaping
// fixpoint (the A.6 m3 leg's alloc trap; the fixpoint oracle caught what
// the census structurally could not).
fn eff_names_of(names) = flatten(map(
  { ENamed(h) => [intern_name_of(h)], EParameterized(h, _) => [intern_name_of(h)], EPure => [] },
  names
))

// Builtin effects have no handler record — the raw substrate IS their
// handler (wasm instruction / WASI import). Drop them from the evidence
// layout so user effects keep their correct indices. The builtin set is
// carried as DATA (one membership projection), not an inline `== "X"`
// chain. The ultimate form carries builtin-ness STRUCTURALLY as an
// EffectDeclKind variant (BuiltinEffect vs UserEffect) read from the
// graph; that touches the effect-declaration substrate in both layers
// (peer Hβ.row.builtin-effect-kind) and changes no evidence bytes —
// the membership result is identical, so it composes after L1.
fn row_dispatched_names(names) = filter((n) => !is_builtin_effect(n), names)

// drift-audit: ignore — byte-parity requires the SAME name set the seed filters (row_dispatched_names data segs 6496/6512/6528); a structural BuiltinEffect EffectDeclKind variant must change both layers together (peer Hβ.row.builtin-effect-kind, post-L1) or the evidence layout diverges from m2's.
fn is_builtin_effect(ename) = index_of_name(["Memory", "Alloc", "WASI"], ename, 0) >= 0

// op_name → its declaring effect's name via EffectOpScheme ("" if not an
// effect op in scope — productive-under-error). The graph carries the
// op→effect edge; read it, never a side registry.
fn lower_effect_name_of_op(op_name) = match lookup_parent_effect(op_name) {
  Some(en) => en,
  None => "",
}

// op's index WITHIN its own effect (op-decl order). The per-effect arm
// region is laid out in this order, so op_slot indexes it directly.
fn lower_compute_ev_slot_for_op(op_name) = match lookup_parent_effect(op_name) {
  Some(ename) => clamp_index(index_of_name(effect_op_names(ename), op_name, 0)),
  None => 0,
}

// The positional ev-INDEX apparatus is DELETED — evidence is now read by
// effect IDENTITY (a key-scan over the self-describing captured_evs region),
// so there is no row index to compute, dispatch on, or keep place==read stable
// (the cure for position-as-the-bug: a sibling effect shuffles no key). What
// remains is the op-DECL index (op_slot), a STABLE position into an effect's
// immutable op-list — never a row position. `clamp_index` is its defensive
// floor: an op absent from its own effect's op-list is structurally impossible
// (the op→effect edge proves membership), so -1 never arises here.
// A -1 here means an op missing from its own effect's registered list —
// with index_of_name's String proof landed the live cause (pointer-eq on
// the op name: every multi-op effect's ops all clamped to slot 0, result
// overwriting yield in the install record) is gone; the clamp's floor is
// named residue until the diagnostic path reaches this site.
fn clamp_index(i) = if i < 0 { 0 } else { i }

// ─── Lexical handler resolution (lower-phase, install-handle-bearing) ──
// Walk the lower-handler-stack innermost-first; return the install handle
// and the handler declaration of the first stacked install whose handler
// declares op_name. None when no lexical install answers it — the Tier-2
// evidence path. The install handle gives emit the `__hstate_<h>` record the
// arm runs against.
fn lower_resolve_handler_for_op(op_name, word) = {
  let ename = lower_effect_name_of_op(op_name)
  resolve_in_stack(op_name, ename, word, lower_handler_stack_now())
}

// An install that answers the op and serves an instance route-distinct from
// the perform's is passed, as the run's walk passes it.
fn resolve_in_stack(op_name: String, ename, word, stack) = if ename == "" || len(stack) == 0 {
  None
} else {
  match last(stack) {
    // the frame fence — enclosing installs live in another WASM frame
    Fence => None,
    Installed(ih, hd, _, iword) => if handler_declares_op(hd, ename, op_name) && !pinned_passes(hd, ename, iword, word) {
      Some((ih, hd))
    } else {
      resolve_in_stack(op_name, ename, word, drop_last(stack))
    },
  }
}

// THE INSTANCE A DISPATCH KEYS ON, as one word: the effect's values spelled
// and interned — an operand by its node — or 0 where an instance variable is
// still free, which any install may serve and which may reach any. Two words
// both known and different are route-distinct, the law the judgment's
// absorption reads (effects.mn), so the static walk above and the run's walk
// pass exactly the installs the row says do not answer.
fn instance_word(ename: String, args) = if len(args) > 0 && all(route_known, args) {
  intern_str("{ename}({show_list(args, value_sig, ",")})") + 1
} else {
  0
}

fn words_route_distinct(a, b) = a != 0 && b != 0 && a != b

// The instance a perform names, read under the twin it is emitted in.
fn perform_instance_word(handle, ename: String) = {
  let n = len(effect_dim_names(ename))
  if n == 0 {
    0
  } else {
    match find(eff_name_is(ename, ??), flat_map(row_presents, graph_rows_at(handle))) {
      Some(e) => instance_word(ename, map(instance_arg_value, take(n, entry_args(e)))),
      None => 0,
    }
  }
}

fn row_presents(r) = match r {
  EfRow(p, _, _) => p,
}

fn instance_arg_value(a) = match instance_value_at(a) {
  Some(x) => x,
  None => a,
}

// The instance an install serves of the effect, read off its handler's
// config where it pins it — a computed config by the operand that computes
// it; a handler that serves every instance is 0.
fn served_word(right, hd, ename: String) = match handler_e_r(Some(hd), right) {
  Some(er) => match served_instance(er, right) {
    Some(s) => if eff_name_is(ename, s) { instance_word(ename, entry_args(s)) } else { 0 },
    None => 0,
  },
  None => 0,
}

// The word of the effect the handler pins, which the static walk carries on
// the install's stack entry.
fn pinned_word(right, hd) = match handler_pinned_effect(hd) {
  Some(en) => served_word(right, hd, en),
  None => 0,
}

// The same word read off an install the lowering has finished, through the
// handler expression its note holds.
fn install_word_at(ih, hd, ename: String) = match graph_install_at(ih) {
  InstallOf(right, _) => served_word(right, hd, ename),
  NoInstall => 0,
}

// The stack entry of an install the lowering has finished, which the emit's
// walks push as the lowering pushed it.
fn installed_entry(ih, hd) = Installed(
  ih,
  hd,
  projection_of(hd),
  match graph_install_at(ih) {
    InstallOf(right, _) => pinned_word(right, hd),
    NoInstall => 0,
  }
)

// Whether a pinned install passes the perform: its pinned effect is the
// perform's, and the two instances are route-distinct.
fn pinned_passes(hd, ename: String, word, pword) = match handler_pinned_effect(hd) {
  Some(en) => str_eq(en, ename) && words_route_distinct(word, pword),
  None => false,
}

// THE KEY IS THE OP, NOT THE EFFECT. This asked whether a handler covers the
// effect — does one of this handler's arm groups key on that effect — until
// 2026-09-09, and a handler that implements ANY op of an effect answered
// yes for EVERY op of it. So a split-effect pair, two handlers covering one
// effect's disjoint op sets, resolved every op to whichever was innermost:
// tests/frontier/mn-split-effect-op-key.mn checked with ZERO diagnostics and
// emitted a call to an arm the resolved handler does not have. The
// assembler caught it, which is the same
// compiles-clean-then-refuses shape the reification landing just closed one
// layer up. The hazard had been NAMED in the tree ("an ename key
// mis-resolved the split-effect pair") and the fix taken then was to key a
// second walk by handler NAME instead — moving the problem to a key that
// cannot answer an ambiguous op, which is where the eta-wrapper ceiling
// came from. Both walks are one walk now, and both key on the op.
//
// Nothing is added to answer it. `build_handler_arm_names` already lays each
// group's arms DENSE over [0, max_slot] with `""` at the ops this handler
// does not implement, so "does this handler declare this op" is the slot
// being filled — the same question the RUNTIME record answers with its arm
// region, where wasm.mn's emit_arm_writes skips gaps and leaves the slot zero.
// The arms this handler lays for ONE effect — dense over that effect's op
// slots, a gap where it does not implement one, empty when it does not cover
// the effect at all. Both questions below are reads of this one list, and
// the find is the find place_arm_in_groups already uses, so the group lookup
// has one home and neither question carries a scanning lambda of its own.
fn handler_arms_for(hd, ename: String) = match split_group_by_ename(handler_arm_groups(hd), ename) {
  (_, grp, _) => group_arms(grp),
}

fn handler_declares_op(hd, ename: String, op_name: String) = {
  let arms = handler_arms_for(hd, ename)
  let slot = lower_compute_ev_slot_for_op(op_name)
  if slot >= len(arms) { false } else { !field_name_eq(arms[slot], "") }
}

// The execution strategy a fanout (`<|`/`><`) runs under — read LIVE
// from the installed `~>` chain, NEVER baked into the verb. A verb
// draws an edge; it does not schedule (the deleted Thread-inject was
// the category error). `Schedule` is an ADT of scheduler classes —
// never a `mode==0/1/2` int (drift 8). NO scheduler installed → `Seq`,
// the invisible default: branches evaluate inline, in source order,
// results tupled — deterministic, zero spawn cost. `~> Thread` →
// `Thread`: each branch thunk dispatched to wasi-threads (the relocated
// spawn/join body), spawn-ALL-then-join-ALL in source order so results
// tuple deterministically regardless of completion order. `Simd` packs the
// f32 branch results into v128 lanes (the value layer's RV128 repr meeting the
// verb); `Gpu` projects the same thunks to a device-kernel host import (the one
// legitimate external-transport boundary, "the handler IS the backend");
// `Persist` checkpoints each branch thunk to disk for crash-survivable parallel
// execution (parallelism = durability, §4④). All five read LIVE from the `~>`
// chain — never baked into the verb. `Schedule` and the roster that classes
// an install live in src/effects.mn, where the judgment reads them too.
//
// One projection of infer's ExecutableBoundary edge. Every field keeps its
// graph identity through LowIR: the thunk closure, semantic result, boundary-
// local carrier, and the two scheduler-specific transient tickets.
// thunk, result, carrier, Thread ticket, Persist ticket, the branch node
// (the source the race rule reports at — a thunk is a synthesized node
// with no span of its own)
type ScheduledBoundary
  = ScheduledBoundary(LowExpr, Int, Int, Int, Int, Int)
  | InvalidScheduledBoundary(Int, BoundaryInvariant)

// What a fanout site fans: the branches of `><` / `<|`, each its own
// executable boundary, or — the sequence fanout `fanout(f, xs)` — the
// function it applies, by the handle its row is read at.
type FanBranches = FanBranches([ScheduledBoundary]) | FanSeq(Int)

// THE FORM A FANOUT RUNS UNDER, read at the site. Its own frame's install
// wins; a site whose frame installs none runs the form the active bracket
// demands — a caller's spawning schedule reaching it through a direct call
// (`spec_call_name`) — and its own frame's form otherwise. A schedule the
// site carries no form for (the vocabulary is not linked, or the bracket
// names Simd/Gpu, which never cross a call) reads as the site's own.
fn fanout_form(lexical, forms) = fanout_form_named(forms, fanout_schedule(lexical, forms))

// The schedule that form runs under — the one home of the choice, read by
// the form and by every reader that asks what the form costs.
fn fanout_schedule(lexical, forms) = match lexical {
  Some(s) => s,
  None => match enc_sched(spec_enc_active()) {
    Seq => Seq,
    demanded @ (Threaded | Simd | Gpu | Persisted) => match forms_lookup(forms, demanded) {
      Some(_) => demanded,
      None => Seq,
    },
  },
}

// A site's form for its own schedule — always present by construction.
fn fanout_form_named(forms, s) = match forms_lookup(forms, s) {
  Some(f) => f,
  None => match forms {
    [(_, f), ..._] => f,
    [] => LInvariantFailure(0, MissingFanoutBoundary),
  },
}

fn forms_lookup(forms, s) = match forms {
  [] => None,
  [(fs, f), ...rest] => if schedule_eq(fs, s) { Some(f) } else { forms_lookup(rest, s) },
}

fn schedule_eq(a: Schedule, b: Schedule) = match a {
  Seq => match b {
    Seq => true,
    Threaded | Simd | Gpu | Persisted => false,
  },
  Threaded => match b {
    Threaded => true,
    Seq | Simd | Gpu | Persisted => false,
  },
  Simd => match b {
    Simd => true,
    Seq | Threaded | Gpu | Persisted => false,
  },
  Gpu => match b {
    Gpu => true,
    Seq | Threaded | Simd | Persisted => false,
  },
  Persisted => match b {
    Persisted => true,
    Seq | Threaded | Simd | Gpu => false,
  },
}

// THE SCHEDULE RIDES THE BRACKET'S ENC. A twin's encoding is its
// instantiation's repr digits; a schedule twin's ends in the letter of the
// spawning schedule its caller's install demands — `T` for Thread, `P` for
// Persist — so the one bracket every twin emits under carries the schedule
// too, and every reader that keys on the enc (nested records, extents,
// faces) keys the schedule twin apart from its type twin. A floor enc is
// all digits; a letter makes it a twin.
fn sched_suffix(s: Schedule) = match s {
  Threaded => "T",
  Persisted => "P",
  Seq => "",
  Simd => "",
  Gpu => "",
}

fn enc_sched(enc: String) = {
  let n = byte_len(enc)
  if n == 0 {
    Seq
  } else {
    let b = byte_at(enc, n - 1)
    // 'T'
    if b == 84 {
      Threaded
    }
    // 'P'
    else if b == 80 {
      Persisted
    } else {
      Seq
    }
  }
}

// The enc without its schedule letter — the instantiation alone.
fn enc_type_part(enc: String) = match enc_sched(enc) {
  Seq => enc,
  Threaded | Simd | Gpu | Persisted => str_slice(enc, 0, byte_len(enc) - 1),
}

// THE ENC A NESTED RECORD TAKES under a schedule twin. A branch thunk, an
// install's arm and a state init run inside the extent and never leave it,
// so they keep the schedule: a `><` inside a spawned branch runs threaded
// too. A lambda, a partial, a nested fn and a reified remainder are VALUES
// that can outlive the install — called outside it, a spawn they carried
// would find no handler on the chain, a trap the row never promised — so
// they keep the instantiation alone and run their fanouts at their own
// frame's schedule (`Hβ.lower.schedule-through-a-value`).
fn nested_enc(name: String, enc: String) = match graph_emitfn_at(name) {
  [] => enc_type_part(enc),
  entries => match last(entries) {
    EmitFnEntry(e) => match e.kind {
      EfkThunk => enc,
      EfkArm(_, _) => enc,
      EfkInit(_) => enc,
      EfkLambda => enc_type_part(enc),
      EfkPartial => enc_type_part(enc),
      EfkNested => enc_type_part(enc),
      EfkK => enc_type_part(enc),
    },
  },
}

// THE SYMBOL A NESTED RECORD TAKES under a twin, with the enc it is emitted
// under: its own enc (`nested_enc`), mangled where that names an
// instantiation, and the bare name at the floor — a lambda under the schedule
// twin of a monomorphic fn is the base lambda, emitted once and walked under
// the floor bracket. The plan, the allocation audit and the closure mint all
// read this one spelling.
fn nested_twin(name: String, enc: String) = {
  let ne = nested_enc(name, enc)
  if spec_enc_is_floor(ne) { {enc: "", sym: name} } else { {enc: ne, sym: spec_mangle(name, ne)} }
}

// Read the fanout's execution strategy from the installed `~>` chain —
// the SAME `lower_handler_stack_now()` stack every perform resolves
// through (`resolve_in_stack`), each entry classed by `projection_of`. The
// innermost handler covering a scheduler-class effect (`Thread`/`Simd`/
// `Gpu`) wins; with none installed the strategy is `Seq` — the net-new
// default the old hardwired `Thread` inject made unsayable (a bare `><`
// was the E_HandlerUninstallable refusal; now it just runs single-threaded).
// `!Thread` proves the negative: a region with `Thread` subtracted from
// its row provably runs `Seq` (a real-time-DSP guarantee).
fn lower_fanout_schedule() = schedule_in_stack(lower_handler_stack_now())

// What the site's own frame INSTALLS: the innermost schedule-class install
// before the frame fence, or none — two answers a site's form and a call's
// demand read differently, since an installed `Seq` governs the site while
// no install at all inherits the demand the bracket carries.
fn lower_site_schedule() = schedule_installed(lower_handler_stack_now())

fn schedule_in_stack(stack) = match schedule_installed(stack) {
  Some(s) => s,
  None => Seq,
}

fn schedule_installed(stack) = schedule_installed_at(stack, len(stack) - 1)

// Innermost first, by index: this is asked at every global call inside an
// install's extent, so it allocates nothing and reads each entry's class
// where the push classified it once.
fn schedule_installed_at(stack, i) = if i < 0 {
  None
} else {
  match list_index(stack, i) {
    // the frame fence — the LEXICAL read stops at the frame; a caller's
    // schedule reaches a fanout in another frame by DEMAND, through a direct
    // call (`spec_call_name`, `fanout_form`), never through this stack
    Fence => None,
    Installed(_, _, proj, _) => match proj {
      PSchedule(s) => Some(s),
      PDispatch | PDerivative | PArena => schedule_installed_at(stack, i - 1),
    },
  }
}

// The derivative reading's DEMAND, drawn where an LDerive is built: the emit
// reads it before it looks for a reading, so a program that installs none
// pays nothing for the reading's existence — not a scan, not a byte.
effect DerivativeDemand {
  derivative_demand_note()
  derivative_demanded() -> Bool
}

// An arena's DEMAND, drawn the same way where an LArena is built: a module
// that opens none carries no journal, no exit and no barrier — a store
// emits as the plain store it always was — so its bytes are what they were.
effect ArenaDemand {
  arena_demand_note()
  arena_demanded() -> Bool
}

// A handler's install class (src/effects.mn's roster) at the lowering.
fn projection_of(hd) = projection_of_effects(handler_arm_enames(hd))

// The effects a handler's arms answer, read off its declaration in one pass —
// the class is a fact of the declaration, so an install reads it rather than
// rebuilding the handler's arm groups once per class it asks about.
fn handler_arm_enames(hd) = match handler_shape_at(hd) {
  Some((_, _, _, arms)) => arms |> map({ arm => lower_effect_name_of_op(handler_arm_op_name(arm)) }),
  None => [],
}

// Per-effect arm-fn-name groups [(ename, [arm_fn_name])], op-decl order
// within each effect. A handler can cover multiple effects (graph_handler:
// GraphWrite + GraphRead); op-slot is op-decl-relative WITHIN an effect, so
// a flat region would collide (each effect's op 0 wants slot 0). Grouping
// by effect (read from the graph via lower_effect_name_of_op) lets emit lay
// each group contiguously and build a thin per-effect [record, base] entry.
fn build_handler_arm_names(hd, arms) = {
  let placements = map(
    (arm) => {
      let op = handler_arm_op_name(arm)
      let ename = lower_effect_name_of_op(op)
      {
        ename: if ename == "" { op } else { ename },
        name: arm_fn_name(hd, op),
        slot: lower_compute_ev_slot_for_op(op),
      }
    },
    arms
  )
  fold([], place_arm_in_groups, placements) |> map(pad_group_to_effect_ops)
}

// DENSE OVER THE EFFECT'S OP LIST, not over the handler's own arms — and the
// difference was a silent wrong. The op slot is documented as a STABLE
// position into an effect's immutable op-list, and every reader indexes the
// arm region by it, but `set_at_extend` only grew a group to the highest slot
// THIS handler implements. A handler covering one op of a two-op effect
// therefore laid a ONE-slot region, and a dispatch for the other op indexed
// past it into whatever the record held next: measured at
// tests/frontier/mn-split-effect-evidence.mn as 15 where 33 is correct, with
// zero diagnostics, a clean assemble, and no trap. Padding closes it at the
// layout rather than at each reader, and it is what makes the runtime walk's
// "does this node declare the op" test READABLE — an unimplemented slot is
// now present and zero, where before it was absent and whatever came after.
fn pad_group_to_effect_ops(g: {arms: [String], ename: String}) = {
  arms: grow_to_with_gaps(group_arms(g), len(effect_op_names(group_ename(g)))),
  ename: group_ename(g),
}

// Place one arm at its op-slot in its effect-group's arm_list, find-or-
// create the group. The arm_list is dense [0, max_slot] with the empty-
// string gap sentinel for ops this handler doesn't implement; emit skips
// gaps but counts the length, so the per-effect base advances correctly.
// The group/arm record types are Intent Boundaries: they arrive as the
// fold's generic state, and unresolved record types hit the emit's loud
// field-load floor (the place_arm_in_groups unreachable). The pin is the
// proof — same class as names_concat / ls_find_str_local.
fn place_arm_in_groups(groups: [{arms: [String], ename: String}], arm: {ename: String, name: String, slot: Int}) = match split_group_by_ename(groups, arm.ename) {
  (before, grp, after) => {
    let filled = set_at_extend(group_arms(grp), arm.slot, arm.name)
    list_concat(before, [{arms: filled, ename: arm.ename}] ++ after)
  },
}

// The group's arms, read through an annotated projection: `grp` arrives
// off a tuple destructure whose element type the seed's inference does
// not carry across the return boundary, so a direct `grp.arms` hits the
// emit's loud unresolved-field floor. The call-site unification with the
// declared param IS the pin (the env_find precedent at the record layer).
fn group_arms(grp: {arms: [String], ename: String}) -> [String] = grp.arms

fn group_ename(grp: {arms: [String], ename: String}) -> String = grp.ename

// ename: String pins — the same pointer-eq-lie class as ls_find_str_local.
fn split_group_by_ename(groups: [{arms: [String], ename: String}], ename: String) =
  split_group_loop([], groups, ename)

fn split_group_loop(before: [{arms: [String], ename: String}], rest: [{arms: [String], ename: String}], ename: String) = if len(rest) == 0 {
  (before, {arms: [], ename}, [])
} else if last(rest).ename == ename {
  (before, last(rest), drop_last(rest))
} else {
  split_group_loop(list_concat(before, [last(rest)]), drop_last(rest), ename)
}

// Functional set arms[slot] = name. Replace in place when slot is in
// range; else grow with "" gaps and append. Tree-safe (slice + concat,
// not flat list_set) — the arm_list may be a concat-tree.
fn set_at_extend(arms: [String], slot: Int, name: String) = if slot < len(arms) {
  list_concat(slice(arms, 0, slot), [name] ++ slice(arms, slot + 1, len(arms)))
} else {
  list_concat(grow_to_with_gaps(arms, slot), [name])
}

fn grow_to_with_gaps(arms: [String], n: Int) =
  if len(arms) >= n { arms } else { grow_to_with_gaps(list_concat(arms, [""]), n) }

// Perform lowering — the single decision point. The DISCIPLINE branches
// here (a MultiShot perform yields rather than calling an arm); the
// dispatch does not, because there is one perform and one walk. What the
// site can bind of that walk NOW rides on the PerformDispatch it carries,
// and op_slot is a position in every case — the op's index in its
// effect's IMMUTABLE decl-order op-list (a stable identity, not a row
// position), which is what makes "does this node DECLARE the op" a single
// load rather than a table.
// M4 — divergence: an expression that ALWAYS yields (unwinds and never
// returns to its own position). An Abandon-op perform is the leaf; an
// if/match whose every branch diverges diverges; a block diverges if a
// statement diverges or its value does. Code after a diverging expression
// in a block is DEAD (the deaden in lower_expr's BlockExpr arm). A call to
// a fn that always aborts is NOT caught here (inter-procedural — the named
// follow-up Hβ.lower.diverging-callee-analysis; rare, and the flag still
// propagates via the caller's k2 boundary, only the local dead code isn't
// pruned).
fn expr_diverges(node) = match graph_node_body(node) {
  // Statements wrap their expression — a block's stmts are NStmt(...), so
  // first_diverging must unwrap to reach the perform.
  NStmt(ExprStmt(e)) => expr_diverges(e),
  NStmt(LetStmt(_, init, _)) => expr_diverges(init),
  NExpr(CallExpr(f, _)) => match graph_node_body(f) {
    NExpr(VarRef(_)) => match op_resume_discipline(graph_ref_decl(f)) {
      Abandon => true,
      OneShot | MultiShot => false,
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => false,
  },
  NExpr(IfExpr(_, t, e)) => expr_diverges(t) && expr_diverges(e),
  NExpr(MatchExpr(_, arms)) => all_arms_diverge(arms, 0),
  NExpr(BlockExpr(stmts, final)) => match first_diverging(stmts, 0) {
    Some(_) => true,
    None => expr_diverges(final),
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => false,
}

fn all_arms_diverge(arms, i) = if i >= len(arms) {
  true
} else {
  match list_index(arms, i) {
    (_, body) => if expr_diverges(body) { all_arms_diverge(arms, i + 1) } else { false },
  }
}

// The index of the first diverging statement, if any — everything past it
// in the block is dead.
fn first_diverging(stmts, i) = if i >= len(stmts) {
  None
} else if expr_diverges(list_index(stmts, i)) {
  Some(i)
} else {
  first_diverging(stmts, i + 1)
}

// The diverging statement lowers as the expression that diverges: a binder
// it would have bound is dead, and a block ending in a `let` has no value
// (`let v = ab(); v + 1` did not assemble — nothing on the stack).
fn diverging_expr(stmt) = match graph_node_body(stmt) {
  NStmt(ExprStmt(e)) => e,
  NStmt(LetStmt(_, init, _)) => init,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => stmt,
}

// Lexical install wins over the keyed forward (a nested handler shadows the
// caller's evidence) — the seed's $lower_perform order, byte-faithful.
fn lower_perform_dispatch(handle, op_name, lo_args) = match op_resume_discipline(env_resolve(op_name)) {
  // A MultiShot perform NEVER calls the arm — it YIELDS, from any position:
  // the frame's continuation pass (`capture_frame`) mints the frame's
  // remainder at the perform as the record the handler resumes.
  MultiShot => LYield(handle, op_name, lo_args, KSite(KRef(""), [], [])),
  // An Abandon perform yields from ANY position with a DEAD k: the arm
  // never resumes, so the continuation is abandoned and the frame unwinds
  // to its landing (`LAbandon`). The driver runs the arm with k = 0, the
  // arm returns without calling it, and the loop exits flag-clear
  // delivering the arm's value as the install's. Everything up the stack
  // unwinds through the boundary checks (never a bare return, which would
  // skip an install's driver bracket — the M1.3 finding).
  Abandon => LAbandon(handle, op_name, lo_args),
  OneShot => lower_perform_walk(handle, op_name, lo_args),
}

// THE ONE WALK, ASKED AT LOWER. It is the same traversal the runtime does —
// innermost-out to the handler that declares this op — and this is simply the
// PREFIX of it that the bound edges permit. A lexically enclosing install
// answers the whole thing; a uniquely-declaring handler answers the arm but
// not the record; nothing bound answers neither. Three residuals, one
// operation, and no arm of the emit may differ on what it MEANS — which is
// why the world bracket is not a property of any of them.
fn lower_perform_walk(handle, op_name, lo_args) = LPerform(
  handle,
  perform_dispatch_of(
    op_name,
    lower_resolve_handler_for_op(
      op_name,
      perform_instance_word(handle, lower_effect_name_of_op(op_name))
    )
  ),
  lo_args
)

// `lexical` is not a flag, it is the binding-time INPUT: how much of the walk
// this site can finish now. An ordinary perform passes what the install stack
// says; a REIFIED op (a bare op name lowered as a value) passes None, because
// its body becomes a lifted fn and the frame a lexical answer would name will
// not exist when it runs. Same walk, fewer bound edges, later epoch.
fn perform_dispatch_of(op_name, lexical) = {
  let ename = lower_effect_name_of_op(op_name)
  let slot = lower_compute_ev_slot_for_op(op_name)
  match lexical {
    Some((ih, hd)) => PdFrame(ih, hd, op_name),
    None => match lower_op_default_handler(op_name) {
      // The arm is static (one handler declares it) and the record is not. The
      // record comes from the SAME walk the unbound case uses — it used to come
      // from a second one keyed on the handler name, which could not answer an
      // ambiguous op and was the whole of the eta ceiling. A handler whose
      // installs may key their arms has no ONE arm to name: the record the walk
      // finds holds the arm its own install runs.
      Some(hd) => if handler_may_key(hd) {
        PdWalk(ename, slot, op_name, ArmSlot)
      } else {
        PdWalk(ename, slot, op_name, ArmNamed(hd))
      },
      None => PdWalk(ename, slot, op_name, ArmSlot),
    },
  }
}

// The fn this dispatch calls — None when it reaches the arm through the
// record's own slot, which names nothing. An OPTION rather than "", because
// the empty string is a constructor nobody named: both readers here have to
// branch on presence, and a sentinel makes that branch a string compare that
// any other empty name would satisfy. Emit writes the call and reachability
// keeps the callee alive, so the two read ONE projection — the divergence
// where emit called a symbol reachability had already pruned is what this fn
// exists to make unconstructible. A frame answer's target is the install's
// arm REFERENCE, not a spelled name: which arm the install runs is its key's
// to decide, under whatever bracket the two readers stand in.
fn perform_target(disp) = match disp {
  PdFrame(ih, hd, op_name) => Some(RefArm(ih, arm_fn_name(hd, op_name))),
  PdWalk(_, _, op_name, ArmNamed(hd)) => Some(RefDeclArm(hd, arm_fn_name(hd, op_name))),
  PdWalk(_, _, _, ArmSlot) => None,
  PdDriver(hd, _) => Some(RefName(redrive_fn_name(hd))),
}

// The declaration of the op's ONE handler, read from the providers the
// EffectOpScheme edge carries (drawn at the handler's registration) — None
// when no handler declares it, or when two do and the arm comes out of the
// record.
fn lower_op_default_handler(op_name) = match env_lookup(op_name) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      EffectOpScheme(_, providers, _) => match providers {
        [hd] => Some(hd),
        _ => None,
      },
      FnScheme | ConstructorScheme(_, _) | RecordSchemeKind(_) | EffectDeclKind(_, _)
      | HandlerKind(_, _, _, _, _) | ParamScheme(_) | RowAliasKind(_) | TypeVariants(_)
      | HandlerChainKind(_) | ValueScheme | PrimitiveKind(_) => None,
    },
  },
  None => None,
}

// Look up which effect an op belongs to via EffectOpScheme.
fn lookup_parent_effect(op_name) = match env_lookup(op_name) {
  Some(entry) => match entry {
    (_, _, kind) => match kind {
      EffectOpScheme(ename, _, _) => Some(ename),
      FnScheme | ConstructorScheme(_, _) | RecordSchemeKind(_) | EffectDeclKind(_, _)
      | HandlerKind(_, _, _, _, _) | ParamScheme(_) | RowAliasKind(_) | TypeVariants(_)
      | HandlerChainKind(_) | ValueScheme | PrimitiveKind(_) => None,
    },
  },
  None => None,
}

// op_resume_discipline — the op's resume cardinality — lives at the env
// altitude now (src/env.mn), where the EffectOpScheme it projects lives.
// Lower reads it through the import; the dispatch tiers below are its
// callers.
//
// Lower walk — exhaustive, live
//
// lower reads the fabric: before lowering, resolve the node's CANONICAL
// form from the e-graph (egraph_extract = the e-class root, the simplest
// proven-equivalent term). For an un-rewritten node the root is the node
// itself, so this is identity on the common path; for x + 0 the root IS x
// and lower emits x — optimization as a cursor read, not a separate pass.
// The canonical handle carries the type lookups, since a rewrite preserves
// the type (and, for a dropping rewrite, the effect row — the gate proved it).
//
// An AUTHORED hole's identity lives on its own node — the id and the
// authored span the executable gate and the cursor read (authored_hole).
// Its union-find class root is often an absent-default mint (NHole(0):
// the fn-return var a body hole unified with, a let's value var), so
// canonicalizing first discards the authored truth and the surviving
// hole slips the gate. The hole keeps its handle; every other body
// reads canonically (same class ⇒ same lookup_ty chase ⇒ same repr),
// at the authored node's own span.
fn lower_expr(handle) = match graph_node_body(handle) {
  NHole(_) => {
    // The value-holes column's note (the one writer): a hole that
    // reaches this arm SURVIVED to value position — consumed
    // call-arg/pipe holes never do. executable_hole is the note
    // condition (authored id + real span), exactly the old walk's
    // collect test.
    if executable_hole(handle) { graph_hole_note(handle) } else { () }
    LConst(handle, LInt(0))
  },
  NExpr(_) | NStmt(_) | NPat(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => {
    let canon = egraph_extract(handle)
    let span = graph_span_of(handle)
    match graph_node_body(canon) {
      NExpr(e) => lower_expr_body(e, canon, span),
      NStmt(s) => lower_stmt_body(s, canon, span),
      // patterns don't lower as expr
      NPat(_) => LConst(canon, LInt(0)),
      // the class root is a hole-default mint; nothing authored to carry
      NHole(_) => LConst(canon, LInt(0)),
      // never an expr position — module entity, not a value
      NModule(_) => LConst(canon, LInt(0)),
      NLink(_) => LConst(canon, LInt(0)),
      // never an expr position — an authored annotation, not a value
      NTypeAnn(_) => LConst(canon, LInt(0)),
      NName(_) => LConst(canon, LInt(0)),
      NRow(_) => LConst(canon, LInt(0)),
      NParam(_) => LConst(canon, LInt(0)),
    }
  },
}

// The read of a name the lowering's scope resolved — a value reference and a
// call's callee take the same read, so the name is resolved once per site.
// For LLocal/LUpval the LowExpr's handle is the one that types the read —
// `local_ty_handle` decides it, for this site and every other read of a
// resolved local. Fall back to VarRef's handle for RGlobal where there's no
// separate local-binding handle.
//
// SchemeKind dispatch (H3): a VarRef whose env entry is a nullary
// ConstructorScheme is a value-position constructor reference (`None`,
// `True`, `False`). Lower it as LMakeVariant(handle, tag, []) — emit emits
// the sentinel i32.const form for nullary tags.
fn lower_resolved_ref(handle, name: String, res, local_h) = match res {
  RLocal(reg) => LLocal(local_ty_handle(local_h, handle), reg),
  RUpval(slot) => LUpval(local_ty_handle(local_h, handle), slot),
  // (LF.B) a `<~` lambda param resolves to the feedback site's prior local,
  // read LIVE — the recurrence's y[n-1] term IS this node.
  RFbPrior(fb_h) => LFeedbackPrior(fb_h),
  // A NON-FN BINDING IN VALUE POSITION IS A REIFICATION, and until
  // 2026-09-09 it was two silent wrongs. A constructor lowered to
  // LMakeVariant(handle, tag, []) whatever its arity, so mapping a
  // one-field constructor over a list checked with zero diagnostics
  // and built payload-less variants that trapped `unreachable` in the
  // match reading them; an op fell to the catch-all's LGlobal and emitted
  // `(global.get $note)` for a global that never exists, so the
  // ASSEMBLER was the first thing in the chain to object, hundreds of
  // thousands of WAT lines from the name the developer wrote.
  //
  // The declaration the reference reaches proves the answer — ConstructorScheme
  // and EffectOpScheme are distinct tags written at the declaration — and
  // the reification the developer was writing by hand is the medium's
  // own hole-product: a bare name IS the parameter product with every
  // field unsupplied (SYNTAX §«Partial application»), so it lowers
  // through the SAME partial mint an authored hole already used, with
  // no supplied args and no new mechanism. The callee shape is read live from the
  // node's own program cell, never rebuilt from the matched Expr, and
  // the product — no arguments, a cell per slot — is the judgment's own,
  // written at the reference (`bare_reference_product`, infer.mn): the
  // judgment knows whether the reference is an arrow, so the use site
  // no longer asks the env scheme by name for an arity it could not
  // tell from an unresolved type. What the reference denotes is the
  // declaration its edge reaches.
  RGlobal => match graph_ref_decl(handle) {
    Some(d) => lower_declared_ref(handle, d),
    // NO EDGE: the judgment refused the name. `_ => LGlobal(handle, name)`
    // stood here once and guessed an unbound name into `(global.get
    // $name)`, fabricating the one fact infer had just proved false: WAT no
    // assembler accepts, the medium's own spanned E_MissingVariable moved to
    // a wat2wasm error hundreds of thousands of lines away.
    None => LInvariantFailure(handle, MissingName(name)),
  },
}

fn lower_declared_ref(handle, d) = match published_kind(Some(d)) {
  Some(ConstructorScheme(tag_id, _)) => match graph_product_at(handle) {
    // Not a function type: the reference IS the value — a nullary
    // variant, the sentinel form emit already knows.
    NoProduct => LMakeVariant(handle, tag_id, []),
    ProductOf(_, open, _) => lower_call_partial(handle, graph_node_body(handle), handle, [], open, len(open)),
  },
  Some(EffectOpScheme(_, _, _)) => match graph_product_at(handle) {
    // An op's declared scheme is always a signature, zero-arg
    // included, so a missing product is an unresolved judgment and the
    // typed floor is the honest answer — lower_call_partial's own
    // None path, reached with the arity the graph actually proved.
    NoProduct => LInvariantFailure(handle, PartialCalleeShape(handle)),
    ProductOf(_, open, _) => lower_call_partial(handle, graph_node_body(handle), handle, [], open, len(open)),
  },
  // A primitive as a value has no symbol to reach: it is the partial with
  // every slot open, whose body applies the instruction.
  Some(PrimitiveKind(_)) => match graph_product_at(handle) {
    NoProduct => LInvariantFailure(handle, PartialCalleeShape(handle)),
    ProductOf(_, open, _) => lower_call_partial(handle, graph_node_body(handle), handle, [], open, len(open)),
  },
  // A named-fn VALUE reference (FnScheme tag-0 — excludes HandlerKind,
  // the PTee guard): the bare LGlobal — emit resolves it to the fn's static
  // closure record; the fn's performs dispatch through the live world chain
  // when the consumer (`each(f, xs)`) calls it. A fold face's raw body never
  // runs, so its judgment wrote the product a primitive's value has, and the
  // reference is the partial whose body folds.
  Some(FnScheme) => match graph_product_at(handle) {
    NoProduct => LGlobal(handle, DeclaredAt(d)),
    ProductOf(_, open, _) => lower_call_partial(handle, graph_node_body(handle), handle, [], open, len(open)),
  },
  // Found, some other kind (a value binding, a record) — the global read
  // is the right projection.
  Some(_) => LGlobal(handle, DeclaredAt(d)),
  // a declaration that published nothing: the judgment stopped at it
  None => LInvariantFailure(handle, MissingName(enclosing_decl_name(d))),
}

fn lower_expr_body(e, handle, span) = match e {
  LitInt(v) => LConst(handle, LInt(v)),
  LitFloat(v) => LConst(handle, LFloat(v)),
  LitString(s) => LConst(handle, LString(s)),
  LitBool(b) => {
    // HB: True/False are nullary ConstructorScheme entries. Lower
    // routes through LMakeVariant so emit picks the sentinel path
    // (i32.const tag) — no allocation, full ADT semantics.
    let tag = if b { 1 } else { 0 }
    LMakeVariant(handle, tag, [])
  },
  LitUnit => LConst(handle, LInt(0)),
  VarRef(name) => match ls_resolve(name) {
    (res, local_h) => lower_resolved_ref(handle, name, res, local_h),
  },
  // The boolean verbs are CONTROL, not arithmetic: `a && b` IS
  // `if a { b } else { false }`, `a || b` IS `if a { true } else { b }`.
  // The eager i32.and lowering evaluated both operands, so every guard
  // protecting a read (`pos < n && str_eq(set[pos], …)`) ran the read it
  // guards — three latent OOB sites in the wheel's own runtime and infer
  // (set_insert, cache_filter_loop, register_one_variant), all surfaced the
  // hour list_index gained its SYNTAX-promised bounds trap. Those three
  // sites keep explicit control-flow guards for the transition generation
  // (an m2 body compiled by the still-eager boot meets the checked
  // list_index in the same binary).
  BinOpExpr(op, left, right) => match binop_kind(op) {
    BKBool => match op {
      BAnd => LIf(handle, lower_expr(left), [lower_expr(right)], [LConst(handle, LInt(0))]),
      BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BLt | BGt | BLe | BGe | BOr | BConcat => LIf(handle, lower_expr(left), [LConst(handle, LInt(1))], [lower_expr(right)]),
    },
    BKArith => LBinOp(handle, op, lower_expr(left), lower_expr(right)),
    BKCmp => LBinOp(handle, op, lower_expr(left), lower_expr(right)),
    BKConcat => LBinOp(handle, op, lower_expr(left), lower_expr(right)),
  },
  UnaryOpExpr(op, inner) => LUnaryOp(handle, op, lower_expr(inner)),
  CallExpr(f, args) => {
    // SchemeKind dispatch (H3): when the callee is a VarRef whose
    // env entry is a ConstructorScheme, the call is value-side
    // ADT instantiation — emit LMakeVariant with the registered
    // tag_id, not LCall through a non-existent fn-table entry.
    // EffectOpScheme dispatch lowers an effect-op call. SYNTAX.md
    // §«Invoking effect operations»: an op is a BARE call — there is
    // no PerformExpr path (dissolved); `op(args)` IS the canonical and
    // only form, dispatched here by the env's EffectOpScheme. Plain
    // function calls fall through.
    let fbody = graph_node_body(f)
    // The arg PRODUCT is the judgment's — labeled args in declaration
    // order, absent fields filled by their defaults — read off the call
    // node (the call-product column), never resolved again by name.
    match call_product_at(handle, args) {
      // PARTIAL APPLICATION AS A VALUE (SYNTAX §«Partial application — the
      // product with a hole»): resolved args leaving declaration-order params
      // unfilled — an authored `??` slot — IS the lambda the surface law names
      // (`add3(10, ??, 30)` ≡ `(x) => add3(10, x, 30)`), supplied fields
      // evaluated ONCE at construction. The fork reads infer_call's decision
      // off the product (the shape); the mint precedes lo_args so hole slots
      // never lower. Pipe-right calls never reach this fork —
      // lower_pipe_complete dispatches them fork-free (the pipe owns its
      // hole; the inline splice is the zero-record projection of the same
      // hole-filling).
      (r_args, open, shape) => match partial_unfilled(f, shape) {
        Some(n_ps) => lower_call_partial(handle, fbody, f, r_args, open, n_ps),
        None => lower_call_dispatch(handle, f, fbody, r_args),
      },
    }
  },
  IfExpr(cond, then_e, else_e) => LIf(handle, lower_expr(cond), [lower_expr(then_e)], [lower_expr(else_e)]),
  BlockExpr(stmts, final_e) => {
    // M4 — an Abandon perform DIVERGES (it always yields, unwinding to its
    // install's driver), so any statement/expression after it is DEAD. The
    // block's value IS the diverging statement's yield; the remainder deadens
    // (never lowered), so post-abort EFFECTFUL code cannot run. Without this
    // the abort's LYield stands but `s; abort(); print(x)` would raise the
    // flag and STILL run print before the frame propagates (the crucibles'
    // pure `0` hid it). The prefix statements up to the divergence lower
    // and drop as usual; the diverging one lowers as the block VALUE (not
    // dropped, so its yield is the block's result the enclosing frame
    // propagates).
    let cp = ls_push_scope()
    let result = match first_diverging(stmts, 0) {
      Some(i) => {
        let lo_prefix = lower_stmt_list(take(i, stmts))
        let lo_diverge = lower_expr(diverging_expr(list_index(stmts, i)))
        LBlock(handle, list_concat(lo_prefix, [lo_diverge]))
      },
      None => {
        let lo_stmts = lower_stmt_list(stmts)
        let lo_final = lower_expr(final_e)
        LBlock(handle, list_concat(lo_stmts, [lo_final]))
      },
    }
    ls_pop_scope(cp)
    result
  },
  MatchExpr(scrutinee, arms) => match destructure_subs(arms, product_arity_at(scrutinee)) {
    // A PRODUCT TAKEN APART WHERE IT IS BUILT IS ITS PARTS. The one arm
    // binds every position, so the match is the destructuring and no
    // record need exist: each part lands in the binder's own register,
    // which is what the `let` spelling this desugars from costs.
    Some(subs) => match destructure_body(arms) {
      Some(body) => lower_product_destructure(handle, scrutinee, subs, body),
      None => LMatch(handle, lower_expr(scrutinee), lower_match_arms(scrutinee, arms)),
    },
    None => LMatch(handle, lower_expr(scrutinee), lower_match_arms(scrutinee, arms)),
  },
  MakeListExpr(elems) => LMakeList(handle, lower_expr_list(elems)),
  MakeTupleExpr(elems) => LMakeTuple(handle, lower_expr_list(elems)),
  // Per #138: MakeStringExpr is the semantic-preserving form of
  // string interpolation (alternating literal + splice fragments).
  // Lower projects it to a left-fold of str_concat calls at this
  // cursor — the runtime substrate is the str_concat composition.
  // Post-Mentl-ultimate-strings (peer Hβ.runtime.zero-copy-string-
  // view's view-substrate), the fold materializes to one alloc per
  // concat node; the view-substrate ensures zero byte-copy through
  // each splice's lex-produced view operand.
  MakeStringExpr(fragments) => lower_string_interpolation(handle, lower_expr_list(fragments)),
  // γ's splice half: the structural show reads THIS judged node's
  // handle — the 4818 placeholder mint is dead; emit's show dispatch
  // reads the OPERAND's type exactly as before.
  ShowExpr(inner) => LShow(handle, lower_expr(inner)),
  // Subscript dispatch at lower-time — the proof becomes the dispatch.
  // A tuple IS a positional product (L1); indexing it at a CONSTANT is a
  // field load read live from the proven Ty: lower emits LFieldLoad at the
  // width-summed prefix-sum to element i (tuple_elem_offset — the SAME fold
  // records run), the load width is the index handle's own repr
  // (LFieldLoad reads repr_of(lookup_ty(h)), so an f64 element loads f64).
  // Bounds are discharged at compile time (the const is in range or the
  // offset is -1 → the LFieldLoad unprovable floor, never a fabricated 0).
  // Tuple construction (emit_field_stores_acc) and LPTuple match-bind read
  // the SAME offset fold — the three move in lock-step (Law 7: a half-
  // migration mis-offsets an f64 tuple). A genuinely-runtime-variable index,
  // or a list receiver, stays the runtime list_index call.
  IndexExpr(receiver, index) => lower_index(handle, receiver, index),
  MakeRecordExpr(fields) => LMakeRecord(handle, lower_record_field_values(fields)),
  // A nominal record lowers as a bare record literal does: its type's
  // identity is the judgment's, and the head is a reference to the type,
  // never a value the record holds.
  NamedRecordExpr(head, fields) => LMakeRecord(handle, lower_record_field_values(fields)),
  RecordUpdateExpr(base, overrides) => lower_record_update(handle, base, overrides),
  LambdaExpr(params, body_node) => {
    // DESIGN Ch 1: lambdas close over their free variables. Each
    // lambda gets a unique name derived from its AST handle, so
    // emit's deep walk lifts every LMakeClosure — top-level or
    // inline — into a WASM function entry in the $fns table.
    // Param + capture HANDLES are threaded into the frame so VarRef
    // resolution returns the local's actual type handle (Phase-A1).
    let lambda_name = "lambda_{int_to_str(handle)}"
    let param_names_list = lower_param_names(params)
    let param_handles_list = params
    // Seed "__k" whenever a k is lexically in scope at the mint: a resume
    // in this body, or in a lambda or a nested fn minted inside it, reads
    // the k the closure carries — and the chain holds for arbitrary nesting
    // by induction (each inner mint re-seeds from its own enclosing frame).
    // Where no k is in scope the
    // seed adds nothing. One dormant word per arm-context closure that
    // never uses it — the price of a walk-free, stateless rule. Every name
    // the parameters' patterns bind is the body's own, never a capture.
    let free_uses0 = collect_free_uses(body_node, param_bound_names(params))
    let free_uses = lower_seed_hrec(lower_seed_k(free_uses0))
    match resolve_captures_outer(free_uses, handle) {
      (captures_names, captures_exprs, captures_handles) => {
        // Lambda is anonymous — empty fn_name, which a nested fn's symbol
        // path skips (`ls_fn_symbol`).
        // lambda_h = THIS lambda's own handle (the handle LMakeClosure uses
        // below).
        graph_emitfn_note(EmitFnEntry{
          caps: zip(captures_names, captures_handles),
          fence: len(captures_exprs),
          kind: EfkLambda,
          name: lambda_name,
          origin: handle,
          params: zip(param_names_list, entry_param_tys(handle, params)),
          ret: ret_ty_of(handle),
        })
        // THE DIRECT SWAP (landing shape α): the LowFn is built by the
        // COLUMN-SEEDED projector — the one construction, program+
        // columns in, LowFn out. The site keeps what FEEDS the columns
        // (free-var collection, capture resolution, the note); the
        // body-lowering lives in project_lambda_fn.
        match project_lambda_fn(handle, zip(captures_names, captures_handles)) {
          // The record is [fn_ptr@0][nc@4][captures@8..] — captures only. The
          // body's performs dispatch through the LIVE world chain at call time
          // (a computation performs in the world where it is CALLED — R2's law),
          // and a resume inside a MultiShot arm's lambda rides the captures as
          // the ordinary __k free var (collect_free_vars' ResumeExpr arm).
          Some(fn_ir) => LMakeClosure(handle, fn_ir, captures_exprs),
          None => LInvariantFailure(handle, ProjectionOriginShape(handle)),
        }
      },
    }
  },
  // The cursor reads the op's proven cardinality LIVE (the body IS the
  // contract; current_resume_discipline() projects it from the enclosing
  // arm context) and picks the representation — the gradient at the resume
  // site, the TIME-axis twin of the function-dispatch gradient. The
  // continuation is the unified heap record's fifth role: minted ONLY when
  // the body actually resumes more than once.
  //
  // OneShot (~85%): the zero-cost stack return — BYTE-IDENTICAL to the
  // pre-producer floor. Hβ.first-light.resume-with-state-mutation
  // (SYNTAX §State updates via with on resume): the resume value AND every `with field = NEW`
  // RHS read the PRE-update state; lower_resume_snapshot commits the stores
  // after evaluating all RHS into scratch locals in source order.
  ResumeExpr(val, state_updates) => match current_resume_discipline() {
    OneShot => lower_resume_oneshot(handle, val, state_updates),
    // MultiShot: resume(v) CALLS the k record the driver bound to the
    // arm's __k param — the W7 closure convention on fn_ptr@0, N times
    // (k is immutable data, minted where the performing frame yielded,
    // `capture_frame`). The catching handler
    // (in-memory / oracle-rollback / persist) is the swap.
    MultiShot => lower_resume_callk(handle, val, state_updates),
    // M4 — a resume inside a pure-Abandon op's arm is the MIXED case (the
    // op has an abandon arm AND a resume arm). It does not occur in the
    // wheel or crucibles: abort/fail are single-handler UZero, so a
    // resume under an Abandon-graded op is unreachable-by-construction (a
    // UZero arm has no resume). If it ever arises, the op must reify k at
    // the perform (become MultiShot — the abandon perform's dead k=0
    // would trap here, loud, never silent): Hβ.lower.abandon-with-resume-arm.
    Abandon => lower_resume_callk(handle, val, state_updates),
  },
  // W6: the field NAME rides the node; the offset projects at emit from
  // the receiver's live type under the bracket.
  FieldExpr(rec, field) => LFieldLoad(handle, lower_expr(rec), FByName(field)),
  PipeExpr(kind, left, right) => lower_pipe(kind, left, right, handle),
  FanoutExpr(branches) => lower_fanout_nary_to(handle, branches, FdValue),
  // infer already reported ERestOutsideDestructure at this node;
  // productive-under-error, same as the hole.
  RestExpr(_) => LConst(handle, LInt(0)),
  // ? — emit lowers to unreachable via NHole check
  ExprPlaceholder => LConst(handle, LInt(0)),
  // A labeled arg is resolved to positional by resolve_call_args before
  // lower_expr sees it; reaching here means one leaked outside a call's arg
  // list. Lower the value through (productive-under-error) — infer has already
  // surfaced the E_UnknownArgLabel diagnostic at this node.
  LabeledArg(_, v) => lower_expr(v),
}

// `|>` is HOLE-COMPLETION (SYNTAX.md §«Partial application — the product
// with a hole»), never a positional rewrite: the piped value fills the
// right call's one remaining hole — the authored `??` slot when present,
// else the first unfilled declaration-order param (the trailing hole of a
// positional-prefix partial). A SATURATED call is a closure-producing
// stage; the piped value applies to its result. The callee's arity is
// read LIVE from its graph type (lookup_ty → TFun) — Carried-Truth,
// never a second arity table. Factored from PForward so the k remainder
// builder can complete a stage with the RESUME HOLE as the piped value
// (band B M1.3) — one completion, two callers.
fn lower_pipe_complete(lo_l, right, handle) = lower_pipe_complete_many([lo_l], right, handle)

// The values a pipe gives its stage: one, or the parts of a product the site
// builds, which the merge hands to the stage's N open slots.
fn lower_pipe_complete_many(lo_ls, right, handle) = match inlinable_lambda_arity(right, len(lo_ls)) {
  Some((params, body)) => lower_applied_in_place(lo_ls, params, body, handle),
  None => lower_pipe_stage(lo_ls, right, handle),
}

// A literal standing as a pipe's stage IS the piped values bound to its
// parameters: each parameter binds in the frame the pipe stands in and the
// body lowers there, so no closure is minted — the judgment charges none, by
// the same test (`inlinable_lambda_arity`). Each parameter's register is its
// own, so a parameter spelled like a local of the frame never overwrites it.
fn lower_applied_in_place(lo_ls, params, body, handle) = {
  let cp = ls_push_scope()
  let binds = map(bind_stage_param, zip(zip(params, lower_param_names(params)), lo_ls))
  let layers = lower_param_destructures(params)
  let lo_body = wrap_param_destructures(layers, lower_expr(body))
  ls_pop_scope(cp)
  LBlock(handle, binds ++ [lo_body])
}

// One parameter of an applied-in-place stage. The register's width reads the
// parameter's own type where it has a handle, and the piped value's where the
// type was ground (the same type: the application unified them).
fn bind_stage_param(pair) = match pair {
  ((ph, name), value) => {
    let reg = ls_bind_local(name, ph)
    LLet(if ph == 0 { lexpr_handle(value) } else { ph }, reg, value)
  },
}

fn lower_pipe_stage(lo_ls, right, handle) = {
  let rbody = graph_node_body(right)
  match stage_global_name(right, rbody) {
    // A bare reference to a module-level function or op standing as the
    // stage is the call `f(x)` in the frame the pipe stands in — applied,
    // never minted, one graph with the call it spells: an op has no static
    // record a value could reach (`x |> put` under `!Alloc`,
    // tests/micros/mn-pipe-into-op.mn), and a function's record is reached
    // through a direct call, never dispatched through as a value.
    Some(name) => lower_global_call(handle, right, name, [], lo_ls),
    None => lower_pipe_stage_value(lo_ls, right, handle, rbody),
  }
}

// The declaration a bare reference stage names, when its edge reaches a
// function or an effect op at module scope; a local or a constructor is the
// value it is.
fn stage_global_name(right, rbody) = match rbody {
  NExpr(VarRef(name)) => match ls_resolve(name) {
    (RGlobal, _) => match published_kind(graph_ref_decl(right)) {
      Some(EffectOpScheme(_, _, _)) | Some(FnScheme) => Some(name),
      None | Some(_) => None,
    },
    _ => None,
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => None,
}

fn lower_pipe_stage_value(lo_ls, right, handle, rbody) = {
  // THE MERGE: a product the site built fills the stage's N open slots —
  // the trailing holes the Stage Law puts the datum in — so the tuple is
  // never built and the call is the one its let-spelling writes. One value
  // is the ordinary pipe, below.
  let lo_l = list_index(lo_ls, 0)
  // A pipe-right CALL dispatches fork-free (lower_call_dispatch): the pipe
  // owns its hole and completes it below by inline splice, so a raw
  // hole-bearing call in stage position never mints a partial closure.
  let lo_r = match rbody {
    NExpr(CallExpr(f2, args2)) => lower_call_dispatch(right, f2, graph_node_body(f2), call_product_nodes(right, args2)),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => lower_expr(right),
  }
  let hole_at = match rbody {
    NExpr(CallExpr(_, cargs)) => pipe_hole_index(cargs, 0),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => -1,
  }
  // The pipe owns its hole: the slot lowered above (the column note
  // fired at the visit) and the splice below consumes it — retract the
  // pending note so a consumed hole never reads as a survival.
  match rbody {
    NExpr(CallExpr(_, cargs2)) => if hole_at >= 0 { graph_hole_unnote(list_index(cargs2, hole_at)) } else { () },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => (),
  }
  let is_partial = match rbody {
    NExpr(CallExpr(f, cargs)) => len(cargs) < callee_arity_of(f),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => false,
  }
  // The completed application is the PIPE's value, so it carries the pipe
  // node's handle, whose type is the stage's result. It carried the
  // stage's, whose type is the partial's arrow, and every reader of the
  // value's type read a function: `(xs |> map(f)) ++ [7]` refused as a
  // shape it could not prove, `(2.0 |> scale(3.0)) > 5.0` checked clean
  // and did not assemble, and `(2 |> wrap(3)) == [3, 2]` compared two
  // addresses and answered false (boot e23392f6).
  match lo_r {
    LDirectCall(_, dfh, dn, dt, dargs) => if hole_at >= 0 && len(lo_ls) == 1 {
      completed_call(handle, dfh, dn, dt, splice_at(dargs, hole_at, lo_l))
    }
    // drift-audit: ignore — one completion per pipe node, not a loop accumulator
    else if is_partial {
      completed_call(handle, dfh, dn, dt, dargs ++ lo_ls)
    } else {
      LCall(handle, lo_r, lo_ls)
    },
    LCall(_, fn_, args) => if hole_at >= 0 && len(lo_ls) == 1 {
      LCall(handle, fn_, splice_at(args, hole_at, lo_l))
    }
    // drift-audit: ignore — one completion per pipe node, not a loop accumulator
    else if is_partial {
      LCall(handle, fn_, args ++ lo_ls)
    } else {
      LCall(handle, lo_r, lo_ls)
    },
    LMakeVariant(_, tag, vargs) => if hole_at >= 0 && len(lo_ls) == 1 {
      LMakeVariant(handle, tag, splice_at(vargs, hole_at, lo_l))
    }
    // drift-audit: ignore — one completion per pipe node
    else if is_partial {
      LMakeVariant(handle, tag, vargs ++ lo_ls)
    } else {
      LCall(handle, lo_r, lo_ls)
    },
    // A bare fn-VALUE stage (`7 |> outer`): the completion call is a call
    // like any other — the callee's performs dispatch through the world
    // chain, and a stage that resumes reads the k its record carries.
    LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
    | LUnaryOp(_, _, _) | LTailCall(_, _, _) | LReturn(_, _) | LMakeClosure(_, _, _)
    | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _) | LDeclareFn(_) | LIf(_, _, _, _)
    | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _) | LFanout(_, _, _, _)
    | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMatch(_, _, _) | LResumeK(_, _, _, _)
    | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _) | LArena(_, _) | LFeedback(_, _, _, _, _)
    | LFeedbackPrior(_) | LPerform(_, _, _) | LFieldLoad(_, _, _) | LPrim(_, _, _)
    | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _)
    | LInvariantFailure(_, _) | LWasiCall(_, _, _) => LCall(handle, lo_r, lo_ls),
  }
}

// ── A PRODUCT CONSUMED WHERE IT IS BUILT ──────────────────────────────
//
// The parts are evaluated where the product stands, each into a register of
// its own, and the consumer reads the registers: a positional destructure's
// binders, or the N arguments the merge hands its stage. No record is built
// at any schedule — a spawning one joins its branches into the same
// registers — which is the verb costing exactly what its `let` spelling
// costs (the judgment charges by the same rule, `charge_product`).
fn lower_product_destructure(handle, ph, subs, body) = {
  let values = lower_product_parts(ph)
  let cp = ls_push_scope()
  let regs = map(bind_destructured_part, zip(subs, part_handles_of(ph)))
  let fill = fill_product_parts(ph, regs, values)
  let lo_body = lower_expr(body)
  ls_pop_scope(cp)
  LBlock(handle, [fill, lo_body])
}

// The merge: the parts into registers, then the stage applied to them.
fn lower_product_merge(handle, ph, right) = {
  let values = lower_product_parts(ph)
  let cp = ls_push_scope()
  let hs = part_handles_of(ph)
  let regs = map(bind_merge_slot(ph), enumerate(hs))
  let fill = fill_product_parts(ph, regs, values)
  let args = map(read_part_reg, zip(regs, hs))
  let call = lower_pipe_complete_many(args, right, handle)
  ls_pop_scope(cp)
  LBlock(handle, [fill, call])
}

// A destructured part's register: the binder's own name, at the part's width;
// a wildcard still EVALUATES its part (a branch is a computation, and `><`
// branches are independent of each other, never of the program), so it takes
// a register nothing reads.
fn bind_destructured_part(pair) = match pair {
  (sub, part_h) => match pat_of(sub) {
    PVar(name) => ls_bind_local(name, part_h),
    PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) | PAs(_, _) => ls_bind_local("__part_{int_to_str(part_h)}", part_h),
  },
}

fn bind_merge_slot(ph, indexed) = match indexed {
  (i, part_h) => ls_bind_local("__merge_{int_to_str(i)}_{int_to_str(ph)}", part_h),
}

fn read_part_reg(pair) = match pair {
  (reg, part_h) => LLocal(part_h, reg),
}

// THE PARTS, each at its own handle: a tuple literal's elements, a fanout's
// branch results (the boundary edges inference drew).
fn part_handles_of(ph) = match graph_node_body(ph) {
  NExpr(MakeTupleExpr(elems)) => elems,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => match fanout_boundaries(ph) {
    Ok(boundaries) => map(boundary_result_handle, boundaries),
    Err(_) => [],
  },
}

fn boundary_result_handle(edge) = match edge {
  BoundaryEdge(result_h, _, _, _, _, _) => result_h,
}

// A tuple literal's parts are lowered where they stand; a fanout's are the
// schedule's business, so its values are built with the form (`fill_product_parts`).
fn lower_product_parts(ph) = match graph_node_body(ph) {
  NExpr(MakeTupleExpr(elems)) => lower_expr_list(elems),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// The expression that puts the parts in the registers: plain lets for a tuple
// literal, and the fanout's own per-schedule form for a fanout — which binds
// the same registers whether its branches ran here or crossed a thread.
fn fill_product_parts(ph, regs, values) = match graph_node_body(ph) {
  NExpr(MakeTupleExpr(_)) => LBlock(ph, map(bind_part_to_reg, zip(regs, values))),
  NExpr(FanoutExpr(branches)) => lower_fanout_nary_to(ph, branches, FdRegs(regs)),
  NExpr(PipeExpr(PFanout(fan_own), l, r)) => lower_fanout_to(ph, fan_own, l, r, FdRegs(regs)),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => LInvariantFailure(ph, MissingFanoutBoundary),
}

fn lower_pipe(kind, left, right, handle) = match kind {
  // `<|`/`><` — ONE parallel-fanout topology, discriminated by input
  // ownership (the FanOwnership aspect). The verb draws the independence
  // edge + tuples the branch results; it does NOT schedule. HOW the
  // branches run is read LIVE from the installed `~>` chain
  // (`lower_fanout_schedule()` → Seq/Thread/Simd/Gpu) — the same handler
  // stack every `perform` resolves through. NO scheduler → Seq (the
  // invisible default): branches evaluate inline, tupled in source order.
  // Drift 1 closure: the handler chain IS the dispatch; no vtable. Drift
  // 5 closure: any per-thread state lives in the chosen handler's `with`,
  // never an ad-hoc parallel struct.
  PFanout(fan_own) => lower_fanout_to(handle, fan_own, left, right, FdValue),
  // THE MERGE (PLAN §4②): a product the site builds fills the stage's N
  // open slots. The parts are bound to registers where they are computed
  // and handed to the stage, so `(a) >< (b) |> f` is `f(a, b)` — no tuple
  // at any schedule (`product_fills_stage`, graph.mn, the judgment's own
  // rule for the expectation it unified).
  PForward => if product_fills_stage(left, right) {
    lower_product_merge(handle, left, right)
  } else {
    lower_pipe_complete(lower_expr(left), right, handle)
  },
  PTee => match installed_handler(right) {
    Some(hd) => lower_install(left, right, hd, handle),
    // A handler held by a value absorbs nothing at the judgment
    // (`installed_handler`), so the install is its body.
    None => lower_expr(left),
  },
  PFeedback => {
    // <~ feedback. The site's line is a ring owned by the record of the
    // function that contains the cycle: the site takes the innermost
    // frame's next line slot here, BEFORE its body lowers, so an outer
    // cycle's slot precedes any cycle nested in its recurrence. The
    // LFeedback emit loads the ring's oldest slot into $__fb_prev_<h> (the
    // prior-iteration output), so the body can read it LIVE. (LF.B) When
    // the LHS is (prev) => body, prev binds to THIS feedback handle's prior
    // node and the recurrence y[n]=f(x[n],y[n-1]) is expressed — not
    // commented. The lambda is INLINED (its body lowers directly into the
    // cycle), never a closure: the prior is a register read, and a `<~`
    // recurrence allocating a closure per tick would defeat !Alloc.
    let depth = feedback_line_depth(right)
    let home = ls_line_slot(handle, depth)
    let lo_l = lower_feedback_body(left, handle)
    let lo_r = lower_expr(right)
    LFeedback(handle, depth, home, lo_l, lo_r)
  },
}

// ~> tee — handler attachment. One precedence, one kind: the parser's table
// already scoped the handler over the whole chain to its left. The install
// is pushed onto the lower-stack BEFORE its body lowers, so a Tier-1 perform
// inside resolves to it AND learns the install handle (→ `__hstate_<h>`, the
// SAME record the arm runs against), and popped after.
//
// The ONE handler record (protocol_handler_is_state_is_closure_is_evidence)
// carries config args (from `~> handler(args)`, written FIRST) then the
// state its declaration's init fn writes, and the per-effect arm groups; the
// arm bodies' performs dispatch through the live world chain, so the install
// threads no captured-evidence region.
fn lower_install(left, right, hd, handle) = {
  let lo_r = lower_expr(right)
  let proj = projection_of(hd)
  lower_handler_push(Installed(handle, hd, proj, pinned_word(right, hd)))
  // The body is a frame of its own, whose remainders the enclosing frame's
  // continuation pass reads (`capture_frame`).
  let lo_l = lower_expr(left)
  lower_handler_pop()
  let config_args = extract_handler_config_args(right)
  // The install-shape column (lowering-is-a-column step i): the handler
  // expression and the config-arg program handles, noted at the install
  // node. The config arguments are this frame's own expressions; the state
  // belongs to the declaration, whose init fn the install calls
  // (`lower_init_decl`).
  graph_install_note(handle, InstallOf(right, config_args))
  let config_inits = config_args |> map(lower_expr)
  match proj {
    // The reading replaces the install: no record, no world push. The
    // seed is the reading's one config argument, and it keeps the lowered
    // shape every read of it has (a local or a capture), which is how
    // derive knows its uses.
    PDerivative => {
      derivative_demand_note()
      match config_inits {
        [seed, ..._] => LDerive(handle, seed, lo_l),
        [] => LDerive(handle, LConst(handle, LFloat(0.0)), lo_l),
      }
    },
    // The arena replaces the install the same way: no record, no world
    // push. Its exit asks no one — every store its body made into older
    // memory journaled its own type where it happened.
    PArena => {
      arena_demand_note()
      LArena(handle, lo_l)
    },
    PSchedule(_) | PDispatch => LHandleWith(handle, lo_l, lo_r, hd, config_inits, handler_arm_groups(hd)),
  }
}

// How many priors does this site's line carry? The authored literal when
// one was written (`delay(3)` → 3), ONE otherwise — a state element that
// names no depth (accumulate) holds a single prior, and a computed depth
// already REFUSED at infer, so the shape here only keeps lowering
// productive past a diagnostic that will not reach an executable. Same
// reason the non-positive literal answers 1: the refusal is the verdict,
// this is the shape the check/edit projections still walk.
fn feedback_line_depth(spec) = match feedback_depth(spec) {
  DepthLiteral(n) => if n <= 0 { 1 } else { n },
  DepthComputed => 1,
  DepthUnstated => 1,
}

// (LF.B) Lower the LHS of a `<~`. A single-param lambda `(prev) => body`
// The `??` hole's declaration-order index among a call's RAW args — the
// pipe's completion target (SYNTAX §«Partial application»: `x |> clamp(0,
// ??, 255)` names the hole; the first authored hole is the one completed).
fn pipe_hole_index(args, i) = if i >= len(args) {
  -1
} else {
  match graph_node_body(list_index(args, i)) {
    NHole(_) => i,
    NExpr(_) | NStmt(_) | NPat(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => pipe_hole_index(args, i + 1),
  }
}

// The callee's declared arity, read LIVE from its inferred TFun (the graph
// already proves it — never a second arity table). -1 when the graph holds
// no fn type at the callee (the unresolved callee already carries its own
// diagnostic); the pipe then treats the right side as a saturated stage.
fn callee_arity_of(f) = match lookup_ty(f) {
  TFun(ps, _, _) => len(ps),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => -1,
}

// Replace the completed hole's slot in a lowered args list — the product's
// one absent field filled by the piped value.
//
// drift-audit: ignore — one three-way splice per completed hole, not a loop accumulator
fn splice_at(xs, i, v) = slice(xs, 0, i) ++ [v] ++ slice(xs, i + 1, len(xs))

// A stage call the pipe has completed. A call of the prelude's `fanout`
// with both fields supplied is the sequence fanout's node — the pipe's
// twin of the arm `lower_global_call` holds for a direct call, since the
// stage was dispatched with its hole open and only the completion sees
// both fields; every other completed call is the call itself.
fn completed_call(dh, dfh, c, dt, args) = if callee_is_vocabulary(c, "fanout") && len(args) == 2 {
  lower_fanout_seq(dh, dfh, lexpr_handle(list_index(args, 0)), args)
} else {
  LDirectCall(dh, dfh, c, dt, args)
}

// Whether a callee is the declaration a vocabulary name resolves to at the
// link's scope — the callee's identity compared, never its spelling.
fn callee_is_vocabulary(c, n: String) = match c {
  DeclaredAt(d) => match env_resolve_linked(n) {
    Some(v) => v == d,
    None => false,
  },
  Synthesized(_) => false,
}

// binds prev to the feedback site's prior local and inlines the body —
// the recurrence reads y[n-1] live. Any other LHS lowers as-is (a bare
// expression computes on the current input only, the structural form).
fn lower_feedback_body(left, fb_handle) = match inlinable_lambda(left) {
  Some((params, body)) => {
    let cp = ls_push_scope()
    ls_bind_fb_prior(lower_param_name(last(params)), fb_handle)
    let layers = lower_param_destructures(params)
    let lo = wrap_param_destructures(layers, lower_expr(body))
    ls_pop_scope(cp)
    lo
  },
  None => lower_expr(left),
}

// Config args from `~> handler(arg1, arg2)` — the parameterized-handler
// factory's arguments, lowered and written FIRST into the install record
// (before state inits). The install constructs the config PRODUCT, and the
// product is the judgment's, read off the install's own node (the
// call-product column): a `~> handler(args)` install is a call and carries
// it at the call node; a bare `~> handler` of a config'd handler is the
// zero-arg product — every field filled from its decl default (SYNTAX
// §«Default parameter values») — written at the reference node
// (`note_bare_handler_product`, infer.mn); a handler without config, or a
// tee over a plain fn value, has none.
fn extract_handler_config_args(node) = match graph_node_body(node) {
  NExpr(CallExpr(_callee, args)) => call_product_nodes(node, args),
  NExpr(VarRef(_)) => match graph_product_at(node) {
    ProductOf(nodes, _, _) => nodes,
    NoProduct => [],
  },
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

// Fanout lowering — ONE path for `<|` and `>< `, discriminated by the
// FanOwnership aspect. The verb produces strategy-NEUTRAL branch thunks
// (each a 0-arg closure, the unified heap record — handler = state =
// closure = evidence = continuation, §6 — so a branch is portable
// across a thread boundary, packable into a SIMD lane, shippable to a
// device, or persisted mid-flight: four backends, four readings of ONE
// record shape). HOW they run is read LIVE from the installed `~>`
// chain via `lower_fanout_schedule()` — never baked into the verb.
//
//   `FanDistribute` (`><`) — BINARY: two independent owned-input
//       branches, each a `synthesize_branch_thunk`.
//   `FanShare` (`<|`) — one input ref-borrowed: bind the input once as
//       a let-local, then N shared-input thunks each applying their
//       branch fn to it (the __fanout_input capture).
//
// `effects_of(fanout) = ⋃ branch rows` (the Thread inject is deleted at
// infer); ownership affinity (own values cannot flow through `<|`) is
// proven at infer (E_OwnershipViolation), trusted here.
//
// All four backends are LIVE (W13, this batch — the strategy-neutral thunks
// read four ways): `~> Simd` packs the f32 branch results into v128 lanes
// (LSimdLanes, the value layer's RV128 repr meeting the verb); `~> Gpu`
// projects the same thunks to a device-kernel host import (the one legitimate
// external-transport boundary, "the handler IS the backend" — the host-import
// binding is peer Hβ.lower.fanout-gpu-host-import); `~> Persist` checkpoints
// each branch thunk to disk via persist_branch/join_persist for crash-
// survivable parallel execution (§4④ — parallelism and durable execution are
// the same arm). Each is a `~> handler` choice over the one pure-topology verb.
//
// Infer owns the ordered executable edges at the fanout site. Project them
// directly; tuple types prove the result shape but are not an identity index.
// THE FANOUT, LOWERED TO WHAT CONSUMES IT. `FdValue` is the tuple of the
// branches' results; `FdRegs(regs)` is the parts bound to the registers a
// positional destructure or a merge took, with no tuple built at all — the
// product's own law, read at the consumer (`destructure_subs`,
// `product_fills_stage`).
fn lower_fanout_to(handle, fan_own, left, right, dest) = match fanout_boundaries(handle) {
  Ok(boundaries) => match fan_own {
    // The N-ary carrier owns `><` (Hβ.parser.pcompose-nary); the
    // PipeKind arm delegates so the kind stays a key, not a shape.
    FanDistribute => fanout_at(handle, [left, right], NoShare, boundaries, dest),
    FanShare => {
      let lo_input = lower_expr(left)
      let input_local_name = "__fanout_input_{int_to_str(handle)}"
      let branch_nodes = share_stages(right)
      // Bind the shared input ONCE — the branches read the local,
      // whether they are applied in the frame or captured by a
      // spawning schedule's thunk.
      LBlock(
        handle,
        [
          LLet(left, input_local_name, lo_input),
          fanout_at(handle, branch_nodes, Shared(left, input_local_name), boundaries, dest)
        ]
      )
    },
  },
  Err(invariant) => LInvariantFailure(handle, invariant),
}

// Whether a fanout's branches are APPLIED to one borrowed input (`<|`) or
// are values of their own (`><`) — the ownership aspect, carried to the one
// place that projects a branch.
type InputSharing = NoShare | Shared(Int, String)

// Where a fanout's branch results go: the tuple it answers, or the
// registers its consumer already took.
type FanDest = FdValue | FdRegs([String])

// The N-ary fanout (FanoutExpr — the `><` carrier): each branch its own
// boundary, tagged by position; the runtime record already carries arity
// (the STEP 4 collapse), so the branch list generalizes with no emit change.
fn lower_fanout_nary_to(handle, branches, dest) = match fanout_boundaries(handle) {
  Ok(boundaries) => fanout_at(handle, branches, NoShare, boundaries, dest),
  Err(invariant) => LInvariantFailure(handle, invariant),
}

// ONE FANOUT SITE, PROJECTED. The branches are evaluated IN THE FRAME the
// fanout stands in for every schedule that runs them here — the sequential
// default, and the lane/device collectors, which pack the same values — so a
// branch literal is applied in place (R0i's law for a `|>` stage and a `<~`
// recurrence, extended to a branch: no closure is minted, and a `<~` inside
// one is a line of the ENCLOSING record, ticking across calls as its author
// wrote it). A spawning schedule is the one that needs a value to cross a
// thread or a disk, so its thunks are built only where its vocabulary is
// linked, and nothing else pays for them.
fn fanout_at(handle, branch_nodes, share, boundaries, dest) = {
  let inframe = fanout_inframe_walk(branch_nodes, share, boundaries, 0, len(branch_nodes))
  let spawning = spawning_schedules()
  let thunks = if len(spawning) == 0 {
    []
  } else {
    fanout_thunk_walk(handle, branch_nodes, share, boundaries, 0, len(branch_nodes))
  }
  let lexical = lower_site_schedule()
  LFanout(
    handle,
    lexical,
    FanBranches(thunks),
    fanout_forms(handle, lexical, inframe, thunks, spawning, dest)
  )
}

// A branch evaluated where the fanout stands: a `><` branch is its own
// value; a `<|` branch is a STAGE applied to the borrowed input exactly as a
// `|>` stage is (`lower_pipe_complete`) — a call completed in place, a
// literal's parameter bound to the input and its body lowered right here.
fn fanout_inframe_walk(branch_nodes, share, boundaries, i, n) = if i >= n {
  []
} else {
  let branch = list_index(branch_nodes, i)
  let value = match fanout_boundary_at(boundaries, i, branch) {
    Ok(BoundaryEdge(result_h, _, _, _, _, _)) => fanout_inframe_value(branch, result_h, share),
    Err(invariant) => LInvariantFailure(branch, invariant),
  }
  [value] ++ fanout_inframe_walk(branch_nodes, share, boundaries, i + 1, n)
}

fn fanout_inframe_value(branch, result_h, share) = match share {
  NoShare => lower_expr(branch),
  Shared(input_h, input_local_name) => lower_pipe_complete(LLocal(input_h, input_local_name), branch, result_h),
}

fn fanout_thunk_walk(handle, branch_nodes, share, boundaries, i, n) = if i >= n {
  []
} else {
  let branch = list_index(branch_nodes, i)
  let thunk = match share {
    NoShare => synthesize_branch_thunk(handle, int_to_str(i), branch, fanout_boundary_at(boundaries, i, branch)),
    Shared(input_h, input_local_name) => synthesize_diverge_thunk(
      handle,
      input_h,
      input_local_name,
      i,
      branch,
      fanout_boundary_at(boundaries, i, branch)
    ),
  }
  [thunk] ++ fanout_thunk_walk(handle, branch_nodes, share, boundaries, i + 1, n)
}

// Inference is the sole writer of executable boundaries. Missing here means
// lower was asked to project a graph whose fanout topology has no executable
// edge: a compiler error, surfaced before the productive-under-error fallback.
fn fanout_boundaries(handle) = match graph_boundary_at(handle) {
  FanoutBoundary(edges) => Ok(edges),
  InterpBoundary(_) => {
    report_at(handle, EUnresolvedType(handle, graph_epoch(), graph_span_of(handle)))
    Err(WrongFanoutBoundaryKind)
  },
  NoBoundary => {
    report_at(handle, EUnresolvedType(handle, graph_epoch(), graph_span_of(handle)))
    Err(MissingFanoutBoundary)
  },
}

fn fanout_boundary_at(boundaries, i, fallback_h) = if i < len(boundaries) {
  Ok(list_index(boundaries, i))
} else {
  report_at(fallback_h, EUnresolvedType(fallback_h, graph_epoch(), graph_span_of(fallback_h)))
  Err(MissingFanoutEdge(i))
}

fn executable_boundary_row(thunk_h) = match lookup_ty(thunk_h) {
  TFun(_, _, row) => Ok(row),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => {
    report_at(thunk_h, EUnresolvedType(thunk_h, graph_epoch(), graph_span_of(thunk_h)))
    Err(UnresolvedBoundaryThunk(thunk_h))
  },
}

// THE RACE RULE (B1, 2026-09-27). A spawned branch runs in the world it
// was spawned in — the task record carries the live install chain and the
// fresh instance installs it before the closure runs — so every perform
// inside the branch walks the SAME chain the fanout's frame holds, from a
// second instance. For each effect the branch's row carries, the handler
// that walk reaches must be PROVABLE here (installed in this frame, before
// the fence — the lexical read the schedule itself uses, never across a
// call) and must WRITE NO STATE (two instances resuming `with n = n + 1`
// on one shared state record is a definite race; a state only READ is
// shared read-only — a config parameter in costume — and runs), or the
// effect is absorbed inside the branch and never in its row at all. A
// substrate name grounds vacuously; anything else refuses at lowering,
// naming the effect and the two fixes (E_ThreadedBranchEffect, armed, born
// at wheel-zero: the wheel installs no threaded schedule). SYNTAX's
// "provably race-free" sentence, given its gate; the row of the thunk is
// the whole input, and the refusal lands on the BRANCH the developer wrote
// (`branch_h`) — the thunk is a synthesized node with no span of its own.
//
// THE WALK IS TRANSITIVE, and the first form was not (measured the same
// day, before the pin): a handler's ARM runs in the performing instance —
// the spawned one — and its performs resolve OUTER of its own install, so
// a stateless handler at the frame whose arm performs into a stateful one
// further out is the same race one hop later (`resume(bump())` under
// `~> h ~> counter` compiled and ran). So a stateless covering handler is
// not an acceptance; it is a step: every effect its residual row carries
// (`handler_arm_effects` — the row the tee re-adds, read from the same
// residual cell) is checked against the stack BELOW it, until every path
// ends at a stateless handler whose arms perform nothing, a substrate
// name, or a refusal.
//
// THE BRANCH'S OWN WRITES are the other half (2026-10-14). A branch that
// stores into memory older than itself — a buffer bound before the fanout,
// a parameter's memory, the shared input — is the race with no handler
// between: the judgment records each such site on the branch's boundary
// (`older_stores`), and a branch whose row carries `Mutate` reaches code
// that writes memory older than its own frame, which every instance shares.
fn threaded_branch_check(branch_h, thunk_row, older_stores) = match lower_fanout_schedule() {
  Threaded => if schedule_spawns(lower_handler_stack_now()) {
    if len(older_stores) > 0 {
      report_at(
        branch_h,
        EThreadedBranchEffect(
          "Mutate",
          "the branch stores into memory older than itself at {show_span(graph_span_of(list_index(older_stores, 0)))} — one buffer, written from every instance",
          graph_span_of(branch_h)
        )
      )
    } else {
      ()
    }
    each(
      { ename => threaded_effect_check(branch_h, lower_handler_stack_now(), "", ename) },
      effects_of_row(thunk_row)
    )
  } else {
    ()
  },
  Seq | Simd | Gpu | Persisted => (),
}

// Whether the Thread handler the fanout runs under actually SPAWNS: its
// arms perform WasiThreads (`parallel_compose`'s `spawn` performs
// `spawn_task`). `sequential_compose` covers the same Thread surface at
// degree 1 and runs each task inline in THIS instance, so there is no
// second instance to race with — the schedule is a handler decision, and
// the rule reads the handler's own row, never the verb (SYNTAX §`><`). The
// first form read the schedule CLASS and refused the sequential twin
// (measured on the frontier's scheduled-effect leg before the pin).
fn schedule_spawns(stack) = match threaded_handler_for(stack, "Thread") {
  Some((hd, _)) => index_of_name(handler_arm_effects(hd), "WasiThreads", 0) >= 0,
  None => false,
}

fn threaded_effect_check(branch_h, stack, via: String, ename: String) = if ename == "Mutate" {
  report_at(
    branch_h,
    EThreadedBranchEffect(
      ename,
      "{via}the branch reaches code that stores into memory older than that code's own frame — a capture, a parameter's memory, a module value, a feedback line — which every instance writes",
      graph_span_of(branch_h)
    )
  )
} else if effect_ops_substrate_grounded(ename) {
  ()
} else {
  match threaded_handler_for(stack, ename) {
    Some((hd, below)) => match handler_state_writer(hd) {
      Some(how) => report_at(
        branch_h,
        EThreadedBranchEffect(
          ename,
          "{via}the handler it reaches at the fanout's frame, `{stmt_decl_name(hd)}`, WRITES its state from an arm ({how}) — one record, two instances",
          graph_span_of(branch_h)
        )
      ),
      None => each(
        {
          inner => threaded_effect_check(
            branch_h,
            below,
            "reached through `{stmt_decl_name(hd)}`, which absorbs the branch's {ename} statelessly at the fanout's frame and performs {inner} from an arm (an arm runs in the spawned instance too) — and ",
            inner
          ),
        },
        handler_arm_effects(hd)
      ),
    },
    None => report_at(
      branch_h,
      EThreadedBranchEffect(
        ename,
        "{via}no handler for it is installed at the fanout's own frame (an install beyond the frame fence — a caller's — is not provable from here)",
        graph_span_of(branch_h)
      )
    ),
  }
}

// The innermost handler covering `ename` in the lexical stack, stopping at
// the frame fence — the schedule read's own walk, one effect at a time —
// with the stack BELOW that handler, where its arms' own performs resolve.
fn threaded_handler_for(stack, ename: String) = if len(stack) == 0 {
  None
} else {
  let below = drop_last(stack)
  match last(stack) {
    Fence => None,
    Installed(_, hd, _, _) => if string_in_list(handler_arm_enames(hd), ename) {
      Some((hd, below))
    } else {
      threaded_handler_for(below, ename)
    },
  }
}

// What a handler's arms perform: its residual row, the cell `register_handler`
// judged the arms under and the tee re-adds as `row(h)` — read live off the
// declaration, never re-derived from the arms' text.
fn handler_arm_effects(hd) = match handler_shape_at(hd) {
  Some((r, _, _, _)) => effects_of_row(mk_ef_open([], r)),
  None => [],
}

// A handler is stateful FOR THE RACE RULE when an arm WRITES its state, by
// either of a field's two writers, both read off the field's one fact
// (types.mn `StateFact`): a `resume … with` update replaces the record's
// word, and an in-place store (`list_set(buf, …)`, directly or through a
// callee storing into its parameter) mutates what the field names — the
// fact the arena's install demand reads too. Declaring state is not
// writing it: a handler whose arms only read `n` shares one immutable
// record across instances, exactly as a config parameter would. Until
// 2026-10-06 the rule read the updates alone, and two branches bumping a
// count kept in a state buffer ran.
//
// The answer says how, for the refusal: the first written field, by the
// writer that writes it. A feedback line an arm ticks lives in the install
// record past the arms, and the arms' row says they write it (infer.mn's
// `tick_mutation`), which the walk down each handler's residual row reads.
fn handler_state_writer(hd) = match handler_shape_at(hd) {
  Some((_, _, state, _)) => fold(None, state_writer_or, state),
  None => None,
}

fn state_writer_or(acc, sf) = match acc {
  Some(_) => acc,
  None => state_field_writer(sf),
}

fn state_field_writer(sf) = match graph_binder_of(state_field_init(sf)) {
  Some(fact) => match fact {
    StateFact(f) => if len(f.stores) > 0 {
      Some("an in-place store into `{state_field_name(sf)}`{store_site(last(f.stores))}")
    } else if len(f.writes) > 1 {
      Some("`resume … with` updates `{state_field_name(sf)}`")
    } else {
      None
    },
    ParamFact(_) => None,
    PartFact(_) => None,
  },
  None => None,
}

// Where the store stands in the arm: the last cell is the stored value, or
// the state argument a storing callee was handed (infer.mn `ages_transport`).
fn store_site(c) = " at {show_span(graph_span_of(c))}"

// The schedules whose branches must cross a boundary, and whose
// implementation the program links — a form is built for each, and for none
// where a program never spawns, so no thunk is synthesized there at all.
fn spawning_schedules() = {
  let threaded =
    if field_name_eq(lower_effect_name_of_op("spawn"), "Thread") { [Threaded] } else { [] }
  let persisted =
    if field_name_eq(lower_effect_name_of_op("persist_branch"), "Persist") { [Persisted] } else { [] }
  threaded ++ persisted
}

// THE FORMS A SITE CAN RUN UNDER, built where perform dispatch belongs. The
// site's own frame's schedule names the form it runs at its own frame; a
// site whose frame installs none is the one a CALLER's install can reach
// through a direct call (`spec_call_name`), so it carries a form for each
// spawning schedule the program's vocabulary can answer — Thread when its
// `spawn` op is linked, Persist when `persist_branch` is. A form's performs
// resolve at their own site: at a frame with no install they are walks of
// the world chain, which is where a caller's install lives. A schedule the
// vocabulary does not carry gets no form, so no perform of nothing is ever
// built; and a site whose frame installs a schedule is never overridden —
// the innermost install wins, as it does for every effect.
fn fanout_forms(handle, lexical, inframe, thunks, spawning, dest) = match lexical {
  Some(s) => [(s, fanout_form_of(handle, s, inframe, thunks, dest))],
  None => [(Seq, fanout_form_of(handle, Seq, inframe, thunks, dest))] ++ map({ s => (s, fanout_form_of(handle, s, inframe, thunks, dest)) }, spawning),
}

// ONE FORM: the branch results a schedule produces, collected the way the
// consumer takes them (`fanout_collect`). The values are the in-frame
// evaluations wherever the schedule runs the branches here — the sequential
// default and the lane/device collectors, which pack what this frame
// computed — and the spawn-then-join reads wherever a branch crosses a
// boundary. The verb is pure topology: only the WHERE and the collector
// differ, and nothing is minted for a schedule the site does not run.
fn fanout_form_of(handle, schedule, inframe, thunks, dest) = match schedule {
  Seq => fanout_collect(handle, dest, inframe),
  Threaded => {
    // Spawn ALL branches, THEN join ALL — true parallelism with
    // source-order collection (the spawn-join-each interleave
    // serialized). The spawn handles bind as let-locals so the joins
    // read them after every spawn has launched.
    let spawn_lets = map(spawn_let_at(handle), enumerate(thunks))
    let joins = map(spawn_join_at(handle), enumerate(thunks))
    LBlock(handle, list_concat(spawn_lets, [fanout_collect(handle, dest, joins)]))
  },
  // `~> Simd` — the SPACE-axis cash-out at the value layer's RV128 altitude:
  // the N branch results ARE the v128 lanes, packed via f32x4.replace_lane
  // over a zeroed base, so the fanout's VALUE is one v128 the lane ops
  // (emit_binop_v128: f32x4.add/mul) process four-at-once. The branches are
  // the SAME in-frame evaluations Seq runs — only the COLLECTOR differs
  // (lanes vs tuple), which is the verb being pure topology (PLAN §4 STEP 4).
  // A consumer that took the parts apart gets them as registers: a
  // destructured lane vector is scalar code, and packing it would be a
  // record built for nothing.
  Simd => match dest {
    FdValue => LSimdLanes(handle, inframe),
    FdRegs(_) => fanout_collect(handle, dest, inframe),
  },
  // `~> Gpu` — "the handler IS the backend" (PLAN: infer/lower/emit/native/GPU
  // are the projected cursor, each aspect → a target token). The WASM substrate
  // has no in-process GPU dispatch instruction — a device kernel crosses the
  // external-transport boundary (the ONE legitimate external-surface exception,
  // like wasmtime/WABT, PLAN §6). The structurally-correct lowering is a host
  // import call carrying the branch grid; until a host gpu-dispatch import is
  // bound, it runs the branches here, which is a correct sequential execution
  // of the kernel body, and the device offload is the host-import swap at that
  // boundary — named peer Hβ.lower.fanout-gpu-host-import (the transport
  // binding, not a Mentl gap).
  Gpu => fanout_collect(handle, dest, inframe),
  // `~> Persist` — parallelism and durable execution are the SAME arm (PLAN
  // §4④): each branch thunk is a continuation record (handler = state = closure
  // = evidence = continuation, §6), so a Persist scheduler spawns each branch
  // AND checkpoints its thunk to disk — a crashed/forked branch re-runs from its
  // memcpy'd record. The catch is the Persist handler (lib/persist.mn,
  // B3): each thunk is dispatched via `persist_branch` (spawn + checkpoint),
  // joined via `join_persist` (resume from disk if the live result is absent).
  // The thunks are the same strategy-neutral closures — only the CATCHER differs
  // (a persisting handler vs a thread pool vs inline), the §4④ unification made
  // real at the fanout layer.
  Persisted => {
    let spawn_lets = map(persist_let_at(handle), enumerate(thunks))
    let joins = map(persist_join_at(handle), enumerate(thunks))
    LBlock(handle, list_concat(spawn_lets, [fanout_collect(handle, dest, joins)]))
  },
}

// THE COLLECTOR: the tuple the fanout answers, or the registers its consumer
// already took — in which case no record exists at any schedule, and the
// form leaves no value of its own (wasm.mn's lexpr_leaves_value reads the form).
fn fanout_collect(handle, dest, values) = match dest {
  FdValue => LMakeTuple(handle, values),
  FdRegs(regs) => LBlock(handle, map(bind_part_to_reg, zip(regs, values))),
}

fn bind_part_to_reg(pair) = match pair {
  (reg, value) => LLet(lexpr_handle(value), reg, value),
}

// One branch's spawn, bound to its ticket handle as a let-local the join
// below reads after every spawn has launched.
// A spawn or a join perform returns with the flag raised when its branch
// abandoned — run inline by a sequential schedule's arm, or re-raised at the
// join from a thread's task record (the runtime's $join_task_impl) — so the fanout
// checks after each, per branch, where the branch's row may yield (AN-2). A
// live continuation does not cross a join: nothing past the thread can hold it.
fn branch_checked(h, thunk, e) = match lookup_ty(lexpr_handle(thunk)) {
  TFun(_, _, row) => if ls_program_may_yield() && row_may_multishot(row) { LCheck(h, e, None) } else { e },
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => e,
}

fn spawn_let_at(handle, indexed) = match indexed {
  (i, branch) => match branch {
    ScheduledBoundary(thunk, _, _, thread_ticket_h, _, _) => LLet(
      thread_ticket_h,
      "__fanout_spawn_{int_to_str(i)}_{int_to_str(handle)}",
      branch_checked(thread_ticket_h, thunk, lower_perform_dispatch(thread_ticket_h, "spawn", [thunk]))
    ),
    InvalidScheduledBoundary(boundary_h, invariant) => LLet(
      boundary_h,
      "__fanout_spawn_invalid_{int_to_str(i)}_{int_to_str(handle)}",
      LInvariantFailure(boundary_h, invariant)
    ),
  },
}

fn spawn_join_at(handle, indexed) = match indexed {
  (i, branch) => match branch {
    ScheduledBoundary(thunk, result_h, carrier_h, thread_ticket_h, _, _) => {
      let joined = lower_perform_dispatch(
        carrier_h,
        "thread_join",
        [LLocal(thread_ticket_h, "__fanout_spawn_{int_to_str(i)}_{int_to_str(handle)}")]
      )
      LFieldLoad(result_h, branch_checked(carrier_h, thunk, joined), FByIndex(0))
    },
    InvalidScheduledBoundary(boundary_h, invariant) => LInvariantFailure(boundary_h, invariant),
  },
}

fn persist_let_at(handle, indexed) = match indexed {
  (i, branch) => match branch {
    ScheduledBoundary(thunk, _, _, _, persist_ticket_h, _) => LLet(
      persist_ticket_h,
      "__fanout_persist_{int_to_str(i)}_{int_to_str(handle)}",
      branch_checked(
        persist_ticket_h,
        thunk,
        lower_perform_dispatch(persist_ticket_h, "persist_branch", [thunk])
      )
    ),
    InvalidScheduledBoundary(boundary_h, invariant) => LLet(
      boundary_h,
      "__fanout_persist_invalid_{int_to_str(i)}_{int_to_str(handle)}",
      LInvariantFailure(boundary_h, invariant)
    ),
  },
}

fn persist_join_at(handle, indexed) = match indexed {
  (i, branch) => match branch {
    ScheduledBoundary(thunk, result_h, carrier_h, _, persist_ticket_h, _) => {
      let joined = lower_perform_dispatch(
        carrier_h,
        "join_persist",
        [LLocal(persist_ticket_h, "__fanout_persist_{int_to_str(i)}_{int_to_str(handle)}")]
      )
      LFieldLoad(result_h, branch_checked(carrier_h, thunk, joined), FByIndex(0))
    },
    InvalidScheduledBoundary(boundary_h, invariant) => LInvariantFailure(boundary_h, invariant),
  },
}

// The sequence fanout's node: the same site/bracket reading as the
// syntactic forms (`fanout_forms`), each form a direct call into the
// library fn that owns the schedule. The callee-reference handle is the
// site's own, so the call's twin key is read off `fanout`'s instantiation
// there — the same shape `map` and its threaded twin declare.
fn lower_fanout_seq(handle, fh, f_h, lo_args) = {
  // Every element's branch applies the one function: the race rule reads
  // that function's row, as it reads a syntactic branch's.
  match lookup_ty(f_h) {
    TFun(_, _, f_row) => threaded_branch_check(f_h, f_row, []),
    TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
    | TRecordOpen(_, _) | TRefined(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TReprPin(_, _) | TValue(_) => (),
  }
  let lexical = lower_site_schedule()
  let forms = match lexical {
    Some(s) => [(s, fanout_seq_form(handle, fh, s, lo_args))],
    None => [(Seq, fanout_seq_form(handle, fh, Seq, lo_args))] ++ fanout_seq_linked(handle, fh, lo_args, Threaded, "fanout_threaded") ++ fanout_seq_linked(handle, fh, lo_args, Persisted, "fanout_persisted"),
  }
  // The forms' callees are declarations the lowering chose — no source
  // reference reaches them — so construction is told them here, where they
  // are chosen, and enqueues them beside the constructed decl's own
  // references (`reach_root`); the emit reach walks the selected form alone
  // and decides what is emitted.
  fanout_form_note(fold([], fanout_form_callee, forms))
  LFanout(handle, lexical, FanSeq(f_h), forms)
}

fn fanout_form_callee(acc, sf) = match sf {
  (_, LDirectCall(_, fh, DeclaredAt(d), _, _)) => push(acc, (fh, d)),
  (_, _) => acc,
}

// A form's callee as the reference construction enqueues.
fn fanout_form_ref(p) = match p {
  (fh, d) => RefCall(fh, DeclaredAt(d)),
}

// A spawning schedule's form, when its implementation is linked.
fn fanout_seq_linked(handle, fh, lo_args, s, impl: String) = {
  let c = vocabulary_callee(impl)
  match callee_kind(c) {
    Some(FnScheme) => [(s, LDirectCall(handle, fh, c, false, lo_args))],
    None | Some(_) => [],
  }
}

fn fanout_seq_form(handle, fh, schedule, lo_args) = match schedule {
  Seq => LDirectCall(handle, fh, vocabulary_callee("map"), false, lo_args),
  Threaded => fanout_seq_impl(handle, fh, lo_args, "fanout_threaded"),
  Persisted => fanout_seq_impl(handle, fh, lo_args, "fanout_persisted"),
  // Simd and Gpu pack a FIXED lane count; a runtime sequence runs
  // sequentially under them, as the syntactic Gpu arm does today.
  Simd => LDirectCall(handle, fh, vocabulary_callee("map"), false, lo_args),
  Gpu => LDirectCall(handle, fh, vocabulary_callee("map"), false, lo_args),
}

fn fanout_seq_impl(handle, fh, lo_args, impl: String) = {
  let c = vocabulary_callee(impl)
  match callee_kind(c) {
    Some(FnScheme) => LDirectCall(handle, fh, c, false, lo_args),
    None | Some(_) => LInvariantFailure(handle, SequenceFanoutUnlinked(impl)),
  }
}

// Walk branch_nodes producing one LMakeClosure per branch. Each thunk body is
// the ordinary call projection of the branch stage applied to the shared
// input, carrying inference's result_h through the call lowering. Captures begin
// with the shared input and then include the branch's free variables.
//
// Per H.2.e (lower-lambda-capture-substrate): the closure
// machinery used here is the same machinery that lowers user-
// written lambdas; compiler-synthesized thunks reuse it.
fn synthesize_diverge_thunk(parent_handle, input_h, input_local_name, i, branch_node, boundary_at) = match boundary_at {
  Ok(boundary) => match boundary {
    BoundaryEdge(result_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h, older_stores) => {
      let thunk_name = "diverge_{int_to_str(i)}_{int_to_str(parent_handle)}"
      // A diverge thunk is a closure exactly like a branch thunk (`><`,
      // synthesize_branch_thunk) — ONE closure-synthesis discipline, not two.
      // It captures EVERY free var it needs: the shared input (a synthetic
      // capture with no source VarRef, riding slot 0) AND every free var the
      // branch itself references (a lambda branch's `k`), resolved against the
      // parent frame. Inside the thunk each reads as an upval off __state. The
      // old form captured only the input and referenced it as a bare local —
      // the parent's let-local, undefined in the thunk (the input miss); and it
      // captured NONE of the branch's frees (the `k` miss). Both were invisible
      // because no micro exercised `<|` — only `><`.
      let free_uses = collect_free_uses(branch_node, [])
      match resolve_captures_outer(free_uses, parent_handle) {
        (b_names, b_exprs, b_handles) => {
          let captures_names = [input_local_name] ++ b_names
          let captures_exprs = [LLocal(input_h, input_local_name)] ++ b_exprs
          let captures_handles = [input_h] ++ b_handles
          match executable_boundary_row(thunk_h) {
            Ok(thunk_row) => {
              threaded_branch_check(branch_node, thunk_row, older_stores)
              // A branch thunk takes nothing — its input rides capture
              // slot 0 — so the param vector is empty by construction
              // and the result is the thunk node's own judged type.
              graph_emitfn_note(EmitFnEntry{
                caps: zip(captures_names, captures_handles),
                fence: len(captures_exprs),
                kind: EfkThunk,
                name: thunk_name,
                origin: thunk_h,
                params: [],
                ret: Some(lookup_ty(thunk_h)),
              })
              // THE DIRECT SWAP (α, the fanout pair's one projector):
              // Some(input_h) = the `<|` share — the branch applied to
              // the input riding capture slot 0 through the normal call
              // lowering. A `<|` branch that performs a STATEFUL effect
              // dispatches through the live world chain exactly as a
              // real lambda does — no thunk-local evidence.
              let fn_ir = project_thunk_fn(
                thunk_name,
                zip(captures_names, captures_handles),
                branch_node,
                result_h,
                carrier_h,
                Some(input_h)
              )
              ScheduledBoundary(
                LMakeClosure(thunk_h, fn_ir, captures_exprs),
                result_h,
                carrier_h,
                thread_ticket_h,
                persist_ticket_h,
                branch_node
              )
            },
            Err(invariant) => InvalidScheduledBoundary(thunk_h, invariant),
          }
        },
      }
    },
  },
  Err(invariant) => InvalidScheduledBoundary(branch_node, invariant),
}

// Branch-as-thunk synthesis. Mirrors LambdaExpr's lowering above —
// collect_free_vars over an EMPTY bound-set (a thunk has no params,
// so every name referenced in the body is a capture), resolve via
// outer frame, lower body under a fresh frame, wrap as LMakeClosure.
// The synthesized fn_name encodes parent_handle + side so emit's
// fn_idx-globals walk lifts each thunk into a distinct WASM function.
// Per H.2.e (lower-lambda-capture-substrate): the same machinery that
// lowers user-written lambdas covers compiler-synthesized thunks.
// Drift 6 closure: same closure substrate — no special-case for
// "compiler-synthesized" thunks vs. user-written ones.
fn synthesize_branch_thunk(parent_handle, side_label: String, branch_node, boundary) = match boundary {
  Ok(edge) => match edge {
    BoundaryEdge(result_h, thunk_h, carrier_h, thread_ticket_h, persist_ticket_h, older_stores) => {
      let thunk_name = "compose_{side_label}_{int_to_str(parent_handle)}"
      let free_uses = collect_free_uses(branch_node, [])
      match resolve_captures_outer(free_uses, parent_handle) {
        (captures_names, captures_exprs, captures_handles) => match executable_boundary_row(thunk_h) {
          Ok(thunk_row) => {
            threaded_branch_check(branch_node, thunk_row, older_stores)
            graph_emitfn_note(EmitFnEntry{
              caps: zip(captures_names, captures_handles),
              fence: len(captures_exprs),
              kind: EfkThunk,
              name: thunk_name,
              origin: thunk_h,
              params: [],
              ret: Some(lookup_ty(thunk_h)),
            })
            // THE DIRECT SWAP (α, the fanout pair's one projector):
            // None = the `><` distribute — the branch evaluated as its
            // own value. Synthetic parallel-thunk: empty fn_name, not a
            // lambda (frame -1 → ev READ falls through to the
            // named-fn/block path).
            let fn_ir = project_thunk_fn(
              thunk_name,
              zip(captures_names, captures_handles),
              branch_node,
              result_h,
              carrier_h,
              None
            )
            ScheduledBoundary(
              LMakeClosure(thunk_h, fn_ir, captures_exprs),
              result_h,
              carrier_h,
              thread_ticket_h,
              persist_ticket_h,
              branch_node
            )
          },
          Err(invariant) => InvalidScheduledBoundary(thunk_h, invariant),
        },
      }
    },
  },
  Err(invariant) => InvalidScheduledBoundary(branch_node, invariant),
}

// W6 — resolve a field's byte offset from the record's live type.
// Fields are sorted (field-canonicalize invariants in `effects.mn`), so the
// field's index in `TRecord(fields)` / `TRecordOpen(fields, _)` maps directly
// to `4 * idx`. There is NO graceful degrade: if `lookup_ty` returns a
// non-record type (the receiver's type mis-resolved) or the field is absent,
// return -1 — the LFieldLoad emit arm guards offset < 0 and emits a LOUD
// `(unreachable)` with a Located Reason. The former silent `0` read the node's
// word-0 as the field value (a graph pointer) and wasm.mn's wat_emit dumped the heap:
// the emit corruption. The ultimate form refuses to guess an offset it cannot
// prove; the loud trap names the unresolved receiver instead of masking it.
// The full field set of an OPEN receiver: its row read to its end
// (record_row_full, the one walk), canonically sorted. None while the rest
// is still a free variable: the layout sorts over the FULL set, so an offset
// prefix-summed over a partial set is the wrong-slot class (measured live —
// a {nodes, ...} demand read offset 0, the receiver's first sorted field),
// and the unprovable case floors loudly, never a partial sum. The offset
// read and the twin key read this one answer; they held two until
// 2026-09-28, because a residual written as the union of two partial sets
// with nothing standing for the rest had to be trusted by one and refused by
// the other. That residual no longer exists: the rest is a variable.
fn open_record_full_fields(fields, v) = match record_row_full(fields, v) {
  (all, end) => match end {
    RowEndClosed => Some(sort_record_type_fields(all)),
    RowEndFree(_) => None,
  },
}

fn resolve_field_offset(rec_handle, field_name) =
  record_field_offset(lookup_ty(rec_handle), field_name)

// A named field's offset in a record receiver — -1 while the receiver's
// field set is not whole. The field load and the record pattern both read
// it, so a field sits where one fold says in both.
fn record_field_offset(ty, field_name) = match record_full_fields(ty) {
  Some(full) => field_byte_offset(full, field_name, 0, len(full)),
  None => -1,
}

// A record receiver's WHOLE field set, sorted — Some once its row is closed,
// by the program or by the active twin's instantiation, and None while it is
// open. A variable and an open row's free end both read through lookup_ty,
// which is bracket-aware, so a generic body's receiver answers with the
// instantiation the twin is emitting (a row variable's pair is the residual
// the site proved past it, spelled after the fields the chain learned — so a
// pattern's rest binder, whose chain starts past the receiver's named
// fields, answers with the residual's own layout). A nominal record answers
// with its declaration. TVar(0) is the no-proof type, never chased.
fn record_full_fields(ty) = match ty {
  TVar(h) => if h == 0 {
    None
  } else {
    match lookup_ty(h) {
      TVar(h2) => if h2 == h { None } else { record_full_fields(TVar(h2)) },
      t @ (
        TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
        | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
        | TAlias(_, _) | TValue(_)
      ) => record_full_fields(t),
    }
  },
  TRecord(fields) => Some(fields),
  TRecordOpen(fields, v) => match record_row_full(fields, v) {
    (all, end) => match end {
      RowEndClosed => Some(sort_record_type_fields(all)),
      RowEndFree(t) => match lookup_ty(t) {
        TRecord(residual) => Some(sort_record_type_fields(all ++ residual)),
        TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
        | TName(_, _) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
        | TAlias(_, _) | TValue(_) => None,
      },
    },
  },
  TName(name, _) => nominal_record_fields(name),
  TAlias(_, inner) => record_full_fields(inner),
  TRefined(base, _) => record_full_fields(base),
  TInt => None,
  TFloat => None,
  TUnit => None,
  TByte => None,
  TAddr => None,
  TList(_) => None,
  TTuple(_) => None,
  TFun(_, _, _) => None,
  TCont(_, _, _, _) => None,
  TReprPin(_, _) => None,
  TValue(_) => None,
}

// A field's byte offset is the prefix-sum of repr_width over the canonically-
// sorted fields preceding it — NOT 4*i. The width is the field's slot width
// (`slot_repr`): an i32/pointer field is 4, an f64/i64 field is 8, a v128
// lane field is 16. For an all-i32 record this is exactly 4*i (Law 7
// byte-identity); a float field genuinely occupies 8 inline bytes.
fn field_byte_offset(fields, target, i, n) = field_byte_offset_acc(fields, target, i, n, 0)

// field absent — unprovable offset, NOT a silent 0
fn field_byte_offset_acc(fields, target, i, n, acc) = if i >= n {
  -1
} else {
  match list_index(fields, i) {
    (name, ty) => {
      let r = slot_repr(ty)
      let here = align_for(acc, r)
      if field_name_eq(name, target) {
        here
      } else {
        field_byte_offset_acc(fields, target, i + 1, n, here + repr_width(r))
      }
    },
  }
}

// THE WIDTH OF A SLOT whose type is `ty`, read live through `slot_ty`: under
// a twin's bracket a variable is the site's instantiation, at the floor it
// is what the graph bound, a free one is the word, and TVar(0) is lower's
// explicit no-proof floor. Every layout reader takes a slot's width here —
// construction, field load, tuple index, the record, constructor and list
// patterns, the fold leaves — because a layout computed two ways is two
// layouts.
fn slot_repr(ty) = repr_of(slot_ty(ty))

// The type a slot holds under the twin being emitted: a variable is read
// through `lookup_ty`, which answers the bracket's instantiation, and an
// alias or refinement through its base. TVar(0), the no-proof type, is never
// chased; an unbound variable stays itself, the word floor.
fn slot_ty(ty) = match ty {
  TVar(h) => if h == 0 {
    ty
  } else {
    match lookup_ty(h) {
      TVar(h2) => if h2 == h { ty } else { slot_ty(TVar(h2)) },
      t @ (
        TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
        | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
        | TAlias(_, _) | TValue(_)
      ) => slot_ty(t),
    }
  },
  TAlias(_, inner) => slot_ty(inner),
  TRefined(base, _) => slot_ty(base),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TValue(_) => ty,
}

// v128 lanes want 16-byte alignment for aligned loads/stores; every other
// width is naturally aligned by the prefix-sum (4/8 byte fields). Pad the
// running offset up to the field's alignment before placing it.
fn align_for(off, r) with Pure = match r {
  RV128 => {
    let m = off % 16
    if m == 0 { off } else { off + (16 - m) }
  },
  RI32 | RI64 | RF64 | RF32 => off,
}

// tuple_elem_offset — a tuple IS a positional product (L1); element `i`'s byte
// offset is the prefix-sum of repr_width over the elements 0..i, the IDENTICAL
// width-summed fold field_byte_offset_acc runs for records. The elements are
// the TTuple's positional Tys, each read at its slot width (`slot_repr`).
// For an all-i32 tuple this is exactly 4*i (Law 7); an f64 element genuinely
// occupies 8 inline bytes. Carried-Truth: construction (emit_field_stores_acc
// over the tuple elems) and the index/match-bind read the SAME offset fold —
// they cannot disagree on where element i lives.
//
// index out of range — unprovable, NOT a silent 0
fn tuple_elem_offset(elems, target, i, off) = if i >= len(elems) {
  -1
} else {
  let r = slot_repr(list_index(elems, i))
  let here = align_for(off, r)
  if i == target { here } else { tuple_elem_offset(elems, target, i + 1, here + repr_width(r)) }
}

// Statement lowering: a statement list in its binding runs (`stmt_runs`),
// each lowered into one buffer of `(buf, count)`.
fn lower_stmt_list(stmts) = {
  let n = len(stmts)
  let initial_capacity = if n < 4 { 4 } else { n }
  match fold((make_list(initial_capacity), 0), lower_run_into, stmt_runs(stmts)) {
    (final_buf, final_count) => slice(final_buf, 0, final_count),
  }
}

// A run of fn declarations binds every member's name before any member
// mints, so a member that captures a sibling declared after it reads the
// register the sibling's record will be set at; the emit fills the records
// once every one of them exists (wasm.mn's emit_minted_bindings).
fn lower_run_into(acc, run) = match run {
  Lone(stmt) => lowered_into(acc, lower_stmt(stmt)),
  Joined(decls) => fold(acc, lower_member_into, zip(decls, flat_map(bind_member, decls))),
}

// A run member's name bound in the frame: the register its record is set at.
fn bind_member(decl) = match graph_node_body(decl) {
  NStmt(FnStmt(name, _, _, _, _)) => [ls_bind_local(name, decl)],
  // a run holds fn declarations only
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => [],
}

fn lower_member_into(acc, member) = match member {
  (decl, reg) => match graph_node_body(decl) {
    NStmt(FnStmt(name, params, _, _, body_node)) => lowered_into(acc, lower_fn_mint(name, params, body_node, decl, reg)),
    // a run holds fn declarations only
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => acc,
  },
}

// A lowered statement appended to the buffer. Its holes stay pending to the
// top-level declaration being constructed, which the reach keeps or drops
// whole (`reach_construct`): a nested lambda's, thunk's or arm's hole shares
// its declaration's reachability.
fn lowered_into(acc, lo) = match acc {
  (buf, count) => (list_set(list_extend_to(buf, count + 1), count, lo), count + 1),
}

// Module scope is a frame: the frame of $__init_lets, the one WAT function
// every module value let's init runs in. Its locals are that function's
// locals, a fn nested in an init is a closure minted there (its lines are
// slots in its own record), and a `<~` directly in an init is static, its
// ring an instance global owned by $__init_lets. The frame is named for
// the binding, so a nested fn qualifies as it would inside a fn of that
// name. Lowered with no frame, a block local resolved as a global and a
// nested fn took a static home it had no record for
// (Hβ.lower.module-scope-has-no-frame). The frame's lines are not kept:
// every one is static and rides its own `LFeedback`, where the emit reads
// it.
fn lower_module_init(pat, handle, expr) = {
  let frame_name = match pat_of(pat) {
    PVar(_) => decl_symbol(handle),
    PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) | PAs(_, _) => "init{int_to_str(handle)}",
  }
  ls_enter_frame(frame_name, [], [], [], [], -1)
  lower_frame_fence_push()
  let lo = lower_expr(expr)
  lower_handler_pop()
  ls_exit_frame()
  lo
}

// H6: exhaustive NodeBody enumeration. NPat and NHole at
// statement position are degenerate; lowering to LConst(0)
// is the "unreachable-in-well-formed-source" fallback. Named
// explicitly so a new NodeBody variant surfaces at compile time.
fn lower_stmt(handle) = {
  let span = graph_span_of(handle)
  match graph_node_body(handle) {
    NStmt(s) => lower_stmt_body(s, handle, span),
    NExpr(e) => lower_expr_body(e, handle, span),
    // pattern at stmt position — degenerate
    NPat(_) => LConst(handle, LInt(0)),
    // Hazel hole at stmt position — unreachable trap at emit
    NHole(_) => LConst(handle, LInt(0)),
    // module entity at stmt position — degenerate
    NModule(_) => LConst(handle, LInt(0)),
    NLink(_) => LConst(handle, LInt(0)),
    // type annotation at stmt position — degenerate
    NTypeAnn(_) => LConst(handle, LInt(0)),
    NName(_) => LConst(handle, LInt(0)),
    NRow(_) => LConst(handle, LInt(0)),
    NParam(_) => LConst(handle, LInt(0)),
  }
}

fn lower_stmt_body(s, handle, span) = match s {
  LetStmt(pat, expr, _) => {
    let lo = if ls_frame_depth() == 0 { lower_module_init(pat, handle, expr) } else { lower_expr(expr) }
    match pat_of(pat) {
      // Register the name in the current scope (a local for subsequent
      // VarRef lookups; the bound expr's handle IS the local's type handle),
      // set at the register the binding took.
      PVar(name) => LLet(handle, ls_bind_local(name, expr), lo),
      // In a block `let _ = e` evaluates e for effect, and a destructuring
      // pattern never reaches here: the parser makes `let pat = v; rest` the
      // `match v { pat => rest }` it is at the node's birth (desugar_block),
      // whose one pattern walk binds and lowers (`lower_match_arms`). The
      // module's init stores only what one binder names, so at module scope
      // any other pattern is refused.
      PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) | PAs(_, _) => if ls_frame_depth() == 0 { LInvariantFailure(handle, ModuleLetPattern) } else { lo },
    }
  },
  // Bind the fn's name in the enclosing frame (the fn's handle is the type
  // handle, its TFun bound there by infer) and mint it at that register; a
  // block's run of fns binds every name before it mints any
  // (`lower_run_into`).
  FnStmt(name, params, _ret_ann, _effs, body_node) => lower_fn_mint(name, params, body_node, handle, ls_bind_local(name, handle)),
  TypeDefStmt(_name, _variants) => LConst(handle, LInt(0)),
  EffectDeclStmt(_name, _params, _ops) => LConst(handle, LInt(0)),
  HandlerDeclStmt(_name, _ename, config, state, arms, _effs) => {
    // Each arm becomes a wasm function, `op_<handler>_<op>` (`arm_fn_name`,
    // read off this statement, the handler's declaration) — unique where
    // many handlers answer one op, as the prelude's handlers all answer
    // Iterate's `yield`. The config parameters and state fields are bound as
    // the arm's captures, so their references read the record's slots. The
    // arm-name groups that size the record's fence are read off the same
    // declaration an install reads, so the two agree in any module order.
    //
    // A PROJECTION's arms are not lowered: an install of it builds no
    // record, so nothing could ever call them. The derivative reading's arm
    // states what `d(v)` means and derive reads that meaning as a rewrite; its
    // body names a primitive with no forward lowering on purpose. An arena's
    // arms forward its body's allocation, which the substrate answers anyway.
    let arm_decls = match projection_of(handle) {
      PDerivative => [],
      PArena => [],
      PSchedule(_) | PDispatch => lower_handler_arms_as_decls(arms, handle, config, state),
    }
    LBlock(handle, list_concat(arm_decls, [LConst(handle, LInt(0))]))
  },
  // A chain has no runtime presence of its own: every install of it
  // became its members' installs at the judgment, and the members' arms are
  // lowered at their own declarations.
  HandlerChainStmt(_, _) => LConst(handle, LInt(0)),
  ImportStmt(_module) => LConst(handle, LInt(0)),
  RefineStmt(_name, _ty, _pred) => LConst(handle, LInt(0)),
  // Transparent alias: type-level only, no runtime presence — the alias
  // and its underlying type unify at infer; emit erases (like RefineStmt).
  AliasStmt(_name, _ty) => LConst(handle, LInt(0)),
  // A named row is an env fact — no runtime presence.
  RowAliasStmt(_name, _effs) => LConst(handle, LInt(0)),
  ExprStmt(expr) => lower_expr(expr),
}

// A named fn's mint, at the register its name is bound to.
fn lower_fn_mint(name, params, body_node, handle, reg) = {
  // A nested fn captures the continuation and the install record its arm
  // holds, as a lambda minted there does: a resume in its body reads the k
  // its record carries, so it is called with its own arguments alone and
  // handed out as a value like any closure. Where no arm encloses the mint,
  // the seeds add nothing.
  let free_uses =
    collect_free_uses(body_node, param_bound_names(params)) |> lower_seed_k |> lower_seed_hrec
  let param_names_list = lower_param_names(params)
  let param_tys_list = entry_param_tys(handle, params)
  match resolve_captures_outer(free_uses, handle) {
    (captures_names, captures_exprs, captures_handles) => {
      // The emitted symbol, asked BEFORE this fn's own frame is entered so
      // the path is its enclosing fns' (`ls_fn_symbol`): the declaration's
      // own at top level, the symbol the module's start calls for main.
      let fn_name = ls_fn_symbol(name, handle)
      graph_emitfn_note(EmitFnEntry{
        caps: zip(captures_names, captures_handles),
        fence: len(captures_exprs),
        kind: EfkNested,
        name: fn_name,
        origin: handle,
        params: zip(param_names_list, param_tys_list),
        ret: ret_ty_of(handle),
      })
      // THE DIRECT SWAP (landing shape α, second kind): the LowFn is
      // built by the column-seeded projector; the site keeps what feeds the
      // columns.
      match project_nested_fn(handle, fn_name, zip(captures_names, captures_handles)) {
        // Two namespaces meet here, each carried by its own node. The LLet
        // holds the LOCAL one — the register the name is bound at (the source
        // name unless it shadows), which the body's own references, a
        // self-capture and a sibling's capture read — and the LowFn holds the
        // EMITTED symbol (`ls_fn_symbol`). The emit binds the record at the
        // LLet's register (wasm.mn's emit_minted_bindings) and names its body by the
        // LowFn, so neither is read for the other. Binding this LLet to the
        // symbol was tried at pin 3967d236b294 and reverted: it left the
        // register the captures read unbound.
        Some(fn_ir) => LLet(handle, reg, LMakeClosure(handle, fn_ir, captures_exprs)),
        None => LInvariantFailure(handle, ProjectionOriginShape(handle)),
      }
    },
  }
}

// Pattern lowering
fn lower_match_arms(scrut_h, arms) = {
  // ONE scrutinee, ONE representation proof — hoisted out of the per-arm
  // map (the chase is per-value, never per-arm). Whether a flat list's
  // elements may be read raw is the emit's question: it depends on the
  // element's width, which only the twin being emitted knows.
  let srep = seq_rep_of(scrut_h)
  // THE LAST ARM OF A MATCH OF SEVERAL ARMS RUNS UNTESTED when its pattern
  // extracts nothing from a payload: the judgment refuses every such match a
  // value escapes (E_PatternInexhaustive), so every value the arms before it
  // leave reaches it, and a roster costs what the `_` cost. A match of one
  // arm asserts its shape, and its arm keeps the test the claim's Trap
  // stands for.
  let n = len(arms)
  let last_unconditional = n > 1
  map(
    {
      (i, arm) => match arm {
        (pat, body) => {
          let cp = ls_push_scope()
          // ONE walk binds the arm's names and lowers its pattern, so a
          // binder's register is decided at its binding and the pattern the
          // emit writes carries it. The pattern's value type is the
          // scrutinee's, read live, and every sub-pattern keeps its own — so
          // the emit places each slot by the SAME fold construction and
          // access run, under any twin.
          let lp = lower_pat_value(
            bind_fresh,
            arm_pat_lowered(pat, i == n - 1 && last_unconditional),
            pat,
            lookup_ty(scrut_h),
            srep,
            scrut_h
          )
          let lo_body = lower_expr(body)
          ls_pop_scope(cp)
          (lp, lo_body)
        },
      },
    },
    enumerate(arms)
  )
}

fn arm_pat_lowered(pat, last_of_exhaustive) = if last_of_exhaustive {
  match unconditional_pat(pat) {
    Some(u) => u,
    None => pat_of(pat),
  }
} else {
  pat_of(pat)
}

// The pattern an arm lowers as when nothing can fail to match it: `_` for a
// roster whose payloads are all `_`, the binder for a roster bound under one
// (`b @ (C(_) | D)` binds the scrutinee, as `b` alone does); None for a
// pattern that places a binder inside a payload or tests a literal.
fn unconditional_pat(pat) = match pat_of(pat) {
  PWild => Some(PWild),
  PVar(n) => Some(PVar(n)),
  PAs(n, inner) => match unconditional_pat(inner) {
    Some(_) => Some(PVar(n)),
    None => None,
  },
  PCon(_, ps) => if all(pat_is_wild, ps) { Some(PWild) } else { None },
  PAlt(branches) => fold(Some(PWild), merge_unconditional, map(unconditional_pat, branches)),
  PLit(_) => None,
  PTuple(_) => None,
  PList(_, _) => None,
  PRecord(_, _) => None,
}

fn pat_is_wild(p) = match pat_of(p) {
  PWild => true,
  PVar(_) => false,
  PLit(_) => false,
  PCon(_, _) => false,
  PTuple(_) => false,
  PList(_, _) => false,
  PRecord(_, _) => false,
  PAlt(_) => false,
  PAs(_, _) => false,
}

// Two branches of one unconditional alternation agree on the binder they
// place or place none (the alternation law has every branch bind the same
// names); any branch that keeps a test keeps the arm's.
fn merge_unconditional(acc, u) = match acc {
  None => None,
  Some(a) => match u {
    None => None,
    Some(PWild) => Some(a),
    Some(PVar(n)) => match a {
      PWild => Some(PVar(n)),
      PVar(m) => if m == n { Some(PVar(n)) } else { None },
      PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) | PAs(_, _) => None,
    },
    Some(PLit(_)) | Some(PCon(_, _)) | Some(PTuple(_)) | Some(PList(_, _)) | Some(PRecord(_, _))
    | Some(PAlt(_)) | Some(PAs(_, _)) => None,
  },
}

// How a pattern walk binds a name. A binder takes its register where the
// walk first meets it (`bind_fresh`, at the handle of the type its position
// matched); an alternation's later branches write the registers the first
// branch took (`bind_again`) — the alternation law has every branch bind
// the same names, and the arm body reads one register per name.
fn bind_fresh(name: String, ty) = ls_bind_local(name, ty_handle_of(ty))

fn bind_again(name: String, _ty) = match ls_resolve(name) {
  (RLocal(reg), _) => reg,
  // A later branch binding a name the first did not is refused at the
  // judgment (E_PatternAlternationBindingMismatch); the source name keeps
  // the refused arm assembling.
  (RUpval(_), _) => name,
  (RFbPrior(_), _) => name,
  (RGlobal, _) => name,
}

// THE one "handle of a Ty (0 if ground)" projection — read by tparam_handle,
// lower_param_handles and a pattern binder's binding (Carried-Truth: one
// home, N readers, never a
// re-derived copy). A Ty is TVar(handle) only while un-ground; every ground
// type carries no handle, so the 0 sentinel is EXPLICIT per variant, not a
// wildcard that would silently absorb a future Ty. (The env_find self-host
// blocker: handle-0 made `k == name` compare op-key POINTERS, so `==`
// dispatches to str_eq, never pointer i32.eq.) H6: exhaustive Ty enumeration.
fn ty_handle_of(ty) = match ty {
  TVar(handle) => handle,
  TInt => 0,
  TFloat => 0,
  TUnit => 0,
  TByte => 0,
  TAddr => 0,
  TList(_) => 0,
  TTuple(_) => 0,
  TFun(_, _, _) => 0,
  TName(_, _) => 0,
  TRecord(_) => 0,
  TRecordOpen(_, _) => 0,
  TRefined(_, _) => 0,
  TCont(_, _, _, _) => 0,
  TAlias(_, _) => 0,
  TReprPin(_, _) => 0,
  TValue(_) => 0,
}

// ─── the sequence-representation chase ──────────────────────────────
//
// seq_rep_of projects the representation the value was BORN with: the
// graph holds the construction (a MakeListExpr is flat, a ++ node is a
// rope, a push call is snoc, a slice call is a view), and the LowerScope
// binding edge (ls_bind_local: name -> the init expression's handle)
// carries it through local lets — no new state, no side-ledger, a pure
// projection over two edges the graph already draws. Joins widen: equal
// reps survive a merge; different reps degrade to SRUnknown, the honest
// floor where the runtime tag branch is genuine information. Params,
// captures, and polymorphic flow read SRUnknown until the spec bracket
// learns to carry rep pairs (the twins' next axis).
//
// Fuel bounds the descent: a chase step through a binding, a join arm, or
// a block tail spends one, and exhaustion degrades to SRUnknown — always
// sound (the total reader), never a deep tree re-walk per pattern.
fn seq_rep_of(h) = seq_rep_of_fuel(h, 8)

fn seq_rep_of_fuel(h, fuel) = if fuel <= 0 {
  SRUnknown
} else {
  match graph_node_body(h) {
    NExpr(MakeListExpr(_)) => SRFlat,
    NExpr(LitString(_)) => SRFlat,
    NExpr(MakeStringExpr(_)) => SRFlat,
    NExpr(ShowExpr(_)) => SRFlat,
    NExpr(BinOpExpr(op, _, _)) => match op {
      BConcat => SRRope,
      BAdd | BSub | BMul | BDiv | BMod | BEq | BNe | BLt | BGt | BLe | BGe | BAnd | BOr => SRUnknown,
    },
    NExpr(CallExpr(f, _)) => match graph_node_body(f) {
      NExpr(VarRef(cname)) => seq_rep_of_call(cname),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
      | NRow(_) | NParam(_) => SRUnknown,
    },
    NExpr(IfExpr(_, t, e)) => seq_rep_join(seq_rep_of_fuel(t, fuel - 1), seq_rep_of_fuel(e, fuel - 1)),
    NExpr(MatchExpr(_, arms)) => seq_rep_arms(arms, 0, SRUnknown, true, fuel - 1),
    NExpr(BlockExpr(_, final_e)) => seq_rep_of_fuel(final_e, fuel - 1),
    NExpr(VarRef(name)) => match ls_resolve(name) {
      (res, local_h) => match res {
        RLocal(_) => if local_h == 0 { SRUnknown } else { seq_rep_of_fuel(local_h, fuel - 1) },
        RUpval(_) | RGlobal | RFbPrior(_) => SRUnknown,
      },
    },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => SRUnknown,
  }
}

// The runtime constructors' return representations — the same named set
// is_seq_op already recognizes as the substrate boundary. Anything not in
// the set is the honest unknown (a per-fn rep summary is the
// interprocedural completion).
fn seq_rep_of_call(ref cname: String) = if cname == "make_list" {
  SRFlat
} else {
  if cname == "list_to_flat" {
    SRFlat
  } else {
    if cname == "push" {
      SRSnoc
    } else {
      if cname == "slice" { SRSlice } else { if cname == "str_slice" { SRSlice } else { SRUnknown } }
    }
  }
}

fn seq_rep_join(a, b) = if a == b { a } else { SRUnknown }

fn seq_rep_arms(ref arms, i, acc, first, fuel) = if i >= len(arms) {
  acc
} else {
  match list_index(arms, i) {
    (_, body) => {
      let r = seq_rep_of_fuel(body, fuel)
      seq_rep_arms(arms, i + 1, if first { r } else { seq_rep_join(acc, r) }, false, fuel)
    },
  }
}

// Lowers `pat`, matched against a value of type `ty`, keeping that type on
// every sub-pattern: a tuple's element, a constructor's payload at the
// scrutinee's own instantiation, a record's field, a list's element — and
// binds each binder with `bind` as the walk meets it (left to right, an
// as-binder before its inner pattern, a rest after the elements or fields it
// follows), carrying the register that binding took. No width and no offset
// is decided here; the emit reads each slot through the kept type
// (`slot_repr`) under whatever twin it is emitting. `rh` is the scrutinee's
// handle, where a record whose field set never closes is reported. TVar(0)
// is the explicit no-proof type: a position no type reached, read as the
// word.
fn lower_pat_at(bind, pat, ty, srep, rh) = lower_pat_value(bind, pat_of(pat), pat, ty, srep, rh)

// The pattern a node holds, lowered — or the pattern an arm lowers as in its
// place (`arm_pat_lowered`), which names no constructor. A constructor is
// the declaration the pattern's edge reaches (`ctor_kind_at`).
fn lower_pat_value(bind, p, node, ty, srep, rh) = match p {
  PVar(name) => LPVar(bind(name, ty)),
  PWild => LPWild,
  PLit(v) => LPLit(lower_lit_value(v)),
  PTuple(sub) => LPTuple(lower_pat_positions(bind, sub, tuple_elem_tys(ty), rh)),
  // The scrutinee's proven representation rides the TOP list pattern —
  // nested sequences are reached through elements (rep unknown) and stay
  // on the total reader.
  PList(sub, rest) => lower_pat_list(bind, list_elem_ty(ty), sub, rest, srep, rh),
  // The constructor's tag_id is read off the declaration the pattern's
  // edge reaches; emit dispatches on the int tag. The receiver's type
  // grounds the constructor's payloads, so a binder takes the width the
  // graph PROVED rather than the one the declaration quantified.
  PCon(name, sub) => match ctor_kind_at(node) {
    Some(ConstructorScheme(t, _)) => LPCon(name, t, lower_pat_positions(bind, sub, pat_payload_tys(name, ty), rh)),
    // Nominal-record pattern `Pri(pa)`: the runtime value IS the bare
    // record (no tag word) — the ctor wrapper is the identity in
    // pattern position exactly as in construction. The single
    // sub-pattern matches the scrutinee itself, at the scrutinee's own
    // type. The BARE spelling `Pri =>` binds nothing: LPWild.
    Some(RecordSchemeKind(_)) => if len(sub) == 0 { LPWild } else { lower_pat_at(bind, list_index(sub, 0), ty, srep, rh) },
    // a name no declaration proves: infer already reported it, and the
    // sub-binders still declare so the dead arm body assembles
    None | Some(_) => LPUnresolvedCon(name, map(lower_pat_at(bind, ??, TVar(0), SRUnknown, rh), sub)),
  },
  PRecord(flds, rest) => {
    let lflds = map(lower_pat_field(bind, ty, rh, ??), flds)
    LPRecord(rh, ty, lflds, bind_rest(bind, rest))
  },
  // Alternation branches match the one scrutinee, at its type; the first
  // takes the registers and the rest write them.
  PAlt(branches) => match branches {
    [first, ...others] => {
      let lfirst = lower_pat_at(bind, first, ty, srep, rh)
      LPAlt([lfirst] ++ map(lower_pat_at(bind_again, ??, ty, srep, rh), others))
    },
    [] => LPAlt([]),
  },
  PAs(name, inner) => {
    // The binder rides the pattern's own path; the inner keeps the
    // scrutinee's type (the whole point — the name IS the value).
    let reg = bind(name, ty)
    LPAs(reg, lower_pat_at(bind, inner, ty, srep, rh))
  },
}

// What the declaration a constructor pattern's edge reaches was published
// as; None where the judgment drew no edge — a name it refused.
fn ctor_kind_at(node) = match graph_ref_decl(node) {
  Some(d) => match graph_published(d) {
    Some((_, _, kind)) => Some(kind),
    None => None,
  },
  None => None,
}

// A list or record pattern's rest: the fresh slice or record the emit builds
// for it binds under the no-proof type, and `..._` binds nothing.
fn bind_rest(bind, rest) = match rest {
  None => None,
  Some(r) => match pat_of(r) {
    PVar(name) => Some(bind(name, TVar(0))),
    PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) | PAs(_, _) => Some("_"),
  },
}

// A record pattern's field, lowered at the field's type.
fn lower_pat_field(bind, ty, rh, fld) = match fld {
  (name, sub) => (name, lower_pat_at(bind, sub, record_field_ty(ty, name), SRUnknown, rh)),
}

// A list pattern: every element sub-pattern matched against the list's one
// element type `elem`, carried on the pattern for the emit to read.
fn lower_pat_list(bind, elem, sub, rest, srep, rh) = {
  let lsub = map(lower_pat_at(bind, ??, elem, SRUnknown, rh), sub)
  LPList(elem, lsub, bind_rest(bind, rest), srep)
}

// The type a record pattern's field has at the receiver: the fields the
// receiver's row knows, closed or open, or a nominal record's declaration.
// A field no type names takes the no-proof floor.
fn record_field_ty(ty, name: String) = match find(field_named(name, ??), record_known_fields(ty)) {
  Some(f) => match f {
    (_, t) => t,
  },
  None => TVar(0),
}

// The three projections below read the positions a pattern names beneath
// its scrutinee. Inference unified the scrutinee with the pattern's own
// shape before lowering ran, so a type of any other shape here is the
// no-proof type reaching the pattern from above or a mismatch the judgment
// already reported; it proves no position. Each is enumerated, so a new
// type shape is a decision rather than a silent no-proof.
fn record_known_fields(ty) = match tuple_pat_strip(ty) {
  TRecord(fs) => fs,
  TRecordOpen(fs, v) => match record_row_full(fs, v) {
    (all, _) => all,
  },
  TName(n, _) => match nominal_record_fields(n) {
    Some(declared) => declared,
    None => [],
  },
  TReprPin(_, inner) => record_known_fields(inner),
  TAlias(_, inner) => record_known_fields(inner),
  TRefined(inner, _) => record_known_fields(inner),
  TVar(_) | TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _)
  | TCont(_, _, _, _) | TValue(_) => [],
}

fn field_named(name: String, f) = match f {
  (n, _) => field_name_eq(n, name),
}

fn tuple_elem_tys(ty) = match tuple_pat_strip(ty) {
  TTuple(elems) => elems,
  TReprPin(_, inner) => tuple_elem_tys(inner),
  TAlias(_, inner) => tuple_elem_tys(inner),
  TRefined(inner, _) => tuple_elem_tys(inner),
  TVar(_) | TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => [],
}

fn list_elem_ty(ty) = match tuple_pat_strip(ty) {
  TList(e) => e,
  TReprPin(_, inner) => list_elem_ty(inner),
  TAlias(_, inner) => list_elem_ty(inner),
  TRefined(inner, _) => list_elem_ty(inner),
  TVar(_) | TInt | TFloat | TUnit | TByte | TAddr | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => TVar(0),
}

// A constructor's payload types at the scrutinee — none where no type
// reached it (the null handle is never chased).
fn pat_payload_tys(name: String, ty) = match ty {
  TVar(h) => if h == 0 { [] } else { con_payload_tys_at(name, ty) },
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) | TValue(_) => con_payload_tys_at(name, ty),
}

// Strip alias/refinement and chase a top-level TVar to its bound type so a
// tuple scrutinee typed as `TVar -> TTuple` resolves to its element list.
// TVar(0), the no-proof type, is never chased.
fn tuple_pat_strip(ty) = match ty {
  TVar(h) => if h == 0 {
    ty
  } else {
    match graph_chase(h) {
      GNode(NBound(inner), _) => tuple_pat_strip(inner),
      GNode(_, _) => ty,
    }
  },
  TAlias(_, inner) => tuple_pat_strip(inner),
  TRefined(base, _) => tuple_pat_strip(base),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TValue(_) => ty,
}

// A tuple's elements or a constructor's payloads: each sub-pattern paired
// with its position's PROVEN type — a tuple's element type, a payload read at
// the scrutinee's own instantiation — and lowered at it, so it lands at its
// width-summed offset (the SAME fold construction + index run) and a
// tuple-of-tuples resolves offsets at every depth. A position no type reached
// takes TVar(0), the explicit no-proof floor (the null handle, never chased),
// which `slot_repr` reads as the word — never a fabricated width.
fn lower_pat_positions(bind, subs, tys, rh) =
  map(lower_pat_position(bind, tys, rh, ??), enumerate(subs))

fn lower_pat_position(bind, tys, rh, slot) = match slot {
  (i, sub) => {
    let t = if i < len(tys) { list_index(tys, i) } else { TVar(0) }
    (t, lower_pat_at(bind, sub, t, SRUnknown, rh))
  },
}

// The two views of one paired list. The walkers that read a payload's OFFSET
// need the whole type list (the width-summed fold), and the walkers that read
// a sub-pattern need the patterns; both project from the ONE source LPCon
// carries, computed at the arm rather than re-read from the env by name — the
// pairing is where the correctness lives, and these cannot disagree.
fn ty_of_pairs(pairs) = map(pair_ty, pairs)

fn pat_of_pairs(pairs) = map(pair_pat, pairs)

fn pair_ty(pair) = match pair {
  (t, _) => t,
}

fn pair_pat(pair) = match pair {
  (_, p) => p,
}

// One constructor's payload types AT the scrutinee's instantiation — the
// grounded specs, keyed by the constructor NAME the pattern carries. An
// unresolved scrutinee answers with no types and the caller floors each slot.
// The receiver arrives as whatever the pattern's own site holds, which for a
// match scrutinee is a var the graph has since bound — so the read resolves
// through chase_deep before stripping, the same fold boundary the eq and show
// collectors run at their dispatch entry. Without it a `match a` whose `a` is
// a bound var answered with no specs at all, and every payload floored.
fn con_payload_tys_at(cname: String, scrutinee_ty) = match find(spec_named(cname), variant_named_specs_at(fold_strip(chase_deep(scrutinee_ty)))) {
  Some(spec) => match spec {
    (_, _, tys) => tys,
  },
  None => [],
}

fn lower_lit_value(v) = match v {
  LVInt(n) => LInt(n),
  LVFloat(f) => LFloat(f),
  LVString(s) => LString(s),
  LVBool(b) => LBool(b),
}

// A handler's arms as `LDeclareFn` entries: module-level fn declarations,
// no runtime allocation. Each arm body becomes a wasm function
// (`arm_fn_name`) taking the arm's args after the implicit `__state`, which
// is the install record; a state init is a fn of its own
// (`lower_init_decl`). `hd` is the handler's declaration.
fn lower_handler_arms_as_decls(arms, hd, config, state) = {
  // The arm fn's __state IS the handler record [_, nstate FENCE, state..,
  // arms.., evs..]; its captured-ev region starts past state AND arms, so
  // fence = nstate + total_arms — summed from the SAME arm-name groups the
  // install's emit lays the arms by (the two sides agree by construction).
  let nstate = len(config) + len(state)
  let fence = nstate + sum_group_arm_lens(handler_arm_groups(hd))
  // The arms share ONE record — the install's — so their `<~` lines share
  // one slot space past the fence: each arm's lines begin where the arms
  // before it ended, threaded through the fold (the install's emit sizes
  // the record by the sum over the same arm fns). The init fn's lines come
  // last.
  match fold(
    ([], fence),
    (acc, arm) => match acc {
      (decls, line_base) => match lower_one_arm_decl(arm, hd, config, state, fence, line_base) {
        LDeclareFn(LFn(n, a, p, b, f, lines)) => (decls ++ [LDeclareFn(LFn(n, a, p, b, f, lines))], line_base + len(lines)),
        other @ (
          LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
          | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
          | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
          | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _)
          | LFanout(_, _, _, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _)
          | LMatch(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _)
          | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
          | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
          | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _)
        ) => (decls ++ [other], line_base),
      },
    },
    arms
  ) {
    (decls, line_base) => if len(state) == 0 {
      decls
    } else {
      decls ++ [lower_init_decl(hd, config, state, fence, line_base)]
    },
  }
}

// A handler's state inits are a function of its record, as its arms are.
// They are judged with the config bound (register_handler), so they name
// only the config and globals — and an install's own scope holds neither
// config name. So they lower ONCE, here, in the arms' frame, where the
// config names are captures at slots 0..nconfig-1, into one fn the install
// calls with the record (`init_fn_name`). Each field stores at its slot,
// a wide value in a cell of its own (`LStateInit`). Lowered at every
// install instead, an init reading its config through an expression
// (`with n = cfg.x`) reached the unbound-name floor, and the special case
// that served a bare config name read every capture in the install's list
// as the record's own slot, so a captured config argument arrived as 0.
fn lower_init_decl(hd, config, state: [{init: Node, name: Node}], fence, line_base) = {
  let fn_name = init_fn_name(hd)
  let config_names = lower_param_names(config)
  let captures_names = config_names ++ state_field_names_of(state)
  let nconfig = len(config_names)
  graph_emitfn_note(EmitFnEntry{
    caps: [],
    fence,
    kind: EfkInit(hd),
    name: fn_name,
    origin: list_index(state, 0).init,
    params: [],
    ret: None,
  })
  ls_enter_frame(fn_name, [], [], captures_names, zeros_of_len(len(captures_names)), line_base)
  lower_frame_fence_push()
  let stores = map(
    { (i, field) => LStateInit(field.init, hd, nconfig + i, lower_expr(field.init)) },
    enumerate(state)
  )
  lower_handler_pop()
  let lines = ls_exit_frame()
  LDeclareFn(LFn(fn_name, 0, [], stores ++ [LConst(0, LInt(0))], fence, lines))
}

// An op's declared types met at a handler's instance. Inference draws this
// edge for every arm (`unify_op_payload`): the op's own instance unifies with
// the handler's, so a parameter the effect declared `a` IS the handler's
// instance variable. Replayed here as a substitution over the two schemes, it
// lets an arm's header read that variable, which a twin keyed at the instance
// then substitutes; read off the declaration alone, the effect's variable never
// met the twin's pairs, and a Float twin signed a word under a body reading
// f64 (it did not assemble). The arm's parameters have no handles of their
// own to read the edge through.
fn op_instance_subst(op, hd) = match op_scheme_instance(op) {
  None => [],
  Some(oi) => match handler_decl_instance(hd) {
    None => [],
    Some(hi) => spec_pairs_walk(oi, hi, []),
  },
}

fn op_scheme_instance(op) = match published_at(op) {
  Some(entry) => match entry {
    (scheme, _, kind) => match kind {
      EffectOpScheme(_, _, _) => match scheme {
        Frozen(_, TFun(_, _, row)) => op_instance_ty(row),
        Frozen(_, _) | Live(_) => None,
      },
      FnScheme | ConstructorScheme(_, _) | RecordSchemeKind(_) | EffectDeclKind(_, _)
      | HandlerKind(_, _, _, _, _) | ParamScheme(_) | RowAliasKind(_) | TypeVariants(_)
      | HandlerChainKind(_) | ValueScheme | PrimitiveKind(_) => None,
    },
  },
  None => None,
}

// The effect instance a handler declaration's scheme handles.
fn handler_decl_instance(hd) = match graph_published(hd) {
  Some((scheme, _, _)) => match judgment_pair(scheme) {
    (_, sty) => match handler_result_ty(sty) {
      TName(_, [inst, _]) => Some(inst),
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
      | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
      | TAlias(_, _) | TValue(_) => None,
    },
  },
  None => None,
}

fn at_instance(sub, oty) = match oty {
  Some(t) => Some(spec_subst_pairs(t, sub)),
  None => None,
}

fn lower_one_arm_decl(arm: {args: [Node], body: Node, op: Node}, hd, config, state, fence, line_base) = {
  let op_name = handler_arm_op_name(arm)
  let op = handler_arm_op_decl(arm)
  let fn_name = arm_fn_name(hd, op_name)
  // Hβ.first-light.arm-body-fresh-frame: each handler-arm body is
  // its own WASM function with __state IS the handler state record
  // (per PLAN §5.U). The
  // arm body needs a FRESH frame so state-field references (e.g.
  // frames, globals) resolve to LUpval(0..N-1), emitting
  // `(local.get $__state)(i32.load offset=8 + idx*4)` — the
  // canonical closure-record layout.
  //
  // captures_names = config_names ++ state_field_names (sources
  // for closure-record slots at install time). args go as locals
  // (arm fn params at WASM call-arity), with zero handles: the arm's
  // params and captures read their types at their uses.
  let config_names = lower_param_names(config)
  let state_field_names = state_field_names_of(state)
  let captures_names = config_names ++ state_field_names
  let captures_handles = zeros_of_len(len(captures_names))
  // The cardinality, PROJECTED off the op's EffectOpScheme — inference wrote
  // it (draw_op_edges joined every handler arm's resume_grade); lower reads
  // the proven fact live, the way it reads repr off a type or world off a
  // row. Read BEFORE the frame: a MultiShot arm's signature carries the k
  // record as its leading param (the driver pushes (record, k); resume(v)
  // calls __k — band B k1). OneShot arms keep their params, arity, and
  // fence byte-identically (Law 7).
  let disc = op_resume_discipline(op)
  let arg_names = lower_param_names(arm.args)
  let arm_params = match disc {
    MultiShot => ["__k"] ++ arg_names,
    // M4 — the driver pushes (record, k) uniformly; an Abandon arm takes __k and ignores it (it never resumes), returning its value flag-clear so the driver delivers it as the install's
    Abandon => ["__k"] ++ arg_names,
    OneShot => arg_names,
  }
  let locals_handles = zeros_of_len(len(arm_params))
  // The arm's param edges are the OP's declared arg types, read from the
  // same EffectOpScheme entry the discipline came from one line up; the
  // leading __k a MultiShot/Abandon arm carries is the driver's own word
  // and floors. The arm's RESULT depends on who receives it: a OneShot arm
  // is called by the PERFORMER and returns the resumed value, the op's
  // declared R; a MultiShot or Abandon arm returns the handler's answer to
  // its driver, the body's own type. Signing a OneShot arm with the body's
  // type (the answer, S) floored every wide R to a word the performer then
  // read as f64 — a Float op's handler did not assemble. Both are read at the
  // HANDLER's instance (`op_instance_subst`), so a twin keyed there signs the
  // widths its body reads.
  let at_inst = op_instance_subst(op, hd)
  let arm_arg_tys = map(at_instance(at_inst, ??), op_param_tys(op))
  let arm_param_tys = if len(arm_arg_tys) == len(arm.args) {
    match disc {
      MultiShot => floor_tys(1) ++ arm_arg_tys,
      Abandon => floor_tys(1) ++ arm_arg_tys,
      OneShot => arm_arg_tys,
    }
  } else {
    floor_tys(len(arm_params))
  }
  // The enumeration note fires PARENT-BEFORE-CHILD (nested mints note
  // during body lowering below) — the tree order every projected kind
  // shares, so the future enumeration reader walks parents first.
  let arm_ret = match disc {
    MultiShot => Some(lookup_ty(arm.body)),
    Abandon => Some(lookup_ty(arm.body)),
    OneShot => at_instance(at_inst, op_ret_ty(op)),
  }
  graph_emitfn_note(EmitFnEntry{
    caps: [],
    fence,
    kind: EfkArm(op_name, hd),
    name: fn_name,
    origin: arm.body,
    params: zip(arm_params, arm_param_tys),
    ret: arm_ret,
  })
  // The arm's `<~` lines live in the install record past the fence, after
  // the lines of the arms lowered before it (line_base).
  ls_enter_frame(fn_name, arm_params, locals_handles, captures_names, captures_handles, line_base)
  lower_frame_fence_push()
  // An arm that COMMITS state or may RE-DRIVE binds `__hrec` to its own
  // $__state — the install record the driver passed — so every depth
  // reaches it through the ONE ladder: at arm level the LLet local, in a
  // lambda or a nested fn the seeded capture. A
  // held resume re-drives this handler when its remainder performs again
  // (`lower_resume_callk`), and the driver dispatches through the install
  // record, so a re-driving arm needs the ladder whether or not it has
  // state: a stateless handler's lambda had nothing to capture and its
  // redrive trapped (tests/micros/mn-held-resume-stateless-reyield.mn). The
  // bind runs BEFORE body lowering so nested mints resolve it; the LLet
  // materializes it below.
  let hrec =
    if len(captures_names) > 0 || disc_redrives(disc) { Some(ls_bind_local("__hrec", 0)) } else { None }
  // Hβ.first-light.resume-with-state-mutation: install arm_state_ctx
  // around arm body lowering so lower_expr's ResumeExpr arm resolves
  // `with field = NEW` updates' slot offsets via current_state_fields()
  // AND its representation via current_resume_discipline().
  //
  // Hβ.lower.tail-call-mark-pass — handler arm body is in tail. The arm is a
  // frame: a yield its body or its resume meets takes the rest of the arm.
  let lo_body = capture_frame(
    mark_tail({
      let layers = lower_param_destructures(arm.args)
      wrap_param_destructures(layers, lower_expr(arm.body))
    } ~> arm_state_ctx(captures_names, disc, Some(hd))),
    arm_ret
  )
  lower_handler_pop()
  let lines = ls_exit_frame()
  // fence = nstate + total_arms; the arm's LEvPerform reads land on the
  // record's captured-ev region (past state AND arms).
  let body_list = match hrec {
    Some(reg) => [LLet(0, reg, LLocal(0, "__state")), lo_body],
    None => [lo_body],
  }
  let fn_ir = LFn(fn_name, len(arm_params), arm_params, body_list, fence, lines)
  LDeclareFn(fn_ir)
}

// Sum each effect-group's arm-list length — the handler record's total
// arm-slot count, contiguous per effect.
fn sum_group_arm_lens(groups: [{arms: [String], ename: String}]) =
  fold(0, (acc, g) => acc + len(group_arms(g)), groups)

// Extract just the `name` field from each state-fields record.
// Per parse_handler_state_fields, each entry is `{name, init}`, and
// state_field_name / state_field_init live at the record's mint (parser.mn,
// beside it) — one home per truth.
fn state_field_names_of(state: [{init: Node, name: Node}]) = map(state_field_name, state)

// Build a list of n zero handles. Used as the handle-list for arm
// captures and locals where lower-time has no type-handle info.
fn zeros_of_len(n) = map((_) => 0, range(0, n))

// Whether an arm of this discipline may re-drive its handler: a held resume
// (`lower_resume_callk`) calls the k record and, when the remainder performs
// one of this handler's ops again, dispatches it through the install record.
// The same two disciplines give the arm its leading k parameter.
fn disc_redrives(disc) = match disc {
  MultiShot => true,
  Abandon => true,
  OneShot => false,
}

// OneShot resume — the zero-cost stack return, byte-identical to the
// pre-producer floor. No state updates: the value flows straight to
// LReturn (~85% of arms). With updates: the snapshot writeback, reading
// the enclosing arm's state-fields live from the ArmStateContext handler.
fn lower_resume_oneshot(handle, val, state_updates) = if len(state_updates) == 0 {
  LReturn(handle, lower_expr(val))
} else {
  let fields = current_state_fields()
  lower_resume_snapshot(handle, val, state_updates, fields)
}

// The OneShot commit's record home: the arm's own $__state ("" — the
// byte-frozen pre-S1 form; a OneShot resume lowers in the arm frame where
// $__state IS the install record).
//
// ── MultiShot: the reified k (band B k1, continuation-reification codegen) ──
//
// A MultiShot perform never calls the arm — the PERFORMING FRAME yields: its
// remainder-after-the-perform reifies as the continuation record k (handler =
// state = closure = evidence = CONTINUATION, one shape), the install's driver
// binds k to the arm, and resume(v) CALLS the record — N times, it is
// immutable data. The prior producer (deleted here) reified the WRONG side:
// k minted at the RESUME site from the arm's snapshot prologue — the arm
// bound record POINTERS to a/b and nothing ever called them (the measured
// invalid-exit). The capture/world recipe it carried lives on below, at the
// correct side (the perform's frame).
//
// resume(v) in a MultiShot arm = call the k record through the W7 closure
// convention (park k, push k as __state, push v, call_indirect fn_ptr@0).
// The post-call flag check (band B M2b — the owned-op re-dispatch, the
// twice-refuted correction of the bank's "driver re-entry" sketch, which
// ABANDONED the outer arm): a raised flag means the remainder yielded
// again mid-resume. An OWNED op re-enters this handler's own dispatch —
// $op___redrive_<hname>, the install driver's dispatch factored to ONE home —
// and the dispatched arm's return IS this resume's value (the deep-handler
// equation handle(E[perform]) = arm(k = λv. handle(E[v])), independently
// re-derived: pick()+pick()*10 under twice = 66, never the abandonment's
// 32). A FOREIGN op is still flagged after the redrive: the redrive is a
// boundary of the arm's frame, so a live one takes the rest of the arm with
// it and a dead one unwinds the arm (`capture_frame`). The SAME commit prefix
// OneShot uses runs BEFORE the k-call: it binds the value, and with state
// updates (band B M1.5, bank Ruling 4) snapshots them and COMMITS the slot
// stores, and the k-call takes the bound val local (the ev8d race). One
// prefix, two tails.
fn lower_resume_callk(handle, val, state_updates) = {
  let kr = "__kr_{int_to_str(handle)}"
  let kr2 = "__kr2_{int_to_str(handle)}"
  // The commit's record is a value the frame was BORN holding — the __hrec
  // ladder resolves it (arm: the LLet alias of $__state; a lambda or a
  // nested fn minted in the arm: the seeded capture), the same rails as
  // __k. A closure's own $__state is its closure record (the measured
  // 32-not-46 silent state loss, S1's unmasking gate), so the record is
  // CARRIED, never re-read from a bracket-scoped cache a rebind can stale.
  let hrec = resolve_hrec(handle)
  // The resumed value is computed in the arm's world, before the resume
  // enters the remainder's, so a perform it makes resolves outside the
  // install as every perform the arm makes does: the prefix binds it, and
  // with state updates commits them, ahead of the call.
  let fields = if len(state_updates) == 0 { [] } else { current_state_fields() }
  match resume_commit_prefix(handle, val, state_updates, fields, hrec) {
    (prefix, val_name) => LBlock(
      handle,
      prefix ++ [
        LLet(handle, kr, LResumeK(handle, resolve_resume_k(handle), hrec, LLocal(val, val_name))),
        // The redrive dispatches the remainder's re-yield of this
        // handler's OWN op to the arm, so a flag still raised after it is
        // a yield the arm's run raised outward — a FOREIGN op, or the
        // arm's own perform — and the frame's check after the redrive is
        // where the arm meets it.
        LLet(
          handle,
          kr2,
          LIf(
            handle,
            LGlobal(handle, Synthesized("yield_flag")),
            [redrive_perform(handle, kr)],
            [LLocal(handle, kr)]
          )
        ),
        LLocal(handle, kr2)
      ]
    ),
  }
}

// The redrive a held resume calls when its remainder yields again: the
// enclosing arm's handler's (`current_arm_handler`). A resume outside every
// arm was refused at the judgment (E_ResumeOutsideArm), so a context with no
// arm is the impossible branch's typed floor, never a call.
fn redrive_perform(handle, kr: String) = match current_arm_handler() {
  Some(hd) => LPerform(handle, PdDriver(hd, resolve_hrec(handle)), [LLocal(handle, kr)]),
  None => LInvariantFailure(handle, ResumeKOutsideLadder),
}

// drift-audit: ignore — one-shot stmt-list concat, no loop
//
// The resume-resolution LADDER (band B M1.6, bank Ruling 2 as amended by
// A3) — the k is a value the frame was born holding, never evidence:
//   lexical  — "__k" is the arm's own leading param (the k1 fast path).
//   capture  — "__k" was captured into the record of a lambda or a nested
//              fn minted inside the arm (`lower_seed_k`) — the LUpval
//              read, N frames deep.
// A resume whose "__k" resolves NEITHER way is E_ResumeOutsideArm at
// infer (the armed class), so the remaining two shapes are the
// impossible branch — the typed loud floor, never a fabricated k.
//
// Merge "__k" into a closure mint's free set when a k is lexically in
// scope (the arm's param or an enclosing capture) — read through the SAME
// ls_resolve ladder the resumes use.
fn lower_seed_k(free_uses) = match ls_resolve("__k") {
  (res, _lh) => match res {
    RLocal(_) => free_uses_merge([("__k", 0)], free_uses),
    RUpval(_) => free_uses_merge([("__k", 0)], free_uses),
    RGlobal | RFbPrior(_) => free_uses,
  },
}

// __hrec rides the same rule — the commit's record threads to closures
// exactly as the k does: one ladder, both values the frame was born
// holding. Where no stateful arm encloses the mint, the seed adds nothing.
fn lower_seed_hrec(free_uses) = match ls_resolve("__hrec") {
  (res, _lh) => match res {
    RLocal(_) => free_uses_merge([("__hrec", 0)], free_uses),
    RUpval(_) => free_uses_merge([("__hrec", 0)], free_uses),
    RGlobal | RFbPrior(_) => free_uses,
  },
}

// The commit's record, resolved through the SAME ladder as the k (the
// record is an ARGUMENT or a CAPTURE, never a global): the arm frame
// binds `__hrec` as an LLet alias of its own $__state (the record the
// driver passed), and a lambda or a nested fn minted inside the arm
// captures it (lower_seed_hrec). The unresolved arms fall back to the
// frame's own $__state — sound exactly where no __hrec was ever minted,
// because a frame with commits and no binding IS the record's owner (the
// arm-level identity).
fn resolve_hrec(handle) = match ls_resolve("__hrec") {
  (res, _lh) => match res {
    RLocal(reg) => LLocal(0, reg),
    RUpval(slot) => LUpval(0, slot),
    RFbPrior(_) => LLocal(0, "__state"),
    RGlobal => LLocal(0, "__state"),
  },
}

// The k is a WORD — the continuation record's pointer — read at handle 0 as
// the record `__hrec` is, whatever the resume node is typed: since the
// answer rides the handler's type (2026-10-03) a resume's node is the
// install's answer, and naming the k local at that node declared `$__k.f64`
// under a Float answer where the arm's parameter is `$__k`.
fn resolve_resume_k(handle) = match ls_resolve("__k") {
  (res, _lh) => match res {
    RLocal(reg) => LLocal(0, reg),
    RUpval(slot) => LUpval(0, slot),
    RFbPrior(_) => LInvariantFailure(handle, ResumeKOutsideLadder),
    RGlobal => LInvariantFailure(handle, ResumeKOutsideLadder),
  },
}

// A CONTINUATION IS CAPTURED AT ANY POSITION. A frame — a function's body, a
// lambda's, an arm's, an install's or an arena's — is lowered whole, then read
// once for the places a yield may leave it. A boundary off the frame's
// terminus is checked where it returns, and a raised flag means the frame is
// done. A boundary a LIVE continuation may cross — a multi-shot perform, or a
// call, perform, install or resume whose row may carry one — first composes
// the frame's remainder onto the continuation: the frame's own lowered tree
// zipped at the boundary (what ran before it dropped, the branch it stands in
// kept alone, its value the hole), every value the remainder reads from
// before the boundary captured into its record. The tree states the order the
// frame runs its parts in, so the remainder runs exactly what the frame had
// left, and a part that ran before the boundary and is read after it is bound
// to a register first (`cp_node`). One function per boundary, declared at the
// boundary and minted again by every remainder that reaches the boundary from
// a scope of its own. `ret` is what the frame's function returns.
fn capture_frame(body, ret) = if ls_program_may_yield() { frame_captured(body, ret) } else { body }

// One frame: its boundaries checked, then each live one's remainder read
// out of the checked tree, the records filled from the frame's scope, and
// each remainder declared at its boundary.
fn frame_captured(body, ret) = {
  let root = lexpr_handle(body)
  match cp_checked(root, body, true) {
    (checked, _) => {
      let sites = boundary_sites(checked)
      if len(sites) == 0 {
        checked
      } else {
        let found = map(site_capture(checked, ??), sites)
        let filled = site_tree(SwFill(found), checked)
        site_tree(SwDeclare(map(remainder_fn(filled, ret, ??), found)), filled)
      }
    },
  }
}

// A live boundary's remainder: its function's name, the boundary's handle
// (the hole the remainder takes), what it reads from before the boundary,
// and the frame's `<~` lines it ticks.
type Capture = Capture(String, Int, [Cap], [(Int, Int, LineHome)])

// A value a remainder reads from before its boundary: a local of the frame,
// a capture of the frame's own record, or the prior a `<~` cycle loaded.
type Cap = CapLocal(String, Int) | CapUpval(Int, Int) | CapPrior(Int)

// The boundaries checked, top-down with whether the position is the frame's
// terminus — where the value is the frame's own, so a yield leaves through
// the frame's return or its landing and needs no check. The second half of
// the answer says whether the subtree holds a live boundary of THIS frame,
// which is what makes its parent bind what ran before it.
fn cp_checked(root, e, terminus) = match e {
  LYield(h, op, args, _) => match cp_node(root, LYield(h, op, args, k_site(root, h))) {
    (walked, _) => (walked, true),
  },
  LCall(h, f, _) => match cp_node(root, e) {
    (walked, inside) => cp_check(
      root,
      h,
      walked,
      inside,
      !terminus && can_yield(lexpr_handle(f)),
      call_may_yield_live(lexpr_handle(f))
    ),
  },
  LDirectCall(h, fh, _, t, _) => match cp_node(root, e) {
    (walked, inside) => cp_check(root, h, walked, inside, !t && !terminus && can_yield(fh), call_may_yield_live(fh)),
  },
  LPerform(h, d, _) => match cp_node(root, e) {
    (walked, inside) => match perform_op_name(d) {
      Some(op) => cp_check(root, h, walked, inside, !terminus && ls_unwinding_op(op), ls_live_op(op)),
      // a held resume's re-drive, which hands back the foreign yield its
      // remainder raised, a live one included
      None => cp_check(root, h, walked, inside, !terminus, true),
    },
  },
  // The body is a frame of its own, whose yields the install's landing
  // meets; the install is this frame's boundary for what its driver bubbles.
  LHandleWith(h, b, hn, hd, inits, an) => match cp_node(
    root,
    LHandleWith(h, frame_captured(b, Some(lookup_ty(lexpr_handle(b)))), hn, hd, inits, an)
  ) {
    (walked, inside) => cp_check(
      root,
      h,
      walked,
      inside,
      !terminus && subtree_may_yield_by(h, effect_has_multishot_op),
      subtree_may_yield_by(h, effect_has_live_op)
    ),
  },
  LArena(h, b) => cp_check(
    root,
    h,
    LArena(h, frame_captured(b, Some(lookup_ty(lexpr_handle(b))))),
    false,
    !terminus && arena_may_yield(h),
    arena_may_yield_live(h)
  ),
  // the reading brackets nothing: its body's value lands where its own does
  LDerive(h, seed, b) => match cp_checked(root, b, terminus) {
    (b2, inside) => (LDerive(h, seed, b2), inside),
  },
  LReturn(h, x) => match cp_checked(root, x, true) {
    (x2, inside) => (LReturn(h, x2), inside),
  },
  LBlock(h, stmts) => match cp_last(root, stmts, terminus) {
    (stmts2, inside) => (LBlock(h, stmts2), inside),
  },
  LIf(h, c, t, el) => match (cp_checked(root, c, false), cp_last(root, t, terminus), cp_last(root, el, terminus)) {
    ((c2, ic), (t2, it), (e2, ie)) => (LIf(h, c2, t2, e2), ic || it || ie),
  },
  LMatch(h, s, arms) => match cp_checked(root, s, false) {
    (s2, is) => {
      let walked = map(cp_arm(root, terminus, ??), arms)
      (LMatch(h, s2, map({ (pat, (b, _)) => (pat, b) }, walked)), is || any({ (_, (_, l)) => l }, walked))
    },
  },
  LLet(h, n, init) => match cp_checked(root, init, false) {
    (i2, inside) => (LLet(h, n, i2), inside),
  },
  // every schedule's form stands where the fanout does
  LFanout(h, lex, br, forms) => {
    let walked = map(cp_form(root, terminus, ??), forms)
    (LFanout(h, lex, br, map({ (s, (f, _)) => (s, f) }, walked)), any({ (_, (_, l)) => l }, walked))
  },
  // the tick follows the body, so the body is never the terminus
  LFeedback(fh, d, home, b, s) => match cp_checked(root, b, false) {
    (b2, inside) => (LFeedback(fh, d, home, b2, s), inside),
  },
  LCheck(_, _, _) => (e, false),
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LUpval(_, _) | LFeedbackPrior(_) | LDeclareFn(_)
  | LInvariantFailure(_, _) => (e, false),
  LBinOp(_, _, _, _) | LUnaryOp(_, _, _) | LTailCall(_, _, _) | LMakeClosure(_, _, _)
  | LAbandon(_, _, _) | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _) | LMakeRecord(_, _)
  | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _) | LResumeK(_, _, _, _) | LFieldLoad(_, _, _)
  | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _)
  | LWasiCall(_, _, _) => cp_node(root, e),
}

// A sequence's members checked in order, the last at the sequence's terminus.
fn cp_last(root, stmts, terminus) = {
  let n = len(stmts)
  let walked =
    map({ (i, s) => cp_checked(root, s, if i == n - 1 { terminus } else { false }) }, enumerate(stmts))
  (map({ (x, _) => x }, walked), any({ (_, l) => l }, walked))
}

fn cp_arm(root, terminus, arm) = match arm {
  (pat, body) => (pat, cp_checked(root, body, terminus)),
}

fn cp_form(root, terminus, form) = match form {
  (s, f) => (s, cp_checked(root, f, terminus)),
}

// A boundary's check where it needs one: the value parked, and at a raised
// flag the frame done — a live continuation first takes the frame's
// remainder, minted at this boundary.
fn cp_check(root, h, walked, inside, checks, live) = if checks {
  let mints = live && h != 0
  (LCheck(h, walked, if mints { Some(k_site(root, h)) } else { None }), inside || mints)
} else {
  (walked, inside)
}

// The site a live boundary mints at, its record filled once the frame's
// remainders are read.
fn k_site(root, h) = KSite(KRef("__k_{int_to_str(root)}_{int_to_str(h)}"), [], [])

// A node that runs its children in order and combines what they answer:
// each child checked, and when one holds a live boundary every child up to
// it is bound to a register first, so the remainder captured inside reads
// what ran before instead of running it again.
fn cp_node(root, e) = {
  let walked = map(cp_checked(root, ??, false), pass_kids(e))
  let kids = map({ (x, _) => x }, walked)
  match last_live(walked) {
    Some(k) => (spill_through(e, kids, k), true),
    None => (pass_rebuild(e, kids), false),
  }
}

fn last_live(walked) = fold(None, live_at, enumerate(walked))

fn live_at(acc, child) = match child {
  (i, (_, l)) => if l { Some(i) } else { acc },
}

// The children up to the live one's, each bound to a register of its own in
// the order they run, and the node rebuilt over the reads.
fn spill_through(e, kids, k) = {
  let h = lexpr_handle(e)
  let parts = map(spill_part(h, k, ??), enumerate(kids))
  LBlock(
    h,
    flat_map({ (lets, _) => lets }, parts) ++ [pass_rebuild(e, map({ (_, read) => read }, parts))]
  )
}

fn spill_part(h, k, indexed) = match indexed {
  (i, c) => if i > k {
    ([], c)
  } else {
    let ch = lexpr_handle(c)
    let t = "__t_{int_to_str(h)}_{int_to_str(i)}_{int_to_str(ch)}"
    ([LLet(ch, t, c)], LLocal(ch, t))
  },
}

// Whether a call may hand back a LIVE continuation: its callee's row may
// carry an effect whose handler resumes. A callee the judgment typed as no
// function proves nothing about one, and its check unwinds what it carries.
fn call_may_yield_live(callee_h) = ls_program_may_yield() && ty_may_yield_live(lookup_ty(callee_h))

fn ty_may_yield_live(t) = match t {
  TFun(_, _, row) => row_may_yield_by(row, effect_has_live_op),
  TAlias(_, inner) => ty_may_yield_live(inner),
  TRefined(inner, _) => ty_may_yield_live(inner),
  TReprPin(_, inner) => ty_may_yield_live(inner),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TCont(_, _, _, _) | TValue(_) => false,
}

// The expressions a node runs in its own frame, in the order it runs them —
// the one enumeration (`frame_children`) but where the pass reads a frame
// differently: an install's and an arena's bodies are frames of their own,
// each schedule's form of a fanout is a way this frame may run it, and a
// re-drive evaluates the record it dispatches through.
fn pass_kids(e) = match e {
  LHandleWith(_, _, hn, _, inits, _) => [hn] ++ inits,
  LArena(_, _) => [],
  LFanout(_, _, _, forms) => map({ (_, f) => f }, forms),
  LPerform(_, d, args) => dispatch_kids(d) ++ args,
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
  | LDeclareFn(_) | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _)
  | LSimdLanes(_, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _)
  | LMatch(_, _, _) | LResumeK(_, _, _, _) | LDerive(_, _, _) | LFeedback(_, _, _, _, _)
  | LFeedbackPrior(_) | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _)
  | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => frame_children(e),
}

// A node rebuilt over new children, in `pass_kids`' order.
fn pass_rebuild(e, kids) = match e {
  LConst(_, _) => e,
  LLocal(_, _) => e,
  LGlobal(_, _) => e,
  LLet(h, n, _) => LLet(h, n, list_index(kids, 0)),
  LUpval(_, _) => e,
  LBinOp(h, op, _, _) => LBinOp(h, op, list_index(kids, 0), list_index(kids, 1)),
  LUnaryOp(h, op, _) => LUnaryOp(h, op, list_index(kids, 0)),
  LCall(h, _, _) => LCall(h, list_index(kids, 0), rest(kids)),
  LTailCall(h, _, _) => LTailCall(h, list_index(kids, 0), rest(kids)),
  LDirectCall(h, fh, n, t, _) => LDirectCall(h, fh, n, t, kids),
  LReturn(h, _) => LReturn(h, list_index(kids, 0)),
  LMakeClosure(h, f, _) => LMakeClosure(h, f, kids),
  LYield(h, op, args, site) => LYield(h, op, take(len(args), kids), site_with_caps(site, drop(len(args), kids))),
  LCheck(h, _, site) => LCheck(h, list_index(kids, 0), opt_site_with_caps(site, rest(kids))),
  LAbandon(h, op, _) => LAbandon(h, op, kids),
  LDeclareFn(_) => e,
  LIf(h, _, t, _) => LIf(h, list_index(kids, 0), slice(kids, 1, 1 + len(t)), drop(1 + len(t), kids)),
  LBlock(h, _) => LBlock(h, kids),
  LMakeList(h, _) => LMakeList(h, kids),
  LMakeTuple(h, _) => LMakeTuple(h, kids),
  LSimdLanes(h, _) => LSimdLanes(h, kids),
  LFanout(h, lex, br, forms) => LFanout(h, lex, br, zip_with(form_with, forms, kids)),
  LMakeRecord(h, _) => LMakeRecord(h, kids),
  LRecordUpdate(h, _, ws) => update_from_parts(h, ws, kids),
  LMakeVariant(h, t, _) => LMakeVariant(h, t, kids),
  LMatch(h, _, arms) => LMatch(h, list_index(kids, 0), zip_with(arm_with, arms, rest(kids))),
  LResumeK(h, _, _, _) => LResumeK(h, list_index(kids, 0), list_index(kids, 1), list_index(kids, 2)),
  LHandleWith(h, b, _, hd, _, an) => LHandleWith(h, b, list_index(kids, 0), hd, rest(kids), an),
  LDerive(h, _, _) => LDerive(h, list_index(kids, 0), list_index(kids, 1)),
  LArena(_, _) => e,
  LFeedback(h, d, home, _, _) => LFeedback(h, d, home, list_index(kids, 0), list_index(kids, 1)),
  LFeedbackPrior(_) => e,
  LPerform(h, d, _) => LPerform(h, dispatch_with(d, kids), drop(len(dispatch_kids(d)), kids)),
  LFieldLoad(h, _, sel) => LFieldLoad(h, list_index(kids, 0), sel),
  LPrim(h, p, _) => LPrim(h, p, kids),
  LStateSlotStore(h, o, _, _) => LStateSlotStore(h, o, list_index(kids, 0), list_index(kids, 1)),
  LStateInit(h, hd, s, _) => LStateInit(h, hd, s, list_index(kids, 0)),
  LShow(h, _) => LShow(h, list_index(kids, 0)),
  LHash(h, _) => LHash(h, list_index(kids, 0)),
  LInvariantFailure(_, _) => e,
  LWasiCall(h, n, _) => LWasiCall(h, n, kids),
}

fn site_caps(site) = match site {
  KSite(_, caps, _) => caps,
}

fn opt_site_caps(site) = match site {
  Some(s) => site_caps(s),
  None => [],
}

fn site_with_caps(site, caps) = match site {
  KSite(kfn, _, lines) => KSite(kfn, caps, lines),
}

fn opt_site_with_caps(site, caps) = match site {
  Some(s) => Some(site_with_caps(s, caps)),
  None => None,
}

fn site_name(site) = match site {
  KSite(kfn, _, _) => kfn_name(kfn),
}

fn site_lines(site) = match site {
  KSite(_, _, lines) => lines,
}

fn kfn_name(kfn) = match kfn {
  KDef(LFn(n, _, _, _, _, _)) => n,
  KRef(n) => n,
}

fn form_with(form, f) = match form {
  (s, _) => (s, f),
}

fn arm_with(arm, body) = match arm {
  (pat, _) => (pat, body),
}

// A driver's record is an expression the re-drive evaluates; a dispatch the
// lowering resolved evaluates none.
fn dispatch_kids(d) = match d {
  PdDriver(_, rec) => [rec],
  PdFrame(_, _, _) => [],
  PdWalk(_, _, _, _) => [],
}

fn dispatch_with(d, kids) = match d {
  PdDriver(hd, _) => PdDriver(hd, list_index(kids, 0)),
  PdFrame(_, _, _) => d,
  PdWalk(_, _, _, _) => d,
}

// What a walk over a frame's live boundaries does with each: finds it, fills
// its record from the frame's scope, or declares its remainder there.
type SiteMode = SwFind | SwFill([Capture]) | SwDeclare([LowFn])

fn boundary_sites(e) = match site_walk(SwFind, e) {
  (_, found) => found,
}

fn site_tree(mode, e) = match site_walk(mode, e) {
  (t, _) => t,
}

// The frame's live boundaries in the order its tree holds them. The walk
// stays in the frame: a minted function's body, an install's and an arena's
// are frames of their own, whose sites their own pass answered.
fn site_walk(mode, e) = match e {
  LYield(h, op, args, site) => match site_walk_list(mode, args) {
    (args2, found) => match site_at(mode, h, site) {
      (site2, here) => (LYield(h, op, args2, site2), found ++ here),
    },
  },
  LCheck(h, inner, site) => match site_walk(mode, inner) {
    (inner2, found) => match site {
      Some(s) => match site_at(mode, h, s) {
        (s2, here) => (LCheck(h, inner2, Some(s2)), found ++ here),
      },
      None => (LCheck(h, inner2, None), found),
    },
  },
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LReturn(_, _) | LMakeClosure(_, _, _) | LAbandon(_, _, _) | LDeclareFn(_) | LIf(_, _, _, _)
  | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _) | LFanout(_, _, _, _)
  | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _) | LMatch(_, _, _)
  | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _) | LArena(_, _)
  | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _) | LFieldLoad(_, _, _)
  | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _)
  | LInvariantFailure(_, _) | LWasiCall(_, _, _) => match site_walk_list(mode, pass_kids(e)) {
    (kids, found) => (pass_rebuild(e, kids), found),
  },
}

fn site_walk_list(mode, es) = fold(([], []), site_walk_step(mode, ??, ??), es)

fn site_walk_step(mode, acc, x) = match acc {
  (out, found) => match site_walk(mode, x) {
    (x2, more) => (push(out, x2), found ++ more),
  },
}

fn site_at(mode, h, site) = match site {
  KSite(kfn, caps, lines) => match mode {
    SwFind => (site, [(kfn_name(kfn), h)]),
    SwFill(found) => match find({ c => capture_name(c) == kfn_name(kfn) }, found) {
      Some(c) => (KSite(kfn, capture_reads(c), capture_lines(c)), []),
      None => (site, []),
    },
    SwDeclare(fns) => match find({ f => kfn_name(KDef(f)) == kfn_name(kfn) }, fns) {
      Some(f) => (KSite(KDef(f), caps, lines), []),
      None => (site, []),
    },
  },
}

fn capture_name(c) = match c {
  Capture(n, _, _, _) => n,
}

// A record's captures, read where the frame mints it.
fn capture_reads(c) = match c {
  Capture(_, _, caps, _) => map(cap_read, caps),
}

// A record's lines, after its captures and its world: each the line the
// frame owns, shared into the record where the frame mints it.
fn capture_lines(c) = match c {
  Capture(_, _, caps, lines) => map(
    {
      (j, line) => match line {
        (fh, d, home) => (fh, d, LhShare(len(caps) + 1 + j, home)),
      },
    },
    enumerate(lines)
  ),
}

fn cap_read(cap) = match cap {
  CapLocal(n, h) => LLocal(h, n),
  CapUpval(slot, h) => LUpval(h, slot),
  CapPrior(fh) => LFeedbackPrior(fh),
}

fn cap_handle(cap) = match cap {
  CapLocal(_, h) => h,
  CapUpval(_, h) => h,
  CapPrior(fh) => fh,
}

fn cap_key(cap) = match cap {
  CapLocal(n, _) => "l{n}",
  CapUpval(slot, _) => "u{int_to_str(slot)}",
  CapPrior(fh) => "p{int_to_str(fh)}",
}

// The name and type handle the enumeration entry carries for a capture.
fn cap_entry(cap) = match cap {
  CapLocal(n, h) => (n, h),
  CapUpval(slot, h) => ("__up_{int_to_str(slot)}", h),
  CapPrior(fh) => ("__prior_{int_to_str(fh)}", fh),
}

fn cap_added(caps, cap) =
  if any({ c => cap_key(c) == cap_key(cap) }, caps) { caps } else { push(caps, cap) }

fn cap_at_key(key: String, slot) = match slot {
  (_, c) => cap_key(c) == key,
}

fn ring_added(lines, line) = match line {
  (fh, _, _) => if any({ (g, _, _) => g == fh }, lines) { lines } else { push(lines, line) },
}

// Where a `<~` line lives in a remainder's record: after its captures and its
// world, in the order the remainder found the lines.
fn k_home(caps, lines, fh) = match find(line_at(fh, ??), enumerate(lines)) {
  Some((j, (_, _, home))) => LhShare(len(caps) + 1 + j, home),
  None => LhSlot(len(caps)),
}

fn line_at(fh, slot) = match slot {
  (_, (g, _, _)) => g == fh,
}

// A boundary's remainder, zipped out of the checked tree, and what it reads
// from before the boundary.
fn site_capture(checked, site) = match site {
  (name, h) => {
    let hole = "{name}_in"
    match zip_at(checked, name, LLocal(h, hole)) {
      Some((rem, onpath)) => match ref_walk(Collecting, rem, ref_scope(hole, onpath)) {
        (_, sc) => Capture(name, h, sc.caps, sc.lines),
      },
      None => Capture(name, h, [], []),
    }
  },
}

// The function a boundary's remainder runs: the frame zipped at the
// boundary out of the filled tree, each read of what ran before it turned
// into a read of the record, its one parameter the boundary's value.
fn remainder_fn(filled, ret, cap) = match cap {
  Capture(name, h, caps, lines) => {
    let hole = "{name}_in"
    let body = match zip_at(filled, name, LLocal(h, hole)) {
      Some((rem, onpath)) => match ref_walk(Converting(caps, lines), rem, ref_scope(hole, onpath)) {
        (converted, _) => converted,
      },
      None => LInvariantFailure(h, RemainderLost(h)),
    }
    graph_emitfn_note(EmitFnEntry{
      caps: map(cap_entry, caps),
      fence: len(caps),
      kind: EfkK,
      name,
      origin: h,
      params: [(hole, Some(lookup_ty(h)))],
      ret,
    })
    LFn(name, 1, [hole], [body], len(caps), [])
  },
}

// The frame's remainder at the boundary `name`: the tree above it with what
// ran before the boundary dropped — a block's earlier statements, an `if`'s
// condition and its other branch, a `match`'s scrutinee and its other arms —
// and the boundary's value read from the hole. A `<~` cycle the boundary
// stands in keeps its tick, and its prior was loaded before the boundary, so
// the second half of the answer names each such cycle, whose prior the
// remainder reads from its record.
fn zip_at(e, name, hole) = match e {
  LYield(_, _, _, site) => if site_name(site) == name { Some((hole, [])) } else { zip_kids(e, name, hole) },
  LCheck(h, inner, site) => if opt_site_name(site) == name {
    Some((hole, []))
  } else {
    match zip_at(inner, name, hole) {
      Some((r, fb)) => Some((LCheck(h, r, site), fb)),
      None => None,
    }
  },
  LBlock(h, stmts) => zip_from(h, stmts, name, hole),
  LLet(h, n, init) => match zip_at(init, name, hole) {
    Some((r, fb)) => Some((LLet(h, n, r), fb)),
    None => None,
  },
  LIf(h, c, t, el) => match zip_at(c, name, hole) {
    Some((r, fb)) => Some((LIf(h, r, t, el), fb)),
    None => match zip_from(h, t, name, hole) {
      Some(x) => Some(x),
      None => zip_from(h, el, name, hole),
    },
  },
  LMatch(h, s, arms) => match zip_at(s, name, hole) {
    Some((r, fb)) => Some((LMatch(h, r, arms), fb)),
    None => arms |> find_map(zip_arm(name, hole, ??)),
  },
  LReturn(h, x) => match zip_at(x, name, hole) {
    Some((r, fb)) => Some((LReturn(h, r), fb)),
    None => None,
  },
  LFeedback(fh, d, home, b, s) => match zip_at(b, name, hole) {
    Some((r, fb)) => Some((LFeedback(fh, d, home, r, s), [fh] ++ fb)),
    None => None,
  },
  // the fanout ran the form the boundary stands in, in this frame
  LFanout(_, _, _, forms) => forms |> find_map(zip_form(name, hole, ??)),
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LMakeClosure(_, _, _) | LAbandon(_, _, _) | LDeclareFn(_) | LMakeList(_, _) | LMakeTuple(_, _)
  | LSimdLanes(_, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _)
  | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _) | LArena(_, _)
  | LFeedbackPrior(_) | LPerform(_, _, _) | LFieldLoad(_, _, _) | LPrim(_, _, _)
  | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _)
  | LInvariantFailure(_, _) | LWasiCall(_, _, _) => zip_kids(e, name, hole),
}

fn opt_site_name(site) = match site {
  Some(s) => site_name(s),
  None => "",
}

// A sequence zipped at the member the boundary stands in: the members after
// it kept, the ones before it dropped.
fn zip_from(h, list, name, hole) = enumerate(list) |> find_map(zip_member(h, list, name, hole, ??))

fn zip_member(h, list, name, hole, member) = match member {
  (i, m) => match zip_at(m, name, hole) {
    Some((r, fb)) => Some((LBlock(h, [r] ++ drop(i + 1, list)), fb)),
    None => None,
  },
}

fn zip_arm(name, hole, arm) = zip_at(match_arm_body(arm), name, hole)

fn zip_form(name, hole, form) = match form {
  (_, f) => zip_at(f, name, hole),
}

// A node zipped at the child the boundary stands in, the others kept: what
// ran before it is a register the frame bound, or a read the remainder takes
// again.
fn zip_kids(e, name, hole) = {
  let kids = pass_kids(e)
  enumerate(kids) |> find_map(zip_kid(e, kids, name, hole, ??))
}

fn zip_kid(e, kids, name, hole, kid) = match kid {
  (i, k) => match zip_at(k, name, hole) {
    Some((r, fb)) => Some((pass_rebuild(e, take(i, kids) ++ [r] ++ drop(i + 1, kids)), fb)),
    None => None,
  },
}

// What a walk over a remainder does with a read of what ran before its
// boundary: notes it, or reads it from the record.
type RefMode = Collecting | Converting([Cap], [(Int, Int, LineHome)])

// The scope a remainder is read in: its hole bound, and the `<~` cycles it
// stands inside, whose priors it reads from the record.
fn ref_scope(hole: String, onpath) =
  {bound: [hole], caps: [], fb: [], installs: [], lines: [], onpath}

// What a remainder reads from before its boundary, found or turned into
// reads of its record. The scope holds what the remainder has bound so far:
// a block's locals (each block's lets are bound for all of it, since a run of
// closure bindings is minted together and reads one another, and a register
// is never set twice while it is live), the priors of the cycles that load
// one inside it, and the installs it makes; a read of anything else was bound
// before the boundary.
fn ref_walk(mode, e, sc) = match e {
  LLocal(h, n) => if string_in_list(sc.bound, n) { (e, sc) } else { ref_outer(mode, e, CapLocal(n, h), sc) },
  LUpval(h, slot) => ref_outer(mode, e, CapUpval(slot, h), sc),
  LFeedbackPrior(fh) => if any({ g => g == fh }, sc.fb) { (e, sc) } else { ref_outer(mode, e, CapPrior(fh), sc) },
  LFeedback(fh, d, home, b, s) => {
    let sc1 = match mode {
      Collecting => {...sc, lines: ring_added(sc.lines, (fh, d, home))},
      Converting(_, _) => sc,
    }
    let inner = if any({ g => g == fh }, sc1.onpath) { sc1.fb } else { sc1.fb ++ [fh] }
    match ref_walk(mode, b, {...sc1, fb: inner}) {
      (b2, sc2) => match ref_walk(mode, s, {...sc2, fb: sc1.fb}) {
        (s2, sc3) => (LFeedback(fh, d, ref_home(mode, fh, home), b2, s2), sc3),
      },
    }
  },
  LBlock(h, stmts) => match ref_list(mode, stmts, {...sc, bound: sc.bound ++ flat_map(let_binds, stmts)}) {
    (stmts2, sc2) => (LBlock(h, stmts2), sc2),
  },
  LLet(h, n, init) => match ref_walk(mode, init, sc) {
    (i2, sc2) => (LLet(h, n, i2), {...sc2, bound: sc2.bound ++ [n]}),
  },
  LIf(h, c, t, el) => match ref_walk(mode, c, sc) {
    (c2, sc1) => match ref_branch(mode, t, sc1) {
      (t2, sc2) => match ref_branch(mode, el, sc2) {
        (e2, sc3) => (LIf(h, c2, t2, e2), sc3),
      },
    },
  },
  LMatch(h, s, arms) => match ref_walk(mode, s, sc) {
    (s2, sc1) => match ref_arms(mode, arms, sc1) {
      (arms2, sc2) => (LMatch(h, s2, arms2), sc2),
    },
  },
  LHandleWith(h, b, hn, hd, inits, an) => match ref_list(mode, [hn] ++ inits, sc) {
    (kids, sc1) => match ref_walk(mode, b, {...sc1, installs: sc1.installs ++ [h]}) {
      (b2, sc2) => (
        LHandleWith(h, b2, list_index(kids, 0), hd, rest(kids), an),
        {...sc2, bound: sc1.bound, installs: sc1.installs}
      ),
    },
  },
  LArena(h, b) => match ref_walk(mode, b, sc) {
    (b2, sc2) => (LArena(h, b2), {...sc2, bound: sc.bound}),
  },
  LPerform(h, d, args) => match ref_list(mode, dispatch_kids(d) ++ args, sc) {
    (kids, sc2) => (
      LPerform(h, ref_dispatch(mode, dispatch_with(d, kids), sc), drop(len(dispatch_kids(d)), kids)),
      sc2
    ),
  },
  LYield(h, op, args, site) => match ref_list(mode, args, sc) {
    (args2, sc1) => match ref_site(mode, site, sc1) {
      (site2, sc2) => (LYield(h, op, args2, site2), sc2),
    },
  },
  LCheck(h, inner, site) => match ref_walk(mode, inner, sc) {
    (inner2, sc1) => match site {
      Some(s) => match ref_site(mode, s, sc1) {
        (s2, sc2) => (LCheck(h, inner2, Some(s2)), sc2),
      },
      None => (LCheck(h, inner2, None), sc1),
    },
  },
  LFanout(h, lex, br, forms) => match ref_forms(mode, forms, sc) {
    (forms2, sc2) => (LFanout(h, lex, br, forms2), sc2),
  },
  LConst(_, _) | LGlobal(_, _) | LBinOp(_, _, _, _) | LUnaryOp(_, _, _) | LCall(_, _, _)
  | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _) | LReturn(_, _) | LMakeClosure(_, _, _)
  | LAbandon(_, _, _) | LDeclareFn(_) | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _)
  | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _) | LResumeK(_, _, _, _)
  | LDerive(_, _, _) | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _)
  | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => match ref_list(mode, pass_kids(e), sc) {
    (kids, sc2) => (pass_rebuild(e, kids), sc2),
  },
}

// A read of what ran before the boundary: noted, or read from the record.
fn ref_outer(mode, e, cap, sc) = match mode {
  Collecting => (e, {...sc, caps: cap_added(sc.caps, cap)}),
  Converting(caps, _) => match find(cap_at_key(cap_key(cap), ??), enumerate(caps)) {
    Some((slot, _)) => (LUpval(cap_handle(cap), slot), sc),
    None => (LInvariantFailure(cap_handle(cap), CaptureLost(cap_handle(cap))), sc),
  },
}

fn ref_home(mode, fh, home) = match mode {
  Collecting => home,
  Converting(caps, lines) => k_home(caps, lines, fh),
}

// An install the remainder does not make is reached through the world the
// record froze, never the frame's register for it.
fn ref_dispatch(mode, d, sc) = match mode {
  Collecting => d,
  Converting(_, _) => match d {
    PdFrame(ih, _, op) => if any({ i => i == ih }, sc.installs) { d } else { perform_dispatch_of(op, None) },
    PdWalk(_, _, _, _) => d,
    PdDriver(_, _) => d,
  },
}

// A boundary inside the remainder mints its own remainder again, from the
// remainder's scope: its captures read there, and each line it shares the
// remainder's own share of that line.
fn ref_site(mode, site, sc) = match site {
  KSite(kfn, caps, lines) => match ref_list(mode, caps, sc) {
    (caps2, sc2) => match mode {
      Collecting => (KSite(kfn, caps2, lines), sc2),
      Converting(kc, kl) => (KSite(KRef(kfn_name(kfn)), caps2, map(line_shared_from(kc, kl, ??), lines)), sc2),
    },
  },
}

fn line_shared_from(kc, kl, line) = match line {
  (fh, d, home) => match home {
    LhShare(slot, _) => (fh, d, LhShare(slot, k_home(kc, kl, fh))),
    LhSlot(_) => line,
    LhStatic => line,
    LhStaticJvp => line,
  },
}

fn ref_list(mode, es, sc) = fold(([], sc), ref_step(mode, ??, ??), es)

fn ref_step(mode, acc, x) = match acc {
  (out, s) => match ref_walk(mode, x, s) {
    (x2, s2) => (push(out, x2), s2),
  },
}

// A branch binds for itself: what its blocks bind is gone after it.
fn ref_branch(mode, list, sc) = match ref_list(mode, list, {...sc, bound: sc.bound ++ flat_map(let_binds, list)}) {
  (list2, sc2) => (list2, {...sc2, bound: sc.bound}),
}

fn ref_arms(mode, arms, sc) = fold(([], sc), ref_arm(mode, ??, ??), arms)

// An arm binds for itself: what its pattern binds is gone after it.
fn ref_arm(mode, acc, arm) = match (acc, arm) {
  ((out, s), (pat, body)) => match ref_walk(mode, body, {...s, bound: s.bound ++ pat_binds(pat)}) {
    (b2, s2) => (push(out, (pat, b2)), {...s2, bound: s.bound}),
  },
}

fn ref_forms(mode, forms, sc) = fold(([], sc), ref_form(mode, ??, ??), forms)

fn ref_form(mode, acc, form) = match (acc, form) {
  ((out, s), (sch, f)) => match ref_walk(mode, f, s) {
    (f2, s2) => (push(out, (sch, f2)), {...s2, bound: s.bound}),
  },
}

// The register a statement binds.
fn let_binds(s) = match s {
  LLet(_, n, _) => [n],
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
  | LDeclareFn(_) | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _)
  | LSimdLanes(_, _) | LFanout(_, _, _, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _)
  | LMakeVariant(_, _, _) | LMatch(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _)
  | LDerive(_, _, _) | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
  | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
  | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => [],
}

// The registers a pattern binds.
fn pat_binds(p) = match p {
  LPVar(n) => [n],
  LPWild => [],
  LPCon(_, _, subs) => flat_map({ (_, sp) => pat_binds(sp) }, subs),
  LPUnresolvedCon(_, subs) => flat_map(pat_binds, subs),
  LPTuple(subs) => flat_map({ (_, sp) => pat_binds(sp) }, subs),
  LPLit(_) => [],
  LPList(_, pre, rest_name, _) => flat_map(pat_binds, pre) ++ name_of(rest_name),
  LPRecord(_, _, fields, rest_name) => flat_map({ (_, sp) => pat_binds(sp) }, fields) ++ name_of(rest_name),
  LPAs(n, sp) => [n] ++ pat_binds(sp),
  LPAlt(bs) => match bs {
    [] => [],
    [b, ..._] => pat_binds(b),
  },
}

fn name_of(o) = match o {
  Some(n) => [n],
  None => [],
}

// Lower a ResumeExpr's value + state updates with SNAPSHOT semantics:
// the resume value and every update RHS evaluate against the arm's
// PRE-update state, in source order, into per-site scratch locals;
// only then do the slot stores commit, and the saved value returns.
// Without the snapshot, `resume(ctr + n) with ctr = ctr + 1` returned
// the NEW ctr + n — the writeback raced the value (ev8d, 58-not-57).
// Slot offsets come from the field's source-order position in the
// enclosing arm's state-fields (resolved via the ArmStateContext
// handler). Updates whose field name is not in scope lower to
// LStateSlotStore(handle, -1, value) — emit time skips negative
// offsets per SYNTAX §State updates via with on resume
// productive-under-error.
fn lower_resume_snapshot(handle, val, updates, fields) = match resume_commit_prefix(handle, val, updates, fields, resolve_hrec(handle)) {
  (prefix, val_name) => LBlock(
    handle,
    // drift-audit: ignore — one-shot stmt-list concat, no loop
    // The snapshot is read back at the VALUE's handle, the node the scratch
    // is declared at (`resume_commit_prefix`) — never the resume node's,
    // whose type is the handler's answer.
    prefix ++ [LReturn(handle, LLocal(val, val_name))]
  ),
}

// The COMMIT PREFIX — the snapshot semantics shared by BOTH resume
// disciplines (band B M1.5, bank Ruling 4): the resume value and every
// update RHS evaluate against the arm's PRE-update state, in source order,
// into per-site scratch locals; only then do the slot stores COMMIT.
// Returns (stmts, val_name) — the tail differs per discipline: OneShot
// returns the snapshotted value (LReturn); MultiShot calls the k with it
// (commit BEFORE k(v), so the resumed remainder re-enters against
// committed state — LStateSlotStore writes through the RESOLVED record
// read (the __hrec ladder), the install record the driver pushed, and
// every arm state read is a LIVE load through that record, so the next
// resume in the same arm sees the committed value).
fn resume_commit_prefix(handle, val, updates, fields, record) = {
  // Each scratch is declared at its VALUE's node — the resume value at the
  // argument's, an update at its init's — the same handle every read of it
  // carries below. The resume node's own type is the handler's ANSWER, and
  // a scratch declared there was named at the answer's width and read at
  // the value's: once an install bound the answer (a Float-answering
  // handler resuming with `()`), the two names differed and the module did
  // not assemble.
  let val_name = "__resume_val_{int_to_str(handle)}"
  let val_let = LLet(val, val_name, lower_expr(val))
  let lets = map(
    (upd) => LLet(state_field_init(upd), resume_upd_local(upd, handle), lower_expr(state_field_init(upd))),
    updates
  )
  // Each commit reads its scratch at the update's own value handle — the
  // width the scratch was declared at.
  let stores = map(
    (upd) => LStateSlotStore(
      handle,
      resolve_state_slot_offset(state_field_name(upd), fields),
      LLocal(state_field_init(upd), resume_upd_local(upd, handle)),
      record
    ),
    updates
  )
  // drift-audit: ignore — one-shot stmt-list concat, no loop
  ([val_let] ++ lets ++ stores, val_name)
}

// The update's minted local — keyed by the field NAME (unique per
// record by construction; an enumerate index would re-derive an
// identity the name already carries) + the resume site's handle. Both
// map lambdas above mint through this one home, so the LLet and its
// LLocal read can never drift apart.
fn resume_upd_local(upd: {init: Node, name: Node}, handle) =
  "__resume_upd_{state_field_name(upd)}_{int_to_str(handle)}"

// Resolve a field name to its byte offset in the handler state
// record. `fields` is the slot-order NAME list — config ++ state in
// declaration order, the SAME list captures_names lays slots out by
// and install writes inits to (one heap record, four roles, per
// PLAN §5.U:
// [fn_ptr@0, count@4, slot_0@8, slot_1@12, ...]). A state-only list
// here was a parallel half-truth: the buffer name resolved to slot 0 — the
// config param's slot — and the next dispatch called the buffer as
// a closure. Returns -1 when name is not in fields
// (productive-under-error).
fn resolve_state_slot_offset(name: String, fields) = {
  let hits = filter({ (_, field) => field == name }, enumerate(fields))
  if len(hits) == 0 {
    -1
  } else {
    match head(hits) {
      (idx, _) => 8 + idx * 4,
    }
  }
}

// A parameter's local: the name its pattern binds the whole argument to —
// a bare name's, an as-pattern's — or, for a pattern binding only parts, a
// register of the lowering's own named by the parameter's handle, which the
// destructure wrapping the body takes apart (`lower_param_destructures`).
// The local's type handle is the parameter's node, the argument's cell, so
// the local live-chases the type the judgment proved.
fn lower_param_name(p) = match pat_of(param_pat(p)) {
  PVar(n) => n,
  PAs(n, _) => n,
  PWild | PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) => "__p{int_to_str(p)}",
}

fn lower_param_names(params) = map(lower_param_name, params)

// A parameter written as a destructuring pattern takes its argument apart
// where the body begins, in the frame the parameters were bound in and the
// order the judgment declared them: every destructured parameter's local is
// read first, while the frame holds the parameters alone, then each pattern
// binds its parts, in parameter order. Each layer is the one-arm match the
// pattern is — the parameter's local its scrutinee, the pattern its arm, and
// the match's handle the parameter's, where the judgment charged what the
// pattern builds (a rest's slice). A name binding the whole argument needs
// no match; an as-pattern's name is the local, and its inner pattern takes
// the argument apart.
fn lower_param_destructures(params) = {
  let taken_apart = params |> filter({ p => is_some(destructured_pat(param_pat(p))) })
  let reads = map(param_read, taken_apart)
  zip(taken_apart, reads) |> map(param_layer)
}

fn param_layer(pair) = match pair {
  (p, read) => {
    let pat = param_pat(p)
    let inner = match destructured_pat(pat) {
      Some(i) => i,
      None => pat,
    }
    (p, read, lower_pat_value(bind_fresh, pat_of(inner), inner, lookup_ty(p), seq_rep_of(p), p))
  },
}

// The body inside the layers, the last parameter's innermost.
fn wrap_param_destructures(layers, lo_body) = layers |> reverse |> fold(lo_body, wrap_param_layer)

fn wrap_param_layer(inner, layer) = match layer {
  (p, read, lp) => LMatch(p, read, [(lp, inner)]),
}

// The pattern a body takes a parameter's argument apart with: none for a
// name or a wildcard, an as-pattern's inner pattern, the pattern itself
// otherwise.
fn destructured_pat(pat) = match pat_of(pat) {
  PVar(_) => None,
  PWild => None,
  PAs(_, inner) => destructured_pat(inner),
  PLit(_) | PCon(_, _) | PTuple(_) | PList(_, _) | PRecord(_, _) | PAlt(_) => Some(pat),
}

// The parameter's local, read as a reference to it lowers: a register of the
// frame, a captured slot, a feedback site's prior.
fn param_read(p) = {
  let name = lower_param_name(p)
  match ls_resolve(name) {
    (res, local_h) => lower_resolved_ref(p, name, res, local_h),
  }
}

// The enumeration entry's param/result EDGES — the fn's own inferred TFun,
// component by component. Its handle-valued sibling above cannot serve the
// signature: ty_handle_of is 0 for every GROUND type, so a `x: Float` param
// would arrive at emit as "no judged type" and sign at the word floor — the
// exact silent-wrong the twin edges kept billing. A Ty carries both cases,
// and the width projection resolves vars through lookup_ty at read time so a
// twin's bracket answers with its own instantiation.
//
// A slot the graph never judged (the resume appendage's __k/__hrec, an arm's
// op args, a callee whose type is not a readable TFun) is ABSENT, not a
// sentinel Ty. The first form of this wrote TVar(0) and the census convicted
// it on sight — a wildcard arm minting a TVar is drift mode 10, and it was
// right: "handle zero means no node" is a convention every reader has to
// learn, where None is a fact the type states. The reader floors on None.
fn entry_param_tys(fn_handle, params) = match lookup_ty(fn_handle) {
  TFun(tparams, _, _) => if len(tparams) == len(params) { map(some_param_ty, tparams) } else { map(param_node_ty, params) },
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => map(param_node_ty, params),
}

// A parameter's type where the declaration's own is not a readable arrow:
// its node is the argument's cell.
fn param_node_ty(p) = Some(TVar(p))

fn ret_ty_of(fn_handle) = match lookup_ty(fn_handle) {
  TFun(_, r, _) => Some(r),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => None,
}

fn floor_tys(n) = map(none_of, range(0, n))

fn none_of(_i) = None

// lower_index — `xs[i]` dispatched on the RECEIVER's proven type (the proof IS
// the dispatch, the ++/== precedent). A TTuple receiver with a CONSTANT index
// is a positional-product field load: LFieldLoad at the width-summed offset
// (tuple_elem_offset). Everything else — a list receiver, or a runtime-variable
// index — stays the genuinely-runtime list_index call. The index's constant-ness
// is read live from its AST body (NExpr(LitInt n)); a tuple indexed by a non-
// constant is still a list_index (an open question the type system would refine
// to ValidIndex, but the const case is the one a positional product answers at
// compile time).
fn lower_index(handle, receiver, index) = match lookup_ty(receiver) {
  TTuple(elems) => match graph_node_body(index) {
    NExpr(LitInt(n)) => LFieldLoad(handle, lower_expr(receiver), FByIndex(n)),
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => lower_index_runtime(handle, receiver, index),
  },
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TFun(_, _, _) | TVar(_) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) | TValue(_) => lower_index_runtime(handle, receiver, index),
}

// A list index lowers to the runtime list_index call. When the judgment proved
// the read in range (its `PInBounds` claim held — the verdict the judgment
// wrote on the index node, graph_narrow_at ≠ 0), the access is the traversal
// beneath the check, list_index_unchecked (SYNTAX.md «Indexing»: "the compiler
// elides the bounds check"), whose row carries no Trap — exactly what the
// judgment charged (`subscript_callee`, one home for both reads). Until TRAP
// (2026-10-06) nothing wrote the verdict, so this branch's elision wrapper
// was never called; the wrapper is deleted.
//
// The reader is a NAMED function, so it is called DIRECTLY at its own
// signature (LDirectCall), never through its static closure as a value: its
// word result for a wide element is the element's ADDRESS (the stride
// carrier reads one body for every width), and the direct call's result arm
// dereferences exactly that. Called as a closure value it met the site's own
// vector — `(i32, i32, i32) -> f64` against a callee that signs a word — the
// moment a closure call stopped boxing, and every `[Float]` index trapped.
fn lower_index_runtime(handle, receiver, index) = {
  let callee = sugar_callee(handle, subscript_callee(graph_narrow_at(index) != 0))
  LDirectCall(handle, handle, callee, false, [lower_expr(receiver), lower_expr(index)])
}

// String interpolation lowering. Reduce a list of LowExpr fragments
// (alternating literal-chunks + spliced-exprs) to a left-fold of
// LCall(VarRef("str_concat"), [acc, next]). Per Mentl-substrate's
// runtime-strings-substrate (Hβ.runtime.zero-copy-string-view): each
// concat allocates ONE flat result; view-substrate makes literal
// chunks zero-copy reads from source. Empty list → empty string;
// singleton → that fragment unchanged.
fn lower_string_interpolation(handle, lowered_fragments) = {
  // Empty literal fragments (the "" edges the parser keeps for the
  // alternation invariant) elide before the fold — the canonical form
  // is also the efficient form (no str_concat with "" at runtime).
  // The seed's $lower_make_string elides IDENTICALLY (fixpoint parity).
  // The structural show arrives PRE-WRAPPED (γ's splice half): the
  // parser mints ShowExpr around every splice at MakeStringExpr's own
  // construction, so each fragment here is a literal LConst or an
  // LShow keyed by its JUDGED program handle — the per-run placeholder
  // mint died with the wrap fn (the projector divergence dossier's
  // smaller root). Emit's dispatch is unchanged (String → identity,
  // Float → float_to_str, word → int_to_str — show_node_of's arms;
  // the int-splice-empty class stays closed by the wrap's new home).
  let fragments = filter((f) => !is_empty_lconst_string(f), lowered_fragments)
  if len(fragments) == 0 {
    LConst(handle, LString(""))
  } else if len(fragments) == 1 {
    last(fragments)
  } else {
    // Left-assembly from the FIRST fragment: acc ++ frag in source order.
    // head = last(fragments) baked the FINAL fragment first — every
    // interpolation m2 lowered into m3 came out rotated ("$ft_{codes}_{rc}"
    // rendered d$ft_iiiid_, m4.wat line 13's assembly failure once m4
    // existed at all, 2026-07-10). The seed's own $lower_make_string
    // assembles source-order, so m2's OWN strings were fine and the
    // wheel's copy was never order-gated (mn-interp-order now gates it).
    let head = list_index(fragments, 0)
    let rest = slice(fragments, 1, len(fragments))
    // Every interior concat keys on a JUDGE-MINTED cell read from the
    // boundary column (InterpBoundary — the concat-key dossier's
    // settled design): distinct per concat by mint, never colliding
    // with a call-keyed handle in the subtree (the fragment-handle
    // keying trapped on exactly that — its own show's $call_<h>), and
    // minted ONCE at the judge, so lowering is a pure projection. The
    // one-handle-for-all form this replaced twice over was the
    // effectful-arg staging clobber. The outermost call keeps the
    // node's handle: the expression's type and span reads key on it.
    let cells = match graph_boundary_at(handle) {
      InterpBoundary(cs) => cs,
      NoBoundary | FanoutBoundary(_) => [],
    }
    // A count mismatch would let zip TRUNCATE — fragments silently
    // dropped from the string. The judge's elision mirror and this
    // filter must agree; a divergence is the loud typed terminal,
    // never a shorter string.
    if len(cells) == len(rest) {
      let chained = fold(
        head,
        (acc, pair) => match pair {
          (frag, ch) => LCall(ch, LGlobal(ch, sugar_callee(handle, interpolation_callee())), [acc, frag]),
        },
        zip(rest, cells)
      )
      match chained {
        LCall(_, g, args) => LCall(handle, g, args),
        other @ (
          LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
          | LUnaryOp(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _) | LReturn(_, _)
          | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _) | LDeclareFn(_)
          | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _)
          | LFanout(_, _, _, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _)
          | LMatch(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _)
          | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
          | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
          | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _)
        ) => other,
      }
    } else {
      LInvariantFailure(handle, ProjectionOriginShape(handle))
    }
  }
}

fn is_empty_lconst_string(frag) = match frag {
  LConst(_, LString(s)) => byte_len(s) == 0,
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
  | LDeclareFn(_) | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _)
  | LSimdLanes(_, _) | LFanout(_, _, _, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _)
  | LMakeVariant(_, _, _) | LMatch(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _)
  | LDerive(_, _, _) | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
  | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
  | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => false,
}

// Expression list
fn lower_expr_list(nodes) = map(lower_expr, nodes)

// Lower each value in a record-literal field list. Fields arrive
// sorted-by-name (parser invariant); position IS layout. The lowered
// list is in field-name sort order — emit reads it as the byte
// layout directly, no per-field lookup.
fn lower_record_field_values(flds) = map({ (_, value) => lower_expr(value) }, flds)

// {...base, f: v} — a non-destructive update: the base evaluated once into a
// local, then the update read off it. The written fields are carried by
// name and nothing here reads a type: which fields the result holds, and
// where each sits, is the update's type wherever it is emitted, so every
// copy of a generic function builds the record its own caller's shape
// spells.
fn lower_record_update(handle, base, overrides) = {
  let tmp = "__upd_{int_to_str(handle)}"
  LBlock(
    handle,
    [
      LLet(handle, tmp, lower_expr(base)),
      LRecordUpdate(handle, LLocal(base, tmp), map({ (name, v) => (name, lower_expr(v)) }, overrides))
    ]
  )
}

// The handle that types a read of a resolved local: the binder's own, or —
// when the binder has none — the handle of the node doing the reading.
//
// A local bound at a GROUND type has no binding-time handle (`ty_handle_of`
// answers 0 for a ctor's Float payload, a tuple's String element, a `Float`
// parameter), and a local is monomorphic, so the reading node carries the
// same truth: inference bound its cell to the local's type. Every read of a
// resolved local asks this ONE rule — the VarRef lowering, the k-hole read
// and the capture a closure mint stores. Through 2026-09-27 it was written
// inline at the first two and absent at the third, so a captured Float
// floored to a word at the mint while the body read it wide (`fn make(fb:
// Float) = (x) => x + fb` checked clean and did not assemble). The two `__k`
// resolvers read a word at handle 0 instead: a resume's node is typed at
// the install's answer, never at the record pointer the k local holds. The
// rule retires when a binder is a graph node with its own cell, so no
// binder is ever handle 0 (`Hβ.lower.binder-is-a-node`).
fn local_ty_handle(binder_h, use_h) = if binder_h == 0 { use_h } else { binder_h }

// W7.1 — called at `LambdaExpr` / `FnStmt` lower-time, BEFORE entering
// the new frame. Each free USE is resolved against the CURRENT (enclosing)
// scope via `ls_resolve`:
//   `RLocal`      — name is a local of the enclosing frame; capture loads its slot value.
//   `RUpval(slot)` — name was itself captured; capture loads through `__state` offset.
//   `RGlobal`     — name is a top-level symbol; NOT captured. Dropped from the list.
// The capture's value is read at `local_ty_handle(binder, use)`, so a wide
// local is stored wide (and boxed into its word slot by the mint).
//
// Returns `(captures_names, captures_exprs, captures_handles)` — parallel
// triples. The names half feeds `ls_enter_frame`; the exprs half feeds
// `LMakeClosure`'s heap-record materialization at emit time. The handles
// half stays the BINDER's handle, so each read inside the new frame keeps
// typing itself at its own use.
fn resolve_captures_outer(uses, owner_h) = if len(uses) == 0 {
  ([], [], [])
} else {
  match last(uses) {
    (name, use_h) => match ls_resolve(name) {
      (res, local_h) => match resolve_captures_outer(drop_last(uses), owner_h) {
        (rest_names, rest_exprs, rest_handles) => match res {
          RGlobal => (rest_names, rest_exprs, rest_handles),
          RLocal(reg) => (
            [name] ++ rest_names,
            [LLocal(local_ty_handle(local_h, use_h), reg)] ++ rest_exprs,
            [local_h] ++ rest_handles
          ),
          RUpval(slot) => (
            [name] ++ rest_names,
            [LUpval(local_ty_handle(local_h, use_h), slot)] ++ rest_exprs,
            [local_h] ++ rest_handles
          ),
          RFbPrior(fb_h) => ([name] ++ rest_names, [LFeedbackPrior(fb_h)] ++ rest_exprs, [local_h] ++ rest_handles),
        },
      },
    },
  }
}

// The cross-declaration facts every declaration's lowering reads, settled
// before any declaration is constructed. Each `FnStmt` / `LambdaExpr`
// pushes its own frame, and a name no frame binds is module scope.
fn lower_program(stmts) = {
  // Each pre-pass is an arena (lib/arena.mn): its fact crosses, the walk
  // that found it does not. Does any declared effect carry a yielding op?
  // No ⇒ nothing can yield ⇒ `can_yield` is false everywhere and the
  // boundary machinery contributes zero bytes.
  let facts = effect_yield_facts(stmts) ~> arena
  ls_register_yield_facts(facts)
  let yields = any({ (_, (y, _)) => y }, facts)
  ls_register_may_yield(yields)
  // AN-2 — the ops whose direct performs are followed by the boundary
  // check; nothing unwinds in a program where nothing yields.
  ls_register_unwinding_ops(if yields { unwinding_ops(stmts) ~> arena } else { [] })
  // the ops whose direct performs may hand back a LIVE continuation, which
  // takes the rest of the performer's frame with it
  ls_register_live_ops(if yields { live_ops(stmts) ~> arena } else { [] })
  // No pre-register pass: every handler decl's (config, state, arms) was
  // published at its declaration (register_handler), so an install reads
  // its handler's declaration off its reference's edge regardless of source
  // order. The lower-handler-stack is installed by the compile chain, not
  // here — its extent is the whole remainder (see the effect's own decl).
  //
  // Construction is RELOCATED to the demand worklist (reachable_from_main —
  // Hβ.lower.lowering-is-a-column): lower_program IS its pre-passes, the
  // three cross-decl facts every per-decl lower_stmt call reads. The program
  // flows on; each decl constructs when reachability demands it.
  stmts
}

// W7.1 lexical frame stack. State:
//   `frames`  — list of frame records (head = current). Each frame is one
//               lambda / fn body with locals + captures.
//
// `ls_resolve(name)`: the current frame's INNERMOST binder of the name (the
// last one bound — push/pop checkpoint truncation retires a closed scope's
// binders), else the frame's captures, else `RGlobal`. Frames below the head
// are NEVER searched — they belong to the enclosing lambda, which is opaque
// at this lexical level. Names referenced across frame boundaries MUST be
// captured.
//
// Frame shape: one record per frame. The local side is ONE list of binders
// in binding order (`LocalBind`: the source name, the handle its type is
// read at, and the register it took) beside a sorted set of the names for
// O(log N) membership; the capture side keeps its paired name and handle
// lists (LUpval reads a capture by its position). Until 2026-09-28 the local
// side was two parallel lists searched OLDEST-first, and a binder's register
// was its spelling: a nested let or a match arm that bound a parameter's own
// name overwrote the parameter, which read the arm's value once the arm
// closed — silently — while a shadow at another width resolved to the older
// binder's type and did not assemble
// (`Hβ.lower.shadowing-binder-clobbers-its-register`).
//
// Records are stored with their fields sorted by name; Mentl source reads
// them by `.field`, so the physical layout is the emit's business.
handler lower_scope with frames = [], may_yield = false, yield_facts = smap_new(), unwinding = [], live = [], fn_symbols = wmap_new(64), symbol_counts = smap_new(), judgments = wmap_new(1024) {
  ls_register_yield_facts(facts) => resume() with yield_facts = smap_build(facts),
  ls_judgment_memo(d) => // A declaration's judgment is settled before the lowering reads it, so it
  // is generalized once and read at every site that keys a twin by it.
  resume(wmap_get(judgments, d)),
  ls_judgment_note(d, j) => resume() with judgments = wmap_add(judgments, d, j),
  ls_effect_yield_fact(name) => resume(smap_get(yield_facts, name)),
  ls_register_may_yield(b) => // band B M1.3 — the A1 gate's global short-circuit, computed once at
  // lower_program from the declared effects × their ops' inferred disciplines.
  resume() with may_yield = b,
  ls_program_may_yield() => resume(may_yield),
  ls_register_unwinding_ops(ops) => resume() with unwinding = ops,
  ls_unwinding_op(op) => resume(string_in_list(unwinding, op)),
  ls_register_live_ops(ops) => resume() with live = ops,
  ls_live_op(op) => resume(string_in_list(live, op)),
  ls_enter_frame(fn_name, locals_in, locals_h, captures_in, captures_h, line_base) => // drift-audit: ignore — the capture side's paired name and handle lists (LUpval reads a capture by position); the local side is one binder list
  // fn_name is the frame's emitted symbol, the path a nested fn declared
  // inside it extends (`ls_fn_symbol`); lambda and synthetic frames pass
  // "". A parameter's register is its name: the signature declares it.
  {
    let frame = {
      binds: zip_with(param_bind, locals_in, locals_h),
      capture_handles: captures_h,
      capture_order: captures_in,
      captures: set_canonicalize(captures_in),
      fn_name,
      line_base,
      lines: [],
      locals: set_canonicalize(locals_in),
    }
    // drift-audit: ignore — O(1) push at the end last/drop_last read
    resume() with frames = frames ++ [frame]
  },
  ls_exit_frame() => if len(frames) == 0 {
    resume([])
  } else {
    let frame = last(frames)
    resume(frame.lines) with frames = drop_last(frames)
  },
  ls_line_slot(h, depth) => // The `<~` site takes the innermost frame's next line slot — the record
  // word after the frame's captures (or state and arms, or k tail) and
  // after the lines registered before it. A top-level fn's frame
  // (line_base -1) has no record slot: its line is static.
  if len(frames) == 0 {
    resume(LhStatic)
  } else {
    let frame = last(frames)
    let home = if frame.line_base < 0 { LhStatic } else { LhSlot(frame.line_base + len(frame.lines)) }
    let updated = {
      binds: frame.binds,
      capture_handles: frame.capture_handles,
      capture_order: frame.capture_order,
      captures: frame.captures,
      fn_name: frame.fn_name,
      line_base: frame.line_base,
      lines: frame.lines ++ [(h, depth, home)],
      locals: frame.locals,
    }
    // drift-audit: ignore — replace the END frame last() read
    resume(home) with frames = drop_last(frames) ++ [updated]
  },
  ls_line_home_of(h) => if len(frames) == 0 { resume(None) } else { resume(line_home_in(last(frames).lines, h)) },
  ls_frame_depth() => resume(len(frames)),
  ls_push_scope() => if len(frames) == 0 {
    resume(0)
  } else {
    let frame = last(frames)
    resume(len(frame.binds))
  },
  ls_pop_scope(checkpoint) => if len(frames) == 0 {
    resume()
  } else {
    let frame = last(frames)
    let kept = take(checkpoint, frame.binds)
    let updated = {
      binds: kept,
      capture_handles: frame.capture_handles,
      capture_order: frame.capture_order,
      captures: frame.captures,
      fn_name: frame.fn_name,
      line_base: frame.line_base,
      lines: frame.lines,
      locals: set_canonicalize(map(bind_name, kept)),
    }
    // drift-audit: ignore — replace the END frame last() read
    resume() with frames = drop_last(frames) ++ [updated]
  },
  ls_bind_local(name, h) => if len(frames) == 0 {
    // At module scope a binder's register is the global its declaration's
    // symbol names.
    match enclosing_decl(h) {
      Some(s) => match symbol_of_decl(fn_symbols, s) {
        (sym, symbols) => resume(sym) with fn_symbols = symbols,
      },
      None => resume(name),
    }
  } else {
    let frame = last(frames)
    // A binder whose name the frame already holds takes a register of its
    // own: the binder it shadows may be read again once this one's scope
    // closes (a nested block, a match arm), so the two can never share one.
    // Its position is unique among the binders the frame holds at once, and
    // `$` is no identifier character, so the name collides with nothing.
    let reg = if set_contains(frame.locals, name) { "{name}${len(frame.binds)}" } else { name }
    resume(reg) with frames = drop_last(frames) ++ [frame_binding(frame, BLocal(name, h, reg))]
  },
  ls_bind_fb_prior(name, h) => // (LF.B) The `<~` lambda param names the prior-iteration output, a
  // feedback NODE read live: a binder of the frame like any other, so a
  // binder inside the recurrence body shadows it and a lambda there captures
  // it (resolution in the lambda's own frame finds the capture, never the
  // outer register).
  if len(frames) == 0 {
    resume()
  } else {
    resume() with frames = drop_last(frames) ++ [frame_binding(last(frames), BPrior(name, h))]
  },
  ls_resolve(name) => if len(frames) == 0 {
    resume((RGlobal, 0))
  } else {
    let frame = last(frames)
    // O(log N) membership first: most references name a top-level
    // declaration, and those never walk the binders.
    if set_contains(frame.locals, name) {
      match list_index(frame.binds, innermost_index(frame.binds, name, len(frame.binds) - 1)) {
        BLocal(_, h, reg) => resume((RLocal(reg), h)),
        BPrior(_, fb_h) => resume((RFbPrior(fb_h), 0)),
      }
    } else if set_contains(frame.captures, name) {
      let cap_idx = ls_find_in_order(frame.capture_order, name, 0)
      resume((RUpval(cap_idx), list_index(frame.capture_handles, cap_idx)))
    } else {
      resume((RGlobal, 0))
    }
  },
  ls_decl_symbol(s) => match symbol_of_decl(fn_symbols, s) {
    (sym, symbols) => resume(sym) with fn_symbols = symbols,
  },
  ls_fn_symbol(name, h) => {
    // A named fn's symbol is a projection of its declaration: a top-level
    // one is its declaration's (`decl_symbol`), and a nested one is the
    // path of enclosing named fns joined by `.`, which no identifier
    // contains — so an f nested in a fn named a can never meet a sibling of
    // a named a_f, as the two did under `_`. Two declarations one path names — a name shadowed
    // across runs, the same helper in two branches — take `$1`, `$2` in the
    // order they are lowered, kept by declaration so a second lowering of
    // the same one answers the same symbol. Until 2026-10-03 the second
    // shared the first's and the emit refused the program as the compiler's
    // own naming collision (E_EmittedNameCollision).
    let outer = ls_outer_fn_name_loop(frames)
    if outer == "" {
      match symbol_of_decl(fn_symbols, h) {
        (sym, symbols) => resume(sym) with fn_symbols = symbols,
      }
    } else {
      match wmap_get(fn_symbols, h) {
        Some(sym) => resume(sym),
        None => {
          let base = "{outer}.{name}"
          let k = unwrap_or(smap_get(symbol_counts, base), 0)
          let sym = if k == 0 { base } else { "{base}${int_to_str(k)}" }
          resume(sym) with fn_symbols = wmap_add(fn_symbols, h, sym), symbol_counts = smap_add(symbol_counts, base, k + 1)
        },
      }
    }
  },
}

// A top-level declaration's symbol out of the scope's symbol table, spelled
// into it on the first ask: its module's name and its own, joined by `.`.
fn symbol_of_decl(symbols, s) = match wmap_get(symbols, s) {
  Some(sym) => (sym, symbols),
  None => {
    let sym = "{module_name_of_handle(graph_module_of(s))}.{stmt_decl_name(s)}"
    (sym, wmap_add(symbols, s, sym))
  },
}

// Walk frames innermost-first; return first non-empty fn_name.
// Lambda + block frames carry empty fn_name and are transparent;
// only named-fn frames contribute. Returns empty string when no
// named-fn frame exists (top-level). Drift refused: 7 (frames is one
// list; we read it sequentially, not as parallel arrays).
// The receiver is ANNOTATED with the frame record's WHOLE field set, and
// that is what makes the field read below a proof. A field's offset
// resolves from the receiver's full sorted set; an unannotated `frames`
// leaves the row OPEN, and the offsets then come from whatever subset this
// body happens to name — right only by accident of sort order. This fn is
// the nested-fn name discriminator, so getting it wrong is not a local
// matter: reading a foreign slot here returned the empty string, nested
// fns were never qualified, and the whole qualification path sat dormant.
// Field types read from the ls_enter_frame op's own declared signature,
// not inferred by eye.
fn ls_outer_fn_name_loop(frames: [{binds: [LocalBind], capture_handles: [Int], capture_order: [String], captures: [String], fn_name: String, line_base: Int, lines: [(Int, Int, LineHome)], locals: [String]}]) = if len(frames) == 0 {
  ""
} else {
  let frame = last(frames)
  if frame.fn_name == "" { ls_outer_fn_name_loop(drop_last(frames)) } else { frame.fn_name }
}

// A binder of a frame, in binding order. A local is read at its REGISTER —
// its source name, or a name of its own where it shadows an earlier binder
// of the frame — and its type at its handle; a `<~` recurrence's parameter
// binds the prior of the feedback site it names.
type LocalBind = BLocal(String, Int, String) | BPrior(String, Int)

fn bind_name(b) = match b {
  BLocal(n, _, _) => n,
  BPrior(n, _) => n,
}

// A parameter binds under its own name: the signature declares that register.
fn param_bind(name: String, h) = BLocal(name, h, name)

// The frame with one more binder, the only way a binder enters a frame.
fn frame_binding(frame: {binds: [LocalBind], capture_handles: [Int], capture_order: [String], captures: [String], fn_name: String, line_base: Int, lines: [(Int, Int, LineHome)], locals: [String]}, b) = {
  binds: frame.binds ++ [b],
  capture_handles: frame.capture_handles,
  capture_order: frame.capture_order,
  captures: frame.captures,
  fn_name: frame.fn_name,
  line_base: frame.line_base,
  lines: frame.lines,
  locals: set_insert(frame.locals, bind_name(b)),
}

// The position of a name's INNERMOST binder — the last one bound — once the
// frame's name set has vouched the name is there: a scan from the newest
// binder down that allocates nothing, so a resolution costs what the
// oldest-first lookup it replaced did (a fold here installed a handler per
// resolution: 5.3 MB more by lowering's end on the wheel, measured against
// this scan on one input, 2026-09-28). The read this becomes is the
// name-as-handle index (§5.O layer 1).
fn innermost_index(binds: [LocalBind], name: String, i) = if i < 0 {
  -1
} else if bind_name(list_index(binds, i)) == name {
  i
} else {
  innermost_index(binds, name, i - 1)
}

// A capture's position in the frame's capture list (LUpval reads the
// record at it), once `set_contains` has confirmed the name is there.
fn ls_find_in_order(lst, target: String, i) = ls_find_in_order_loop(lst, target, i, len(lst))

fn ls_find_in_order_loop(lst, target: String, i, n) = if i >= n {
  -1
} else if list_index(lst, i) == target {
  i
} else {
  ls_find_in_order_loop(lst, target, i + 1, n)
}

// ─── Reachability — an executable's emission projects the MAIN-ROOTED
// subgraph ─────────────────────────────────────────────────────────────
// The graph never forgot the call edges; emission reads them, so a rung
// carries only the code it reaches and an uncalled generic's unresolvable
// fold leaf ($compare_nUNRESOLVED) is never minted. A module with no
// `main` is a LIBRARY and emits whole (SYNTAX §Top-level program
// structure).
//
// The edges are read at TWO altitudes through ONE walk. Lower's reach
// constructs by NAME, and it must: a twin is a copy of its base's lowered
// body, so a base is constructed whatever key its sites project. The
// emitted reach (emit_reach, backends/wasm.mn) reads the same references
// once the keys exist, each under the bracket its body is emitted in, and
// emits only what a live reference reaches. Two walkers carried these
// edges until 2026-09-28 — one for the names, one for the twin sites — and
// the second also collected operand handles nothing had read since the
// worthiness gate was deleted.
type LowRef
  // a reference as a VALUE — what it denotes — and the handle its
  // instantiation is read at: an LGlobal
  = RefSite(Int, Callee)
  // a direct call's callee and the handle its instantiation is read at.
  // Distinct from a value reference because only a CALL carries a schedule
  // into its callee (`spec_call_name`): a function value minted under a
  // spawning schedule and called outside the install would perform `spawn`
  // with no handler on the chain, so a value keeps its callee's own frame's
  // schedule (`Hβ.lower.schedule-through-a-value`).
  | RefCall(Int, Callee)
  // an install's arm: the install's handle is where the key it runs the
  // arm under is read (`arm_site_pairs`)
  | RefArm(Int, String)
  // the arm a walked perform calls by its handler's declaration, the one
  // handler that declares the op: no install keys it
  | RefDeclArm(Int, String)
  // a name no instantiation keys: a driver, a runtime fn emit mints for a
  // show, a hash or a wide comparison — emitted under the symbol of the
  // declaration it names (`vocab_symbol`)
  | RefName(String)

fn ref_name(r) = match r {
  RefSite(_, c) => callee_symbol(c),
  RefCall(_, c) => callee_symbol(c),
  RefArm(_, n) => n,
  RefDeclArm(_, n) => n,
  RefName(n) => vocab_symbol(n),
}

fn low_refs_list(acc, exprs) = fold(acc, low_refs, exprs)

// What a continuation site reaches: its captures, and the remainder's body
// where the site declares it.
fn site_refs(acc, site) = match site {
  KSite(KDef(LFn(_n, _a, _p, body, _f, _l)), caps, _) => low_refs_list(low_refs_list(acc, body), caps),
  KSite(KRef(_), caps, _) => low_refs_list(acc, caps),
}

fn name_ref(acc, n) = [RefName(n)] ++ acc

fn arm_refs(acc, ih, groups) =
  fold(acc, (a, n) => [RefArm(ih, n)] ++ a, flatten(map(group_arms, groups)))

// The init fn an install calls is keyed as its arms are.
fn init_refs(acc, ih, hd) =
  if handler_state_count(hd) > 0 { [RefArm(ih, init_fn_name(hd))] ++ acc } else { acc }

fn arm_body_refs(acc, arm) = match arm {
  (_, body) => low_refs(acc, body),
}

// Emit calls a perform's target by name (`perform_target`), so reachability
// keeps that name alive: installed handlers survive via their reached
// container, but a singleton dispatch to an UNINSTALLED handler is the arm
// fn's only reference. A slot dispatch names nothing and reaches its arm
// through the chain node's record.
fn perform_target_refs(acc, disp) = match perform_target(disp) {
  Some(r) => [r] ++ acc,
  None => acc,
}

fn low_refs(acc, expr) = match expr {
  LGlobal(h, c) => [RefSite(h, c)] ++ acc,
  LDirectCall(_h, fh, c, _t, args) => low_refs_list([RefCall(fh, c)] ++ acc, args),
  LFanout(_h, lex, _br, forms) => low_refs(acc, fanout_form(lex, forms)),
  LPerform(_h, disp, args) => low_refs_list(perform_target_refs(acc, disp), args),
  LHandleWith(ih, b, hn, hd, inits, arm_names) => low_refs_list(low_refs(low_refs(init_refs(arm_refs(acc, ih, arm_names), ih, hd), b), hn), inits),
  LDerive(_h, seed, b) => low_refs(low_refs(acc, b), seed),
  LArena(_h, b) => low_refs(acc, b),
  LLet(_h, _n, inner) => low_refs(acc, inner),
  LMakeClosure(_h, LFn(_n, _a, _p, body, _f, _l), caps) => low_refs_list(low_refs_list(acc, body), caps),
  // The resume invocation reaches through its k expr and value; the __k
  // fn itself reaches through the site that declares it.
  LResumeK(_h, k, r, v) => low_refs(low_refs(low_refs(acc, k), r), v),
  // A yield reaches through its site (the remainder's body where the site
  // declares it, and its captures); the ARM reaches through the install's
  // arm groups, the existing channel.
  LYield(_h, _op, args, site) => site_refs(low_refs_list(acc, args), site),
  LCheck(_h, inner, site) => match site {
    Some(s) => site_refs(low_refs(acc, inner), s),
    None => low_refs(acc, inner),
  },
  LAbandon(_h, _op, args) => low_refs_list(acc, args),
  LDeclareFn(LFn(_n, _a, _p, body, _f, _l)) => low_refs_list(acc, body),
  LBlock(_h, stmts) => low_refs_list(acc, stmts),
  LIf(_h, c, t, e) => low_refs_list(low_refs_list(low_refs(acc, c), t), e),
  LBinOp(_h, _op, l, r) => low_refs(low_refs(acc, l), r),
  LUnaryOp(_h, _op, x) => low_refs(acc, x),
  LCall(_h, f, args) => low_refs_list(low_refs(acc, f), args),
  // show/hash contribute the names emit will mint, projected from the SAME
  // live type read the emit dispatch makes — including the generated
  // aggregate leaf's interior renderers (the minimal-module
  // undefined-$int_to_str break, gate mn-aggregate-show).
  LShow(_h, x) => low_refs(fold(acc, name_ref, show_reach_names(x)), x),
  LHash(_h, x) => low_refs(fold(acc, name_ref, hash_reach_names(x)), x),
  LTailCall(_h, f, args) => low_refs_list(low_refs(acc, f), args),
  LReturn(_h, x) => low_refs(acc, x),
  LMakeList(_h, elems) => low_refs_list(acc, elems),
  LMakeTuple(_h, elems) => low_refs_list(acc, elems),
  LSimdLanes(_h, lanes) => low_refs_list(acc, lanes),
  LMakeRecord(_h, fs) => low_refs_list(acc, fs),
  LRecordUpdate(_h, b, ws) => low_refs_list(acc, update_parts(b, ws)),
  LMakeVariant(_h, _t, fs) => low_refs_list(acc, fs),
  LMatch(_h, s, arms) => fold(low_refs(acc, s), arm_body_refs, arms),
  LFeedback(_h, _d, _home, b, s) => low_refs(low_refs(acc, b), s),
  LWasiCall(_h, _n, args) => low_refs_list(acc, args),
  LInvariantFailure(_, _) => acc,
  LFieldLoad(_h, rec, _off) => low_refs(acc, rec),
  LPrim(_h, _, args) => low_refs_list(acc, args),
  LStateSlotStore(_h, _o, v, _) => low_refs(acc, v),
  LStateInit(_h, _hn, _s, v) => low_refs(acc, v),
  LConst(_, _) => acc,
  LLocal(_, _) => acc,
  LFeedbackPrior(_) => acc,
  LUpval(_, _) => acc,
}

// The lowered expressions a node holds, a nested fn's body included, so a
// fold over them reaches every site the node's emission reaches: a node that
// mints a function adds that function's body — a record's own frame, which is
// why `frame_children` stops at it — and every other node holds exactly its
// frame's children.
fn low_children(expr) = match expr {
  LMakeClosure(_, LFn(_, _, _, body, _, _), caps) => caps ++ body,
  LYield(_, _, args, site) => args ++ site_held(site),
  LCheck(_, inner, site) => [inner] ++ match site {
    Some(s) => site_held(s),
    None => [],
  },
  LDeclareFn(LFn(_, _, _, body, _, _)) => body,
  other @ (
    LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
    | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
    | LReturn(_, _) | LAbandon(_, _, _) | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _)
    | LMakeTuple(_, _) | LSimdLanes(_, _) | LFanout(_, _, _, _) | LMakeRecord(_, _)
    | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _) | LMatch(_, _, _) | LResumeK(_, _, _, _)
    | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _) | LArena(_, _) | LFeedback(_, _, _, _, _)
    | LFeedbackPrior(_) | LPerform(_, _, _) | LFieldLoad(_, _, _) | LPrim(_, _, _)
    | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _)
    | LInvariantFailure(_, _) | LWasiCall(_, _, _)
  ) => frame_children(other),
}

// What a continuation site holds: its captures, and the remainder's body
// where the site declares it.
fn site_held(site) = match site {
  KSite(KDef(LFn(_, _, _, body, _, _)), caps, _) => caps ++ body,
  KSite(KRef(_), caps, _) => caps,
}

// The expressions one node evaluates in its OWN frame — the one enumeration
// of the constructors' children. A match gives its arms' bodies (a pattern is
// a `LowPat`, read by the walk that asks about patterns); an install gives its
// body, its handler expression and its state inits, its arms being records of
// their own; a minted function's body belongs to its record.
fn frame_children(expr) = match expr {
  LConst(_, _) => [],
  LLocal(_, _) => [],
  LGlobal(_, _) => [],
  LLet(_, _, inner) => [inner],
  LUpval(_, _) => [],
  LBinOp(_, _, l, r) => [l, r],
  LUnaryOp(_, _, x) => [x],
  LCall(_, f, args) => [f] ++ args,
  LTailCall(_, f, args) => [f] ++ args,
  LDirectCall(_, _, _, _, args) => args,
  LReturn(_, x) => [x],
  LMakeClosure(_, _, caps) => caps,
  LYield(_, _, args, site) => args ++ site_caps(site),
  LCheck(_, inner, site) => [inner] ++ opt_site_caps(site),
  LAbandon(_, _, args) => args,
  LDeclareFn(_) => [],
  LIf(_, c, t, e) => [c] ++ t ++ e,
  LBlock(_, stmts) => stmts,
  LMakeList(_, es) => es,
  LMakeTuple(_, es) => es,
  LSimdLanes(_, lanes) => lanes,
  LFanout(_, lex, _, forms) => [fanout_form(lex, forms)],
  LMakeRecord(_, fs) => fs,
  LRecordUpdate(_, b, ws) => update_parts(b, ws),
  LMakeVariant(_, _, fs) => fs,
  LMatch(_, s, arms) => [s] ++ map(match_arm_body, arms),
  LResumeK(_, k, r, v) => [k, r, v],
  LHandleWith(_, b, hn, _, inits, _) => [b, hn] ++ inits,
  LDerive(_, seed, b) => [seed, b],
  LArena(_, b) => [b],
  LFeedback(_, _, _, b, s) => [b, s],
  LFeedbackPrior(_) => [],
  LPerform(_, _, args) => args,
  LFieldLoad(_, rec, _) => [rec],
  LPrim(_, _, args) => args,
  LStateSlotStore(_, _, v, r) => [v, r],
  LStateInit(_, _, _, v) => [v],
  LShow(_, x) => [x],
  LHash(_, x) => [x],
  LInvariantFailure(_, _) => [],
  LWasiCall(_, _, args) => args,
}

fn match_arm_body(arm) = match arm {
  (_, body) => body,
}

// What an update evaluates: the record it copies, then each value it writes.
fn update_parts(base, written) = [base] ++ map({ (_, v) => v }, written)

// An update rebuilt from its parts in `update_parts`' order, each written
// value back under its field's name.
fn update_from_parts(h, written, parts) =
  LRecordUpdate(h, list_index(parts, 0), zip_with((w, v) => (field_of(w), v), written, rest(parts)))

fn field_of(w) = match w {
  (name, _) => name,
}

// The wide-twin seed, PER ENTRY: a constructed body any of whose sites
// projects a wide key contributes the runtime family a twin's emission can
// mint and its floor did not. A dead decl's wide sites seed nothing
// (nothing will twin for them); the frontier's set discipline absorbs the
// family's re-arrivals.
fn wide_seed(refs) = if any(ref_is_wide, refs) { spec_wide_family() } else { [] }

fn ref_is_wide(r) = match r {
  RefSite(h, c) => !spec_enc_is_floor(twin_site_key(h, c).enc),
  RefCall(h, c) => !spec_enc_is_floor(twin_site_key(h, c).enc),
  RefArm(ih, _) => byte_len(arm_install_enc(ih)) > 0,
  RefDeclArm(_, _) => false,
  RefName(_) => false,
}

// The decl's emitted name — "" for statements that are not named fns
// (module value lets stay unconditionally; they run in __init_lets).
fn reach_decl_name(stmt) = match stmt {
  LDeclareFn(LFn(n, _, _, _, _, _)) => n,
  LLet(_, n, LMakeClosure(_, _, _)) => n,
  // A statement that is no named function names nothing; module value lets
  // run in __init_lets.
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LLet(_, _, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
  | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _)
  | LFanout(_, _, _, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _)
  | LMatch(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _) | LDerive(_, _, _)
  | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
  | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
  | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => "",
}

// The top-level declaration a lowered reference reaches. A reference carries
// the declaration its writer decided — the edge the judgment drew at a
// source reference, through a nested scope, a shadow, a module that spells
// the name too, or the vocabulary a lowering minted at a borrowed site (`map`
// where the source wrote `fanout`, `str_concat` at an interpolation's cell)
// — and an install's arm follows the install to its handler's declaration.
// The runtime an emit's show or comparison calls is vocabulary resolved once
// here at the link's scope; a synthesized unit reaches nothing to construct.
fn ref_target(r) = match r {
  RefSite(_, c) => callee_target(c),
  RefCall(_, c) => callee_target(c),
  RefArm(ih, _) => install_target(ih),
  RefDeclArm(hd, _) => enclosing_decl(hd),
  RefName(n) => vocabulary_target(n),
}

fn callee_target(c) = match c {
  DeclaredAt(d) => enclosing_decl(d),
  Synthesized(_) => None,
}

fn install_target(ih) = match graph_install_at(ih) {
  NoInstall => None,
  InstallOf(right, _) => match tee_handler_decl(right) {
    Some(hd) => enclosing_decl(hd),
    None => None,
  },
}

fn vocabulary_target(n: String) = match env_resolve_linked(n) {
  Some(d) => enclosing_decl(d),
  None => None,
}

// THE DEMAND WORKLIST (Hβ.lower.lowering-is-a-column): construction IS
// reachability. A declaration popping from the frontier CONSTRUCTS, and the
// constructed body is the edge list, read once. A lower-minted reference (a
// synthesized thunk's callee, a twin's wide leaf) exists exactly when its
// parent constructs; a dead decl never constructs at all, and emission and
// reachability agree by construction. Every reference leads to the top-level
// declaration holding what it reaches (`ref_target`), so the frontier, the
// reached set and the constructed declarations are keyed by that statement's
// handle: membership is one word-keyed read, and the walk is linear in what
// it reaches. Reaching one arm reaches every sibling, so no function value
// dangles: an arm's target is its handler's statement, which constructs
// whole.
//
// An executable is a module whose top level declares `fn main` — the
// program's own read (main_param_count's precedent: the FnStmt is the
// canonical main). A library folds false and emits whole.
fn stmt_is_main_fn(node) = match graph_node_body(node) {
  NStmt(FnStmt(name, _, _, _, _)) => name == "main",
  // not a fn decl — cannot be the entry
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
  | NRow(_) | NParam(_) => false,
}

// A stmt DEFERS to the demand frontier when it runs only where a reference
// reaches it: a named fn, and a container with arms, which constructs whole
// when any arm is reached. Everything else is the always-live set: module
// value lets (__init_lets runs them), zero-arm containers, the trivial
// type/effect/import decls, bare exprs — the seed constructs them in source
// order.
fn reach_stmt_defers(node) = match graph_node_body(node) {
  NStmt(s) => match s {
    FnStmt(_, _, _, _, _) => true,
    HandlerDeclStmt(_, _, _, _, arms, _) => len(arms) > 0,
    HandlerChainStmt(_, _) => false,
    LetStmt(_, _, _) => false,
    TypeDefStmt(_, _) => false,
    EffectDeclStmt(_, _, _) => false,
    ImportStmt(_) => false,
    RefineStmt(_, _, _) => false,
    AliasStmt(_, _) => false,
    RowAliasStmt(_, _) => false,
    ExprStmt(_) => false,
  },
  NExpr(_) => false,
  NPat(_) => false,
  NHole(_) => false,
  NModule(_) => false,
  NLink(_) => false,
  NTypeAnn(_) => false,
  NName(_) => false,
  NRow(_) => false,
  NParam(_) => false,
}

// The seed — the always-live set constructs in source order. A module value
// let ROOTS its init's references (it RUNS before main in __init_lets, so
// its callees are live by construction); a closure-valued let leaves its
// references to a reference that reaches it; every other always-live entry
// roots nothing (a bare expr or a trivial decl draws no reach edge) past
// what its construction minted.
fn reach_seed(stmts, i, w, frontier) = if i >= len(stmts) {
  frontier
} else {
  let s = list_index(stmts, i)
  if reach_stmt_defers(s) {
    reach_seed(stmts, i + 1, w, frontier)
  } else {
    let lo = reach_construct(w, s)
    reach_seed(
      stmts,
      i + 1,
      w,
      match lo {
        LLet(_, _, LMakeClosure(_, _, _)) => frontier,
        LLet(_, _, init) => reach_root(w, s, init, frontier),
        LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LUpval(_, _) | LBinOp(_, _, _, _)
        | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
        | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
        | LDeclareFn(_) | LIf(_, _, _, _) | LBlock(_, _) | LMakeList(_, _) | LMakeTuple(_, _)
        | LSimdLanes(_, _) | LFanout(_, _, _, _) | LMakeRecord(_, _) | LRecordUpdate(_, _, _)
        | LMakeVariant(_, _, _) | LMatch(_, _, _) | LResumeK(_, _, _, _) | LHandleWith(_, _, _, _, _, _)
        | LDerive(_, _, _) | LArena(_, _) | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _)
        | LFieldLoad(_, _, _) | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _)
        | LShow(_, _) | LHash(_, _) | LInvariantFailure(_, _) | LWasiCall(_, _, _) => reach_mint_root(w, s, lo, frontier),
      }
    )
  }
}

// One declaration constructed: lowered in an extent of its own, with the
// holes its lowering noted kept beside it, so the executable gate reads a
// hole exactly where the declaration that holds it is kept.
fn reach_construct(w, s) = {
  let lo = lower_stmt(s) ~> arena
  wmap_add(w.built, s, lo)
  wmap_add(w.holes, s, graph_hole_drain())
  lo
}

// What one constructed entry adds to the frontier, once: the runtime its
// construction minted (a fanout's schedule forms), the references E draws,
// and the wide family when a site of E projects wide. The reads are an
// extent of their own: the frontier and the maps keep what they gain, and
// the reference lists and every lookup die here, so the walk's scratch is
// one entry's, never the program's.
fn reach_root(w, s, e, frontier) = {
  wmap_add(w.rooted, s, 1)
  {
    let refs = low_refs([], e)
    reach_enqueue(
      w,
      map(fanout_form_ref, fanout_form_drain()) ++ refs ++ map(RefName, wide_seed(refs)),
      frontier
    )
  } ~> arena
}

// An always-live entry that roots nothing of its own: only what its
// construction minted and the wide family its sites project join the
// frontier.
fn reach_mint_root(w, s, e, frontier) = {
  wmap_add(w.rooted, s, 1)
  reach_enqueue(
    w,
    map(fanout_form_ref, fanout_form_drain()) ++ map(RefName, wide_seed(low_refs([], e))),
    frontier
  ) ~> arena
}

// The frontier drain: pop a declaration (LIFO, a deterministic
// discipline), construct it on first touch, and root its constructed body
// exactly once — a closure-valued let the seed constructed roots here, when
// a reference reaches it. The order is a pure function of the program; the
// reach SET is its order-invariant fixpoint.
fn reach_drain(w, frontier) = if len(frontier) == 0 {
  ()
} else {
  let s = last(frontier)
  let rest = drop_last(frontier)
  let d = match wmap_get(w.built, s) {
    Some(lo) => lo,
    None => reach_construct(w, s),
  }
  match wmap_get(w.rooted, s) {
    Some(_) => reach_drain(w, rest),
    None => reach_drain(w, reach_root(w, s, d, rest)),
  }
}

// EMISSION is source order from the decls' own order: walk the statements
// and keep each constructed decl the program keeps (`reach_kept`).
fn reach_collect(stmts, w, i, buf, count) = if i >= len(stmts) {
  slice(buf, 0, count)
} else {
  match reach_kept(w, list_index(stmts, i)) {
    Some(d) => reach_collect(stmts, w, i + 1, list_set(list_extend_to(buf, count + 1), count, d), count + 1),
    None => reach_collect(stmts, w, i + 1, buf, count),
  }
}

// A constructed declaration the program keeps: one a reference reached, or
// one that waits for no reference — no name of its own and no function
// inside it, as the value let and the zero-arm container; a closure-valued
// let the seed constructed and nothing reached drops here.
fn reach_kept(w, s) = match wmap_get(w.built, s) {
  None => None,
  Some(d) => match wmap_get(w.reached, s) {
    Some(_) => Some(d),
    None => if reach_decl_name(d) == "" && len(reach_nested_names(d, [])) == 0 { Some(d) } else { None },
  },
}

// The value holes of the executable: what each kept declaration's
// construction noted, in source order.
fn reach_holes(stmts, w) = flat_map(kept_holes(w, ??), stmts)

fn kept_holes(w, s) = match reach_kept(w, s) {
  None => [],
  Some(_) => match wmap_get(w.holes, s) {
    Some(hs) => hs,
    None => [],
  },
}

// Every nested decl name a container holds — the container LIVES iff
// any of them was reached (installing a handler makes every arm
// dispatchable, so arms keep whole-container).
fn reach_nested_names(d, acc) = match d {
  LDeclareFn(LFn(n, _, _, body, _, _)) => reach_nested_names_list(body, [n] ++ acc),
  LBlock(_h, stmts) => reach_nested_names_list(stmts, acc),
  LLet(_h, _n, inner) => reach_nested_names(inner, acc),
  LIf(_h, _c, t, e) => reach_nested_names_list(e, reach_nested_names_list(t, acc)),
  LHandleWith(_h, b, _hn, _hd, _inits, _an) => reach_nested_names(b, acc),
  LDerive(_h, _seed, b) => reach_nested_names(b, acc),
  LArena(_h, b) => reach_nested_names(b, acc),
  LConst(_, _) | LLocal(_, _) | LGlobal(_, _) | LUpval(_, _) | LBinOp(_, _, _, _)
  | LUnaryOp(_, _, _) | LCall(_, _, _) | LTailCall(_, _, _) | LDirectCall(_, _, _, _, _)
  | LReturn(_, _) | LMakeClosure(_, _, _) | LYield(_, _, _, _) | LCheck(_, _, _) | LAbandon(_, _, _)
  | LMakeList(_, _) | LMakeTuple(_, _) | LSimdLanes(_, _) | LFanout(_, _, _, _) | LMakeRecord(_, _)
  | LRecordUpdate(_, _, _) | LMakeVariant(_, _, _) | LMatch(_, _, _) | LResumeK(_, _, _, _)
  | LFeedback(_, _, _, _, _) | LFeedbackPrior(_) | LPerform(_, _, _) | LFieldLoad(_, _, _)
  | LPrim(_, _, _) | LStateSlotStore(_, _, _, _) | LStateInit(_, _, _, _) | LShow(_, _) | LHash(_, _)
  | LInvariantFailure(_, _) | LWasiCall(_, _, _) => acc,
}

fn reach_nested_names_list(stmts, acc) = if len(stmts) == 0 {
  acc
} else {
  reach_nested_names_list(drop_last(stmts), reach_nested_names(last(stmts), acc))
}

// Queue each reference's declaration not yet reached — the frontier stays a
// set, its membership one word-keyed read.
fn reach_enqueue(w, refs, frontier) = if len(refs) == 0 {
  frontier
} else {
  reach_enqueue(w, drop_last(refs), reach_push(w, frontier, ref_target(last(refs))))
}

fn reach_push(w, frontier, target) = match target {
  None => frontier,
  Some(s) => match wmap_get(w.reached, s) {
    Some(_) => frontier,
    None => {
      wmap_add(w.reached, s, 1)
      push(frontier, s)
    },
  },
}

// The surviving-hole census over the REACHABLE emitted tree — the executable
// gate's hole read (pipeline.mn's gate_reads). Survival IS value-position
// by construction: a call-arg hole became a partial param (the fork), a
// pipe-stage hole was spliced over (lower_pipe_complete), so an authored
// NHole still riding an LConst in the tree is exactly the hole the
// executable cannot carry (SYNTAX §«Partial application» — productive,
// never executable). One pass, O(1) per node (authored_hole is one graph
// read); the arm set walks in lockstep with LowExpr — every constructor
// present, H6's exhaustive-match law keeping it honest.
// The gate's hole classifier reads the WEAVE span (graph_span_of) — the
// parse truth no unification overwrites: a body/let-init hole unifies with
// its binder's fresh var, the class root becomes that unlocated mint, and
// the reason-flavored caret collapses to span_zero (the miss that let
// `fn main() = ??` slip the gate). The compile tree is a SINGLE parse
// generation, so the session-weave multiplicity that forces the cursor's
// authored_hole onto the caret test (cursor.mn) cannot occur here; the two
// reads re-unify under Hβ.cursor.session-weave-epoch-scope.
fn executable_hole(handle) with !Mutate = match graph_node_body(handle) {
  NHole(id) => id != 0 && !span_eq(graph_span_of(handle), span_zero()),
  NExpr(_) | NStmt(_) | NPat(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => false,
}

// The show/hash reach projections — the exact names emit's show_node_of /
// hash_node_of will mint for this operand's type, plus the generated
// aggregate leaf's INTERIOR renderers (str_concat rides the runtime
// contract; int_to_str / float_to_str do not, and the aggregate body calls
// them directly). sig_has_d reads the fold signature for a float ANYWHERE
// in the shape — the same one-scan the leaf generators key on.
fn sig_has_d(sig, i) = if i >= byte_len(sig) {
  false
} else if byte_at(sig, i) == 100 {
  true
} else {
  sig_has_d(sig, i + 1)
}

fn show_reach_names(x) = {
  let ty = fold_strip(lookup_ty(lexpr_handle(x)))
  match ty {
    TList(TByte) => [],
    TFloat => ["float_to_str"],
    TList(_) => show_agg_reach(ty),
    TTuple(_) => show_agg_reach(ty),
    TName(_, _) => show_agg_reach(ty),
    TRecord(_) => show_agg_reach(ty),
    TRecordOpen(_, _) => show_agg_reach(ty),
    TInt | TUnit | TByte | TAddr | TFun(_, _, _) | TVar(_) | TRefined(_, _) | TReprPin(_, _)
    | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => ["int_to_str"],
  }
}

fn show_agg_reach(ty) = {
  let sig = fold_sig(ty)
  if sig_has_d(sig, 0) { ["float_to_str", "int_to_str"] } else { ["int_to_str"] }
}

fn hash_reach_names(x) = {
  let ty = fold_strip(lookup_ty(lexpr_handle(x)))
  match ty {
    TList(e) => {
      // The seed mirrors hash_node_of's route exactly (the visitor-walk
      // projection law): a byte face calls $str_hash and a word face
      // $list_hash. A STRUCTURAL face — a Float's among them — calls its
      // generated walker, whose interior may reach either runtime hash
      // depending on nesting, so the family is seeded conservatively (a
      // name absent from the input dissolves).
      let face = seq_elem_face(e)
      if seq_face_structural(face) {
        ["list_hash", "str_hash"]
      } else {
        match face {
          TByte => ["str_hash"],
          TInt | TFloat | TUnit | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_) | TName(_, _)
          | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
          | TAlias(_, _) | TValue(_) => ["list_hash"],
        }
      }
    },
    TFloat => ["float_to_str", "str_hash"],
    TRecord(_) => hash_agg_reach(ty),
    TRecordOpen(_, _) => hash_agg_reach(ty),
    TTuple(_) => hash_agg_reach(ty),
    TName(_, _) => hash_agg_reach(ty),
    TInt | TUnit | TByte | TAddr | TFun(_, _, _) | TVar(_) | TRefined(_, _) | TReprPin(_, _)
    | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => [],
  }
}

fn hash_agg_reach(ty) = {
  let sig = fold_sig(ty)
  if sig_has_d(sig, 0) {
    ["float_to_str", "str_hash", "list_hash"]
  } else {
    ["str_hash", "list_hash"]
  }
}

// ─── Named-generic specialization — monomorphization by repr key ─────────
//
// A named generic fn compiles ONCE at the word floor. The word protocol makes
// that floor CORRECT for plumbing (a fold shell shuttles wide references
// untouched), but WRONG the moment the body OPERATES on a quantified var at a
// wide instantiation: the i32-floored `<=`/`+` reads the f64 references as
// words, so prelude sort returns its input in ALLOCATION order and
// `reduce(xs, min)` picks by address (tests/frontier/mn-generic-float-*).
//
// The fix is a TWIN emission of the same body under the site's instantiation —
// and the instantiation is a PROJECTION, never a record: the unifier already
// merged each call's argument classes into the scheme's var classes, so
// walking the scheme's type (its TVar leaves are the quantified roots —
// generalize chase-deeps first) against the site's instantiated type in
// parallel reads the var→type mapping live off the union-find (Carried-Truth:
// zero new storage, zero infer changes). The twin itself is the SAME emit
// under the spec_wty state: the LookupTy handler answers lookup_ty through the
// mapping, so every repr read downstream — param widths, binop dispatch,
// element faces — specializes untouched, and interior call sites project
// their keys UNDER the substitution, keeping a web (sort → merge → merge)
// in-key transitively with no recursion special-case.
//
// The key is `twin_key` over the scheme's quantified vars, sorted by root
// handle: a variable the body reads the structure of keys by that structure,
// and every other one by its repr digit, so a word instantiation nothing
// reads the structure of IS the floor emission and a wide one mints a twin
// ($min$sp2 = min with its one var at f64).
// spec_pairs_find lives in graph.mn with its consumers (spec_pair_or_var /
// spec_subst_pairs / lookup_ty_graph) — the specialization projection reads
// the graph, and both this module and the bracket (infer.mn) reach it there.
fn spec_pairs_add(pairs, root, t) = match spec_pairs_find(pairs, root) {
  // first binding wins; the unifier proved consistency
  Some(_) => pairs,
  None => [(root, t)] ++ pairs,
}

// Deep site-type resolution THROUGH the LookupTy effect — under the spec_wty state
// a substituted var resolves to its concrete, so interior sites in a twin
// project their keys against the specialized truth.
//
// CHECK-THEN-BUILD (the instantiate-sharing law, A.3's exact shape — this
// walk was its unfixed sibling): the eager form re-cloned the ENTIRE tree
// even when nothing resolved — a fully-concrete site type reconstructed
// identically at every one of ~1e5 reference reads, and the demand
// analysis alone allocated 362MB of the self-compile image (measured
// 2026-07-25; the old "zero new storage" claim was the comment an entity
// that can be wrong wrote). The Bool change-walk returns words — zero
// allocation on the unchanged path — and the build recurses through the
// sharing face so unchanged subtrees re-share at every level.
fn spec_resolve(t) = if spec_resolve_changes(t) { spec_resolve_build(t) } else { t }

fn spec_resolve_changes(t) = match t {
  TVar(h) => match lookup_ty(h) {
    TVar(h2) => h2 != h,
    TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
    | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
    | TAlias(_, _) | TValue(_) => true,
  },
  TList(e) => spec_resolve_changes(e),
  TTuple(es) => spec_resolve_changes_list(es, 0),
  TFun(ps, r, _) => spec_resolve_changes_params(ps, 0) || spec_resolve_changes(r),
  TName(_, args) => spec_resolve_changes_list(args, 0),
  TRecord(fs) => spec_resolve_changes_fields(fs, 0),
  // The row var resolves like any other var — this arm read only the field
  // TYPES, so a site whose ONLY change was the row closing reported
  // "unchanged" and kept the open form. That is what left an INTERIOR site (a
  // call inside another twin's body) reading the decl's unlearned row after
  // the outer site had already been keyed on the proven set.
  TRecordOpen(fs, v) => match lookup_ty(v) {
    TVar(h2) => h2 != v || spec_resolve_changes_fields(fs, 0),
    TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
    | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
    | TAlias(_, _) | TValue(_) => true,
  },
  TRefined(b, _) => spec_resolve_changes(b),
  TAlias(_, i) => spec_resolve_changes(i),
  TCont(i, a, _, _) => spec_resolve_changes(i) || spec_resolve_changes(a),
  // scalars (TInt/TFloat/TUnit/TByte)
  TInt | TFloat | TUnit | TByte | TAddr | TReprPin(_, _) | TValue(_) => false,
}

// Raw-recursion loops (the battery's own law): a closure-taking any()
// would mint one record per node and the check-walk's whole point is the
// zero-allocation unchanged path.
fn spec_resolve_changes_list(ref xs, i) = if i >= len(xs) {
  false
} else if spec_resolve_changes(xs[i]) {
  true
} else {
  spec_resolve_changes_list(xs, i + 1)
}

fn spec_resolve_changes_params(ref ps, i) = if i >= len(ps) {
  false
} else if spec_resolve_changes(param_ty(ps[i])) {
  true
} else {
  spec_resolve_changes_params(ps, i + 1)
}

fn spec_resolve_changes_fields(ref fs, i) = if i >= len(fs) {
  false
} else {
  match fs[i] {
    (_, ft) => if spec_resolve_changes(ft) { true } else { spec_resolve_changes_fields(fs, i + 1) },
  }
}

fn spec_resolve_build(t) = match t {
  TVar(h) => match lookup_ty(h) {
    // genuinely free — the floor terminal
    TVar(h2) => TVar(h2),
    other @ (
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
      | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
      | TAlias(_, _) | TValue(_)
    ) => if any((fv) => fv == h, free_in_ty(other)) {
      // The polymorphic-recursion self-reference: a sig'd self-call's
      // demand ctx maps the base's own var to a type CONTAINING it
      // (a := [a]), and resolving would re-apply the ctx to its own
      // output forever (the measured spec_resolve_build exhaustion the
      // day sig'd poly recursion reached the emit). The var floors at
      // its word terminal — the uniform protocol every vector shares —
      // and the Henglein price surfaces as the unspecialized floor,
      // never a hang.
      TVar(h)
    } else {
      spec_resolve(other)
    },
  },
  TList(e) => TList(spec_resolve(e)),
  TTuple(es) => TTuple(map(spec_resolve, es)),
  TFun(ps, r, eff) => TFun(map((p) => param_with_ty(p, spec_resolve(param_ty(p))), ps), spec_resolve(r), eff),
  TName(n, args) => TName(n, map(spec_resolve, args)),
  TRecord(fs) => TRecord(map({ (n, ft) => (n, spec_resolve(ft)) }, fs)),
  // The row read to its end, its rest through the same live channel as every
  // other var: when the site closed it, the learned fields and the residual
  // the site proved past them ARE the resolved receiver and the open form is
  // gone. Anything else keeps the open form, every learned field resolved.
  TRecordOpen(fs, v) => match record_row_full(fs, v) {
    (all, end) => {
      let learned = map({ (n, ft) => (n, spec_resolve(ft)) }, all)
      match end {
        RowEndClosed => TRecord(field_canonicalize(learned)),
        RowEndFree(t) => match lookup_ty(t) {
          TRecord(residual) => TRecord(field_canonicalize(learned ++ residual)),
          TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
          | TName(_, _) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
          | TAlias(_, _) | TValue(_) => mk_record_open(learned, t),
        },
      }
    },
  },
  TRefined(b, p) => TRefined(spec_resolve(b), p),
  TAlias(n, i) => TAlias(n, spec_resolve(i)),
  TCont(i, a, d, w) => TCont(spec_resolve(i), spec_resolve(a), d, w),
  // scalars (TInt/TFloat/TUnit/TByte)
  TInt | TFloat | TUnit | TByte | TAddr | TReprPin(_, _) | TValue(_) => t,
}

// The parallel walk: scheme side vs site side, same shape by construction
// (the unifier made them agree); a shape mismatch is an error path already
// reported — collect nothing there, the floor stands (never fabricate).
// A scheme-side var CHASES its binding before matching: a body-bound var
// (constrain_scrutinee's elem ~ (u, v)) holds structure whose FIELD roots
// are the quantified ones — pairing the outer var coarse ({e -> (F, I)})
// leaves the twin's pattern reads keyless (the slot width found no pair for
// u/v and floored the destructure to offset 4 inside a minted twin).
fn spec_pairs_walk(st0, it0, acc) = {
  let st = fold_strip(st0)
  match st {
    TVar(v) => match graph_chase(v) {
      GNode(NBound(inner), _) => spec_pairs_walk(inner, it0, acc),
      GNode(_, _) => spec_pairs_add(acc, graph_chase_handle(v), it0),
    },
    TList(e) => match fold_strip(it0) {
      TList(ie) => spec_pairs_walk(e, ie, acc),
      TInt | TFloat | TUnit | TByte | TAddr | TTuple(_) | TFun(_, _, _) | TVar(_) | TName(_, _)
      | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
      | TAlias(_, _) | TValue(_) => acc,
    },
    TTuple(es) => match fold_strip(it0) {
      TTuple(ies) => spec_pairs_walk_list(es, ies, acc),
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TFun(_, _, _) | TVar(_) | TName(_, _)
      | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
      | TAlias(_, _) | TValue(_) => acc,
    },
    TFun(ps, r, srow) => match fold_strip(it0) {
      TFun(ips, ir, irow) => spec_pairs_instances(srow, irow, spec_pairs_walk(r, ir, spec_pairs_walk_params(ps, ips, acc))),
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
      | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => acc,
    },
    TName(_, args) => match fold_strip(it0) {
      TName(_, iargs) => spec_pairs_walk_list(args, iargs, acc),
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
      | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
      | TAlias(_, _) | TValue(_) => acc,
    },
    TRecord(fs) => match fold_strip(it0) {
      TRecord(ifs) => spec_pairs_walk_fields(fs, ifs, acc),
      TRecordOpen(ifs, iv) => match record_row_full(ifs, iv) {
        (iall, _) => spec_pairs_walk_fields(fs, iall, acc),
      },
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
      | TName(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => acc,
    },
    // The ROW's free REST is a quantified var like any other, and it keys the
    // twin. Dropping it made every record shape share one body, so the offset
    // came from the decl's own row instead of the call's proven set: two
    // shapes through one open-row callee answered 10 and 6 where both are 6,
    // silently. Both sides are read to their ends — the scheme's rest is the
    // chain's terminal, never a link, and the site's record is whatever its
    // chain spells — and the rest pairs only against a site whose row is
    // closed, because only there is the remainder proven; an open site has
    // nothing to key on and keeps the floor. What the terminal is paired
    // WITH is the residual past the fields the chain learned before it —
    // what unify writes at the instance's own terminal — never the site's
    // whole record: a second type that shares the terminal starts its chain
    // past a different set (a pattern's rest binder, `{| ρ}`, past the
    // receiver's named fields) and spells `learned ++ residual` from its
    // own start. Paired with the whole, `rest.b` read `b` at the RECEIVER's
    // slot — 3 for 2 over `{a: 1, b: 2, c: 3}`, a virgin 0 for `rest.c` —
    // while the rest record was built at the residual's layout (measured
    // 2026-09-30, tests/micros/mn-record-rest-through-param.mn).
    TRecordOpen(fs, v) => match record_row_full(fs, v) {
      (sall, send) => match site_record_full(it0) {
        Some(full) => spec_pairs_key_rest(send, record_fields_diff(full, sall), spec_pairs_walk_fields(sall, full, acc)),
        None => spec_pairs_walk_fields(sall, site_record_known(it0), acc),
      },
    },
    TCont(i1, a1, _, _) => match fold_strip(it0) {
      TCont(i2, a2, _, _) => spec_pairs_walk(a1, a2, spec_pairs_walk(i1, i2, acc)),
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
      | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TAlias(_, _)
      | TValue(_) => acc,
    },
    // scalars carry no vars
    TInt | TFloat | TUnit | TByte | TAddr | TRefined(_, _) | TReprPin(_, _) | TAlias(_, _) | TValue(_) => acc,
  }
}

// A function's instance variables key its twin as its type variables do:
// each the scheme's row quantifies is paired with the value its copy at the
// site is bound to, matched entry by entry within one effect in the order the
// instantiation copied them, so a stage written for no rate is specialized to
// the clock its caller runs it under.
fn spec_pairs_instances(srow, irow, acc) = match resolve_row_edges(srow) {
  EfRow(sp, _, _) => match resolve_row_edges(irow) {
    EfRow(ip, _, _) => spec_pairs_entries(filter(name_holds_var, sp), filter(name_holds_var, ip), acc),
  },
}

fn spec_pairs_entries(ss, is, acc) = match ss {
  [] => acc,
  [s, ...rest] => match find(same_effect_at(s, ??), enumerate(is)) {
    Some((k, i)) => spec_pairs_entries(
      rest,
      take(k, is) ++ drop(k + 1, is),
      spec_pairs_args(entry_args(s), entry_args(i), acc)
    ),
    None => spec_pairs_entries(rest, is, acc),
  },
}

fn same_effect_at(s, ki) = match ki {
  (_, i) => eff_name_handle(i) == eff_name_handle(s),
}

fn entry_args(e) = match e {
  EParameterized(_, args) => args,
  ENamed(_) | EPure => [],
}

fn spec_pairs_args(sargs, iargs, acc) =
  fold(acc, spec_pair_instance(iargs, ??, ??), enumerate(sargs))

fn spec_pair_instance(iargs, acc, ka) = match ka {
  (k, a) => match a {
    EAVar(q) => if k < len(iargs) {
      match instance_value_at(list_index(iargs, k)) {
        Some(x) => spec_pairs_add(acc, graph_chase_handle(q), TValue(x)),
        None => acc,
      }
    } else {
      acc
    },
    EAInt(_) | EAFloat(_) | EAString(_) | EAEffect(_) | EACon(_) | EANode(_) | EAType(_) => acc,
  },
}

// The value an instance argument holds, read under the bracket it is read in:
// a variable through its cell and the enclosing twin's pairs, a value as
// itself; an operand nothing grounds is the one unknown.
fn instance_value_at(a) = match a {
  EAVar(f) => match lookup_ty(f) {
    TValue(x) => Some(x),
    TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
    | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
    | TAlias(_, _) => None,
  },
  EAInt(_) | EAFloat(_) | EAString(_) | EAEffect(_) | EACon(_) => Some(a),
  EANode(_) | EAType(_) => None,
}

// The site's record when its row is proven whole, read to its end.
fn site_record_full(it0) = match fold_strip(it0) {
  TRecord(ifs) => Some(ifs),
  TRecordOpen(ifs, iv) => open_record_full_fields(ifs, iv),
  TInt => None,
  TFloat => None,
  TUnit => None,
  TByte => None,
  TAddr => None,
  TList(_) => None,
  TTuple(_) => None,
  TFun(_, _, _) => None,
  TVar(_) => None,
  TName(_, _) => None,
  TRefined(_, _) => None,
  TReprPin(_, _) => None,
  TCont(_, _, _, _) => None,
  TAlias(_, _) => None,
  TValue(_) => None,
}

// Every field the site's row has learned, whether or not its rest is known.
fn site_record_known(it0) = match fold_strip(it0) {
  TRecord(ifs) => ifs,
  TRecordOpen(ifs, iv) => match record_row_full(ifs, iv) {
    (iall, _) => iall,
  },
  TInt => [],
  TFloat => [],
  TUnit => [],
  TByte => [],
  TAddr => [],
  TList(_) => [],
  TTuple(_) => [],
  TFun(_, _, _) => [],
  TVar(_) => [],
  TName(_, _) => [],
  TRefined(_, _) => [],
  TReprPin(_, _) => [],
  TCont(_, _, _, _) => [],
  TAlias(_, _) => [],
  TValue(_) => [],
}

// A scheme row's free rest keys the residual the site proved past it; a
// closed scheme row is a monomorphic record with nothing to key.
fn spec_pairs_key_rest(send, residual, acc) = match send {
  RowEndFree(t) => spec_pairs_add(acc, t, TRecord(residual)),
  RowEndClosed => acc,
}

fn spec_pairs_walk_list(sts, its, acc) = if len(sts) == 0 || len(its) == 0 {
  acc
} else {
  spec_pairs_walk_list(rest(sts), rest(its), spec_pairs_walk(sts[0], its[0], acc))
}

fn spec_pairs_walk_params(ps, ips, acc) = if len(ps) == 0 || len(ips) == 0 {
  acc
} else {
  spec_pairs_walk_params(rest(ps), rest(ips), spec_pairs_walk(param_ty(ps[0]), param_ty(ips[0]), acc))
}

// Fields pair by NAME (both sides parse-sorted); a missing partner is an
// error path — skip, never fabricate.
fn spec_pairs_walk_fields(fs, ifs, acc) = if len(fs) == 0 {
  acc
} else {
  match fs[0] {
    (n, ft) => {
      let acc2 = match find({ (gn, _) => field_name_eq(gn, n) }, ifs) {
        Some(g) => match g {
          (_, gt) => spec_pairs_walk(ft, gt, acc),
        },
        None => acc,
      }
      spec_pairs_walk_fields(rest(fs), ifs, acc2)
    },
  }
}

// Sorted by root handle — the canonical order the enc digits read.
fn spec_pairs_sorted_insert(sorted, p) = if len(sorted) == 0 {
  [p]
} else {
  match p {
    (v, _) => match sorted[0] {
      (v0, _) => if v <= v0 { [p] ++ sorted } else { [sorted[0]] ++ spec_pairs_sorted_insert(rest(sorted), p) },
    },
  }
}

fn spec_pairs_sort(pairs) = fold([], spec_pairs_sorted_insert, pairs)

fn spec_repr_digit(t) with Pure = match repr_of(t) {
  RI32 => "0",
  RI64 => "1",
  RF64 => "2",
  RF32 => "3",
  RV128 => "4",
}

fn spec_enc_is_floor(enc) = spec_enc_floor_loop(enc, 0, byte_len(enc))

fn spec_enc_floor_loop(enc, i, n) = if i >= n {
  true
}
// '0'
else if byte_at(enc, i) != 48 {
  false
} else {
  spec_enc_floor_loop(enc, i + 1, n)
}

// The String pins are Intent Boundaries, load-bearing since splices
// stopped forcing String onto their fragments: unpinned, these params
// generalize (their only use IS the splice) and the floor copy shows a
// String operand through the word face — twin names minted as pointer
// numerals, the m3 ≠ m4 the march caught.
fn spec_mangle(name: String, enc: String) = "{name}$sp{enc}"

// The base a mangled symbol names — spec_mangle's inverse, read off its one
// spelling.
fn spec_unmangle(sym: String, enc: String) =
  str_slice(sym, 0, byte_len(sym) - byte_len(spec_mangle("", enc)))

// The symbols a handler's code is emitted under, each spelled in this one
// place off the handler's declaration: an arm (the arm decl, the ev-slot
// placement and the redrive liveness probe all read it here), the state
// init the install calls (`lower_init_decl` — the `$` is no identifier's
// character, so no declaration can share the name), and the redrive a held
// resume calls when its remainder yields again. The op keeps the String pin
// spec_mangle's parameters carry, for the same reason.
fn arm_fn_name(hd, op: String) = "op_{decl_symbol(hd)}_{op}"

fn init_fn_name(hd) = "{decl_symbol(hd)}$init"

fn redrive_fn_name(hd) = "op___redrive_{decl_symbol(hd)}"

// The site's instantiation pairs — [] when the callee is not generic: a
// value let, a monomorphic fn, or a synthesized unit. The scheme's
// quantified vars are the roots; the site's chased type carries the bindings.
fn spec_site_pairs_resolved(c, rt) = match fn_judgment(c) {
  None => [],
  Some(j) => match j {
    (qs, sty) => if len(qs) == 0 { [] } else { spec_pairs_sort(spec_pairs_walk(sty, rt, [])) },
  },
}

// A fn's settled judgment, read off its declaration — None for a callee
// that is not a fn: ctor, record, effect-op and value schemes never
// specialize, and a synthesized unit has no scheme. The judgment is
// generalized once per declaration (`ls_judgment_memo`): a live scheme's
// quantifier is a projection the reader runs, and every call site of a
// declaration keys its twin by it, so a forty-function group threading one
// record through updates ran its relation closure once per site.
fn fn_judgment(c) = match c {
  DeclaredAt(d) => match ls_judgment_memo(d) {
    Some(j) => Some(j),
    None => match fn_judgment_fresh(d) {
      Some(j) => {
        ls_judgment_note(d, j)
        Some(j)
      },
      None => None,
    },
  },
  Synthesized(_) => None,
}

fn fn_judgment_fresh(d) = match graph_published(d) {
  Some((scheme, _, kind)) => match kind {
    FnScheme => Some(judgment_pair(scheme)),
    ValueScheme | ParamScheme(_) | ConstructorScheme(_, _) | EffectOpScheme(_, _, _)
    | RecordSchemeKind(_) | EffectDeclKind(_, _) | HandlerKind(_, _, _, _, _) | HandlerChainKind(_)
    | RowAliasKind(_) | TypeVariants(_) | PrimitiveKind(_) => None,
  },
  None => None,
}

fn spec_site_pairs(h, c) = spec_site_pairs_resolved(c, spec_resolve(lookup_ty(h)))

// A TWIN IS KEYED BY WHAT ITS BASE OBSERVES. A twin is its base's body
// emitted under an instantiation, and two instantiations emit different bytes
// only where the body reads a variable's STRUCTURE — a fold leaf over it, a
// concat, a field load or a record pattern on it, or a callee that reads it.
// The judgment enters each such read on the variable's cell as a shape
// demand (`shape_demand`, infer.mn), and instantiation carries a callee's
// reads into its callers, so the fact is on the cell by the time anything is
// emitted (`var_read`). Everywhere else a variable is read at its
// width. So an observed variable keys by its structure (`observed_code`)
// and every other one by its width's digit, and the substitution the twin is
// emitted under is the same fact: an observed variable is bound to its type,
// an unobserved wide one too (its width is read), and an unobserved word
// stays FREE. A structural read the judgment missed then meets a free
// variable and floors where the census sees it, rather than reading another
// instantiation's layout. Keying every structured variable whole, which this
// replaced, made 3,030 twins of the wheel's generics where the bodies are
// 975 (measured 2026-09-28): `map` had 192 twins of two bodies.
//
// An arena's barrier is the third read (`MovedShape`): a store into memory
// older than an arena carries its value out of the region by its type, so a
// body whose store can reach such memory reads the class the move needs, and
// keys by it — where the program opens an arena, and nowhere else.
fn twin_key(pairs) = {enc: fold("", twin_enc_step, pairs), pairs: filter(twin_keeps, pairs)}

fn twin_enc_step(acc: String, p) = acc ++ twin_pair_code(p)

// An observed variable keys by its whole structure, a word scalar included:
// an observed Int is a proven fact the body reads (its comparison, its show),
// and keying it at the floor's own digit folded it back into the base, which
// reads it free. A variable still free at the site proves nothing, and keys
// at the floor.
fn twin_pair_code(p) = match p {
  (w, t) => if is_instance_value(t) {
    fold_sig(t)
  } else {
    match var_read(w) {
      ReadsStructure => observed_code(t),
      ReadsMove => moved_code(t),
      ReadsWidth => spec_repr_digit(t),
    }
  },
}

// An instance's value is observed wherever the body runs: its performs key
// their dispatch on it, so it keys the twin and stays bound in it.
fn is_instance_value(t) = match t {
  TValue(_) => true,
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TVar(_)
  | TName(_, _) | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) => false,
}

fn observed_code(t) = match fold_strip(t) {
  TVar(_) => spec_repr_digit(t),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) | TValue(_) => fold_sig(t),
}

// A moved variable keys by what its move needs: a word moves nothing, so
// every word instantiation shares one twin (`w` — no move sig and no width
// digit begins with it); a float in a word slot moves its box and keys by
// its width, as an unobserved float does; anything else moves by its shape
// and keys by its move sig, where a variable the type still holds is opaque
// and never collides with a word. A variable still free keys at the floor,
// where the barrier cannot see the type and its entry keeps the region.
fn moved_code(t) = match fold_strip(t) {
  TVar(_) => spec_repr_digit(t),
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) | TValue(_) => match evac_of(t) {
    EvWord => "w",
    EvWide => spec_repr_digit(t),
    EvShape(_) => move_sig(t),
    EvOpaque => move_sig(t),
  },
}

fn twin_keeps(p) = match p {
  (w, t) => is_instance_value(t) || match var_read(w) {
    ReadsStructure => true,
    ReadsMove => moved_bound(t),
    ReadsWidth => repr_is_wide(repr_of(t)),
  },
}

// A moved variable is bound in its twin unless it is still free: the barrier
// reads the bound type to choose its leaf, or to know a word needs none.
fn moved_bound(t) = match fold_strip(t) {
  TVar(_) => false,
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
  | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
  | TAlias(_, _) | TValue(_) => true,
}

// What a body reads of a variable, off the demands on its cell: its
// structure, a move, or its width alone.
type VarRead = ReadsStructure | ReadsMove | ReadsWidth

fn var_read(w) = {
  let ds = graph_demands_of(w)
  if any(is_structure_demand, ds) {
    ReadsStructure
  } else if any(is_move_demand, ds) && program_opens_arenas() {
    ReadsMove
  } else {
    ReadsWidth
  }
}

fn is_structure_demand(d) = match d {
  DemandShape(read) => match read {
    WholeShape => true,
    OuterShape => true,
    MovedShape => false,
  },
  DemandNumber(_) | DemandLacks(_) | DemandCopy(_, _, _) | DemandSpill(_) => false,
}

fn is_move_demand(d) = match d {
  DemandShape(read) => match read {
    MovedShape => true,
    WholeShape => false,
    OuterShape => false,
  },
  DemandNumber(_) | DemandLacks(_) | DemandCopy(_, _, _) | DemandSpill(_) => false,
}

// Whether the program opens an arena. An arena's install charges `Arena` to
// the frame it stands in and no handler answers it, so `main`'s row carries
// it exactly when an arena is reachable — the judged fact, settled before a
// single body is lowered, that every barrier's read is keyed by.
fn program_opens_arenas() = match env_lookup("main") {
  Some(entry) => match entry {
    (scheme, _, _) => match judgment_ty(scheme) {
      TFun(_, _, row) => match resolve_row(row) {
        EfRow(p, _, _) => any(names_arena, p),
      },
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
      | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => false,
    },
  },
  None => false,
}

fn names_arena(e) = eff_name_str(e) == "Arena"

// What carrying a value of a type out of an arena's region needs — the one
// classification the twin key, the barriers and the exit's leaves all read:
// nothing for a word (a sentinel included), nothing for a float unless it is
// boxed in a word slot, a refusal to move a value of a type nothing here can
// see into, and a move by its shape.
type Evac = EvWord | EvWide | EvOpaque | EvShape(Shape)

// A shape a leaf moves by: a sequence's element type, a product's field
// types in layout order, each fielded variant's tag and payload types.
type Shape = ShSeq(Ty) | ShProduct([Ty]) | ShSum([(Int, [Ty])])

fn evac_of(ty) = match fold_strip(slot_ty(ty)) {
  TInt => EvWord,
  TByte => EvWord,
  TUnit => EvWord,
  // a word that names memory nothing here can read: the region it
  // points into stays whole rather than move what it cannot see
  TAddr => EvOpaque,
  TFloat => EvWide,
  TList(e) => EvShape(ShSeq(e)),
  TTuple(es) => EvShape(ShProduct(es)),
  TRecord(fs) => evac_record(record_full_fields(TRecord(fs))),
  TRecordOpen(fs, v) => evac_record(record_full_fields(TRecordOpen(fs, v))),
  TName(n, args) => match nominal_record_fields(n) {
    // A nominal record's fields are read off its declaration, which a type
    // argument does not ground — a generic one's layout is not known here.
    Some(fs) => if len(args) == 0 { EvShape(ShProduct(map(field_type_of, fs))) } else { EvOpaque },
    None => evac_sum(variant_specs_at(TName(n, args))),
  },
  TFun(_, _, _) => EvOpaque,
  TCont(_, _, _, _) => EvOpaque,
  TVar(_) => EvOpaque,
  TAlias(_, inner) => evac_of(inner),
  TRefined(base, _) => evac_of(base),
  TReprPin(_, base) => evac_of(base),
  TValue(_) => EvWord,
}

// A record moves by its whole sorted field set; one whose fields the row
// never closed is a layout nothing here can see.
fn evac_record(full) = match full {
  Some(fs) => EvShape(ShProduct(map(field_type_of, fs))),
  None => EvOpaque,
}

fn field_type_of(field) = match field {
  (_, t) => t,
}

// A sum whose variants all carry nothing is a word (its values are the
// sentinels below heap_base); one with no variants at all is a name nothing
// here can see.
fn evac_sum(specs) = if any(variant_fielded, specs) {
  EvShape(ShSum(specs))
} else if len(specs) > 0 {
  EvWord
} else {
  EvOpaque
}

fn variant_fielded(spec) = match spec {
  (_, payloads) => len(payloads) > 0,
}

// Whether the exit looks at a value of this class where it is stored: one
// it moves, or one whose type it cannot see into.
fn evac_moves(ev) = match ev {
  EvShape(_) => true,
  EvOpaque => true,
  EvWord => false,
  EvWide => false,
}

// A float is a pointer only boxed in a word slot.
fn evac_boxes(ev) = match ev {
  EvWide => true,
  EvShape(_) => false,
  EvOpaque => false,
  EvWord => false,
}

// A reference site's key.
fn twin_site_key(h, c) = twin_key(spec_site_pairs(h, c))

// THE INSTALL KEYS ITS ARMS. An arm is lowered once, from the handler's
// declaration, so every install ran one arm set that read its config and its
// effect's instance through the declaration's own types — an open row, a free
// variable. A record config read field by field floored at every install, a
// Float config compared or showed as the address of its box, and an arm adding
// two Float operands of its op added their boxes' addresses. An install is a
// reference site like a call: its handler expression's type is the
// instantiated `Handler(inst)`, and its config arguments are where the
// declaration's config variables meet this install's types, so the arms it
// runs are twinned under exactly those pairs, and the install stores the twins
// in its record.
//
// An arm is reached at the face its INSTANCE gives it. Its header reads the
// op's types at the handler's instance, which a twin keyed here substitutes,
// so an arm signs the widths its body reads; and a performer emits its
// arguments at its own site's widths, which are the same instance's — the tee
// unifies every perform with the handler's — so the two faces agree
// (call_site_vector, wasm.mn). The handler's ANSWER is keyed the same way:
// it is the second argument of the handler's type, met at the install by the
// body's answer (`install_answer`, infer.mn), so an arm that observes its
// answer runs at the answer its install gives it, and a wide answer crosses
// the driver and every continuation at its own width (the continuation
// face, wasm.mn).
fn arm_site_pairs(install_h) = match graph_install_at(install_h) {
  NoInstall => [],
  InstallOf(hexpr_h, cfg_hs) => match tee_handler_decl(hexpr_h) {
    None => [],
    Some(hd) => match graph_published(hd) {
      Some((scheme, _, _)) => arm_pairs_of(judgment_pair(scheme), hexpr_h, cfg_hs),
      None => [],
    },
  },
}

fn arm_pairs_of(jp, hexpr_h, cfg_hs) = match jp {
  (qs, sty) => if len(qs) == 0 {
    []
  } else {
    spec_pairs_sort(arm_pairs_walk(sty, spec_resolve(lookup_ty(hexpr_h)), cfg_hs))
  },
}

// The scheme met at the install: the handler expression's type is the
// instantiated result — or, for a bare reference to a configured handler, the
// instantiated scheme whole — and each config parameter meets its argument.
fn arm_pairs_walk(sty, hexpr_ty, cfg_hs) = match sty {
  TFun(ps, res, _) => {
    let inst = match fold_strip(hexpr_ty) {
      TFun(_, _, _) => spec_pairs_walk(sty, hexpr_ty, []),
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
      | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => spec_pairs_walk(res, hexpr_ty, []),
    }
    fold(inst, arm_pair_step, zip(ps, cfg_hs))
  },
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => spec_pairs_walk(sty, hexpr_ty, []),
}

fn handler_result_ty(sty) = match sty {
  TFun(_, res, _) => res,
  TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TVar(_) | TName(_, _) | TRecord(_)
  | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => sty,
}

fn arm_pair_step(acc, pc) = match pc {
  (p, h) => spec_pairs_walk(param_ty(p), spec_resolve(lookup_ty(h)), acc),
}

// Whether an op's arms are reached by its driver, at the continuation face
// (wasm.mn), rather than called by the performer at the op's declared one.
fn op_answers_its_driver(op: String) = match op_resume_discipline(env_resolve(op)) {
  OneShot => false,
  MultiShot => true,
  Abandon => true,
}

// The key an install's arms run under. They share one: every arm and the
// init are judged in the handler's own scope, so what any of them reads of
// the handler's variables is on those variables' cells.
fn arm_twin_key(ih) = twin_key(arm_site_pairs(ih))

// The install's key as a twin suffix, "" at the floor — what the emit names
// an install's arms and init by.
fn arm_install_enc(ih) = {
  let e = arm_twin_key(ih).enc
  if spec_enc_is_floor(e) { "" } else { e }
}

// The arm fn an install runs: the twin its key names, else the arm as
// declared — a floor key, or a twin past the polymorphic-recursion cap,
// whose sites read the base as every capped body's do. The emit names an
// install's arms and init by it, and the derivative reading demands the
// same symbol's twin at a perform the install answers.
fn arm_symbol(arm: String, enc: String) = if byte_len(enc) == 0 {
  arm
} else {
  let m = spec_mangle(arm, enc)
  if spec_twin_known(m) { m } else { arm }
}

// Whether any install of this handler can run twinned arms: a quantified
// variable in its scheme, in its config or its effect's instance. A perform
// no install of it answers in its own frame then reaches the arm through the
// record the walk finds, never through the base arm's symbol, which a keyed
// install does not run. The facts are the ones the declaration published.
fn handler_may_key(hd) = match graph_published(hd) {
  None => false,
  Some(entry) => match entry {
    (scheme, _r, kind) => match kind {
      HandlerKind(_, _, _, _, _) => match judgment_pair(scheme) {
        (qs, _) => len(qs) > 0,
      },
      FnScheme | ConstructorScheme(_, _) | EffectOpScheme(_, _, _) | RecordSchemeKind(_)
      | EffectDeclKind(_, _) | ParamScheme(_) | RowAliasKind(_) | TypeVariants(_) | HandlerChainKind(_)
      | ValueScheme | PrimitiveKind(_) => false,
    },
  },
}

// The ONE naming projection every reference-emitting arm reads: the site's
// key, mangled when it names more than the floor, the callee's own symbol
// there.
fn spec_global_name(h, c) = {
  let enc = twin_site_key(h, c).enc
  let name = callee_symbol(c)
  if spec_enc_is_floor(enc) { name } else { spec_mangle(name, enc) }
}

// A DIRECT CALL's naming projection: the site's key, and — inside a bracket
// whose enc names a spawning schedule — that schedule's letter, when the
// callee reaches a fanout through direct calls (`fanout_reach_known`, the
// one rule graph.mn states) and its row does not forbid `Thread`. So a
// `~> parallel_compose` install reaches every `><` and `fanout` in its
// extent's direct-call reach, one twin per (instantiation, schedule), and
// a callee declared `!Thread` keeps its own frame's schedule: the negation
// is what the demand reads (`Hβ.lower.schedule-specialized-callee`). Only a
// call carries the schedule; a value reference (`spec_global_name`) never
// does, since the value may outlive the install.
fn spec_call_name(h, c) = {
  let enc = twin_call_key(h, c).enc
  let name = callee_symbol(c)
  if spec_enc_is_floor(enc) { name } else { spec_mangle(name, enc) }
}

// A direct call's key: the site's instantiation key, its enc carrying the
// demanded schedule's letter when the callee takes it.
fn twin_call_key(h, c) = {
  let key = twin_site_key(h, c)
  // the site's own install governs; a site that installs none inherits the
  // bracket's demand (`site_schedule`, noted at the lowering)
  let demanded = match site_schedule(h) {
    Some(s) => s,
    None => enc_sched(spec_enc_active()),
  }
  match demanded {
    Seq => key,
    Threaded | Simd | Gpu | Persisted => if callee_reaches_fanout(c) {
      {enc: key.enc ++ sched_suffix(demanded), pairs: key.pairs}
    } else {
      key
    },
  }
}

// Whether a callee reaches a fanout through its direct calls — asked of its
// declaration (`fanout_reach_known`); a synthesized unit reaches none.
fn callee_reaches_fanout(c) = match c {
  DeclaredAt(d) => fanout_reach_known(d),
  Synthesized(_) => false,
}

fn eff_name_is(ename: String, n) = str_eq(eff_name_str(n), ename)

// The symbol a reference names under the active bracket: the site's key
// projected, redirected ONLY when the demand analysis minted that twin —
// a wide key with no twin stays at the floor, which the word protocol
// keeps correct for plumbing. The exists fast-path keeps a twin-free
// module (every all-word program, Law 7) at one op per reference. Every
// reference surface the emit writes and the derivative reading's own
// callee resolution read this one projection.
fn spec_target_name(h, c) = {
  let name = callee_symbol(c)
  if !spec_twins_exist() {
    name
  } else {
    let m = spec_global_name(h, c)
    if m == name { name } else if spec_twin_known(m) { m } else { name }
  }
}

// The wide runtime family a twin's emission can mint that its floor did not
// (the name show_reach_names contributes at concrete sites): a Float twin
// renders through float_to_str, while its folds' Float leaves are the
// emitted walkers' own. Seeded whenever ANY site projects a wide key — a
// cheap, precise-enough over-approximation in the emit_runtime_contract
// tradition; a program with no wide instantiation adds nothing.
fn spec_wide_family() = ["float_to_str"]

// The demand worklist's driver — reachable_from_main takes the PROGRAM
// (lower_program is its pre-passes) and constructs exactly what emission
// keeps. The seed builds the always-live set in source order; the frontier
// then drains from `main`, constructing each popped declaration and
// enqueuing the CONSTRUCTED body's references, so construction IS
// reachability and every entry constructs at most once, before any assembly
// byte. The runtime emit mints calls to after construction roots as
// vocabulary: the contract, `wasi_args` where main takes argv
// (Hβ.emit.wasi-argv-in-start), so a 0-param main() never pulls it, and the
// launch gate the module's start may call (lib/environ.mn), which reaches
// nothing where the program does not link it. Then the holes of what is
// kept are published for the executable gate.
//
// The walk is an EXTENT (lib/arena.mn): what it publishes is the constructed
// declarations in source order, and everything else it builds on the way —
// each entry's reference list, the twin key read at every site to seed the
// wide family, the frontier and the maps keyed by statement — dies at its
// exit. Measured 2026-10-13 on the self-compile: the declarations published
// 8.2 MB past their own arenas while the walk's scratch stood at 56 MB of
// the heap with nothing to reclaim it, 8 MB more than on the source before
// the landing, and the cost ratchet refused the pin.
fn reachable_from_main(stmts) = {
  let has_main = any(stmt_is_main_fn, stmts)
  // THE LIBRARY PATH seeds ALL decls: every stmt constructs, source
  // order — the whole module emits (narrowing would shift the
  // installed-effect census on programs that compile today; refused,
  // the written decision), and every hole it carries is the gate's.
  if !has_main {
    let lowered = lower_stmt_list(stmts)
    graph_holes_publish(graph_hole_drain())
    lowered
  } else {
    let w =
      {built: wmap_new(4096), holes: wmap_new(4096), reached: wmap_new(4096), rooted: wmap_new(4096)}
    let argv_root = if main_param_count() > 0 { ["wasi_args"] } else { [] }
    let roots = reach_enqueue(
      w,
      map(RefName, emit_runtime_contract() ++ argv_root ++ ["env_demand_check"]),
      reach_push(w, [], find(stmt_is_main_fn, stmts))
    )
    reach_drain(w, reach_seed(stmts, 0, w, roots))
    graph_holes_publish(reach_holes(stmts, w))
    reach_collect(stmts, w, 0, make_list(len(stmts)), 0)
  }
} ~> arena

// ── DAG-homed here (the import-truth sweep, 2026-07-23): each fn below
// moved from a module DOWNSTREAM of its users so every user reaches it
// through a forward import edge — the manifest tells the truth.
//
// Walks the lowered program, emitting the full WAT module structure:
// imports, memory, globals, function table, functions, start. Every
// output line flows through perform wat_emit.
//
// W7: every function is emitted with an implicit `__state` param.
// Calls go through a function table keyed by i32 index; LMakeClosure
// stores the index at offset 0 of the closure record; LCall loads
// the index and uses the WAT instruction call_indirect with `$ft(N+1)` type (arity
// includes the `__state` slot).
//
// The emit layer's substrate contract — every runtime fn an emit arm
// dispatches to BY NAME as it cashes a proof ("the proof becomes the
// dispatch": a String == mints `call $str_eq`, a perform's world walk
// mints `call $ev_perform_node`). These references are minted at emit,
// after reachability projected the input, so the projection seeds its
// frontier from this set — one home, maintained beside the arms that
// mint the calls; an arm that gains a `call $<fn>` adds the name here.
// A name absent from the input dissolves (nothing to reach). The
// visitor-walk projection of this set is the deeper form, gated on the
// ev-slot seam close.
//
// THE WORLD WALK IS NOT IN THIS LIST, and the reason is the list's own
// limit: seeding a NAME only reaches it if the module defining it is already
// in the program's set. The world walk's ev_declaring_node was a lib fn with
// zero Mentl callers, so the wheel linked it (the wheel imports memory) and a small
// program did not — eleven frontier legs read RED on an undefined symbol for
// programs whose only crime was being small. It is emitted into the preamble
// now, beside the $world_push it is the dual of, and needs no reaching at
// all. `Hβ.driver.link-is-reachability` is what makes a minted name demand
// its module the way an import does; every name below still rides on the
// module set already carrying it.
fn emit_runtime_contract() = [
  "len",
  "list_compare",
  "list_concat",
  "list_eq",
  "list_index",
  "list_set",
  "make_list",
  "make_list_sc",
  "slice",
  "str_compare",
  "str_concat",
  "str_eq",
  "str_hash"
]

// make_list_sc is the literal allocator's SECOND face, paired with make_list:
// emit_list_literal mints `call $make_list` for the word floor (sc 0) and
// `call $make_list_sc` for a packed element (byte sc 1, f64 sc 2). Both are
// always-available and tiny (each a one-line wrapper over alloc_list_sc); the
// pairing keeps the wide literal's allocator reachable without a per-program
// scan. The float renderer is contributed CONDITIONALLY by low_refs
// (lower.mn) AT its mint sites — the show/hash nodes (show_reach_names) — so
// a float-free module drags in nothing.
// float_to_str is deliberately absent: to_string on a PROVEN float is
// lower-minted (LGlobal — the walk sees it); only the emit-minted f64
// show-fold leaf references it blind, and a program reaching that leaf
// without the proof fails LOUD at assembly (undefined $float_to_str) —
// the named floor of the m2 call-site result-width frontier
// (Hβ.m2.callsite-result-width), not a reason to drag the whole float
// family into every float-free rung.
//
// Find the index of a string in a list. Returns -1 if not found.
// target: String is an Intent Boundary (SYNTAX §"The Intent Boundary Rule"):
// the elements arrive as bare generic vars, and an unpinned `==` cannot
// prove String to the emit dispatch — it silently emitted POINTER-eq, so
// the interned "main" constant never matched the heap-parsed "main"
// (emit_start's find_main=-1 while the list held it). The pin is the
// proof; env_find(name: String) is the standing precedent.
fn ls_find_str_local(lst: [String], target: String, i) =
  ls_find_str_local_loop(lst, target, i, len(lst))

// main's declared param count — _start must supply every declared param
// or the call's type mismatches (mn-ev2's `fn main(q)`: the hardwired
// $ft1 met a two-param main). A parameterized main runs with zeroed args
// (the battery convention).
//
// Read from main's own DECL, through the decls column. The earlier form
// folded the lowered tree over two decl shapes — a plain LDeclareFn and
// the LLet-wrapped closure the wheel's own main takes — and matching
// only the first once dropped _start's argv arg and broke the m3
// assemble. That whole hazard is a tree-shape hazard: the authored
// params are a PROGRAM fact, and a program node does not know which
// shape lowering chose, so a shape it has never seen cannot mislead it.
// A library with no main folds to zero, which is the truth — _start
// calls nothing and has no params to supply. This is also the
// relocation's own reader shape: a column read, no tree
// (Hβ.lower.lowering-is-a-column).
fn main_param_count() = fold(
  0,
  (acc, h) => match graph_node_body(h) {
    NStmt(FnStmt(name, params, _ret, _effs, _body)) => if name == "main" { len(params) } else { acc },
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_)
    | NRow(_) | NParam(_) => acc,
  },
  graph_decls_at()
)

// Insert the runtime-helper state argument UNDER [a, b] on the stack
// (the W7 calling convention: a Memory-rowed helper takes (state, a, b)).
// Save-reload through the fn-preamble scratch locals, then push state.
// ─── The WIDE-VALUE boundary (§5.U at the call layer) ─────────────────
// A wide value crosses the word-protocol indirect boundary BY REFERENCE:
// emit_wide_ref spills it to a fresh cell and leaves the address (the word
// face — "a handle IS a word"); emit_wide_deref cashes a wide result back
// to its native width. RI32 is the identity. RI64/RF32/RV128 are the same
// law at their widths; their loud floors stand until a producer exists (no i64/f32/
// v128 VALUE exists yet — the reprs reach the boundary only through the f64
// gradient today).
// seq_elem_face — a sequence ELEMENT's resolved face. The element usually
// sits behind a bound var (TList(TVar(h)) with h bound to TFloat), and the
// dispatch arms match STRUCTURE — so the read chases the binding through
// the same lookup_ty projection every top-level read trusts, then strips.
// An unbound var stays itself (the word floor). Without this chase the
// [Float] eq routed to the word list_eq — pointer-comparing the element
// references, the exact lie the structural derivation forbids.
fn seq_elem_face(e) = match fold_strip(e) {
  TVar(h) => match lookup_ty(h) {
    TVar(h2) => if h2 == h { TVar(h) } else { seq_elem_face(TVar(h2)) },
    inner @ (
      TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
      | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
      | TAlias(_, _) | TValue(_)
    ) => seq_elem_face(inner),
  },
  stripped @ (
    TInt | TFloat | TUnit | TByte | TAddr | TList(_) | TTuple(_) | TFun(_, _, _) | TName(_, _)
    | TRecord(_) | TRecordOpen(_, _) | TRefined(_, _) | TReprPin(_, _) | TCont(_, _, _, _)
    | TAlias(_, _) | TValue(_)
  ) => stripped,
}

// A sequence element FACE that requires the generated sequence walker
// ($eq/$compare/$hash_l<sig> — the sequence fold leaves): a product, sum,
// or nested list, where the word runtime fns would compare/hash the element
// WORD — pointer identity standing in for structure (the silent fallback the
// eq law forbids) — and a Float, whose element the walker reads through its
// reference and orders by the folds' total order. Byte faces stay with
// their runtime family (str_*); word scalars and the unresolved floor keep
// the word fns, which ARE value-faithful for single-word elements, a sum
// with no payload among them. One predicate, three leaf dispatches and the
// fold collector all read it.
fn seq_face_structural(face) = match face {
  TRecord(_) => true,
  TRecordOpen(_, _) => true,
  TTuple(_) => true,
  TName(_, _) => !sum_is_tag(face),
  TList(_) => true,
  TFloat => true,
  TInt | TUnit | TByte | TAddr | TFun(_, _, _) | TVar(_) | TRefined(_, _) | TReprPin(_, _)
  | TCont(_, _, _, _) | TAlias(_, _) | TValue(_) => false,
}

fn ls_find_str_local_loop(lst: [String], target: String, i, n) = if i >= n {
  -1
} else if list_index(lst, i) == target {
  i
} else {
  ls_find_str_local_loop(lst, target, i + 1, n)
}
