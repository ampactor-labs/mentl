// mcp.mn — the gate served over MCP (`mentl mcp`)
//
// The Model Context Protocol face of §1's proposer closure: any external
// intelligence connects as a client and PROPOSES source; nothing executes
// unproven. The transport is newline-delimited JSON-RPC on stdio (the MCP
// stdio contract); the judge is the SAME canonical judgment the stdin
// compile runs (infer_program_converged, then the gate law batch-shaped)
// — a transport never grows its own judge. The gate's one property:
//
//   propose {source} -> PROVEN   (artifact streamed to .build/mcp/last.wat
//                                 — only proven bytes ever land there)
//                     | REFUSED  (each error named at its file-local span;
//                                 the refusal teaches)
//
// Beside it, the RESIDENT SESSION's reads (Hβ.session.resident-verbs):
// query / at / audit / teach each answer from the graph the server
// holds — the CLI verb's own projection fn, a different transport. No
// tool re-derives what the session holds; the LOOP re-derives when the
// tree moves (session_current), so a read is true by construction.
//
// stdout carries protocol lines ONLY: the WAT streams through wat_to_file
// (the march's write-through sink) and diagnostics render on stderr
// through the root handler — the forwarder below re-performs every report
// outward, so an MCP client's log pane shows the same lines the verdict
// carries. A span names the proposal's own lines: the judge reads the
// proposal as a module of the project, with the library it runs with.
import types

import backends/wasm

import cli

import driver

import egraph

import fs

import infer

import io

import json

import lists

import lower

import memory

import mentl

import pipeline

import query

import sections

import strings

// The session's collecting console — the address projection's transport
// at the MCP surface. The SAME core that narrates to stdout on the CLI
// (address_project speaking Console's print) runs under this install
// and the lines bank instead of landing on fd 1 (io.mn's own law: WHERE
// print lands is the installed handler's decision). Drained once per
// tool call.
effect ConsoleBank {
  console_taken() -> [String]
}

handler console_bank with lines = [] {
  print(msg) => resume() with lines = push(lines, msg),
  console_taken() => resume(lines),
}

// mcp_judge — the canonical judgment over one proposal, batch-shaped at
// the gate (`gated_compile`, the law the battery reads too: an error or a
// hole refuses; no proc_exit — the server outlives every verdict). The
// proposal is a module of the project it was proposed to: it is written
// beside the server's artifact and linked through the walk every compile
// uses, so its imports resolve to the library the project runs with and its
// spans name its own lines. A sibling module of the project does not
// resolve from there yet (PLAN §11, a module is a scope). The gate hears the
// proposal's own layer (`Project`), as `mentl check` does. Emission streams
// through wat_to_file so stdout stays protocol-only; a refused proposal
// never opens the artifact at all. Returns the diagnostic lines, the errors
// the judgment reported and what the gate did.
fn mcp_judge(source, wat_path) = {
  {
    fs_mkdir(".build")
    fs_mkdir(".build/mcp")
    fs_write_file("{mcp_proposal_module()}.mn", source)
  } ~> wasi_filesystem
  let judged = gated_compile(mcp_proposal_module(), wat_path, Project)
  (heard_lines(judged), judged.errors, judged.left)
}

// The module a proposal's text stands as while it is judged, beside the
// artifact; the walk reads it from `<module>.mn`.
fn mcp_proposal_module() with Pure = ".build/mcp/proposal"

// The verdict's head states exactly what the gate did — refused or proven
// whole. The diagnostic text follows verbatim: the refusal's teaching IS the
// payload.
fn mcp_verdict_text(text, nerr, left, wat_path) = {
  let head = match left {
    ArtifactRefused => "REFUSED — {int_to_str(nerr)} error(s), so nothing was built\n",
    ArtifactWritten(_) => "PROVEN — every claim in the program is proven, and it was built to {wat_path}\n",
  }
  head ++ text
}

// ─── The protocol surface — JSON-RPC response builders ───────────────
fn mcp_response(id, result) =
  json_serialize(JObj([("jsonrpc", JStr("2.0")), ("id", id), ("result", result)])) ++ "\n"

// The code rides as the Int it is: JSON-RPC codes are integers.
fn mcp_error(id, code, msg) = json_serialize(JObj([
  ("jsonrpc", JStr("2.0")),
  ("id", id),
  ("error", JObj([("code", JInt(code)), ("message", JStr(msg))]))
])) ++ "\n"

// The initialize result echoes the client's protocolVersion (the server's
// behavior does not vary by version at this surface); capabilities name
// the one thing served: tools.
fn mcp_initialize_result(params) = {
  let pv = match json_obj_get(params, "protocolVersion") {
    Some(JStr(s)) => s,
    None | Some(_) => "2025-06-18",
  }
  JObj([
    ("protocolVersion", JStr(pv)),
    ("capabilities", JObj([("tools", JObj([]))])),
    ("serverInfo", JObj([("name", JStr("mentl")), ("version", JStr("first-light"))]))
  ])
}

fn mcp_tools_result() = JObj([
  (
    "tools",
    JArr([
      JObj([
        ("name", JStr("propose")),
        (
          "description",
          JStr("Submit Mentl source to the verification gate. The medium compiles it and PROVES every claim before emission: declared effect rows, absence severances (!E — the named effect provably never performed, transitively), refinement predicates. PROVEN: the artifact is emitted to .build/mcp/last.wat beside the server. REFUSED: each undischarged claim is named at its source span and the refusal teaches the fix. Nothing executes unproven.")
        ),
        (
          "inputSchema",
          JObj([
            ("type", JStr("object")),
            (
              "properties",
              JObj([
                (
                  "source",
                  JObj([
                    ("type", JStr("string")),
                    // drift-audit: ignore — prose inside a JSON string literal (the audit's string-literal blindness)
                    (
                      "description",
                      JStr("Complete Mentl source for one module. Its imports resolve to the library the project runs with (a sibling module of the project does not resolve yet); fn main() makes it an executable.")
                    )
                  ])
                )
              ])
            ),
            ("required", JArr([JStr("source")]))
          ])
        )
      ]),
      JObj([
        ("name", JStr("query")),
        (
          "description",
          JStr("Ask the RESIDENT project graph a question — the session holds the derived project and re-derives whenever the tree moves, so every answer is a live read about the tree as it is (schemes with effect rows, Why chains, references). Question forms: 'type NAME', 'why NAME', 'refs of NAME'.")
        ),
        (
          "inputSchema",
          JObj([
            ("type", JStr("object")),
            (
              "properties",
              JObj([
                (
                  "question",
                  JObj([
                    ("type", JStr("string")),
                    // drift-audit: ignore — prose inside a JSON string literal (the audit's string-literal blindness)
                    ("description", JStr("The question, e.g. 'type main' or 'why double'."))
                  ])
                )
              ])
            ),
            ("required", JArr([JStr("question")]))
          ])
        )
      ]),
      JObj([
        ("name", JStr("at")),
        (
          "description",
          JStr("Project the eight aspects at an address in the resident project's entry file — the same read `mentl main.mn:L:C` serves: the node's type at the span, its effect row, ownership, pending obligations, the proposal fan at a ??, and the Why chain. line counts from 1; col defaults to 1.")
        ),
        (
          "inputSchema",
          JObj([
            ("type", JStr("object")),
            (
              "properties",
              JObj([("line", JObj([("type", JStr("integer"))])), ("col", JObj([("type", JStr("integer"))]))])
            ),
            ("required", JArr([JStr("line")]))
          ])
        )
      ]),
      JObj([
        ("name", JStr("audit")),
        (
          "description",
          JStr("Project every entry-file function's effect-row truth from the resident graph — the row each body reaches, which effects are severable (!E provable — the named effect provably never performed), and the capabilities each severance unlocks. The same read `mentl audit main` serves, answered live from the session's one derivation. No arguments.")
        ),
        ("inputSchema", JObj([("type", JStr("object")), ("properties", JObj([]))]))
      ]),
      JObj([
        ("name", JStr("teach")),
        (
          "description",
          JStr("Project each entry-file function's next annotation from the gradient — the one input that would unlock capabilities (an effect severance, a refinement, a representation pin). The same read `mentl teach main` serves, answered live. No arguments.")
        ),
        ("inputSchema", JObj([("type", JStr("object")), ("properties", JObj([]))]))
      ]),
      JObj([
        ("name", JStr("frontier")),
        (
          "description",
          JStr("Project the entry file's whole ranked absence field from the resident graph — the oracle's frontier, the gradient's argmax uncollapsed. Every authored ?? hole first, each carrying its proven-survivor fan and tie-teaching; then the annotation-gradient positions. The same read `mentl main.mn:0` serves. Answer it, act on the head position, and ask again — the session re-derives as the tree moves. No arguments.")
        ),
        ("inputSchema", JObj([("type", JStr("object")), ("properties", JObj([]))]))
      ]),
      JObj([
        ("name", JStr("map")),
        (
          "description",
          JStr("The read path by part — PLAN.md (the substance) and docs/SYNTAX.md (the surface) listed by heading and by PLAN §11's steps, each with its line and size; with a section, the one part it names by id (§11.2, S7.3), by title, or by a word it holds. The same read `mentl map [section]` serves.")
        ),
        (
          "inputSchema",
          JObj([("type", JStr("object")), ("properties", JObj([("section", JObj([("type", JStr("string"))]))]))])
        )
      ])
    ])
  )
])

// tools/call — the gate's propose plus the resident session's reads. A
// verdict is a SUCCESSFUL tool result whether the gate proved or refused
// (isError is reserved for a malformed call); the head line + the
// diagnostic lines are the content.
fn mcp_tool_call(id, params, at_read) = {
  let name = match json_obj_get(params, "name") {
    Some(JStr(s)) => s,
    // The protocol-null sentinel: no real tool name is empty, and the match
    // below refuses "" with -32602.
    None | Some(_) => "",
  }
  // The session's reads answer over the link the graph holds; a server
  // started outside a project judged none.
  let absent = len(link_modules()) == 0
  match name {
    "propose" => {
      let srco = match json_obj_get(params, "arguments") {
        Some(args) => json_obj_get(args, "source"),
        None => None,
      }
      match srco {
        Some(JStr(source)) => match mcp_judge(source, ".build/mcp/last.wat") {
          (banked, nerr, left) => {
            let text = mcp_verdict_text(banked, nerr, left, ".build/mcp/last.wat")
            mcp_response(
              id,
              JObj([
                ("content", JArr([JObj([("type", JStr("text")), ("text", JStr(text))])])),
                ("isError", JBool(false))
              ])
            )
          },
        },
        None | Some(_) => mcp_response(
          id,
          JObj([
            (
              "content",
              JArr([
                JObj([
                  ("type", JStr("text")),
                  ("text", JStr("propose needs arguments.source — a string of Mentl source\n"))
                ])
              ])
            ),
            ("isError", JBool(true))
          ])
        ),
      }
    },
    "at" => if absent {
      mcp_response(
        id,
        JObj([
          (
            "content",
            JArr([
              JObj([
                ("type", JStr("text")),
                (
                  "text",
                  JStr("no project graph resident — the server started outside a project (no resolvable main); at projects the living session\n")
                )
              ])
            ])
          ),
          ("isError", JBool(true))
        ])
      )
    } else {
      let lineo = match json_obj_get(params, "arguments") {
        Some(args) => json_obj_get(args, "line"),
        None => None,
      }
      match lineo {
        Some(JInt(line)) => {
          let col = match json_obj_get(params, "arguments") {
            Some(args) => match json_obj_get(args, "col") {
              Some(JInt(c)) => c,
              None | Some(_) => 1,
            },
            None => 1,
          }
          // The SAME address core the CLI serves, under the collecting
          // console — the transport is the install (at_read is the
          // closure main.mn built where the renders live).
          let banked = at_read(line, col)
          mcp_response(
            id,
            JObj([
              ("content", JArr([JObj([("type", JStr("text")), ("text", JStr(str_concat_all(banked)))])])),
              ("isError", JBool(false))
            ])
          )
        },
        None | Some(_) => mcp_response(
          id,
          JObj([
            (
              "content",
              JArr([
                JObj([("type", JStr("text")), ("text", JStr("at needs arguments.line (an integer, counting from 1)\n"))])
              ])
            ),
            ("isError", JBool(true))
          ])
        ),
      }
    },
    "frontier" => if absent {
      mcp_response(
        id,
        JObj([
          (
            "content",
            JArr([
              JObj([
                ("type", JStr("text")),
                (
                  "text",
                  JStr("no project graph resident — the server started outside a project (no resolvable main); frontier projects the living session\n")
                )
              ])
            ])
          ),
          ("isError", JBool(true))
        ])
      )
    } else {
      // The field read (address line 0 — the whole ranked absence
      // field) through the same at transport.
      let banked = at_read(0, 1)
      mcp_response(
        id,
        JObj([
          ("content", JArr([JObj([("type", JStr("text")), ("text", JStr(str_concat_all(banked)))])])),
          ("isError", JBool(false))
        ])
      )
    },
    "audit" => if absent {
      mcp_response(
        id,
        JObj([
          (
            "content",
            JArr([
              JObj([
                ("type", JStr("text")),
                (
                  "text",
                  JStr("no project graph resident — the server started outside a project (no resolvable main); audit projects the living session\n")
                )
              ])
            ])
          ),
          ("isError", JBool(true))
        ])
      )
    } else {
      // The SAME projection the CLI's audit verb serves (audit_project,
      // one home) over the declarations of the module the session holds —
      // no derivation, a living read.
      let text = audit_project(link_entry_decls())
      mcp_response(
        id,
        JObj([
          ("content", JArr([JObj([("type", JStr("text")), ("text", JStr(text))])])),
          ("isError", JBool(false))
        ])
      )
    },
    "teach" => if absent {
      mcp_response(
        id,
        JObj([
          (
            "content",
            JArr([
              JObj([
                ("type", JStr("text")),
                (
                  "text",
                  JStr("no project graph resident — the server started outside a project (no resolvable main); teach reads the living session\n")
                )
              ])
            ])
          ),
          ("isError", JBool(true))
        ])
      )
    } else {
      // teach_project — the gradient's next-annotation read, the CLI
      // verb's own projection over the declarations of the module the
      // session holds.
      let text = teach_project(link_entry_decls())
      mcp_response(
        id,
        JObj([
          ("content", JArr([JObj([("type", JStr("text")), ("text", JStr(text))])])),
          ("isError", JBool(false))
        ])
      )
    },
    "query" => if absent {
      mcp_response(
        id,
        JObj([
          (
            "content",
            JArr([
              JObj([
                ("type", JStr("text")),
                (
                  "text",
                  JStr("no project graph resident — the server started outside a project (no resolvable main); query reads the living session\n")
                )
              ])
            ])
          ),
          ("isError", JBool(true))
        ])
      )
    } else {
      let qo = match json_obj_get(params, "arguments") {
        Some(args) => json_obj_get(args, "question"),
        None => None,
      }
      match qo {
        Some(JStr(question)) => {
          // The read of the LIVE graph — the session's instances answer;
          // no derivation, no restore, no swap (the resident form the
          // swap-crossing refutation named).
          let text = ask(parse_query_string("", question)) |> render_query_result
          mcp_response(
            id,
            JObj([
              ("content", JArr([JObj([("type", JStr("text")), ("text", JStr("{text}\n"))])])),
              ("isError", JBool(false))
            ])
          )
        },
        None | Some(_) => mcp_response(
          id,
          JObj([
            (
              "content",
              JArr([
                JObj([("type", JStr("text")), ("text", JStr("query needs arguments.question — e.g. 'type main'\n"))])
              ])
            ),
            ("isError", JBool(true))
          ])
        ),
      }
    },
    // The documents need no project: the map answers in any session.
    "map" => {
      let section = match json_obj_get(params, "arguments") {
        Some(args) => match json_obj_get(args, "section") {
          Some(JStr(s)) => Some(s),
          None | Some(_) => None,
        },
        None => None,
      }
      match read_path_map(section) ~> wasi_filesystem {
        (text, code) => mcp_response(
          id,
          JObj([
            ("content", JArr([JObj([("type", JStr("text")), ("text", JStr(text))])])),
            ("isError", JBool(code != 0))
          ])
        ),
      }
    },
    _ => mcp_error(
      id,
      -32602,
      "unknown tool: {name} — the server serves propose, query, at, frontier, audit, teach, and map"
    ),
  }
}

fn mcp_params_of(req) = match json_obj_get(req, "params") {
  Some(p) => p,
  None => JObj([]),
}

fn mcp_request(id, method, params, at_read) = match method {
  "initialize" => mcp_response(id, mcp_initialize_result(params)),
  "tools/list" => mcp_response(id, mcp_tools_result()),
  "tools/call" => mcp_tool_call(id, params, at_read),
  "ping" => mcp_response(id, JObj([])),
  _ => mcp_error(id, -32601, "method not found: {method}"),
}

// A message without an id is a notification (initialized, cancelled, …):
// consumed, never answered — the empty response line is the no-response.
fn mcp_dispatch(req, at_read) = {
  let method = match json_obj_get(req, "method") {
    Some(JStr(s)) => s,
    // The protocol-null sentinel: no real method is empty, and `mcp_request`
    // refuses "" with -32601.
    None | Some(_) => "",
  }
  match json_obj_get(req, "id") {
    None => "",
    Some(id) => mcp_request(id, method, mcp_params_of(req), at_read),
  }
}

fn mcp_handle(line, at_read) = match json_parse(line) {
  JOk(req, _) => mcp_dispatch(req, at_read),
  JErr(m, pos) => mcp_error(JNull, -32700, "parse error at byte {int_to_str(pos)}: {m}"),
}

// A client that frames with \r\n leaves the \r on the line after the
// newline is consumed; strip it so json_parse sees the message alone.
fn strip_cr(line) = {
  let n = byte_len(line)
  if n > 0 && byte_at(line, n - 1) == 13 { str_slice(line, 0, n - 1) } else { line }
}

// The LIVING check — the session graph tracks the tree (the
// incremental cursor's session face): before a message is answered,
// the tree's manifest recomputes and compares against the banked one;
// a moved tree has its edit judged into the resident world at the grain
// it was made (driver_session_cone): the statements the edit rewrote or
// moved, and every statement whose judgment read one of them, are read
// again and judged, the rest keep their nodes, and the manifest replaces
// the banked one. NEVER a restore: the swap-crossing law's third
// constraint IS this form — the image stays the session's own memory, and
// the update is durable growth. What the session judged is said on its
// log, so the cost of an edit is a number a person reads.
//
// The check reads every module's text to hash it, and on an unmoved tree
// nothing it allocated outlives the comparison: the bytes die with the
// answer's arena (session_line_loop). Structural == over the word-triple
// lists.
fn session_current(manifest) = if driver_manifest() == manifest {
  manifest
} else {
  match driver_session_cone("main", session_forget) {
    (n, m) => eprint_string("session: tree moved — re-judged {int_to_str(n)} declaration(s) in {int_to_str(m)} module(s); the graph is current\n"),
  }
  driver_manifest()
}

// The session's generation clear, handed to the cone as a value: the banked
// reports and the claims made where the edit replaced go, and every other
// statement's stand. The cone hands it what its judgment replaces BEFORE the
// judgment — a stale generation's entries must not shadow the current truth,
// their spans belonging to a tree that no longer exists — and the modules the
// new link no longer holds, which no judgment would ever clear: a project
// opened over a lesson's session kept its libraries' reports, and the Lens
// over the next four-line lesson held 519 of them (measured in the browser,
// 2026-10-06).
fn session_forget(gone) = {
  diag_forget(gone)
  verify_forget(gone)
}

// The serve loop — a RAW recursion over the session's manifest (the
// battery_loop law holds; at_read is a stored value). Each message is an
// ARENA (lib/arena.mn): the response prints inside it, and its exit
// reclaims what the message allocated except what it published — the next
// manifest, and what it stored into older
// memory: a read's parse nodes and any spine page they opened, a moved
// tree's fresh generation, every one journaled where it was stored. So
// the server's heap holds what the session learned and nothing else,
// every propose's full compile included. read_stdin_line answers "" at
// EOF; a blank line is outside the newline-delimited-JSON contract, so
// "" ends the session on either reading.
fn mcp_loop(manifest, at_read, current) = {
  let next = {
    let line = read_stdin_line()
    if byte_len(line) == 0 {
      None
    } else {
      // `current` is the living check AS A VALUE (the at_read precedent):
      // the resident path passes session_current — its derivation row
      // absorbed by the session bracket — and the no-project path passes
      // the Pure identity, so the loop stays row-polymorphic and the
      // derivation effects never reach the bare root.
      let m2 = current(manifest)
      let out = mcp_handle(strip_cr(line), at_read)
      if byte_len(out) > 0 { print_string(out) }
      Some(m2)
    }
  } ~> arena
  match next {
    None => (),
    Some(m2) => mcp_loop(m2, at_read, current),
  }
}

// ─── mentl session — the resident graph as the CLI's default transport ──
//
// The graph derives ONCE and lives for the session, tracking the tree per
// request (session_current — the same living check the mcp loop runs per
// message), and answers verbs over a one-line wire speaking the CLI's OWN
// grammar: a line is the verb's argv, tab-joined, parsed by
// parse_cli_args — one grammar, every transport. WHICH verbs answer
// resident is the medium's own dispatch, `answer`, passed in as a value
// from main.mn where the verbs live (session_answer, beside the cold
// dispatch it mirrors); a verb it does not serve answers the MISS
// sentinel and the host falls back to the cold exec.
//
// ONE TRANSPORT. The host owns the process's input — a browser worker over
// its shared-memory channel, the mentl command over a pipe — and gets one
// answer per stdin line (session_line_loop), the answer written whole
// before the next line is read. The listener this verb once served (a
// socket the host preopened) is gone with the socket seam: WASI p1 has no
// bind/listen, and a resident session the CLI shares between invocations
// is a pair of FIFOs the shim would own
// (`Hβ.cli.resident-session-over-fifos`), never a socket in the wheel.
//
// THE GUARD IS INSIDE THE BRACKET, which is mcp_run's own lesson one verb
// over — "The artifact directory is made INSIDE the bracket, because that
// is..." — learned there and not here. `fs_exists` is a Filesystem op and
// dispatch_invocation installs env / graph / mutate / diagnostics and no
// Filesystem, so this guard ran in a world that cannot answer it. It
// worked only while a stateless singleton could be direct-called with no
// record at all; the uniform world bracket ended that, and the guard
// trapped at its own dispatch (ev_declaring_node, i32.const 100524 =
// Filesystem, slot 0, pinned at 0xafd83 in session_run). The installs
// cost nothing on the path that reports no project.
fn session_run(answer) = if driver_module_path("main") == None {
  eprint_string("mentl session: no resolvable main here — the session holds a project's living graph; run it in a project directory\n")
  1
} else {
  driver_link("main")
  eprint_string("mentl session: graph resident on stdin — each line is a verb's argv, tab-joined; the answer is written before the next line is read\n")
  session_line_loop(driver_manifest(), answer, session_current)
  0
} ~>
// The filesystem is the OUTERMOST install: an arm's performs resolve outer
// of its own install, and the query handler's arms read the filesystem (the
// census's path class asks whether a cited path names a file).
query_context ~> mentl_default ~> arm_state_ctx([], OneShot, None) ~> spec_registry ~> wasi_filesystem ~> infer_context ~> progress_stderr(false)

// What an answer cost the image, on the session's log. Each answer is an
// arena (lib/arena.mn), so this is what it PUBLISHED: the nodes a question
// minted and the spine pages they opened, the edges an accept drew, a moved
// tree's fresh generation — what the session learned, and nothing it only
// computed on the way to the answer.
fn session_cost(before) =
  eprint_string("session: the answer cost {int_to_str(addr_diff(heap_mark(), before))} bytes of image\n")

// One stdin line = one answer, for a host that owns the process's input.
// THE READ IS THE FRAME: the answer is written whole before the session
// asks for its next line, so a host serving this input knows the answer is
// complete at the moment the session reads again — exact by construction,
// with no delimiter in the answer to strip. EOF (or an empty line, outside
// the wire's grammar as in the mcp loop) ends the session.
fn session_line_loop(manifest, answer, current) = {
  let before = heap_mark()
  let next = {
    let line = strip_cr(read_stdin_line())
    if byte_len(line) == 0 {
      None
    } else {
      match answer(line, current(manifest)) {
        (text, held) => {
          print_string(text)
          Some(held)
        },
      }
    }
  } ~> arena
  match next {
    None => (),
    Some(m3) => {
      session_cost(before)
      session_line_loop(m3, answer, current)
    },
  }
}

// The wire is tab-joined argv (quoting survives the shell boundary);
// a trailing tab leaves one empty tail element, dropped here.
fn session_argv(line) = {
  let parts = split("\t", line)
  let trimmed = if len(parts) > 0 && byte_len(last(parts)) == 0 { drop_last(parts) } else { parts }
  ["mentl"] ++ trimmed
}

// The wire's one word for "not here": a host reading it re-runs the verb
// cold, where the whole answer — stdout, stderr and the exit code — is said
// by the process that computed it.
fn session_miss() = "MENTL-SESSION-MISS\n"

// The RESIDENT SESSION (Hβ.session.resident-verbs): the server derives
// the project graph ONCE, in its OWN memory, before the loop — the
// analysis instances live for the server's whole life and every query
// answers as a read. All three measured constraints hold by
// construction: no swap exists, per-request strings live in the same
// process, the image IS the session's memory. And the graph is LIVING:
// the loop's session_current check re-derives into this same world
// whenever the tree moves, so a read is true by construction — an
// agent edits a file, asks, and the answer is about the tree as it is.
// A propose still judges in its OWN nested infer_context — fresh
// innermost instances shadow the session's (the world law), and its
// mints die with the request region while the session's spine lives
// below every mark. The derivation is resolution-conditional (the
// prelude-seed precedent): outside a project, the gate serves propose
// alone and query answers honestly.
fn mcp_run(at_read) = {
  eprint_string("mentl mcp: the gate on stdio — nothing executes unproven\n")
  // ONE bracket, BOTH paths: the no-project session's tool arms carry
  // the same static rows (audit's Verify + Tighten, query's ask) even
  // though their guards answer "no project graph resident" at runtime —
  // a bare mcp_loop leaked those rows to main and the executable gate
  // refused (verify_ledger is stateful, so no default grounds it). The
  // conditional lives inside the bracket; the installs cost nothing on
  // the empty path.
  {
    // The artifact directory is made INSIDE the bracket, because that is
    // where the Filesystem handler is: the op answers here, and this
    // server's row says it creates directories.
    fs_mkdir(".build")
    fs_mkdir(".build/mcp")
    if driver_module_path("main") != None {
      driver_link("main")
      eprint_string("session: graph resident — {int_to_str(len(link_modules()))} modules; queries answer live\n")
      // The banked manifest is the tree identity this derivation answered;
      // session_current compares against it per message.
      mcp_loop(driver_manifest(), at_read, session_current)
    } else {
      mcp_loop([], at_read, { m => m })
    }
  } ~> query_context ~> mentl_default ~> arm_state_ctx([], OneShot, None) ~> spec_registry ~> wasi_filesystem ~> infer_context ~> progress_stderr(false)
  0
}
