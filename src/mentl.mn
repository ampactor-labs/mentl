// mentl.mn — the teaching substrate · the oracle (spec 09)
//
// Not a feature. The thesis made flesh. Eight tentacles on the
// shared inference substrate, each a handler reading through
// GraphRead + EnvRead. Distributed cognition over one graph;
// the mascot is an octopus because the architecture IS octopus
// neurology — local reasoning, shared nervous system.
//
// The oracle loop (PLAN §1 · spec 09):
//   graph_push_checkpoint()
//     → apply tentative annotation via graph_bind / graph_bind_row
//     → run inference, run Verify
//     → graph_rollback(checkpoint)
//     → return a PROVEN candidate patch (not a guess)
//
// Synth is peer-handler fall-through: enumerative / SMT / LLM / user,
// each a ~> stage. The compiler verifies; proposers merely propose.
// AI obsolescence is mechanism, not rhetoric: proposers are handlers
// on an effect the compiler exposes.
import types

import graph

import effects

import infer

import query

// Mentl-owned ADTs
//
// Each variant carries an Option(Span) — Some when the candidate
// originated from a user site (hovered hole, quick-fix request);
// None for fully-internal speculation. narrow_row threads this into
// the Located reason so the Why chain reads at the user's
// coordinates, not 0:0-0:0.
type Annotation
  = APure(Option(Span))
  | ARefined(String, Predicate, Option(Span))
  | AOwn(String, Option(Span))
  | ARef(String, Option(Span))
  | AWrapHandler(String, Int, Option(Span))
  // The general severance: !<name> for ANY name the link performs
  // (Hβ.teach.severance-vocabulary-from-link). The fixed
  // ANotAlloc/ANotIO/ANotNetwork trio is DELETED into it — known
  // names keep their rich labels via capabilities_for_severance.
  | ANotEffect(String, Option(Span))

// handler_name, the target fn's handle, span;
// proposes wrapping the target's body in a
// handler that absorbs an offending effect
type Capability
  = CMemoize
  | CParallelize
  | CCompileTimeEval
  | CRealTime
  | CSandbox
  | CEliminateBoundsCheck
  | CZeroCopy
  | CDeterministicDrop
  // The general severance's unlock: the proven absence of a NAMED
  // effect (the crown's own vocabulary as a capability label).
  // Appended LAST so existing variant tags are unshifted.
  | CProvenAbsence(String)

type Patch = Patch(Span, String)

// span to replace, new text
type Explanation = Explanation(String, String, String, Option(Patch), Reason)

// code: E_MissingVariable, V_Pending, W_Suggestion, …
//
// canonical_md: docs/errors/<code>.md
//
// summary: one-line human-readable
//
// fix, present when MachineApplicable
//
// reason_chain: the Why chain
//
// The propose projection: every PROVEN survivor as (Node, Reason), and every
// vocabulary candidate the ALLOWED row refused as (name, Reason) — the
// rejection keeps its Why (PLAN §5: retain the rejection reasons; the row
// pruning IS the second moat, and a pruned candidate the developer cannot
// see is a guess they cannot audit).
type Proposals = Proposals([(Node, Reason)], [(String, Reason)])

// survivors, rejected
type Context = Context([(String, Binding, Reason, SchemeKind)], EffRow, String, Span)

// scope bindings (the Env's own entries), the LIVE active-effect row, the enclosing decl's name ("" at top level — the vocabulary excludes candidates whose free-name closure reaches it: proposing the hole's own enclosing fn, or anything that transitively calls it, is nontermination by construction), and the HOLE'S OWN SPAN — the position the proposals are for, the ranker's nearness anchor (candidate_rank reads decl and use nearness against it).
// The full Boolean row reaches synth — not a
// flattened positive [EffName]. So `!E` (the
// negative capability, PLAN §4⑥) is readable at
// the synth gate: the row's ABSENT field IS the
// forbidden set (`let EfRow(_, a, _) = row`),
// carried on the one row the graph already
// bound. The cursor carries the row handle,
// never a lossy name-list re-derived from it
// (Carried-Truth).
type Candidate = Candidate(Node, Reason)

// AST fragment + why it was proposed
//
// Teach effect — the five tentacle entry points (PLAN §1). `mentl_default`
// projects the substrate for the developer: hover, gradient, why-chain, error catalog,
// unlock preview.
effect Teach {
  teach_here(String, Span, Ty)
  teach_gradient(Int) -> Option(AnnotationSuggestion)
  teach_why(Int) -> Reason
  teach_error(String, Span, Reason) -> Explanation
  teach_unlock(Annotation) -> Capability
}

// ═══ Synth effect — proposers as handlers ══════════════════════════  // drift-audit: ignore — D.1.R reserved block; decoration removal is a separate sub-handle
// Three ops: propose (main), verify_candidate (Mentl-internal),
// enumerate_inhabitants (multi-shot raw). Any proposer — enumerative,
// SMT, LLM, user — plugs in as a handler. The compiler verifies.
effect Synth {
  // proven survivors with their Whys + row-rejected vocabulary with theirs
  synth_propose(Ty, EffRow, Context) -> Proposals
  verify_candidate(Candidate, Ty) -> Bool
  enumerate_inhabitants(Ty, EffRow, Context) -> [Node]
}

// Default Teach handler — the substrate's self-projection. Reads the graph through
// GraphRead. Accumulates `teach_here` entries so the driver renders them as hover info.
// Gradient and why use the speculative oracle and reason DAG respectively.
handler mentl_default with annotations = [], performed = [] {
  teach_here(name, span, ty) => resume() with annotations = [(name, span, ty)] ++ annotations,
  teach_gradient(handle) => // The link's PERFORMED-name union, computed once and held as
  // handler state (handler = state — the Mentl-native memo): the
  // severance vocabulary is what the program actually performs, so
  // per-fn asks stay O(1) after the first. An empty union (a link
  // performing nothing) recomputes per ask — bounded by its own
  // emptiness.
  if len(performed) == 0 {
    let ps = performed_names_of_link()
    resume(gradient_next(handle, ps)) with performed = ps
  } else {
    resume(gradient_next(handle, performed))
  },
  teach_why(handle) => resume(why_from_handle(handle)),
  teach_error(code, span, reason) => resume(Explanation(code, "docs/errors/{code}.md", catalog_summary(code), None, reason)),
  teach_unlock(annotation) => resume(unlock_capability(annotation)),
}

// Speculative oracle: for each candidate annotation, checkpoint → tentative apply →
// run unification → record → rollback. Only PROVEN annotations reach the user.
// The trail (graph.mn) makes the run O(M) where M = mutations recorded.
//
// Returns Option(AnnotationSuggestion) per Hμ.cursor §2 + GR §3.2 (live).
// Internally pick_highest_leverage produces Option<(Annotation, Capability)>;
// `to_annotation_suggestion` wraps at the boundary with kind / annotation
// text / unlocked-capability labels / Reason — the public shape Cursor
// reads off CursorView.teach.
fn gradient_next(handle, performed) = {
  let node = graph_chase(handle)
  match node {
    GNode(_, anchor_reason) => match node {
      GNode(kind, _) => match kind {
        NBound(ty) => match ty {
          TFun(_, _, _) => {
            let proven = try_each_annotation(handle, gradient_candidates(ty, performed), ty)
            match pick_highest_leverage(proven) {
              None => None,
              Some(pair) => match pair {
                (ann, _cap) => Some(to_annotation_suggestion(ann, anchor_reason)),
              },
            }
          },
          _ => None,
        },
        _ => None,
      },
    },
  }
}

// The link's performed-name union WITH PREVALENCE: every env scheme's
// TFun row, row_names'd and counted by the name handle (identity is a
// contract — one interned word per name), sorted most-performed-first
// at the one memo point. The count grades the law's "E happens in this
// program" — a name half the link performs makes a stronger severance
// than one fn's plumbing effect — and the sort IS the tie-ranking:
// pick_highest_leverage's fallback takes the first proven candidate,
// so equal-leverage generics resolve by prevalence, never by env
// enumeration order (the uniform-!SmtSolver symptom). The env is the
// one home the QEffects facet already reads per name; this is the
// same read, link-wide, run once per Teach install and held as
// handler state. (The first cut walked decls-column HANDLES through
// lookup_ty and measured an EMPTY union — a decl node's bound type is
// not its fn's TFun; the scheme is.)
fn performed_names_of_link() = match env_snapshot() {
  Env(entries) => sort_by_count_desc(entries_row_names(entries, [])),
}

fn entries_row_names(entries, acc) = match entries {
  [] => acc,
  [e, ...rest] => entries_row_names(rest, names_union_into(acc, entry_row_names(e))),
}

fn entry_row_names(e) = match e {
  (_, scheme, _, _) => match judgment_ty(scheme) {
    TFun(_, _, row) => row_names(row),
    _ => [],
  },
}

fn names_union_into(acc, names) = match names {
  [] => acc,
  [n, ...rest] => names_union_into(name_count_bump(acc, n), rest),
}

fn name_count_bump(acc, n) = match acc {
  [] => [(n, 1)],
  [p, ...rest] => match p {
    (m, c) => if eff_name_handle(m) == eff_name_handle(n) {
      [(m, c + 1)] ++ rest
    } else {
      [p] ++ name_count_bump(rest, n)
    },
  },
}

fn sort_by_count_desc(pairs) = match pairs {
  [] => [],
  [p, ...rest] => insert_by_count(p, sort_by_count_desc(rest)),
}

fn insert_by_count(p, sorted) = match sorted {
  [] => [p],
  [q, ...rest] => match (p, q) {
    ((_, pc), (_, qc)) => if pc >= qc { [p] ++ sorted } else { [q] ++ insert_by_count(p, rest) },
  },
}

// One general-severance candidate per performed BARE name, in the
// union's prevalence order (most-performed first — the tie-ranking) —
// the parameterized and Pure entries stay out (an instance severance
// is band A's precision work; Pure severs nothing).
fn severance_negations(performed) = match performed {
  [] => [],
  [p, ...rest] => match p {
    (n, _count) => match n {
      ENamed(_) => [ANotEffect(eff_name_str(n), None)] ++ severance_negations(rest),
      EParameterized(_, _) => severance_negations(rest),
      EPure => severance_negations(rest),
    },
  },
}

// The gradient's candidate enumeration — ONE home, two readers: the
// cursor's single-step pick (gradient_next) and the oracle's full
// ranked queue (candidates_at, oracle.mn). The severance vocabulary
// IS the link's performed set: one ANotEffect candidate per performed
// name (known names keep their rich capability labels through
// capabilities_for_severance), each proven by the same
// negation-narrowing row read. `!E` is informative exactly when E
// happens in this program and is absent from THIS fn's row — the
// proof loop filters the present ones.
fn gradient_candidates(ty, performed) = match ty {
  TFun(params, _ret, _row) => [APure(None)] ++ severance_negations(performed) ++ ownership_candidates(params),
  _ => [],
}

// The fork pre-warm's per-candidate step: a severance name meets the
// intern table OUTSIDE any fork extent (the each in
// try_each_annotation), so every in-fork intern_str is a probe HIT.
fn intern_severance_name(ann) = match ann {
  ANotEffect(name, _) => {
    intern_str(name)
    ()
  },
  _ => (),
}

// Boundary wrap — (Annotation, Capability) inside the speculative
// loop becomes the public AnnotationSuggestion shape Cursor reads.
// Per Hμ.cursor §2.1: kind comes from the Annotation tag (drift 8 —
// SuggestionKind ADT, never a string flag); annotation text is
// `show_annotation`'s residue; unlocks is `capabilities_for_annotation`'s
// list (multiple capabilities per annotation, not the lossy single
// `unlock_capability`); reason wraps the anchor with Located.
fn to_annotation_suggestion(ann, anchor_reason) = AnnotationSuggestion(
  suggestion_kind_of(ann),
  show_annotation(ann),
  capability_labels(capabilities_for_annotation(ann)),
  suggestion_reason(ann, anchor_reason)
)

// Map an Annotation variant to its SuggestionKind axis. Drift 8
// closure: SuggestionKind is the tagged dispatch surface; the
// match below is the only place the mapping lives.
fn suggestion_kind_of(ann) with Pure = match ann {
  APure(_) => SuggestEffectRow,
  ARefined(_, _, _) => SuggestRefinement,
  AOwn(_, _) => SuggestOwnership,
  ARef(_, _) => SuggestOwnership,
  AWrapHandler(_, _, _) => SuggestEffectRow,
  ANotEffect(_, _) => SuggestEffectRow,
}

// Capability ADT to display label list. Used by AnnotationSuggestion.unlocks.
// Composition over `show_capability` (already in mentl.mn).
fn capability_labels(caps) with Memory + Alloc = map(show_capability, caps)

// Suggestion's Reason edge. Wraps the candidate's anchor reason in a
// Located/Unmarked chain that the Why-tentacle walks. Span comes from
// the annotation's source-span field when present (user-originated
// candidate), span_zero otherwise (fully internal speculation).
fn suggestion_reason(ann, anchor) = {
  let span = unwrap_source_span(annotation_source_span(ann))
  Located(span, Inferred(suggestion_kind_label(suggestion_kind_of(ann))))
}

fn annotation_source_span(ann) with Pure = match ann {
  APure(sp) => sp,
  ARefined(_, _, sp) => sp,
  AOwn(_, sp) => sp,
  ARef(_, sp) => sp,
  AWrapHandler(_, _, sp) => sp,
  ANotEffect(_, sp) => sp,
}

fn suggestion_kind_label(k) with Pure = match k {
  SuggestEffectRow => "gradient: effect-row tightening",
  SuggestOwnership => "gradient: ownership marker",
  SuggestRefinement => "gradient: refinement predicate",
  SuggestReturnType => "gradient: result-type annotation",
}

// Try each candidate: checkpoint → tentative apply → verify → rollback.
// Per-candidate is the divergent-fanout topology — each ann's
// checkpoint isolates it from siblings, which IS the proof-search step;
// map's tail loop runs them. Per-candidate proof on distinct cores
// (peer Hβ.cursor.speculative-compile, needs per-thread graph) is a
// `><` fanout under its own `~> Thread` at this site — the schedule is
// read at the fanout's install, never across a call
// (Hβ.lower.schedule-specialized-callee). Symmetric with the oracle's
// per-position dispatch at src/oracle.mn:309.
// Returns [(Annotation, Capability)] for annotations that passed.
fn try_each_annotation(handle, candidates, base_ty) = {
  // PRE-WARM THE INTERN below the fork marks: every severance name is
  // interned here ONCE, so every in-fork intern_str is a pure probe HIT.
  // A fork extent must never FIRST-intern — the table is durable state,
  // and a first insert allocates its canonical row IN the region: the
  // reset zeroes it and the next candidate's probe walks garbage
  // (measured: the field leg trapped in intern_probe the moment this
  // site's heap leg landed — the image/scratch interleave's first live
  // case, the two-channel design's own witness). The walk covers ANY
  // candidate name — the fixed three-literal warm died with the trio.
  //
  candidates |> each(intern_severance_name)
  candidates |> map((ann) => {
    // The FORK TRIPLE (R6): this site held only the graph leg — the
    // recon's "half a fork pair" — so a candidate's allocations
    // outlived it and its world isolation rode extent-balance alone.
    // All three legs now, the synth fan's exact shape.
    //
    let cp = graph_push_checkpoint()
    let mark = heap_mark()
    let w = world_top()
    let proven = apply_annotation_tentatively(handle, ann, base_ty)
    let ok = proven && verify_after_apply(handle)
    graph_rollback(cp)
    heap_reset(mark)
    world_restore(w)
    (ann, ok)
  }) |> filter((pair) => match pair {
    (_, ok) => ok,
  }) |> map((pair) => match pair {
    (ann, _) => (ann, unlock_capability(ann)),
  })
}

// Speculative apply: compute the narrowed type/row, graph_bind it, and
// return the PROOF. For a row claim the proof is row_subsumes(body_row,
// narrowing) — the SAME engine the fn-finalize gate runs — read from
// base_ty's own row, the live body truth the graph already carries. The
// old contract returned unit and left "proven" to a post-bind boundness
// read; a bind always sticks, so an !Alloc claim on an allocating body
// read back proven (the boundness-only hole, seen RED on `++`-carrying
// main before this returned the subsumption).
fn apply_annotation_tentatively(handle, ann, base_ty) = match ann {
  APure(sp) => narrow_row_proven(handle, base_ty, mk_ef_pure(), sp),
  ANotEffect(name, sp) => // The general severance: the negation-narrowing proof for ANY name
  // the link performs. The name is user-facing vocabulary at the one
  // mint; identity is the intern handle from here on (EffName-is-a-
  // handle LANDED — comparisons are word i32.eq by type).
  narrow_row_proven(handle, base_ty, mk_ef_neg([ENamed(intern_str(name))]), sp),
  ARefined(_, pred, sp) => {
    // Narrowing the type via refinement — perform verify against the
    // narrowed predicate. Ledger captures; rollback removes. The ledger
    // carries this claim's discharge (band F's own path), so the apply
    // itself admits.
    let span = unwrap_source_span(sp)
    verify(graph_module_current(), span, pred, Refinement(pred, PTrue))
    true
  },
  AOwn(_, _) => // parameter-level marker; type narrowing at call sites
  true,
  ARef(_, _) => true,
  AWrapHandler(handler_name, _target, sp) => {
    // H5: speculatively narrow the row by subtracting the named
    // handler's absorbed effects. The catalog lookup tells us what
    // the handler handles; row arithmetic does the rest. The actual
    // wrap (splice `handle ... with handler_name` around body) is
    // a TEXT patch — out of substrate, into the patcher's surface.
    let absorbed = catalog_handled_effects(handler_name)
    if len(absorbed) == 0 {
      true
    } else {
      let absorbed_row = mk_ef_closed(absorbed)
      // The narrowed row is base_row - absorbed_row. The wrap's row
      // arithmetic IS its proof: the proposed text patch installs the
      // absorbing handler, so the residual row is true BY the wrap —
      // unlike a bare narrowing, no body claim needs discharging.
      match base_ty {
        TFun(_params, _ret, base_row) => {
          let narrowed = diff_row(base_row, absorbed_row)
          narrow_row(handle, base_ty, narrowed, sp)
          true
        },
        _ => true,
      }
    }
  },
}

// A row NARROWING's apply + proof, one home: bind the narrowed TFun
// (trail-reverted on rollback) and return whether the body's own row —
// base_ty's row, the live truth inference already wrote — subsumes into
// the claim. row_subsumes is the fn-finalize gate's engine (the crown's
// by-name negation membership included), so "proven" here means exactly
// what the declaration gate would prove: with Pure demands the empty row,
// !E demands E provably absent.
fn narrow_row_proven(handle, base_ty, narrow, source_span) = match base_ty {
  TFun(_, _, base_row) => {
    narrow_row(handle, base_ty, narrow, source_span)
    row_subsumes(resolve_row(base_row), narrow)
  },
  _ => false,
}

fn unwrap_source_span(opt) with Memory + Alloc = match opt {
  Some(s) => s,
  None => span_zero(),
}

// H5: the effects a named handler absorbs — read LIVE from its env
// binding, never a static string-keyed table. A handler binds as
// HandlerKind(the handled effect name, ...) (types.mn:117): the env already
// PROVES which effect each handler absorbs (the `~>` row algebra
// row(expr ~> h) = (row − E) ⊕ R reads the same E). The AWrapHandler
// proposer reads it the same way — carry the handle, read the binding
// live; the string table that re-derived this is dissolved. A name
// that binds no handler (not found, or a non-handler kind) absorbs
// nothing.
fn catalog_handled_effects(handler_name) with Intern + Memory + EnvRead + !Mutate + Alloc = match env_lookup(handler_name) {
  None => [],
  Some(entry) => match entry {
    (_scheme, _reason, kind) => match kind {
      HandlerKind(_, _, _, arms) => // The handled effect is a live projection of the arms (§2), not a field.
      [ENamed(intern_str(derive_handler_ename(arms, handler_name)))],
      _ => [],
    },
  },
}

// H5: capability unlocks for an annotation. !Alloc unlocks
// CRealTime; !IO + Pure unlock CCompileTimeEval; etc. The list is
// returned by render_audit's severance section.
fn capabilities_for_annotation(ann) with Memory + Alloc + Intern = match ann {
  APure(_) => [CMemoize, CCompileTimeEval, CParallelize],
  ARefined(_, _, _) => [],
  AOwn(_, _) => [CDeterministicDrop, CZeroCopy],
  ARef(_, _) => [],
  AWrapHandler(_, _, _) => // unlocks depend on what's wrapped
  [],
  ANotEffect(name, _) => // the general severance's unlock: the known names keep their rich
  // labels (Alloc → RealTime, IO → CompileTimeEval+Sandbox, Network →
  // Sandbox — capabilities_for_severance's own mapping); an unmapped
  // name unlocks its proven absence itself, the crown's vocabulary as
  // the capability.
  match capabilities_for_severance(ENamed(intern_str(name))) {
    [] => [CProvenAbsence(name)],
    known => known,
  },
}

// H5: capability unlocks for a SEVERANCE — adding `!E` to an fn
// that doesn't perform E. Mirrors capabilities_for_annotation but
// keyed by EffName (severance candidate's name).
fn capabilities_for_severance(name) = match name {
  ENamed(h) => if h == intern_str("Alloc") {
    [CRealTime]
  } else if h == intern_str("IO") {
    [CCompileTimeEval, CSandbox]
  } else if h == intern_str("Network") {
    [CSandbox]
  } else {
    []
  },
  EParameterized(_, _) => [],
  EPure => // the identity severs no capability
  [],
}

fn narrow_row(handle, base_ty, narrow, source_span) = match base_ty {
  TFun(params, ret, _) => {
    let narrowed = TFun(params, ret, narrow)
    // The trail reverts this bind on rollback. source_span is Some(s)
    // when the candidate originated at a user site (hovered hole,
    // quick-fix request); None for fully-internal speculation, in
    // which case we fall back to span_zero(). The Located wrapper
    // gives the Why Engine coordinates to render.
    graph_bind(
      handle,
      narrowed,
      Located(unwrap_source_span(source_span), Inferred("mentl speculative narrow"))
    )
  },
  _ => (),
}

// The STRUCTURAL belt after a tentative apply: the post-apply handle
// must read NBound (the narrowing stuck without a structural conflict).
// This is NOT the proof — a bind always sticks, so boundness alone once
// admitted an !Alloc claim on an allocating body; the proof is the
// row subsumption apply_annotation_tentatively now returns, conjoined
// with this read at try_each_annotation. Failure modes here:
//   NErrorHole — occurs check or a structural conflict caused
//                inference to record failure on the handle.
//   NFree     — the apply didn't bind (shouldn't happen for a
//                well-formed apply_annotation_tentatively).
//   row-kind  — handle was a row variable; not a narrow target.
// The trail-based rollback restores whatever state the handle held
// before the tentative apply, so this check is non-destructive.
fn verify_after_apply(handle) = match graph_chase(handle) {
  GNode(kind, _) => match kind {
    NBound(_) => true,
    NErrorHole(_) => false,
    NFree(_) => false,
    NRowBound(_) => false,
    NRecordRowBound(_, _) => false,
    NRowFree(_) => false,
  },
}

fn ownership_candidates(params) = list_to_flat(params) |> filter((p) => match param_resolved(p) {
  Unmarked => true,
  _ => false,
}) |> ((inferred_params) => flatten(map(
  (p) => {
    let name = param_name(p)
    [AOwn(name, None), ARef(name, None)]
  },
  inferred_params
)))

fn pick_highest_leverage(proven) = if len(proven) == 0 {
  None
} else {
  // The ladder speaks the GENERAL vocabulary (annotation_eq's ANotEffect
  // arm is name-sensitive, so each rung matches its proven namesake).
  // The rich-label severances outrank Pure — the DSP marquee (!Alloc =
  // real-time) leads; ranking by measured leverage instead of this
  // literal ladder is the banked tie-ranking refinement
  // (Hβ.teach.severance-vocabulary-from-link).
  let best = find_by_priority(
    proven,
    [ANotEffect("Alloc", None), ANotEffect("IO", None), ANotEffect("Network", None), APure(None)]
  )
  match best {
    Some(_) => best,
    None => Some(list_index(proven, 0)),
  }
}

fn find_by_priority(proven, priorities) = {
  let matches = filter(
    (target) => match find_annotation(proven, target) {
      Some(_) => true,
      None => false,
    },
    priorities
  )
  if len(matches) == 0 { None } else { find_annotation(proven, head(matches)) }
}

fn find_annotation(proven, target) = {
  let hits = filter(
    (pair) => match pair {
      (ann, _) => annotation_eq(ann, target),
    },
    proven
  )
  if len(hits) == 0 { None } else { Some(head(hits)) }
}

// Span-insensitive: two APure(_) compare equal regardless of source
// span. Priority comparison classifies by discriminator, not origin.
fn annotation_eq(a, b) with Pure = match a {
  APure(_) => match b {
    APure(_) => true,
    _ => false,
  },
  ARefined(_, _, _) => match b {
    ARefined(_, _, _) => true,
    _ => false,
  },
  AOwn(_, _) => match b {
    AOwn(_, _) => true,
    _ => false,
  },
  ARef(_, _) => match b {
    ARef(_, _) => true,
    _ => false,
  },
  AWrapHandler(_, _, _) => match b {
    AWrapHandler(_, _, _) => true,
    _ => false,
  },
  ANotEffect(an, _) => match b {
    ANotEffect(bn, _) => // Name-sensitive where the others are shape-only: two general
    // severances are the SAME candidate only for the same name.
    field_name_eq(an, bn),
    _ => false,
  },
}

// Walk the reason DAG from a graph handle. Every unification, instantiation, and
// subsumption wrote a Reason edge into the graph; `why_expand` recurses through the chain
// until leaf reasons (Declared, Unmarked, MissingVar) terminate. Depth-limited at 20.    // drift-audit: ignore — "cycles" referencing graph cycle detection, not deferred work
fn why_from_handle(handle) = match graph_chase(handle) {
  GNode(_, reason) => why_expand(reason, 0),
}

fn teach_synthesize(hole_handle, context) = match graph_chase(hole_handle) {
  GNode(kind, _) => match kind {
    NBound(ty) => match context {
      Context(_, allowed, _, _) => match synth_propose(ty, allowed, context) {
        Proposals(survivors, _rejected) => if len(survivors) == 1 { Some(head(survivors)) } else { None },
      },
    },
    _ => None,
  },
}

// H6: exhaustive Ty enumeration. Only TFun carries an explicit
// row; every other Ty is treated as the pure row (it has no effect
// behavior by itself). Named explicitly so a future Ty whose row
// semantics aren't pure surfaces as a compile error.
fn extract_row(ty) with Pure = match ty {
  TFun(_, _, row) => row,
  TInt => mk_ef_pure(),
  TFloat => mk_ef_pure(),
  TUnit => mk_ef_pure(),
  TByte => mk_ef_pure(),
  TList(_) => mk_ef_pure(),
  TTuple(_) => mk_ef_pure(),
  TVar(_) => mk_ef_pure(),
  TName(_, _) => mk_ef_pure(),
  TRecord(_) => mk_ef_pure(),
  TRecordOpen(_, _) => mk_ef_pure(),
  TRefined(_, _) => mk_ef_pure(),
  TCont(_, _, _, world) => // resuming a continuation performs its frozen world (the TFun analog: extract_row(TFun) => row)
  world,
  TAlias(_, inner) => extract_row(inner),
  TReprPin(_, base) => extract_row(base),
}

// Map an annotation to the capability it unlocks: add this annotation, get this capability.
fn unlock_capability(annotation) = match annotation {
  APure(_) => CMemoize,
  ARefined(_, _, _) => CEliminateBoundsCheck,
  AOwn(_, _) => CDeterministicDrop,
  ARef(_, _) => CZeroCopy,
  AWrapHandler(_, _, _) => // Wrapping a body in an absorbing handler CONTAINS the offending effect —
  // the sandbox capability, the same family a proven !Network unlocks.
  CSandbox,
  ANotEffect(name, _) => CProvenAbsence(name),
}

// One-line summary for an error code. Every code has a full entry at
// `docs/errors/<code>.md`; `teach_error` returns the full Explanation with that path.
fn catalog_summary(code) = match code {
  "E_MissingVariable" => "Variable not found in scope",
  "E_TypeMismatch" => "Type mismatch",
  "E_PatternInexhaustive" => "Match does not cover every variant",
  "E_OwnershipViolation" => "Double consume or ref escape",
  "E_OccursCheck" => "Circular type (infinite type)",
  "E_UnresolvedType" => "Type handle unresolved at codegen",
  "E_RefinementRejected" => "Refinement obligation rejected by solver",
  "E_PurityViolated" => "Function performs effects that violate declared purity",
  "E_EffectMismatch" => "Effect row mismatch",
  "E_HandlerUninstallable" => "Handler arms require effects not admitted by the enclosing declaration",
  "E_FeedbackNoContext" => "<~ requires an iterative context (install an Iterate-class handler)",
  "E_ReplayExhausted" => "Replay trace exhausted — recording too short or divergent run",
  "P_ExpectedToken" => "Parser expected a specific token",
  "P_UnexpectedToken" => "Parser hit a token that admits no production",
  "V_Pending" => "Verification obligation recorded, solver not yet installed",
  "W_Suggestion" => "Probable fix available (did-you-mean, synth)",
  "T_Gradient" => "Annotation would unlock a capability",
  "T_OverDeclared" => "Function declares a wider effect row than its body uses — tighten to unlock capabilities",
  "T_ContinuationEscapes" => "Multi-shot continuation captured inside arena",
  _ => "Unknown error code: {code}",
}

// Display — for driver rendering
fn show_annotation(ann) = match ann {
  APure(_) => "with Pure",
  ARefined(name, _, _) => "refined {name}",
  AOwn(name, _) => "own {name}",
  ARef(name, _) => "ref {name}",
  AWrapHandler(name, _, _) => "wrap with {name}",
  ANotEffect(name, _) => "with !{name}",
}

fn show_capability(cap) = match cap {
  CMemoize => "Memoization (pure function caching)",
  CParallelize => "Automatic parallelization",
  CCompileTimeEval => "Compile-time evaluation",
  CRealTime => "Real-time safe (proven zero allocation)",
  CSandbox => "Sandbox (proven no network access)",
  CEliminateBoundsCheck => "Bounds check elimination",
  CZeroCopy => "Zero-copy (proven no ownership transfer)",
  CDeterministicDrop => "Deterministic drop (proven single use)",
  CProvenAbsence(name) => "Proven absence of {name} (the transitive !{name})",
}

// render_why — Located-aware Why Engine renderer (I18)
// teach_why returns a Reason DAG. render_why walks it, emitting
// one indented line per structural frame. Located(span, inner)
// produces `<line:col-line:col>` at its depth; structured variants
// produce a short human label then recurse on inner reasons; leaf
// variants terminate via show_reason.
//
// This is the user-visible payoff of I13/I13.1: every unification,
// instantiation, subsumption wrote a Located edge into the graph;
// render_why chases them into readable coordinate trails. IDEs/LSP
// consume this output as hover text; `mentl explain <handle>` dumps
// it to stdout.
fn indent_for(depth) = indent_for_loop(depth, "")

fn indent_for_loop(n, acc) = if n <= 0 { acc } else { indent_for_loop(n - 1, acc ++ "  ") }

fn render_why(reason) = render_why_at(reason, 0)

fn render_why_at(reason, depth) = if depth > 20 {
  "{indent_for(depth)}[depth limit reached]\n"
} else {
  match reason {
    Located(span, inner) => "{indent_for(depth)}{show_span(span)}\n{render_why_at(inner, depth + 1)}",
    Unified(a, b) => "{indent_for(depth)}unified:\n{render_why_at(a, depth + 1)}{indent_for(depth)}with:\n{render_why_at(b, depth + 1)}",
    OpConstraint(op, l, r) => "{indent_for(depth)}op '{op}' constraint:\n{render_why_at(l, depth + 1)}{indent_for(depth)}versus:\n{render_why_at(r, depth + 1)}",
    VarLookup(name, inner) => "{indent_for(depth)}var '{name}' lookup:\n{render_why_at(inner, depth + 1)}",
    FnReturn(name, inner) => "{indent_for(depth)}return of '{name}':\n{render_why_at(inner, depth + 1)}",
    FnParam(name, idx, inner) => "{indent_for(depth)}param '{name}' (#{int_to_str(idx)}):\n{render_why_at(inner, depth + 1)}",
    MatchBranch(a, b) => "{indent_for(depth)}match branches:\n{render_why_at(a, depth + 1)}{indent_for(depth)}& \n{render_why_at(b, depth + 1)}",
    ListElement(inner) => "{indent_for(depth)}list element:\n{render_why_at(inner, depth + 1)}",
    IfBranch(inner) => "{indent_for(depth)}if branch:\n{render_why_at(inner, depth + 1)}",
    LetBinding(name, inner) => "{indent_for(depth)}let '{name}':\n{render_why_at(inner, depth + 1)}",
    Instantiation(name, inner) => "{indent_for(depth)}instantiation of '{name}':\n{render_why_at(inner, depth + 1)}",
    InferredCallReturn(callee, inner) => "{indent_for(depth)}call to '{callee}':\n{render_why_at(inner, depth + 1)}",
    InferredPipeResult(verb, inner) => "{indent_for(depth)}{verb} pipe:\n{render_why_at(inner, depth + 1)}",
    Declared(_) => // Leaf variants — render via show_reason and terminate.
    render_leaf(reason, depth),
    Inferred(_) => render_leaf(reason, depth),
    Fresh(_) => render_leaf(reason, depth),
    MissingVar(_) => render_leaf(reason, depth),
    Placeholder(_) => render_leaf(reason, depth),
    BinOpPlaceholder(_) => render_leaf(reason, depth),
    Refinement(_, _) => render_leaf(reason, depth),
    UnifyFailed(_, _) => render_leaf(reason, depth),
    FreshInContext(_, _) => render_leaf(reason, depth),
    DefaultReason(_, _) => render_leaf(reason, depth),
    VerifyWitness(_) => render_leaf(reason, depth),
  }
}

fn render_leaf(reason, depth) = "{indent_for(depth)}{show_reason(reason)}\n"

// teach_why_string ties the effect-returning teach_why to the pure
// renderer. Callers (LSP hover, explain surface, Quick Fix surface)
// invoke this directly.
fn teach_why_string(handle) with GraphRead + Memory + Alloc + Intern =
  render_why(why_from_handle(handle))

// ─── teach_session — `<|` fanout over the five Teach-cluster ops ──────
//
// The Teach effect declares five entry points (teach_here, teach_gradient,
// teach_why, teach_error, teach_unlock). teach_session borrows a
// position to all five branches simultaneously — output is the 5-tuple
// the IDE renders as one panel ("everything Mentl knows to teach about
// this position"). Same `<|` shape as cursor.mn's eight-aspect fanout,
// scoped to the Teach cluster.
//
// Drift refused: 1 (no dispatch table); 6 (five uniform branches; no
// primitive special case); 7 (output 5-tuple, not parallel-arrays);
// 9 (all five bodied here; no "later").
fn teach_session(handle) with Teach + GraphRead + Memory + Alloc = match graph_chase(handle) {
  GNode(kind, _) => {
    let span = caret_span_from_handle(handle)
    let pos = (handle, kind, span)
    match pos <| (((h, k, sp)) => match k {
      NBound(ty) => teach_here("at handle", sp, ty),
      _ => (),
    }, ((h, _, _)) => teach_gradient(h), ((h, _, _)) => teach_why(h), ((h, _, sp)) => teach_error("E_Position", sp, Inferred("teach_session inquiry")), ((_, k, _)) => match k {
      NBound(ty) => match annotation_inferred_for(ty) {
        Some(ann) => teach_unlock(ann),
        None => CMemoize,
      },
      _ => CMemoize,
    }) {
      (_, gradient, why, _, _) => TeachSession(gradient, why),
    }
  },
}

type TeachSession = TeachSession(Option(AnnotationSuggestion), Reason)

fn caret_span_from_handle(handle) with GraphRead + Memory + Alloc = match graph_chase(handle) {
  GNode(_, reason) => match reason {
    Located(sp, _) => sp,
    _ => span_zero(),
  },
}

fn annotation_inferred_for(ty) with Memory + Alloc = match ty {
  TFun(_, _, _) => Some(APure(None)),
  _ => None,
}

// ─── Multi-position teach — map over a handle list ───────────────────
//
// The DELETED teach_pair (binary special-case) was erased per
// CLAUDE.md Anchor 6: callers compose
// `map(teach_session, handles)` directly; teaching each handle on its
// own core is a `><` fanout under its own `~> Thread` at the call site
// (Hβ.lower.schedule-specialized-callee). Drift 6 erasure: small-arity
// special-case removed.
//
// ─── teach_ic_loop — `<~` IC fixpoint on teach knowledge stability ────
//
// Teach loops until the project's knowledge base stops changing.
// Every accepted gradient suggestion mutates the graph; IC invalidates;
// teach re-projects; the loop converges when no Reason chain changes.
// Per PLAN §2's cached cursor: build IS the <~ loop closing on
// stability.
//
// `<~` requires iterative context — IC handler installed upstream.
// accumulate(initial_handle) starts at the cursor's argmax and
// IC-narrows toward proven-complete teach surface.
fn teach_ic_loop(initial_handle) with Teach + IC + GraphRead + Memory + Alloc =
  initial_handle |> teach_session ~> mentl_default <~ accumulate(initial_handle)
