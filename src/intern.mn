// intern.mn — the intern table's handlers (the string identity).
// The table stands outermost in every judging chain, and a fork reads it
// through `intern_view`, an instance holding the table as the fork found it
// (the fork's seed reads it through `intern_table_view`): a word is interned
// at the text boundary or born in the table (`medium_vocabulary`), so a fork
// mints nothing and a word first seen inside one is refused by name. effect
// Intern declares in types.mn — the vocabulary home every performer imports
// (lex and the EffName mints live below this module); the handlers live with
// the table they manage.
import types

import lexer

import strings

fn intern_probe(ref bucket, ref src, s, e, i, n) = if i >= n {
  None
} else {
  let row = list_index(bucket, i)
  match row {
    (canonical, _h, _kw) => if str_eq_at(canonical, src, s, e) { Some(row) } else { intern_probe(bucket, src, s, e, i + 1, n) },
  }
}

// The table is one state — its buckets, its entries and the next handle —
// BORN holding the medium's vocabulary (`vocab_seed`), so an install of it is
// a member of a handler chain like any other and needs no body to pre-warm it.
handler intern_table with table = vocab_seed() {
  intern_span(src, s, e) => match table {
    (buckets, entries, count) => {
      let b = i32_and(str_hash_loop(src, s, e, -2128831035), 4095)
      let bucket = list_index(buckets, b)
      match intern_probe(bucket, src, s, e, 0, len(bucket)) {
        Some(row) => resume(row),
        None => {
          let canonical = list_to_flat(str_slice(src, s, e))
          let row = (canonical, count, keyword_kind(canonical))
          let nbuckets = list_set(buckets, b, [row] ++ bucket)
          let nentries = list_set(list_extend_to(entries, count + 1), count, canonical)
          resume(row) with table = (nbuckets, nentries, count + 1)
        },
      }
    },
  },
  intern_str(s) => match table {
    (buckets, entries, count) => {
      let e = byte_len(s)
      let b = i32_and(str_hash_loop(s, 0, e, -2128831035), 4095)
      let bucket = list_index(buckets, b)
      match intern_probe(bucket, s, 0, e, 0, len(bucket)) {
        Some(row) => match row {
          (_canonical, h, _kw) => resume(h),
        },
        None => {
          let canonical = list_to_flat(s)
          let row = (canonical, count, keyword_kind(canonical))
          let nbuckets = list_set(buckets, b, [row] ++ bucket)
          let nentries = list_set(list_extend_to(entries, count + 1), count, canonical)
          resume(count) with table = (nbuckets, nentries, count + 1)
        },
      }
    },
  },
  intern_name_of(h) => match table {
    (_buckets, entries, _count) => resume(list_index(entries, h)),
  },
  intern_table_view() => resume(table),
}

// A fork's view of the table it stands over: the table as the fork found it,
// read and never written. Every word a judgment interns is a word the text
// boundary interned or the medium's own vocabulary, so a miss here is a word
// first seen inside a speculation — refused by name, never minted, since a
// handle minted in one option would name another word in the next.
handler intern_view(table) {
  intern_span(src, s, e) => match table {
    (buckets, _entries, _count) => {
      let bucket = list_index(buckets, i32_and(str_hash_loop(src, s, e, -2128831035), 4095))
      match intern_probe(bucket, src, s, e, 0, len(bucket)) {
        Some(row) => resume(row),
        None => fail("intern: `{str_slice(src, s, e)}` is first interned inside a speculation; a word is interned at the text boundary or born in the table"),
      }
    },
  },
  intern_str(s) => match table {
    (buckets, _entries, _count) => {
      let bucket = list_index(buckets, i32_and(str_hash_loop(s, 0, byte_len(s), -2128831035), 4095))
      match intern_probe(bucket, s, 0, byte_len(s), 0, len(bucket)) {
        Some((_canonical, h, _kw)) => resume(h),
        None => fail("intern: `{s}` is first interned inside a speculation; a word is interned at the text boundary or born in the table"),
      }
    },
  },
  intern_name_of(h) => match table {
    (_buckets, entries, _count) => resume(list_index(entries, h)),
  },
  intern_table_view() => resume(table),
}

// The names the compiler itself interns from a literal: the effects the
// judgment charges by name (a construction's `Alloc`, an arena's
// `Memory + Arena`, a partial primitive's `Trap`, a store's `Mutate`, a
// recursion's `Diverge`) and the ones the teaching surface classifies
// (`IO`, `Network`). Every table starts holding them, inserted in this
// order, so each has the same handle in every table (1 through 8) and a
// fork's view always finds them: a program with no literal and no library
// (the frontier's stage-ring demo, whose link is two files) asks for
// `Alloc` from inside a proposal once a closure mint is charged, and for
// `Mutate` once a store is. A literal intern anywhere in the compiler names
// one of these.
fn medium_vocabulary() = ["Memory", "Alloc", "IO", "Network", "Trap", "Arena", "Mutate", "Diverge"]

// A vocabulary word's handle, the same in every table: its place in the
// vocabulary, counted from one as the seed inserts it. A row naming the
// word can then be built once, before any table exists. A word outside the
// vocabulary has no such handle, and asking for one is a defect the
// deliberate trap names.
fn vocab_handle(w: String) = match medium_vocabulary() |> enumerate |> find({ (_, v) => v == w }) {
  Some((i, _)) => i + 1,
  None => trap(),
}

// A table born holding the vocabulary: fresh buckets and entries with the
// words inserted in order — the same insertion the `intern_str` arm makes on
// a miss, so a word seeded here and a word interned later are one row shape.
fn vocab_seed() =
  fold((list_filled(4096, []), make_list(1024), 1), vocab_insert, medium_vocabulary())

fn vocab_insert(table, w: String) = match table {
  (buckets, entries, count) => {
    let canonical = list_to_flat(w)
    let b = i32_and(str_hash_loop(canonical, 0, byte_len(canonical), -2128831035), 4095)
    let row = (canonical, count, keyword_kind(canonical))
    (
      list_set(buckets, b, [row] ++ list_index(buckets, b)),
      list_set(list_extend_to(entries, count + 1), count, canonical),
      count + 1
    )
  },
}
