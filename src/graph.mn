// graph.mn — Graph machinery (spec 00)
//
// The substrate. One live graph, all variables, held as a VALUE: every
// per-handle fact is a column keyed by the handle itself (lib/imap.mn's
// persistent trie, pt), and the graph is the roots of its columns with the
// mint, the span log and the heap mark its writes are told from
// (types.mn Version). Every TVar(id) is a handle into the columns; every
// observer chases via graph_chase; only inference writes.
//
// types.mn owns the vocabulary (NodeKind, GNode, Graph, Version, GraphRead,
// GraphWrite). This file owns the mechanism: graph_handler (the live
// state), the column reads with their absent-contracts, chase_node (the
// read primitive), occurs_in (cycle detection), the forking handlers
// (speculation as a version taken and restored or kept).
//
// THE VERSIONED COLUMNS. A column read is four loads along the handle's
// digits. A write lands in place when the node it reaches was allocated
// after the open version's mark and copies that node's one page otherwise,
// so a version is taken in O(1) by remembering the roots and the line
// (`graph_version`), the writes after it leave it readable, and a
// speculation undoes everything it wrote by making the version the graph
// again (`graph_restore`), in O(1), or keeps everything by dropping it
// (`graph_keep`). Nothing is journaled and nothing walked back: the old
// value is still where it was, read live through the old root. Two versions
// compared are the write set between them (`graph_written_since`), which is
// how a candidate's teaching survives its undo. A column absent at a
// handle reads its zero word, and each read below answers that word's
// absent-contract: the nodes column answers a free cell, the program column
// an absent body, the canon column the handle itself, a multi-map column
// the one shared empty list.
//
// Module-of-position is the module column stamped at each node's mint
// (graph_module_of), never a side-ledger and never a span — every module
// numbers its lines from 1.
import types

import arena

import choice

import effects

import imap

import io

import strings

// The empty version, which every verb-entry install starts from: every
// column empty, the mint at zero, the mark at the bottom of memory so every
// node written is the version's own. The multi-map columns — a gate on the
// few cells a declared negation reaches, an instance note on the few copies
// a still-open declaration hands out — are the same shape as the dense
// ones, a trie populated where something was entered.
fn root_version() = Version{
  binders: pt_empty(),
  births: pt_empty(),
  boundaries: pt_empty(),
  canon: pt_empty(),
  claims: pt_empty(),
  comments: pt_empty(),
  demands: pt_empty(),
  gates: pt_empty(),
  in_edges: pt_empty(),
  installs: pt_empty(),
  instances: pt_empty(),
  late: pt_empty(),
  links: pt_empty(),
  mark: 0,
  module: pt_empty(),
  narrowing: pt_empty(),
  next: 0,
  nodes: pt_empty(),
  parent: pt_empty(),
  products: pt_empty(),
  program: pt_empty(),
  published: pt_empty(),
  rows: pt_empty(),
  span_index: [],
  spans: pt_empty(),
  store_claims: pt_empty(),
}

// ─── The column reads, each with its absent-contract ──────────────────────
// A virgin cell is word 0 (the allocator's virginity contract IS the
// column's). The nodes column answers a synthesized free cell for a handle
// never minted; the program column answers the absent body; the spans and
// comments columns the absent position; the canon column reads 0 as "no
// edge" and the narrowing column as "nothing proven"; a boundaries,
// installs or products cell's 0 IS its nullary absent tag natively; the
// module, parent and links columns hold their handle BIASED BY ONE, since a
// module node, a parent or a declaration may be handle 0 and a virgin cell
// must read as absent.
//
// The one nodes read. Every minted handle's cell was written at its own
// mint, so only a never-minted handle reads a virgin cell, and the word-face
// guard answers it with the synthesized NFree.
fn graph_node_at(ref nodes, idx) = {
  let cell = pt_get(nodes, idx)
  if slot_present(cell) { cell } else { GNode(NFree(0), Fresh(idx)) }
}

fn body_at(ref program, h) = {
  let cell = pt_get(program, h)
  if slot_present(cell) { cell } else { NHole(0) }
}

// The birth-span column read — a virgin cell (never parse-indexed) is
// span_zero, the same absent-contract every position consumer already
// treats as "no source site".
fn span_cell_at(ref spans, h) = {
  let cell = pt_get(spans, h)
  if slot_present(cell) { cell } else { span_zero() }
}

fn comment_at(ref comments, h) = {
  let cell = pt_get(comments, h)
  if slot_present(cell) { cell } else { ("", span_zero()) }
}

fn canon_at(ref canon, h) = {
  let to = pt_get(canon, h)
  if to == 0 { h } else { to }
}

// The module a node was born in — ONE cell read. TOTAL: every node is born
// inside some module, including stdin's, so there is no absent case to
// encode. A virgin cell here means a node was minted with no module in
// force, which is a defect in the caller, and it traps loudly rather than
// answering a fabricated 0 that every reader downstream would have to
// re-check (the surrender-fallback this column exists to end). The cell
// holds the module handle BIASED BY ONE: a fresh graph's FIRST mint is
// handle 0, so the first module node IS handle 0, and an unbiased column
// could not tell "born in module 0" from "never stamped" — measured, the
// day this column landed, as a trap on handle 1 whose module really was 0.
fn module_at(ref module, handle) = {
  let cell = pt_get(module, handle)
  if cell == 0 { out_of_range() } else { 0 }
  cell - 1
}

// The module in force, named — the mechanism-layer read for the write
// guard's own reports. It reads the instance's state directly rather than
// performing graph_module_current, because an arm's performs resolve OUTER
// of its own install (the wrong-instance class this guard family already
// pays for) and because charging GraphRead into this handler's residual is
// the row leak its comment names.
fn module_name(ref program, m) = match body_at(program, m) {
  NModule(mm) => mm.path,
  NLink(_) => "<link>",
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => {
    out_of_range()
    ""
  },
}

fn parent_at(ref parent, h) = {
  let cell = pt_get(parent, h)
  if cell == 0 { None } else { Some(cell - 1) }
}

// A reference's link: the cell holds the declaration's handle BIASED BY ONE,
// the parent column's convention, since a declaration may be handle 0 and a
// virgin cell reads as no link.
fn link_at(ref links, h) = {
  let cell = pt_get(links, h)
  if cell == 0 { None } else { Some(cell - 1) }
}

// Whether the node at `handle` belongs to the program as it stands: the
// module node it was born in has not been superseded by a later parse of the
// same path (graph_register_node's one write), and no node on its parent
// walk — the top-level statement it stands in, above all — was replaced by
// an edit (graph_supersede). The module column's word answers for a cell the
// judgment minted, which no parent holds.
fn current_at(module, parent, superseded, handle) =
  unsuperseded(superseded, module_at(module, handle)) && ancestry_unsuperseded(parent, superseded, handle)

fn ancestry_unsuperseded(parent, superseded, h) = unsuperseded(superseded, h) && match parent_at(parent, h) {
  None => true,
  Some(p) => ancestry_unsuperseded(parent, superseded, p),
}

// Whether a node was neither superseded as its path's module nor replaced
// as a statement. A module node's own module column names the module that
// was open when it was minted, never itself, so the question is asked of
// the handle directly.
fn unsuperseded(superseded, h) = match wmap_get(superseded, h) {
  Some(_) => false,
  None => true,
}

// The purge's question at a supersession: was the node at `handle` born
// anywhere but in the module node being superseded?
fn born_outside(module, m: Int, handle) = module_at(module, handle) != m

// The tree's own edge, child to parent: drawn here, where a parent's body
// registers, for every node that body holds — a module's declarations and
// the link's modules included. The last registration wins, which is the
// tree a desugaring leaves (a `let`'s value is a child of the match its
// block becomes); a candidate a restored version minted held only nodes
// minted in that version, and a re-mint at the same handle redraws its
// edge when its own parent registers.
fn put_parents(parent, mark, p, body) =
  fold(parent, put_parent(mark, p, ??, ??), body_children_for_parent(body))

fn body_children_for_parent(body) = match body {
  NModule(m) => m.decls,
  NLink(l) => l.modules,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => body_child_handles(body),
}

fn put_parent(mark, p, parent, h) = pt_set(parent, mark, h, p + 1)

// The three kinds of a declaration's in-edges, each read off the one store,
// each answered only from a node the program still holds. A use still names
// its reference when the reference's cell links to the declaration it stands
// under: a reference re-resolved to another declaration leaves its old entry
// behind, and the read drops it, as it drops one an edit replaced.
fn use_still_linked(links, module, parent, superseded, decl, e) = match e {
  UseBy(r) => if pt_get(links, r) == decl + 1 && current_at(module, parent, superseded, r) { [r] } else { [] },
  MentionBy(_) | AppliedAt(_) => [],
}

// Each handle once, in the order first seen: one probe per handle into a set
// the walk builds, where comparing every pair made a declaration read by two
// thousand references cost four million comparisons.
fn distinct_handles(hs) = if len(hs) < 2 {
  hs
} else {
  match fold(([], wmap_new(len(hs))), distinct_step, hs) {
    (kept, _) => kept,
  }
}

fn distinct_step(acc, h: Int) = match acc {
  (kept, seen) => match wmap_get(seen, h) {
    Some(_) => acc,
    None => (push(kept, h), wmap_add(seen, h, 1)),
  },
}

fn mention_owner(module, parent, superseded, e) = match e {
  MentionBy(owner) => if current_at(module, parent, superseded, owner) { [owner] } else { [] },
  UseBy(_) | AppliedAt(_) => [],
}

fn application_at(module, parent, superseded, e) = match e {
  AppliedAt(call) => if current_at(module, parent, superseded, call) { [call] } else { [] },
  UseBy(_) | MentionBy(_) => [],
}

// An in-edge survives a supersession when the node it arrives from does.
fn in_edge_kept(keep, e) = match e {
  UseBy(h) | MentionBy(h) | AppliedAt(h) => keep(h),
}

// The binder a reference reads, when what it names is a value binder — a
// parameter, a pattern's binder, a handler's state field, a declaration's
// own cell while its group is judged — whose cell the reference shares: the
// declaration's published binding is that cell, unquantified. A pattern's
// binder that names the whole value it was handed — a let's, a match arm's —
// publishes that value's cell from the node where it is written, so the
// reference reads the value and its edge reaches the binder. A declaration
// that generalizes (a function, a constructor, an op) is reached by the same
// edge and is no binder.
fn binder_read_by(r) = match graph_ref_decl(r) {
  Some(d) => match graph_published(d) {
    Some((Frozen([], TVar(b)), _, _)) => if b == d || is_pattern(d) { Some(b) } else { None },
    None | Some(_) => None,
  },
  None => None,
}

fn is_pattern(h) = match graph_node_body(h) {
  NPat(_) => true,
  NExpr(_)
  | NStmt(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => false,
}

// A declaration stands at module level when this edge runs from it to a
// module node. The decls column holds a block's `let`s and nested fns beside
// a module's own declarations, and this is the one test that tells them apart.
fn at_module_level(h) = match graph_parent_of(h) {
  Some(p) => match graph_node_body(p) {
    NModule(_) => true,
    NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => false,
  },
  None => false,
}

// THE ACCEPT EDGE, read at the one writer (C4). A node bound at an extent
// the accepted column holds — same module, same span — takes its reason
// wrapped in `Accepted`, so every projection of the reason cell (the Why
// facet, the chain render, the address surface) walks from the value to
// the proposal that proved it without a second read. The column is empty
// on every compile that is not an edit session, so the bind pays one
// length read; a non-empty column costs one span compare per entry, at
// felt cadence. `Located` stays OUTERMOST because every span reader
// (span_of_reason, the caret's authored-hole test) reads the reason's
// head, and an acceptance must not unlocate the node it names. A cell
// already carrying the edge keeps it — the wrap is idempotent.
fn accepted_reason(accepted, spans, module, program, handle, reason) = if len(accepted) == 0 {
  reason
} else {
  let sp = span_cell_at(spans, handle)
  let path = module_name(program, module_at(module, handle))
  match find({ (p, asp, _t, _r) => accepted_here(p, path, asp, sp) }, accepted) {
    Some(entry) => match entry {
      (_p, _asp, text, proof) => accept_wrap(reason, text, proof),
    },
    None => reason,
  }
}

// `p: String` pins the compare: two module paths minted by different
// parses are byte-equal and pointer-distinct, the class a bare `==` on
// names falls to (PLAN §9's pointer-eq lesson).
fn accepted_here(p: String, path: String, asp, sp) = p == path && span_eq(asp, sp)

fn accept_wrap(reason, text, proof) = match reason {
  Located(sp, inner) => match inner {
    Accepted(_, _, _) => reason,
    Declared(_)
    | Inferred(_)
    | Fresh(_)
    | OpConstraint(_, _, _)
    | VarLookup(_, _)
    | FnReturn(_, _)
    | FnParam(_, _, _)
    | MatchBranch(_, _)
    | ListElement(_)
    | IfBranch(_)
    | LetBinding(_, _)
    | Unified(_, _)
    | Instantiation(_, _)
    | Placeholder(_)
    | MissingVar(_)
    | Refinement(_, _)
    | Located(_, _)
    | InferredCallReturn(_, _)
    | InferredPipeResult(_, _)
    | DefaultReason(_, _)
    | EffectEnters(_, _, _)
    | LabelEnters(_, _, _)
    | ChainInstall(_, _)
    | StateBinding(_, _) => Located(sp, Accepted(text, proof, inner)),
  },
  Accepted(_, _, _) => reason,
  Declared(_)
  | Inferred(_)
  | Fresh(_)
  | OpConstraint(_, _, _)
  | VarLookup(_, _)
  | FnReturn(_, _)
  | FnParam(_, _, _)
  | MatchBranch(_, _)
  | ListElement(_)
  | IfBranch(_)
  | LetBinding(_, _)
  | Unified(_, _)
  | Instantiation(_, _)
  | Placeholder(_)
  | MissingVar(_)
  | Refinement(_, _)
  | InferredCallReturn(_, _)
  | InferredPipeResult(_, _)
  | DefaultReason(_, _)
  | EffectEnters(_, _, _)
  | LabelEnters(_, _, _)
  | ChainInstall(_, _)
  | StateBinding(_, _) => Accepted(text, proof, reason),
}

// The op-based face of the state-passed occurs family — for bracketed
// pre-check sites (unify's typed-render occurs report), which hold no
// column: one seed read, then a zero-op walk. The arms call the family
// directly with their own state and never come here.
fn occurs_in_live(handle, ref ty) with !Mutate = occurs_in(graph_nodes(), handle, ty)

// graph_handler — the substrate handler
//
// Config: THE VERSION it starts from (types.mn Version) — the empty one at
// the verb entries (`root_version`); a fork on another cursor is an
// instance installed with the parent's version. The versioned state is the
// version's own fields: the twenty-three column roots, the mint, the span
// log and the mark, read by every arm and rebound by the writes, each a
// word store into the install record. Beside them the handler keeps what no
// version carries, because no speculation may take it back: the open
// versions (a stack — the innermost is what a speculation's write set is
// read against), the epoch (bumps on every bind; query observers key
// (handle, epoch)), the module in force, the decls column, the emitted-fn
// enumeration and its index, the signature column, the holes, the write
// guard's stored refusals, the accepted proposals, the modules by file,
// the superseded cells, the link and the tail facts.
//
// Threaded through the pipeline via ~>. Installed once at compile entry.
// Every downstream pass (infer, lower, query, teach, emit, mentl) sees the
// same live graph through the same effect discipline. State is internal to
// the handler; callers never see the columns as a value except as a
// Version they hand back; access is only through perform.
handler graph_handler(seed: Version) with nodes = seed.nodes, program = seed.program, comments = seed.comments, canon = seed.canon, narrowing = seed.narrowing, boundaries = seed.boundaries, installs = seed.installs, links = seed.links, module = seed.module, parent = seed.parent, products = seed.products, spans = seed.spans, gates = seed.gates, instances = seed.instances, demands = seed.demands, rows = seed.rows, binders = seed.binders, births = seed.births, late = seed.late, claims = seed.claims, in_edges = seed.in_edges, published = seed.published, store_claims = seed.store_claims, next = seed.next, span_index = seed.span_index, mark = seed.mark, versions = [], epoch = 0, cur_module = 0, decls_col = [], emitfns_col = [], emitfns_idx = [], emitfns_idx_covers = 0, sigs_col = [], holes_pend = [], holes_col = [], guard_diags = [], accepted = [], modules_now = smap_new(), superseded = wmap_new(64), link_now = None, tails_idx = smap_new() {
  graph_chase(handle) => resume(chase_node(nodes, handle, 0)),
  graph_chase_handle(handle) => resume(chase_handle(nodes, handle, 0)),
  graph_epoch() => resume(epoch),
  graph_next() => resume(next),
  graph_reason_at(handle) => match graph_node_at(nodes, handle) {
    GNode(_, r) => resume(r),
  },
  graph_snapshot() => resume(Graph(next, span_index)),
  graph_nodes() => resume(nodes),
  graph_node_body(handle) => resume(body_at(program, handle)),
  graph_span_of(handle) => resume(span_cell_at(spans, handle)),
  graph_module_of(handle) => // The module a node was born in — ONE cell read, never a containment
  // scan over module spans. The read is module_at's, shared with the accept
  // read at graph_bind.
  resume(module_at(module, handle)),
  graph_parent_of(handle) => resume(parent_at(parent, handle)),
  graph_module_current() => resume(cur_module),
  graph_module_enter(m) => // Enter a module: every subsequent mint is attributed to it. The module
  // node attributes ITSELF, which is what makes the column total without a
  // sentinel — the first stamp has no earlier module to inherit, so it is
  // its own, and the recursion bottoms out at the file the developer named.
  resume() with module = pt_set(module, mark, m, m + 1), cur_module = m,
  graph_version() => // THE VERSION: the graph as it stands, O(1) — the roots, the mint, the
  // span log and the mark the enclosing version left, so a restore or a
  // keep hands that mark back. The line is marked AFTER the record is
  // built, so every node written from here on lies past the mark and is
  // this version's own, and every node the record's roots reach lies below
  // it and is copied before it is written. The version is pushed, since a
  // speculation's write set is read against the innermost open one. The mark
  // is kept as the line's NUMBER: an address committed into this state would
  // be a value the enclosing arena's exit cannot read, and it would keep its
  // whole region for it (measured 2026-10-20: 4,711 of 33,943 exits kept).
  {
    let v = Version{
      binders,
      births,
      boundaries,
      canon,
      claims,
      comments,
      demands,
      gates,
      in_edges,
      installs,
      instances,
      late,
      links,
      mark,
      module,
      narrowing,
      next,
      nodes,
      parent,
      products,
      program,
      published,
      rows,
      span_index,
      spans,
      store_claims,
    }
    resume(v) with mark = addr_word(heap_mark()), versions = push(versions, v)
  },
  graph_restore(v) => // The undo: the version is the graph again, every column read through
  // the root it held, the mint and the span log as they stood. Nothing is
  // walked: what the restored resumption wrote lives past the mark, where
  // no root of this version reaches, and dies with the extent that made it.
  // The mark the version saved is handed back, so the nodes the enclosing
  // version made are written in place again.
  resume() with nodes = v.nodes, program = v.program, comments = v.comments, canon = v.canon, narrowing = v.narrowing, boundaries = v.boundaries, installs = v.installs, links = v.links, module = v.module, parent = v.parent, products = v.products, spans = v.spans, gates = v.gates, instances = v.instances, demands = v.demands, rows = v.rows, binders = v.binders, births = v.births, late = v.late, claims = v.claims, in_edges = v.in_edges, published = v.published, store_claims = v.store_claims, next = v.next, span_index = v.span_index, mark = v.mark, versions = drop_last(versions),
  graph_keep(v) => // The keep: what the version's successor wrote stands, adopted back into
  // the pages the writes replaced where those are the enclosing version's
  // own (lib/imap.mn's pt_adopt), so the copies the writes made die with
  // the extent that made them and no replaced page is left orphaned in
  // memory nothing reclaims. The version's mark is handed back, since
  // nothing holds the roots it saved any longer and the pages written under
  // it are the graph's own. O(what the kept version wrote).
  resume() with nodes = pt_adopt(nodes, v.nodes, v.mark), program = pt_adopt(program, v.program, v.mark), comments = pt_adopt(comments, v.comments, v.mark), canon = pt_adopt(canon, v.canon, v.mark), narrowing = pt_adopt(narrowing, v.narrowing, v.mark), boundaries = pt_adopt(boundaries, v.boundaries, v.mark), installs = pt_adopt(installs, v.installs, v.mark), links = pt_adopt(links, v.links, v.mark), module = pt_adopt(module, v.module, v.mark), parent = pt_adopt(parent, v.parent, v.mark), products = pt_adopt(products, v.products, v.mark), spans = pt_adopt(spans, v.spans, v.mark), gates = pt_adopt(gates, v.gates, v.mark), instances = pt_adopt(instances, v.instances, v.mark), demands = pt_adopt(demands, v.demands, v.mark), rows = pt_adopt(rows, v.rows, v.mark), binders = pt_adopt(binders, v.binders, v.mark), births = pt_adopt(births, v.births, v.mark), late = pt_adopt(late, v.late, v.mark), claims = pt_adopt(claims, v.claims, v.mark), in_edges = pt_adopt(in_edges, v.in_edges, v.mark), published = pt_adopt(published, v.published, v.mark), store_claims = pt_adopt(store_claims, v.store_claims, v.mark), mark = v.mark, versions = drop_last(versions),
  graph_fresh_ty(reason) => // ─── Write ops ───────────────────────────────────────────────────
  // Each write rebinds the column it wrote: pt_set answers the root as it
  // stands when the path was this version's own, else the copied root.
  //
  // A mint is `next`, and nothing else.
  resume(next) with nodes = pt_set(nodes, mark, next, GNode(NFree(epoch), reason)), module = pt_set(module, mark, next, cur_module + 1), next = next + 1,
  graph_fresh_row(reason) => resume(next) with nodes = pt_set(nodes, mark, next, GNode(NRowFree(epoch), reason)), module = pt_set(module, mark, next, cur_module + 1), next = next + 1,
  graph_register_node(handle, body) => // Edge-link a node's body into the one graph at its handle — the program
  // COLUMN. Every AST node registers here at construction, so any handle
  // resolves to its body live (graph_node_body) — the incremental cursor
  // keys per-module recomputation on the driver's tree scan, never a
  // graph-side ledger. The parse-written program projection, distinct from
  // the mutable union-find type cell in the nodes column — one handle, one
  // cell per column.
  //
  // A MODULE node's registration is also where its generation turns over:
  // the file's previous module node is SUPERSEDED here, the one moment the
  // fact exists, so every read after it can ask "is this node current?" in
  // one word (graph_node_current) instead of walking the graph for module
  // cells and keeping the last, and the name-keyed columns drop what the
  // superseded node's generation noted here too — once per supersession, so
  // a read returns its column as it stands. Filtering at every read copied
  // the column at every read, and the proof fragment reads the decls column
  // at every global name it folds (module_let_const): the judgment ran 154
  // MB higher on the wheel's own source, where nothing is ever superseded. A
  // LINK's registration makes it the link the graph holds.
  {
    let program2 = pt_set(program, mark, handle, body)
    let parent2 = put_parents(parent, mark, handle, body)
    match body {
      // A module's generation turns over at the outermost boundary alone: the
      // by-file table and the in-edges purge are written in place, which no
      // restore could take back, so a speculation registering a module is a
      // defect in the caller and traps.
      NModule(m) => match if len(versions) > 0 { out_of_range() } else { smap_get(modules_now, m.file) } {
        Some(old) => if old == handle {
          resume() with program = program2, parent = parent2
        } else {
          let keep = born_outside(module, old, ??)
          resume() with program = program2, parent = parent2, modules_now = smap_add(modules_now, m.file, handle), superseded = wmap_add(superseded, old, 1), decls_col = filter(keep, decls_col), in_edges = pt_retain(in_edges, in_edge_kept(keep, ??))
        },
        None => resume() with program = program2, parent = parent2, modules_now = smap_add(modules_now, m.file, handle),
      },
      NLink(_) => resume() with program = program2, parent = parent2, link_now = Some(handle),
      NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => resume() with program = program2, parent = parent2,
    }
  },
  graph_attach_comment(handle, text, span) => // The comment column — parse-attached prose at the handle. A comment is
  // graph content (SYNTAX.md Comments): the parser attaches each contiguous
  // // block to the handle of the decl it precedes; the Why engine /
  // formatter / cursor project it live (graph_comment_at). A SEPARATE
  // column, not the node's single Reason slot: graph_bind overwrites that
  // slot at infer with the inference Reason, so a parse-written comment
  // Reason would be clobbered.
  //
  // Blank-separated comment blocks share a following declaration: the
  // nested arm attaches the LATER block first, so an existing entry
  // merges BEHIND the incoming earlier text — source order, one home,
  // the blank line surviving as the paragraph break.
  match comment_at(comments, handle) {
    (existing, _) => {
      let merged = if byte_len(existing) > 0 { "{text}\n\n{existing}" } else { text }
      resume() with comments = pt_set(comments, mark, handle, (merged, span))
    },
  },
  graph_reword_comment(handle, text) => // A rename's write along a mention edge: the prose replaced, the span its
  // parse attached kept.
  match comment_at(comments, handle) {
    (_, span) => resume() with comments = pt_set(comments, mark, handle, (text, span)),
  },
  graph_comment_at(handle) => // A virgin cell reads as ("", zero span) — the same absent-contract every
  // column read shares.
  match comment_at(comments, handle) {
    (text, _) => resume(text),
  },
  graph_comment_span_at(handle) => match comment_at(comments, handle) {
    (_, span) => resume(span),
  },
  graph_attach_comment_ref(owner, referent) => // A resolved backticked reference is an edge from the comment's node to
  // the declaration it names, entered among the declaration's in-edges with
  // the uses and applications that arrive there.
  resume() with in_edges = pt_push(in_edges, mark, referent, MentionBy(owner)),
  graph_comment_refs_of(referent) => resume(distinct_handles(flat_map(mention_owner(module, parent, superseded, ??), pt_all(in_edges, referent)))),
  graph_canon_set(from, to) => // The e-graph equivalence weave — union-find as a fabric EDGE, a column
  // beside the program/comments/nodes columns (the TVar union-find
  // precedent). `graph_canon_set(from, to)` draws the equivalence edge
  // `from ≡ to`; `graph_canon_at(handle)` reads the one-step pointer (the
  // node's e-class root pointer, or the handle itself if it is its own
  // root). The rule that records the pair guarantees `to` is the cheaper
  // node, so chasing the edge always descends toward the simplest form —
  // egraph_extract (egraph.mn) follows it live. No side-ledger: an
  // already-rooted `from` overwrites its one cell, so saturation never grows
  // an O(N²) pair-list (the OOM the snoc-list ledger caused).
  resume() with canon = pt_set(canon, mark, from, to),
  graph_canon_at(handle) => // A handle with no edge (absent, or a self-pointer) is its own e-class root —
  // the extracted term. A virgin cell holds 0, and handle 0 is the synthetic
  // Module root (never an expr operand), so a 0 cell reads as "no edge" ⇒
  // return the handle itself.
  resume(canon_at(canon, handle)),
  graph_narrow_set(handle, pred_handle) => // The refinement-narrowing column — beside canon.
  // graph_narrow_set(handle, verdict) records what the judgment proved AT
  // program-point `handle`: a sequence read's index node carries 1 where its
  // bounds claim held (TRAP), and lower reads it to emit the unchecked
  // traversal. graph_narrow_at reads it back — 0 = nothing proven (the
  // default). One cell per handle: every judgment of a read writes its
  // verdict both ways, so a cell a restored speculation wrote is overwritten
  // by the judgment of the node that holds the handle now.
  resume() with narrowing = pt_set(narrowing, mark, handle, pred_handle),
  graph_narrow_at(handle) => resume(pt_get(narrowing, handle)),
  graph_boundary_at(site_handle) => // The executable-boundary weave: one O(1) read per fanout site, containing
  // its ordered branch edges. A virgin cell IS NoBoundary, the nullary tag 0.
  resume(pt_get(boundaries, site_handle)),
  graph_boundary_set(site_handle, boundary) => resume() with epoch = epoch + 1, boundaries = pt_set(boundaries, mark, site_handle, boundary),
  graph_bind(handle, ty, reason) => // The guard reads THIS instance's state DIRECTLY: the occurs family is
  // mechanism-layer (state-passed, zero ops), so the check can neither
  // chase a wrong instance (an arm's performs resolve OUTER of its own
  // install — the class that made the write guard read whatever graph
  // the enclosing chain held) nor charge GraphRead into this handler's
  // residual (the row leak that carried the render/guard ops past every
  // bracket into the wheel's own root row).
  if occurs_in(nodes, handle, ty) {
    // STORED, NOT REPORTED, AND NOT RENDERED. A report here resolves OUTER
    // of this install, so it would sail past any capture bracket installed
    // deeper (where speculation installs one, so the refusal the Mycroft
    // retry keys on never reached it), and a render here would chase a
    // graph that is not this arm's world. The arm notes the fact and the
    // module in force — its HANDLE, which is what a report is made at
    // (report_at reads the name and the layer off the node); the body
    // drains it at the judgment boundary and renders it there
    // (graph_guard_drain). This belt guards the binds no unify pre-check
    // saw.
    let dm = cur_module
    let g1 = push(guard_diags, (EOccursCheck(handle, ty, reason_span_or_zero(reason)), dm))
    // The poly-recursion teach rides the refusal: an infinite type through
    // a fn's OWN param or return mint (read from this instance's own
    // state) is the self-call-at-a-different-type fingerprint.
    let g2 = match graph_node_at(nodes, handle) {
      GNode(_, mint_r) => match mint_r {
        FnParam(owner, _, _) => push(g1, (TPolyRecursionSignature(owner, reason_span_or_zero(reason)), dm)),
        FnReturn(owner, _) => push(g1, (TPolyRecursionSignature(owner, reason_span_or_zero(reason)), dm)),
        Declared(_)
        | Inferred(_)
        | Fresh(_)
        | OpConstraint(_, _, _)
        | VarLookup(_, _)
        | MatchBranch(_, _)
        | ListElement(_)
        | IfBranch(_)
        | LetBinding(_, _)
        | Unified(_, _)
        | Instantiation(_, _)
        | Placeholder(_)
        | MissingVar(_)
        | Refinement(_, _)
        | Located(_, _)
        | InferredCallReturn(_, _)
        | InferredPipeResult(_, _)
        | DefaultReason(_, _)
        | Accepted(_, _, _)
        | EffectEnters(_, _, _)
        | LabelEnters(_, _, _)
        | ChainInstall(_, _)
        | StateBinding(_, _) => g1,
      },
    }
    resume() with guard_diags = g2
  } else {
    // The cell takes the SHAPE: a refinement is a fact about a value, read
    // along its flow edges, and a cell is the class union-find merges
    // values into (types.mn shape_of).
    resume() with epoch = epoch + 1, nodes = pt_set(
      nodes,
      mark,
      handle,
      GNode(NBound(shape_of(ty)), accepted_reason(accepted, spans, module, program, handle, reason))
    )
  },
  graph_bind_hole(handle, reason) => // The productive-under-error poison write (infer.mn:24's law, given its
  // graph op): the node becomes an OBSERVED FAILURE. No occurs check — a hole
  // carries no type to cycle through. A column of the version like every
  // write, so a restored speculation takes a poison back with everything
  // else.
  resume() with epoch = epoch + 1, nodes = pt_set(nodes, mark, handle, GNode(NErrorHole(reason), reason)),
  graph_bind_row(handle, row, reason) => // A row is a SET, so a row var referencing itself (v = names ∪ v) is
  // idempotent — the least fixed point is `names`, v contributes nothing new,
  // and there is no infinite row (the effect universe is finite). Binding the
  // growing self-reference is what spins subst_row/subst_ty forever (the
  // result()->r cycle: r's Iterate payload names r's own row). Union-find never
  // unions a root with itself; the row sort is no different — leave the tail
  // free, resolve_row folds the names forward. NOT reported: unlike a type
  // occurs (a real infinite type), a row self-loop is benign set-idempotence.
  // The guard reads THIS instance's state directly (the graph_bind arm's
  // law): state-passed, zero ops, no wrong instance, no residual charge.
  if occurs_in_row(nodes, handle, row) {
    resume()
  } else {
    // THE TEACHING WRITE IS A JOIN. A row cell is a join-semilattice
    // (present sets grow by union — the SET law above at the write): a
    // bind on an already-bound cell takes union_row(stored, incoming),
    // never a replace. Joins commute and idempote, so N caller branches
    // teaching one shared cell converge to the SAME value in ANY order —
    // the LVar/CALM law, and the death of the window-8 rebind race (the
    // born-reason census caught one cell serially re-taught five deep,
    // the surviving value whichever branch ran last; last-writer-wins
    // was also QUIETLY LOSING earlier callers' contributions in the
    // sequential walk, absorbed only by the rounds re-deriving). The
    // decl-exit REPLACE is a different operation with its own op
    // (graph_finalize_row below); the freeze that makes lattice reads
    // sound is the infer→lower phase boundary, already structural.
    let stored = match graph_node_at(nodes, handle) {
      GNode(NRowBound(prev), r0) => {
        if row_frag_collision(prev, row) {
          // The census line speaks SPANS only (pure projections): a
          // show_reason here would perform GraphRead + Intern from the
          // arm — ops that resolve OUTER and ride this handler's
          // residual past every bracket (the face-pollution root the
          // root-row gate refused: the wheel's own main carrying
          // GraphRead + Intern it never performs).
          eprint_string("FRAGX {int_to_str(handle)} born-at {show_span(reason_span_or_zero(r0))} why-at {show_span(reason_span_or_zero(reason))}\n")
        } else {
          ()
        }
        row_join(prev, row)
      },
      GNode(_, _) => row,
    }
    // THE FLAT-CELL LAW at the teaching write: the joined value folds
    // before it stores, so the cell holds depth-1 truth and every
    // read is a flat lookup (flatten_row_stored's own header).
    resume() with epoch = epoch + 1, nodes = pt_set(nodes, mark, handle, GNode(NRowBound(flatten_row_stored(nodes, stored, handle)), reason))
  },
  graph_finalize_row(handle, row, reason) => // The decl-exit REPLACE — inf_exit_fn publishing the frame's accumulated
  // row as the fn's verdict. Not a join: the frame's accumulation is the
  // decl's own total, already containing everything the body taught, and
  // joining it with the placeholder's interim content would re-widen what
  // row_without_self deliberately stripped. One writer per cell for this
  // op (each decl finalizes its own row_handle, in its own branch). The
  // finalize stores flat too (THE FLAT-CELL LAW — the published verdict is a
  // depth-1 value every caller reads without recursion).
  resume() with epoch = epoch + 1, nodes = pt_set(nodes, mark, handle, GNode(NRowBound(flatten_row_stored(nodes, row, handle)), reason)),
  graph_compress_row(v, row) => // Path compression at the row sort — an OPTIMIZATION write, distinct
  // from the judgment bind by OP so the policy lives where the band facts
  // live. A candidate is judged on the one live graph inside a version, so
  // every walk is the root's and compresses at full strength. The target is
  // NRowBound by construction (compression only fires on a bound link), so
  // no self-loop guard.
  //
  // These writes DO move the cell, which the first-divergence read must
  // account for: a compression write is optimization, not meaning, and is
  // order-dependent, so a segment diff filters them
  // (`Hβ.synth.divergence-from-the-trail`).
  resume() with epoch = epoch + 1, nodes = pt_set(nodes, mark, v, GNode(NRowBound(row), Inferred("row path compression"))),
  graph_gate_add(handle, gate) => // The gate column's one write: entered under the cell's handle, a column
  // of the version, so a speculative judgment (the ??-fan's candidate, a
  // Mycroft round) that installs gates and is restored leaves none behind.
  resume() with epoch = epoch + 1, gates = pt_push(gates, mark, handle, gate),
  graph_instance_note(root, fresh) => resume() with instances = pt_push(instances, mark, root, fresh),
  graph_gates_of(handle) => resume(pt_all(gates, handle)),
  graph_instances_of(handle) => resume(pt_all(instances, handle)),
  graph_demand_add(handle, demand) => // The demand column's one write — the row gate column's twin over TYPE
  // cells: entered under the cell's handle, a column of the version, so a
  // restored speculation leaves no demand behind.
  resume() with epoch = epoch + 1, demands = pt_push(demands, mark, handle, demand),
  graph_demands_of(handle) => resume(pt_all(demands, handle)),
  graph_bind_record_row(handle, fields, tail, reason) => // The record-row residual bind — a `...R` rest's remaining fields, under
  // its OWN node kind (NRecordRowBound). Binding residuals under NRowBound
  // made the row slot an untagged EffRow-or-Ty union every row walk's
  // catch-all silently crossed. The occurs guard is the TYPE-side check over
  // each field ty (a residual's self-reference is a real infinite type), and
  // the tail's own self-reference is the row-side half of the same check.
  if occurs_in_record_fields(nodes, handle, fields) || record_row_tail_is(tail, handle) {
    resume()
  } else {
    // The TAIL rides from the writer that knew it (types.mn RecordRowTail):
    // proven, continuing, or assumed. It is never re-derived here, because
    // the fields alone cannot say which of the three produced them.
    resume() with epoch = epoch + 1, nodes = pt_set(nodes, mark, handle, GNode(NRecordRowBound(fields, tail), reason))
  },
  graph_index_span(span, handle) => // ONE write, TWO projections: the ordered (span, handle) log serves the
  // containment scans (address resolution walks span -> handle); the spans
  // column serves the by-handle O(1) read (graph_span_of).
  resume() with spans = pt_set(spans, mark, handle, span), span_index = push(span_index, (span, handle)),
  graph_ref_link(r, decl) => // THE REFERENCE LINK's write (M1): the reference's cell forward, the
  // declaration's in-edge back, both columns of the version so a restored
  // judgment's links go with it. A reference already linked to this
  // declaration writes nothing.
  if pt_get(links, r) == decl + 1 {
    resume()
  } else {
    resume() with links = pt_set(links, mark, r, decl + 1), in_edges = pt_push(in_edges, mark, decl, UseBy(r))
  },
  graph_ref_decl(r) => resume(link_at(links, r)),
  graph_refs_of(decl) => // The current generation's references: the registration that supersedes
  // a module drops what its generation linked (graph_register_node), because
  // a reader handed a re-judged module's older references counts a program
  // that no longer exists (the generation oracle, 2026-10-02). A reference
  // re-linked elsewhere leaves its entry here, and its own cell says so.
  resume(distinct_handles(flat_map(use_still_linked(links, module, parent, superseded, decl, ??), pt_all(in_edges, decl)))),
  graph_apply_note(decl, call) => resume() with in_edges = pt_push(in_edges, mark, decl, AppliedAt(call)),
  graph_applies_of(decl) => resume(distinct_handles(flat_map(application_at(module, parent, superseded, ??), pt_all(in_edges, decl)))),
  graph_publish(decl, scheme, reason, kind) => // What the judgment learned about a declaration, at its handle, newest
  // last — the facts the env's entries carried by name until 2026-10-14.
  resume() with published = pt_push(published, mark, decl, (scheme, reason, kind)),
  graph_published(decl) => resume(pt_newest(published, decl)),
  graph_decl_note(decl_handle) => // The refs column's decl-granularity sibling — append-only telemetry,
  // the handler's own: judgment rounds re-note the same handle, readers
  // dedup by handle.
  resume() with decls_col = push(decls_col, decl_handle),
  graph_decls_at() => resume(decls_col),
  graph_node_current(h) => resume(current_at(module, parent, superseded, h)),
  graph_supersede(stmts) => // An edit's replaced statements, marked where every currency read asks
  // (current_at), and the decls column kept to what the program still
  // declares — once per edit, as a module's supersession keeps it, so the
  // proof fragment's per-name read of the column never filters it again.
  {
    let gone = fold(superseded, (acc, s) => wmap_add(acc, s, 1), stmts)
    resume() with superseded = gone, decls_col = filter(current_at(module, parent, gone, ??), decls_col)
  },
  graph_tails_note(tails) => resume() with tails_idx = smap_build_from(tails, len(tails) - 1, tails_idx),
  graph_tails() => resume(tails_idx),
  graph_module_now(file) => resume(smap_get(modules_now, file)),
  graph_link() => resume(link_now),
  graph_hole_note(h) => // The value-holes column's pending half: lower's authored-hole arm is
  // the one writer (value-position is a lowering decision); the reach
  // drains it with each declaration it constructs.
  resume() with holes_pend = push(holes_pend, h),
  graph_hole_drain() => // Empty pending — the overwhelming case — resumes without a state
  // rebind, so the per-declaration drain costs nothing when no hole is
  // waiting.
  if len(holes_pend) == 0 { resume(holes_pend) } else { resume(holes_pend) with holes_pend = [] },
  graph_holes_publish(hs) => resume() with holes_col = hs,
  graph_guard_drain() => // The write guard's stored refusals, handed to the body that can narrate
  // them. Empty — the overwhelming case — resumes without a state rebind,
  // so the per-judgment drain costs nothing when no bind refused.
  if len(guard_diags) == 0 { resume([]) } else { resume(guard_diags) with guard_diags = [] },
  graph_hole_unnote(h) => resume() with holes_pend = holes_pend_without(holes_pend, h),
  graph_holes_at() => resume(holes_col),
  graph_row_note(h, row) => // THE ROW NOTE's write (C5): what a construct charges, under the node
  // that charges it — the frame join's per-node twin, entered under the
  // handle like the gates, a column of the version so a restored judgment's
  // notes go with its bindings.
  resume() with epoch = epoch + 1, rows = pt_push(rows, mark, h, row),
  graph_rows_at(h) => resume(pt_all(rows, h)),
  graph_binder_note(h, fact) => // THE BINDER FACT's write (P0): newest last under the binder's handle, a
  // column of the version — a binder minted inside a speculative judgment is
  // a handle the restore hands out again, so its fact must go with it.
  resume() with epoch = epoch + 1, binders = pt_push(binders, mark, h, fact),
  graph_let_born_note(h) => // The parse's note that it made the node of a destructuring `let`, a
  // column of the version for the same reason a binder's fact is: a node
  // minted inside a speculation is a handle the restore hands out again.
  resume() with epoch = epoch + 1, births = pt_set(births, mark, h, 1),
  graph_store_claim_note(h, claim) => // A declaration's store claim, a column of the version like a binder's
  // fact: a declaration judged inside a speculation takes its claim back
  // with it, and the image carries every claim to a warm start.
  resume() with epoch = epoch + 1, store_claims = pt_push(store_claims, mark, h, claim),
  graph_binder_of(h) => resume(pt_newest(binders, h)),
  graph_let_born(h) => resume(pt_get(births, h) != 0),
  graph_store_claim_of(h) => resume(pt_newest(store_claims, h)),
  graph_owe_late(g, payer) => // THE LATE PAYERS' write (P0): a frame called through a guard cell its
  // declaration has not written yet. Entered under the cell, a column of the
  // version, so a restored judgment's payments go with it.
  resume() with epoch = epoch + 1, late = pt_push(late, mark, g, payer),
  graph_late_payers(g) => resume(pt_all(late, g)),
  graph_claim_note(h, contract) => // THE CLAIMS' write (P0): a contract claimed of the value at a node,
  // entered under its handle, a column of the version so a restored
  // judgment's claims go with it.
  resume() with epoch = epoch + 1, claims = pt_push(claims, mark, h, contract),
  graph_claims_of(h) => resume(pt_all(claims, h)),
  graph_written_since(below) => // The write set of the innermost open version: the cells below the
  // frontier whose type or row cell the graph and that version disagree on,
  // compared root to leaf and skipping every page the two share. With no
  // version open nothing is speculative, and the set is empty.
  resume(if len(versions) == 0 { [] } else { pt_changed(nodes, last(versions).nodes, below) }),
  graph_accept_note(path, span, text, proof) => // THE ACCEPT EDGE's write (C4): an outermost-boundary fact. A human
  // accepted a proposal; nothing speculative writes here, and a restore
  // must never lose it — so an open version is a defect in the caller and
  // traps rather than storing a fact outside what the restore reverts to.
  // The read is graph_bind's.
  {
    if len(versions) > 0 { out_of_range() } else { 0 }
    resume() with accepted = push(accepted, (path, span, text, proof))
  },
  graph_install_note(h, ish) => // The install-shape column: a cell at the install node's handle, written
  // by the lowering, which runs after the judgment; a re-lower writes the
  // same shape.
  resume() with installs = pt_set(installs, mark, h, ish),
  graph_install_at(h) => resume(pt_get(installs, h)),
  graph_product_note(h, slots, holes, shape) => // The call-product column's one write — the judgment's, a column of the
  // version: a candidate or a Mycroft round that noted a product and is
  // restored leaves the cell as it found it.
  resume() with epoch = epoch + 1, products = pt_set(products, mark, h, ProductOf(slots, holes, shape)),
  graph_product_at(h) => resume(pt_get(products, h)),
  graph_emitfn_note(entry) => // The emittable-fn enumeration (the no-mint resolution): one append per
  // synthesized-fn construction, in lower's deterministic walk order. The
  // handler's own by the decls contract; the step-iii reader filters by the
  // reach set.
  resume() with emitfns_col = push(emitfns_col, entry),
  graph_emitfn_at(fn_name) => // The enumeration's by-name O(1) read — the identity projection of the
  // ordered column, MATERIALIZED ON DEMAND (the note path stays one push;
  // piggybacking the index there measured +94MB of hot-arm state
  // rebinds). The coverage is the COLUMN LENGTH the index was folded
  // from, not a boolean: an equal length means the projection is whole,
  // a shorter one names exactly the suffix to fold in, so interleaved
  // notes and reads cost O(new entries) total across a run and never a
  // rebuild. A latched flag went stale the moment a note followed a read
  // — which is precisely what the emit-time worklist does
  // (Hβ.lower.lowering-is-a-column).
  //
  // What the reader gets is the multi-map's newest-first bucket, and the
  // relocation's worklist resolves through it without the quadratic
  // column scan the floor dig measured at a 106s m3 leg. The table stays
  // UNALLOCATED until a read demands it: zero coverage means the field is
  // still the empty `[]` that costs nothing.
  if len(emitfns_col) == 0 {
    resume([])
  } else if emitfns_idx_covers == len(emitfns_col) {
    resume(smap_get_all(emitfns_idx, fn_name))
  } else {
    let seed = if emitfns_idx_covers == 0 { smap_new() } else { emitfns_idx }
    let grown = emitfns_index_build(emitfns_col, seed, emitfns_idx_covers)
    resume(smap_get_all(grown, fn_name)) with emitfns_idx = grown, emitfns_idx_covers = len(emitfns_col)
  },
  graph_sigs_publish(pairs) => // THE SIGNATURE COLUMN's one write. The whole table lands in a single
  // rebind at the emit settling point, so no reader can observe a partial
  // one — the property N per-symbol notes could not give.
  resume() with sigs_col = smap_build(pairs),
  graph_sig_at(name) => // Unpublished is the empty `[]` that costs nothing. Every read before the
  // publish — every non-emit route, the check and query verbs, the
  // judgment's own — answers None and takes the word floor.
  if len(sigs_col) == 0 { resume(None) } else { resume(smap_get(sigs_col, name)) },
}

// THE FORKING HANDLERS. Speculation is a choice whose resumptions a bracket
// isolates: each handler answers `choose` (lib/choice.mn) by resuming the
// computation once per option. A site that judges candidates says what one
// candidate's judgment is; the handler that catches the resumptions says how
// they are judged, and the bracket — the version taken, the world's top, the
// restore or the keep — is written here and nowhere else.
//
// `speculate` judges every option against a version of the graph and
// restores it: the version is taken before the option's arena opens, so the
// option's every write lands past the mark and copies what it touches, the
// options are independent — the fanout says so: under no schedule it runs
// them in order, and a schedule installed over the judgment may run them on
// threads once each option's other handlers are its own — and the restore
// runs before the arena exits, so the state reaches nothing the arena
// reclaims. Each resumption runs in an arena (lib/arena.mn): what crosses
// its exit is the answer and whatever the resumption stored into older
// memory that no version carries — a name it was the first to intern stays
// in the table, as interning anywhere else would leave it. The world is
// restored after the resumption ends, and both before anything replays a
// branch's facts, so the replay's performs resolve to the root's chain.
handler speculate {
  choose(options) => options |> fanout({
    o => {
      let v = graph_version()
      {
        let w = world_top()
        let answers = resume(o)
        world_restore(w)
        graph_restore(v)
        answers
      } ~> arena
    },
  }) |> flatten,
}

// `first_held` judges the options in order and keeps the first whose answer
// holds, restoring the version before every other; none after it is
// resumed. The kept resumption's writes stand as truth: its version is
// dropped, never restored, so a speculation around it can still undo them.
// Each resumption is an extent of its own and runs in an arena, as
// `speculate`'s do: a round's page copies die at its end, kept or restored,
// and a round that did not hold leaves nothing behind, where the rounds of
// a binding group once stacked their scratch until the group's extent ended.
handler first_held {
  choose(options) => options |> fold(
    false,
    (held, o) => held || {
      let v = graph_version()
      {
        if resume(o) {
          graph_keep(v)
          true
        } else {
          graph_restore(v)
          false
        }
      } ~> arena
    }
  ),
}

// Pure graph operations — the mechanism
// Internal machinery the handler delegates to. All pure; all
// deterministic; no effects.
//
// Follow NBound / NRowBound links until terminal. Amortized O(1) —
// chains shallow in practice, depth-limited for cycle safety.
fn chase_node(ref nodes, handle, depth) with !Mutate = if depth > 100 {
  GNode(NErrorHole(Inferred("chase depth exceeded")), Fresh(handle))
} else {
  match graph_node_at(nodes, handle) {
    GNode(kind, reason) => match kind {
      NBound(ty) => match ty {
        TVar(next) => chase_node(nodes, next, depth + 1),
        TInt
        | TFloat
        | TUnit
        | TByte
        | TAddr
        | TList(_)
        | TTuple(_)
        | TFun(_, _, _)
        | TName(_, _)
        | TRecord(_)
        | TRecordOpen(_, _)
        | TRefined(_, _)
        | TReprPin(_, _)
        | TCont(_, _, _, _)
        | TAlias(_, _) => GNode(kind, reason),
      },
      NRowBound(row) => match row {
        // The chase folds the chain under the READING LAW: each level's
        // present rides forward MINUS the levels above it masked, and the
        // absents ACCUMULATE — the discarded-absent destructure here was
        // the mask-killer at the one mechanism every row read routes
        // through (a `~>` subtraction bound mid-chain vanished from every
        // graph_chase, so published faces carried the unmasked union and
        // the root-row gate refused the wheel's own main). A SINGLE edge
        // is a chain link and the chase follows it; a MULTI-edge tail is
        // not a chain — the cell is its own terminal, and every content
        // read rides resolve's fold (which walks each edge). The link's
        // own mask joins the masks carried forward: it is this path's.
        EfRow(names, absents, EtOpen(edges)) => if len(edges) == 1 {
          let next = edge_cell(last(edges))
          chase_node(nodes, next, depth + 1) |> merge_chased_row(??, names, name_set_union(absents, edge_mask(last(edges))), next)
        } else {
          GNode(kind, reason)
        },
        EfRow(_, _, _) => GNode(kind, reason),
      },
      NFree(_) | NRowFree(_) | NRecordRowBound(_, _) | NErrorHole(_) => GNode(kind, reason),
    },
  }
}

// The emitfn index's extension — the column's UNCOVERED SUFFIX folded
// into the by-name smap. `i` is the coverage the caller already holds,
// so the first read folds the whole column and a read after later notes
// folds only what those notes added.
fn emitfns_index_build(col, idx, i) = fold(idx, emitfn_index_note, slice(col, i, len(col)))

fn emitfn_index_note(acc, e) = smap_add(acc, e.name, e)

// The unnote's filter — the pipe-consumed hole leaves the pending buffer.
fn holes_pend_without(hs, h) = fold([], (a, x) => if x == h { a } else { push(a, x) }, hs)

// chase_handle — union-find `find`: follow the TVar chain to the
// canonical ROOT handle (the integer), not the node. unify unions the
// roots; binding a surface alias instead strands the canonical var
// free. Mirror of chase_node's NBound(TVar) arm, returning the handle.
fn chase_handle(ref nodes, handle, depth) with !Mutate = if depth > 100 {
  handle
} else {
  match graph_node_at(nodes, handle) {
    GNode(kind, _) => match kind {
      NBound(ty) => match ty {
        TVar(next) => chase_handle(nodes, next, depth + 1),
        TInt
        | TFloat
        | TUnit
        | TByte
        | TAddr
        | TList(_)
        | TTuple(_)
        | TFun(_, _, _)
        | TName(_, _)
        | TRecord(_)
        | TRecordOpen(_, _)
        | TRefined(_, _)
        | TReprPin(_, _)
        | TCont(_, _, _, _)
        | TAlias(_, _) => handle,
      },
      // Row aliases: unify_row links open row cells as `va → EfRow(_, _, EtOpen([vb]))`.
      // find follows a SINGLE edge to the canonical root, exactly as it
      // follows TVar — so generalize/instantiate quantify a buried row
      // tail (the row mirror of the type-var find). Type handles never
      // reach this arm; a MULTI-edge tail has no single root, so the
      // cell is its own canonical handle (content reads ride resolve).
      NRowBound(row) => match row {
        EfRow(_, _, EtOpen(edges)) => if len(edges) == 1 { chase_handle(nodes, edge_cell(last(edges)), depth + 1) } else { handle },
        EfRow(_, _, _) => handle,
      },
      NFree(_) | NRowFree(_) | NRecordRowBound(_, _) | NErrorHole(_) => handle,
    },
  }
}

// When chasing a var-tailed row that points to another row handle,
// fold the known names forward through the chain. free_handle is the
// handle we chased INTO — needed to reconstruct the var-tailed triple
// when the chain terminates at NRowFree (the free variable).
fn merge_chased_row(ref chased, ref names, ref absents, free_handle) = match chased {
  GNode(ck, cr) => match ck {
    NRowBound(inner) => GNode(NRowBound(merge_row(names, absents, inner)), cr),
    // EVERY non-bound terminal preserves the accumulated reading — the
    // names AND masks ride an edge to the terminal. NRowFree always did;
    // the former catch-all returned the bare terminal for every OTHER
    // ending — above all the cross-sort free t-cell a fn-typed param
    // chain ends at — so the mid-chain presents vanished from the read
    // and a final-pass publish whose chain ends at a free param cell
    // published Pure under a declared row (the forward-hof
    // false-absence root; the CELT-vs-CELB differential measured it).
    NBound(_) | NFree(_) | NRowFree(_) | NRecordRowBound(_, _) | NErrorHole(_) => if len(names) == 0 && len(absents) == 0 {
      chased
    } else {
      GNode(NRowBound(ef_make(names, absents, EtOpen([bare_edge(free_handle)]))), cr)
    },
  },
}

// ONE law for every tail (the reading law at the unwind): the deeper
// level's present joins MINUS this level's masks; the masks union. The
// former EtAll special case (return the deeper row whole) was
// reading-equal only when this level carried no absents — with the
// masks riding, the uniform arm is the truth for it too.
fn merge_row(ref names, ref absents, ref row) = match row {
  EfRow(p, a, t) => ef_make(name_set_union(names, name_set_diff(p, absents)), name_set_union(absents, a), t),
}

// THE FLAT-CELL LAW's WRITE half (PLAN's settled laws): a stored row
// never carries depth — every bound edge folds to its value HERE, at
// the two write ops, so reads are depth-1 by invariant and no read
// path ever recurses stored chains (the hub-cell wall's cure: the
// fold's cost is paid once per write, never per read). Free edges
// survive into the residual carrying their masks; a bound edge's content
// enters through edge_content_into, the one assembly every fold shares —
// this file held a second copy of that arithmetic, and the copy is where
// a `~>` mask became the whole row's: its `a' = a ∪ ca` filtered every
// sibling edge with an install that never covered it (measured
// 2026-09-26, `f() + ((g()) ~> h)` stored as `(r_f + r_g) − E`).
//
// AND NO CELL'S STORED ROW REACHES THE CELL. The fold runs before the put,
// on `written`'s current content, so a chain may pass THROUGH the cell being
// written, and a free terminal's edge was kept as its chain head: `D := D ∪
// [G]` with `G → D → T` stored `D = [T, G]`, and the next fold through D
// walked G → D → G until the stack ran out (measured 2026-10-01, two
// mutually recursive callers' precondition guards; the occurs check had
// compared the edge's first cell and its root, never the cells between). A
// row is a set, so what reaches the cell adds nothing to it: such an edge
// keeps its chain's terminal, and an edge that is the cell, or ends at it,
// keeps nothing.
// Mechanism-layer: state-passed, structural, zero ops.
fn flatten_row_stored(ref nodes, row, written) with !Mutate = match row {
  EfRow(p, a, t) => match t {
    EtOpen(vs) => match flatten_row_edges(nodes, edges_masked(vs, a), (p, [], [], false), written) {
      (rp, am, res, saw_all) => row_of_fold(rp, am, res, saw_all),
    },
    EtClosed | EtAll => row,
  },
}

fn flatten_row_edges(ref nodes, ref vs: [RowEdge], acc, written) with !Mutate = match vs {
  [] => acc,
  [e, ...rest] => match acc {
    (p, am, res, saw_all) => {
      let next = if edge_cell(e) == written {
        acc
      } else {
        match chase_node(nodes, edge_cell(e), 0) {
          GNode(kind, _) => match edge_row_of(kind) {
            Some(inner) => match edge_content_into(p, am, res, saw_all, edge_mask(e), flatten_row_stored(nodes, inner, written)) {
              (p2, am2, r2, s2, _) => (p2, am2, r2, s2),
            },
            None => (p, am, kept_edge(nodes, res, e, written), saw_all),
          },
        }
      }
      flatten_row_edges(nodes, rest, next, written)
    },
  },
}

// A free terminal's edge as the fold keeps it: the chain head, through which
// a later write anywhere along the chain still reaches the row — unless the
// chain passes through the cell being written, when it names the terminal
// instead, or nothing when the terminal is that cell. The chase reached the
// terminal with no names and no masks on the way (either would have bound
// the result), so the edge's own mask is the whole path's.
fn kept_edge(nodes, res, e, written) with !Mutate = if chain_passes(nodes, edge_cell(e), written, 0) {
  let t = chase_handle(nodes, edge_cell(e), 0)
  if t == written { res } else { tail_set_insert(res, row_edge(t, edge_mask(e))) }
} else {
  tail_set_insert(res, e)
}

// Does the link chain from `v` reach `written`? `chase_handle`'s walk, with
// the comparison at every cell rather than at the root alone.
fn chain_passes(nodes, v, written, depth) with !Mutate = if v == written {
  true
} else if depth > 100 {
  false
} else {
  match graph_node_at(nodes, v) {
    GNode(kind, _) => match kind {
      NBound(ty) => match ty {
        TVar(n) => chain_passes(nodes, n, written, depth + 1),
        TInt
        | TFloat
        | TUnit
        | TByte
        | TAddr
        | TList(_)
        | TTuple(_)
        | TFun(_, _, _)
        | TName(_, _)
        | TRecord(_)
        | TRecordOpen(_, _)
        | TRefined(_, _)
        | TReprPin(_, _)
        | TCont(_, _, _, _)
        | TAlias(_, _) => false,
      },
      NRowBound(row) => match row {
        EfRow(_, _, EtOpen(edges)) => if len(edges) == 1 {
          chain_passes(nodes, edge_cell(last(edges)), written, depth + 1)
        } else {
          false
        },
        EfRow(_, _, _) => false,
      },
      NFree(_) | NRowFree(_) | NRecordRowBound(_, _) | NErrorHole(_) => false,
    },
  }
}

// Occurs check
// Before graph_bind(h, ty, r): walk ty for free handles containing h.
// If found, inference emits E_OccursCheck and refuses. No silent
// binding. No cycle except through explicit <~ feedback.
//
// Iteration uses flat-indexed loops on list_to_flat'd inputs — snoc
// inputs materialize once at entry, flat inputs pass through. Walks
// short-circuit on first hit.
//
// H6: exhaustive Ty enumeration. A wildcard arm here silently
// misses a new Ty variant's containment check — the most
// dangerous site in the compiler because a missed occurs-check
// admits infinite types. Every current Ty variant is named; any
// future variant fails to compile until its containment semantics
// are decided explicitly.
fn occurs_in(nodes, handle, ref ty) = match ty {
  TInt => false,
  TFloat => false,
  TUnit => false,
  TByte => false,
  TAddr => false,
  // The leaf answers "does handle occur in the type GRAPH reachable from
  // here" — three tiers, each a hole the selfapply fixture found trapping
  // the compiler (f(f) spun chase_deep/subst_ty to stack exhaustion with
  // ZERO occurs reports): (1) the raw handle; (2) the ROOT (unify IS
  // union-find — the indirect cycle a ~ (b -> r) with b's root already a
  // passed a raw compare); (3) the root's BINDING, recursed — bind
  // graph_bind(a, TFun([b], r)) first (b free, passes), then close the
  // cycle with graph_bind(b, TVar(a)):
  // no handle comparison sees that cycle, only descending a's bound
  // structure does. Termination is the guarded-write invariant itself:
  // every bind runs this check, so the graph stays acyclic and the
  // recursion always bottoms out (chase_deep's depth tripwire is the
  // belt behind this suspender).
  TVar(id) => if id == handle {
    true
  } else {
    let root = chase_handle(nodes, id, 0)
    if root == handle {
      true
    } else {
      match chase_node(nodes, root, 0) {
        GNode(NBound(inner), _) => occurs_in(nodes, handle, inner),
        GNode(NRecordRowBound(fields, tail), _) => occurs_in_fields(nodes, handle, fields) || occurs_in_row_tail(nodes, handle, tail),
        GNode(_, _) => false,
      }
    }
  },
  TList(elem) => occurs_in(nodes, handle, elem),
  TTuple(elems) => occurs_in_list(nodes, handle, elems),
  TFun(params, ret, eff) => occurs_in_params(nodes, handle, params) || occurs_in(nodes, handle, ret) || occurs_in_row(nodes, handle, eff),
  TName(_, args) => occurs_in_list(nodes, handle, args),
  TRecord(fields) => occurs_in_fields(nodes, handle, fields),
  TRecordOpen(fields, v) => if v == handle || occurs_in_fields(nodes, handle, fields) {
    true
  } else {
    let vroot = chase_handle(nodes, v, 0)
    if vroot == handle {
      true
    } else {
      // The row is a CHAIN, and the guard walks all of it — the same links
      // record_row_full reads, so the three walks of a record row (free
      // variables, substitution, occurs) agree about where it ends.
      match chase_node(nodes, vroot, 0) {
        GNode(NRecordRowBound(rest, tail), _) => occurs_in_fields(nodes, handle, rest) || occurs_in_row_tail(nodes, handle, tail),
        GNode(NBound(inner), _) => occurs_in(nodes, handle, inner),
        GNode(_, _) => false,
      }
    }
  },
  TRefined(base, _) => occurs_in(nodes, handle, base),
  TCont(input, answer, _, world) => occurs_in(nodes, handle, input) || occurs_in(nodes, handle, answer) || occurs_in_row(nodes, handle, world),
  TAlias(_, inner) => occurs_in(nodes, handle, inner),
  TReprPin(_, base) => occurs_in(nodes, handle, base),
}

fn occurs_in_params(nodes, handle, ref params) = {
  let flat = list_to_flat(params)
  occurs_in_params_loop(nodes, handle, flat, 0, len(flat))
}

fn occurs_in_params_loop(nodes, handle, ref params, i, n) = if i >= n {
  false
} else {
  let ty = param_ty(list_index(params, i))
  if occurs_in(nodes, handle, ty) {
    true
  } else {
    occurs_in_params_loop(nodes, handle, params, i + 1, n)
  }
}

fn occurs_in_list(nodes, handle, ref tys) = {
  let flat = list_to_flat(tys)
  occurs_in_list_loop(nodes, handle, flat, 0, len(flat))
}

fn occurs_in_list_loop(nodes, handle, ref tys, i, n) = if i >= n {
  false
} else {
  if occurs_in(nodes, handle, list_index(tys, i)) {
    true
  } else {
    occurs_in_list_loop(nodes, handle, tys, i + 1, n)
  }
}

fn occurs_in_fields(nodes, handle, ref fields) = {
  let flat = list_to_flat(fields)
  occurs_in_fields_loop(nodes, handle, flat, 0, len(flat))
}

fn occurs_in_fields_loop(nodes, handle, ref fields, i, n) = if i >= n {
  false
} else {
  match list_index(fields, i) {
    (_, ty) => if occurs_in(nodes, handle, ty) {
      true
    } else {
      occurs_in_fields_loop(nodes, handle, fields, i + 1, n)
    },
  }
}

// The occurs-check twin of free_in_row: does `handle` appear in the row's
// parameterized-effect payload types (Iterate(a) carries a)? subst_ty freshens
// these payloads via subst_row, so the check MUST see them or a var bound to a
// type carrying itself in a row (result() -> r) escapes the check and subst_ty
// loops. One traversal shape across free_in_row / subst_row / here — they read
// the SAME structure; drift between them IS the bug this closes.
//
// ONE triple, one walk: the names on both fields plus the tail var —
// the three vars-of-a-row walks (free/occurs/subst) agree by having
// one shape to agree about.
// ONE WALK VISITS EACH ROW CELL ONCE. A row is a graph, not a tree: the
// cells of a binding group's rows are reached through one another along
// every call path of the cycle, so a walk that re-entered a cell per path
// was exponential in the group's depth. Measured 2026-09-28 on the wheel:
// the formatter's 46-member group spent 266 MB of the judgment's 565 MB
// high-water in one member's occurs checks (45 of them walked 17.4 million
// edges), and one more member doubled it. A cell's content answers the same
// question however it was reached, so the walk keeps a table of the roots
// already entered and a second arrival reads only the edge's own mask. The
// table is made where a row walk begins, which most occurs checks never
// reach.
fn occurs_in_row(nodes, handle, ref eff) = occurs_in_row_seen(nodes, handle, eff, wmap_new(16))

fn occurs_in_row_seen(nodes, handle, eff, seen) = match eff {
  EfRow(p, a, t) => if occurs_in_eff_names(nodes, handle, p) {
    true
  } else {
    if occurs_in_eff_names(nodes, handle, a) {
      true
    } else {
      match t {
        // A BOUND edge hides structure the write would embed: subst_row's
        // merge arm traverses into the binding, so the cycle guard must
        // reach the same leaves through EVERY edge (the trio law over
        // rows — any edge occurring is the row occurring). Structural
        // walk — the mechanism layer's own discipline.
        EtOpen(vs) => occurs_in_edges(nodes, handle, vs, seen),
        EtClosed | EtAll => false,
      }
    }
  },
}

fn occurs_in_edges(nodes, handle, ref vs: [RowEdge], seen) = match vs {
  [] => false,
  [e, ...rest] => {
    let v = edge_cell(e)
    let r = chase_handle(nodes, v, 0)
    // The mask is part of the edge's structure (a parameterized name can
    // carry a payload type), so the cycle guard reads it as subst does.
    let here = if v == handle || r == handle {
      true
    } else if occurs_in_eff_names(nodes, handle, edge_mask(e)) {
      true
    } else {
      match wmap_get(seen, r) {
        Some(_) => false,
        None => {
          wmap_add(seen, r, r)
          match chase_node(nodes, r, 0) {
            GNode(kind, _) => match edge_row_of(kind) {
              Some(inner) => occurs_in_row_seen(nodes, handle, inner, seen),
              None => false,
            },
          }
        },
      }
    }
    if here { true } else { occurs_in_edges(nodes, handle, rest, seen) }
  },
}

fn occurs_in_record_fields(nodes, handle, ref fields) = if len(fields) == 0 {
  false
} else {
  match last(fields) {
    (_, ty) => occurs_in(nodes, handle, ty) || occurs_in_record_fields(nodes, handle, drop_last(fields)),
  }
}

// The ROW-side half of the residual bind's occurs guard: a tail that
// continues at the very handle being bound is the row sort's own infinite
// type, and subst would walk it forever. The other two arms carry no
// handle, so there is nothing to close.
fn occurs_in_row_tail(nodes, handle, tail) = match tail {
  RowClosed => false,
  RowContinues(next) => occurs_in(nodes, handle, TRecordOpen([], next)),
}

fn record_row_tail_is(tail, handle) with Pure = match tail {
  RowClosed => false,
  RowContinues(v) => v == handle,
}

fn occurs_in_eff_names(nodes, handle, ref names) = {
  let flat = list_to_flat(names)
  occurs_in_eff_names_loop(nodes, handle, flat, 0, len(flat))
}

fn occurs_in_eff_names_loop(nodes, handle, ref names, i, n) = if i >= n {
  false
} else {
  let occ = match list_index(names, i) {
    ENamed(_) => false,
    EPure => false,
    EParameterized(_, args) => occurs_in_eff_args(nodes, handle, args),
  }
  if occ { true } else { occurs_in_eff_names_loop(nodes, handle, names, i + 1, n) }
}

fn occurs_in_eff_args(nodes, handle, ref args) = {
  let flat = list_to_flat(args)
  occurs_in_eff_args_loop(nodes, handle, flat, 0, len(flat))
}

fn occurs_in_eff_args_loop(nodes, handle, ref args, i, n) = if i >= n {
  false
} else {
  let occ = match list_index(args, i) {
    EAInt(_) => false,
    EAFloat(_) => false,
    EAString(_) => false,
    EAType(ty) => occurs_in(nodes, handle, ty),
    EANode(_) => false,
    // interned identities — no embedded Ty, nothing to occur in
    EAEffect(_) => false,
    EACon(_) => false,
  }
  if occ { true } else { occurs_in_eff_args_loop(nodes, handle, args, i + 1, n) }
}

// ── the one total child projection — the weave's tree edge ──────────
//
// DAG-homed here (the import-truth sweep, 2026-07-23): each fn below moved
// from a module DOWNSTREAM of its users so every user reaches it through a
// forward import edge — the manifest tells the truth. The census's tree
// walks, the enclosing-decl descent and lower's race rule (a handler's arms
// walked for a state write) all read THIS edge (moved from query.mn
// 2026-09-27), never a per-altitude copy.
//
// expr_child_handles — the type-handles of an Expr's direct child Nodes.
// One arm per Expr variant that carries children (the row algebra over
// the value space — H6 exhaustive); leaf literals carry none.
fn expr_child_handles(e) = match e {
  BinOpExpr(_, l, r) => [l, r],
  UnaryOpExpr(_, n) => [n],
  CallExpr(f, args) => [f] ++ args,
  // a lambda's parameters are nodes of its own, then its body
  LambdaExpr(params, body) => params ++ [body],
  IfExpr(c, t, f) => [c, t, f],
  // order-free: membership test only
  BlockExpr(stmts, fin) => [fin] ++ stmts,
  // an arm's pattern and body are child nodes — dropping the arms left
  // the projection partial and tree containment blind below any match
  // (the enclosing-decl guard's measured hole).
  MatchExpr(scrut, arms) => [scrut] ++ flat_map({ (p, b) => [p, b] }, arms),
  // A resume-with update is the parser's {name, init} record: the node
  // naming the field it writes, then the value written.
  ResumeExpr(v, updates) => [v] ++ flat_map(state_field_children, updates),
  MakeListExpr(elems) => elems,
  MakeTupleExpr(elems) => elems,
  // Record LITERALS carry the parser's (name, value) tuples
  // (parse_record_fields); only resume updates are {name, init} records.
  MakeRecordExpr(fields) => map(tuple_field_handle, fields),
  RecordUpdateExpr(base, flds) => [base] ++ map(tuple_field_handle, flds),
  NamedRecordExpr(head, flds) => [head] ++ map(tuple_field_handle, flds),
  IndexExpr(recv, idx) => [recv, idx],
  MakeStringExpr(frags) => frags,
  ShowExpr(inner) => [inner],
  FieldExpr(recv, _) => [recv],
  PipeExpr(_, l, r) => [l, r],
  FanoutExpr(branches) => branches,
  // the labeled value is a child node
  LabeledArg(_, v) => [v],
  // LitInt/LitFloat/LitString/LitBool/LitUnit/VarRef/ExprPlaceholder — no child Nodes
  LitInt(_)
  | LitFloat(_)
  | LitString(_)
  | LitBool(_)
  | LitUnit
  | VarRef(_)
  | RestExpr(_)
  | ExprPlaceholder => [],
}

// The field IS the parser's {name, init} record — read by field name (the
// tuple destructure read a record as positions and met Node): the binder
// node its name is written at, or the node naming the field an update
// writes, then its init.
fn state_field_children(field) = [field.name, field.init]

// A variant's node: the third of its (name, field types, node).
fn variant_node(variant) with Pure = match variant {
  (_, _, node) => node,
}

// An op's node: the fourth of its (name, params, result, node).
fn op_node(op) with Pure = match op {
  (_, _, _, node) => node,
}

fn tuple_field_handle(field) with Pure = match field {
  (_, v) => v,
}

// stmt_child_handles — expr_child_handles' Stmt sibling (the projection
// made TOTAL, Hβ.cursor.enclosing-decl-edge's dep): the child nodes of a
// statement. An import and an alias hold none.
fn stmt_child_handles(s) = match s {
  // the annotation channel is a child only when it IS one: an absent
  // annotation IS the value node (the parser's sentinel at every LetStmt
  // mint; its module-scope let reads the same identity), so listing it would
  // double-visit every unannotated let's value subtree — measured as
  // count_var_uses doubling through statement-position lets. The alias is
  // a fact of the HANDLES, so no body is read: the register arm draws its
  // parent edges through this projection, and an arm's performs resolve
  // outside its own install.
  LetStmt(pat, value, ann) => if ann == value { [pat, value] } else { [pat, value, ann] },
  // a declaration's parameters and its return annotation are nodes of its
  // own, before its body; an absent annotation IS the body, as a let's is
  // its value
  FnStmt(_name, params, ret, _effs, body) => if ret == body { params ++ [body] } else { params ++ [ret, body] },
  ExprStmt(e) => [e],
  HandlerDeclStmt(_hname, _ename, config, states, arms, _effs) => config ++ flat_map(state_field_children, states) ++ flat_map(arm_children, arms),
  HandlerChainStmt(_, chain) => [chain],
  // A type's variants and an effect's ops are its parts: each is a node the
  // parse minted, its parent the declaration that holds it, so an op reaches
  // its effect and a variant its type by the edge, never by a name.
  TypeDefStmt(_, variants) => map(variant_node, variants),
  EffectDeclStmt(_, params, ops) => params ++ map(op_node, ops),
  ImportStmt(_) => [],
  // A refinement's predicate is an expression over `self`, its child.
  RefineStmt(_, _, pred) => [pred],
  AliasStmt(_, _) => [],
  RowAliasStmt(_, _) => [],
}

// An arm's op name, its parameter nodes, then its body. The op name is a
// reference to the op it serves, so it is a node of the arm: the walk up from
// it reaches the handler, and an edit that replaces the effect judges the
// handlers serving its ops again, whose arms grade each op's discipline.
fn arm_children(arm) = [arm.op] ++ arm.args ++ [arm.body]

// body_child_handles — the ONE total child projection over NodeBody:
// tree walks (containment, the enclosing-decl descent) read this,
// never a per-altitude copy.
// THE ROW OF A SUBTREE — a read over structure (C5). The judgment charges
// every construct's cost on the node that builds it (the row notes,
// graph_row_note) and joins the same charges into the FRAME's row cell; a
// sub-expression's row was never readable, because the frame cell holds the
// whole declaration's total. It is a fold now: a node's own notes, resolved
// live, joined over its children's — with four constructs answering their
// OWN notes alone, or with one child, since what is under them does not run
// when they are evaluated (a lambda and a nested fn mint a record whose body
// is latent; a handler declaration installs nothing; a `<~` ticks its
// recurrence and never evaluates its delay spec, which is judged in a frame
// whose row is dropped — folding it made the caret say `Memory + Alloc` at
// a cycle `!Alloc` accepts) or is already summarized (a `~>` tee's note IS
// its body's row with the handler's absorption removed, so descending would
// re-add what the install absorbs). A hole answers None:
// an authored absence performs whatever the position may, and a reader
// asking "is this provably pure?" must hear no — except the slot a partial
// application leaves open, which is the field the closure awaits: the call
// that mints the closure runs nothing of it. The e-graph's absorb gate
// reads it; a sub-expression's Effects facet can.
fn row_of_subtree(h) with !Mutate = {
  let here = fold(mk_ef_pure(), (acc, r) => union_row(acc, resolve_row(r)), graph_rows_at(h))
  match graph_node_body(h) {
    NHole(_) => if hole_is_open_slot(h) { Some(here) } else { None },
    NExpr(LambdaExpr(_, _)) => Some(here),
    NStmt(FnStmt(_, _, _, _, _)) => Some(here),
    NStmt(HandlerDeclStmt(_, _, _, _, _, _)) => Some(here),
    NExpr(PipeExpr(PTee, _, _)) => Some(here),
    NExpr(PipeExpr(PFeedback, l, _)) => row_of_child(Some(here), l),
    body @ (
      NExpr(_)
      | NStmt(_)
      | NPat(_)
      | NModule(_)
      | NLink(_)
      | NTypeAnn(_)
      | NName(_)
      | NRow(_)
      | NParam(_)
    ) => fold(Some(here), row_of_child, body_child_handles(body)),
  }
}

// A slot of a suspended call's product, the hole standing in it directly or
// under its label.
fn hole_is_open_slot(h) = match graph_parent_of(h) {
  Some(p) => suspended_at(p, h) || match graph_parent_of(p) {
    Some(q) => suspended_at(q, h),
    None => false,
  },
  None => false,
}

fn suspended_at(p, h) = match graph_product_at(p) {
  ProductOf(nodes, _, CallSuspended) => any({ n => n == h }, nodes),
  ProductOf(_, _, CallApplied) | NoProduct => false,
}

fn row_of_child(acc, c) = match acc {
  None => None,
  Some(row) => match row_of_subtree(c) {
    None => None,
    Some(cr) => Some(union_row(row, cr)),
  },
}

// A node's children: the handles its body holds.
fn node_children(h) = body_child_handles(graph_node_body(h))

// A node and every node below it, in the walk's order.
fn nodes_under(h) = [h] ++ flat_map(nodes_under, node_children(h))

// The names a top-level statement declares into the link's scope: its head,
// each constructor or op its entry lists, and every binder a module value's
// pattern writes. A statement's retraction and the session's collision read
// both start here.
fn stmt_names(stmt) = match graph_node_body(stmt) {
  NStmt(s) => match s {
    TypeDefStmt(n, variants) => [n] ++ map(part_variant_name, variants),
    EffectDeclStmt(n, _, ops) => [n] ++ map(part_op_name, ops),
    LetStmt(pat, _, _) => nodes_under(pat) |> flat_map(binder_name_at),
    FnStmt(_, _, _, _, _)
    | HandlerDeclStmt(_, _, _, _, _, _)
    | HandlerChainStmt(_, _)
    | RefineStmt(_, _, _)
    | AliasStmt(_, _)
    | RowAliasStmt(_, _)
    | ExprStmt(_)
    | ImportStmt(_) => option_list(head_spelling(s)),
  },
  NExpr(_) | NPat(_) | NHole(_) | NModule(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => [],
}

fn binder_name_at(h) = match graph_node_body(h) {
  NPat(p) => option_list(binder_spelling(p)),
  NExpr(_)
  | NStmt(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => [],
}

fn option_list(o) = match o {
  Some(x) => [x],
  None => [],
}

fn body_child_handles(body) = match body {
  NExpr(e) => expr_child_handles(e),
  NStmt(s) => stmt_child_handles(s),
  NPat(p) => pat_child_handles(p),
  NHole(_) => [],
  NModule(_) => [],
  NLink(_) => [],
  NTypeAnn(ty) => written_cells(ty),
  NName(_) => [],
  NRow(terms) => written_row_nodes(terms),
  // a parameter's pattern, then the annotation and the default it carries
  NParam(p) => [p.pat] ++ option_nodes(p.ann) ++ option_nodes(p.dflt),
}

// A function type's row cells: every open edge of its row, the written
// row's among them.
fn row_cells(row) = match row {
  EfRow(_, _, EtOpen(edges)) => map(
    {
      ed => match ed {
        RowEdge(r) => r.cell,
      },
    },
    edges
  ),
  EfRow(_, _, EtClosed) | EfRow(_, _, EtAll) => [],
}

// The nodes a written row places its names at, groups included.
fn written_row_nodes(terms) = flat_map({ (t, _, _) => term_nodes(t) }, terms)

fn term_nodes(t) = match t {
  RtEff(_, Some(n)) => [n],
  RtEff(_, None) => [],
  RtGroup(ts) => written_row_nodes(ts),
}

// A type annotation's children: the names it writes. Every variable a type
// holds as written is a name's cell (the parse's written_type_name), and a
// name's own arguments are its children in turn.
fn written_cells(ty) = match ty {
  TVar(h) => [h],
  TList(elem) => written_cells(elem),
  TTuple(elems) => flat_map(written_cells, elems),
  TFun(params, ret, row) => flat_map({ p => written_cells(param_ty(p)) }, params) ++ written_cells(ret) ++ row_cells(row),
  TName(_, args) => flat_map(written_cells, args),
  TRecord(fields) => flat_map({ (_, fty) => written_cells(fty) }, fields),
  TRecordOpen(fields, _) => flat_map({ (_, fty) => written_cells(fty) }, fields),
  TRefined(base, _) => written_cells(base),
  TCont(input, answer, _, _) => written_cells(input) ++ written_cells(answer),
  TAlias(_, inner) => written_cells(inner),
  TReprPin(_, base) => written_cells(base),
  TInt | TFloat | TUnit | TByte | TAddr => [],
}

// A pattern's sub-patterns, each a node of its own, a rest among them.
fn pat_child_handles(p) = match p {
  PCon(_, ps) => ps,
  PTuple(ps) => ps,
  PList(ps, rest) => ps ++ option_nodes(rest),
  PRecord(fields, rest) => map({ (_, f) => f }, fields) ++ option_nodes(rest),
  PAlt(ps) => ps,
  PAs(_, inner) => [inner],
  PVar(_) | PWild | PLit(_) => [],
}

fn option_nodes(rest) = match rest {
  Some(r) => [r],
  None => [],
}

// ── THE FANOUT REACH — one rule, asked one name at a time ────────────
//
// Whether a function reaches a fanout through DIRECT calls: its own body
// holds a `><`, a `<|` or a `fanout(f, xs)` call, or it directly calls a fn
// that does — never through a fn declared `!Thread` or `!Alloc`, which keeps
// its own frame's schedule and hands no demand on: a spawn performs `Thread`
// and builds its thunks, while the in-frame form builds nothing. A schedule an install demands
// crosses a call exactly this far (lower's spec_call_name), so the emit
// asks this rule before it demands a callee's schedule twin, and `mentl
// where` asks it, the same way, to say which callers' installs reach a
// fanout site. A lambda's or a nested fn's body is its own frame and never
// the enclosing fn's own fanout (`Hβ.lower.schedule-through-a-value`); a
// call inside one is not a direct call of the enclosing fn.
//
// The whole-program closure that stood here beside this rule had one
// reader, the `where` verb, which scanned every graph handle to build it
// and every handle again to find a body by name; both read the decls
// column now and the closure is gone (2026-10-02, D5).
//
// Whether a declaration's clause negates the named effect (`!Thread`) —
// the authored negation, read off the FnStmt it stands on.
fn declares_absent(clause, ename: String) =
  any({ (t, negated, _) => negated && term_spells(t, ename) }, clause)

// ONE ASK of the rule with the answers settled across asks carried in
// `memo`, keyed by declaration: an ask that found no fanout from its root
// settles every declaration it entered false (`fanout_reach_settle`), the
// root's reach being whole. The emit's spec registry and `where`'s demand
// walk both ask through here.
fn fanout_reach_ask(memo, decl: Int) = match fanout_reach_of({entered: [], memo, seen: wmap_new(64)}, decl) {
  (found, st) => (found, if found { st.memo } else { fold(st.memo, fanout_reach_settle, st.entered) }),
}

// THE RULE WALKED FROM ONE DECLARATION and no further. The memo carries the
// answers settled across asks; a declaration is entered ONCE per ask (the
// seen set, with the entered list its order), and a second meeting — a
// cycle, or a callee two paths share — answers false without walking again,
// since the ask's root settles it: a chain that found a fanout settles true
// as it returns, and a root that found none settles every declaration it
// entered false. A declaration with no fn body — a primitive, an op, a
// constructor — has nothing to reach through.
fn fanout_reach_of(st, decl: Int) = match wmap_get(st.memo, decl) {
  Some(v) => (v == 1, st),
  None => match wmap_get(st.seen, decl) {
    Some(_) => (false, st),
    None => match graph_node_body(decl) {
      NStmt(FnStmt(_, _, _, clause, body)) => if declares_absent(clause, "Thread") || declares_absent(clause, "Alloc") {
        (false, {entered: st.entered, memo: wmap_add(st.memo, decl, 0), seen: st.seen})
      } else {
        match fanout_fact((false, []), body) {
          (has_own, callees) => if has_own {
            (true, {entered: st.entered, memo: wmap_add(st.memo, decl, 1), seen: st.seen})
          } else {
            match fold(
              (false, {entered: push(st.entered, decl), memo: st.memo, seen: wmap_add(st.seen, decl, 1)}),
              fanout_reach_callee,
              callees
            ) {
              (found, inner) => (
                found,
                {
                  entered: inner.entered,
                  memo: if found { wmap_add(inner.memo, decl, 1) } else { inner.memo },
                  seen: inner.seen,
                }
              ),
            }
          },
        }
      },
      NExpr(_)
      | NStmt(_)
      | NPat(_)
      | NHole(_)
      | NModule(_)
      | NLink(_)
      | NTypeAnn(_)
      | NName(_)
      | NRow(_)
      | NParam(_) => (false, st),
    },
  },
}

fn fanout_reach_callee(acc, callee: Int) = match acc {
  (true, _) => acc,
  (false, st) => fanout_reach_of(st, callee),
}

// An ask that found no fanout from its root settles every declaration it
// entered.
fn fanout_reach_settle(memo, decl: Int) = wmap_add(memo, decl, 0)

// ONE pass over a body: whether it holds a fanout of its own and the
// declarations it calls directly, both at its own frame — a lambda or a
// nested fn starts another. A fold stage over `(own, callees)`, the
// accumulator first.
fn fanout_fact(acc, h) = {
  let body = graph_node_body(h)
  match body {
    NExpr(FanoutExpr(_)) => fold(fact_own(acc), fanout_fact, body_child_handles(body)),
    NExpr(PipeExpr(PFanout(_), _, _)) => fold(fact_own(acc), fanout_fact, body_child_handles(body)),
    NExpr(CallExpr(f, _)) => fold(fact_call(acc, f), fanout_fact, body_child_handles(body)),
    NExpr(LambdaExpr(_, _)) => acc,
    NStmt(FnStmt(_, _, _, _, _)) => acc,
    other @ (
      NExpr(_)
      | NStmt(_)
      | NPat(_)
      | NHole(_)
      | NModule(_)
      | NLink(_)
      | NTypeAnn(_)
      | NName(_)
      | NRow(_)
      | NParam(_)
    ) => fold(acc, fanout_fact, body_child_handles(other)),
  }
}

fn fact_own(acc) = match acc {
  (_, callees) => (true, callees),
}

// A call of the prelude's `fanout` is a fanout of the body's own.
fn fact_call(acc, f) = match graph_node_body(f) {
  NExpr(VarRef(_)) => match acc {
    (has_own, callees) => (has_own || callee_is_fanout(f), direct_callee(callees, f)),
  },
  NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => acc,
}

// A call is DIRECT when its callee's edge reaches a module-level
// declaration. A value — a parameter, a let, a nested fn — keeps its own
// frame's schedule (`Hβ.lower.schedule-through-a-value`), so its body is no
// part of this frame's reach.
fn direct_callee(callees, f) = match graph_ref_decl(f) {
  Some(d) => if at_module_level(d) { push(callees, d) } else { callees },
  None => callees,
}

fn callee_is_fanout(f) = match graph_node_body(f) {
  NExpr(VarRef(name)) => str_eq(name, "fanout"),
  NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => false,
}

// ── A PRODUCT BUILT AT A SITE, AND WHAT TAKES IT APART THERE ──────────
//
// A VERB NEVER COSTS MORE THAN ITS DESUGARING. A product a site builds and
// takes apart there is its parts, in registers, exactly as the `let`
// spelling is — only a product that ESCAPES (returned, stored, passed,
// captured, spawned) is a record. Two consumers take one apart where it
// stands: the one-arm positional destructure (`match p { (a, b) => … }`,
// which a tuple `let` desugars to at parse) and the N-ary stage a `|>`
// fills (PLAN §4②'s "merge folds into `|> merge_fn`", Faust's `,` then
// `:`). The JUDGMENT reads this to charge the product only where the
// record is built; the LOWERING reads it to bind the parts; so the two
// cannot disagree about what a fanout costs.
//
// How many parts the product at `h` has, and −1 for a value that is not one
// built here: a tuple literal's elements, a fanout's branches.
fn product_arity_at(h) = match graph_node_body(h) {
  NExpr(MakeTupleExpr(elems)) => len(elems),
  NExpr(FanoutExpr(branches)) => len(branches),
  NExpr(PipeExpr(PFanout(fan_own), _, right)) => match fan_own {
    FanDistribute => 2,
    FanShare => len(share_stages(right)),
  },
  NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => -1,
}

// A `<|`'s stages: the elements of the tuple it fans into, read here once for
// the judgment, the lowering, the formatter and the cursor. The parse makes a
// `<|` over one stage the pipe it is, a product of one being its field, so the
// right side of every `<|` the graph holds is a tuple literal of two or more;
// any other right side is a node no parse built, and the deliberate trap names
// the broken invariant where a reader would have guessed a branch.
fn share_stages(right) = match graph_node_body(right) {
  NExpr(MakeTupleExpr(elems)) => elems,
  NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => out_of_range(),
}

// The one arm whose tuple pattern binds every part of the product it
// scrutinizes — a binder or a wildcard at each position, so the match IS
// the destructuring and no arm can fail. `None` where the match is a real
// dispatch, which keeps its tuple.
fn destructure_subs(arms, n) = if n < 2 {
  None
} else {
  match arms {
    [(pat, _)] => match pat_of(pat) {
      PTuple(subs) => if len(subs) == n && all(pat_binds_only, subs) { Some(subs) } else { None },
      PVar(_) | PWild | PLit(_) | PCon(_, _) | PList(_, _) | PRecord(_, _) | PAlt(_) | PAs(_, _) => None,
    },
    [] | [_, _, ..._] => None,
  }
}

fn pat_binds_only(h) = match pat_of(h) {
  PVar(_) => true,
  PWild => true,
  PLit(_) => false,
  PCon(_, _) => false,
  PTuple(_) => false,
  PList(_, _) => false,
  PRecord(_, _) => false,
  PAlt(_) => false,
  PAs(_, _) => false,
}

// The arm's body, where the arms ARE that destructure.
fn destructure_body(arms) = match arms {
  [(_, body)] => Some(body),
  _ => None,
}

// WHO DECIDES whether a product is a record. A positional destructure is an
// AST fact, so the product's own judgment reads it; a pipe's merge turns on
// the stage's ARROW, which is judged after the product, so the PIPE charges
// its left (infer.mn's infer_pipe) once it knows. Everything else escapes and is
// charged where it is built.
type ProductFate = PfConsumed | PfByPipe | PfEscapes

fn product_fate(h) = match graph_parent_of(h) {
  None => PfEscapes,
  Some(p) => match graph_node_body(p) {
    NExpr(MatchExpr(scrut, arms)) => if scrut == h && is_some(destructure_subs(arms, product_arity_at(h))) {
      PfConsumed
    } else {
      PfEscapes
    },
    NExpr(PipeExpr(PForward, left, _)) => if left == h && product_arity_at(h) > 1 { PfByPipe } else { PfEscapes },
    NExpr(_)
    | NStmt(_)
    | NPat(_)
    | NHole(_)
    | NModule(_)
    | NLink(_)
    | NTypeAnn(_)
    | NName(_)
    | NRow(_)
    | NParam(_) => PfEscapes,
  },
}

// THE MERGE: a product of N fills a stage whose N slots are still open —
// the trailing holes the Stage Law puts the datum in, N of them. A stage
// with one hole takes the product WHOLE (an ordinary pipe), so the merge
// asks for exact agreement and never guesses.
fn product_fills_stage(h, right) = {
  let n = product_arity_at(h)
  n > 1 && stage_open_slots(right) == n
}

// A stage's open slots: the parameters of its own arrow, read live — a bare
// reference's whole parameter list, a partial's remaining ones (the partial
// node's type IS the remaining arrow), and −1 where nothing proves an arrow.
// A LITERAL stage says its own count on the page, which is what lets the
// merge be known before the literal is judged (the judgment reaches a pipe's
// left first).
fn stage_open_slots(right) = match graph_node_body(right) {
  NExpr(LambdaExpr(params, _)) => len(params),
  NExpr(_)
  | NStmt(_)
  | NPat(_)
  | NHole(_)
  | NModule(_)
  | NLink(_)
  | NTypeAnn(_)
  | NName(_)
  | NRow(_)
  | NParam(_) => match lookup_ty(right) {
    TFun(ps, _, _) => len(ps),
    TInt
    | TFloat
    | TUnit
    | TByte
    | TAddr
    | TList(_)
    | TTuple(_)
    | TVar(_)
    | TName(_, _)
    | TRecord(_)
    | TRecordOpen(_, _)
    | TRefined(_, _)
    | TReprPin(_, _)
    | TCont(_, _, _, _)
    | TAlias(_, _) => -1,
  },
}

// The MINT span of a handle — the reverse read of the span_index weave
// (fresh_handle writes (span, handle) at every mint). A node's REASON span
// can be overwritten by a later bind (a hole's reason becomes its binder's
// "declared as ..."), so a patch target must read the weave, never the
// reason. O(n) scan at felt cadence (once per accepted action); the O(1)
// form is the handle-indexed span weave (the §5.O name-is-handle sibling).
//
// Every module in this weave, in weave order. A position's module is never
// derived from these cells by span containment: every module numbers its
// lines from 1, so a span alone lies inside every file long enough to reach
// it, and the scan that answered that way (the proximity rank's, until
// 2026-10-01) read a decl on line 1 of any module as the caret's own. A
// node's module is the column `graph_module_of` reads.
//
// The DAG is a fact the driver PROVES on every invocation and then could not
// show anyone: answering "which modules does this entry pull?" meant a shell
// transitive-closure loop over `grep '^import'`, re-deriving by name what the
// graph holds by edge. That hand walk is what this projection retires, and it
// is a read of the link, never a second walk of the filesystem.
// ONE CELL PER MODULE OF THE LINK, as `(handle, path, span, decls)`: the
// modules of the program the graph holds, in the order the walk judged them.
// A module that left the program on an edit is no member of the link that
// replaced it, and a module a later parse of its file superseded is replaced
// by that parse where the link was registered, so no consumer is handed a
// module the program does not hold.
//
// The HANDLE leads because it is the module's identity and the other three
// are projections of the node it names; the cell's DECLS ride out with its
// path and span. Dropping them made every consumer that wanted a module's own
// content re-derive it from text — which is how 52 dead imports sat unseen: a
// grep cannot tell a used name from one named in a comment, and the graph
// can.
fn module_cells() with !Mutate = link_modules() |> fold([], module_cell_of)

// A member of the link's cell. A link holds modules alone.
fn module_cell_of(acc, h) with !Mutate = match graph_node_body(h) {
  NModule(m) => push(acc, (h, m.path, m.span, m.decls)),
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => out_of_range(),
}

// The program the graph holds, read off its link: its modules, the module a
// person named and the prelude every module speaks. None of them before any
// derivation.
fn link_modules() with !Mutate = match graph_link() {
  None => [],
  Some(l) => link_of(l).modules,
}

fn link_entry() with !Mutate = match graph_link() {
  None => None,
  Some(l) => link_of(l).entry,
}

fn link_prelude() with !Mutate = match graph_link() {
  None => None,
  Some(l) => link_of(l).prelude,
}

// The link's record at its handle; a handle the graph holds as its link is a
// link.
fn link_of(l) with !Mutate = match graph_node_body(l) {
  NLink(k) => k,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NModule(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => out_of_range(),
}

// A module's own record at its handle; an import edge and a member of the
// link reach a module.
fn module_of(mh) with !Mutate = match graph_node_body(mh) {
  NModule(m) => m,
  NExpr(_) | NStmt(_) | NPat(_) | NHole(_) | NLink(_) | NTypeAnn(_) | NName(_) | NRow(_) | NParam(_) => out_of_range(),
}

// The program's declarations, every module's in the link's order: what a
// compile lowers.
fn link_program() with !Mutate = link_modules() |> flat_map({ mh => module_of(mh).decls })

fn module_paths() with !Mutate = map({ (_h, p, _s, _d) => p }, module_cells())

// ─── Import reachability — can module A see module B's names? ────────
//
// THE ONE HOME for a question two readers ask of the same edges: the
// cursor's proximity rank (is the target's module depended on by the
// caret's?) and the comment-reference gate (may this prose name that
// decl?). It lived in cursor.mn, which imports infer, so the gate could
// not reach it — and a gate that cannot ask the question answers the
// wrong one: resolution fell back to the whole link's FLATTENED env,
// where a name resolves whether or not the module writing it can reach
// that name. Measured 2026-09-20: 0 unresolved on the entry link against
// 57 per module. It is homed in graph.mn because graph.mn is the DAG
// bottom, so every reader imports it.
//
// Every reader asks it as HANDLES: the judgment's (the comment-reference
// gate, the F0b import check) through infer_ctx's cached table below, the
// cursor's proximity and the proposer's rank through one module's row of
// it (`module_reach_of`). The by-path walk the proximity rank used per call
// is deleted with the span-read decay it served (2026-10-01).
//
// The whole module DAG's reachability in ONE graph walk (F0b, 2026-09-27):
// every module of the link and its closure along the import edges its node
// holds. Built once per judgment (infer_ctx caches it) so the per-reference
// import check is a table read, never a graph scan per VarRef.
fn module_reach_table() = {
  let ambient = ambient_closure()
  fold(wmap_new(64), reach_table_add(ambient), link_modules())
}

// The prelude is linked into every compile unasked (the link's prelude
// edge), so its closure is every module's — the ambient world, absent only
// where no prelude resolves.
fn ambient_closure() = match link_prelude() {
  None => [],
  Some(p) => module_closure(p),
}

// One module's row of the table: the modules it reaches through import
// edges, the ambient world included — for a reader asking of one module,
// which builds no table for the rest.
fn module_reach_of(mh: Int) with !Mutate = module_closure(mh) ++ ambient_closure()

fn reach_table_add(ambient, table, mh: Int) = wmap_add(table, mh, module_closure(mh) ++ ambient)

fn module_closure(mh: Int) = closure_walk([mh], [])

// The walk along the import edges each module node holds — the edges the
// driver drew where its walk resolved them, so no spelling is matched here.
fn closure_walk(frontier, seen) = match frontier {
  [] => seen,
  [m, ...rest] => if handles_contain(seen, m) {
    closure_walk(rest, seen)
  } else {
    closure_walk(rest ++ module_of(m).imports, push(seen, m))
  },
}

fn handles_contain(xs, h: Int) = any({ x => x == h }, xs)

fn reach_table_has(table, from: Int, to: Int) = match wmap_get(table, from) {
  None => false,
  Some(closure) => handles_contain(closure, to),
}

// The total source the medium processed for this entry — the SUM of every
// module's own extent. A graph read, so it is DETERMINISTIC: unlike a wall
// clock it can be ratcheted, and a landing that makes the medium process more
// source to answer the same question is a refusal rather than a number
// somebody notices later.
//
// IT WAS A MAX, and the max was right exactly as long as spans were offsets
// into ONE concatenated weave: the last line any module reached WAS the total,
// because the modules were laid end to end. The per-module parse makes every
// file start at line 1, so the max became the LONGEST MODULE — this answered
// 9929 (infer.mn's own length) for the whole 59,501-line wheel, and for two
// different entries whose only shared module was that one. A ratchet reading
// too small does not go red; it goes BLIND, and accepts every rise beneath the
// number it now reports (§11 tripwire 4). Summing the per-module extents is
// what "total source" meant all along; it is only now that the two differ.
fn weave_line_extent() with !Mutate = fold(
  0,
  (acc, c) => match c {
    (_h, _p, s, _d) => match s {
      Span(sl, _sc, el, _ec) => acc + (el - sl),
    },
  },
  module_cells()
)

// The ONLY route from a TypeHandle to a resolved Ty. Delegates to
// graph_chase. No cache. No staleness. Every observer reads live.
// The effect decl beside its ONE handler (the order-independence law).
effect LookupTy {
  lookup_ty(Int) -> Ty
  // The specialization bracket (named-generic twins): while set, the handler
  // answers a free var through the site's EXACT instantiation pairs (root
  // handle -> concrete type; sound since the subscript fracture fix made a
  // generic body's element classes one union-find root), and the
  // active enc lets the closure-mint arm redirect a nested lambda to its
  // twin record. State on the ONE LookupTy handler — never a second handler
  // (singleton tier).
  spec_ctx_set([(Int, Ty)], String)
  spec_ctx_clear()
  spec_enc_active() -> String
  spec_pairs_active() -> [(Int, Ty)]
}

// ─── the specialization projection — lookup_ty under a twin's pairs ──
//
// The key is the repr digit vector over the scheme's quantified vars, sorted
// by root handle — tiny, and maximally shared: every word instantiation IS
// the floor emission ([Int], String, records — byte-identical, Law 7); only
// a genuinely wide var mints a twin ($min$sp2 = min with its one var at f64).
fn spec_pairs_find(pairs, root) = match find({ (v, _) => v == root }, pairs) {
  Some(p) => match p {
    (_, t) => Some(t),
  },
  None => None,
}

// A RECORD ROW READ TO ITS END: every field its chain has learned, and what
// lies past them — nothing, proven, or the one free row variable the rest
// still is. Unify writes the chain and every reader walks it here (the
// offset, the twin key, the substitution, the free-variable collection), so
// no reader can stop one link short and call a partial set the whole.
type RowEnd = RowEndClosed | RowEndFree(Int)

fn record_row_full(fields, v) = match graph_chase(v) {
  GNode(kind, _) => match kind {
    NRecordRowBound(residual, RowClosed) => (fields ++ residual, RowEndClosed),
    NRecordRowBound(residual, RowContinues(next)) => record_row_full(fields ++ residual, next),
    NBound(t) => match t {
      TRecordOpen(more, next) => record_row_full(fields ++ more, next),
      TRecord(more) => (fields ++ more, RowEndClosed),
      // A row cell bound to any other type is ill-sorted; its rest is not
      // known, and a reader that needs it floors.
      TInt
      | TFloat
      | TUnit
      | TByte
      | TAddr
      | TList(_)
      | TTuple(_)
      | TFun(_, _, _)
      | TVar(_)
      | TName(_, _)
      | TRefined(_, _)
      | TReprPin(_, _)
      | TCont(_, _, _, _)
      | TAlias(_, _) => (fields, RowEndFree(graph_chase_handle(v))),
    },
    NFree(_) => (fields, RowEndFree(graph_chase_handle(v))),
    NRowFree(_) => (fields, RowEndFree(graph_chase_handle(v))),
    NErrorHole(_) => (fields, RowEndFree(graph_chase_handle(v))),
    NRowBound(_) => (fields, RowEndFree(graph_chase_handle(v))),
  },
}

// Exact root-keyed substitution — the twin's one rule. Sound since the
// subscript fracture fix (Force = UNIFY at IndexExpr): a generic body's
// element classes and the scheme's quantified vars are ONE union-find root,
// so a free leaf answers its OWN root's binding in the site's instantiation
// pairs — and a free var whose root is NOT in the pairs stays the honest
// floor TVar. This is the precision the interim free-leaf rule (every free =
// the one wide type) could not have, and it lifts the one-wide-type demand
// guard: multi-type generics (a := Float, b := Int) twin correctly.
fn spec_pair_or_var(u, pairs) = match spec_pairs_find(pairs, graph_chase_handle(u)) {
  Some(c) => c,
  None => TVar(u),
}

// A free record row's rest under a twin: the residual the site proved past
// it, or — for the copy an update makes, which no site pairs when the update
// is read inside its own body — the base's whole record under the same
// pairs with the written names taken out, less what the copy's chain holds
// in front of this end. A row that is its own base reads nothing through
// the relation.
fn spec_row_rest(t, pairs) = match spec_pairs_find(pairs, t) {
  Some(c) => Some(c),
  None => graph_demands_of(t) |> fold(None, spec_copy_rest(t, pairs, ??, ??)),
}

fn spec_copy_rest(t, pairs, found, d) = match found {
  Some(_) => found,
  None => match d {
    DemandCopy(base, copy, names) => match record_row_full([], copy) {
      (in_front, end) => match record_row_full([], base) {
        (_, base_end) => if row_ends_at(end, t) && !row_ends_at(base_end, t) {
          spec_copy_fields(spec_subst_pairs(TRecordOpen([], base), pairs), names, in_front)
        } else {
          None
        },
      },
    },
    DemandNumber(_) | DemandShape(_) | DemandLacks(_) => None,
  },
}

// The base's record, once the pairs close it, less the written names and
// the fields the copy's chain holds in front of its end.
fn spec_copy_fields(whole, names, in_front) = match whole {
  TRecord(fs) => Some(TRecord(filter({ f => copy_holds_past(names, in_front, f) }, fs))),
  TInt
  | TFloat
  | TUnit
  | TByte
  | TAddr
  | TList(_)
  | TTuple(_)
  | TFun(_, _, _)
  | TVar(_)
  | TName(_, _)
  | TRecordOpen(_, _)
  | TRefined(_, _)
  | TCont(_, _, _, _)
  | TAlias(_, _)
  | TReprPin(_, _) => None,
}

fn row_ends_at(end, t) = match end {
  RowEndFree(e) => graph_chase_handle(e) == t,
  RowEndClosed => false,
}

fn copy_holds_past(names, in_front, f) = match f {
  (n, _) => !any({ m => m == n }, names) && !any(field_is_named(n, ??), in_front),
}

fn field_is_named(n: String, g) = match g {
  (gn, _) => gn == n,
}

fn spec_subst_pairs(t, pairs) = match t {
  TVar(u) => match graph_chase(u) {
    GNode(kind, _r) => match kind {
      NBound(t2) => spec_subst_pairs(t2, pairs),
      NFree(_) => spec_pair_or_var(u, pairs),
      NErrorHole(_) => spec_pair_or_var(u, pairs),
      // an EFFECT row — not in the pair space, which keys value shapes
      NRowBound(_) => t,
      // A RECORD row var is a quantified var like any other, and the site that
      // closed it proved the whole field set. Returning it verbatim left the
      // substitution unable to answer for the one var whose binding decides
      // every field offset — and an INTERIOR site, a call inside another
      // twin's own body, read the decl's unlearned row again. A bound cell is
      // a link in a chain, so it answers as the record the chain spells.
      NRecordRowBound(_, _) => spec_subst_pairs(TRecordOpen([], u), pairs),
      NRowFree(_) => match spec_row_rest(graph_chase_handle(u), pairs) {
        Some(c) => c,
        None => TVar(u),
      },
    },
  },
  TList(e) => TList(spec_subst_pairs(e, pairs)),
  TTuple(es) => TTuple(map(spec_subst_pairs(??, pairs), es)),
  TFun(ps, r, eff) => TFun(
    map((p) => param_with_ty(p, spec_subst_pairs(param_ty(p), pairs)), ps),
    spec_subst_pairs(r, pairs),
    eff
  ),
  TName(n, args) => TName(n, map(spec_subst_pairs(??, pairs), args)),
  TRecord(fs) => TRecord(map({ (n, ft) => (n, spec_subst_pairs(ft, pairs)) }, fs)),
  // A row var is a var, and its pair is the RESIDUAL the site proved past
  // it. The row is read to its END first: a key sits on the chain's free
  // terminal, never on a link, so a receiver whose row learned fields
  // across several unifies answers as the one record every link spells —
  // the fields its chain learned, then the residual the site proved past
  // the terminal (lower.mn's spec_pairs_key_rest). Two types sharing one terminal
  // start their chains at different points (a receiver at its named
  // fields, its pattern's rest binder past them), and each spells its own
  // record from its own start. Unpaired, the row stays open at its
  // terminal; closed, it is the record.
  TRecordOpen(fs, v) => match record_row_full(fs, v) {
    (all, end) => {
      let learned = map({ (n, ft) => (n, spec_subst_pairs(ft, pairs)) }, all)
      match end {
        RowEndFree(t) => match spec_row_rest(t, pairs) {
          Some(residual) => match residual {
            TRecord(rfs) => TRecord(field_canonicalize(learned ++ rfs)),
            // only lower.mn's spec_pairs_key_rest pairs a row terminal, always as a closed record
            other @ (
              TInt
              | TFloat
              | TUnit
              | TByte
              | TAddr
              | TList(_)
              | TTuple(_)
              | TFun(_, _, _)
              | TVar(_)
              | TName(_, _)
              | TRecordOpen(_, _)
              | TRefined(_, _)
              | TReprPin(_, _)
              | TCont(_, _, _, _)
              | TAlias(_, _)
            ) => other,
          },
          None => mk_record_open(learned, t),
        },
        RowEndClosed => TRecord(field_canonicalize(learned)),
      }
    },
  },
  TRefined(b, p) => TRefined(spec_subst_pairs(b, pairs), p),
  TAlias(n, i) => TAlias(n, spec_subst_pairs(i, pairs)),
  TCont(i, a, d, w) => TCont(spec_subst_pairs(i, pairs), spec_subst_pairs(a, pairs), d, w),
  TInt | TFloat | TUnit | TByte | TAddr | TReprPin(_, _) => t,
}

// lookup_ty_graph — GraphRead → LookupTy bridge (spec 05)
// The ONLY LookupTy handler in Phase 1. Declares GraphRead
// (inherited from the outer graph_handler). Free and error-hole handles
// resume TVar(h) — the honest word floor every consumer reads; a width a
// site genuinely needs detonates at emit's loud floors, never here.
//
// The handler additionally carries the SPECIALIZATION state (spec_pairs): a
// named-generic twin's emission brackets itself with spec_ctx_set/clear, and
// while set, a free var answers through the site's EXACT instantiation pairs
// (spec_subst_pairs above — root-keyed; a free var whose root is not in
// the pairs stays the honest floor TVar). State-swap, NOT handler-swap:
// a second LookupTy handler would demote every lookup_ty perform out of the
// singleton direct-dispatch tier — measured as ev-scan faults at infer sites
// that never threaded evidence (they never needed to under the singleton).
handler lookup_ty_graph with spec_pairs = [], spec_enc = "" {
  spec_ctx_set(prs, e) => resume() with spec_pairs = prs, spec_enc = e,
  spec_ctx_clear() => resume() with spec_pairs = [], spec_enc = "",
  spec_enc_active() => resume(spec_enc),
  spec_pairs_active() => resume(spec_pairs),
  lookup_ty(h) => match graph_chase(h) {
    GNode(kind, reason) => if len(spec_pairs) > 0 {
      match kind {
        NBound(t) => resume(spec_subst_pairs(t, spec_pairs)),
        NFree(_) => resume(spec_pair_or_var(h, spec_pairs)),
        NErrorHole(_) => resume(spec_pair_or_var(h, spec_pairs)),
        NRowBound(_) => resume(TUnit),
        NRecordRowBound(_, _) => resume(TUnit),
        // A free RECORD row the site paired answers with the residual the site
        // proved past it, as a type variable answers its pair — its reader
        // spells the chain's learned fields before it; an effect row is never
        // in the pair space and keeps the unit it always read. Answering unit
        // for the paired row too left every open record a twin had closed
        // still open to lower.mn's spec_resolve, which reads a row's end through this op.
        NRowFree(_) => resume(match spec_row_rest(graph_chase_handle(h), spec_pairs) {
          Some(c) => c,
          None => TUnit,
        }),
      }
    } else {
      match kind {
        NBound(t) => resume(t),
        // An error hole / free var resumes TVar(h) — CARRY THE HANDLE. The
        // prior TName("ERROR_HOLE")/TName("UNRESOLVED") sentinels fabricated
        // a NOMINAL type for a node the graph proves is unresolved: every
        // downstream type-directed read then trusted the lie — the eq
        // dispatch minted a structural-sum helper $eq_nUNRESOLVED that read
        // a raw Int operand as a variant pointer (memory at address 44100 as
        // a tag word). TVar(h) is the truth: repr_of reads the word floor,
        // fold_sig reads "i", eq reads word identity — the honest
        // productive-under-error floor at every consumer, no second sentinel
        // channel. (A quantified var's == at a GENERIC body is word identity
        // by the same floor; the type-directed eq for a generic operand at
        // its instantiated width is the evidence-passing band —
        // Hβ.emit.generic-boundary-repr-coercion.)
        NErrorHole(_) => resume(TVar(h)),
        // A free var read at lower is NOT an error — it is a legal quantified
        // parameter of a reachable generic declaration (generalize's Forall is
        // the graph's own proof; `fn ident(x) = x` called from main carries
        // one), and repr_of floors it to the honest word by design. The per-read
        // report here re-derived "free = error" against that proof — 182
        // false diagnostics on a clean runtime-lib compile, the whole
        // frontier-gate debt class. A GENUINELY stuck width still detonates
        // at emit's loud comment-marked floors (field-offset-unprovable, the
        // ft mismatch), at the site that actually needs the width — the
        // consumer owns the refusal, never the read.
        NFree(_) => resume(TVar(h)),
        NRowBound(_) => resume(TUnit),
        NRecordRowBound(_, _) => resume(TUnit),
        NRowFree(_) => resume(TUnit),
      }
    },
  },
}
