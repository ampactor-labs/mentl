// own.mn — ownership as effect (spec 07)
//
// Ownership dissolves into the existing effect algebra. Every use of
// an own-annotated parameter performs Consume. The affine_ledger
// handler tracks which bindings have been consumed; a double-consume
// is E_OwnershipViolation. A ref-annotated value cannot escape return position —
// checked structurally on the body.
//
// Explicit own is enforced by the Consume handler during inference. Unmarked
// params are resolved after the body walk by the structural use-count pass, then
// written back into the function type for lower/query to read live.
import types

import strings

// affine_ledger — the Consume handler. Installed per-function body.
// State tracks consumed-names and the first-use span (for diagnostic
// pinpointing). `with !Consume` on the handler would statically
// prevent the arms from recursing through consume — the Boolean
// algebra gate.
//
// State:
//   used          — flat sorted set of consumed names (O(log N) membership)
//   used_sites    — insertion-ordered [(name, span)] for first-use diagnosis
//   branches      — stack of (base, deltas) frames for >< and <| branching.
//                   Each frame saves `used` at branch_enter; tracks each
//                   branch's captured delta; branch_exit pairwise-checks
//                   and merges. Stack shape naturally supports nested
//                   branches (e.g. (a >< b) >< c).
handler catch_abort {
  abort() => None,
}

handler affine_ledger with used = [], used_sites = [], branches = [], fn_saved = [], borrow_depth = 0, declared = [] {
  borrow_enter() => // A borrow scope reads without moving — inside it consume is a no-op, so
  // an `own` value used in an `if` condition / `match` scrutinee stays
  // available in the arms. A depth counter, not a flag: nested borrows
  // (a field access inside a condition) each add one.
  resume() with borrow_depth = borrow_depth + 1,
  borrow_exit() => resume() with borrow_depth = borrow_depth - 1,
  consume_enter_fn() => // A function body opens a fresh consume scope; its close restores the
  // parent's. The whole (used, used_sites, branches) triple is saved so a
  // nested fn decl inferred mid-branch cannot leak its consumes outward —
  // the enclosing frame comes back exactly as it was. Push/pop at the END
  // (§9 stack discipline): bounded by lexical fn-nesting depth, not a data
  // loop.
  //
  // drift-audit: ignore — bounded by lexical fn-nesting depth, not a data loop
  resume() with fn_saved = fn_saved ++ [(used, used_sites, branches, declared)], used = [], used_sites = [], branches = [], declared = [],
  consume_declare(name, span) => // The relevant tier's one write: an authored `own` binding entering
  // scope. The frame's own list — saved and restored with the rest of
  // the triple, so a nested fn decl's owns never leak outward.
  //
  // drift-audit: ignore — bounded by a fn's own authored-own params, not a data loop
  resume() with declared = declared ++ [(name, span)],
  consume_exit_fn() => {
    // EXACTLY-ONCE, reported before the frame closes: every authored
    // `own` this body declared and never consumed. Affine says "not
    // twice"; this says "not never" — the finalization half, and the
    // reason a persisted continuation can lose a close obligation
    // today (Hβ.own.linear-tier-and-persist-value-barrier).
    report_unconsumed(declared, used, 0)
    if len(fn_saved) == 0 {
      resume()
    } else {
      match last(fn_saved) {
        (u, us, br, dc) => resume() with used = u, used_sites = us, branches = br, declared = dc, fn_saved = drop_last(fn_saved),
      }
    }
  },
  consume(name, ownership, span) => // The message mint is a named fn with a String pin (spec_mangle's
  // law): the arm's name binder judged free despite the op scheme's
  // declared String — the arm-binder-inherits-op-param gap, named
  // Hβ.infer.arm-binder-op-param-type — and the word floor rendered
  // the consumed name as a pointer numeral. The named call anchors it.
  match ownership {
    Own => // A name the ledger already moved admits NO further use. The used-set
    // read comes FIRST: a consuming second use is the affine violation
    // (armed), and a borrow-read of a moved name is use-after-move —
    // narration until the wheel's census reaches 0 (the arming law). The
    // old borrow-first order resumed silently on every read of a moved
    // value, sound only because the heap never frees — the
    // accident-invariant §5.O layer 3's arena deletes. A borrow BEFORE
    // any move stays a recordless read.
    if set_contains(used, name) {
      let first = find_first_span(used_sites, name)
      if borrow_depth > 0 {
        report(TUseAfterMove(read_after_move_msg(name, first), span))
      } else {
        report(EOwnershipViolation(consume_twice_msg(name, first), span))
      }
      resume()
    } else if borrow_depth > 0 {
      // Inside a borrow scope the value is READ, not moved — record nothing.
      resume()
    } else {
      // `used` maintains sort invariant via set_insert — every read
      // (set_contains above) is O(log N) without boundary normalization.
      // `used_sites` keeps insertion order so find_first_span returns
      // the actual first-use span (sorting it would lose temporal order).
      resume() with used = set_insert(used, name), used_sites = [(name, span)] ++ used_sites
    },
    _ => resume(),
  },
  branch_enter(mode) => // branch_enter — snapshot the current `used` as the frame's base;
  // deltas list starts empty; the mode rides the frame so branch_exit
  // knows whether the arms run in parallel (collision) or as
  // alternatives (union). Nested branches push onto the stack — at the
  // END, like every Mentl stack (§9's wrong-end class: the old prepend
  // met last/drop_last readers, so ONE frame worked while a NESTED
  // alternative's divider and exit operated on the ENCLOSING frame —
  // the measured break the hoist workarounds were passing around,
  // Hβ.infer.nested-alternative-branch-bracketing's true root).
  {
    // drift-audit: ignore — bounded by lexical branch-nesting depth, not a data loop
    resume() with branches = branches ++ [(used, [], mode)]
  },
  branch_divider(_span) => // branch_divider — called between branches of `><` or between
  // non-last branches of `<|`. Captures the just-finished branch's
  // delta (names consumed in this branch, i.e. used \ base), appends
  // to the frame's deltas list, then resets `used` to base so the
  // next branch sees the original scope.
  {
    if len(branches) == 0 {
      resume()
    } else {
      match last(branches) {
        (base, deltas, mode) => {
          let delta = set_diff(used, base)
          // drift-audit: ignore — bounded by lexical branch-nesting depth, not a data loop
          resume() with used = base, branches = drop_last(branches) ++ [(base, [delta] ++ deltas, mode)]
        },
      }
    }
  },
  branch_exit(span) => // branch_exit — captures the last branch's delta, pairwise-checks
  // collisions against already-captured deltas (each collision is an
  // E_OwnershipViolation at the branch site), merges all deltas into
  // `used` as base ∪ union(deltas), pops the frame.
  {
    if len(branches) == 0 {
      resume()
    } else {
      match last(branches) {
        (base, prior_deltas, mode) => {
          let last_delta = set_diff(used, base)
          let all_deltas = [last_delta] ++ prior_deltas
          // Parallel arms both run, so a name in two deltas is consumed
          // twice at runtime — a violation. Alternative arms run exactly
          // one, so a name across deltas is one consume on the taken path:
          // union it in, never a collision.
          match mode {
            BParallel => report_branch_collisions(all_deltas, span),
            BAlternative => (),
          }
          resume() with used = set_union(base, union_all_deltas(all_deltas)), branches = drop_last(branches)
        },
      }
    }
  },
  consume_seed(names) => // The branch-cursor triple (the fan, C1c-2 — the op decl carries the
  // protocol). seed replaces the consumed-set whole: the branch's fresh
  // instance adopts the root's frozen view, its sites list stays empty
  // so the log is exactly the branch's own first-consumes.
  resume() with used = names,
  consume_base() => resume(used),
  consume_log() => resume(used_sites),
  consume_declared() => // The persist value barrier's read: this frame's authored-own names,
  // whole. A frame-declared own FREE in a replay-boundary thunk is
  // re-consumed per resumed run (the affine law on the TIME axis); the
  // call-edge gate intersects this projection with the thunk's free
  // names and says so at the capture site. Never declared-minus-used:
  // the capture IS the consume, so a subtraction blinds the gate.
  resume(declared_own_names(declared)),
}

// The declared-own projection: names only (the gate reports at the
// CAPTURE site's span; the name carries the teaching).
fn declared_own_names(ref declared) with Memory + Alloc = map(
  (entry) => match entry {
    (name, _) => name,
  },
  declared
)

// The double-consume message's one mint, String-pinned (the comment at
// the consume arm carries the why).
fn consume_twice_msg(name: String, first) with GraphRead + Memory + Alloc =
  "'{name}' consumed twice (first at {show_span(first)})"

// The read-after-move message's mint, String-pinned like its sibling.
fn read_after_move_msg(name: String, first) with GraphRead + Memory + Alloc =
  "'{name}' read after move (moved at {show_span(first)}) — the value this name owned has been consumed"

// THE RELEVANT TIER'S REPORT — every authored `own` the body declared
// and never consumed. Narration first per the census arming law (a
// class arms only at wheel-zero); the wheel's own unconsumed owns are
// findings, not failures, until the count is 0. The message states the
// obligation rather than the rule: what the developer promised to
// finish, and did not.
fn report_unconsumed(ref declared, ref used, i) with Diagnostic + GraphRead + Memory + Alloc + Intern = if i >= len(declared) {
  ()
} else {
  match declared[i] {
    (name, span) => if set_contains(used, name) { () } else { report(TOwnUnconsumed(unconsumed_msg(name), span)) },
  }
  report_unconsumed(declared, used, i + 1)
}

// The message's one mint, String-pinned like its double-consume sibling.
fn unconsumed_msg(name: String) with Memory + Alloc =
  "'{name}' is declared own but never consumed on this path — an owned resource with no finalization"

// Flat-array union across all branch deltas. Every delta is already
// a sorted set (maintained by set_insert during consume), so folding
// set_union across them preserves the invariant.
fn union_all_deltas(ref deltas) with !Mutate =
  fold([], set_union, deltas)

// Pairwise collision check across branch deltas. For each pair of
// branch deltas (i < j), any name in their intersection was
// consumed in TWO parallel branches — an affine violation. We report
// each colliding name once per pair; a name consumed in three
// branches surfaces as (1,2), (1,3), (2,3) triples, each naming the
// branch pair in its own diagnostic. Span is the branching verb's
// span — the site where the violation becomes observable.
fn report_branch_collisions(ref deltas, ref span) with Memory + Alloc + Intern + GraphRead + Diagnostic = {
  let n = len(deltas)
  each(
    (i) => each(
      (j) => {
        let collisions = set_intersect(list_index(deltas, i), list_index(deltas, j))
        report_each_collision(collisions, span)
      },
      range(i + 1, n)
    ),
    range(0, n)
  )
}

// Tofte-Talpin region escape tracker (I12). Installed per-function
// body alongside `affine_ledger`. Arms react to Alloc/return
// surfaces to track region identity on each value:
//
// - `region_enter` — fresh region id + span, pushed onto stack.
// - `region_exit` — pops the stack; values tagged with this region
//   are checked against the ambient live region on escape.
// - `check_escape` — compares the value's tagged region against the
//   stack; mismatches emit `E_RegionEscape` pointing at both alloc
//   site and escape site.
//
// The arms are wired to the Alloc effect surface; `tag_alloc` stamps
// every allocation with the current-top region id. `tag_alloc_join`
// takes the deepest (innermost) region across a composite value's
// fields — preventing inner-region pointers from escaping via the
// composite.
// The bucket count is a CONFIG PARAMETER because the two installs index
// different amounts of work: the root chain indexes a whole program's
// handles, a judged branch indexes one statement's. It was one fixed 65536
// for both, and the branch paid the root's sizing on every install — see
// region_index_new for the measurement.
handler region_tracker with region_stack = [], next_region = 0, region_index = region_index_new(65536) {
  region_enter(span) => {
    // Push at the END — every Mentl stack does (§9's wrong-end class: the
    // old front-push met last/drop_last readers, an enter-front/pop-bottom
    // queue that dormancy never caught). Region ids start at 1: 0 is the
    // no-region/global sentinel every tag test reads, and the first live
    // region must never collide with it. Bounded by fn-nesting depth.
    let rid = next_region + 1
    // drift-audit: ignore — bounded by lexical fn-nesting depth, not a data loop
    resume(rid) with region_stack = region_stack ++ [Region(rid, span)], next_region = rid
  },
  region_exit(_rid) => if len(region_stack) == 0 { resume() } else { resume() with region_stack = drop_last(region_stack) },
  tag_alloc(value_handle) => {
    // Stamp the value with the current-top region (or 0 = no
    // region active = global lifetime). A tag is the TUPLE
    // (install_span, region_id) — destructured positionally by its
    // readers, because the bucket scan's return is type-erased and a
    // nominal field read there silently resolved to OFFSET 0 (the old
    // record's handle field posed as the region id, so every
    // bare-literal-bodied fn flagged its own body handle as a dead
    // region — the six false E_RegionEscape). Positional destructure
    // is provable with no type flow — the render_audit precedent. The
    // old handle field duplicated the bucket key and had zero readers.
    let rid = if len(region_stack) == 0 {
      0
    } else {
      match last(region_stack) {
        Region(r, _) => r,
      }
    }
    let install_span = if len(region_stack) == 0 {
      span_zero()
    } else {
      match last(region_stack) {
        Region(_, s) => s,
      }
    }
    resume() with region_index = region_index_add(region_index, value_handle, (install_span, rid))
  },
  tag_alloc_join(value_handle, field_handles) => {
    // H4.1: composite values (record / variant with fields) take
    // the DEEPEST (innermost = largest region_id) region across
    // (current_region, every field's region). A field tagged with
    // an inner region pins the composite to that inner lifetime —
    // escaping the composite to outer scope would orphan the
    // inner-region pointer field. The escape check at fn return
    // uses this max-region tag.
    let cur_rid = if len(region_stack) == 0 {
      0
    } else {
      match last(region_stack) {
        Region(r, _) => r,
      }
    }
    let install_span = if len(region_stack) == 0 {
      span_zero()
    } else {
      match last(region_stack) {
        Region(_, s) => s,
      }
    }
    let joined = join_field_regions(region_index, field_handles, cur_rid)
    resume() with region_index = region_index_add(region_index, value_handle, (install_span, joined))
  },
  check_escape(value_handle, escape_span) => {
    // The fn-return read, three verdicts (regions are LIVE — infer_fn
    // brackets every fn body in its own region, §5.O layer 3):
    //   OWN region  → THE RETURN TRANSFER (Hβ.own.region-return-transfer,
    //     the result-region-as-parameter form): the value leaves through
    //     the return, so it re-tags into the PARENT region — the caller
    //     owns it now. This is what makes the region drop safe as the
    //     layer-3 arena reset: everything still tagged with the dying
    //     region is provably transient.
    //   OUTER live region / region 0 → already outlives this return.
    //   DEAD region → the escape, reported with BOTH spans (where the
    //     region opened, where the value tried to leave).
    let entry = lookup_tag(region_index, value_handle)
    match entry {
      None => resume(),
      Some(tag) => match tag {
        (install_span, region_id) => {
          let depth = len(region_stack)
          let top_rid = if depth == 0 {
            0
          } else {
            match last(region_stack) {
              Region(r, _) => r,
            }
          }
          if region_id == 0 {
            resume()
          } else if region_id == top_rid {
            let parent = if depth < 2 {
              0
            } else {
              match list_index(region_stack, depth - 2) {
                Region(p, _) => p,
              }
            }
            resume() with region_index = region_index_add(region_index, value_handle, (install_span, parent))
          } else if region_on_stack(region_stack, region_id) {
            resume()
          } else {
            // drift-audit: ignore
            report(ERegionEscape(
              "value allocated in a region (opened at {show_span(install_span)}) that ended before this return — region {int_to_str(region_id)} no longer live",
              escape_span
            ))
            resume()
          }
        },
      },
    }
  },
}

// O(1) region lookup — the region ledger is a handle-indexed hash bucket
// (region_index), not a cons-list re-scanned per alloc. check_escape /
// join_field_regions' linear find over it was ~93% of the post-classifier
// self-compile (perf, 2026-07-13; the O(N²) alloc-check scan, §5.O). The handle
// is a dense Int, so i32.eq buckets — no str_eq. Returns Some(tag) / None, exactly
// as find did.
fn lookup_tag(ref idx, handle) with Memory + Alloc = region_index_get(idx, handle)

// The bucket count is the INDEX'S OWN, read live from its header.
//
// It used to be the literal 65536 here and the literal 65535 in both
// accessors' masks — one fact written three times, and the reason that
// mattered is cost, not tidiness: a fixed 65536-slot fill is paid by EVERY
// install of region_tracker, and branch_bracket installs it once per judged
// branch. `fn main() = 7` judges 433 branches, so it filled 28 million slots
// to hold a few dozen entries — `list_filled_from` measured 25.91% SELF and
// its caller branch_bracket 55.95% inclusive (Hβ.own.region-index-per-install).
// `len` is `load_i32`, so the mask costs nothing to read from the list that
// already knows it, and the count becomes a parameter with no second copy to
// keep in sync. A caller sizes the index to the work it actually indexes.
// The two sizings, named where the index is. Both must be powers of two —
// region_bucket masks with len(idx) - 1.
//
// PROGRAM indexes a whole program's handles: the root chain and the trial's
// own world, which both judge everything. BRANCH indexes ONE statement's,
// and a statement mints its own handles plus the overflow quota, so a few
// hundred buckets leave the chains short while costing 64× less to build.
let region_buckets_program = 65536

let region_buckets_branch = 1024

fn region_index_new(n) with Memory + Alloc = list_filled(n, [])

fn region_bucket(idx, handle) with Memory = i32_and(handle, len(idx) - 1)

fn region_index_add(idx, handle, tag) with Memory + Alloc = {
  let b = region_bucket(idx, handle)
  list_set(idx, b, [(handle, tag)] ++ list_index(idx, b))
}

fn region_index_get(ref idx, handle) with Memory + Alloc = {
  let b = region_bucket(idx, handle)
  region_bucket_scan(list_index(idx, b), handle, 0)
}

fn region_bucket_scan(ref bucket, handle, i) with Memory + Alloc = if i >= len(bucket) {
  None
} else {
  match list_index(bucket, i) {
    (h, tag) => if h == handle { Some(tag) } else { region_bucket_scan(bucket, handle, i + 1) },
  }
}

fn region_on_stack(ref stack, rid) with Memory + Alloc = any(
  (r) => match r {
    Region(rid_on_stack, _) => rid_on_stack == rid,
  },
  stack
)

// H4.1: join field regions with current region — returns the MAX
// (innermost) region_id. Untagged fields (scalars, never alloc'd)
// contribute region 0 (global lifetime, doesn't bound the join).
// The result is the composite's pinning region.
fn join_field_regions(ref tags, ref fields, current) with Memory + Alloc = fold(
  current,
  (acc, fh) => {
    let field_rid = match lookup_tag(tags, fh) {
      None => 0,
      Some(t) => match t {
        (_, rid) => rid,
      },
    }
    if field_rid > acc { field_rid } else { acc }
  },
  fields
)

fn report_each_collision(ref names, ref span) with Diagnostic + Memory + Alloc + GraphRead + Intern =
  each((name) => report(EOwnershipViolation(parallel_collision_msg(name), span)), names)

// The collision message's one mint, String-pinned (spec_mangle's law —
// the each-lambda judges datum-last while the set element is still
// free, so the pin anchors at the named call, consume_twice_msg's twin).
fn parallel_collision_msg(name: String) with Memory + Alloc =
  "'{name}' consumed in two parallel branches"

fn find_first_span(ref sites, ref name: String) with Alloc + Memory = {
  let hits = filter(
    (entry) => match entry {
      (entry_name, _) => entry_name == name,
    },
    sites
  )
  if len(hits) == 0 {
    span_zero()
  } else {
    match head(hits) {
      (_, sp) => sp,
    }
  }
}

// W8.2 / Phase-A2: `used` now maintains sort invariant by
// construction (set_insert in consume), so set_contains runs at
// O(log N) without boundary canonicalize. The local string_in_list
// adapter is gone — call sites use set_contains directly.
//
// DELETED 2026-07-17 (Stage 1b): check_ref_escape / collect_ref_params /
// walk_return_positions / walk_match_arms — a purely SYNTACTIC escape check with
// ZERO hazard model. It fired when a param inference had graded `Ref` (use-count
// >= 2) also appeared as a bare tail return, never asking whether a mutation or
// aliasing conflict was actually possible. So it flagged `min(a,b) = if a <= b
// { a } else { b }`, every fold-accumulator return, and `extract_chase` — 356 of
// the census, every sampled case provably safe to return from.
//
// It was a cruder, older stand-in for the hazard the region tracker now covers.
// check_escape (own.mn ~201) tracks allocation regions and reports a GENUINE
// escape — a value outliving the region it was allocated in — via the return
// TRANSFER (Hβ.own.region-return-transfer); it reports 0 on the wheel, because
// the wheel has no real lifetime violations. Two checks for one property, one
// modelling the hazard and one guessing from syntax; the guess is deleted. Its
// one caller existed and nothing downstream read its verdict
// (grep-verified at deletion). §4⑤'s bar — "if the developer has to think about it, the
// inference failed" — is met by removal: 356 false alarms on the medium's own
// source were exactly the developer being made to think.
//
// The named peer Hβ.infer.usage-grade-unifies-cardinality-ownership survives as
// a SEPARATE, real item: own.mn's count_uses sums disjoint branches additively
// (the anti-pattern types.mn:288 warns against) instead of sharing resume_grade's
// usage_seq/usage_join lattice. Worth doing as a Usage-lattice dedup, but NOT
// this deletion, and it would not have cleared the compare-then-return subclass.
//
// Deduce `Own` vs `Ref` for `Unmarked`-marked parameters from the body's
// (consume, read) Usage pair (§11 4.2, Hβ.infer.grade-is-join-and-mode —
// the Usage lattice unification the types.mn ADT comment names): never
// consumed and never read → `Unmarked`; never consumed but read → `Ref`;
// consumed exactly once on every path → `Own`; consumed more → `Ref`.
fn infer_ownership(ref params, ref body) with Memory + Alloc + EnvRead + GraphRead = map(
  (p) => {
    let inferred = match param_authored(p) {
      Unmarked => classify_usage(param_name(p), body),
      _ => param_authored(p),
    }
    // Only the resolved-ownership slot is written; type, name, authored
    // marker, and default travel unchanged BY CONSTRUCTION via the updater
    // (Carried-Truth — dropping the default would lose the param's `= expr`
    // fallback at every call site; param_with_resolved cannot drop it).
    param_with_resolved(p, inferred)
  },
  list_to_flat(params)
)

fn classify_usage(ref name, ref body) with Memory + Alloc + EnvRead + GraphRead = match usage_of(name, body, MConsume) {
  (consume, read) => match consume {
    UZero => match read {
      UZero => Unmarked,
      _ => Ref,
    },
    UOne => Own,
    UMany => Ref,
  },
}

// The walk's position mode: which component of the pair a mention feeds.
type UseMode = MConsume | MRead

fn use_leaf(mode) = match mode {
  MConsume => (UOne, UZero),
  MRead => (UZero, UOne),
}

fn pair_zero() = (UZero, UZero)

// Componentwise ⊗ (one path runs both) and ⊔ (exactly one alternative
// runs) over the (consume, read) pair — the lattice ops live in types.mn
// beside the Usage ADT (one home; infer.mn's resume classifier folds the
// same two).
fn pair_seq(a, b) = match a {
  (ac, ar) => match b {
    (bc, br) => (usage_seq(ac, bc), usage_seq(ar, br)),
  },
}

fn pair_join(a, b) = match a {
  (ac, ar) => match b {
    (bc, br) => (usage_join(ac, bc), usage_join(ar, br)),
  },
}

// usage_of — ONE walk of the body per param name, mode threading down.
// Positional resets: an if-condition and a match scrutinee are READ to
// pick the path; a call's args take the CALLEE's own param product's mode
// (param_borrows — the same one test the arg walk's borrow bracket reads
// one phase later); the callee position and every seq-op-shaped access
// (index receiver, field base, record-update base) are reads. resume_grade
// (infer.mn) is this walk's sibling over the same lattice — they stay two
// walks because resume carries call-substitution this walk must not, and
// this walk carries mode resume must not (the stamped two-walks ruling).
fn usage_of(ref name: String, ref node, mode) with Memory + Alloc + EnvRead + GraphRead = match node {
  N(body, _, _) => match body {
    NExpr(VarRef(n)) => if n == name { use_leaf(mode) } else { pair_zero() },
    NExpr(CallExpr(f, args)) => pair_seq(usage_of(name, f, MRead), usage_args(name, args, callee_borrow_params(f), 0)),
    NExpr(BinOpExpr(_, l, r)) => pair_seq(usage_of(name, l, mode), usage_of(name, r, mode)),
    NExpr(UnaryOpExpr(_, inner)) => usage_of(name, inner, mode),
    NExpr(IfExpr(c, t, e)) => // The condition is read to PICK the branch (⊗ before), and exactly
    // one branch runs (⊔ across) — the two laws the additive sum broke.
    pair_seq(usage_of(name, c, MRead), pair_join(usage_of(name, t, mode), usage_of(name, e, mode))),
    NExpr(BlockExpr(stmts, final_e)) => pair_seq(usage_elems(name, stmts, mode), usage_of(name, final_e, mode)),
    NExpr(LambdaExpr(_, lb)) => // A closure runs 0..N times: a consume inside widens to UMany (the
    // borrow-safe Ref direction); reads stay reads. The body opens in
    // consume mode — its own positions re-derive from there.
    match usage_of(name, lb, MConsume) {
      (c, r) => match c {
        UZero => (UZero, r),
        _ => (UMany, r),
      },
    },
    NExpr(PipeExpr(_, l, r)) => // The datum's true slot mode is the completed call's own param; the
    // enclosing mode threads both sides (the ledger's borrow bracket at
    // the completed call is the runtime truth, and a divergence here
    // surfaces as a T_UseAfterMove hit the zero ratchet arbitrates).
    pair_seq(usage_of(name, l, mode), usage_of(name, r, mode)),
    NExpr(FanoutExpr(branches)) => // Parallel branches ALL run — ⊗, exactly the ledger's BParallel
    // collision semantics (consumed in two branches is consumed twice).
    usage_elems(name, branches, mode),
    NExpr(RestExpr(_)) => pair_zero(),
    NExpr(MatchExpr(s, arms)) => pair_seq(usage_of(name, s, MRead), usage_arms(name, arms, mode)),
    NExpr(MakeListExpr(elems)) => usage_elems(name, elems, mode),
    NExpr(MakeTupleExpr(elems)) => usage_elems(name, elems, mode),
    NExpr(MakeStringExpr(fragments)) => usage_elems(name, fragments, mode),
    NExpr(ShowExpr(inner)) => usage_of(name, inner, mode),
    NExpr(IndexExpr(receiver, index)) => // xs[i] is the seq-op borrow: receiver and index are reads.
    pair_seq(usage_of(name, receiver, MRead), usage_of(name, index, MRead)),
    NExpr(MakeRecordExpr(flds)) => usage_flds(name, flds, mode),
    NExpr(RecordUpdateExpr(base, flds)) => // {...base, f: v} copies non-destructively — the base is READ.
    pair_seq(usage_of(name, base, MRead), usage_flds(name, flds, mode)),
    NExpr(NamedRecordExpr(_, flds)) => usage_flds(name, flds, mode),
    NExpr(FieldExpr(rec, _)) => // A field access reads the record; what the enclosing mode consumes
    // is the value read OUT, never the record itself.
    usage_of(name, rec, MRead),
    NExpr(LitInt(_)) => pair_zero(),
    NExpr(LitFloat(_)) => pair_zero(),
    NExpr(LitString(_)) => pair_zero(),
    NExpr(LitBool(_)) => pair_zero(),
    NExpr(LitUnit) => pair_zero(),
    NExpr(ResumeExpr(v, _)) => usage_of(name, v, mode),
    NExpr(LabeledArg(_, v)) => usage_of(name, v, mode),
    NExpr(ExprPlaceholder) => pair_zero(),
    NStmt(LetStmt(_, v, _)) => // The binding's value embeds under the binder — a consume-shape use.
    // The deleted additive count's `NStmt(_) => 0` blanket missed EVERY
    // statement-level use; the walk descends.
    usage_of(name, v, MConsume),
    NStmt(ExprStmt(e)) => usage_of(name, e, mode),
    NStmt(FnStmt(_, _, _, _, _)) => // A nested fn declaration is not an execution (resume_grade's own
    // ruling); its capture-and-call usage stays uncounted — parity with
    // the deleted count, Ref-safe when it under-counts.
    pair_zero(),
    NStmt(TypeDefStmt(_, _)) => pair_zero(),
    NStmt(EffectDeclStmt(_, _, _)) => pair_zero(),
    NStmt(HandlerDeclStmt(_, _, _, _, _)) => pair_zero(),
    NStmt(ImportStmt(_)) => pair_zero(),
    NStmt(RefineStmt(_, _, _)) => pair_zero(),
    NStmt(AliasStmt(_, _)) => pair_zero(),
    NStmt(RowAliasStmt(_, _)) => pair_zero(),
    NPat(_) => pair_zero(),
    NHole(_) => pair_zero(),
    NModule(_) => pair_zero(),
    NTypeAnn(_) => pair_zero(),
  },
}

// ⊗ over a node list (block stmts, list/tuple/string elems, parallel
// branches): all evaluate on one path. last/drop_last are the O(1)
// snoc-end reads and both pair ops are order-insensitive — the exact
// shape of resume_grade's grade_nodes (a named walk, not a fold lambda:
// usage_of performs EnvRead, and an effectful lambda is the anonymity
// tier's own conviction).
fn usage_elems(ref name, ref nodes, mode) with Memory + Alloc + EnvRead + GraphRead = if len(nodes) == 0 {
  pair_zero()
} else {
  pair_seq(usage_of(name, last(nodes), mode), usage_elems(name, drop_last(nodes), mode))
}

// ⊔ over match arms ((pat, body) tuples): exactly one arm runs.
fn usage_arms(ref name, ref arms, mode) with Memory + Alloc + EnvRead + GraphRead = if len(arms) == 0 {
  pair_zero()
} else {
  match last(arms) {
    (_, b) => pair_join(usage_of(name, b, mode), usage_arms(name, drop_last(arms), mode)),
  }
}

// ⊗ over record fields ((name, value) tuples).
fn usage_flds(ref name, ref flds, mode) with Memory + Alloc + EnvRead + GraphRead = if len(flds) == 0 {
  pair_zero()
} else {
  match last(flds) {
    (_, v) => pair_seq(usage_of(name, v, mode), usage_flds(name, drop_last(flds), mode)),
  }
}

// The callee's param product, when readable: a VarRef callee resolved in
// env to an arrow scheme. None (a lambda/expr callee, an env miss, a
// non-arrow) mirrors the arg walk's callee-miss borrow guard: every bare
// arg reads.
//
// The read goes THROUGH the posture, and that is load-bearing rather than
// tidy. A frozen entry is a snapshot taken when the callee finished; a live
// one is the callee's own cell, and the shallow chase to its bound node is
// the layer's live read (own.mn sits below infer, so judgment_ty — which
// would also run the quantifier split this reader has no use for — is not
// in scope). Reading only the frozen shape here is what the trial/final
// divergence is MADE of: when the entry is not yet an arrow the answer is
// None, every bare arg reads, the grade lands `r`, and the final's
// re-judgment lands `o` — the whole printed flip set
// (`buffer:rlf → buffer:olf`, `list:ri → list:oi`).
fn callee_borrow_params(ref f) with !Mutate + GraphRead + EnvRead + Memory + Alloc = match f {
  N(fb, _, _) => match fb {
    NExpr(VarRef(cn)) => match env_lookup(cn) {
      Some(entry) => match entry {
        (scheme, _, _) => match scheme {
          Frozen(_, TFun(ps, _, _)) => Some(ps),
          Frozen(_, TVar(h)) => chased_borrow_params(h),
          Live(h) => chased_borrow_params(h),
          _ => None,
        },
      },
      None => None,
    },
    _ => None,
  },
}

// A cell's arrow, one hop: the params when the bound node is a function,
// None when it is anything else. Shared by the live posture and the frozen
// TVar, which are the same read taken at two moments.
fn chased_borrow_params(h) with GraphRead + Memory + Alloc = match graph_chase(h) {
  GNode(NBound(TFun(ps, _, _)), _) => Some(ps),
  _ => None,
}

// Per-arg walk with the callee's slot modes. An index walk because the
// slot pairing is positional (infer_call_arg_list's own idiom); a labeled
// arg resolves its param by NAME, exactly as resolve_call_args does one
// phase earlier.
fn usage_args(ref name, ref args, borrow_slots, i) with Memory + Alloc + EnvRead + GraphRead = if i >= len(args) {
  pair_zero()
} else {
  let arg = list_index(args, i)
  pair_seq(
    usage_of(name, arg, arg_slot_mode(arg, borrow_slots, i)),
    usage_args(name, args, borrow_slots, i + 1)
  )
}

// The mode of one arg slot: only a bare mention (VarRef, or a labeled
// VarRef) takes the callee param's borrow test — a compound arg opens in
// consume mode and its inner positions re-derive (the borrow bracket's
// own VarRef-only rule). Beyond-product args consume (the arg walk's
// plain infer_expr fall-through).
fn arg_slot_mode(ref arg, ref borrow_slots, i) = match arg {
  N(ab, _, _) => match ab {
    NExpr(VarRef(_)) => match borrow_slots {
      Some(ps) => if i < len(ps) { if param_borrows(list_index(ps, i)) { MRead } else { MConsume } } else { MConsume },
      None => MRead,
    },
    NExpr(LabeledArg(label, v)) => match v {
      N(vb, _, _) => match vb {
        NExpr(VarRef(_)) => match borrow_slots {
          Some(ps) => if labeled_param_borrows(ps, label, 0) { MRead } else { MConsume },
          None => MRead,
        },
        _ => MConsume,
      },
    },
    _ => MConsume,
  },
}

fn labeled_param_borrows(ref ps, ref label: String, i) = if i >= len(ps) {
  false
} else {
  let p = list_index(ps, i)
  if param_name(p) == label { param_borrows(p) } else { labeled_param_borrows(ps, label, i + 1) }
}
