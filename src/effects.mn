// effects.mn — Boolean algebra over effect rows (spec 01)
//
// The algebra. Pure functions on data. No handlers, no state, no
// effects. The proof engine that every compilation gate (`Pure`,
// `!IO`, `!Alloc`, `!Network`) and every handler install reduces to.
//
// types.mn owns the EffRow ADT and display; this file owns the
// algebra — normalize / union / diff / inter / neg / subsumes / unify
// / absorb / ground. One mechanism; four gates fall out.
//
// Research: Flix Boolean unification (OOPSLA 2024), Tang-Lindley
// Modal Effect Types (POPL 2025 / 2026), Abstracting Effect Systems
// (ICFP 2024). Decidable, sound, documented. None invented here.
// The artifact is that one row_subsumes call services every gate.
import types

import strings

// Smart constructors — sort invariant by construction
// Every row value in the system passes through these
// constructors. They canonicalize their input at the boundary so
// downstream consumers (set_union, set_diff, set_contains, equality
// checks) can assume sorted-flat input and run at substrate speed.
// Permanent overhead-at-call drops to a single set_canonicalize per
// construction; consumers can then drop their boundary canonicalize
// adapters entirely.
//
// DESIGN Ch 4 substrate discipline: the row IS the sorted set. The
// graph stores rows in the form they were constructed; constructors
// enforce the invariant the algebra depends on.
//
// ─── the canonical triple's constructors ────────────────────────────
// row = present ∪ (tail ∖ absent). Invariants enforced HERE, once, so
// every flowing row is canonical at birth and no read ever normalizes:
// present and absent each deduped. present ∩ absent is COHERENT under
// the reading law — present ADDS a name now, absent FILTERS it from the
// tail; both at once means "performs it here, and the tail's copy is
// subtracted" (exactly what a caller's teaching join into a `~>` mask
// cell produces). The former `absent ∖= present` canonicalization
// conflated the AUTHORED contradiction (`with A + !A`, a decl-site
// meet — build_declared_row's business) with a representation
// invariant, and every join/fold that unioned a present into a masked
// row silently DELETED the mask — the pending `~>` subtraction dying at
// the collision, GraphRead/Intern surviving every bracket into the
// wheel's own root row (the mask-inversion class, third face).
//
// The absent set survives EVERY tail form: under EtClosed it is vacuous
// for the row's READING (no tail to mask) but load-bearing as the
// crown's PROOF-OF-ABSENCE record — `with A + !B` gates carry B here,
// and subsumption checks a body's presents against it transitively.
fn ef_make(ref present, ref absent, tail) with !Mutate =
  EfRow(name_set_canonicalize(present), name_set_canonicalize(absent), tail_canonical(tail))

// EtOpen([]) IS EtClosed — a union of zero edges contributes nothing
// beyond the present set, so the empty open form never survives its
// constructor; readers meet a canonical tail (their own empty-set arms
// are the belt, per display-totality). SORTEDNESS is the WRITERS'
// invariant, not a per-construction tax: mints are singletons
// (trivially sorted), the union and the fold accumulators insert in
// order (tail_set_insert), so ef_make never re-sorts — structural ==
// over two canonical sets is set equality by construction.
fn tail_canonical(tail) = match tail {
  EtOpen(vs) => if len(vs) == 0 { EtClosed } else { EtOpen(vs) },
  EtClosed => EtClosed,
  EtAll => EtAll,
}

// ─── the edge set — §4①'s sorted-handle-set at the tail ─────────────
// Ascending, deduped; sets are small (a frame accumulates a handful of
// open callees). STRUCTURAL RECURSION, deliberately not the fold/filter
// vocabulary: the row algebra is MECHANISM (graph.mn's chase discipline)
// and runs inside unify inside every judgment — the vocabulary form put
// the resolver ON the Iterate handler machinery, and its first real
// multi-edge walk floored the k2 yield boundary from inside a fold's
// own yield arm (measured at m3's first trial unify, 2026-08-01: a
// row-polymorphic call inside a yield arm's dynamic extent reads the
// in-flight flag). The [Int] pins are the ++ floor's Intent Boundaries.
fn tail_set_insert(ref vs: [Int], v: Int) with Memory + Alloc = match vs {
  [] => [v],
  [h, ...rest] => if v < h { [v] ++ vs } else if v == h { vs } else { [h] ++ tail_set_insert(rest, v) },
}

fn tail_set_union(ref vs: [Int], ref ws: [Int]) with Memory + Alloc = match ws {
  [] => vs,
  [h, ...rest] => tail_set_union(tail_set_insert(vs, h), rest),
}

fn tail_set_has(ref vs: [Int], v: Int) with Pure = match vs {
  [] => false,
  [h, ...rest] => if h == v { true } else { tail_set_has(rest, v) },
}

fn tail_set_diff(ref vs: [Int], ref ws: [Int]) with Memory + Alloc = match vs {
  [] => [],
  [h, ...rest] => if tail_set_has(ws, h) { tail_set_diff(rest, ws) } else { [h] ++ tail_set_diff(rest, ws) },
}

fn absent_minus_present(ref a, ref p) with !Mutate =
  filter((entry) => !any((pe) => absent_contradicted_by(entry, pe), p), a)

// The meet's teaching half: each absent entry a present entry contradicts
// is REPORTED at the decl (the same pair law the subtraction filters by),
// so the fold never resolves an authored contradiction silently. Named
// recursion, not an each-lambda — the report row wants its decl home.
fn report_row_contradictions(absent, present) = match absent {
  [] => (),
  [entry, ...rest] => {
    if any((pe) => absent_contradicted_by(entry, pe), present) {
      report(EDeclaredRowContradiction(eff_name_str(entry), span_zero()))
    } else {
      ()
    }
    report_row_contradictions(rest, present)
  },
}

// The SUBTRACTION's pair law — when does a present entry contradict an
// absent one (dropping it from the declared meet)? Distinct from
// eff_forbids: a BARE present beside an INSTANCE absent is a REFINEMENT
// ("any Sample except 44100") — the absent survives; only same-identity
// pairs (bare/bare, or instances not provably distinct) and an
// instance-present under a bare-absent (the severance blocking its own
// positive) are contradictions.
fn absent_contradicted_by(absent, present) with Memory = if eff_name_handle(absent) != eff_name_handle(present) {
  false
} else {
  match absent {
    ENamed(_) => true,
    EPure => false,
    EParameterized(_, aargs) => match present {
      ENamed(_) => false,
      EPure => false,
      EParameterized(_, pargs) => !eff_args_provably_distinct(aargs, pargs, 0),
    },
  }
}

fn mk_ef_closed(ref names) with Memory + Alloc = ef_make(names, [], EtClosed)

fn mk_ef_open(ref names, v) with Memory + Alloc = ef_make(names, [], EtOpen([v]))

// ONE pure row for the whole image — the identity element as a module
// value, every read a global load, zero allocation. This is the wheel's
// own first top-level let: the form that found the init-emission fault
// (the missing emit bracket, frontier mn-top-level-let) rides the fix.
let ef_pure_row = EfRow([], [], EtClosed)

fn mk_ef_pure() with Pure = ef_pure_row

// The crown's negative capability: !B = anything except B.
fn mk_ef_neg(ref names) with Memory + Alloc = ef_make([], names, EtAll)

// ─── The signed-clause fold — authored `with` terms to ONE row ───────
// The parsed triples (EffName, negated, EConn) build the canonical
// triple here, at their one home: infer's declared-row gate and the
// parser's fn-TYPE `with` rows (a param typed `() -> a with !WASI`)
// both read this fold. The with-clause is a SIGNED SET, not a running
// union: positives name what may be performed (composed by the
// authored connective); negations name what provably must NOT (one
// forbidden set — complements compose by intersection). The row is
// their meet; an authored Pure is absolute and dominates the clause.
fn is_pure_eff_name(name) = match name {
  EPure => true,
  _ => false,
}

// Neither operand is `own`: the row algebra's three verbs all BORROW
// (union/diff/inter read and mint), so an own here was a claim this fn
// never finishes (the relevant tier's first sweep).
fn apply_connective(conn, acc, term) = match conn {
  EcUnion => union_row(acc, term),
  EcDiff => diff_row(acc, term),
  EcInter => inter_row(acc, term),
}

fn has_pure_declared(effs) = any({ (name, _, _) => is_pure_eff_name(name) }, effs)

fn build_declared_row(effs) = build_row_seen(effs, [])

// A name whose env kind is RowAliasKind builds ITS row WHOLE through
// this same fold and the outer connective applies to the RESULT —
// grouping by construction (the inline-splice trap: with X = B,
// `X + (A - B)` is B + A, which splicing X's triples inline folds to
// A). `seen` guards cycles (E_RowAliasCycle, then pure — loud, then
// productive). A NEGATED alias reference (`with !File`) is sound only
// over a positive-closed alias row: its present names join the
// forbidden set; anything richer refuses the shorthand
// (E_RowAliasNegation) — de Morgan over the full algebra is not a
// shorthand's job.
fn build_row_seen(effs, seen) = match fold(
  (mk_ef_pure(), [], false),
  (acc, eff) => match acc {
    (pos, negs, saw) => match eff {
      (name, negated, conn) => if is_pure_eff_name(name) {
        (pos, negs, true)
      }
      // drift-audit: ignore — bounded by the authored clause length, not a loop accumulator
      else if negated {
        (pos, negs ++ neg_names_of(name, seen), saw)
      } else {
        (apply_connective(conn, pos, leaf_row_of(name, seen)), negs, saw)
      },
    },
  },
  effs
) {
  (pos, neg_names, saw_pure) => if saw_pure {
    mk_ef_pure()
  } else if len(neg_names) == 0 {
    pos
  } else {
    // ONE triple: the positives present, the negations absent — a solo
    // `with !N` is the negative capability (universal tail); positives
    // pin the gate closed with the absence riding as the crown's proof.
    // THE AUTHORED MEET runs HERE, at the one place a human wrote both
    // clauses: an absent entry a present entry genuinely contradicts
    // (`with A + !A` — the pair law, instance-aware) drops from the
    // declared row. This is a DECL-site rule, not a representation
    // invariant — flowing rows keep coexisting present/absent (the
    // reading law: present adds now, absent filters the tail).
    match pos {
      EfRow{present: pp, absent: pa, tail: pt} => if len(pp) == 0 {
        mk_ef_neg(sort_unique(neg_names))
      } else {
        let full_absent = name_set_union(pa, sort_unique(neg_names))
        // The pair law REPORTS before it drops (E_DeclaredRowContradiction,
        // band L's decl-site teaching): the pre-diagnostic meet resolved
        // `with A + !A` by silently discarding the negation, and the body's
        // perform of A then checked CLEAN under a clause that declared !A —
        // a false-absence surface measured 2026-08-08. One row cannot both
        // permit and forbid a name; the developer drops a side, never the fold.
        report_row_contradictions(full_absent, pp)
        ef_make(pp, absent_minus_present(full_absent, pp), pt)
      },
    }
  },
}

// The row-alias read: two env facts, read live at build time — the row
// algebra downstream never sees the name (Hβ.types.named-effect-rows).
fn row_alias_triples(name) = match env_lookup(eff_name_str(name)) {
  Some(entry) => match entry {
    (_, _, RowAliasKind(triples)) => Some(triples),
    _ => None,
  },
  None => None,
}

fn leaf_row_of(name, seen) = match row_alias_triples(name) {
  Some(triples) => if row_name_seen(seen, name) {
    report(ERowAliasCycle(eff_name_str(name), span_zero()))
    mk_ef_pure()
  } else {
    build_row_seen(triples, seen ++ [eff_name_str(name)])
  },
  None => mk_ef_closed([name]),
}

fn neg_names_of(name, seen) = match row_alias_triples(name) {
  Some(triples) => if row_name_seen(seen, name) {
    report(ERowAliasCycle(eff_name_str(name), span_zero()))
    []
  } else {
    match build_row_seen(triples, seen ++ [eff_name_str(name)]) {
      EfRow{present: pp, absent: pa, tail: pt} => if len(pa) == 0 && row_tail_closed(pt) {
        pp
      } else {
        report(ERowAliasNegation(eff_name_str(name), span_zero()))
        []
      },
    }
  },
  None => [name],
}

fn row_name_seen(seen, name) with Memory + Alloc + Intern =
  row_name_seen_at(seen, eff_name_str(name), 0, len(seen))

fn row_name_seen_at(seen, target: String, i, n) with Memory = if i >= n {
  false
} else {
  if list_index(seen, i) == target { true } else { row_name_seen_at(seen, target, i + 1, n) }
}

fn row_tail_closed(t) with Pure = match t {
  EtClosed => true,
  _ => false,
}

fn mk_record_open(ref fields, v) with Memory + Alloc = TRecordOpen(field_canonicalize(fields), v)

fn field_canonicalize(ref fields) with Memory + Alloc = {
  let n = len(fields)
  field_canonicalize_loop(fields, 0, n, [])
}

fn field_canonicalize_loop(ref fields, i, n, own acc) with Memory + Alloc = if i >= n {
  acc
} else {
  match list_index(fields, i) {
    (name, ty) => field_canonicalize_loop(fields, i + 1, n, field_insert(acc, name, ty)),
  }
}

// Insert (name, ty) into sorted-by-name list; if name already present,
// replace (last write wins).
fn field_insert(ref sorted, ref name: String, ref ty) with Memory + Alloc = {
  let n = len(sorted)
  let pos = field_find_pos(sorted, name, 0, n)
  if pos < n {
    match list_index(sorted, pos) {
      (existing_name, _) => if existing_name == name {
        // Replace at pos.
        let buf = make_list(n)
        let copied = list_copy_into(sorted, buf, 0, n)
        list_set(copied, pos, (name, ty))
      } else {
        // Insert at pos.
        let buf = make_list(n + 1)
        let prefix = list_copy_into(sorted, buf, 0, pos)
        let with_ins = list_set(prefix, pos, (name, ty))
        field_copy_suffix_shifted(sorted, with_ins, pos, pos, n)
      },
    }
  } else {
    // Append.
    let buf = make_list(n + 1)
    let copied = list_copy_into(sorted, buf, 0, n)
    list_set(copied, n, (name, ty))
  }
}

// Field-NAME equality with the String proof pinned at the boundary. The
// bare `==` on two tuple-destructured names carries no type proof through
// the seed's weak inference, so it emitted POINTER-eq — decl-pass-interned
// "tier" never matched literal-pass-interned "tier", and byte-identical
// records refused to unify ({ w, tier } vs { w, tier }, the rp2 pin).
// One home for the compare; every record-field walk routes through it.
// Dissolves with band D (== reads the operand proof at the eq-fold).
fn field_name_eq(a: String, b: String) with Pure = a == b

fn field_find_pos(ref sorted, ref name, i, n) with Memory = if i >= n {
  n
} else {
  match list_index(sorted, i) {
    (existing_name, _) => if str_lt(existing_name, name) { field_find_pos(sorted, name, i + 1, n) } else { i },
  }
}

fn field_copy_suffix_shifted(ref src, own dst, src_idx, dst_idx, n) with Memory = if src_idx >= n {
  dst
} else {
  field_copy_suffix_shifted(
    src,
    list_set(dst, dst_idx + 1, list_index(src, src_idx)),
    src_idx + 1,
    dst_idx + 1,
    n
  )
}

// ─── the triple algebra — fieldwise, canonical, no rewrite passes ──
//
// Identity until PROGRESS: resolution folds every tail EDGE into the
// head (THE ABSENT-MASK LAW, PLAN's settled laws) —
// r = p ∪ (each edge's content ∖ a); a bound edge contributes
//   p' = p ∪ (cp ∖ a),  a' = a ∪ ca,  and its residual tail merges on
// (Closed adds nothing, an open set unions into the residual, EtAll
// absorbs — the mask rides the absent field even at the universe). A
// free edge survives into the residual set; a row with no bound edge
// returns UNTOUCHED (identity until progress, preserved exactly).
fn resolve_row(row) with Memory + Alloc + GraphRead = match row {
  EfRow{present: p, absent: a, tail: t} => match t {
    EtOpen(vs) => match resolve_edges(vs, (p, a, [], false, false)) {
      (rp, ra, res, saw_all, progressed) => if progressed {
        if saw_all { ef_make(rp, ra, EtAll) } else { ef_make(rp, ra, EtOpen(res)) }
      } else {
        row
      },
    },
    _ => row,
  },
}

// The edge walk, STRUCTURAL — mechanism-layer recursion, never the
// fold/Iterate vocabulary (the resolver runs inside unify inside every
// judgment; the handler form floored the k2 yield boundary from inside
// its own dispatch — the 2026-08-01 m3 trap).
fn resolve_edges(ref vs: [Int], acc) with GraphRead + Memory + Alloc = match vs {
  [] => acc,
  [v, ...rest] => resolve_edges(rest, resolve_edge(acc, v)),
}

// One edge of the reading fold: acc = (p, a, residual, saw_all,
// progressed). Progress means at least one edge was bound — the
// no-progress row returns by identity above.
fn resolve_edge(acc, v) with GraphRead + Memory + Alloc = match acc {
  (p, a, res, saw_all, progressed) => match graph_chase(v) {
    GNode(kind, _) => match edge_row_of(kind) {
      Some(inner) => edge_content_into(p, a, res, saw_all, resolve_row(inner)),
      None => (p, a, tail_set_insert(res, v), saw_all, progressed),
    },
  },
}

// A resolved edge's content enters the accumulator — the one assembly
// every edge fold shares (resolve, compress, chase-face, subst). The
// residual set unions in order (the sorted-set invariant).
fn edge_content_into(ref p, ref a, ref res, saw_all, ri) with Memory + Alloc = match ri {
  EfRow{present: cp, absent: ca, tail: ct} => {
    let p2 = name_set_union(p, name_set_diff(cp, a))
    let a2 = name_set_union(a, ca)
    match ct {
      EtClosed => (p2, a2, res, saw_all, true),
      EtAll => (p2, a2, res, true, true),
      EtOpen(ws) => (p2, a2, tail_set_union(res, ws), saw_all, true),
    }
  },
}

// The compressing resolve — union-find's other half at the row sort:
// folding a chain REBINDS the var to its resolved terminal (trail-backed,
// semantically equal), so every later read is one hop. UNIFY-ONLY: the
// graph has one writer, so only unify_row (inference's own bind site)
// compresses; every other reader takes resolve_row and rides the web
// unify already compressed. The write goes through graph_compress_row —
// the OPTIMIZATION op, whose branch-cursor arm skips it (a branch
// rebinding shared chain cells makes sibling chases schedule-dependent;
// the root's sequential walks compress the web).
fn resolve_row_compress(row) = match row {
  EfRow{present: p, absent: a, tail: t} => match t {
    EtOpen(vs) => match resolve_edges_compress(vs, (p, a, [], false, false)) {
      (rp, ra, res, saw_all, progressed) => if progressed {
        if saw_all { ef_make(rp, ra, EtAll) } else { ef_make(rp, ra, EtOpen(res)) }
      } else {
        row
      },
    },
    _ => row,
  },
}

fn resolve_edges_compress(ref vs: [Int], acc) = match vs {
  [] => acc,
  [v, ...rest] => resolve_edges_compress(rest, resolve_edge_compress(acc, v)),
}

// The compressing fold's edge: resolve, REBIND the edge to its terminal
// (the one-hop web later reads ride), then fold the content in.
fn resolve_edge_compress(acc, v) = match acc {
  (p, a, res, saw_all, progressed) => match graph_chase(v) {
    GNode(kind, _) => match kind {
      NRowBound(inner) => {
        let ri = resolve_row_compress(inner)
        graph_compress_row(v, ri)
        edge_content_into(p, a, res, saw_all, ri)
      },
      k => // A fn-typed edge FOLDS its row but is NEVER compressed: the cell's
      // binding IS the function type, and a compress write here would
      // overwrite the TFun with a row (the cell serves the type reads too).
      match edge_row_of(k) {
        Some(inner) => edge_content_into(p, a, res, saw_all, resolve_row_compress(inner)),
        None => (p, a, tail_set_insert(res, v), saw_all, progressed),
      },
    },
  },
}

// The LATTICE JOIN — the teaching write's algebra (graph_bind_row's
// bound-cell arm). Differs from union_row in ONE move: parameterized
// instances COEXIST as fragments (dedup by instance identity, never by
// name), because instance payloads are unification variables, not lattice
// points — a by-name union collapses different callers' instances
// (Iterate(Float) eating Iterate(List(t)) — 85 measured E_TypeMismatch
// the moment the join landed by-name) where the install is the one place
// fragments reconcile (the same-name-fragments-coexist law). Fragment
// identity is the instance's own record — conservative: an unshared
// equal fragment coexists as a copy, and coexistence is the safe side.
// Bare names and absent sets are genuine name-sets; tails join as ever.
fn row_join(ref a, ref b) with !Mutate + Memory + Alloc = match a {
  EfRow{present: pa, absent: aa, tail: ta} => match b {
    EfRow{present: pb, absent: ab, tail: tb} => {
      let p = frag_union(pa, pb)
      let absent = match ta {
        EtClosed => match tb {
          EtClosed => [],
          _ => ab,
        },
        _ => match tb {
          EtClosed => aa,
          _ => name_set_union(aa, ab),
        },
      }
      ef_make(p, absent, tail_join(ta, tb))
    },
  },
}

// A join COLLISION: the two rows carry same-named parameterized
// instances with DIFFERENT identities — the leak instrument. A shared
// cell should never receive two independent callers' instance payloads
// (each caller's instantiation owns fresh copies); a collision names a
// share that escaped freshening, and the join's coexistence is the
// confluence net that keeps it deterministic while the census drives
// the leak class to zero.
fn row_frag_collision(ref a, ref b) with Memory + Alloc = match a {
  EfRow{present: pa} => match b {
    EfRow{present: pb} => frag_collision_walk(pa, pb, 0),
  },
}

fn frag_collision_walk(ref pa, ref pb, i) with Memory + Alloc = if i >= len(pb) {
  false
} else {
  let hit = match list_index(pb, i) {
    EParameterized(h2, args2) => frag_name_clash(pa, h2, args2, 0),
    _ => false,
  }
  if hit { true } else { frag_collision_walk(pa, pb, i + 1) }
}

fn frag_name_clash(ref pa, h2, args2, j) with Memory + Alloc = if j >= len(pa) {
  false
} else {
  let hit = match list_index(pa, j) {
    EParameterized(h1, args1) => h1 == h2 && !frag_args_same(args1, args2),
    _ => false,
  }
  if hit { true } else { frag_name_clash(pa, h2, args2, j + 1) }
}

// Fragment-identity union: b's entries append unless an identical entry
// is already present. Bare ENamed dedups by handle (one instance per bare
// effect by construction); EParameterized dedups by the instance's GRAPH
// identity (frag_args_same — the instance IS the fragment).
fn frag_union(ref pa, ref pb) with Memory + Alloc =
  fold(pa, (acc, e) => if frag_present(acc, e, 0) { acc } else { acc ++ [e] }, pb)

fn frag_present(ref acc, e, i) with Memory + Alloc = if i >= len(acc) {
  false
} else {
  let hit = match (list_index(acc, i), e) {
    (ENamed(h1), ENamed(h2)) => h1 == h2,
    (EParameterized(h1, args1), EParameterized(h2, args2)) => h1 == h2 && frag_args_same(args1, args2),
    _ => false,
  }
  if hit { true } else { frag_present(acc, e, i + 1) }
}

// Fragment identity is the instance's GRAPH identity — the arg handles the
// perform minted, scalar payloads by value — never the args list's ADDRESS.
// addr-identity was deterministic within one binary and UNSTABLE across two
// (region resets re-issue addresses, and each binary's allocation sequence
// differs), and the march measured it: one dedup coincidence differing
// between the m2 and m3 binaries flipped one can_yield verdict — the
// 13-line m3 ≠ m4 k2-wrap divergence on driver_incremental. Handles are a
// pure function of the source (the banded partition), so this dedup is
// binary-invariant. A non-var type payload coexists conservatively (the
// safe side); after an install reconciles fragments their args UNIFY, and
// the reconciled instance IS the install's identity — the same channel the
// crown's instance-precise negation keys on (install provenance, the
// world-chain hkey: designed here once, consumed by the modal crown).
fn frag_args_same(ref a1, ref a2) with Memory + Alloc =
  len(a1) == len(a2) && frag_args_same_walk(a1, a2, 0)

fn frag_args_same_walk(ref a1, ref a2, i) with Memory + Alloc = if i >= len(a1) {
  true
} else {
  let same = match (list_index(a1, i), list_index(a2, i)) {
    (EAInt(x), EAInt(y)) => x == y,
    (EAFloat(x), EAFloat(y)) => x == y,
    (EAString(x), EAString(y)) => x == y,
    (EAType(tx), EAType(ty2)) => match (tx, ty2) {
      (TVar(hx), TVar(hy)) => hx == hy,
      _ => false,
    },
    (EANode(nx), EANode(ny)) => nx == ny,
    (EAEffect(hx), EAEffect(hy)) => // The registration fold's constants: one interned identity each, so
    // sameness is the word compare (eff_arg_scalar_unequal's dual).
    hx == hy,
    (EACon(hx), EACon(hy)) => hx == hy,
    _ => false,
  }
  if same { frag_args_same_walk(a1, a2, i + 1) } else { false }
}

// Union (`+` and the accumulation of performs): presents union; a name
// present ANYWHERE escapes every mask, so the joint absent set drops it;
// tails join Closed < Var < All, first var kept (unification constrains).
fn union_row(ref a, ref b) with Memory + Alloc = match a {
  EfRow{present: pa, absent: aa, tail: ta} => match b {
    EfRow{present: pb, absent: ab, tail: tb} => {
      let p = name_set_union(pa, pb)
      let absent = match ta {
        EtClosed => match tb {
          EtClosed => [],
          _ => ab,
        },
        _ => match tb {
          EtClosed => aa,
          _ => name_set_union(aa, ab),
        },
      }
      ef_make(p, absent, tail_join(ta, tb))
    },
  },
}

// THE UNION IS LIVE (the B1+B3+charge-as-edge arc — D9 rung 1). Its two
// prior convictions (2026-08-01: deep-set reads, then thousands-element
// sets at SHARED LOOSE-PREREG CELLS — one fresh edge per forward
// caller's teach, O(n²) insert allocation to the 4GB guard) were the
// HUB's bill, and the hub's writer is deleted at the one-way call and
// pipe edges (infer_call_saturated / infer_pipe: the expectation's row
// IS the callee's own row, so unify_row meets identical rows and
// no-ops — no caller ever teaches a callee's cell). A cell's edge set
// is now bounded by its own body's distinct callees plus value-position
// merges (the writer census's Class B), so the set union is the join
// the lattice always wanted: a second callee's edge SURVIVES where the
// first-var drop discarded it. mn-two-tail-accumulation is the
// acceptance.
fn tail_join(ta, tb) with Memory + Alloc + !Mutate = match ta {
  EtClosed => tb,
  EtOpen(vs) => match tb {
    EtAll => EtAll,
    EtOpen(ws) => EtOpen(tail_set_union(vs, ws)),
    EtClosed => EtOpen(vs),
  },
  EtAll => EtAll,
}

// Difference (`-` and the `~>` subtraction): an EAGER LITERAL DIFFERENCE
// into the fields — b's present names leave a's present and join a's
// absent, masking the tail FOREVER (the subtraction cannot be dropped by
// a later tail grounding: it is a field of the row, not a rewrite step).
//
// A VAR tail's mask goes INTO THE GRAPH, not the field: union's absent is
// the mask INTERSECTION (set-correct — each mask scopes only its own
// tail), so a top-level mask on a var-tailed row VANISHES the moment the
// absorbed row unions into a frame (the multieffect leak: `run() ~>
// buffer` in let position lost Emit's subtraction at the frame union).
// Minting a fresh var BOUND to the masked triple over the original tail
// makes the mask an EDGE resolve_row folds through — unions carry vars
// untouched, so the subtraction survives every union by construction.
fn diff_row(ref a, ref b) with GraphWrite + Memory + !Mutate + Alloc = match a {
  EfRow{present: pa, absent: aa, tail: ta} => match b {
    EfRow{present: pb} => match ta {
      EtOpen(vs) => {
        // The mask edge wraps the WHOLE original edge set — one fresh
        // cell bound to the masked triple over every surviving edge, so
        // the subtraction rides any union as a single opaque edge.
        let masked = graph_fresh_row(Inferred("~> subtraction mask"))
        graph_bind_row(
          masked,
          EfRow([], name_set_union(aa, pb), EtOpen(vs)),
          Inferred("pending tail subtraction")
        )
        ef_make(name_set_diff(pa, pb), [], EtOpen([masked]))
      },
      _ => ef_make(name_set_diff(pa, pb), name_set_union(aa, pb), ta),
    },
  },
}

// Intersection (`&`): closed∩closed intersects presents; anything meeting
// the pure-negation form (p=[], tail=All) is the difference; the
// var-tailed general meet is the modal frontier — the LOUD refusal names
// it instead of mushing (the crucible that reaches it is the witness).
fn inter_row(ref a, ref b) with Memory + Alloc + GraphWrite = match a {
  EfRow{present: pa, absent: aa, tail: ta} => match b {
    EfRow{present: pb, absent: ab, tail: tb} => match ta {
      EtAll => if len(pa) == 0 { diff_row(b, mk_ef_closed(aa)) } else { EfRow(pa, aa, ta) },
      _ => match tb {
        EtAll => if len(pb) == 0 { diff_row(a, mk_ef_closed(ab)) } else { EfRow(pa, aa, ta) },
        _ => match ta {
          EtClosed => match tb {
            EtClosed => ef_make(name_set_intersect(pa, pb), [], EtClosed),
            _ => ef_make(name_set_intersect(pa, pb), [], EtClosed),
          },
          _ => ef_make(name_set_intersect(pa, pb), [], EtClosed),
        },
      },
    },
  },
}

// Handler absorption: row(expr ~> h) = (body − handled) ⊕ residual.
fn absorb_row(ref body_row, ref handled_row, ref extra_row) with !Mutate =
  union_row(diff_row(body_row, handled_row), extra_row)

// A recursive fn's row equation R = names ∪ R takes its LEAST solution:
// a tail landing on the fn's OWN row handle cuts to the closed head. The
// compare runs on CHASED ROOTS (find-before-compare — unify IS union-find,
// and the frame's fresh row cell aliases its pre-registration root through
// the decl's entry unify, so a raw handle compare misses the self-loop
// that arrives through the alias). This one cut closes a whole mutual
// cycle: each member's charge lands on its callee's LIVE root, so the
// LAST member's resolved tail chases the entire loop back to its own
// cell — the least solution for the SCC, with the storage acyclic
// (every earlier member finalized before its tail's target was bound).
// CONDEMNED CUT, whole-or-nothing (the resolved design D3/D4): this
// publish-time freeze is the severed-co-member-effects root
// (mn-cycle-charge-freeze), and its HALF-STEP replacement was built and
// REVERTED 2026-07-31 (the bb8b93a2 guard: a visiting-set resolve with
// the cut moved to the read). Measured against it: live tails escaped
// into published rows with no completion event to drain them, so
// fragment/payload joins behind those tails never fired — the element
// instance never taught a HOF lambda's param (findtag/mapelem/mapfield
// exit 134, field offset unprovable) and parked masks surfaced as
// !Iterate-carrying body rows (forty gate refusals). The cut deletes
// ONLY with the row half landed whole: edge-set tails (D3) + gates and
// drains at the group's completion event (D4). Until then this freeze
// is the sound form.
fn row_without_self(row, self_h) with Memory + Alloc + GraphRead = match resolve_row(row) {
  EfRow{present: p, absent: a, tail: t} => match t {
    EtOpen(vs) => {
      // The cut drops every edge chasing to the fn's OWN cell; the
      // surviving edges keep the tail open (chased-root compare — the
      // find-before-compare law). Structural walk, mechanism layer.
      let others = edges_without_self(vs, graph_chase_handle(self_h))
      if len(others) == 0 { ef_make(p, a, EtClosed) } else { ef_make(p, a, EtOpen(others)) }
    },
    _ => EfRow(p, a, t),
  },
}

fn edges_without_self(ref vs: [Int], self_root: Int) with Memory + Alloc + GraphRead = match vs {
  [] => [],
  [v, ...rest] => if graph_chase_handle(v) == self_root {
    edges_without_self(rest, self_root)
  } else {
    [v] ++ edges_without_self(rest, self_root)
  },
}

// THE COMPLETION PRUNE — the one-way-edge arc's pressure valve: the fold
// that makes a published row SMALL. At a decl's finalize, a still-FREE
// edge minted DURING the judgment (chased root >= the pass's prereg
// ceiling) is an unconstrained instantiated copy — no constraint ever
// reached it, and none can arrive (its only escape was this row) — so it
// reads as the pure body (the publish law's own unbound reading) and
// DROPS. A free edge BELOW the ceiling is a prereg cell: a co-member's
// or forward decl's live accumulator, the shared link the one-way reads
// flow through — KEPT. A bound edge is a content link — KEPT (reads fold
// it). Without this prune the raw accumulated set publishes whole and
// multiplies through generalize∘instantiate — qvars(f) = Σ refs ×
// qvars(callee) — measured to the 4GB guard three ways (tail_set churn,
// the mint_row storm, the payload-var collection) on a 6,458-line lib
// blob. Ceiling 0 = pass-through (a chain that never set it prunes
// nothing). Structural walk — row walks are mechanism, the paid law.
//
// The THIRD keep category — the signature keep-set — is what makes the
// drop reading TRUE where it fires: a free judgment-era root the decl's
// params/return reach at exit escapes through instantiate at every call
// site (generalize's signature collection quantifies exactly these), so
// "none can arrive" is false for it. The two-category form dropped that
// edge and published `run(f) = f()` as Pure while f's row var rode the
// scheme disconnected — the crown's higher-order leak (root 29 vs
// ceiling 26 by binary-patch wat probe; the keep census showed the
// collected root IS the severed edge, and the crown flipped 4/1 → 5/5
// with the wheel census still 0). The 2026-08-05 refuted attempt at this
// same category collected from declared slots and never contained the
// root: signature_free_roots reads THROUGH the live cells at exit,
// deep-chased — that read is load-bearing. Record:
// `Hβ.infer.hof-param-row-never-reaches-enclosing` in RESIDUE.md.
fn row_keep_completion(row, ceiling: Int, sig_keep: [Int]) with Memory + Alloc + GraphRead = if ceiling == 0 {
  row
} else {
  match row {
    EfRow{present: p, absent: a, tail: t} => match t {
      EtOpen(vs) => {
        let kept = edges_keep_completion(vs, ceiling, sig_keep)
        if len(kept) == 0 { ef_make(p, a, EtClosed) } else { ef_make(p, a, EtOpen(kept)) }
      },
      _ => row,
    },
  }
}

fn edges_keep_completion(ref vs: [Int], ceiling: Int, sig_keep: [Int]) with Memory + Alloc + GraphRead = match vs {
  [] => [],
  [v, ...rest] => match graph_chase(v) {
    GNode(kind, _) => // "A bound edge is a content link — KEPT (reads fold it)" holds for
    // BOTH row-bearing bindings (edge_row_of, the one projection): a row
    // cell, and a cell bound to a FUNCTION type — the caller's freshened
    // HOF param, bound by the argument, whose row the finalize fold now
    // reads. The NRowBound-only keep dropped the fn-typed link as an
    // above-ceiling transient, and the callee's effects died with it
    // (the under-publish peer's layer two).
    match edge_row_of(kind) {
      Some(_) => [v] ++ edges_keep_completion(rest, ceiling, sig_keep),
      None => {
        let r = graph_chase_handle(v)
        if r < ceiling {
          [v] ++ edges_keep_completion(rest, ceiling, sig_keep)
        } else if any((k) => k == r, sig_keep) {
          [v] ++ edges_keep_completion(rest, ceiling, sig_keep)
        } else {
          edges_keep_completion(rest, ceiling, sig_keep)
        }
      },
    },
  },
}

// ─── the gates ──────────────────────────────────────────────────────
//
// Subsumption: body ⊆ gate, fieldwise and decidable.
//   gate tail All    (the !B stance): body's reachable names must avoid
//                    gate.absent — present ∩ B = ∅, and an open body tail
//                    must itself be masked (body.absent ⊇ B) or free-to-
//                    constrain (conservative reject when it is not).
//   gate tail Closed: body must be closed with present ⊆ gate.present.
//   gate tail Open:   the gate is polymorphic — body's knowns must fit
//                    the gate's knowns; the tails unify later.
fn row_subsumes(ref body_row, ref gate_row) with Memory + Alloc + GraphRead = {
  // Subsumption is a READ — resolve without compressing. The graph has ONE
  // writer (inference); a gate check runs from every projection (egraph
  // is_pure, the gradient's narrowing read, the census), and a read that
  // rebinds row vars would make every projection a writer. Compression
  // (resolve_row_compress) lives at unify_row alone, where inference
  // already owns the bind.
  // A body tail STILL EtOpen after resolve is GENUINELY free (NRowFree) —
  // empty after full inference: a monomorphic fn accumulated no further
  // effect, so the body performs exactly its present names and the free
  // tail is vacuous at the gate (the rebind at the gate closes it to the
  // declared row). Rejecting it was the ~80% row-var slice of the
  // self-compile's false effect-mismatches — twice now (measured at 646
  // on this representation's first self-judgment; the ledger has both). A body tail EtAll (the
  // negative stance: everything-except) is never subsumed by a closed
  // gate — an unknown-beyond-mask body may perform outside it.
  let b = resolve_row(body_row)
  let g = resolve_row(gate_row)
  match b {
    EfRow{present: pb, absent: ab, tail: tb} => match g {
      EfRow{present: pg, absent: ag, tail: tg} => match tg {
        EtAll => // The `!B` gate: nothing present may touch the forbidden set. A
        // closed or free-tailed body passes on disjointness alone.
        //
        // THE FREE TAIL IS ADMITTED HERE AND NOTHING CLOSES IT LATER. This
        // clause used to promise that "a var that LATER grows is caught at
        // unify, where Open~All binds the var to the mask"; measured
        // 2026-08-18, it is not: `fn run(f) with !E = f()` accepts
        // `run(() => op())`, and so does the `with Pure` gate below, and so
        // does an unrelated `!WASI`. A PARAM's row var reaching the gate
        // through a call is never bound by the declaration it passed.
        // Rejecting it here is the twice-measured dead end (the ~80% row-var
        // slice, 646 false mismatches); the constraint belongs at the
        // DECLARATION, where inference owns the write —
        // `Hβ.infer.declared-row-vacuous-against-a-free-body-row` carries the
        // design. This read stays a read.
        //
        // An EtAll body must carry at least the gate's mask: ¬A ⊆ ¬B iff B ⊆ A.
        if forbidden_names_disjoint(pb, ag) {
          match tb {
            EtClosed => true,
            EtOpen(_) => true,
            EtAll => name_set_subset(ag, ab),
          }
        } else {
          false
        },
        EtClosed => // The closed gate's absent set is the declared `!B` proof: nothing
        // present may touch it, transitively through every subsumption.
        // Present membership is the ADMISSION read (eff_admits — the
        // instance law's positive side), not bare structural equality: a
        // bare declared name admits every instance of its name.
        if forbidden_names_disjoint(pb, ag) {
          match tb {
            EtClosed => present_admitted(pb, pg),
            EtOpen(_) => present_admitted(pb, pg),
            EtAll => false,
          }
        } else {
          false
        },
        EtOpen(_) => match tb {
          EtClosed => present_admitted(pb, pg),
          EtOpen(_) => present_admitted(pb, pg),
          EtAll => false,
        },
      },
    },
  }
}

// Unification — the equality constraint, fieldwise. The var-tail binds
// the RESIDUAL TRIPLE (the crown's carry-the-algebra-forward move:
// binding a tail to ([], B, All) is exactly bind_open_to_neg; binding to
// a masked triple carries the pending subtraction). All allocation is
// per unify EVENT; reads stay identity.
fn unify_row(ref a, ref b, ref span, ref reason) with !Mutate =
  unify_row_canonical(resolve_row_compress(a), resolve_row_compress(b), span, reason)

// Bind one row into EVERY edge of a set — the multi-edge bind the five
// unify arms share. Structural walk (mechanism layer, the resolver's
// own discipline).
fn bind_edges_to(ref ws: [Int], row, ref span, ref reason) with Memory + Alloc + GraphWrite = match ws {
  [] => (),
  [w, ...rest] => {
    graph_bind_row(w, row, Located(span, reason))
    bind_edges_to(rest, row, span, reason)
  },
}

fn unify_row_canonical(ref a, ref b, ref span, ref reason) with Memory + Alloc + Intern + GraphRead + Diagnostic + GraphWrite = match a {
  EfRow{present: pa, absent: aa, tail: ta} => match b {
    EfRow{present: pb, absent: ab, tail: tb} => match ta {
      EtClosed => match tb {
        EtClosed => if name_set_eq(pa, pb) { () } else { report_effect_mismatch(a, b, span, reason) },
        EtOpen(wbs) => // Closed(A) ~ (B + edges∖ab): the residual (A ∖ B) binds EVERY
        // edge (A2's judged form) — the equation demands each edge's
        // contribution fit within the residual and the union read
        // exactly A; binding each to the residual-closed row is the
        // maximal solution, and each cell's OTHER referents learn the
        // same closed bound (the singleton case is today's unique
        // solution verbatim). A masked name demanded by A is a genuine
        // mismatch.
        if forbidden_names_disjoint(pa, ab) {
          bind_edges_to(wbs, ef_make(name_set_diff(pa, pb), [], EtClosed), span, reason)
        } else {
          report_effect_mismatch(a, b, span, reason)
        },
        EtAll => // Closed ~ ¬B: the negation row is a GATE by construction (§4③ —
        // "the negation is the GATE"), so the meet is SUBSUMPTION, not
        // equality: a concrete row satisfying the mask passes with NO
        // bind — each side keeps its own row (the context reads its
        // declared gate, the value its tighter truth; widening, sound).
        // Equality here falsely refused every rigid arg against a
        // neg-rowed fn-type param ("Pure vs !WASI", the b3 probe — the
        // resume barrier's admit face). The unguarded direction (a
        // ¬-rowed VALUE flowing into a closed context) stays refused by
        // the reverse arm below; the fully direction-aware call edge is
        // the named residual Hβ.effects.directional-fn-row-edge.
        if row_subsumes(a, b) { () } else { report_effect_mismatch(a, b, span, reason) },
      },
      EtOpen(was) => match tb {
        EtClosed => if forbidden_names_disjoint(pb, aa) {
          bind_edges_to(was, ef_make(name_set_diff(pb, pa), [], EtClosed), span, reason)
        } else {
          report_effect_mismatch(a, b, span, reason)
        },
        EtOpen(wbs) => // Identical edge sets are ONE tail (structural == over the
        // canonical sorted sets — singletons reduce to the old handle
        // compare). Otherwise every edge PRIVATE to a binds the
        // residual whose tail keeps b's WHOLE edge set: shared edges
        // stay free on both sides (contributing equally to both
        // readings), a-only edges learn b's knowns and chain to b's
        // set — no bound edge appears in its own binding's tail
        // (a-only ∉ wbs), so the occurs guard has nothing to cut.
        // a ⊆ b degenerates to the identical case's name check (the
        // one-way teach — D5's decl→site direction — as today).
        if was == wbs {
          if name_set_eq(pa, pb) { () } else { report_effect_mismatch(a, b, span, reason) }
        } else {
          let only_a = tail_set_diff(was, wbs)
          if len(only_a) == 0 {
            if name_set_eq(pa, pb) { () } else { report_effect_mismatch(a, b, span, reason) }
          } else {
            bind_edges_to(
              only_a,
              ef_make(name_set_diff(pb, pa), name_set_diff(ab, pa), EtOpen(wbs)),
              span,
              reason
            )
          }
        },
        EtAll => // Open ~ !B: the SOUND modal closure — every edge carries the
        // negative capability forward; the knowns must avoid B.
        if forbidden_names_disjoint(pa, ab) {
          bind_edges_to(was, EfRow([], ab, EtAll), span, reason)
        } else {
          report_effect_mismatch(a, b, span, reason)
        },
      },
      EtAll => match tb {
        EtAll => if name_set_eq(aa, ab) && name_set_eq(pa, pb) {
          ()
        } else {
          report_effect_mismatch(a, b, span, reason)
        },
        EtOpen(wbs) => if forbidden_names_disjoint(pb, aa) {
          bind_edges_to(wbs, EfRow([], aa, EtAll), span, reason)
        } else {
          report_effect_mismatch(a, b, span, reason)
        },
        EtClosed => // ¬A ~ Closed: the mirror of the gate meet above — the closed
        // side satisfying the mask passes with no bind.
        if row_subsumes(b, a) { () } else { report_effect_mismatch(a, b, span, reason) },
      },
    },
  },
}

// The reason rides to the report site so the mismatch can NAME its
// construction (it pinned the E_EffectMismatch quartet to one call form
// in a single read). Carrying it into the rendered diagnostic is the
// named peer Hβ.diag.effect-mismatch-reason — DiagKind's ctor widens
// with a Reason field and diag_message renders it through show_reason.
fn report_effect_mismatch(ref a, ref b, ref span, ref reason) with !Mutate =
  report(EEffectMismatch(a, b, span))

// Ground: no open edge anywhere the dispatch would need resolved.
fn row_is_ground(ref row) with Pure = match row {
  EfRow{tail: t} => match t {
    EtOpen(_) => false,
    _ => true,
  },
}

fn sort_unique(ref names) with Memory + Alloc = name_set_canonicalize(names)

// The comparison KEY — name identity as the interned handle (one word;
// §5.O layer 1 landed). An effect declaration's name and a negation
// clause's name intern to the SAME handle, so identity is i32.eq by TYPE — the
// pointer-miss class the old by-name str_eq family guarded against is
// unconstructible, and a missed intern at a mint site is a loud
// E_TypeMismatch, never a silent miss. ENamed and EParameterized of one
// base name share the handle, so bare-name membership matches an instance
// by the same word compare (instance-precise negation stays the named
// follow-on, Hβ.effects.parameterized-negation-instance). EPure carries
// the reserved absent handle 0 and never matches a named effect.
fn eff_name_handle(name: EffName) -> Int with Pure = match name {
  ENamed(h) => h,
  EParameterized(h, _) => h,
  EPure => 0,
}

// The RENDER projection — handle → canonical spelling, read live from the
// intern table. Comparisons never come here (eff_name_handle is the key);
// diagnostics, show, and lower's ename extraction do.
fn eff_name_str(name: EffName) -> String with Intern = match name {
  ENamed(h) => intern_name_of(h),
  EParameterized(h, _) => intern_name_of(h),
  EPure => "",
}

// body ∩ forbidden = ∅ BY NAME — the crown's negation membership. A body effect
// whose NAME is forbidden fails the gate: this is where a forbidden effect
// carried in through instantiation is CAUGHT.
fn forbidden_names_disjoint(ref body, ref forbidden) with !Mutate =
  forbidden_names_disjoint_loop(body, forbidden, 0, len(body))

fn forbidden_names_disjoint_loop(ref body, ref forbidden, i, n) with Memory = if i >= n {
  true
} else if name_in_forbidden(forbidden, list_index(body, i), 0, len(forbidden)) {
  false
} else {
  forbidden_names_disjoint_loop(body, forbidden, i + 1, n)
}

fn name_in_forbidden(ref forbidden, present, i, n) with Memory = if i >= n {
  false
} else if eff_forbids(list_index(forbidden, i), present) {
  true
} else {
  name_in_forbidden(forbidden, present, i + 1, n)
}

// The negation's INSTANCE LAW (SYNTAX §«Parameterized effect»: equality
// is name AND argument value) — does a forbidden entry block a present
// one? A bare `!E` severs every instance and the bare name; a forbidden
// instance `!E(args)` blocks the bare name (a bare occurrence could be
// any instance — conservative) and any instance not PROVABLY distinct.
// Provable distinctness is the only admission: scalar literal args
// (Int/Float/String) with unequal values at a shared position; type and
// node args never prove it. Both directions of the crown read this one
// predicate — subsumption's forbidden-membership and ef_make's
// absent-minus-present — so `Sample(48000) + !Sample(44100)` holds the
// severance it declares instead of the by-name dedup silently deleting
// it at row construction.
fn eff_forbids(forbidden: EffName, present: EffName) with Memory = if eff_name_handle(forbidden) != eff_name_handle(present) {
  false
} else {
  match forbidden {
    ENamed(_) => true,
    EPure => false,
    EParameterized(_, fargs) => match present {
      ENamed(_) => true,
      EPure => false,
      EParameterized(_, pargs) => !eff_args_provably_distinct(fargs, pargs, 0),
    },
  }
}

// The admission's INSTANCE LAW — eff_forbids' positive dual, read at the
// subsumption's present legs: does a gate's present entry admit a body
// charge? A bare declared name admits every instance of its name
// (declaring `with Sample` constrains the NAME; the instance stays the
// body's own). An instanced declaration admits exactly the structurally
// same instance — the declared gate's pin (pin_declared_instances) has
// already written its scalar literals into the charge's unknowable value
// dims, so a surviving argument difference IS a different instance — and
// refuses a bare charge (it could be any instance; conservative, the
// same frame eff_forbids holds on the negation side).
fn eff_admits(gate_name: EffName, body_name: EffName) with Memory + Alloc = if eff_name_handle(gate_name) != eff_name_handle(body_name) {
  false
} else {
  match gate_name {
    ENamed(_) => true,
    EPure => false,
    EParameterized(_, gargs) => match body_name {
      ENamed(_) => false,
      EPure => false,
      EParameterized(_, bargs) => frag_args_same(gargs, bargs),
    },
  }
}

fn present_admitted(ref bp, ref gp) with Memory + Alloc =
  all((b) => any((g) => eff_admits(g, b), gp), bp)

fn eff_args_provably_distinct(ref a, ref b, i) with Memory = if len(a) != len(b) {
  // Differing arity never proves distinctness — an effect has ONE
  // declared signature, so the pair is ill-formed and the instance
  // typing owns the refusal; the negation stays conservative.
  false
} else if i >= len(a) {
  false
} else if eff_arg_scalar_unequal(list_index(a, i), list_index(b, i)) {
  true
} else {
  eff_args_provably_distinct(a, b, i + 1)
}

fn eff_arg_scalar_unequal(fa, pa) with Pure = match fa {
  EAInt(x) => match pa {
    EAInt(y) => x != y,
    _ => false,
  },
  EAFloat(x) => match pa {
    EAFloat(y) => x != y,
    _ => false,
  },
  EAString(x) => match pa {
    EAString(y) => x != y,
    _ => false,
  },
  EAType(_) => false,
  EANode(_) => false,
  EAEffect(x) => // The registration fold's constants (types.mn EffArg): an effect name
  // and a nullary ctor are GLOBAL identities — one namespace each, the
  // intern handle the word — so handle inequality IS value inequality,
  // unconditionally (two distinct constructors are distinct values
  // whatever their types; ill-typed positions are instance typing's
  // refusal, never a distinctness claim).
  match pa {
    EAEffect(y) => x != y,
    _ => false,
  },
  EACon(x) => match pa {
    EACon(y) => x != y,
    _ => false,
  },
}

// string_in_list — membership over a list of STRINGS (own.mn's ref-escape
// names), NOT EffNames. It aliased name_set_contains, whose by-name leaf
// derefs each element as an EffName (eff_name_str) — a bare String traps
// there. The two were conflated into one fn; they are different element
// types, so they get different comparisons. The elements are words
// (list_index erases the type), so str_eq explicitly — a bare `==` would
// floor to the same pointer-eq name_set_contains just shed.
fn string_in_list(ref lst, s: String) with Memory = string_in_list_loop(lst, s, 0, len(lst))

fn string_in_list_loop(ref lst, s: String, i, n) with Memory = if i >= n {
  false
}
// drift-audit: ignore — the String case of ==; nameable-sequence leaf, band D
else if str_eq(list_index(lst, i), s) {
  true
} else {
  string_in_list_loop(lst, s, i + 1, n)
}

// EffName equality is the ONE structural `==` (the value-layer fold's sum-eq
// leaf, §5.U) — type-dispatched at emit, total over the five node-kinds, so
// `ENamed`'s string / `EParameterized`'s (name, args) / `EPure` all compare by
// shape with no hand-rolled comparator. The DELETED eff_name_eq / eff_args_eq /
// eff_arg_eq were its drift-7 twins (and their `match a` fell through to a trap
// on a null the fold tag-compares past). One equality; per SYNTAX §Parameterized
// effect (structural for compound args). A parameterized effect carries ONE
// shared type var per instance (register_one_op / register_effect_ops), so a row
// never holds two different-var `Iterate` entries — `==` dedups them exactly as
// the old EAType-always-equal boundary did. (peer Hβ.effects.parameterized-
// effect-row-dedup verifies the shared-var invariant at the value gate.)
//
// Row-name set algebra
// [EffName] SET ops — a row IS a set, so membership (name_set_contains, a
// linear by-name scan) is the ONE operation: subset / subsumption /
// equality (len + mutual-subset) and dedup all read through it, order-
// independent. No canonical order is imposed because no consumer reads one —
// equality is order-free (name_set_eq) and ev-slots are key-addressed, not
// positional (lower.mn derive_ev_slots). So the sorted insert (make_list(n+1)
// + copy + shift + eff_name_lt — the null's trap site) is DISSOLVED: the
// drift-7 twin of strings.mn's string-set collapses to one membership,
// and the sort — a canonical order no reader consumes — is the re-derivation
// the Carried-Truth Law deletes (§4①: one ordered-keyed-set operation).
//
// Set builds are BUFFER-COUNTER (§9): one make_list at the max size, a
// write-cursor appends, one slice at the end. The insert-per-element form
// copied the whole accumulator per step — at row sizes the asymptotics are
// moot (rows are small), but the copy VOLUME ran millions of times per
// pass; this family is on the inf_add_row hot path.
fn name_set_canonicalize(ref names) with Memory + Alloc = {
  let n = len(names)
  // Identity fast path — a duplicate-free input IS its canonical form, so
  // return it UNSHARED-COPY-FREE. Rows are 0–3 names almost everywhere; the
  // check is a scan with zero allocation, and the rebuild runs only when a
  // duplicate actually exists. This is the churn fix for the 4GB bump image:
  // ef_make canonicalizes at every algebra op, and before this path each op
  // paid make_list + slice even for [] and singletons.
  if n <= 1 {
    names
  } else if name_set_is_dedup(names, 0, n) {
    names
  } else {
    name_set_dedup_into(names, 0, n, make_list(n), 0)
  }
}

// Is the list already duplicate-free (by-name, the same leaf as dedup)?
fn name_set_is_dedup(ref names, i, n) with Memory = if i >= n {
  true
} else if name_set_prefix_contains(names, i, list_index(names, i)) {
  false
} else {
  name_set_is_dedup(names, i + 1, n)
}

fn name_set_dedup_into(ref names, i, n, own buf, count) with Memory + Alloc = if i >= n {
  slice(buf, 0, count)
} else {
  let x = list_index(names, i)
  let at = name_set_prefix_index(buf, count, x)
  if at >= 0 {
    // A name collision UPGRADES bare -> parameterized in place: the
    // instance carries the payload truth the bare name only gestures at
    // (bare ∪ instance = instance). Keeping the first-arrived bare
    // erased the instance args wherever a declared pre-row met the
    // body's inferred instance (iterate_from's recursive self-call
    // unioned its bare pre-scheme Iterate over the parameterized one —
    // the fold-family element severance). Two parameterized instances
    // keep the first (the instance-precision residue,
    // parameterized-negation-instance).
    let held = list_index(buf, at)
    let upgraded = match (held, x) {
      (ENamed(_), EParameterized(_, _)) => list_set(buf, at, x),
      _ => buf,
    }
    name_set_dedup_into(names, i + 1, n, upgraded, count)
  } else {
    name_set_dedup_into(names, i + 1, n, list_set(buf, count, x), count + 1)
  }
}

// The index twin of name_set_prefix_contains: where in buf[0..count) does a
// same-named entry sit (-1 = absent). The dedup's upgrade needs the slot.
fn name_set_prefix_index(ref buf, count, ref name) with !Mutate =
  name_set_prefix_index_loop(buf, name, 0, count)

fn name_set_prefix_index_loop(ref buf, ref name, i, n) with Memory = if i >= n {
  0 - 1
} else if eff_name_handle(list_index(buf, i)) == eff_name_handle(name) {
  i
} else {
  name_set_prefix_index_loop(buf, name, i + 1, n)
}

// Membership against the WRITTEN PREFIX of a buffer under construction.
fn name_set_prefix_contains(ref buf, count, ref name) with !Mutate =
  name_set_prefix_contains_loop(buf, name, 0, count)

fn name_set_prefix_contains_loop(ref buf, ref name, i, n) with Memory = if i >= n {
  false
}
// By NAME, like the membership leaf (name_set_contains_loop) and the
// negation gate — this is the DEDUP twin (name_set_dedup_into), and it
// was still `==` (pointer-eq) after cc487f8 fixed membership, so two
// byte-equal ENamed from distinct sites still failed to dedup HERE, and
// rows kept bloating past the membership fix. The two must agree.
else if eff_name_handle(list_index(buf, i)) == eff_name_handle(name) {
  true
} else {
  name_set_prefix_contains_loop(buf, name, i + 1, n)
}

fn name_set_union(ref a, ref b) with Memory + Alloc = {
  let na = len(a)
  let nb = len(b)
  // Identity fast paths: X ∪ ∅ = canonical X (zero-alloc when X already is).
  if na == 0 {
    name_set_canonicalize(b)
  } else if nb == 0 {
    name_set_canonicalize(a)
  } else {
    let buf = make_list(na + nb)
    let ca = name_set_dedup_count(a, 0, na, buf, 0)
    name_set_union_rest(b, 0, nb, buf, ca)
  }
}

// Phase 1 of union: dedup a into the buffer, RETURN the raw (buf-mutating)
// count — the caller continues appending into the same buffer.
// The union loops share dedup_into's collision law: a same-named arrival
// UPGRADES a held bare to the parameterized instance (bare ∪ instance =
// instance) — one law at every dedup twin, or the instance args die on
// whichever accumulation path a bare reaches first.
fn name_set_dedup_count(ref names, i, n, own buf, count) with Memory + Alloc = if i >= n {
  count
} else {
  let x = list_index(names, i)
  let at = name_set_prefix_index(buf, count, x)
  if at >= 0 {
    let held = list_index(buf, at)
    let upgraded = match (held, x) {
      (ENamed(_), EParameterized(_, _)) => list_set(buf, at, x),
      _ => buf,
    }
    name_set_dedup_count(names, i + 1, n, upgraded, count)
  } else {
    name_set_dedup_count(names, i + 1, n, list_set(buf, count, x), count + 1)
  }
}

fn name_set_union_rest(ref b, i, n, own buf, count) with Memory + Alloc = if i >= n {
  slice(buf, 0, count)
} else {
  let x = list_index(b, i)
  let at = name_set_prefix_index(buf, count, x)
  if at >= 0 {
    let held = list_index(buf, at)
    let upgraded = match (held, x) {
      (ENamed(_), EParameterized(_, _)) => list_set(buf, at, x),
      _ => buf,
    }
    name_set_union_rest(b, i + 1, n, upgraded, count)
  } else {
    name_set_union_rest(b, i + 1, n, list_set(buf, count, x), count + 1)
  }
}

fn name_set_intersect(ref a, ref b) with Memory + Alloc = {
  let n = len(a)
  name_set_intersect_into(a, b, 0, n, make_list(n), 0)
}

fn name_set_intersect_into(ref a, ref b, i, n, own buf, count) with Memory + Alloc = if i >= n {
  slice(buf, 0, count)
} else {
  let x = list_index(a, i)
  if name_set_contains(b, x) {
    name_set_intersect_into(a, b, i + 1, n, list_set(buf, count, x), count + 1)
  } else {
    name_set_intersect_into(a, b, i + 1, n, buf, count)
  }
}

fn name_set_diff(ref a, ref b) with Memory + Alloc = {
  let n = len(a)
  // Identity fast paths: ∅ ∖ Y = ∅; X ∖ ∅ = canonical X (zero-alloc when
  // X already is — ef_make's absent-minus-present with empty present).
  if n == 0 {
    a
  } else if len(b) == 0 {
    name_set_canonicalize(a)
  } else {
    name_set_diff_into(a, b, 0, n, make_list(n), 0)
  }
}

fn name_set_diff_into(ref a, ref b, i, n, own buf, count) with Memory + Alloc = if i >= n {
  slice(buf, 0, count)
} else {
  let x = list_index(a, i)
  if name_set_contains(b, x) {
    name_set_diff_into(a, b, i + 1, n, buf, count)
  } else {
    name_set_diff_into(a, b, i + 1, n, list_set(buf, count, x), count + 1)
  }
}

fn name_set_subset(ref sub, ref sup) with Memory = name_set_subset_loop(sub, sup, 0, len(sub))

fn name_set_subset_loop(ref sub, ref sup, i, n) with Memory = if i >= n {
  true
} else if name_set_contains(sup, list_index(sub, i)) {
  name_set_subset_loop(sub, sup, i + 1, n)
} else {
  false
}

fn name_set_eq(ref a, ref b) with !Mutate =
  if len(a) != len(b) { false } else { name_set_subset(a, b) }

fn name_set_contains(ref set, ref name) with !Mutate =
  name_set_contains_loop(set, name, 0, len(set))

fn name_set_contains_loop(ref set, ref name, i, n) with Memory = if i >= n {
  false
}
// Match by NAME, exactly as the negation gate does (name_in_forbidden,
// forbidden_names_disjoint) — the value-layer `==` FLOORS to pointer-eq
// here because list_index erases the element to a word (the untyped list
// has no type to dispatch structural EffName equality on), and two
// byte-equal ENamed("Memory") minted at distinct source sites are
// distinct heap objects. The old `==` claimed pointer-eq was "adequate
// for dedup/subset where names are interned-identical" — MEASURED FALSE:
// it broke set-dedup, so ~422/598 self-compile rows carried duplicate
// names (Memory+Memory+Memory) whose open tail never closed and hit
// row_subsumes' `_ => false`. By-name identity across sites fixes dedup
// AND subset. (EffName-is-a-handle LANDED 2026-07-24 — the compare below
// IS i32.eq on eff_name_handle; this parenthetical's old future tense
// described its own present. The parameterized-instance residue rides
// Hβ.effects.parameterized-negation-instance.)
else if eff_name_handle(list_index(set, i)) == eff_name_handle(name) {
  true
} else {
  name_set_contains_loop(set, name, i + 1, n)
}
