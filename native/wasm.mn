// check: clean
// A WebAssembly module read from its bytes: the eight bytes it opens with,
// then each section's kind, place, size and count. The translator reads the
// module the compiler wrote, the one artifact every gate has judged (PLAN
// §11, "The order from 2026-11-12", N0).
//
// Reading bytes in order. `byte` answers the next one, `pass` moves over
// `count` bytes without reading them, `place` says how many bytes have been
// read so far, and `more` says whether any are left.
effect Source {
  byte() -> Int
  pass(count: Int)
  place() -> Int
  more() -> Bool
}

// Bytes read from the first: `left` holds the bytes not read yet, and `read`
// is the place of the next one in the file, which starts at `first` (0 for
// a whole file, a section's place for its body). A read past the last byte
// is the file's fault: the reader says where the bytes end and stops.
handler reading(bytes, first) with left = bytes, read = first {
  byte() => match left {
    [next, ...rest] => resume(next) with left = rest, read = read + 1,
    [] => fail("the module ends at byte {int_to_str(read)}, inside a section that says it is longer"),
  },
  pass(count) => resume() with left = after(count, read, left), read = read + count,
  place() => resume(read),
  more() => resume(len(left) > 0),
}

// The bytes left once `count` of them are passed over, cut off in one step.
// A count past the end of the file is the file's fault: `read` says where
// the reader stood when it was asked.
fn after(count, read, bytes) = if 0 <= count && count <= len(bytes) {
  slice(bytes, count, len(bytes))
} else {
  fail("at byte {int_to_str(read)} a section says {int_to_str(count)} more bytes follow, and the file has {int_to_str(len(bytes))}")
}

// A whole number written seven bits to a byte, lowest bits first. A byte
// under 128 is the number's last.
fn number() = {
  let b = byte()
  if b < 128 { b } else { b - 128 + 128 * number() }
}

// What a section holds. The file says it with one byte, 0 to 12.
type Kind
  = Custom
  | Types
  | Imports
  | Functions
  | Tables
  | Memories
  | Globals
  | Exports
  | Start
  | Elements
  | DataCount
  | Code
  | Data

fn kind_of(id) = match id {
  0 => Custom,
  1 => Types,
  2 => Imports,
  3 => Functions,
  4 => Tables,
  5 => Memories,
  6 => Globals,
  7 => Exports,
  8 => Start,
  9 => Elements,
  10 => Code,
  11 => Data,
  12 => DataCount,
  _ => fail("byte {int_to_str(place() - 1)} names section kind {int_to_str(id)}, and a module has kinds 0 to 12"),
}

// One section: its kind, the byte its body starts at, the body's size in
// bytes, and how many entries the body says it holds.
type Section = {at: Int, count: Int, kind: Kind, size: Int}

// How many entries a section's body says it holds. A section that is a list
// opens with its length. A start section names one function. A custom
// section is a name and bytes of its own, with no count.
fn entries(kind) = match kind {
  Custom => 0,
  Start => 1,
  Types | Imports | Functions | Tables | Memories | Globals | Exports | Elements | DataCount | Code
  | Data => number(),
}

// The next section: its kind and size are read, its count where it has one,
// and the rest of its body is passed over.
fn section() = {
  let kind = kind_of(byte())
  let size = number()
  let at = place()
  let count = entries(kind)
  pass(at + size - place())
  Section({at, count, kind, size})
}

// Every section left in the file, each handed on as it is read.
fn sections() = if more() {
  yield(section())
  sections()
} else {
  ()
}

// The eight bytes every module opens with: a zero byte, the letters "asm",
// and version 1 as four bytes.
fn header() = if [byte(), byte(), byte(), byte(), byte(), byte(), byte(), byte()] == [0, 97, 115, 109, 1, 0, 0, 0] {
  ()
} else {
  fail("this is not a WebAssembly module: it does not open with a zero byte, \"asm\" and version 1")
}

// A module's sections, in the file's order. A file shorter than the eight
// opening bytes is no module at all.
fn sections_of(bytes) = if len(bytes) < 8 {
  fail("this is not a WebAssembly module: it is {int_to_str(len(bytes))} bytes long, and a module opens with eight")
} else {
  {
    header()
    sections()
    result()
  } ~> collector ~> reading(bytes, 0)
}

// The kinds by the names `wasm-objdump -h` prints.
fn kind_name(kind) = match kind {
  Custom => "Custom",
  Types => "Type",
  Imports => "Import",
  Functions => "Function",
  Tables => "Table",
  Memories => "Memory",
  Globals => "Global",
  Exports => "Export",
  Start => "Start",
  Elements => "Elem",
  DataCount => "DataCount",
  Code => "Code",
  Data => "Data",
}

// A byte written as two hex digits after "0x", the way the WebAssembly
// reference writes an instruction's number.
fn hex_byte(b) = "0x" |> push(??, hex_nibble(b / 16 % 16)) |> push(??, hex_nibble(b % 16))

// The one section of a kind, read by `reader` from its first byte, so the
// places the reader names are the file's. A module without it is refused.
fn read_section(bytes, parts, kind, reader) = match find(is_kind(kind, ??), parts) {
  Some(s) => reader() ~> reading(body_of(bytes, s), s.at),
  None => fail("the module has no {kind_name(kind)} section"),
}

// Whether a module holds a section of a kind.
fn holds(parts, kind) = any(is_kind(kind, ??), parts)

// A whole number with a sign, written seven bits to a byte like `number`.
// The last byte's seventh bit is the sign.
fn signed() = {
  let b = byte()
  if b < 64 { b } else if b < 128 { b - 128 } else { b - 128 + 128 * signed() }
}

// A list as the file writes one: its length, then that many items, each
// read by `item`.
fn listed(item) = {
  items(number(), item)
  result()
} ~> collector

fn items(left, item) = if left > 0 {
  yield(item())
  items(left - 1, item)
} else {
  ()
}

// The bytes of a section's body, cut out of the file's. A section that says
// it stands outside the file is the file's fault.
fn body_of(bytes, s: Section) = {
  let from = s.at
  let to = from + s.size
  if 0 <= from && from <= to && to <= len(bytes) {
    slice(bytes, from, to)
  } else {
    fail("a section says it stands at bytes {int_to_str(from)} to {int_to_str(to)}, and the file has {int_to_str(len(bytes))}")
  }
}

fn is_kind(kind, s: Section) = s.kind == kind

// A function's shape: how many values it takes and how many it answers.
// The translator takes 32-bit whole numbers and no other kind of value yet.
fn shape() = if byte() == 0x60 {
  (len(listed(whole_number)), len(listed(whole_number)))
} else {
  fail("byte {int_to_str(place() - 1)}: a function's shape opens with the byte 0x60")
}

fn whole_number() = if byte() == 0x7F {
  ()
} else {
  fail("byte {int_to_str(place() - 1)}: a value that is no 32-bit whole number, which the translator does not take yet")
}

// One export: its name's bytes, what kind of thing it is (0 for a
// function), and that thing's number.
fn export() = (listed(byte), byte(), number())
