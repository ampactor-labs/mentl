// expect: 0
// The reader's answer for a module written out here byte by byte: one
// function that takes nothing and answers 42, exported as "main". It has
// four sections, and the reader must say each one's kind, where its body
// starts, its size and its count. `wasm-objdump -h` says the same of these
// 37 bytes.
import io

import wasm

// The eight opening bytes, then four sections, each a kind, a size and a
// body: one type (a function from nothing to a 32-bit integer), one
// function of that type, one export (the name "main" for function 0), and
// one body of four bytes (no locals, the constant 42, the end).
fn small_module() =
  [0, 97, 115, 109, 1, 0, 0, 0] ++ [1, 5, 1, 96, 0, 1, 127] ++ [3, 2, 1, 0] ++ [7, 8, 1, 4, 109, 97, 105, 110, 0, 0] ++ [10, 6, 1, 4, 0, 65, 42, 11]

fn expected() = [
  Section({at: 10, count: 1, kind: Types, size: 5}),
  Section({at: 17, count: 1, kind: Functions, size: 2}),
  Section({at: 21, count: 1, kind: Exports, size: 8}),
  Section({at: 31, count: 1, kind: Code, size: 6})
]

fn main() = {
  if sections_of(small_module()) == expected() { 0 } else { 1 }
} ~> fail_exit
