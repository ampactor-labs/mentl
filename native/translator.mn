// check: clean
// The translator from a WebAssembly module to the Daisy Seed's processor:
// it takes whole numbers, locals, blocks, loops, branches and calls (PLAN
// §11, "The order from 2026-11-12", N0), and refuses anything else, naming
// the byte. `native/translate.mn` is the program that runs it.
import thumb

import wasm

// The registers the translated code keeps to. The top value a function
// holds is in `top`, and the ones under it are on the stack. `under` and
// `spare` hold a value for one instruction. `frame` points at the
// function's locals.
let top = 0

let under = 1

let spare = 2

let frame = 7

// What the translator knows of the whole module while it reads one
// function: the shape of the function with a number.
effect Shapes {
  shape_of(number: Int) -> (Int, Int)
}

// `shapes` holds each shape the module declares, and `kinds` the number of
// the shape each function has.
handler shaped(shapes, kinds) {
  shape_of(number) => resume(nth_of(shapes, nth_of(kinds, number))),
}

fn nth_of(items, n) = match items {
  [first, ...rest] => if n == 0 { first } else { nth_of(rest, n - 1) },
  [] => fail("the module names a function or a shape it does not declare"),
}

// What the translator knows of the function it is reading. `held` is how
// many values the function holds at this point, and `hold` sets it. `live`
// says whether the chip can reach this point, `leave` says it cannot reach
// what follows, and `arrive` says a block has ended, so it is reached again
// and holds that many. `local_at` says how many words above the frame a
// local stands.
effect Frame {
  held() -> Int
  hold(count: Int)
  live() -> Bool
  leave()
  arrive(count: Int)
  local_at(index: Int) -> Int
}

// A function that takes `takes` values and declares `extra` locals of its
// own. From the frame upward stand its own locals, the last one lowest,
// then the caller's frame and the way back, then what it takes, the last
// one lowest.
handler function_frame(takes, extra) with holding = 0, reached = true {
  held() => resume(holding),
  hold(count) => resume() with holding = count,
  live() => resume(reached),
  leave() => resume() with reached = false,
  arrive(count) => resume() with holding = count, reached = true,
  local_at(index) => resume(if index < takes { extra + 1 + takes - index } else { extra + takes - 1 - index }),
}

// A place a branch can go: how many values the function held where the
// block began, how many of the top values a branch to it keeps, and how
// many loops and blocks of the program's lines stand around it.
type Label = {height: Int, keeps: Int, level: Int}

fn label_at(labels, out) = match labels {
  [first, ...rest] => if out == 0 { first } else { label_at(rest, out - 1) },
  [] => fail("byte {int_to_str(place() - 1)}: a branch names a block that is not around it"),
}

// How a run of instructions ended: at its end instruction, or at the else of
// an if.
type Close = Ended | Elsed

fn line(l) = yield(l)

fn put_lines(ls) = ls |> each(line)

// A value arrives on top: the old top, where there is one, goes to the
// stack.
fn make_room() = {
  if held() > 0 { line(push_reg(top)) } else { () }
  hold(held() + 1)
}

// The top value has been used: the one under it, where there is one, comes
// up from the stack.
fn top_used() = {
  hold(held() - 1)
  if held() > 0 { line(pop_reg(top)) } else { () }
}

// Two values in, one out: the second is on top and the first comes off the
// stack into `under`. The instructions leave their answer on top.
fn two_to_one(ls) = {
  line(pop_reg(under))
  put_lines(ls)
  hold(held() - 1)
}

// That many words leave the stack.
fn released(words) = if words <= 0 {
  []
} else if words <= 127 {
  [drop_words(words)]
} else {
  [drop_words(127)] ++ released(words - 127)
}

// The instructions that read and write a local `words` words above the
// frame.
fn local_read(words) = if 0 <= words && words <= 31 {
  load_word(top, frame, words)
} else if 0 <= words && words <= 1023 {
  load_far(top, frame, words)
} else {
  fail("a function has more than 1,000 locals, which the translator does not take")
}

fn local_write(words) = if 0 <= words && words <= 31 {
  store_word(top, frame, words)
} else if 0 <= words && words <= 1023 {
  store_far(top, frame, words)
} else {
  fail("a function has more than 1,000 locals, which the translator does not take")
}

// A constant on top, in the shortest instruction that holds it.
fn constant(k) = if 0 <= k && k <= 255 {
  [move_byte(top, k)]
} else if 0 <= k && k <= 65535 {
  [wide_move(0xF240, top, k)]
} else {
  set_word(top, k)
}

// 1 on top where the last comparison stands as `cond` says, and 0 where it
// does not.
fn truth(cond) = [either(cond), move_byte(top, 1), move_byte(top, 0)]

// A shift counts its bits modulo 32, so the count is cut to five bits
// first. The answer is made in `under` and copied to the top.
fn shifted(by) = [move_byte(spare, 31), and_into(top, spare), by, shift_left(top, under, 0)]

// A division stops the program where the divisor is zero.
let zero_stops = [compare_byte(top, 0), StopIf(Equal)]

// A division with a sign also stops where the least number is divided by
// -1, since the answer is no 32-bit number.
fn overflow_stops() = block_of([
  add_small(spare, top, 1),
  Jump(NotEqual, 0),
  move_byte(spare, 1),
  shift_left(spare, spare, 31),
  compare_regs(under, spare),
  StopIf(Equal)
])

// The condition a comparison instruction asks about.
fn asked(op) = match op {
  0x46 => Equal,
  0x47 => NotEqual,
  0x48 => Less,
  0x49 => Below,
  0x4A => Greater,
  0x4B => Above,
  0x4C => LessEqual,
  0x4D => BelowEqual,
  0x4E => GreaterEqual,
  0x4F => AboveEqual,
  _ => fail("byte {int_to_str(place() - 1)}: instruction {hex_byte(op)} is no comparison"),
}

// The instructions for arithmetic on two values, the first in `under` and
// the second on top.
fn arithmetic(op) = match op {
  0x6A => [add_regs(top, under, top)],
  0x6B => [subtract_regs(top, under, top)],
  0x6C => [multiply_into(top, under)],
  0x6D => zero_stops ++ [overflow_stops(), divide(top, under, top)],
  0x6E => zero_stops ++ [divide_unsigned(top, under, top)],
  0x6F => zero_stops ++ [divide(spare, under, top), multiply_subtract(top, spare, top, under)],
  0x70 => zero_stops ++ [divide_unsigned(spare, under, top), multiply_subtract(top, spare, top, under)],
  0x71 => [and_into(top, under)],
  0x72 => [or_into(top, under)],
  0x73 => [xor_into(top, under)],
  0x74 => shifted(shift_left_by(under, top)),
  0x75 => shifted(shift_right_signed_by(under, top)),
  0x76 => shifted(shift_right_by(under, top)),
  _ => fail("byte {int_to_str(place() - 1)}: instruction {hex_byte(op)} is one the translator does not take yet"),
}

// What a block answers: nothing (0x40) or one whole number (0x7F).
fn answers() = match byte() {
  0x40 => 0,
  0x7F => 1,
  _ => fail("byte {int_to_str(place() - 1)}: a block that answers anything but nothing or one whole number, which the translator does not take yet"),
}

// What a branch drops on its way to a label. The function holds `from`
// values where the branch stands. A label that keeps the top value leaves
// it on top and drops what lies between. A label that keeps none drops
// down to the values held where its block began, and brings the top one of
// those up.
fn unwound(label: Label, from) = if label.keeps == 1 {
  released(from - label.height - 1)
} else if from <= label.height {
  []
} else if label.height == 0 {
  released(from - 1)
} else {
  released(from - label.height - 1) ++ [pop_reg(top)]
}

// The lines of a run of instructions and how it ended.
fn run(labels, level) = {
  let close = instructions(labels, level)
  (close, result())
} ~> collector

// Instructions are read and translated up to the end or else instruction
// that closes them. After one that always leaves, the rest are passed over.
fn instructions(labels, level) = match byte() {
  0x0B => Ended,
  0x05 => Elsed,
  op => {
    instruction(op, labels, level)
    if live() { instructions(labels, level) } else { passed_over(0) }
  },
}

// Instructions the chip never reaches are read only to find where their
// block closes. `inside` counts the blocks opened among them.
fn passed_over(inside) = match byte() {
  0x0B => if inside == 0 { Ended } else { passed_over(inside - 1) },
  0x05 => if inside == 0 { Elsed } else { passed_over(inside) },
  op => passed_over(inside + operands_passed(op)),
}

// One instruction's operands are read past. The answer is 1 where the
// instruction opens a block and 0 where it does not.
fn operands_passed(op) = if op == 0x02 || op == 0x03 || op == 0x04 {
  byte()
  1
} else if op == 0x0C || op == 0x0D || op == 0x10 || 0x20 <= op && op <= 0x22 {
  number()
  0
} else if op == 0x41 {
  signed()
  0
} else if op <= 0x01 || op == 0x0F || op == 0x1A || op == 0x1B || 0x45 <= op && op <= 0x4F || 0x6A <= op && op <= 0x76 {
  0
} else {
  fail("byte {int_to_str(place() - 1)}: instruction {hex_byte(op)} is one the translator does not take yet")
}

// One instruction.
fn instruction(op, labels, level) = if 0x46 <= op && op <= 0x4F {
  two_to_one([compare_regs(under, top)] ++ truth(asked(op)))
} else if 0x6A <= op && op <= 0x76 {
  two_to_one(arithmetic(op))
} else {
  match op {
    // unreachable: the program stops
    0x00 => {
      line(StopIf(Always))
      leave()
    },
    // nop
    0x01 => (),
    0x02 => block(labels, level),
    0x03 => looped(labels, level),
    0x04 => branched(labels, level),
    // br: the branch is always taken
    0x0C => {
      let label = label_at(labels, number())
      put_lines(unwound(label, held()) ++ [Jump(Always, level - 1 - label.level)])
      leave()
    },
    0x0D => branch_if(label_at(labels, number()), level),
    // return: the function's own block is the outermost one
    0x0F => {
      line(Jump(Always, level - 1))
      leave()
    },
    0x10 => call(number()),
    // drop
    0x1A => top_used(),
    // select: the first of two values where the top is not zero
    0x1B => {
      put_lines([
        pop_reg(under),
        pop_reg(spare),
        compare_byte(top, 0),
        either(NotEqual),
        copy_reg(top, spare),
        copy_reg(top, under)
      ])
      hold(held() - 2)
    },
    // local.get, local.set and local.tee
    0x20 => {
      make_room()
      line(local_read(local_at(number())))
    },
    0x21 => {
      line(local_write(local_at(number())))
      top_used()
    },
    0x22 => line(local_write(local_at(number()))),
    // i32.const
    0x41 => {
      make_room()
      put_lines(constant(signed()))
    },
    // i32.eqz
    0x45 => put_lines([compare_byte(top, 0)] ++ truth(Equal)),
    _ => fail("byte {int_to_str(place() - 1)}: instruction {hex_byte(op)} is one the translator does not take yet"),
  }
}

// A block: a branch to it goes past its end.
fn block(labels, level) = {
  let label = Label({height: held(), keeps: answers(), level})
  let (_, inner) = run([label] ++ labels, level + 1)
  line(block_of(inner))
  arrive(label.height + label.keeps)
}

// A loop: a branch to it goes to its start and keeps nothing.
fn looped(labels, level) = {
  let after = answers()
  let label = Label({height: held(), keeps: 0, level})
  let (_, inner) = run([label] ++ labels, level + 1)
  line(loop_of(inner))
  arrive(label.height + after)
}

// An if: the top value is tested and used. The first run stands inside two
// blocks, the inner one left where the value was zero and the outer one
// left at the run's end, so the second run stands inside one.
fn branched(labels, level) = {
  let keeps = answers()
  line(compare_byte(top, 0))
  top_used()
  let label = Label({height: held(), keeps, level})
  let (close, first) = run([label] ++ labels, level + 2)
  let second = match close {
    Elsed => {
      arrive(label.height)
      match run([label] ++ labels, level + 1) {
        (_, inner) => inner,
      }
    },
    Ended => [],
  }
  line(block_of([block_of([Jump(Equal, 0)] ++ first ++ [Jump(Always, 1)])] ++ second))
  arrive(label.height + keeps)
}

// A branch taken where the top value is not zero. Where the branch must
// drop values on its way, it does so inside a small block that is left
// where the value was zero.
fn branch_if(label: Label, level) = {
  line(compare_byte(top, 0))
  top_used()
  let dropped = unwound(label, held())
  if len(dropped) == 0 {
    line(Jump(NotEqual, level - 1 - label.level))
  } else {
    line(block_of([Jump(Equal, 0)] ++ dropped ++ [Jump(Always, level - label.level)]))
  }
}

// A call: every value the caller holds goes to the stack, the callee takes
// its own off, and its answer, where it gives one, comes back on top.
fn call(number) = {
  let (takes, gives) = shape_of(number)
  if held() > 0 { line(push_reg(top)) } else { () }
  line(Call(number))
  hold(held() - takes + gives)
  if gives == 0 && held() > 0 { line(pop_reg(top)) } else { () }
}

// A group of locals: how many, all of them whole numbers.
fn local_group() = {
  let count = number()
  whole_number()
  count
}

// One function. It keeps the caller's frame and the way back, puts a zero
// on the stack for each local of its own, and marks its frame. Its
// instructions stand in one block, which a return instruction leaves. Then
// the stack goes back to the frame, the locals leave it, the caller's frame
// comes back, the way back comes off into `under`, what the function took
// leaves the stack, and it returns.
fn function(index) = {
  let (takes, gives) = shape_of(index)
  number()
  let extra = sum(listed(local_group))
  let (_, inner) = run([Label({height: 0, keeps: gives, level: 0})], 1) ~> function_frame(takes, extra)
  [save_frame, move_byte(under, 0)] ++ repeat(extra, push_reg(under)) ++ [mark_frame, block_of(inner), stack_to_frame] ++ released(extra) ++ [pop_reg(frame), pop_reg(under)] ++ released(takes) ++ [return_through_one]
}

// The functions of a code section, each with its number.
fn functions_from(number, left) = if left > 0 {
  yield(function(number))
  functions_from(number + 1, left - 1)
} else {
  ()
}

fn functions() = {
  functions_from(0, number())
  result()
} ~> collector

// The number of the function a module exports as "main".
fn main_of(exports) = match find(is_main, exports) {
  Some((_, _, number)) => number,
  None => fail("the module exports no function named main"),
}

fn is_main(export) = match export {
  (name, kind, _) => kind == 0 && name == [109, 97, 105, 110],
}

// The program starts by calling the module's main and asking the system to
// end it with what main answered (call 1, the answer already on top). The
// stop does the same with 134, the exit of a program that trapped.
fn start(main) = [Call(main), move_byte(frame, 1), system_call]

let stop = [move_byte(top, 134), move_byte(frame, 1), system_call]

// Where each function starts, given where the first one does.
fn starts(at, bodies) = match bodies {
  [first, ...rest] => [at] ++ starts(at + size_of(first), rest),
  [] => [],
}

// The whole program for a module's bytes, as the halves the chip reads: the
// start, the stop, then every function in the order of its number.
fn program(bytes) = {
  let parts = sections_of(bytes)
  if holds(parts, Imports) {
    fail("the module imports something, which the translator does not take yet")
  } else {
    ()
  }
  let shapes = read_section(bytes, parts, Types, () => listed(shape))
  let kinds = read_section(bytes, parts, Functions, () => listed(number))
  let main = main_of(read_section(bytes, parts, Exports, () => listed(export)))
  let bodies = read_section(bytes, parts, Code, () => functions() ~> shaped(shapes, kinds))
  let opening = start(main)
  let first_at = size_of(opening) + size_of(stop)
  opening ++ stop ++ flatten(bodies) |> halves_of ~> placed(starts(first_at, bodies), size_of(opening))
}
