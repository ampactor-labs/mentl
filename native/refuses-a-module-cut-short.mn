// expect: 1
// A module whose last section says it is longer than the file is refused:
// the reader says where it stood and how many bytes are missing, and the
// program stops with exit 1. Here the code section says six bytes follow
// and two do.
import io

import wasm

fn cut_short() =
  [0, 97, 115, 109, 1, 0, 0, 0] ++ [1, 5, 1, 96, 0, 1, 127] ++ [3, 2, 1, 0] ++ [10, 6, 1, 4]

fn main() = {
  len(sections_of(cut_short()))
} ~> fail_exit
