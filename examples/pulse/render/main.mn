// Pulse · scene 1 — the offline renderer
//
// Ten seconds of music, rendered sample by sample into a WAV file on
// standard output:
//
//   mentl run examples/pulse/render/main.mn > pulse.wav
//
// This is the first program written in Mentl that is not the compiler. It
// exists to be READ as much as heard, so every stage below says what it is
// in the words of the domain, and the medium's own claims sit where a
// listener would ask about them. Its instruments are the library's — the
// oscillators (lib/dsp/osc.mn), the envelopes (lib/dsp/envelope.mn), the
// filters (lib/dsp/feedback.mn), the echo, the rooms, the panning and the
// limiter (lib/dsp/stereo.mn) — and the course beside it
// (examples/pulse/course) teaches each in turn. Four of the medium's claims
// are the reason the program exists at all:
//
//   1. THE PER-SAMPLE PATH CANNOT ALLOCATE. `render_frame` — everything
//      that runs once per sample — is declared `!Alloc`, and the medium
//      proves it transitively: the oscillators, the noise, the filters, the
//      distortion handler's arms, both echoes, both rooms of reverb, the
//      limiter, and the PCM writes into a buffer sized before the first
//      frame. Add one allocation anywhere beneath that signature and the
//      program does not build (the frontier board keeps that twin
//      refusing).
//
//   2. THE SIGNAL CARRIES ITS BOUNDS AS TYPES. A `Sample` is a Float the
//      unit range bounds, an `Hz` a frequency below Nyquist, a `Decay` a
//      feedback gain under unity; a constant that breaks one is refused at
//      the line that wrote it. The WAV writer takes only `Sample`s, so the
//      file cannot hold a value the type did not bound.
//
//   3. SOUND HAS MEMORY, AND MEMORY IS A SHAPE YOU DRAW. An oscillator's
//      phase, a filter's last output, a quarter-second of echo, a room's
//      eight comb lines — each is the `<~` verb, a loop in the graph, its
//      line owned by the closure that holds it. Two filters minted from one
//      maker are two filters; two echoes are two rooms.
//
//   4. ONE RATE. The clock is the `Sample(48_000)` effect, pinned at the
//      three functions that read it, and the per-sample path declares
//      `!Sample(44_100)`: a stage written for 44.1 kHz cannot be reached
//      from it — two rates are two effects, and the mismatch refuses at
//      compile time. The handler at the root answers whichever instance
//      asks (an install cannot yet pin the instance it serves), so the
//      negation is where the rule is written.
import io

import audio/wav

import dsp/clock

import dsp/envelope

import dsp/feedback

import dsp/osc

import dsp/signal

import dsp/spectral

import dsp/stereo

import math

// ─── The score ────────────────────────────────────────────────────────
//
// Eight notes over ten seconds — an A-minor line that rises to the fifth
// and falls back to the third, a bass that moves once every two notes
// (A, F, C, G), a kick on every beat, a snare on the off-beats and a
// hi-hat on every eighth. The length is the program's
// one authored duration; every other time derives from it and the rate the
// clock answers.
fn seconds() with Pure = 10

fn notes_in_score() with Pure = 8

fn hats_per_note() with Pure = 4

fn beats_per_note() with Pure = 2

// The lead's pitch for note `k`. Every arm is a literal, so the `Hz` claim
// is decided where it is written — the compiler knows 440.0 is under the
// ceiling, and no check runs while the piece plays.
fn note_hz(k: Int) -> Hz = match k {
  0 => 220.0,
  1 => 261.63,
  2 => 329.63,
  3 => 440.0,
  4 => 392.0,
  5 => 329.63,
  6 => 293.66,
  _ => 261.63,
}

// The bass's pitch, one step per two lead notes: A1, F1, C2, G1.
fn bass_hz(k: Int) -> Hz = match k / 2 {
  0 => 55.0,
  1 => 43.65,
  2 => 65.41,
  _ => 49.0,
}

// ─── The clock ────────────────────────────────────────────────────────
//
// The program runs at 48,000 samples a second, and the rate is pinned
// HERE, at the three readers of the clock: `Sample(48_000)` on each says
// which instance of the Sample effect the piece performs, and every
// function that calls them carries that instance in its projected row
// without writing it down.
fn clock_rate() with Sample(48000) = sample_rate()

fn now() with Sample(48000) = current_sample()

fn advance() with Sample(48000) = advance_sample()

// How many frames one note lasts — read off the rate the installed clock
// answers, never a constant of its own.
fn frames_per_note() = clock_rate() * seconds() / notes_in_score()

fn frames_per_hat() = frames_per_note() / hats_per_note()

fn frames_per_beat() = frames_per_note() / beats_per_note()

// ─── Envelopes — the shape of a note in time ──────────────────────────
//
// The lead swells in and rings; the bass plucks and holds lower. Both are
// the library's ADSR with the note's own time last, so a note's time pipes
// into its shape.
fn lead_shape(len: Float, tn: Float) -> Float with Pure = adsr(0.01, 0.2, 0.65, 0.3, len, tn)

fn bass_shape(len: Float, tn: Float) -> Float with Pure = adsr(0.005, 0.25, 0.5, 0.08, len, tn)

// A hi-hat is struck and gone: an exponential fall with a 35 ms time
// constant from each eighth's onset, the off-beats accented.
fn hat_shape(th: Float, index: Int) -> Float with Pure = {
  let accent = if index % 2 == 1 { 1.0 } else { 0.55 }
  accent * fade(0.035, th)
}

// A snare answers on the off-beats: a crack of noise over a 185 Hz body,
// gone in about a tenth of a second.
fn snare_level(tb: Float, beat: Int) -> Float with Pure =
  if beat % 2 == 1 { fade(0.12, tb) } else { 0.0 }

// ─── The sweep ────────────────────────────────────────────────────────
//
// The lead's filter opens and closes between 200 Hz and 1.6 kHz once every
// five seconds. The result is claimed `Hz` HERE, where the value is made,
// so the filters below receive a frequency the type bounds. The claim rests
// on the sine's range and the compiler's Float arithmetic, which the proof
// engine cannot yet bound — it is the program's one open obligation of its
// own, and the compile says so every time instead of assuming it.
fn cutoff_at(t: Float) -> Hz with Pure = 900.0 + 700.0 * sin(two_pi() * 0.2 * t)

// The vibrato: five and a half wobbles per second, four tenths of a percent
// deep — enough to hear the voice breathe, not enough to hear it as pitch.
fn vibrato_at(t: Float) -> Float with Pure = 0.004 * sin(two_pi() * 5.5 * t)

// One channel of the output: the dry signal and its echo blended
// (lib/dsp/signal.mn's `mix`), the room under it, the limiter's gain, and
// the soft clip that lands every sample strictly inside the unit range —
// which is what the WAV writer's `Sample` parameters demand.
fn channel(dry: Float, echo: Float, room: Float, gain: Float) -> Sample with Pure =
  soft_clip(gain * (mix(0.35, echo, dry) + 0.3 * room))

// ─── The rig — every stateful stage, built once ───────────────────────
//
// Everything with memory is made here, before a sample renders, and the
// render loop only reads and writes what it was given: three oscillators
// for the lead, one for the bass and its filter, the kick's sine, the noise
// and the two filters that make it a hat and a snare, the snare's body, the
// swept filter per channel, an echo and a room per channel, and the
// limiter. The record is the instrument; the loop plays it. The right echo
// feeds back harder than the left, so the image opens as each note rings
// out.
fn build_rig(sr: Int) = {
  bass: square_voice(sr),
  bass_tone: lowpass_filter(sr),
  echo_l: echo(0.35),
  echo_r: echo(0.5),
  hat_tone: highpass_filter(sr),
  hiss: noise_source(),
  kick: sine_voice(sr),
  lead_a: saw_voice(sr),
  lead_b: saw_voice(sr),
  limiter: limiter(0.9, sr),
  room_l: room_left(),
  room_r: room_right(),
  snare_body: sine_voice(sr),
  snare_tone: highpass_filter(sr),
  sub: sine_voice(sr),
  sweep_l: lowpass_filter(sr),
  sweep_r: lowpass_filter(sr),
}

// ─── The per-sample path ──────────────────────────────────────────────
//
// Everything that happens once per sample, in one function, under one
// signature: `!Alloc` is the oath — read it as "cannot allocate", not
// "does not", not "was tested and didn't" — and `!Sample(44_100)` the
// rate. The rest of the row — the pinned clock, the Distort effect, the
// Memory writes — is inferred and projected at the address surface; only
// the decisions are written.
//
// The frame index and the time come from the clock the root installed:
// `now()` is how far the piece has played, `clock_rate()` how fast, and
// `advance()` at the end is the tick. The program never keeps its own copy
// of any of the three.
fn render_frame(buf, rig) with !Alloc + !Sample(44100) = {
  let n = now()
  let sr = float_of_int(clock_rate())
  let t = float_of_int(n) / sr
  let per_note = frames_per_note()
  let len = float_of_int(per_note) / sr
  let k = n / per_note
  let tn = float_of_int(n - k * per_note) / sr
  let hat = n / frames_per_hat()
  let th = float_of_int(n - hat * frames_per_hat()) / sr
  let beat = n / frames_per_beat()
  let tb = float_of_int(n - beat * frames_per_beat()) / sr
  // The lead: two sawtooths a hair apart — the second three tenths of a
  // percent sharp, which the ear hears as width, not as a second note —
  // and a sine an octave down, under one envelope, then the distortion.
  let f = note_hz(k) * (1.0 + vibrato_at(t))
  let voiced = (rig.lead_a(f) + rig.lead_b(f * 1.003) + 0.6 * rig.sub(f * 0.5)) / 2.6
  // The distortion is an EFFECT: `distort` asks whatever handler the root
  // installed to shape the sample. Here that is the spectral-flux
  // distortion (lib/dsp/spectral.mn), whose transfer function follows the
  // signal's transients — warm on sustain, folded on attack. Swap the
  // handler at the root and this line does not change.
  let lead = distort(voiced * lead_shape(len, tn), 2.5)
  // The bass through its own low-pass — one filter of the library's, its
  // memory its own.
  let bass = rig.bass(bass_hz(k)) * bass_shape(len, tn) |> rig.bass_tone(320.0)
  // The drums. One noise source fans to two high-passes (`<|`): at 7 kHz it
  // is a hi-hat, at 1.8 kHz over a sine body it is a snare. The kick is a
  // sine voice driven by a pitch that falls from 150 Hz toward 45 Hz as it
  // dies, its level falling over 180 ms, struck on every beat.
  let noise = rig.hiss()
  let (hats, hiss_band) = noise <| ({ v => v * hat_shape(th, hat) |> rig.hat_tone(7000.0) }, rig.snare_tone(1800.0))
  let snare = (0.7 * hiss_band + 0.5 * rig.snare_body(185.0)) * snare_level(tb, beat)
  let kick = rig.kick(fall(45.0, 150.0, 0.04, tb)) * fade(0.18, tb)
  let drums = 0.9 * kick + 0.35 * snare
  // Placement: the lead a little left, the bass and the drums centred, the
  // hats right. The swept filter runs per channel — two filters, one maker
  // — over the tonal voices, the two channels a stereo pair (`><`); the
  // drums bypass it.
  let cutoff = cutoff_at(t)
  let (tone_l, tone_r) = (lead * pan_left(-0.2) + 0.8 * bass * pan_left(0.0) |> rig.sweep_l(cutoff))
      ><
  (lead * pan_right(-0.2) + 0.8 * bass * pan_right(0.0) |> rig.sweep_r(cutoff))
  let dry_l = tone_l + drums * pan_left(0.0) + 0.3 * hats * pan_left(0.6)
  let dry_r = tone_r + drums * pan_right(0.0) + 0.3 * hats * pan_right(0.6)
  // Each channel fans to its echo and its room (`<|`).
  let (echo_l, room_l) = dry_l <| (rig.echo_l, rig.room_l)
  let (echo_r, room_r) = dry_r <| (rig.echo_r, rig.room_r)
  let gain = rig.limiter(dry_l + room_l, dry_r + room_r)
  wav_frame(buf, n, channel(dry_l, echo_l, room_l, gain), channel(dry_r, echo_r, room_r, gain))
  advance()
}

// The render loop: one frame per tick until the clock reaches the end of
// the piece. Tail-recursive, so it is a loop in the emitted code, and it
// carries the same oath as the frame it calls.
fn render_loop(buf, total: Int, rig) with !Alloc + !Sample(44100) = if now() >= total {
  ()
} else {
  render_frame(buf, rig)
  render_loop(buf, total, rig)
}

// ─── The root — where the memory is built and the handlers are installed ──
//
// The handlers go up first — the console the finished file is printed to,
// the distortion the chain will ask, and the clock at 48,000 samples a
// second — and everything else happens inside them: the WAV buffer is
// sized for the whole piece from the rate the clock answers, the rig is
// built, and the loop runs. When it returns, the buffer IS the file, and
// it goes to standard output as the byte sequence it is.
fn main() = {
  {
    let rate = clock_rate()
    let frames = rate * seconds()
    let buf = wav_header(wav_alloc(frames), frames, rate)
    render_loop(buf, frames, build_rig(rate))
    print(wav_bytes(buf))
  } ~> stdout_console ~> spectral_flux_distort ~> sample_at(48000)
  0
}
