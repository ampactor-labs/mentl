// 09 · learn: a filter that learns, using the derivative effect
//
// A sawtooth through two filters, three seconds long: on the left the
// library's low-pass at 600 Hz, on the right a one-pole whose coefficient
// starts at zero and learns, sample by sample, to match the left.
//
//   mentl run examples/pulse/course/09-learn.mn > 09.wav
//
// This lesson's operator is `~>` again, with a different kind of handler:
// `~> grad(a)` is a derivative reading of the code it covers
// (lib/ml/grad.mn). The body of `slope` computes the filter's error exactly
// as the filter computes it, and `d(e * e)` requests the derivative of that
// squared error with respect to the coefficient the reading is seeded at.
// The medium derives the derivative program from the chain's own graph and
// emits it beside the forward one. No tape records the run, no operator is
// overloaded, and no second copy of the chain exists to fall out of step.
// The coefficient is a `<~` line inside the filter's own line, moved against
// the slope each tick, so the learning step reads as the calculus it
// performs, and the frame stays `!Alloc`: nothing is allocated while it learns.
//
//   mentl examples/pulse/course/09-learn.mn:44    the derivative request, and the handler that serves it
import audio/wav

import dsp/clock

import dsp/feedback

import dsp/osc

import dsp/signal

import io

import ml/grad

import rate

fn seconds() with Pure = 3

// The slope of the squared error with respect to the coefficient, computed
// from the same arithmetic the filter runs.
fn slope(a, x, yprev, want) = {
  let e = want - (a * x + (1.0 - a) * yprev)
  d(e * e)
} ~> grad(a)

// A one-pole low-pass whose coefficient learns: each tick, the coefficient
// line moves against the slope of the error between this filter and the
// signal it is set to match, then the output line ticks with the new
// coefficient.
fn learner(mu) = {
  fn stage(want, x) with !Alloc = {
    prev => {
      let a = { aprev => aprev - mu * slope(aprev, x, prev, want) } <~ delay(1)
      a * x + (1.0 - a) * prev
    },
  } <~ delay(1)
  stage
}

fn frame(buf, rig, n) with !Alloc = {
  let saw = rig.voice(220.0) * 0.5
  let want = saw |> rig.teacher(600.0)
  let got = rig.learner(want, saw)
  wav_frame(buf, n, soft_clip(want), soft_clip(got))
}

fn build_rig(sr) = {learner: learner(0.05), teacher: lowpass_filter(sr), voice: saw_voice(sr)}

fn main() = {
  {
    let frames = frames_of(seconds())
    let buf = wav_header(wav_alloc(frames), frames, rate())
    play(frames, frame(buf, build_rig(rate())))
    print(wav_bytes(buf))
  } ~> stdout_console ~> sample_at(48000)
  0
}
