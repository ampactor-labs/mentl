// 02 · line: memory in a signal chain, written as a feedback loop
//
// A sawtooth at 220 Hz through a low-pass filter, the left channel dark and
// the right bright, three seconds long.
//
//   mentl run examples/pulse/course/02-line.mn > 02.wav
//
// This lesson's operator is `<~`: a cycle in the graph. A one-pole low-pass
// is y[n] = a·x[n] + (1 − a)·y[n−1], and `one_pole` below writes exactly
// that: the body computes this sample from the input and from the prior it
// binds, which is the output one sample ago. `delay(1)` is the depth of the
// memory the cycle reads. The medium allocates this memory, called a line,
// once, when the closure that owns it is created, so the stage is `!Alloc`
// and a tick is a load, a store and an increment. Two filters made by one
// maker have two separate lines: `rig.dark` and `rig.bright` below each store
// their own last output, which is why one sawtooth can come out in two
// colours. The sawtooth is a line too: its phase, which wraps at 1.0
// (lib/dsp/osc.mn). Put the cursor on the cycle:
//
//   mentl examples/pulse/course/02-line.mn:44    the aspects at `<~`: the line, its depth, its owner
import audio/wav

import dsp/clock

import dsp/feedback

import dsp/osc

import dsp/signal

import io

import rate

fn seconds() with Pure = 3

// The one-pole low-pass, written out in full. The cutoff arrives with every
// sample, so the filter can sweep, and α is computed from it each time
// (lib/dsp/feedback.mn's `compute_alpha`). The signal is the stage's last
// parameter, so `x |> lp(cutoff)` filters x.
fn one_pole(sr) = {
  fn stage(cutoff: Hz, x) with !Alloc = {
    let a = compute_alpha(cutoff, sr)
    { prev => a * x + (1.0 - a) * prev } <~ delay(1)
  }
  stage
}

// One frame: the sawtooth, then each channel through its own filter.
fn frame(buf, rig, n) = {
  let saw = rig.voice(220.0) * 0.4
  let l = saw |> rig.dark(300.0) |> soft_clip
  let r = saw |> rig.bright(3000.0) |> soft_clip
  wav_frame(buf, n, l, r)
}

// Everything with memory is made here, once, before a sample renders.
fn build_rig(sr) = {bright: one_pole(sr), dark: one_pole(sr), voice: saw_voice(sr)}

fn main() = {
  {
    let frames = frames_of(seconds())
    let buf = wav_header(wav_alloc(frames), frames, rate())
    play(frames, frame(buf, build_rig(rate())))
    print(wav_bytes(buf))
  } ~> stdout_console ~> sample_at(48000)
  0
}
