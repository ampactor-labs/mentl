// 08 · hole: leave a gap and ask the medium what goes there
//
// Two notes, three seconds, and one stage of the chain left open: `??`.
//
//   mentl examples/pulse/course/08-hole.mn:50:76     Propose: brighten, the one candidate left
//   mentl accept examples/pulse/course/08-hole.mn:50:76
//   mentl run examples/pulse/course/08-hole.mn > 08.wav
//
// A hole is a typed constraint, not a gap in the text. The pipe requires a
// stage from Float to Float, so the cursor tries every candidate among the
// names the module can see, checks each in a trial version of the graph
// (infer, verify, restore), and keeps only the ones that pass. Here one
// passes, `brighten`, and the accept command writes it where the hole was:
// the edge is drawn first, the text is its projection, and the Why at the
// stage leads back to the proposal. Until the hole is filled the file does
// not run: an executable with a hole is always rejected, with
// E_UnresolvedHole at the hole, while `mentl check` passes it, since a hole
// is productive. If you declare a second stage of the same shape,
// `fn darken(x) with Pure = x - 0.3 * x * x * x`, two candidates pass. A tie
// between meanings is reported as a question: the medium does not pick a
// behaviour (PLAN §5). The frontier gate accepts this lesson's candidate
// into a scratch copy and renders it, so the board checks it as a contract.
import audio/wav

import dsp/clock

import dsp/envelope

import dsp/osc

import dsp/signal

import io

import rate

fn seconds() with Pure = 3

// The score: A3 then E4, a second and a half each.
fn note_hz(k) -> Hz = if k == 0 { 220.0 } else { 329.63 }

// A soft brightening: the signal plus a little of its cube, which adds the
// third harmonic without moving the peak much.
fn brighten(x) with Pure = x + 0.3 * x * x * x

fn frame(buf, rig, n) with !Alloc = {
  let t = time()
  let k = n * 2 / 3 / rate()
  let tn = t - 1.5 * float_of_int(k)
  let lead = rig.voice(note_hz(k)) * adsr(0.01, 0.3, 0.6, 0.4, 1.5, tn) |> ?? |> soft_clip
  wav_frame(buf, n, lead, lead)
}

fn build_rig(sr) = {voice: sine_voice(sr)}

fn main() = {
  {
    let frames = frames_of(seconds())
    let buf = wav_header(wav_alloc(frames), frames, rate())
    play(frames, frame(buf, build_rig(rate())))
    print(wav_bytes(buf))
  } ~> stdout_console ~> sample_at(48000)
  0
}
