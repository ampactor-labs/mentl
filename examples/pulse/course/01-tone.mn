// 01 · tone — a sine through the pipe to the file
//
// The first sound: a sine at 220 Hz, through a gain, into both channels of a
// WAV on standard output, three seconds long.
//
//   mentl run examples/pulse/course/01-tone.mn > 01.wav
//
// The verb is `|>`: the value on its left flows into the stage on its right.
// A stage is a function with its configuration first and its datum last, so
// `x |> gain(0.3)` is `gain(0.3, x)`: the pipe fills the one slot the stage
// left open (SYNTAX §«Partial application»), and `soft_clip` after it lands
// the sample strictly inside the unit range, which is what the WAV writer's
// `Sample` parameters demand. Put the caret on the chain and ask the medium
// what is true there:
//
//   mentl examples/pulse/course/01-tone.mn:38       the eight aspects at the pipe
//   mentl where examples/pulse/course/01-tone.mn frame    the frame's head, its row inferred
//
// What the row says, nobody wrote: `frame` performs the clock's instance and
// the memory writes of the WAV, and nothing else. The positive row is
// projected, never typed; a signature holds decisions.
import audio/wav

import dsp/clock

import dsp/osc

import dsp/signal

import io

import rate

fn seconds() with Pure = 3

// One frame: the voice at 220 Hz, through the gain, into both channels.
fn frame(buf, tone, n: Int) = {
  let s = tone(220.0) |> gain(0.3) |> soft_clip
  wav_frame(buf, n, s, s)
}

// The root: the console the file is printed to and the clock at 48,000
// samples a second go up first; inside them the buffer is sized from the
// rate the clock answers, the voice is minted, and the loop runs.
fn main() = {
  {
    let frames = frames_of(seconds())
    let buf = wav_header(wav_alloc(frames), frames, rate())
    play(frames, frame(buf, sine_voice(rate())))
    print(wav_bytes(buf))
  } ~> stdout_console ~> sample_at(48000)
  0
}
