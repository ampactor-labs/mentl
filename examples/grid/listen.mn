// listen.mn: learns the hum's frequency, using a gradient that the compiler
// works out from the arithmetic itself.
//
// It reads one sample of the hum per line on stdin, 480 samples a second
// (the ear's copy of the signal at that rate, samples/hum_480.txt in the HUM
// repository), and keeps one number, the coefficient a, that learns the
// frequency. A pure tone obeys x[n] = a·x[n−1] − x[n−2] with a = 2·cos(ω),
// so that one number fixes the pitch. For each sample the program predicts
// x[n] from the two samples before it, squares the error, and moves a
// against the slope of that squared error. The compiler derives the slope
// from the same arithmetic, `d(e * e)` under `~> grad(a)`, the way lesson
// 09's filter learns. Nothing records the run for a later backward pass, and
// no second, hand-written copy of the derivative can drift out of step. Once
// a second it prints the frequency that a stands for:
//
//   mentl run examples/grid/listen.mn < samples/hum_480.txt
//   {"hz_learned":60.000312}
//
// There are two stages, and a function makes each one. Both promise
// `!Alloc`, so no memory is allocated while they run. `smoother` makes a
// four-pole low-pass filter at 80 Hz, so the hum's harmonics, which would
// bend a two-sample predictor by about a hertz, reach the learner 40 dB
// weaker. `learner` makes the step that keeps a, and the running average of
// the signal's energy that each step is divided by. The caller passes in the
// two previous samples.
import io

import math

import ml/grad

import strings

fn rate() -> Float with Pure = 480.0

// The slope of the squared prediction error with respect to a, taken from
// the same arithmetic the prediction runs.
fn slope(a: Float, x1: Float, x2: Float, x: Float) -> Float = {
  let e = x - (a * x1 - x2)
  d(e * e)
} ~> grad(a)

// Four one-pole filters in series at the same corner frequency, each
// keeping its own previous output.
fn smoother(corner: Float) = {
  let al = 1.0 - exp(0.0 - two_pi() * corner / rate())
  fn stage(x: Float) -> Float with !Alloc = {
    let y1 = { y => y + al * (x - y) } <~ delay(1)
    let y2 = { y => y + al * (y1 - y) } <~ delay(1)
    let y3 = { y => y + al * (y2 - y) } <~ delay(1)
    { y => y + al * (y3 - y) } <~ delay(1)
  }
  stage
}

// Each step moves a against the slope, divided by the smoothed energy of
// the two samples it predicts from, so a loud hum and a quiet one learn at
// the same pace. The stored value starts at zero, which would mean 120 Hz,
// so the first tick sets it to 60 Hz, 2·cos(2π·60/480), and the reading
// starts at the grid's nominal frequency.
fn learner(mu: Float) = {
  fn stage(x2: Float, x1: Float, x: Float) -> Float with !Alloc = {
    let energy = { en => en + (x1 * x1 + x2 * x2 - en) * 0.02 } <~ delay(1)
    {
      a => {
        let seeded = if a == 0.0 { 1.4142135623730951 } else { a }
        seeded - mu * slope(seeded, x1, x2, x) / (energy + 0.000001)
      },
    } <~ delay(1)
  }
  stage
}

// The frequency that a coefficient stands for: a = 2·cos(ω), so
// ω = acos(a / 2), converted to hertz at 480 samples a second. The cosine
// is clamped to its range so the square root is always real.
fn hz_of(a: Float) -> Float with Pure = {
  let c0 = a / 2.0
  let c = if c0 > 1.0 { 1.0 } else if c0 < -1.0 { -1.0 } else { c0 }
  atan2(sqrt(1.0 - c * c), c) * rate() / two_pi()
}

// Reads one sample per line, smooths it, and passes the two previous
// samples along.
fn step(smooth, learn, n: Int, x2: Float, x1: Float) = {
  let line = read_stdin_line()
  if byte_len(line) == 0 {
    ()
  } else {
    let x = smooth(parse_float(line))
    let a = learn(x2, x1, x)
    if n % 480 == 0 { print_string("\{\"hz_learned\":{float_to_str(hz_of(a))}\}\n") } else { () }
    step(smooth, learn, n + 1, x1, x)
  }
}

fn main() = {
  step(smoother(80.0), learner(0.005), 1, 0.0, 0.0)
  0
}
