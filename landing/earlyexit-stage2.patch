diff --git a/tests/micros/mn-any-stops-at-the-hit.mn b/tests/micros/mn-any-stops-at-the-hit.mn
new file mode 100644
index 0000000..87a6151
--- /dev/null
+++ b/tests/micros/mn-any-stops-at-the-hit.mn
@@ -0,0 +1,23 @@
+// expect: 3
+// `any` is the fold of `||`: the predicate runs until the first hit and not
+// after it, as `p(1) || p(2) || p(3) || …` evaluates its right operand only
+// when the left is false. The counter sees three calls over five elements.
+// On boot 4228ff71 `any_handler` resumed on every element, the predicate ran
+// five times, and the program answered 5.
+effect Tick {
+  tick()
+  ticks() -> Int
+}
+
+handler counter with n = 0 {
+  tick() => resume() with n = n + 1,
+  ticks() => resume(n),
+}
+
+fn main() = {
+  let _ = any((x) => {
+    tick()
+    x > 2
+  }, [1, 2, 3, 4, 5])
+  ticks()
+} ~> counter
diff --git a/tests/micros/mn-search-stops-at-the-hit.mn b/tests/micros/mn-search-stops-at-the-hit.mn
new file mode 100644
index 0000000..c258c90
--- /dev/null
+++ b/tests/micros/mn-search-stops-at-the-hit.mn
@@ -0,0 +1,32 @@
+// expect: 6
+// `find` and `all` stop at their first hit and `take` at its count: three
+// predicate calls each over five elements, `find` answering Some(3) and
+// `all` false at the 3, and two elements taken. On boot 4228ff71 `all`
+// resumed past its first false and its predicate ran over every element:
+// 3 + 5 = 8.
+effect Tick {
+  tick()
+  ticks() -> Int
+}
+
+handler counter with n = 0 {
+  tick() => resume() with n = n + 1,
+  ticks() => resume(n),
+}
+
+fn main() = {
+  let found = find((x) => {
+    tick()
+    x > 2
+  }, [1, 2, 3, 4, 5])
+  let small = all((x) => {
+    tick()
+    x < 3
+  }, [1, 2, 3, 4, 5])
+  let taken = take(2, [7, 8, 9])
+  let v = match found {
+    Some(n) => n,
+    None => 0,
+  }
+  if v == 3 && !small && taken == [7, 8] { ticks() } else { 100 }
+} ~> counter
